---
const segments = [
  {
    title: "Growing D2C brands",
    text: "Teams with real sales volume, repeated buyer questions, and a process that needs more than a fixed chatbot template.",
  },
  {
    title: "Custom sales workflows",
    text: "Brands that need qualification, routing, catalog logic, offer rules, and clean handoffs shaped around how their team sells.",
  },
  {
    title: "Catalog-heavy selling",
    text: "Fashion, footwear, beauty, lifestyle, and other stores where size, shade, stock, delivery, and COD details drive conversion.",
  },
];
---

<section id="best-for" class="relative overflow-hidden py-12 sm:py-14">
  <div class="page-shell">
    <div class="grid gap-5 rounded-2xl border border-stone-200 bg-white/82 p-5 shadow-[0_14px_44px_rgba(28,25,23,0.06)] backdrop-blur-xl lg:grid-cols-[0.72fr_1.28fr] lg:items-center lg:p-6">
      <div>
        <p class="section-eyebrow">Best for</p>
        <h2 class="mt-3 text-2xl font-semibold leading-tight text-stone-950 sm:text-3xl">
          Built for teams where social conversations drive serious revenue.
        </h2>
      </div>

      <div class="grid gap-3 md:grid-cols-3">
        {segments.map((segment) => (
          <article class="rounded-xl border border-stone-200 bg-stone-50/80 p-4">
            <h3 class="text-base font-semibold leading-snug text-stone-950">{segment.title}</h3>
            <p class="mt-2 text-sm font-medium leading-relaxed text-stone-600">{segment.text}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
