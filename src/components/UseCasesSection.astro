---
const pillars = [
  {
    code: "PILLAR 01",
    title: "Instagram Comment-to-DM Accelerator",
    text: "When a reel goes viral, VoluChat auto-replies to comments in 2 seconds and instantly slides into DMs with exact pricing, photos, and sizing options before interest drops.",
    metric: "100% Lead Capture",
    badge: "Top of Funnel",
    color: "from-rose-500/10 border-rose-500/20 text-rose-300",
  },
  {
    code: "PILLAR 02",
    title: "Deep Catalog & Sizing Intelligence",
    text: "Trained on your Shopify catalog. Answers complex buyer queries: fabric care, matching combinations, size charts, and real-time variant stock availability.",
    metric: "0% Hallucination",
    badge: "Product Advisory",
    color: "from-teal-500/10 border-teal-500/20 text-teal-300",
  },
  {
    code: "PILLAR 03",
    title: "WhatsApp Autonomous Sales Closer",
    text: "Moves qualified buyers to your official WhatsApp Business number. Replaces human reps by negotiating, addressing delivery timelines, and building trust naturally.",
    metric: "24/7 Closing Rate",
    badge: "Bottom of Funnel",
    color: "from-emerald-500/10 border-emerald-500/20 text-emerald-300",
  },
  {
    code: "PILLAR 04",
    title: "Native In-DM 1-Click Payment & COD Guard",
    text: "Generates native WhatsApp catalog checkouts or instant UPI / Razorpay payment links. Validates pincodes and verifies COD orders to eliminate delivery returns.",
    metric: "Sub-90s Checkout",
    badge: "Transaction Layer",
    color: "from-indigo-500/10 border-indigo-500/20 text-indigo-300",
  },
];
---

<section
  id="how-it-works"
  class="relative bg-[#050b14] py-20 sm:py-24 lg:py-28"
>
  <div class="page-shell relative z-10">
    <div class="usecases-header mb-12 grid gap-6 lg:grid-cols-2 lg:items-end opacity-0">
      <div>
        <div class="chip mb-4">
          <span class="mini-label">The Autonomous Commerce Engine</span>
        </div>
        <h2 class="section-title text-white">
          Built to close sales where <span class="gradient-text-anim">customers actually buy.</span>
        </h2>
      </div>
      <p class="section-copy max-w-xl text-slate-400 lg:justify-self-end lg:pb-2">
        From the moment a customer comments on a Reel to the second their UPI payment clears inside WhatsApp — VoluChat manages the entire revenue journey without human intervention.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {
        pillars.map((pillar, index) => (
          <article
            class={`usecase-card group relative overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-b from-white/[0.04] to-transparent p-7 transition-all duration-500 hover:border-emerald-500/30 hover:bg-white/[0.05] sm:p-8 opacity-0 ${index % 2 === 1 ? "md:translate-y-8" : ""}`}
          >
            <div class="relative z-10 flex h-full flex-col justify-between gap-8">
              <div>
                <div class="mb-5 flex items-center justify-between gap-4">
                  <span class="font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-400">
                    {pillar.code}
                  </span>
                  <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-[9px] font-bold uppercase tracking-[0.16em] text-slate-400">
                    {pillar.badge}
                  </span>
                </div>

                <h3 class="font-heading text-xl font-semibold tracking-tight text-white transition-colors duration-300 group-hover:text-emerald-300 sm:text-2xl">
                  {pillar.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-slate-400">
                  {pillar.text}
                </p>
              </div>

              <div class="flex items-end justify-between border-t border-white/10 pt-5">
                <span class="font-heading text-lg font-bold text-emerald-300">
                  {pillar.metric}
                </span>
                <span class="text-[11px] font-semibold text-slate-500 transition-colors duration-300 group-hover:text-emerald-400">
                  Autonomous Layer &rarr;
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#how-it-works",
        start: "top 75%",
      }
    });

    tl.fromTo(
      ".usecases-header",
      { opacity: 0, y: 25 },
      { opacity: 1, y: 0, duration: 0.55, ease: "power3.out" }
    );

    // Architectural expansion: cards slide and unroll into place with depth
    const cards = gsap.utils.toArray<HTMLElement>(".usecase-card");
    if (cards.length === 4) {
      tl.fromTo(
        [cards[0], cards[2]], // Left column
        { opacity: 0, x: -35, y: 15 },
        { opacity: 1, x: 0, y: 0, duration: 0.55, stagger: 0.12, ease: "power3.out" },
        "-=0.25"
      );
      tl.fromTo(
        [cards[1], cards[3]], // Right column
        { opacity: 0, x: 35, y: 15 },
        { opacity: 1, x: 0, y: 0, duration: 0.55, stagger: 0.12, ease: "power3.out" },
        "-=0.55"
      );
    }
  });
</script>
