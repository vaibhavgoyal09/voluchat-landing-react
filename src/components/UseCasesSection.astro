---
const workflows = [
  {
    code: "CR",
    href: "/agents/cart-recovery",
    title: "Recover carts with context, not reminder spam",
    text: "Detect checkout drop-off, identify the likely objection, and use approved recovery offers only when margin rules allow it.",
    metric: "Cart recovery",
    cta: "Recover this cart",
  },
  {
    code: "PA",
    href: "/agents/product-assistant",
    title: "Answer buying questions from live catalog data",
    text: "Handle sizing, stock, delivery, returns, and product-fit questions before the buyer leaves the product page.",
    metric: "Product confidence",
    cta: "View assistant",
  },
  {
    code: "UB",
    href: "/agents/upsell",
    title: "Introduce relevant bundles at the right moment",
    text: "Suggest add-ons and upgrades when intent is clear, then back off cleanly when the buyer wants to checkout.",
    metric: "Order value",
    cta: "View upsell flow",
  },
  {
    code: "IC",
    href: "/agents/inventory-clearance",
    title: "Move slow stock without store-wide discounting",
    text: "Turn aging inventory into targeted offers for shoppers already browsing related products or categories.",
    metric: "Stock velocity",
    cta: "Move this stock",
  },
  {
    code: "CF",
    href: "/agents/customer-follow-up",
    title: "Turn delivery moments into retention workflows",
    text: "Check satisfaction, route issues to support, ask for reviews, and prompt repeat purchases when timing is right.",
    metric: "Repeat purchase",
    cta: "View follow-up agent",
  },
  {
    code: "RL",
    href: "/agents/revenue-leak-detection",
    title: "Find the revenue leaks hiding between tools",
    text: "Rank operational gaps across unanswered demand, abandoned carts, slow inventory, and product-page hesitation.",
    metric: "Leak detection",
    cta: "Audit revenue leaks",
  },
];
---

<section
  id="workflows"
  class="relative overflow-hidden bg-[#07111f] py-28 sm:py-36"
>
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
  >
  </div>
  <div
    class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
  >
  </div>

  <div class="page-shell relative z-10">
    <div class="max-w-3xl reveal-on-scroll reveal-up">
      <span class="section-eyebrow">Revenue workflows</span>
      <h2 class="section-title mt-4 text-white">
        Automate the work that moves <span class="gradient-text-anim"
          >revenue.</span
        >
      </h2>
      <p class="section-copy mt-6 max-w-2xl text-slate-300">
        Deploy agent workflows that connect customer intent with catalog
        details, inventory pressure, approval rules, and measurable outcomes.
      </p>
    </div>

    <div class="mt-16 grid gap-6 grid-cols-1 md:grid-cols-12">
      {
        workflows.map((workflow, index) => {
          // Asymmetric grid layout mapping for 12 columns
          let colClass = "col-span-full";
          let cardBgClass = "bg-[#101b2b]/90 hover:bg-[#142438]";
          let metricColor = "text-teal-200";

          if (index === 0) {
            // Cart Recovery (Row 1 Left) - Gradient and accent border
            colClass = "col-span-full md:col-span-6 lg:col-span-7";
            cardBgClass =
              "bg-gradient-to-br from-[#101b2b] to-[#0f3b37]/35 border border-teal-500/20 hover:border-teal-400/35";
          } else if (index === 1) {
            // Product Assistant (Row 1 Right)
            colClass = "col-span-full md:col-span-6 lg:col-span-5";
          } else if (index === 2) {
            // Upsell (Row 2 Left)
            colClass = "col-span-full md:col-span-6 lg:col-span-4";
          } else if (index === 3) {
            // Inventory Clearance (Row 2 Middle) - Amber themed gradient
            colClass = "col-span-full md:col-span-6 lg:col-span-4";
            cardBgClass =
              "bg-gradient-to-br from-[#101b2b] to-[#451a03]/15 border border-amber-500/10 hover:border-amber-400/25";
            metricColor = "text-amber-300";
          } else if (index === 4) {
            // Customer Follow-up (Row 2 Right)
            colClass = "col-span-full md:col-span-12 lg:col-span-4";
          } else if (index === 5) {
            // Leak Detection (Row 3 Full Width with embedded visual check panel)
            colClass = "col-span-full";
          }

          return (
            <a
              href={workflow.href}
              class={`spotlight reveal-on-scroll reveal-scale group flex flex-col justify-between rounded-3xl border border-white/10 ${cardBgClass} p-6 sm:p-8 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-slate-400/30 ${colClass} reveal-delay-${(index % 3) * 100} shadow-[0_24px_70px_-54px_rgba(0,0,0,0.85)]`}
            >
              {index === 5 ? (
                // Specialized content layout for Leak Detection
                <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center w-full">
                  <div>
                    <div class="flex items-center justify-between gap-4">
                      <span class="font-mono text-sm font-semibold text-slate-500">
                        {workflow.code}
                      </span>
                      <span class="text-[11px] font-bold uppercase tracking-[0.16em] text-red-300">
                        Revenue leak audit
                      </span>
                    </div>
                    <h3 class="mt-8 text-2xl font-semibold leading-tight text-white font-heading">
                      {workflow.title}
                    </h3>
                    <p class="mt-4 text-base font-medium leading-relaxed text-slate-300">
                      {workflow.text}
                    </p>
                    <div class="mt-8 flex items-center justify-between border-t border-white/10 pt-4 text-sm font-bold">
                      <span class="text-slate-400">{workflow.cta}</span>
                      <span class="text-teal-200 transition group-hover:translate-x-1">
                        View agent &rarr;
                      </span>
                    </div>
                  </div>

                  {/* Visual diagnostic report mockup */}
                  <div class="rounded-2xl border border-white/10 bg-black/25 p-5 font-mono text-xs text-slate-300 space-y-3 shadow-inner">
                    <div class="flex items-center justify-between border-b border-white/5 pb-2.5 text-[10px] uppercase tracking-wider text-slate-400 font-bold">
                      <span>Audit Surface</span>
                      <span>Risk Status</span>
                    </div>
                    <div class="flex items-center justify-between py-1.5 border-b border-white/5">
                      <span class="flex items-center gap-2">
                        <span class="h-1.5 w-1.5 rounded-full bg-red-400 animate-pulse" />
                        Checkout Drop-off
                      </span>
                      <span class="text-red-400 font-bold">
                        High priority
                      </span>
                    </div>
                    <div class="flex items-center justify-between py-1.5 border-b border-white/5">
                      <span class="flex items-center gap-2">
                        <span class="h-1.5 w-1.5 rounded-full bg-amber-400" />
                        Unanswered DMs
                      </span>
                      <span class="text-amber-400 font-bold font-semibold">
                        Medium Risk
                      </span>
                    </div>
                    <div class="flex items-center justify-between py-1.5">
                      <span class="flex items-center gap-2">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" />
                        Stock Availability
                      </span>
                      <span class="text-emerald-400 font-bold">Monitored</span>
                    </div>
                  </div>
                </div>
              ) : (
                // Standard layout for other cards
                <>
                  <div>
                    <div class="flex items-center justify-between gap-4">
                      <span class="font-mono text-sm font-semibold text-slate-500">
                        {workflow.code}
                      </span>
                      <span
                        class={`text-[11px] font-bold uppercase tracking-[0.16em] ${metricColor}`}
                      >
                        {workflow.metric}
                      </span>
                    </div>
                    <h3 class="mt-8 text-xl font-semibold leading-tight text-white font-heading">
                      {workflow.title}
                    </h3>
                    <p class="mt-4 text-[15px] font-medium leading-relaxed text-slate-300">
                      {workflow.text}
                    </p>
                  </div>
                  <div class="mt-8 flex items-center justify-between border-t border-white/10 pt-4 text-sm font-bold">
                    <span class="text-slate-400">{workflow.cta}</span>
                    <span class="text-teal-200 transition group-hover:translate-x-1">
                      View agent &rarr;
                    </span>
                  </div>
                </>
              )}
            </a>
          );
        })
      }
    </div>
  </div>
</section>
