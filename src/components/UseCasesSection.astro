---
const workflows = [
  {
    code: "WF-01",
    title: "Cart Recovery",
    text: "Automatically detect abandoned carts and prepare personalized recovery offers with precise margin checks.",
    metric: "Revenue Protection",
    href: "/agents/cart-recovery",
  },
  {
    code: "WF-02",
    title: "Clearance & Stock",
    text: "Identify slow-moving inventory and launch targeted clearance recommendations to free up warehouse space.",
    metric: "Capital Efficiency",
    href: "/agents/inventory-clearance",
  },
  {
    code: "WF-03",
    title: "Contextual Upsell",
    text: "Suggest the perfect matching accessory right when the customer intent is highest, fully aware of live stock.",
    metric: "Average Order Value",
    href: "/agents/upsell",
  },
  {
    code: "WF-04",
    title: "VIP Follow-ups",
    text: "Check in on high-value customers after delivery, gather feedback, and recommend timely add-ons.",
    metric: "Customer Retention",
    href: "/agents/customer-follow-up",
  },
  {
    code: "WF-05",
    title: "Leak Detection",
    text: "Continuously scan your store's operations to find hidden revenue leaks across the entire customer journey.",
    metric: "Growth Margin",
    href: "/agents/revenue-leak-detection",
  },
];
---

<section
  id="workflows"
  class="relative bg-[#050b14] py-24 sm:py-32"
>
  <div class="page-shell relative z-10">
    <div class="max-w-2xl reveal-on-scroll reveal-up mb-24">
      <h2 class="section-title text-white">
        Workflows that <span class="gradient-text-anim">drive revenue.</span>
      </h2>
      <p class="section-copy mt-6 text-slate-400">
        Deploy agent workflows that connect customer intent with catalog details, inventory pressure, and measurable outcomes.
      </p>
    </div>

    <!-- Sticky Stack Container -->
    <div id="sticky-stack-container" class="relative">
      {
        workflows.map((workflow, i) => {
          return (
            <div
              class="stack-card sticky top-32 lg:top-40 flex flex-col justify-center mb-[15vh] last:mb-0"
              style={{ zIndex: i + 10 }}
            >
              <article class="w-full max-w-4xl mx-auto rounded-[2rem] border border-white/10 bg-[#0c1627] p-8 md:p-12 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.9)] overflow-hidden relative">
                <!-- Card Inner Glow -->
                <div class="absolute inset-0 bg-gradient-to-br from-teal-500/5 to-transparent pointer-events-none" />
                
                <div class="relative z-10 grid gap-8 md:grid-cols-[1fr_200px] md:items-end">
                  <div>
                    <div class="flex items-center gap-4 mb-8">
                      <span class="font-mono text-sm font-bold text-teal-400">
                        {workflow.code}
                      </span>
                      <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500">
                        {workflow.metric}
                      </span>
                    </div>
                    <h3 class="text-3xl md:text-5xl font-bold text-white font-heading tracking-tight mb-6">
                      {workflow.title}
                    </h3>
                    <p class="text-lg text-slate-300 max-w-xl leading-relaxed">
                      {workflow.text}
                    </p>
                  </div>
                  
                  <div class="flex md:justify-end">
                    <a
                      href={workflow.href}
                      class="btn-secondary rounded-full px-6 py-3 border border-white/20 hover:border-teal-400/50 hover:bg-teal-500/10 hover:text-teal-200 transition-all text-sm font-bold"
                    >
                      Explore agent &rarr;
                    </a>
                  </div>
                </div>
              </article>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  // Wait for the main Layout GSAP initialization
  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReduced) return;

    // Wait a brief moment to ensure global GSAP has initialized
    setTimeout(() => {
      // @ts-ignore
      if (window.gsap && window.ScrollTrigger) {
        // @ts-ignore
        const gsap = window.gsap;
        // @ts-ignore
        const ScrollTrigger = window.ScrollTrigger;

        const cardEls = gsap.utils.toArray(".stack-card");
        
        cardEls.forEach((card: any, i: number) => {
          if (i === cardEls.length - 1) return; // Skip last card

          // The card scales down and fades out slightly as the next one arrives
          gsap.to(card, {
            scale: 0.92,
            opacity: 0.4,
            filter: "blur(4px)",
            ease: "none",
            scrollTrigger: {
              trigger: cardEls[i + 1],
              start: "top 85%", // When the next card enters the bottom 15% of the screen
              end: "top 25%",   // When the next card reaches its sticky position
              scrub: true,
            },
          });
        });
      }
    }, 100);
  });
</script>
