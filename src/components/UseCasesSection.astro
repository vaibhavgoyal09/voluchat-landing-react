---
const workflows = [
  {
    code: "WF-01",
    title: "Cart Recovery",
    text: "Automatically detect abandoned carts and prepare personalized recovery offers with precise margin checks.",
    metric: "Revenue Protection",
    href: "/agents/cart-recovery",
  },
  {
    code: "WF-02",
    title: "Clearance & Stock",
    text: "Identify slow-moving inventory and launch targeted clearance recommendations to free up warehouse space.",
    metric: "Capital Efficiency",
    href: "/agents/inventory-clearance",
  },
  {
    code: "WF-03",
    title: "Contextual Upsell",
    text: "Suggest the perfect matching accessory right when the customer intent is highest, fully aware of live stock.",
    metric: "Average Order Value",
    href: "/agents/upsell",
  },
  {
    code: "WF-04",
    title: "VIP Follow-ups",
    text: "Check in on high-value customers after delivery, gather feedback, and recommend timely add-ons.",
    metric: "Customer Retention",
    href: "/agents/customer-follow-up",
  },
  {
    code: "WF-05",
    title: "Leak Detection",
    text: "Continuously scan your store's operations to find hidden revenue leaks across the entire customer journey.",
    metric: "Growth Margin",
    href: "/agents/revenue-leak-detection",
  },
];
---

<section
  id="workflows"
  class="relative bg-[#050b14] py-20 sm:py-24"
>
  <div class="page-shell relative z-10">
    <div class="usecases-header mb-12 max-w-2xl opacity-0">
      <h2 class="section-title text-white">
        Workflows that <span class="gradient-text-anim">drive revenue.</span>
      </h2>
      <p class="section-copy mt-6 text-slate-400">
        Deploy agent workflows that connect customer intent with catalog details, inventory pressure, and measurable outcomes.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {
        workflows.map((workflow, i) => {
          return (
            <article
              class={`usecase-card group relative overflow-hidden rounded-[1.5rem] border border-white/10 bg-[#0c1627] p-6 shadow-[0_24px_70px_-46px_rgba(0,0,0,0.88)] transition-all duration-300 hover:-translate-y-1 hover:border-teal-300/30 hover:bg-[#101b2f] sm:p-7 opacity-0 ${i === workflows.length - 1 ? "md:col-span-2" : ""}`}
            >
              <div class="absolute inset-0 bg-gradient-to-br from-teal-500/6 to-transparent pointer-events-none" />

              <div class="relative z-10 flex h-full flex-col">
                <div class="mb-7 flex items-center gap-4">
                  <span class="font-mono text-xs font-bold text-teal-400">
                    {workflow.code}
                  </span>
                  <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">
                    {workflow.metric}
                  </span>
                </div>

                <div class={i === workflows.length - 1 ? "grid gap-6 md:grid-cols-[1fr_auto] md:items-end" : ""}>
                  <div>
                    <h3 class="text-2xl font-bold text-white font-heading tracking-tight md:text-3xl">
                      {workflow.title}
                    </h3>
                    <p class="mt-4 max-w-xl text-sm font-medium leading-relaxed text-slate-300 sm:text-base">
                      {workflow.text}
                    </p>
                  </div>

                  <a
                    href={workflow.href}
                    class="mt-7 inline-flex w-fit items-center rounded-full border border-white/20 px-5 py-2.5 text-sm font-bold text-slate-100 transition-all hover:border-teal-400/50 hover:bg-teal-500/10 hover:text-teal-200 md:mt-0"
                  >
                    Explore agent &rarr;
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // Unique animation for UseCasesSection: Staggered pop-in from center
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#workflows",
        start: "top 80%",
        end: "bottom 20%",
        toggleActions: "play none none reverse"
      }
    });

    tl.fromTo(".usecases-header", 
      { opacity: 0, scale: 0.9, y: 30 },
      { opacity: 1, scale: 1, y: 0, duration: 0.8, ease: "back.out(1.5)" }
    );

    tl.fromTo(".usecase-card",
      { opacity: 0, y: 50, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 0.7, stagger: { amount: 0.5, from: "start" }, ease: "power2.out" },
      "-=0.4"
    );
  });
</script>
