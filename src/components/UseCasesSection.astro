---
const capabilities = [
  {
    icon: "⚡",
    title: "Comment-to-DM",
    desc: "2s auto-reply with sizes & prices",
  },
  {
    icon: "📱",
    title: "Multi-Channel",
    desc: "Instagram, WhatsApp, Messenger & Storefront",
  },
  {
    icon: "🎙️",
    title: "Voice Messages",
    desc: "Understands voice notes in any language",
  },
  {
    icon: "🛍️",
    title: "Storefront Widget",
    desc: "Embeddable AI chat for your website",
  },
];
---

<section
  id="capabilities"
  class="relative bg-[#06060a] py-10 sm:py-12 border-y border-white/[0.08]"
>
  <div class="page-shell relative z-10">
    <!-- Compact Horizontal Capability Strip -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 items-center">
      {
        capabilities.map((item, idx) => (
          <div class={`reveal-on-scroll reveal-delay-${idx + 1} flex items-center gap-3.5 p-3 rounded-xl border border-white/[0.06] bg-[#0a0a0c] hover:border-emerald-500/30 transition-all`}>
            <div class="h-9 w-9 rounded-lg border border-white/[0.10] bg-[#101012] flex items-center justify-center text-base shrink-0">
              {item.icon}
            </div>
            <div>
              <h3 class="font-heading text-sm font-bold text-white leading-tight">
                {item.title}
              </h3>
              <p class="text-[11px] text-slate-400 font-normal mt-0.5">
                {item.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>


