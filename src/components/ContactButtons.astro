---
<div class="fixed bottom-6 right-6 z-[60] flex flex-col gap-3 sm:gap-4 anim-fade-in-up">
  <a 
    href="mailto:support@voluchat.com" 
    class="glass w-12 h-12 sm:w-14 sm:h-14 rounded-2xl flex items-center justify-center text-slate-600 hover:-translate-y-1 transition-all duration-300 group"
    aria-label="Send Email"
    title="Email Support"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 sm:w-6 sm:h-6 group-hover:text-indigo-600"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
  </a>
  <a 
    href="tel:+918847568693" 
    class="w-12 h-12 sm:w-14 sm:h-14 bg-slate-950/90 border border-white/15 backdrop-blur-xl rounded-2xl flex items-center justify-center text-white shadow-premium hover:shadow-hover hover:-translate-y-1 transition-all duration-300 group"
    aria-label="Call Support"
    title="Call Support"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 sm:w-6 sm:h-6 group-hover:scale-110 transition-transform"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
  </a>
</div>

<style>
  .anim-fade-in-up {
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 1.5s; /* Wait for hero to animate */
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Custom shadows if not in tailwind config */
  .shadow-premium {
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
  }
  .shadow-hover {
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.15);
  }
</style>
