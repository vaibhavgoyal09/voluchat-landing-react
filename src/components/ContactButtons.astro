---
<div class="fixed bottom-8 right-8 z-[60] flex flex-col gap-4 anim-fade-in-up">
  <a 
    href="mailto:support@voluchat.com" 
    class="glass-card-premium w-14 h-14 rounded-2xl flex items-center justify-center text-slate-500 hover:-translate-y-1.5 hover:text-indigo-600 transition-all duration-500 group shadow-2xl border-white"
    aria-label="Send Email"
    title="Email Support"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 transition-transform group-hover:scale-110"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
  </a>
  <a 
    href="tel:+918847568693" 
    class="w-14 h-14 bg-gradient-to-br from-indigo-600 via-violet-600 to-blue-600 text-white rounded-2xl flex items-center justify-center shadow-[0_20px_50px_rgba(99,102,241,0.28)] hover:shadow-[0_25px_60px_rgba(124,58,237,0.34)] hover:-translate-y-1.5 transition-all duration-500 group border-t border-white/20"
    aria-label="Call Support"
    title="Call Support"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 transition-transform group-hover:scale-110 group-hover:rotate-12"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
  </a>
</div>

<style>
  .anim-fade-in-up {
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 1.5s; /* Wait for hero to animate */
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Custom shadows if not in tailwind config */
  .shadow-premium {
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
  }
  .shadow-hover {
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.15);
  }
</style>
