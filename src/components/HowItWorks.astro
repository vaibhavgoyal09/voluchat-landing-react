---
const steps = [
  {
    title: "Connect sales channels",
    description: "Use Meta login to connect the Instagram and Facebook accounts your buyers already message. No password sharing."
  },
  {
    title: "Sync your store inventory",
    description: "Connect Shopify so products, variants, and stock stay current, then add shipping, COD, offer rules, and brand voice."
  },
  {
    title: "Tune the WhatsApp handoff",
    description: "We shape the order message so your team receives product, variant, quantity, address, and phone details clearly."
  }
];
---

<section id="how-it-works" class="section-pad section-band relative overflow-hidden">
  <div class="page-shell">
    <div class="mx-auto max-w-3xl text-center reveal-on-scroll">
      <p class="section-eyebrow">Simple setup</p>
      <h2 class="section-title mt-4">
        Launch around your existing selling process.
      </h2>
      <p class="section-copy mx-auto mt-5 max-w-2xl">
        We map how your team already handles DMs, then automate the predictable parts before the final WhatsApp close.
      </p>
    </div>

    <div class="mt-12 reveal-on-scroll reveal-delay-100">
      <div class="relative">
        <div class="absolute left-5 top-0 hidden h-full w-px bg-primary-200 md:left-0 md:right-0 md:top-7 md:mx-auto md:block md:h-px md:w-[calc(100%-8rem)]"></div>

        <div class="grid gap-6 md:grid-cols-3">
          {steps.map((step, index) => (
            <article class="relative rounded-none border-l border-primary-200 pl-6 md:border-l-0 md:pl-0 md:pt-16">
              <span class="absolute -left-[1.35rem] top-0 grid h-10 w-10 place-items-center rounded-full border border-primary-200 bg-white font-mono text-xs font-semibold text-primary-800 shadow-[0_10px_28px_rgba(29,43,67,0.1)] md:left-0 md:right-0 md:top-2 md:mx-auto">
                0{index + 1}
              </span>
              <div class="md:px-5 md:text-center">
                <h3 class="text-2xl font-semibold leading-tight text-stone-950">{step.title}</h3>
                <p class="mt-4 text-sm font-medium leading-relaxed text-stone-600">{step.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-3 border-y border-stone-200 py-5 text-center sm:grid-cols-3">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">No password sharing</p>
      <p class="border-y border-stone-200 py-3 text-xs font-semibold uppercase tracking-[0.16em] text-stone-500 sm:border-x sm:border-y-0 sm:py-0">Shopify sync included</p>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">WhatsApp handoff tuned</p>
    </div>
  </div>
</section>
