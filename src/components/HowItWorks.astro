---
const stepsData = [
  {
    icon: "link",
    title: "Connect",
    description: "Link your Instagram & WhatsApp accounts securely in 1 click.",
    benefits: [
      "Official Meta API integration",
      "Secure OAuth authentication",
      "No password sharing required",
    ],
  },
  {
    icon: "workflow",
    title: "Select Flow",
    description: "Choose a pre-built template for your niche (Fashion, Food, etc).",
    benefits: [
      "Industry-specific templates",
      "Customizable automation rules",
      "Multi-language support built-in",
    ],
  },
  {
    icon: "zap",
    title: "Automate",
    description: "VoluChat replies instantly and sends leads to WhatsApp.",
    benefits: [
      "Instant AI-powered responses",
      "Automatic lead qualification",
      "Seamless WhatsApp handoff",
    ],
  },
];
---

<section id="how-it-works" class="py-24 relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-7xl h-[600px] bg-blue-500/5 blur-[100px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute inset-0 gradient-mesh opacity-30 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <!-- Section Header -->
    <div class="mx-auto mb-20 max-w-4xl text-center">
      <div class="inline-block px-4 py-1.5 rounded-full bg-blue-50/50 backdrop-blur-sm border border-blue-100/50 text-blue-700 text-xs font-semibold uppercase tracking-wider mb-6">
        How It Works
      </div>
      <h2 class="text-5xl sm:text-6xl font-heading font-bold text-slate-900 mb-6">
        Live in minutes, <span class="text-gradient-primary">not days</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-2xl mx-auto font-light">
        No coding required. Just connect and start selling.
      </p>
    </div>

    <!-- Step Indicators with Connecting Line -->
    <div class="relative mx-auto mb-16 w-full max-w-5xl hidden md:block">
      <div aria-hidden="true" class="absolute left-[16.6667%] top-1/2 h-0.5 w-[66.6667%] -translate-y-1/2 bg-gradient-to-r from-slate-200 via-blue-200 to-slate-200"></div>
      <div class="relative grid grid-cols-3">
        {stepsData.map((_, index) => (
          <div class="flex h-14 w-14 items-center justify-center justify-self-center rounded-full bg-white border-4 border-blue-50 font-bold text-xl text-blue-600 shadow-lg z-10">
            {index + 1}
          </div>
        ))}
      </div>
    </div>

    <!-- Steps Grid -->
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 md:grid-cols-3">
      {stepsData.map((step) => (
        <div class="relative rounded-[2rem] border border-white/40 bg-white/60 backdrop-blur-md p-8 text-slate-900 transition-all duration-300 ease-in-out shadow-premium hover:scale-[1.02] hover:shadow-premium-lg hover:bg-white/80 z-10 group">
          <!-- Icon -->
          <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 text-white shadow-lg shadow-blue-500/20 group-hover:scale-110 transition-transform duration-300">
            {step.icon === "link" && <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>}
            {step.icon === "workflow" && <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="8" x="3" y="3" rx="2"/><path d="M7 11v4a2 2 0 0 0 2 2h4"/><rect width="8" height="8" x="13" y="13" rx="2"/></svg>}
            {step.icon === "zap" && <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>}
          </div>
          <!-- Title and Description -->
          <h3 class="mb-3 text-2xl font-heading font-bold text-slate-900 group-hover:text-blue-700 transition-colors">
            {step.title}
          </h3>
          <p class="mb-8 text-slate-600 leading-relaxed font-medium text-lg">
            {step.description}
          </p>
          <!-- Benefits List -->
          <ul class="space-y-4">
            {step.benefits.map((benefit) => (
              <li class="flex items-start gap-3">
                <div class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-blue-100 mt-1">
                  <div class="h-2 w-2 rounded-full bg-blue-600"></div>
                </div>
                <span class="text-base text-slate-700 leading-relaxed font-medium">
                  {benefit}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
