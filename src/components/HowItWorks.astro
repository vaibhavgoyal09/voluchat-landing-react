---
const steps = [
  {
    title: "Connect Instagram",
    description: "Connect your Instagram Professional account with Meta login. No Instagram password sharing."
  },
  {
    title: "Add Boutique Catalog",
    description: "Add products, sizing guides, colors, availability, offers, and common buyer questions."
  },
  {
    title: "Configure WhatsApp",
    description: "Choose what details your staff needs before a buyer reaches WhatsApp."
  }
];
---

<section id="how-it-works" class="section-pad relative overflow-hidden">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="absolute right-1/4 top-1/2 h-[28rem] w-[28rem] rounded-full bg-stone-300/10 blur-3xl"></div>
  </div>

  <div class="page-shell">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
      <div class="max-w-xl reveal-on-scroll space-y-4">
        <p class="section-eyebrow">Simple setup</p>
        <h2 class="section-title">
          Set up VoluChat around your boutique workflow.
        </h2>
        <p class="section-copy">
          Our team helps you connect accounts, import catalog details, tune replies, and test the flow during the 14-day free trial.
        </p>
      </div>

      <div class="grid gap-5">
        {steps.map((step, index) => (
          <article class={`surface-soft rounded-[2.25rem] p-7 md:p-8 hover:-translate-y-1 hover:shadow-xl hover:border-white transition-all duration-300 reveal-on-scroll ${index === 1 ? 'reveal-delay-100' : index === 2 ? 'reveal-delay-200' : ''}`}>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="space-y-2">
                <h3 class="font-heading text-xl font-bold text-stone-950">{step.title}</h3>
                <p class="text-xs sm:text-sm font-semibold leading-relaxed text-stone-600 max-w-xl">{step.description}</p>
              </div>
              <span class="h-10 w-10 shrink-0 rounded-full bg-stone-950 text-white font-mono font-bold text-sm flex items-center justify-center shadow-md select-none">
                0{index + 1}
              </span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
