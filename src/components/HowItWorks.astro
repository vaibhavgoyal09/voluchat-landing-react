---
const steps = [
  {
    number: "01",
    icon: "link",
    title: "Connect Instagram",
    description: "Connect your Instagram Professional account with Meta login. No Instagram password sharing."
  },
  {
    number: "02",
    icon: "workflow",
    title: "Add Boutique Catalog",
    description: "Add products, sizing guides, colors, availability, offers, and common buyer questions."
  },
  {
    number: "03",
    icon: "zap",
    title: "Configure WhatsApp",
    description: "Choose what details your staff needs before a buyer reaches WhatsApp."
  }
];
---

<section id="how-it-works" class="relative overflow-hidden py-28 md:py-36">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-10"></div>
    <div class="absolute -right-32 bottom-24 h-[32rem] w-[32rem] rounded-full bg-primary-300/10 blur-3xl"></div>
    <div class="absolute -left-32 top-12 h-[32rem] w-[32rem] rounded-full bg-stone-300/12 blur-3xl"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6">
    <div class="mx-auto mb-24 max-w-3xl text-center">
      <!-- Standardized Glowing Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-lg border border-primary-200/70 bg-primary-50/70 px-4 py-1.5 text-xs font-semibold text-primary-800 shadow-sm backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-primary-600 shadow-[0_0_8px_rgba(51,141,115,0.42)]"></span>
        <span>Simple setup</span>
      </div>
      <!-- Consistent Responsive Heading -->
      <h2 class="text-3xl font-heading font-semibold leading-[1.1] tracking-tight text-stone-950 sm:text-5xl lg:text-6xl">
        Set up VoluChat around your boutique workflow.
      </h2>
      <p class="mt-6 text-lg font-semibold leading-relaxed text-stone-600 sm:text-xl">
        Our team helps you connect accounts, import catalog details, tune replies, and test the flow during the 14-day free trial.
      </p>
    </div>

    <div class="relative grid gap-8 md:grid-cols-3">
      <!-- Dotted Connector Line (Premium UI detail) -->
      <div class="absolute left-[16%] right-[16%] top-20 z-0 hidden h-0.5 bg-gradient-to-r from-transparent via-primary-100 to-transparent md:block"></div>

      {steps.map((step, index) => (
        <article class={`glass-card-premium relative z-10 rounded-2xl p-8 shadow-xl flex flex-col justify-between hover:-translate-y-2 hover:shadow-2xl hover:border-primary-500/20 transition-all duration-500 group/step reveal-on-scroll ${index === 1 ? 'reveal-delay-100' : index === 2 ? 'reveal-delay-200' : ''}`}>
          <div>
            <div class="mb-8 flex items-center justify-between gap-4">
              <!-- Glowing Blue Glass Icon Badge -->
              <div class="grid h-14 w-14 place-items-center rounded-2xl bg-primary-50/80 border border-primary-100 text-primary-700 shadow-sm shrink-0 group-hover/step:bg-primary-700 group-hover/step:text-white group-hover/step:border-primary-700 group-hover/step:shadow-lg group-hover/step:shadow-primary-700/15 transition-all duration-300">
                {step.icon === "link" && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>}
                {step.icon === "workflow" && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="8" x="3" y="3" rx="2"/><path d="M7 11v4a2 2 0 0 0 2 2h4"/><rect width="8" height="8" x="13" y="13" rx="2"/></svg>}
                {step.icon === "zap" && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>}
              </div>
              <span class="select-none font-heading text-5xl font-semibold leading-none tracking-tighter text-primary-100/80 group-hover/step:text-primary-600 group-hover/step:scale-110 origin-right transition-all duration-300">{step.number}</span>
            </div>

            <h3 class="font-heading text-xl sm:text-2xl font-semibold tracking-tight text-stone-950 mb-3">{step.title}</h3>
            <p class="text-sm font-semibold leading-relaxed text-stone-600">{step.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
