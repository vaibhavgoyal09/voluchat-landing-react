---
const steps = [
  {
    number: "01",
    icon: "link",
    title: "Connect",
    description: "Link your Instagram & WhatsApp accounts securely in one click.",
    benefits: ["Official Meta API integration", "Secure OAuth authentication", "No password sharing required"],
  },
  {
    number: "02",
    icon: "workflow",
    title: "Select Flow",
    description: "Choose a pre-built template for your niche — Fashion, Food, and more.",
    benefits: ["Industry-specific templates", "Customizable automation rules", "Multi-language support built-in"],
  },
  {
    number: "03",
    icon: "zap",
    title: "Automate",
    description: "VoluChat replies instantly and sends warm leads straight to WhatsApp.",
    benefits: ["Instant AI-powered responses", "Automatic lead qualification", "Seamless WhatsApp handoff"],
  },
];
---

<section id="how-it-works" class="py-28 relative overflow-hidden bg-slate-50/60">
  <!-- Background -->
  <div class="absolute inset-0 pointer-events-none -z-10">
    <div class="sect-grid"></div>
    <div class="sect-orb" style="width:500px;height:500px;background:radial-gradient(circle,rgba(99,102,241,0.10) 0%,transparent 70%);top:0;left:50%;transform:translateX(-50%);"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <!-- Header -->
    <div class="text-center mb-20 max-w-2xl mx-auto">
      <span class="section-badge mb-5 inline-flex">How It Works</span>
      <h2 class="text-4xl sm:text-5xl font-heading font-bold text-slate-900 mb-4 leading-tight">
        Live in minutes,<br /><span class="text-gradient-primary">not days</span>
      </h2>
      <p class="text-lg text-slate-500">No coding required. Just connect and start selling.</p>
    </div>

    <!-- Steps -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
      <!-- Connector line (desktop) -->
      <div class="hidden md:block absolute top-10 left-[22%] right-[22%] h-px bg-gradient-to-r from-transparent via-indigo-200 to-transparent z-0"></div>

      {steps.map((step) => (
        <div class="relative group bg-white rounded-3xl border border-slate-100 p-8 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1 z-10">
          <!-- Step number + icon row -->
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white shadow-sm flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
              {step.icon === "link" && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>}
              {step.icon === "workflow" && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="8" x="3" y="3" rx="2"/><path d="M7 11v4a2 2 0 0 0 2 2h4"/><rect width="8" height="8" x="13" y="13" rx="2"/></svg>}
              {step.icon === "zap" && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>}
            </div>
            <span class="text-4xl font-heading font-black text-slate-100 select-none leading-none">{step.number}</span>
          </div>

          <h3 class="text-xl font-heading font-bold text-slate-900 mb-2">{step.title}</h3>
          <p class="text-slate-500 text-sm leading-relaxed mb-6">{step.description}</p>

          <ul class="space-y-3">
            {step.benefits.map((b) => (
              <li class="flex items-center gap-2.5 text-sm text-slate-600">
                <div class="w-5 h-5 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                {b}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
