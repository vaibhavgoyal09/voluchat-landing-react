---
const steps = [
  {
    title: "Connect sales channels",
    description: "Connect Instagram and Facebook Pages with Meta login for one inbox or many. No password sharing."
  },
  {
    title: "Provide your store policies",
    description: "Share shipping, return, and refund rules so VoluChat answers buyers with the same store-approved terms."
  },
  {
    title: "Add your product catalog",
    description: "Add products, variants, sizing guides, colors, availability, offers, and common buyer questions."
  }
];
---

<section id="how-it-works" class="section-pad relative overflow-hidden">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="absolute right-1/4 top-1/2 h-[28rem] w-[28rem] rounded-full bg-stone-300/10 blur-3xl"></div>
  </div>

  <div class="page-shell">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
      <div class="max-w-xl reveal-on-scroll space-y-4">
        <p class="section-eyebrow">Simple setup</p>
        <h2 class="section-title">
          Launch without rebuilding how your team sells.
        </h2>
        <p class="section-copy">
          Setup is about permissions, store rules, and reply tone. We map what your team already does, then turn the repetitive parts into controlled automation.
        </p>
      </div>

      <div class="grid gap-5">
        {steps.map((step, index) => (
          <article class={`solid-card hover:-translate-y-1 hover:shadow-xl transition-all duration-300 reveal-on-scroll ${index === 1 ? 'reveal-delay-100' : index === 2 ? 'reveal-delay-200' : ''}`}>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="space-y-2">
                <h3 class="font-heading text-xl font-bold text-stone-950">{step.title}</h3>
                <p class="text-xs sm:text-sm font-semibold leading-relaxed text-stone-600 max-w-xl">{step.description}</p>
              </div>
              <span class="h-10 w-10 shrink-0 rounded-full bg-primary-800 text-white font-mono font-bold text-sm flex items-center justify-center shadow-[0_12px_30px_rgba(40,57,87,0.16)] select-none">
                0{index + 1}
              </span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
