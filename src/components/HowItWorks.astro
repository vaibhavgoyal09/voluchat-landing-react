---
const steps = [
  {
    title: "Map your sales workflow",
    description: "We document how buyers ask, how your team qualifies them, which details matter, and where the conversation should go next."
  },
  {
    title: "Configure catalog, rules, and handoffs",
    description: "We add your products, variants, policies, COD, offers, tone, escalation logic, and WhatsApp handoff format."
  },
  {
    title: "Launch the pilot and tune from real chats",
    description: "Start with one high-value workflow, review live conversations, and refine replies, routing, and handoff context as buyers respond."
  }
];
---

<section id="how-it-works" class="section-pad relative overflow-hidden">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="absolute right-1/4 top-1/2 h-[28rem] w-[28rem] rounded-full bg-stone-300/10 blur-3xl"></div>
  </div>

  <div class="page-shell">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
      <div class="max-w-xl reveal-on-scroll space-y-4">
        <p class="section-eyebrow">Founder-led setup</p>
        <h2 class="section-title">
          Launch a workflow around your existing sales process.
        </h2>
        <p class="section-copy">
          VoluChat is not a one-size-fits-all template. We map the repeatable parts of your sales motion, configure the automation, and keep your team in control of the close.
        </p>
      </div>

      <div class="grid gap-5">
        {steps.map((step, index) => (
          <article class={`solid-card hover:-translate-y-1 hover:shadow-xl transition-all duration-300 reveal-on-scroll ${index === 1 ? 'reveal-delay-100' : index === 2 ? 'reveal-delay-200' : ''}`}>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="space-y-2">
                <h3 class="font-heading text-xl font-bold text-stone-950">{step.title}</h3>
                <p class="text-xs sm:text-sm font-semibold leading-relaxed text-stone-600 max-w-xl">{step.description}</p>
              </div>
              <span class="h-10 w-10 shrink-0 rounded-full bg-primary-800 text-white font-mono font-bold text-sm flex items-center justify-center shadow-[0_12px_30px_rgba(40,57,87,0.16)] select-none">
                0{index + 1}
              </span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
