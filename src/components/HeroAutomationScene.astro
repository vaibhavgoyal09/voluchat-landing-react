---
---

<div class="hero-stage relative min-h-[360px] overflow-hidden rounded-[2.25rem] bg-[linear-gradient(145deg,rgba(255,255,255,0.9),rgba(232,237,244,0.72))] p-2 shadow-[0_34px_120px_rgba(28,25,23,0.13)] sm:min-h-[500px] lg:min-h-[530px]">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_0%,rgba(83,111,159,0.13),transparent_34%),radial-gradient(circle_at_14%_82%,rgba(203,217,234,0.22),transparent_32%),radial-gradient(circle_at_52%_45%,rgba(174,191,215,0.12),transparent_36%)]"></div>

  <div class="relative z-10 h-full min-h-[344px] overflow-hidden rounded-[1.85rem] border border-white/90 bg-[#fcfdff] p-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.95),inset_0_-24px_70px_rgba(120,113,108,0.08)] sm:min-h-[480px] sm:p-5 lg:min-h-[510px]">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(90deg,rgba(255,255,255,0.88),transparent_58%),radial-gradient(circle_at_76%_42%,rgba(83,111,159,0.08),transparent_33%),radial-gradient(circle_at_16%_18%,rgba(243,247,251,0.86),transparent_30%)]"></div>

    <div class="relative z-10 flex items-center justify-between rounded-[1.25rem] border border-stone-200/70 bg-white/88 px-4 py-3 text-[11px] font-semibold text-stone-600 shadow-[0_18px_50px_rgba(68,64,60,0.08)]">
      <span>Live checkout automation</span>
      <span class="inline-flex items-center gap-2 text-stone-950">
        <span class="h-2 w-2 rounded-full bg-primary-500 shadow-[0_0_16px_rgba(83,111,159,0.55)]"></span>
        Active
      </span>
    </div>

    <div class="relative z-10 mt-4 grid gap-3 sm:gap-4 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="space-y-3">
        <div class="kinetic-card rounded-[1.35rem] border border-stone-200/70 bg-white/92 p-4 shadow-[0_20px_60px_rgba(28,25,23,0.10)]">
          <div class="flex items-center justify-between gap-3">
            <p class="mini-label">Incoming question</p>
            <span class="rounded-full bg-primary-50 px-2.5 py-1 text-[10px] font-semibold text-primary-700">Instagram DM</span>
          </div>
          <p class="mt-3 text-sm font-semibold leading-snug text-stone-950">"Is the linen co-ord available in Size M?"</p>
          <div class="mt-4 flex items-center gap-3 rounded-2xl bg-[linear-gradient(135deg,rgba(243,247,251,0.86),rgba(255,255,255,0.72))] p-3">
            <img src="/linen_coord_thumb.png" alt="Linen co-ord set used in an automated apparel availability check" class="h-12 w-12 rounded-xl object-cover" loading="eager" decoding="async" />
            <div>
              <p class="text-xs font-semibold text-stone-950">Linen Co-ord Set</p>
              <p class="mt-1 text-[11px] font-medium text-stone-500">Catalog match: Size M in ivory</p>
            </div>
          </div>
        </div>

        <div class="hidden rounded-[1.35rem] border border-stone-200/70 bg-white/80 p-4 shadow-[0_16px_44px_rgba(28,25,23,0.07)] sm:block">
          <p class="mini-label">Channels</p>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <span class="rounded-full bg-[linear-gradient(135deg,#283957,#425b87)] px-3 py-2 text-center text-[11px] font-semibold text-white shadow-sm shadow-primary-800/10">Instagram</span>
            <span class="rounded-full bg-[linear-gradient(135deg,#f3f7fb,#e5edf6)] px-3 py-2 text-center text-[11px] font-semibold text-primary-800">Facebook Page</span>
          </div>
          <div class="mt-3 grid grid-cols-3 gap-2" aria-label="Apparel catalog examples">
            <img src="/linen_coord_thumb.png" alt="Linen co-ord set catalog item" class="aspect-square rounded-xl object-cover shadow-sm" loading="eager" decoding="async" />
            <img src="/satin_kurta_thumb.png" alt="Satin kurta set catalog item" class="aspect-square rounded-xl object-cover shadow-sm" loading="lazy" decoding="async" />
            <img src="/denim_overshirt_thumb.png" alt="Denim overshirt catalog item" class="aspect-square rounded-xl object-cover shadow-sm" loading="lazy" decoding="async" />
          </div>
          <p class="mt-4 text-xs font-medium leading-relaxed text-stone-500">New questions are checked against size, color, delivery, offer, cart, and checkout context.</p>
        </div>
      </div>

      <div class="relative grid gap-3 sm:block sm:min-h-[350px] lg:min-h-[438px]">
        <div class="hidden rounded-[1.45rem] border border-stone-200/70 bg-white/92 p-3 shadow-[0_24px_70px_rgba(28,25,23,0.10)] sm:absolute sm:right-0 sm:top-0 sm:block sm:w-[76%]">
          <div class="aspect-[4/3] overflow-hidden rounded-[1.1rem] bg-stone-100">
            <img src="/linen_coord_thumb.png" alt="Linen co-ord apparel product card" class="h-full w-full object-cover" loading="eager" decoding="async" />
          </div>
          <div class="mt-3 flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-semibold text-stone-950">Linen Co-ord Set</p>
              <p class="mt-1 text-[11px] font-medium text-stone-500">Size, color, delivery</p>
            </div>
            <span class="rounded-full bg-primary-50 px-2.5 py-1 text-[10px] font-semibold text-primary-700">Matched</span>
          </div>
        </div>

        <div class="kinetic-card relative rounded-[1.45rem] bg-[radial-gradient(circle_at_18%_0%,rgba(255,255,255,0.16),transparent_38%),linear-gradient(135deg,#283957,#536f9f)] p-4 text-white shadow-[0_26px_80px_rgba(40,57,87,0.22)] sm:absolute sm:left-0 sm:top-24 sm:w-[78%]">
          <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-stone-400">Checkout draft</p>
          <p class="mt-2 text-sm font-semibold leading-snug">"Yes. Size M is in stock in ivory. Delivery to Delhi 110024 works."</p>
          <div class="mt-4 rounded-2xl bg-white/10 p-3">
            <p class="text-[11px] font-medium leading-relaxed text-stone-300">VoluChat collects cart items, variants, and address before the store sends payment details.</p>
          </div>
        </div>

        <div class="relative grid gap-2 rounded-[1.35rem] border border-stone-200/70 bg-white/88 p-3 shadow-[0_18px_55px_rgba(28,25,23,0.09)] sm:absolute sm:bottom-0 sm:left-3 sm:right-0 sm:grid-cols-3">
          <div class="kinetic-card rounded-2xl bg-primary-50/80 p-3">
            <p class="mini-label">Size match</p>
            <p class="mt-1 text-sm font-semibold text-stone-950">M in stock</p>
          </div>
          <div class="kinetic-card rounded-2xl bg-primary-50/70 p-3">
            <p class="mini-label">Saved context</p>
            <p class="mt-1 text-sm font-semibold text-stone-950">Ivory, PIN</p>
          </div>
          <div class="kinetic-card rounded-2xl bg-sky-soft/80 p-3">
            <p class="mini-label">WhatsApp</p>
            <p class="mt-1 text-sm font-semibold text-stone-950">Text ready</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
