<div class="hero-stage relative min-h-[420px] overflow-hidden rounded-[2.25rem] bg-[linear-gradient(145deg,rgba(255,255,255,0.9),rgba(232,237,244,0.72))] p-2 shadow-[0_34px_120px_rgba(28,25,23,0.13)] sm:min-h-[500px] lg:min-h-[530px]">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_0%,rgba(83,111,159,0.13),transparent_34%),radial-gradient(circle_at_14%_82%,rgba(203,217,234,0.22),transparent_32%),radial-gradient(circle_at_52%_45%,rgba(174,191,215,0.12),transparent_36%)]"></div>
  <canvas id="automation-scene" class="absolute inset-0 z-0 h-full w-full opacity-80" aria-label="3D automation scene showing product questions routed into AI replies"></canvas>

  <div class="relative z-10 h-full min-h-[404px] overflow-hidden rounded-[1.85rem] border border-white/90 bg-[#fcfdff] p-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.95),inset_0_-24px_70px_rgba(120,113,108,0.08)] sm:min-h-[480px] sm:p-5 lg:min-h-[510px]">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(90deg,rgba(255,255,255,0.88),transparent_58%),radial-gradient(circle_at_76%_42%,rgba(83,111,159,0.08),transparent_33%),radial-gradient(circle_at_16%_18%,rgba(243,247,251,0.86),transparent_30%)]"></div>

    <div class="relative z-10 flex items-center justify-between rounded-[1.25rem] border border-stone-200/70 bg-white/88 px-4 py-3 text-[11px] font-semibold text-stone-600 shadow-[0_18px_50px_rgba(68,64,60,0.08)]">
      <span>Live reply automation</span>
      <span class="inline-flex items-center gap-2 text-stone-950">
        <span class="h-2 w-2 rounded-full bg-primary-500 shadow-[0_0_16px_rgba(83,111,159,0.55)]"></span>
        Active
      </span>
    </div>

    <div class="relative z-10 mt-4 grid gap-3 sm:gap-4 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="space-y-3">
        <div class="kinetic-card motion-orbit rounded-[1.35rem] border border-stone-200/70 bg-white/92 p-4 shadow-[0_20px_60px_rgba(28,25,23,0.10)]">
          <div class="flex items-center justify-between gap-3">
            <p class="mini-label">Incoming question</p>
            <span class="rounded-full bg-primary-50 px-2.5 py-1 text-[10px] font-semibold text-primary-700">Instagram DM</span>
          </div>
          <p class="mt-3 text-sm font-semibold leading-snug text-stone-950">"Is the premium sneaker available in UK 9?"</p>
          <div class="mt-4 flex items-center gap-3 rounded-2xl bg-[linear-gradient(135deg,rgba(243,247,251,0.86),rgba(255,255,255,0.72))] p-3">
            <img src="/white_runner_thumb.webp" alt="White runner sneaker used in an automated product availability check" class="h-12 w-12 rounded-xl object-cover" loading="eager" decoding="async" />
            <div>
              <p class="text-xs font-semibold text-stone-950">Cloud Runner 02</p>
              <p class="mt-1 text-[11px] font-medium text-stone-500">Catalog match: UK 9 in stock</p>
            </div>
          </div>
        </div>

        <div class="rounded-[1.35rem] border border-stone-200/70 bg-white/80 p-4 shadow-[0_16px_44px_rgba(28,25,23,0.07)]">
          <p class="mini-label">Channels</p>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <span class="rounded-full bg-[linear-gradient(135deg,#283957,#425b87)] px-3 py-2 text-center text-[11px] font-semibold text-white shadow-sm shadow-primary-800/10">Instagram</span>
            <span class="rounded-full bg-[linear-gradient(135deg,#f3f7fb,#e5edf6)] px-3 py-2 text-center text-[11px] font-semibold text-primary-800">Facebook Page</span>
          </div>
          <p class="mt-4 text-xs font-medium leading-relaxed text-stone-500">New questions are checked against product, delivery, offer, and handoff context.</p>
        </div>
      </div>

      <div class="relative grid gap-3 sm:block sm:min-h-[350px] lg:min-h-[438px]">
        <div class="hidden rounded-[1.45rem] border border-stone-200/70 bg-white/92 p-3 shadow-[0_24px_70px_rgba(28,25,23,0.10)] sm:absolute sm:right-0 sm:top-0 sm:block sm:w-[76%]">
          <div class="aspect-[4/3] overflow-hidden rounded-[1.1rem] bg-stone-100">
            <img src="/white_runner_thumb.webp" alt="Premium sneaker product card" class="h-full w-full object-cover" loading="eager" decoding="async" />
          </div>
          <div class="mt-3 flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-semibold text-stone-950">Cloud Runner 02</p>
              <p class="mt-1 text-[11px] font-medium text-stone-500">Size, stock, delivery</p>
            </div>
            <span class="rounded-full bg-primary-50 px-2.5 py-1 text-[10px] font-semibold text-primary-700">Matched</span>
          </div>
        </div>

        <div class="kinetic-card motion-orbit motion-orbit-delay relative rounded-[1.45rem] bg-[radial-gradient(circle_at_18%_0%,rgba(255,255,255,0.16),transparent_38%),linear-gradient(135deg,#283957,#536f9f)] p-4 text-white shadow-[0_26px_80px_rgba(40,57,87,0.22)] sm:absolute sm:left-0 sm:top-24 sm:w-[78%]">
          <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-stone-400">Automated reply</p>
          <p class="mt-2 text-sm font-semibold leading-snug">"Yes. UK 9 is in stock. Delivery to Pune 411014 works."</p>
          <div class="mt-4 rounded-2xl bg-white/10 p-3">
            <p class="text-[11px] font-medium leading-relaxed text-stone-300">Staff can edit, approve, or hand off when the buyer asks something unusual.</p>
          </div>
        </div>

        <div class="relative grid gap-2 rounded-[1.35rem] border border-stone-200/70 bg-white/88 p-3 shadow-[0_18px_55px_rgba(28,25,23,0.09)] sm:absolute sm:bottom-0 sm:left-3 sm:right-0 sm:grid-cols-3">
          <div class="kinetic-card rounded-2xl bg-primary-50/80 p-3">
            <p class="mini-label">Replies</p>
            <p class="mt-1 text-sm font-semibold text-stone-950">Instant</p>
          </div>
          <div class="kinetic-card rounded-2xl bg-primary-50/70 p-3">
            <p class="mini-label">Saved context</p>
            <p class="mt-1 text-sm font-semibold text-stone-950">Stock, PIN</p>
          </div>
          <div class="kinetic-card rounded-2xl bg-sky-soft/80 p-3">
            <p class="mini-label">Handoff</p>
            <p class="mt-1 text-sm font-semibold text-stone-950">Ready</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('automation-scene');
  const container = canvas?.closest('.hero-stage');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (canvas instanceof HTMLCanvasElement && container) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 100);
    camera.position.set(0, 0.2, 8.4);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const group = new THREE.Group();
    group.position.set(0.45, -0.08, 0);
    scene.add(group);

    const palette = {
      graphite: 0x1c1917,
      stone: 0xa8a29e,
      slateBlue: 0x536f9f,
      cream: 0xfafaf7,
      white: 0xffffff,
    };

    const keyLight = new THREE.DirectionalLight(0xffffff, 2.8);
    keyLight.position.set(4, 5, 5);
    scene.add(keyLight);
    scene.add(new THREE.AmbientLight(0xfafaf7, 2.2));

    const createPanel = (x, y, z, width, height, color, opacity = 0.7) => {
      const panel = new THREE.Mesh(
        new THREE.BoxGeometry(width, height, 0.045),
        new THREE.MeshStandardMaterial({
          color,
          roughness: 0.48,
          metalness: 0.04,
          transparent: true,
          opacity,
        })
      );
      panel.position.set(x, y, z);
      panel.rotation.set(-0.08, -0.18, 0.025);
      panel.userData.baseY = y;
      group.add(panel);
      return panel;
    };

    const panels = [
      createPanel(-1.75, 1.14, -0.9, 1.72, 0.68, palette.white, 0.62),
      createPanel(0.35, 0.52, -1.25, 1.95, 0.72, palette.cream, 0.68),
      createPanel(1.8, -0.3, -1.05, 1.52, 0.58, palette.white, 0.55),
      createPanel(-0.85, -1.05, -1.45, 2.2, 0.64, palette.white, 0.5),
    ];

    const lineMaterial = new THREE.LineBasicMaterial({
      color: palette.slateBlue,
      transparent: true,
      opacity: 0.36,
    });

    const makeRoute = (points, speed, offset) => {
      const curve = new THREE.CatmullRomCurve3(points);
      const geometry = new THREE.BufferGeometry().setFromPoints(curve.getPoints(80));
      const line = new THREE.Line(geometry, lineMaterial.clone());
      group.add(line);

      const dot = new THREE.Mesh(
        new THREE.SphereGeometry(0.055, 24, 24),
        new THREE.MeshStandardMaterial({
          color: palette.slateBlue,
          roughness: 0.28,
          metalness: 0.16,
          emissive: palette.slateBlue,
          emissiveIntensity: 0.22,
        })
      );
      group.add(dot);
      return { curve, dot, speed, offset };
    };

    const routes = [
      makeRoute([
        new THREE.Vector3(-2.5, 1.12, -0.75),
        new THREE.Vector3(-1.15, 0.92, -1.1),
        new THREE.Vector3(0.15, 0.45, -1.25),
        new THREE.Vector3(1.48, -0.12, -0.92),
      ], 0.16, 0),
      makeRoute([
        new THREE.Vector3(-1.55, -1.05, -1.42),
        new THREE.Vector3(-0.35, -0.5, -1.38),
        new THREE.Vector3(0.65, 0.2, -1.12),
        new THREE.Vector3(2.2, 0.62, -0.84),
      ], 0.12, 0.42),
    ];

    const nodeGeometry = new THREE.BoxGeometry(0.18, 0.18, 0.18);
    const nodes = [
      [-2.45, 1.12, -0.68, palette.graphite],
      [-0.12, 0.46, -1.1, palette.slateBlue],
      [1.48, -0.12, -0.85, palette.graphite],
      [2.22, 0.62, -0.78, palette.stone],
    ].map(([x, y, z, color]) => {
      const node = new THREE.Mesh(
        nodeGeometry,
        new THREE.MeshStandardMaterial({ color, roughness: 0.3, metalness: 0.22 })
      );
      node.position.set(x, y, z);
      node.rotation.set(0.25, 0.45, 0.1);
      group.add(node);
      return node;
    });

    const resize = () => {
      const { width, height } = container.getBoundingClientRect();
      renderer.setSize(width, height, false);
      camera.aspect = width / Math.max(height, 1);
      camera.updateProjectionMatrix();
    };

    const clock = new THREE.Clock();
    let frameId = 0;

    const updateScene = (elapsed) => {
      group.rotation.y = Math.sin(elapsed * 0.2) * 0.045;
      group.rotation.x = Math.sin(elapsed * 0.18) * 0.018;

      panels.forEach((panel, index) => {
        panel.position.y = panel.userData.baseY + Math.sin(elapsed * 0.72 + index * 0.9) * 0.035;
      });

      nodes.forEach((node, index) => {
        node.rotation.x = elapsed * (0.18 + index * 0.03);
        node.rotation.y = elapsed * (0.22 + index * 0.04);
      });

      routes.forEach((route) => {
        const progress = (elapsed * route.speed + route.offset) % 1;
        route.dot.position.copy(route.curve.getPoint(progress));
      });
    };

    const renderStill = () => {
      resize();
      updateScene(0.8);
      renderer.render(scene, camera);
    };

    const animate = () => {
      const elapsed = clock.getElapsedTime();
      updateScene(elapsed);
      renderer.render(scene, camera);
      frameId = requestAnimationFrame(animate);
    };

    resize();
    window.addEventListener('resize', resize);

    if (reducedMotion.matches) {
      renderStill();
    } else {
      animate();
    }

    reducedMotion.addEventListener('change', () => {
      cancelAnimationFrame(frameId);
      if (reducedMotion.matches) {
        renderStill();
      } else {
        animate();
      }
    });
  }
</script>
