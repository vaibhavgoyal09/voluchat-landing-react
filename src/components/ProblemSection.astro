---
const painPoints = [
  {
    code: "P01",
    title: "Stock questions go unanswered",
    description:
      "Buyers want sizing, material, and availability answers before purchasing, but your team is busy.",
  },
  {
    code: "P02",
    title: "Cart recovery stalls",
    description:
      "High-intent shoppers ask for help, then leave before anyone sends a timely follow-up.",
  },
  {
    code: "P03",
    title: "Old stock sits too long",
    description:
      "Slow-moving SKUs keep tying up cash because targeted clearance work takes too much manual effort.",
  },
  {
    code: "P04",
    title: "Upsell moments get missed",
    description:
      "Customers check out before seeing the matching accessory or add-on that fits their exact order.",
  },
  {
    code: "P05",
    title: "Campaigns need too much prep",
    description:
      "Targeted follow-ups still depend on exports, filters, and guesswork across disconnected tools.",
  },
  {
    code: "P06",
    title: "Revenue leaks stay hidden",
    description:
      "Teams see the symptoms, but not the exact moments where missed replies, weak follow-up, or idle inventory cost revenue.",
  },
];
---

<section
  id="problem"
  class="section-band-quiet py-24 lg:py-32 relative overflow-hidden"
>
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
  >
  </div>

  <div class="page-shell">
    <div class="max-w-3xl reveal-on-scroll reveal-up">
      <div class="chip mb-6">
        <span class="mini-label">The Growth Trap</span>
      </div>
      <h2 class="section-title text-white">
        Growing stores hit an <span class="gradient-text-anim">operations wall</span>
      </h2>
      <p class="section-copy mt-6 max-w-2xl text-slate-300">
        As order volume grows, the work becomes harder to catch: repeated product questions, delayed cart follow-ups, idle inventory, and customer updates spread across tools.
      </p>
    </div>

    <!-- 12-Column Balanced Bento Grid -->
    <div class="mt-16 grid gap-6 grid-cols-1 md:grid-cols-12">
      {
        painPoints.map((point, index) => {
          let colClass = "col-span-full";
          let cardBgClass = "bg-[#101b2b]/90 hover:bg-[#142438]";
          let codeColor = "text-slate-500";

          if (index === 0) {
            // Same product questions (Row 1 Left) - Rose accent border & warm gradient
            colClass = "col-span-full md:col-span-6 lg:col-span-6";
            cardBgClass =
              "bg-gradient-to-br from-[#101b2b] to-[#45121b]/20 border border-rose-500/10 hover:border-rose-400/25";
            codeColor = "text-rose-400";
          } else if (index === 1) {
            // Abandoned carts (Row 1 Right) - Amber accent border & warm gradient
            colClass = "col-span-full md:col-span-6 lg:col-span-6";
            cardBgClass =
              "bg-gradient-to-br from-[#101b2b] to-[#452a0a]/20 border border-amber-500/10 hover:border-amber-400/25";
            codeColor = "text-amber-400";
          } else if (index === 2) {
            // Slow-moving stock (Row 2 Left)
            colClass = "col-span-full md:col-span-6 lg:col-span-4";
          } else if (index === 3) {
            // Missed upsell moments (Row 2 Middle)
            colClass = "col-span-full md:col-span-6 lg:col-span-4";
          } else if (index === 4) {
            // Manual campaigns (Row 2 Right)
            colClass = "col-span-full md:col-span-12 lg:col-span-4";
          } else if (index === 5) {
            // No view of leaks (Row 3 Full Width with visual dashboard mockup)
            colClass = "col-span-full";
            cardBgClass =
              "bg-gradient-to-br from-[#101b2b] to-[#45121b]/25 border border-red-500/10 hover:border-red-400/25";
            codeColor = "text-red-400";
          }

          return (
            <div
              class={`spotlight reveal-on-scroll reveal-scale flex flex-col justify-between rounded-3xl border border-white/10 ${cardBgClass} p-6 sm:p-8 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-slate-400/35 ${colClass} reveal-delay-${(index % 3) * 100} shadow-[0_24px_70px_-54px_rgba(0,0,0,0.85)]`}
            >
              {index === 5 ? (
                // Custom layout for P06 (Leak Detection) with visual disconnect mockup
                <div class="grid gap-8 lg:grid-cols-[1.25fr_1fr] lg:items-center w-full h-full">
                  <div class="flex flex-col justify-between h-full">
                    <div>
                      <div class="mb-5 flex items-center justify-between">
                        <span
                          class={`font-mono text-xs font-semibold ${codeColor}`}
                        >
                          {point.code}
                        </span>
                        <span class="text-[11px] font-bold uppercase tracking-[0.16em] text-red-300">
                          Hidden leak
                        </span>
                      </div>
                      <h3 class="mb-3 text-2xl font-bold text-white font-heading">
                        {point.title}
                      </h3>
                      <p class="text-base font-medium leading-relaxed text-slate-300">
                        {point.description}
                      </p>
                    </div>
                  </div>

                  {/* Visual disconnect table */}
                  <div class="flex flex-col gap-2.5 rounded-2xl border border-white/5 bg-black/35 p-5 font-mono text-[11px] text-slate-400 shadow-inner">
                    <div class="flex items-center justify-between rounded-lg border border-dashed border-red-500/20 bg-red-950/10 px-3 py-2 text-red-300">
                      <span>Shopify Inventory Catalog</span>
                      <span class="font-bold text-[9px] uppercase tracking-wider bg-red-500/15 px-2 py-0.5 rounded border border-red-500/20">
                        Siloed
                      </span>
                    </div>
                    <div class="flex items-center justify-center py-0.5">
                      <span class="text-[10px] text-red-500/50 font-bold">
                        Missed signal
                      </span>
                    </div>
                    <div class="flex items-center justify-between rounded-lg border border-dashed border-red-500/20 bg-red-950/10 px-3 py-2 text-red-300">
                      <span>Instagram DMs & Customer Chats</span>
                      <span class="font-bold text-[9px] uppercase tracking-wider bg-red-500/15 px-2 py-0.5 rounded border border-red-500/20">
                        Manual Handoff
                      </span>
                    </div>
                    <div class="flex items-center justify-center py-0.5">
                      <span class="text-[10px] text-red-500/50 font-bold">
                        Manual handoff
                      </span>
                    </div>
                    <div class="flex items-center justify-between rounded-lg border border-dashed border-red-500/20 bg-red-950/10 px-3 py-2 text-red-300">
                      <span>WhatsApp Order Confirmation</span>
                      <span class="font-bold text-[9px] uppercase tracking-wider bg-red-500/15 px-2 py-0.5 rounded border border-red-500/20">
                        Offline
                      </span>
                    </div>
                  </div>
                </div>
              ) : (
                // Standard layout for other cards
                <div class="flex flex-col h-full justify-between">
                  <div>
                    <div class="mb-6 flex items-center justify-between">
                      <span
                        class={`font-mono text-xs font-semibold ${codeColor}`}
                      >
                        {point.code}
                      </span>
                      {index === 0 && <span class="rounded bg-rose-500/10 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-rose-300 border border-rose-500/20">Time Drain</span>}
                      {index === 1 && <span class="rounded bg-amber-500/10 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-amber-300 border border-amber-500/20">Revenue Loss</span>}
                      {index > 1 && <span class="h-px w-12 bg-white/10" />}
                    </div>
                    
                    {index === 0 && (
                      <div class="mb-6 flex flex-col gap-2 rounded-xl bg-black/20 p-4 border border-white/5">
                        <div class="w-3/4 rounded-lg rounded-tl-none bg-[#1e293b]/80 p-2 text-[10px] text-slate-300">Are the matching joggers in stock?</div>
                        <div class="w-3/4 rounded-lg rounded-tl-none bg-[#1e293b]/80 p-2 text-[10px] text-slate-300">Do you ship to Toronto?</div>
                        <div class="w-3/4 rounded-lg rounded-tl-none bg-[#1e293b]/80 p-2 text-[10px] text-slate-300">How do I return this?</div>
                        <div class="w-full text-right mt-1"><span class="text-[9px] text-rose-400 uppercase tracking-widest font-bold animate-pulse">Waiting for reply...</span></div>
                      </div>
                    )}

                    {index === 1 && (
                      <div class="mb-6 flex items-end gap-2 h-20 border-b border-white/10 pb-2">
                        <div class="w-1/4 bg-amber-500/80 rounded-t h-full"></div>
                        <div class="w-1/4 bg-amber-500/60 rounded-t h-4/5"></div>
                        <div class="w-1/4 bg-amber-500/40 rounded-t h-2/5 relative">
                          <div class="absolute -top-6 -right-4 text-xs font-bold text-amber-400 bg-amber-950/80 px-2 py-0.5 rounded shadow-lg border border-amber-500/30 whitespace-nowrap">-68% Drop-off</div>
                        </div>
                        <div class="w-1/4 bg-amber-500/20 rounded-t h-1/5"></div>
                      </div>
                    )}

                    {index === 3 && (
                      <div class="mb-6 flex items-center gap-4 rounded-xl bg-black/20 p-3 border border-white/5">
                        <div class="h-12 w-12 rounded bg-slate-800 border border-white/10 overflow-hidden">
                          <img src="/about_hero.webp" alt="Product" class="w-full h-full object-cover opacity-60" />
                        </div>
                        <div>
                          <div class="text-[10px] text-teal-400 uppercase font-bold tracking-widest mb-1">Missed Add-on</div>
                          <div class="text-xs text-white">Matching Leather Strap</div>
                          <div class="text-xs text-slate-400 mt-0.5">+ ₹2,499 value</div>
                        </div>
                      </div>
                    )}

                    <h3 class="mb-3 text-lg font-bold text-white font-heading">
                      {point.title}
                    </h3>
                    <p class="text-sm font-medium leading-relaxed text-slate-300">
                      {point.description}
                    </p>
                  </div>
                </div>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
