---
const supportingPoints = [
  {
    code: "LEAK 01",
    stat: "55%",
    statLabel: "Midnight Browsing",
    title: "11 PM Leads Go Cold",
    description: "Shoppers comment 'Price?' late at night when manual reps are offline. By morning, they've bought elsewhere.",
  },
  {
    code: "LEAK 02",
    stat: "35%",
    statLabel: "COD Returns (RTO)",
    title: "Unverified Impulse Orders",
    description: "Orders placed without sizing verification or UPI prepayment incentives result in costly return-to-origin shipments.",
  },
];
---

<section
  id="problem"
  class="relative overflow-hidden py-20 sm:py-24 bg-[#000000]"
>
  <div class="page-shell">
    <div class="max-w-3xl mb-14">
      <div class="chip mb-4">
        <span class="mini-label text-rose-400">The Fashion DM Revenue Leak</span>
      </div>
      <h2 class="section-title text-[#fcfdff] font-heading">
        Where clothing brands <span class="text-rose-400">lose 60%+ of social buyers</span>.
      </h2>
      <p class="section-copy mt-3">
        Manual chat reps and rigid flowchart bots fail when buyers are ready to purchase.
      </p>
    </div>

    <!-- Asymmetric 2-Column Problem Layout: 1 Killer Hero Stat + 2 Supporting Evidence Cards -->
    <div class="grid gap-6 lg:grid-cols-[1.3fr_1fr] items-stretch">
      <!-- Dominant Killer Statistic Card -->
      <article class="reveal-on-scroll rounded-2xl border border-rose-500/30 bg-gradient-to-b from-[#160b0e] via-[#0d0709] to-[#0a0a0c] p-8 sm:p-10 flex flex-col justify-between hover:border-rose-500/50 transition-all shadow-2xl relative overflow-hidden">
        <!-- Subtle background glow -->
        <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-rose-500/10 blur-3xl pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between border-b border-rose-500/20 pb-4 mb-8">
            <span class="font-mono text-xs text-rose-400 font-bold uppercase tracking-wider">Primary Revenue Leak</span>
            <span class="rounded-full border border-rose-500/30 bg-rose-500/10 px-3 py-1 font-mono text-xs text-rose-300 font-medium">
              Cart Drop-Off
            </span>
          </div>

          <!-- Hero Number -->
          <div class="font-heading text-6xl sm:text-7xl lg:text-8xl font-black text-white tracking-tight leading-none mb-4">
            68<span class="text-rose-400">%</span>
          </div>

          <h3 class="font-heading text-2xl sm:text-3xl font-bold text-white leading-tight mb-3">
            of Instagram DM shoppers drop off before completing website checkout.
          </h3>

          <p class="text-sm sm:text-base text-rose-200/80 font-normal leading-relaxed max-w-lg">
            Sending interested DM buyers to a slow 5-step web cart destroys impulse buying. VoluChat qualifies their size and closes UPI checkout directly inside the conversation.
          </p>
        </div>

        <div class="mt-8 pt-6 border-t border-rose-500/20 flex items-center justify-between text-xs font-mono text-rose-300/80">
          <span>Cause: External Website Friction</span>
          <span class="font-bold text-rose-400">Solution: In-Chat UPI</span>
        </div>
      </article>

      <!-- 2 Stacked Supporting Evidence Cards -->
      <div class="grid gap-6 flex-col justify-between">
        {
          supportingPoints.map((point, idx) => (
            <article class={`reveal-on-scroll reveal-delay-${idx + 1} rounded-2xl border border-white/[0.10] bg-[#0a0a0c] p-6 sm:p-8 flex flex-col justify-between hover:border-white/20 transition-all`}>
              <div>
                <div class="flex items-center justify-between border-b border-white/[0.06] pb-3 mb-4">
                  <span class="font-mono text-xs text-slate-500 font-bold">{point.code}</span>
                  <span class="font-mono text-xs text-slate-400 uppercase">{point.statLabel}</span>
                </div>
                <div class="font-heading text-4xl font-bold text-white tracking-tight mb-2">
                  {point.stat}
                </div>
                <h3 class="font-heading text-lg font-semibold text-white">
                  {point.title}
                </h3>
                <p class="mt-2 text-xs text-[rgba(252,253,255,0.7)] font-normal leading-relaxed">
                  {point.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
