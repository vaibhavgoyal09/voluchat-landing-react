---
const chaosPoints = [
  {
    title: "11 PM – 2 AM leads go cold",
    desc: "Shopper asks 'Price?' on a viral Reel at midnight. Your team replies at 10 AM — she's already bought elsewhere.",
  },
  {
    title: "Sizing confusion kills checkout",
    desc: "Back-and-forth on 'bust size kya hai?' with blurry size-chart photos. 60%+ abandon mid-chat.",
  },
  {
    title: "UPI screenshot chasing",
    desc: "Manual UPI IDs, hours waiting for GPay screenshots, fake receipts and COD RTO.",
  },
  {
    title: "WISMO buries real buyers",
    desc: "'Where is my parcel?' DMs drown out new shoppers while staff hunt courier numbers.",
  },
];

const autopilotPoints = [
  {
    title: "2-second comment-to-DM",
    desc: "Every 'Price?' gets pricing, photos and a DM in 2s — before she scrolls away.",
  },
  {
    title: "AI stylist, exact size match",
    desc: "Bust, waist, length understood per outfit. Right fit recommended in seconds.",
  },
  {
    title: "1-click UPI checkout in chat",
    desc: "Direct GPay / PhonePe link, address collected, order confirmed automatically.",
  },
  {
    title: "Live tracking in 3 seconds",
    desc: "Delhivery / Shiprocket status answered on WhatsApp. Zero WISMO tickets.",
  },
];
---

<section id="problem" class="relative scroll-mt-28 py-20 sm:py-24">
  <div class="page-shell relative z-10">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
    <div class="lg:sticky lg:top-28 lg:self-start text-center lg:text-left">
      <p class="section-eyebrow">The boutique reality</p>
      <h2 class="mt-4 text-4xl sm:text-5xl leading-[1.05]">
        Your customers don't stop messaging <em class="serif-accent">when you stop working</em>.
      </h2>
      <p class="section-copy mt-5">
        Manual selling leaks night orders. VoluChat closes them 24/7 on Instagram, Messenger and WhatsApp.
      </p>
      <a href="/free-trial" class="btn-primary mt-7 hidden lg:inline-flex">Start My 30-Day Free Trial &rarr;</a>
    </div>

    <div class="space-y-5">
      <div class="rounded-[20px] border border-slate-900/[0.07] bg-[#fffdf9] p-7 sm:p-8">
        <p class="mini-label text-slate-500">Manual selling</p>
        <h3 class="mt-1 text-2xl">The DM revenue leak</h3>
        <ul class="mt-6">
          {
            chaosPoints.map((item, i) => (
              <li class="border-t border-slate-900/[0.07] py-4 first:border-t-0 first:pt-0 last:pb-0">
                <p class="text-[15px] font-semibold text-slate-900">
                  <span class="mr-2 font-mono text-xs font-bold text-slate-400">0{i + 1}</span>
                  {item.title}
                </p>
                <p class="mt-1 text-sm leading-relaxed text-slate-600">{item.desc}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-[20px] border border-emerald-600/25 bg-[#fffefb] p-7 sm:p-8">
        <p class="mini-label text-emerald-700">With VoluChat · 24/7 active</p>
        <h3 class="mt-1 text-2xl">Autonomous autopilot</h3>
        <ul class="mt-6">
          {
            autopilotPoints.map((item, i) => (
              <li class="border-t border-emerald-900/10 py-4 first:border-t-0 first:pt-0 last:pb-0">
                <p class="text-[15px] font-semibold text-slate-900">
                  <span class="mr-2 font-mono text-xs font-bold text-emerald-600">0{i + 1}</span>
                  {item.title}
                </p>
                <p class="mt-1 text-sm leading-relaxed text-slate-600">{item.desc}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    </div>
  </div>
</section>
