---
const painPoints = [
  {
    code: "LEAK 01",
    title: "11 PM DM Leads Go Cold",
    description: "40%+ of social shopping happens at night. By the time human reps reply the next morning, impulse buyers have already purchased elsewhere.",
    tone: "text-rose-400 border-rose-500/20 bg-rose-500/10",
  },
  {
    code: "LEAK 02",
    title: "Viral Reel Comment Backlog",
    description: "A reel hits 50k views and generates 400 'Price please' comments. Manual teams take 8 hours to DM them, losing 85% of warm intent.",
    tone: "text-amber-400 border-amber-500/20 bg-amber-500/10",
  },
  {
    code: "LEAK 03",
    title: "Rigid Flowchart Chatbot Fatigue",
    description: "Tools like Wati force buyers through robotic 'Press 1' menus. Shoppers want to ask about sizing, custom colors, and delivery timelines.",
    tone: "text-emerald-400 border-emerald-500/20 bg-emerald-500/10",
  },
  {
    code: "LEAK 04",
    title: "Drop-off at External Checkout Links",
    description: "Sending customers a website link breaks the conversational vibe. 70% of shoppers drop off rather than navigating a browser checkout.",
    tone: "text-indigo-400 border-indigo-500/20 bg-indigo-500/10",
  },
  {
    code: "LEAK 05",
    title: "Expensive Rep Churn & Errors",
    description: "Hiring 2-3 chat reps means endless training, manual bank detail errors, and missed upsells when chat queues spike.",
    tone: "text-teal-400 border-teal-500/20 bg-teal-500/10",
  },
  {
    code: "LEAK 06",
    title: "High COD Return Rates (RTO)",
    description: "Orders placed without real-time address validation or conversational confirmation result in 30%+ failed delivery returns.",
    tone: "text-red-400 border-red-500/20 bg-red-500/10",
  },
];
---

<section
  id="problem"
  class="section-band-quiet relative overflow-hidden py-14 lg:py-20"
>
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
  >
  </div>

  <div class="page-shell">
    <div class="problem-header max-w-3xl opacity-0">
      <div class="chip mb-5">
        <span class="mini-label">The Social Commerce Trap</span>
      </div>
      <h2 class="section-title text-white">
        Where D2C brands <span class="gradient-text-anim">lose 50%+ of social revenue</span>
      </h2>
      <p class="section-copy mt-5 max-w-2xl text-slate-300">
        You spend lakhs driving Instagram traffic, but your manual chat reps and rigid button chatbots cannot close buyers in the exact moment they want to purchase.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        painPoints.map((point) => (
          <article
            class="problem-card group relative flex flex-col justify-start py-2 pl-6 border-l-2 border-white/10 transition-colors duration-300 hover:border-emerald-500/60 opacity-0"
          >
            <div class="mb-3 flex items-center gap-3">
              <span class="font-mono text-xs font-bold text-slate-500">
                {point.code}
              </span>
              <span
                class={`rounded px-2 py-0.5 text-[9px] font-bold uppercase tracking-[0.14em] ${point.tone}`}
              >
                Revenue Leak
              </span>
            </div>

            <h3 class="font-heading text-lg font-bold text-white group-hover:text-emerald-50 transition-colors">
              {point.title}
            </h3>
            <p class="mt-2.5 text-sm font-medium leading-relaxed text-slate-400">
              {point.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#problem",
        start: "top 78%",
      }
    });

    tl.fromTo(
      ".problem-header",
      { opacity: 0, x: -30 },
      { opacity: 1, x: 0, duration: 0.6, ease: "power3.out" }
    )
    .fromTo(
      ".problem-card",
      { opacity: 0, y: 30, filter: "blur(4px)" },
      {
        opacity: 1,
        y: 0,
        filter: "blur(0px)",
        duration: 0.5,
        stagger: {
          grid: [2, 3],
          from: "start",
          amount: 0.35,
        },
        ease: "power2.out",
      },
      "-=0.3"
    );
  });
</script>
