---
const painPoints = [
  {
    code: "P01",
    title: "Same product questions every day",
    description:
      "Your team spends hours answering repetitive questions about sizing, materials, and stock instead of doing high-value work.",
  },
  {
    code: "P02",
    title: "Abandoned carts with no follow-up",
    description:
      "Carts sit empty without timely outreach, leaving easy revenue on the table because manual messaging is too slow.",
  },
  {
    code: "P03",
    title: "Slow-moving stock sitting idle",
    description:
      "Old inventory takes up space and ties up capital because launching targeted clearance campaigns takes too much effort.",
  },
  {
    code: "P04",
    title: "Missed upsell moments",
    description:
      "Customers check out without seeing the perfect matching accessory because upsells require smart, context-aware suggestions.",
  },
  {
    code: "P05",
    title: "Manual customer campaigns",
    description:
      "Running targeted campaigns depends on messy, manual CSV exports and guesswork. Operations feel disconnected and slow.",
  },
  {
    code: "P06",
    title: "No clear view of revenue leaks",
    description:
      "Founders cannot clearly see where money is leaking across the customer journey because the data lives in too many places.",
  },
];
---

<section
  id="problem"
  class="section-band-quiet py-24 lg:py-32 relative overflow-hidden"
>
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
  >
  </div>

  <div class="page-shell">
    <!-- Stacked Header (Compliant with split-header ban) -->
    <div class="max-w-3xl reveal-on-scroll reveal-up">
      <div class="chip mb-6">
        <span class="mini-label">The Growth Trap</span>
      </div>
      <h2 class="section-title text-white">
        Your store grows.<br class="hidden sm:inline" />
        <span class="gradient-text-anim"
          >Then the manual work grows faster.</span
        >
      </h2>
      <p class="section-copy mt-6 max-w-2xl text-slate-300">
        Every missed reply, abandoned cart, stale product, and late follow-up
        becomes a small leak. At scale, those leaks become a revenue system your
        team cannot manually hold together.
      </p>
    </div>

    <!-- 12-Column Balanced Bento Grid -->
    <div class="mt-16 grid gap-6 grid-cols-1 md:grid-cols-12">
      {
        painPoints.map((point, index) => {
          let colClass = "col-span-full";
          let cardBgClass = "bg-[#101b2b]/90 hover:bg-[#142438]";
          let codeColor = "text-slate-500";

          if (index === 0) {
            // Same product questions (Row 1 Left) - Rose accent border & warm gradient
            colClass = "col-span-full md:col-span-6 lg:col-span-6";
            cardBgClass =
              "bg-gradient-to-br from-[#101b2b] to-[#45121b]/20 border border-rose-500/10 hover:border-rose-400/25";
            codeColor = "text-rose-400";
          } else if (index === 1) {
            // Abandoned carts (Row 1 Right) - Amber accent border & warm gradient
            colClass = "col-span-full md:col-span-6 lg:col-span-6";
            cardBgClass =
              "bg-gradient-to-br from-[#101b2b] to-[#452a0a]/20 border border-amber-500/10 hover:border-amber-400/25";
            codeColor = "text-amber-400";
          } else if (index === 2) {
            // Slow-moving stock (Row 2 Left)
            colClass = "col-span-full md:col-span-6 lg:col-span-4";
          } else if (index === 3) {
            // Missed upsell moments (Row 2 Middle)
            colClass = "col-span-full md:col-span-6 lg:col-span-4";
          } else if (index === 4) {
            // Manual campaigns (Row 2 Right)
            colClass = "col-span-full md:col-span-12 lg:col-span-4";
          } else if (index === 5) {
            // No view of leaks (Row 3 Full Width with visual dashboard mockup)
            colClass = "col-span-full";
            cardBgClass =
              "bg-gradient-to-br from-[#101b2b] to-[#45121b]/25 border border-red-500/10 hover:border-red-400/25";
            codeColor = "text-red-400";
          }

          return (
            <div
              class={`spotlight reveal-on-scroll reveal-scale flex flex-col justify-between rounded-3xl border border-white/10 ${cardBgClass} p-6 sm:p-8 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-slate-400/35 ${colClass} reveal-delay-${(index % 3) * 100} shadow-[0_24px_70px_-54px_rgba(0,0,0,0.85)]`}
            >
              {index === 5 ? (
                // Custom layout for P06 (Leak Detection) with visual disconnect mockup
                <div class="grid gap-8 lg:grid-cols-[1.25fr_1fr] lg:items-center w-full">
                  <div>
                    <div class="mb-5 flex items-center justify-between">
                      <span
                        class={`font-mono text-xs font-semibold ${codeColor}`}
                      >
                        {point.code}
                      </span>
                      <span class="text-[11px] font-bold uppercase tracking-[0.16em] text-red-300">
                        The Ultimate Leak
                      </span>
                    </div>
                    <h3 class="mb-3 text-2xl font-bold text-white font-heading">
                      {point.title}
                    </h3>
                    <p class="text-base font-medium leading-relaxed text-slate-300">
                      {point.description}
                    </p>
                  </div>

                  {/* Visual disconnect table */}
                  <div class="flex flex-col gap-2.5 rounded-2xl border border-white/5 bg-black/35 p-5 font-mono text-[11px] text-slate-400 shadow-inner">
                    <div class="flex items-center justify-between rounded-lg border border-dashed border-red-500/20 bg-red-950/10 px-3 py-2 text-red-300">
                      <span>Shopify Inventory Catalog</span>
                      <span class="font-bold text-[9px] uppercase tracking-wider bg-red-500/15 px-2 py-0.5 rounded border border-red-500/20">
                        Siloed
                      </span>
                    </div>
                    <div class="flex items-center justify-center py-0.5">
                      <span class="text-[10px] text-red-500/50 font-bold">
                        ✕ Connection Broken
                      </span>
                    </div>
                    <div class="flex items-center justify-between rounded-lg border border-dashed border-red-500/20 bg-red-950/10 px-3 py-2 text-red-300">
                      <span>Instagram DMs & Customer Chats</span>
                      <span class="font-bold text-[9px] uppercase tracking-wider bg-red-500/15 px-2 py-0.5 rounded border border-red-500/20">
                        Manual Handoff
                      </span>
                    </div>
                    <div class="flex items-center justify-center py-0.5">
                      <span class="text-[10px] text-red-500/50 font-bold">
                        ✕ Manual Copy-Paste
                      </span>
                    </div>
                    <div class="flex items-center justify-between rounded-lg border border-dashed border-red-500/20 bg-red-950/10 px-3 py-2 text-red-300">
                      <span>WhatsApp Order Confirmation</span>
                      <span class="font-bold text-[9px] uppercase tracking-wider bg-red-500/15 px-2 py-0.5 rounded border border-red-500/20">
                        Offline
                      </span>
                    </div>
                  </div>
                </div>
              ) : (
                // Standard layout
                <>
                  <div class="mb-6 flex items-center justify-between">
                    <span
                      class={`font-mono text-xs font-semibold ${codeColor}`}
                    >
                      {point.code}
                    </span>
                    <span class="h-px w-12 bg-white/10" />
                  </div>
                  <h3 class="mb-3 text-lg font-bold text-white font-heading">
                    {point.title}
                  </h3>
                  <p class="text-sm font-medium leading-relaxed text-slate-300">
                    {point.description}
                  </p>
                </>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
