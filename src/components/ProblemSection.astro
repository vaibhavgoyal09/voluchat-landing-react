---
const chaosPoints = [
  {
    icon: "🌙",
    title: "11:00 PM - 2:00 AM Leads Go Cold",
    desc: "Shopper asks 'Price?' on a viral Reel at midnight. By the time your team wakes up at 10 AM, the buyer has purchased from another boutique.",
    impact: "-45% Lost Night Revenue",
    leak: "6-8h Response Delay",
  },
  {
    icon: "📏",
    title: "Sizing Confusion & DM Drop-off",
    desc: "Back-and-forth messages asking 'Bust size kya hai?' or sending low-res size chart photos causes 60%+ buyers to abandon cart.",
    impact: "60% Abandonment",
    leak: "Manual Sizing Friction",
  },
  {
    icon: "💳",
    title: "Payment Screenshot Chasing",
    desc: "Typing UPI IDs manually and waiting hours for GPay/PhonePe screenshots leads to fake receipts, inventory holds, and high COD RTO.",
    impact: "25% High COD RTO",
    leak: "Fake Screenshot Risk",
  },
  {
    icon: "📦",
    title: "WISMO Courier Inquiries Bury Sales",
    desc: "Dozens of 'Where is my parcel?' messages drown out genuine new buyers, keeping store staff busy looking up courier tracking numbers.",
    impact: "80+ Daily Support DMs",
    leak: "Support Overload",
  },
];

const autopilotPoints = [
  {
    icon: "⚡",
    title: "2-Second Instant Comment-to-DM",
    desc: "Every 'Price?' comment gets an instant reply in 2s with exact pricing, photos, and a DM before the shopper scrolls away.",
    impact: "100% Leads Captured",
    highlight: "2.0s Avg Reply",
  },
  {
    icon: "👗",
    title: "AI Stylist & Exact Size Chart Match",
    desc: "Understands bust, waist, and length measurements for every outfit. Recommends the exact fit variant in seconds.",
    impact: "Zero Sizing Confusion",
    highlight: "Zero Fits Returns",
  },
  {
    icon: "💸",
    title: "1-Click Native UPI Checkout",
    desc: "Generates direct 1-tap Google Pay/PhonePe links in chat with address collection and instant automated order confirmation.",
    impact: "1-Tap In-Chat Pay",
    highlight: "Prepaid UPI Conversion",
  },
  {
    icon: "🚚",
    title: "Live Courier Tracking Lookups",
    desc: "Fetches live parcel status directly from Delhivery, Shiprocket, or BlueDart on WhatsApp in under 3 seconds.",
    impact: "Zero WISMO Tickets",
    highlight: "100% Automated",
  },
];
---

<section
  id="problem"
  class="relative overflow-hidden py-28 sm:py-32 lg:py-36 bg-[#f8fafc] border-t border-slate-200/80"
>
  <div class="page-shell relative z-10">
    <!-- Header -->
    <div class="max-w-3xl mb-16 lg:mb-20">
      <div class="chip mb-4">
        <span class="mini-label text-emerald-600">The Boutique Reality</span>
      </div>
      <h2 class="section-title font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight">
        Your customers don&rsquo;t stop messaging <em class="serif-accent">when you stop working</em>.
      </h2>
      <p class="section-copy mt-5 text-base sm:text-lg text-slate-600 font-normal leading-relaxed">
        See the stark difference between manual selling chaos vs running an autonomous AI Sales Agent that converts shoppers 24/7 across Instagram, Facebook Messenger, and WhatsApp.
      </p>
    </div>

    <!-- Side-by-Side Visual Comparison Cards -->
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-10 items-stretch">
      
      <!-- Card 1: Manual Chaos (The Leak) -->
      <div class="rounded-3xl border border-rose-200 bg-rose-50/40 p-7 sm:p-9 flex flex-col justify-between transition-all duration-300 hover:border-rose-300 relative overflow-hidden group shadow-sm">
        <div>
          <!-- Phase Header -->
          <div class="flex items-center justify-between pb-6 border-b border-rose-200/80 mb-7">
            <div class="flex items-center gap-3">
              <span class="h-8 w-8 rounded-xl bg-rose-100 border border-rose-300 flex items-center justify-center text-rose-600 text-sm font-bold">
                ✕
              </span>
              <div>
                <span class="font-mono text-xs text-rose-600 font-bold uppercase tracking-wider block">Manual Selling</span>
                <h3 class="font-heading text-xl sm:text-2xl font-bold text-slate-900">The DM Revenue Leak</h3>
              </div>
            </div>
            <span class="rounded-full border border-rose-300 bg-rose-100 px-3 py-1 font-mono text-[11px] text-rose-700 font-bold">
              60%+ Sales Lost
            </span>
          </div>

          <!-- Items list with visual callouts -->
          <div class="space-y-4">
            {
              chaosPoints.map((item) => (
                <div class="rounded-2xl border border-rose-200/70 bg-white/80 p-4 space-y-1.5 hover:border-rose-300 transition-colors shadow-xs">
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2 font-semibold text-slate-900 text-sm">
                      <span>{item.icon}</span>
                      <span>{item.title}</span>
                    </div>
                    <span class="text-[10px] font-mono text-rose-700 font-bold bg-rose-100 border border-rose-200 px-2 py-0.5 rounded">
                      {item.leak}
                    </span>
                  </div>
                  <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed">
                    {item.desc}
                  </p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-rose-200 flex items-center justify-between text-xs font-mono text-slate-500">
          <span class="text-rose-600 font-semibold">Without AI Sales Agent</span>
          <span class="text-slate-700 font-medium">Overwhelmed & Slow</span>
        </div>
      </div>

      <!-- Card 2: VoluChat Autopilot (The Fix) -->
      <div class="rounded-3xl border border-emerald-500/30 bg-white p-7 sm:p-9 flex flex-col justify-between transition-all duration-300 hover:border-emerald-500/50 shadow-[0_15px_45px_rgba(5,150,105,0.08)] relative overflow-hidden group">
        <div>
          <!-- Phase Header -->
          <div class="flex items-center justify-between pb-6 border-b border-slate-100 mb-7">
            <div class="flex items-center gap-3">
              <span class="h-8 w-8 rounded-xl bg-emerald-100 border border-emerald-300 flex items-center justify-center text-emerald-700 text-sm font-bold">
                ✓
              </span>
              <div>
                <span class="font-mono text-xs text-emerald-600 font-bold uppercase tracking-wider block">With VoluChat</span>
                <h3 class="font-heading text-xl sm:text-2xl font-bold text-slate-900">Autonomous Autopilot</h3>
              </div>
            </div>
            <span class="rounded-full border border-emerald-300 bg-emerald-50 px-3 py-1 font-mono text-[11px] text-emerald-800 font-bold flex items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-ping"></span>
              24/7 Active
            </span>
          </div>

          <!-- Items list with visual callouts -->
          <div class="space-y-4">
            {
              autopilotPoints.map((item) => (
                <div class="rounded-2xl border border-emerald-500/20 bg-emerald-50/30 p-4 space-y-1.5 hover:border-emerald-500/40 transition-colors shadow-xs">
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2 font-semibold text-slate-900 text-sm">
                      <span>{item.icon}</span>
                      <span class="text-slate-900">{item.title}</span>
                    </div>
                    <span class="text-[10px] font-mono text-emerald-800 font-bold bg-emerald-100 border border-emerald-200 px-2 py-0.5 rounded">
                      {item.highlight}
                    </span>
                  </div>
                  <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed">
                    {item.desc}
                  </p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-mono text-slate-600">
          <span class="text-emerald-700 font-bold flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            2.0s Response Time
          </span>
          <span class="text-emerald-800 font-bold">100% Orders Closed In-Chat</span>
        </div>
      </div>

    </div>

    <!-- Methodology / Benchmark footnote -->
    <div class="mt-8 text-center">
      <p class="text-[11px] font-mono text-slate-500">
        *Based on internal pilot benchmarks across 12,000+ customer DM & comment conversations in Indian fashion boutiques.
      </p>
    </div>
  </div>
</section>
