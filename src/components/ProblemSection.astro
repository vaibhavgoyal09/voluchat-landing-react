---
const beforeSaleItems = [
  {
    num: "01",
    title: "Instant Reel Comment-to-DM",
    desc: "When someone asks 'Price?' on your Reel, VoluChat replies in 2 seconds with exact pricing, photos, and a direct DM before they scroll away.",
    tag: "2s Response",
  },
  {
    num: "02",
    title: "Fit & Sizing Consultation",
    desc: "Understands bust, waist, and length measurements for every outfit. Guides shoppers to their perfect fit without sizing confusion.",
    tag: "Size Charts",
  },
  {
    num: "03",
    title: "Matching Outfit Recommendations",
    desc: "Suggests matching dupattas, jewelry, or complementary pieces right inside the chat to lift average order value naturally.",
    tag: "Smart Upsell",
  },
  {
    num: "04",
    title: "1-Click Native UPI Checkout",
    desc: "Sends a direct Google Pay or PhonePe payment link. No typing UPI IDs manually or waiting hours for payment screenshots.",
    tag: "In-Chat Pay",
  },
];

const afterSaleItems = [
  {
    num: "05",
    title: "Live Courier Tracking",
    desc: "Checks real-time parcel status from Delhivery, Shiprocket, or BlueDart and sends tracking updates on WhatsApp in seconds.",
    tag: "Live Tracking",
  },
  {
    num: "06",
    title: "Fabric, Wash & Care Doubts",
    desc: "Explains pure fabrics, lining details, dry cleaning vs gentle wash, and delivery timelines in your boutique's exact tone.",
    tag: "Brand Tone",
  },
  {
    num: "07",
    title: "Routine Size Exchanges",
    desc: "Enforces your 7-day exchange window, asks for unboxing photos with tags intact, and prepares replacement details cleanly.",
    tag: "Policy Enforced",
  },
  {
    num: "08",
    title: "1-Tap VIP & Bridal Escalation",
    desc: "When a customer asks for bespoke bridal stitching or bulk wedding orders, it alerts you on WhatsApp so you can step in with 1 tap.",
    tag: "Human Handover",
  },
];
---

<section
  id="shift"
  class="relative overflow-hidden py-28 sm:py-32 lg:py-36 bg-[#000000] border-t border-white/[0.08]"
>
  <div class="page-shell">
    <!-- Header with generous breathing room -->
    <div class="max-w-3xl mb-16 lg:mb-20">
      <div class="chip mb-4">
        <span class="mini-label text-emerald-400">The Boutique Reality</span>
      </div>
      <h2 class="section-title font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
        Your customers don&rsquo;t stop messaging <span class="text-emerald-400">when you stop working</span>.
      </h2>
      <p class="section-copy mt-5 text-base sm:text-lg text-slate-400 font-normal leading-relaxed">
        11pm sizing doubts go cold by morning. A viral Reel brings 200 &ldquo;Price?&rdquo; messages you can&rsquo;t answer. &ldquo;Where is my parcel?&rdquo; buries your real buyers. VoluChat handles every one of them&mdash;from first Reel comment to final delivery.
      </p>
    </div>

    <!-- 2-Column Spacious Lifecycle Architecture -->
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-12 items-stretch">
      
      <!-- Column 1: Before The Sale -->
      <div class="rounded-3xl border border-white/[0.08] bg-[#070709] p-8 sm:p-10 flex flex-col justify-between hover:border-emerald-500/30 transition-all duration-300">
        <div>
          <!-- Phase Header -->
          <div class="flex items-center justify-between pb-6 border-b border-white/[0.08] mb-8">
            <div>
              <span class="font-mono text-xs text-emerald-400 font-bold uppercase tracking-wider block">Phase 01</span>
              <h3 class="font-heading text-2xl font-bold text-white mt-1">Before The Sale</h3>
            </div>
            <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3.5 py-1 font-mono text-xs text-emerald-300 font-medium">
              Revenue You&rsquo;re Missing
            </span>
          </div>

          <!-- Items list with generous vertical rhythm -->
          <div class="space-y-7">
            {
              beforeSaleItems.map((item) => (
                <div class="group flex items-start gap-4">
                  <span class="font-mono text-xs font-bold text-emerald-400 mt-1 shrink-0 w-6">
                    {item.num}
                  </span>
                  <div class="space-y-1 flex-1">
                    <div class="flex items-center justify-between gap-2">
                      <h4 class="text-base font-semibold text-white tracking-tight group-hover:text-emerald-300 transition-colors">
                        {item.title}
                      </h4>
                      <span class="text-[10px] font-mono text-slate-500 hidden sm:inline-block">
                        {item.tag}
                      </span>
                    </div>
                    <p class="text-sm text-slate-400 font-normal leading-relaxed">
                      {item.desc}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mt-10 pt-5 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono text-slate-400">
          <span>Speed: <strong class="text-white">Under 90 seconds</strong></span>
          <span class="text-emerald-400 font-semibold">Result: Closed Revenue</span>
        </div>
      </div>

      <!-- Column 2: After The Sale -->
      <div class="rounded-3xl border border-white/[0.08] bg-[#070709] p-8 sm:p-10 flex flex-col justify-between hover:border-teal-500/30 transition-all duration-300">
        <div>
          <!-- Phase Header -->
          <div class="flex items-center justify-between pb-6 border-b border-white/[0.08] mb-8">
            <div>
              <span class="font-mono text-xs text-teal-400 font-bold uppercase tracking-wider block">Phase 02</span>
              <h3 class="font-heading text-2xl font-bold text-white mt-1">After The Sale</h3>
            </div>
            <span class="rounded-full border border-teal-500/20 bg-teal-500/10 px-3.5 py-1 font-mono text-xs text-teal-300 font-medium">
              Zero Unanswered DMs
            </span>
          </div>

          <!-- Items list with generous vertical rhythm -->
          <div class="space-y-7">
            {
              afterSaleItems.map((item) => (
                <div class="group flex items-start gap-4">
                  <span class="font-mono text-xs font-bold text-teal-400 mt-1 shrink-0 w-6">
                    {item.num}
                  </span>
                  <div class="space-y-1 flex-1">
                    <div class="flex items-center justify-between gap-2">
                      <h4 class="text-base font-semibold text-white tracking-tight group-hover:text-teal-300 transition-colors">
                        {item.title}
                      </h4>
                      <span class="text-[10px] font-mono text-slate-500 hidden sm:inline-block">
                        {item.tag}
                      </span>
                    </div>
                    <p class="text-sm text-slate-400 font-normal leading-relaxed">
                      {item.desc}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mt-10 pt-5 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono text-slate-400">
          <span>Coverage: <strong class="text-white">24/7 Unassisted</strong></span>
          <span class="text-teal-400 font-semibold">Result: 0 Unanswered DMs</span>
        </div>
      </div>

    </div>
  </div>
</section>
