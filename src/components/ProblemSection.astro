---
const painPoints = [
  {
    code: "P01",
    title: "Stock questions wait",
    description: "Shoppers need sizing, material, or availability answers before they buy.",
    tone: "text-rose-300 border-rose-500/15 bg-rose-500/8",
  },
  {
    code: "P02",
    title: "Cart follow-ups lag",
    description: "High-intent buyers leave while the team is still catching up.",
    tone: "text-amber-300 border-amber-500/15 bg-amber-500/8",
  },
  {
    code: "P03",
    title: "Old stock stays idle",
    description: "Clearance ideas exist, but campaign setup keeps getting delayed.",
    tone: "text-slate-300 border-white/10 bg-white/[0.035]",
  },
  {
    code: "P04",
    title: "Upsells get missed",
    description: "The right add-on is obvious only after the moment has passed.",
    tone: "text-teal-300 border-teal-500/15 bg-teal-500/8",
  },
  {
    code: "P05",
    title: "Campaigns need prep",
    description: "Useful follow-ups still depend on exports, filters, and manual checks.",
    tone: "text-indigo-300 border-indigo-500/15 bg-indigo-500/8",
  },
  {
    code: "P06",
    title: "Leaks stay hidden",
    description: "Teams see missed revenue later, not when there is still time to act.",
    tone: "text-red-300 border-red-500/15 bg-red-500/8",
  },
];
---

<section
  id="problem"
  class="section-band-quiet relative overflow-hidden py-20 lg:py-24"
>
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
  >
  </div>

  <div class="page-shell">
    <div class="max-w-3xl reveal-on-scroll reveal-up">
      <div class="chip mb-5">
        <span class="mini-label">The Growth Trap</span>
      </div>
      <h2 class="section-title text-white">
        Growing stores hit an <span class="gradient-text-anim">operations wall</span>
      </h2>
      <p class="section-copy mt-5 max-w-2xl text-slate-300">
        More shoppers. More edge cases. More missed follow-ups. Eventually, the
        team cannot act fast enough without adding more people.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        painPoints.map((point, index) => (
          <article
            class={`spotlight reveal-on-scroll reveal-scale rounded-2xl border border-white/10 bg-[#101b2b]/78 p-5 shadow-[0_20px_60px_-48px_rgba(0,0,0,0.85)] transition-all duration-300 hover:-translate-y-1 hover:border-slate-400/25 ${index > 0 ? `reveal-delay-${(index % 3) * 75}` : ""}`}
          >
            <div class="mb-5 flex items-center justify-between gap-4">
              <span class="font-mono text-xs font-semibold text-slate-500">
                {point.code}
              </span>
              <span
                class={`rounded border px-2 py-0.5 text-[9px] font-bold uppercase tracking-[0.14em] ${point.tone}`}
              >
                Signal
              </span>
            </div>

            <h3 class="font-heading text-lg font-bold text-white">
              {point.title}
            </h3>
            <p class="mt-3 text-sm font-medium leading-relaxed text-slate-300">
              {point.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
