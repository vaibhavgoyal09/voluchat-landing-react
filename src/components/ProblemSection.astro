---
const painPoints = [
  {
    code: "LEAK 01",
    title: "11 PM 'Price?' & Sizing Doubts Go Cold",
    description: "55%+ of apparel browsing happens late at night. When reps are offline, buyers asking 'Is this true to size?' or 'Price?' scroll away and buy from competitors.",
    tone: "text-rose-400 border-rose-500/20 bg-rose-500/10",
  },
  {
    code: "LEAK 02",
    title: "Viral Reel Comment Deluge",
    description: "A styling Reel hits 50k views and gets 400+ 'Price please' comments. Manual teams take 8+ hours to DM everyone, losing 80% of peak buying intent.",
    tone: "text-amber-400 border-amber-500/20 bg-amber-500/10",
  },
  {
    code: "LEAK 03",
    title: "Robotic Chatbot Flowcharts",
    description: "Tools like Wati force buyers through rigid 'Press 1' menus. Boutique shoppers want natural styling advice: 'Does this kurti come with pants?'",
    tone: "text-emerald-400 border-emerald-500/20 bg-emerald-500/10",
  },
  {
    code: "LEAK 04",
    title: "Drop-Off on External Website Links",
    description: "Pushing DM shoppers to an external website cart kills the conversational impulse. 70%+ drop off rather than completing a 5-step web checkout.",
    tone: "text-indigo-400 border-indigo-500/20 bg-indigo-500/10",
  },
  {
    code: "LEAK 05",
    title: "Manual UPI Screenshots & Sizing Errors",
    description: "Chasing payment screenshots, checking bank transfers manually, and answering repetitive size chart questions burns 5+ hours of founder time daily.",
    tone: "text-teal-400 border-teal-500/20 bg-teal-500/10",
  },
  {
    code: "LEAK 06",
    title: "High COD Return Rates (RTO)",
    description: "Unconfirmed impulse orders placed without real-time address validation and sizing confirmation result in 30%+ painful delivery returns.",
    tone: "text-red-400 border-red-500/20 bg-red-500/10",
  },
];
---

<section
  id="problem"
  class="relative overflow-hidden py-20 lg:py-28"
>
  <div class="page-shell">
    <div class="problem-header grid gap-6 lg:grid-cols-2 lg:items-end opacity-0">
      <div>
        <div class="chip mb-5">
          <span class="mini-label">The Fashion DM Revenue Leak</span>
        </div>
        <h2 class="section-title text-white">
          Where clothing brands <span class="gradient-text-anim">lose 60%+ of social sales</span>
        </h2>
      </div>
      <p class="section-copy max-w-xl text-slate-400 lg:justify-self-end lg:pb-2">
        You spend lakhs producing content and running Meta ads, but manual chat replies and rigid chatbot builders cannot close impulse boutique buyers at midnight.
      </p>
    </div>

    <div class="mt-14 border-t border-white/10">
      {
        painPoints.map((point, index) => (
          <article
            class="problem-card group relative grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-2 border-b border-white/10 py-7 transition-colors duration-300 hover:bg-white/[0.02] sm:gap-x-10 sm:py-8 lg:grid-cols-[auto_1fr_1fr] opacity-0"
          >
            <span class="font-heading text-4xl font-bold leading-none text-white/[0.07] transition-colors duration-300 group-hover:text-emerald-400/25 sm:text-6xl">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="font-heading text-lg font-semibold text-white transition-colors group-hover:text-emerald-50 sm:text-xl">
              {point.title}
              <span class="mt-1 block font-mono text-[10px] font-medium uppercase tracking-[0.18em] text-slate-500">
                {point.code} &mdash; Revenue Leak
              </span>
            </h3>
            <p class="col-span-2 max-w-xl text-sm leading-relaxed text-slate-400 lg:col-span-1">
              {point.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#problem",
        start: "top 78%",
      }
    });

    tl.fromTo(
      ".problem-header",
      { opacity: 0, x: -30 },
      { opacity: 1, x: 0, duration: 0.6, ease: "power3.out" }
    )
    .fromTo(
      ".problem-card",
      { opacity: 0, y: 24 },
      {
        opacity: 1,
        y: 0,
        duration: 0.5,
        stagger: 0.08,
        ease: "power2.out",
      },
      "-=0.3"
    );
  });
</script>
