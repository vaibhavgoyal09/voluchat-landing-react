---
const supportingPoints = [
  {
    code: "PROBLEM 01",
    stat: "55%",
    pct: 55,
    statLabel: "Late Night DMs",
    title: "Customers message at 11 PM and buy elsewhere by morning",
    description: "Most people scroll Instagram in bed late at night. When they message asking for price or sizes while you're asleep, they don't wait — they buy from another store.",
  },
  {
    code: "PROBLEM 02",
    stat: "40%",
    pct: 40,
    statLabel: "Payment Friction",
    title: "Drop-offs while texting UPI IDs & waiting for screenshots",
    description: "Typing out your GPay number, texting 'Please share payment screenshot', and checking your bank app manually creates friction that makes buyers drop off before paying.",
  },
];
---

<section
  id="problem"
  class="relative overflow-hidden py-28 sm:py-32 lg:py-36 bg-[#000000]"
>
  <div class="page-shell">
    <div class="max-w-3xl mb-12">
      <div class="chip mb-3">
        <span class="mini-label text-rose-400">The Problem With Manual Selling</span>
      </div>
      <h2 class="section-title font-heading">
        Where boutique owners <span class="text-rose-400">lose half their daily sales</span>.
      </h2>
      <p class="section-copy mt-4">
        Selling in WhatsApp DMs works great — until you get flooded with messages, take too long to reply, and customers end up buying elsewhere.
      </p>
    </div>

    <!-- Editorial: 1 titanium feature + hairline spec rows -->
    <div class="grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-14 items-start">
      
      <!-- Dominant Hero Statistic — titanium surface, rose kept for loss only -->
      <article class="reveal-on-scroll titanium-surface rounded-3xl p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden">
        <div>
          <!-- Header -->
          <div class="flex items-center justify-between border-b border-rose-500/20 pb-3 mb-5">
            <span class="font-mono text-[11px] text-rose-300 font-bold uppercase tracking-wider">Biggest Daily Drop-Off</span>
            <span class="rounded-full border border-rose-400/30 bg-rose-500/15 px-3 py-0.5 font-mono text-[11px] text-rose-200 font-medium shadow-[inset_0_1px_1px_rgba(255,255,255,0.15)]">
              Left on &ldquo;Seen&rdquo; ↓
            </span>
          </div>

          <!-- Hero Number -->
          <div class="flex items-baseline gap-2 mb-2">
            <div class="font-heading text-5xl sm:text-6xl font-bold text-white tracking-tight leading-none">
              65<span class="text-rose-400">%</span>
            </div>
            <span class="text-xs font-mono text-rose-300/90 font-medium">
              stop replying
            </span>
          </div>

          <!-- Slim Progress Bar -->
          <div class="h-1.5 w-full rounded-full bg-white/10 overflow-hidden my-4 backdrop-blur-sm">
            <div class="h-full w-[65%] rounded-full bg-gradient-to-r from-rose-500 to-rose-300 shadow-[0_0_12px_rgba(244,63,94,0.6)]"></div>
          </div>

          <h3 class="font-heading text-lg sm:text-xl font-semibold text-white leading-snug mb-2.5">
            of buyers leave you on &ldquo;seen&rdquo; if they don't get a price, size, or photos within 5 minutes.
          </h3>

          <p class="text-xs sm:text-sm text-rose-100/75 font-normal leading-relaxed">
            When a customer asks &ldquo;Price?&rdquo; or &ldquo;Is size M in stock?&rdquo;, they are ready to buy right now. If you're busy packing orders or away from your phone, they scroll to the next page. VoluChat answers instantly, shows exact sizing, and collects UPI payment in 85 seconds.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-rose-500/20 flex items-center justify-between text-xs font-mono text-rose-200/80">
          <span>Cause: Delayed manual replies</span>
          <span class="font-bold text-rose-300">Fix: 2s AI replies &amp; 1-click UPI</span>
        </div>
      </article>

      <!-- 2 supporting points as Apple spec rows — no boxes -->
      <div>
        {
          supportingPoints.map((point, idx) => (
            <article class={`hairline-row reveal-on-scroll reveal-delay-${idx + 1} grid gap-3 sm:grid-cols-[88px_1fr] sm:gap-6`}>
              <div class="font-heading text-4xl font-bold text-white tracking-tight">
                {point.stat}
              </div>
              <div>
                <div class="font-mono text-[11px] text-slate-500 font-bold">{point.code} — {point.statLabel}</div>
                <h3 class="font-heading text-base sm:text-lg font-semibold text-white mt-1">
                  {point.title}
                </h3>
                <p class="mt-1.5 text-sm text-[#86868b] font-normal leading-relaxed">
                  {point.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
