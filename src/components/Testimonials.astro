---
const foundingHighlights = [
  {
    title: "Real Store Workload",
    desc: "Built around manual tasks: late replies, repeat questions, and manual photo searches."
  },
  {
    title: "1-on-1 Dedicated Setup",
    desc: "We personally configure your account, catalog mapping, and WhatsApp handoff."
  },
  {
    title: "Localized Reply Tuning",
    desc: "Optimized for Indian shoppers with seamless support for English, Hindi, and Hinglish queries."
  },
  {
    title: "Early Co-Creation",
    desc: "Shape our upcoming product features directly around your daily retail operations."
  }
];
---

<section id="testimonials" class="relative overflow-hidden py-24 md:py-32">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-15"></div>
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <!-- Standardized Glowing Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-100 bg-emerald-50/70 px-4 py-1.5 text-xs font-black text-emerald-700 shadow-sm backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.6)]"></span>
        <span>Founding stores</span>
      </div>
      <!-- Consistent Responsive Heading -->
      <h2 class="text-3xl font-heading font-black leading-[1.1] tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
        Onboarding founding Instagram stores in India.
      </h2>
      <p class="mt-6 text-lg font-semibold leading-relaxed text-slate-600 sm:text-xl">
        We build side-by-side with real retail operators to ensure our automation perfectly fits real-world sales operations.
      </p>
    </div>

    <!-- Onboarding Benefits Grid -->
    <div class="grid gap-8 md:grid-cols-2 lg:gap-12 max-w-5xl mx-auto">
      {foundingHighlights.map((item) => (
        <div class="glass-card-premium rounded-[2rem] p-8 shadow-xl flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3.5 mb-4">
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg border border-emerald-100 bg-emerald-50">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <h3 class="font-heading text-lg font-black tracking-tight text-slate-950">{item.title}</h3>
            </div>
            <p class="text-sm font-semibold leading-relaxed text-slate-600">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 text-center">
      <a href="/contact" class="group inline-flex items-center justify-center gap-3 rounded-full bg-blue-600 py-4 px-8 text-sm font-black text-white shadow-xl shadow-blue-500/25 transition duration-300 hover:bg-blue-700 hover:scale-[1.02]">
        <span>Request Demo & Join Founding Program</span>
        <span class="h-2 w-2 rounded-full bg-white"></span>
      </a>
    </div>
  </div>
</section>

