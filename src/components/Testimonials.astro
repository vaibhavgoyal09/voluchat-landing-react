---
const trustHighlights = [
  {
    title: "No fake case studies",
    desc: "VoluChat is still early, so we do not pretend to have public reviews, logos, or inflated performance numbers."
  },
  {
    title: "Try it for 14 days",
    desc: "Use the trial to test your real Instagram comments, catalog questions, and WhatsApp handoff before deciding."
  },
  {
    title: "Hands-on boutique setup",
    desc: "We help tune products, sizes, shades, COD, delivery, and Hinglish replies around your actual boutique workflow."
  },
  {
    title: "Built with early boutique sellers",
    desc: "The product is shaped around Instagram-first fashion sellers who still close orders manually on WhatsApp."
  }
];
---

<section id="testimonials" class="relative overflow-hidden py-28 md:py-36">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-15"></div>
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center max-w-3xl mx-auto mb-24">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-100 bg-emerald-50/70 px-4 py-1.5 text-xs font-black text-emerald-700 shadow-sm backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.6)]"></span>
        <span>Early-stage proof</span>
      </div>
      <h2 class="text-3xl font-heading font-black leading-[1.1] tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
        Built with early boutique sellers.
      </h2>
      <p class="mt-6 text-lg font-semibold leading-relaxed text-slate-600 sm:text-xl">
        We earn trust through a real trial, guided setup, and honest expectations instead of borrowed review badges.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:gap-12 max-w-5xl mx-auto">
      {trustHighlights.map((item) => (
        <div class="glass-card-premium rounded-[2rem] p-8 shadow-xl flex flex-col justify-between hover:-translate-y-1.5 hover:shadow-2xl hover:border-emerald-500/20 transition-all duration-500 group/card">
          <div>
            <div class="flex items-center gap-3.5 mb-4">
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg border border-emerald-100 bg-emerald-50 group-hover/card:bg-emerald-500 group-hover/card:border-emerald-500 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600 group-hover/card:text-white transition-colors duration-300"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <h3 class="font-heading text-lg font-black tracking-tight text-slate-950">{item.title}</h3>
            </div>
            <p class="text-sm font-semibold leading-relaxed text-slate-600">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 text-center">
      <a href="/contact" class="group relative inline-flex items-center justify-center gap-3 rounded-full bg-zinc-950 py-4 px-8 text-sm font-black text-white shadow-2xl overflow-hidden transition-all duration-300 hover:scale-[1.03] hover:bg-blue-600">
        <span class="relative z-10">Start 14-day free trial</span>
        <span class="h-2.5 w-2.5 rounded-full bg-blue-400 group-hover:bg-white transition-colors duration-300 relative z-10"></span>
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
      </a>
    </div>
  </div>
</section>
