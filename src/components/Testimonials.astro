---
const trustHighlights = [
  {
    title: "No fake client logos",
    desc: "We do not have public customers yet, so this page does not use borrowed logos, invented testimonials, or inflated performance claims."
  },
  {
    title: "Live product demo",
    desc: "The demo call shows the actual product flow instead of a slide deck or static promise."
  },
  {
    title: "Founder-led setup",
    desc: "We personally help configure your rules, tone, escalation boundaries, and store-specific edge cases."
  },
  {
    title: "30-day money-back guarantee",
    desc: "Early customers can launch with transparent pricing and ask for their money back within 30 days if VoluChat is not a fit."
  }
];
---

<section id="testimonials" class="section-pad relative overflow-hidden">
  <div class="page-shell">
    <div class="mx-auto max-w-3xl text-center">
      <p class="section-eyebrow">Transparent proof</p>
      <h2 class="section-title mt-4">
        Real product, honest proof.
      </h2>
      <p class="section-copy mx-auto mt-5 max-w-2xl">
        VoluChat is opening to early customers. We would rather show the live workflow and pricing clearly than pretend to have public case studies.
      </p>
    </div>

    <div class="mx-auto mt-10 grid max-w-5xl gap-4 md:grid-cols-4">
      {trustHighlights.map((item, index) => (
        <article class={`proof-tile hover:-translate-y-1 hover:shadow-xl transition-all duration-300 reveal-on-scroll ${index % 2 === 1 ? 'reveal-delay-100' : ''}`}>
          <h3 class="font-heading text-lg font-semibold text-stone-950">{item.title}</h3>
          <p class="mt-3 text-xs font-semibold leading-relaxed text-stone-600">{item.desc}</p>
        </article>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href="/contact" class="btn-primary">
        Book demo call
      </a>
    </div>
  </div>
</section>
