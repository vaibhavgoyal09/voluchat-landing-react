---
const trustHighlights = [
  {
    icon: "demo",
    title: "Live workflow demo",
    desc: "See the real Instagram DM-to-WhatsApp handoff instead of a slide deck or inflated promise."
  },
  {
    icon: "setup",
    title: "Founder-led setup",
    desc: "We map products, variants, policies, reply tone, and WhatsApp handoff details with your team."
  },
  {
    icon: "connections",
    title: "Official workflow",
    desc: "Connect Instagram and Facebook through Meta login, sync Shopify where available, and keep WhatsApp as your close."
  },
  {
    icon: "guarantee",
    title: "30-day money-back guarantee",
    desc: "Launch with transparent early pricing and ask for your money back within 30 days if VoluChat is not a fit."
  }
];

const icons = {
  demo: "M5 6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v7A2.5 2.5 0 0 1 16.5 16h-9A2.5 2.5 0 0 1 5 13.5v-7Zm5 12h4M12 16v2.5m-1.5-9 3 2-3 2v-4Z",
  setup: "M12 3.5v3m0 10v4m8.5-8.5h-3m-10 0h-4m14.01-5.51-2.12 2.12M8.61 15.39l-2.12 2.12m0-11.02 2.12 2.12m6.78 6.78 2.12 2.12M12 8.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7Z",
  connections: "M7.5 8.5h9m-9 7h9M6.5 4.5h11A2.5 2.5 0 0 1 20 7v10a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17V7a2.5 2.5 0 0 1 2.5-2.5Zm2 4v7m7-7v7",
  guarantee: "M12 3.5 19 6v5.5c0 4.4-2.92 7.2-7 9-4.08-1.8-7-4.6-7-9V6l7-2.5Zm-3 8 2 2 4-4",
};
---

<section id="proof" class="relative overflow-hidden py-10 sm:py-12">
  <div class="ambient-noise"></div>

  <div class="page-shell relative z-10">
    <div class="solid-card overflow-hidden p-0 reveal-on-scroll">
      <div class="grid gap-0 lg:grid-cols-[0.78fr_1.22fr]">
        <div class="border-b border-stone-200/80 bg-stone-50/80 p-6 sm:p-8 lg:border-b-0 lg:border-r">
          <p class="section-eyebrow">Honest early access proof</p>
          <h2 class="mt-4 text-2xl font-semibold leading-tight text-stone-950 sm:text-3xl">
            Trust signals without pretending we are bigger than we are.
          </h2>
          <p class="mt-4 text-sm font-semibold leading-relaxed text-stone-600 sm:text-base">
            No fake testimonials, inflated customer counts, or unsupported revenue claims. The proof today is a live product flow, hands-on setup, transparent pricing, and a clear guarantee.
          </p>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
            <a href="https://dashboard.voluchat.com/register" class="btn-primary">
              Start Free Setup
            </a>
            <a href="https://ig.me/m/airwalks.shoes" target="_blank" rel="noopener" class="btn-secondary">
              Watch Live Demo
            </a>
          </div>
        </div>

        <div class="grid divide-y divide-stone-200/80 sm:grid-cols-2 sm:divide-x sm:divide-y-0">
          {trustHighlights.map((item, index) => (
            <article class={`p-5 sm:p-6 ${index > 1 ? 'sm:border-t sm:border-stone-200/80' : ''}`}>
              <div class="grid h-9 w-9 place-items-center rounded-xl border border-primary-100 bg-primary-50 text-primary-800 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={icons[item.icon]} />
                </svg>
              </div>
              <h3 class="mt-4 text-base font-semibold leading-snug text-stone-950 sm:text-lg">{item.title}</h3>
              <p class="mt-2 text-sm font-medium leading-relaxed text-stone-600">{item.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
