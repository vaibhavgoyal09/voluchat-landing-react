---
const trustHighlights = [
  {
    icon: "logos",
    title: "No fake client logos",
    desc: "We do not have public customers yet, so this page does not use borrowed logos, invented testimonials, or inflated performance claims."
  },
  {
    icon: "demo",
    title: "Live product demo",
    desc: "The demo call shows the actual product flow instead of a slide deck or static promise."
  },
  {
    icon: "setup",
    title: "Founder-led setup",
    desc: "We personally help configure your rules, tone, escalation boundaries, and store-specific edge cases."
  },
  {
    icon: "guarantee",
    title: "30-day money-back guarantee",
    desc: "Early customers can launch with transparent pricing and ask for their money back within 30 days if VoluChat is not a fit."
  }
];

const icons = {
  logos: "M4 7.5h16M7 4.5h10a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-9a3 3 0 0 1 3-3Zm2.5 7.5h5",
  demo: "M5 6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v7A2.5 2.5 0 0 1 16.5 16h-9A2.5 2.5 0 0 1 5 13.5v-7Zm5 12h4M12 16v2.5m-1.5-9 3 2-3 2v-4Z",
  setup: "M12 3.5v3m0 10v4m8.5-8.5h-3m-10 0h-4m14.01-5.51-2.12 2.12M8.61 15.39l-2.12 2.12m0-11.02 2.12 2.12m6.78 6.78 2.12 2.12M12 8.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7Z",
  guarantee: "M12 3.5 19 6v5.5c0 4.4-2.92 7.2-7 9-4.08-1.8-7-4.6-7-9V6l7-2.5Zm-3 8 2 2 4-4",
};
---

<section id="testimonials" class="section-pad relative overflow-hidden">
  <div class="ambient-noise"></div>

  <div class="page-shell relative z-10">
    <div class="solid-card overflow-hidden p-0">
      <div class="grid gap-0 lg:grid-cols-[0.85fr_1.15fr]">
        <div class="border-b border-stone-200/80 bg-stone-50/70 p-6 sm:p-8 lg:border-b-0 lg:border-r">
          <p class="section-eyebrow">Transparent proof</p>
          <h2 class="mt-4 text-3xl font-semibold leading-tight text-stone-950 sm:text-4xl">
            Early access, no inflated proof.
          </h2>
          <p class="mt-5 text-base font-semibold leading-relaxed text-stone-600">
            VoluChat is opening to early customers. Until there are public case studies, we show the real product, publish the price, and support launch directly.
          </p>

          <div class="mt-7 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
            <a href="/contact" class="btn-primary">
              Book demo call
            </a>
            <a href="#demo" class="btn-secondary">
              Review demo
            </a>
          </div>
        </div>

        <div class="grid divide-y divide-stone-200/80 sm:grid-cols-2 sm:divide-x sm:divide-y-0">
          {trustHighlights.map((item, index) => (
            <article class={`p-6 sm:p-7 ${index > 1 ? 'sm:border-t sm:border-stone-200/80' : ''}`}>
              <div class="grid h-10 w-10 place-items-center rounded-xl border border-primary-100 bg-primary-50 text-primary-800 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={icons[item.icon]} />
                </svg>
              </div>
              <h3 class="mt-5 text-lg font-semibold leading-snug text-stone-950">{item.title}</h3>
              <p class="mt-3 text-sm font-medium leading-relaxed text-stone-600">{item.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
