---
const trustHighlights = [
  {
    title: "No fake case studies",
    desc: "VoluChat is still early, so we do not pretend to have public reviews, logos, or inflated performance numbers."
  },
  {
    title: "Try it for 14 days",
    desc: "Use the trial to test your real Instagram comments, catalog questions, and WhatsApp handoff before deciding."
  },
  {
    title: "Hands-on store setup",
    desc: "We help tune products, sizes, colors, COD, delivery, offers, and Hinglish replies around your actual sales workflow."
  },
  {
    title: "Built with early ecommerce sellers",
    desc: "The product is shaped around product-heavy online stores, from owner-led teams to larger sales teams, that lose sales when manual replies are too slow."
  }
];
---

<section id="testimonials" class="section-pad relative overflow-hidden">
  <div class="page-shell">
    <div class="mx-auto max-w-3xl text-center">
      <p class="section-eyebrow">Early-stage proof</p>
      <h2 class="section-title mt-4">
        Built with early ecommerce sellers.
      </h2>
      <p class="section-copy mx-auto mt-5 max-w-2xl">
        We earn trust through a real trial, guided setup, and honest expectations instead of borrowed review badges.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-2">
      {trustHighlights.map((item, index) => (
        <article class={`glass-card-premium rounded-[2rem] p-8 hover:-translate-y-1 hover:shadow-xl transition-all duration-300 reveal-on-scroll ${index % 2 === 1 ? 'reveal-delay-100' : ''}`}>
          <h3 class="font-heading text-xl font-semibold text-stone-950">{item.title}</h3>
          <p class="mt-4 text-xs font-semibold leading-relaxed text-stone-600">{item.desc}</p>
        </article>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href="/contact" class="btn-primary">
        Start 14-day free trial
      </a>
    </div>
  </div>
</section>
