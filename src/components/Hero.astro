---
import HeroAutomationScene from './HeroAutomationScene.astro';
---

<section id="hero" class="relative isolate overflow-hidden pt-32 pb-14 sm:pt-36 lg:min-h-[calc(100dvh-4rem)] lg:pt-32 lg:pb-14">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_12%_18%,rgba(83,111,159,0.11),transparent_28%),radial-gradient(circle_at_82%_10%,rgba(203,217,234,0.16),transparent_26%),linear-gradient(180deg,rgba(255,255,255,0.92),rgba(247,249,252,0.86)_58%,rgba(255,255,255,0.96))]"></div>
  <div class="ambient-noise"></div>

  <div class="page-shell relative z-10 w-full">
    <div class="grid items-center gap-8 lg:grid-cols-[0.92fr_1.08fr] xl:gap-12">
      <div class="max-w-xl text-left">
        <div id="hero-badge" class="chip">
          Automate repetitive product replies
        </div>

        <h1 id="hero-title" class="mt-6 max-w-[17ch] text-[2.75rem] font-semibold leading-[0.98] text-stone-950 sm:text-[3.7rem] lg:mt-5 lg:text-[3.75rem] xl:text-[4.05rem]">
          <span class="sr-only">Stop Losing Sales to Slow Replies</span>
          <span aria-hidden="true" class="block">Stop Losing Sales</span>
          <span aria-hidden="true" class="accent-gradient-text block">to Slow Replies</span>
        </h1>

        <p id="hero-description" class="mt-6 max-w-lg text-base font-medium leading-relaxed text-stone-600 sm:text-lg">
          VoluChat answers repeated product questions across Instagram, Facebook Pages, and WhatsApp-native automation soon before buyers lose interest.
        </p>

        <p class="mt-3 max-w-lg text-sm font-semibold leading-relaxed text-stone-500">
          Price, size, stock, delivery, and offers get fast answers before buyers leave.
        </p>

        <div id="hero-actions" class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/contact" class="btn-primary">
            Start 14-day free trial
          </a>
          <a href="#demo" class="btn-secondary">
            See automated replies
          </a>
        </div>

        <p class="mt-5 max-w-lg text-xs font-semibold leading-relaxed text-stone-500">
          Built for shoe stores, accessories, premium fashion, jewelry, beauty, and other product-heavy stores where slow replies lose buyers.
        </p>

        <div class="mt-7 grid max-w-lg grid-cols-3 gap-2.5 sm:gap-3">
          <div class="hero-metric-card kinetic-card">
            <p class="mini-label">Replies</p>
            <p class="mt-2 text-lg font-semibold text-stone-950">Instant</p>
          </div>
          <div class="hero-metric-card kinetic-card">
            <p class="mini-label">Channels</p>
            <p class="mt-2 text-lg font-semibold text-stone-950">Meta</p>
          </div>
          <div class="hero-metric-card kinetic-card">
            <p class="mini-label">Trial</p>
            <p class="mt-2 text-lg font-semibold text-stone-950">14 days</p>
          </div>
        </div>
      </div>

      <HeroAutomationScene />
    </div>
  </div>
</section>
