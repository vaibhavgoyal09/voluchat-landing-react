---

---

<section
  id="hero"
  class="hero-section relative isolate overflow-hidden pt-[7.5rem] pb-16 sm:pt-[8.5rem] lg:pt-[9rem] lg:pb-24"
>
  <!-- Modern layered background (pure CSS, zero JS) -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-grid"></div>
    <div class="hero-bg-mesh"></div>
    <div class="hero-bg-orb hero-bg-orb--teal"></div>
    <div class="hero-bg-orb hero-bg-orb--emerald"></div>
    <div class="hero-bg-orb hero-bg-orb--violet"></div>
    <div class="hero-bg-scan"></div>
    <div class="hero-bg-vignette"></div>
  </div>

  <div class="page-shell relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <!-- Copy Block -->
      <div class="text-center lg:text-left">
        <!-- Single Clean Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-950/20 px-4 py-1.5 text-xs font-medium text-emerald-300 backdrop-blur-xl shadow-[0_4px_16px_rgba(16,185,129,0.12),inset_0_1px_1px_rgba(255,255,255,0.16)]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Official Meta Tech Partner &bull; <strong class="font-semibold text-white">30 Days Free Trial</strong></span>
        </div>

        <h1
          class="hero-title mt-7 font-heading text-[2.75rem] font-bold leading-[1.02] tracking-[-0.035em] sm:text-[3.25rem] lg:text-[3.6rem] xl:text-[4rem] text-[#fcfdff]"
        >
          <span>
            Your Instagram Reels Bring the Traffic.
          </span>
          <span class="block bg-gradient-to-r from-emerald-300 via-teal-200 to-emerald-400 bg-clip-text text-transparent pb-1">VoluChat Closes the Sale on WhatsApp.</span>
        </h1>

        <p
          class="hero-text mx-auto mt-6 max-w-xl text-lg font-normal leading-relaxed text-[rgba(245,245,247,0.72)] sm:text-xl lg:mx-0"
        >
          Turn Instagram &amp; Facebook comments, WhatsApp messages, and website visits into completed orders — automatically across every channel.
        </p>

        <div
          class="hero-ctas mt-8 flex flex-col items-center gap-3.5 sm:flex-row sm:justify-center lg:justify-start"
        >
          <a href="/free-trial" class="btn-primary">
            Start 30-Day Free Trial &rarr;
          </a>
          <a
            href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary inline-flex items-center gap-2"
          >
            💬 Test Drive the Bot on WhatsApp
          </a>
        </div>

        <!-- Trust Metrics Bar: Apple minimalist frosted glass strip -->
        <div class="mt-10 rounded-2xl border border-white/[0.10] bg-white/[0.03] backdrop-blur-xl p-4 sm:p-5 shadow-[0_8px_24px_rgba(0,0,0,0.3),inset_0_1px_1px_rgba(255,255,255,0.12)] max-w-xl mx-auto lg:mx-0">
          <div class="grid grid-cols-4 gap-3 text-left">
            <div>
              <div class="font-heading text-xl sm:text-2xl font-bold text-white tracking-tight">2.0<span class="text-emerald-400">s</span></div>
              <p class="text-[11px] font-normal text-slate-400 mt-0.5">Comment Reply</p>
            </div>
            <div>
              <div class="font-heading text-xl sm:text-2xl font-bold text-white tracking-tight">&lt;90<span class="text-emerald-400">s</span></div>
              <p class="text-[11px] font-normal text-slate-400 mt-0.5">Checkout</p>
            </div>
            <div>
              <div class="font-heading text-xl sm:text-2xl font-bold text-white tracking-tight">4<span class="text-emerald-400">ch</span></div>
              <p class="text-[11px] font-normal text-slate-400 mt-0.5">Channels</p>
            </div>
            <div>
              <div class="font-heading text-xl sm:text-2xl font-bold text-white tracking-tight">10<span class="text-emerald-400">x</span></div>
              <p class="text-[11px] font-normal text-slate-400 mt-0.5">ROI Standard</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Hero Visual: phone on an illuminated glowing stage with high-contrast chassis -->
      <div class="hero-mockup relative mx-auto w-full max-w-[245px] sm:max-w-[260px] lg:max-w-[275px] xl:max-w-[285px] lg:mx-0 lg:justify-self-center -mt-6 lg:-mt-10">
        <!-- Stage atmospheric illumination & backdrop glow -->
        <div class="absolute left-1/2 top-1/2 -z-10 h-[460px] w-[460px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(16,185,129,0.20)_0%,rgba(20,184,166,0.10)_40%,transparent_70%)] blur-[75px]"></div>
        <div class="absolute left-1/2 top-1/2 -z-10 h-[320px] w-[320px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/[0.05] blur-[45px]"></div>

        <!-- Floating Live Highlights (Contextual Liquid Glass Capsules) -->
        <div class="animate-float-slow absolute -top-4 -left-6 z-30 hidden sm:flex items-center gap-2 rounded-full border border-white/20 bg-slate-950/70 px-3.5 py-1.5 shadow-[0_12px_32px_rgba(0,0,0,0.7),inset_0_1px_1px_rgba(255,255,255,0.25)] backdrop-blur-2xl">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-[11px] font-medium text-slate-200">
            <strong class="text-emerald-400 font-semibold">2.0s</strong> Comment-to-DM
          </span>
        </div>

        <div class="animate-float absolute -bottom-4 -right-6 z-30 hidden sm:flex items-center gap-2.5 rounded-full border border-white/20 bg-slate-950/70 px-4 py-2 shadow-[0_12px_32px_rgba(0,0,0,0.7),inset_0_1px_1px_rgba(255,255,255,0.25)] backdrop-blur-2xl">
          <div class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 shadow-[inset_0_1px_1px_rgba(255,255,255,0.2)]">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div class="text-left">
            <p class="text-[9px] uppercase font-semibold tracking-wider text-slate-400">In-Chat UPI</p>
            <p class="text-xs font-bold text-white">₹7,999 Closed in 85s</p>
          </div>
        </div>

        <!-- Interactive Tilt Phone Device -->
        <div class="tilt relative" data-tilt-strength="3">
          <!-- Metallic Hardware Buttons (Catch light against dark page) -->
          <!-- Silent Switch -->
          <div class="absolute -left-[5px] top-24 h-6 w-[3px] rounded-l-sm bg-gradient-to-r from-slate-400 to-slate-600 shadow-sm"></div>
          <!-- Volume Up -->
          <div class="absolute -left-[5px] top-36 h-10 w-[3px] rounded-l-sm bg-gradient-to-r from-slate-400 to-slate-600 shadow-sm"></div>
          <!-- Volume Down -->
          <div class="absolute -left-[5px] top-50 h-10 w-[3px] rounded-l-sm bg-gradient-to-r from-slate-400 to-slate-600 shadow-sm"></div>
          <!-- Power Button -->
          <div class="absolute -right-[5px] top-36 h-14 w-[3px] rounded-r-sm bg-gradient-to-l from-slate-400 to-slate-600 shadow-sm"></div>

          <!-- Phone Chassis: Natural Titanium Metallic Edge with Defined Specular Rim -->
          <div class="relative rounded-[2.85rem] bg-gradient-to-b from-slate-600 via-slate-700 to-slate-800 p-[3px] shadow-[0_25px_60px_-15px_rgba(0,0,0,0.95),0_0_50px_rgba(16,185,129,0.2),inset_0_1px_1px_rgba(255,255,255,0.6)]">
            
            <!-- Inner Dark Chamfer & Display Frame -->
            <div class="rounded-[2.65rem] bg-[#16171d] p-[4px] ring-1 ring-white/10">
              
              <!-- Screen Container (Exact 9:20 matching the video aspect ratio perfectly) -->
              <div class="relative overflow-hidden rounded-[2.4rem] bg-[#000000] ring-1 ring-black" style="aspect-ratio: 9 / 20;">
                
                <!-- Realistic Screen Glass Specular Sheen -->
                <div class="pointer-events-none absolute inset-0 z-20 bg-gradient-to-tr from-transparent via-white/[0.02] to-white/[0.07]"></div>

                <!-- Video Stream (Full uncropped 9:20 fit) -->
                <video
                  poster="/voluchat_demo_poster.webp"
                  class="absolute inset-0 h-full w-full object-cover"
                  autoplay
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  aria-label="VoluChat automated WhatsApp sales demo"
                >
                  <source src="/voluchat_demo_optimized.webm" type="video/webm" />
                  <source src="/voluchat_demo_optimized.mp4" type="video/mp4" />
                </video>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroMockupPop {
    from {
      opacity: 0;
      transform: translateY(22px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .hero-title {
    animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-text {
    animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
    opacity: 0;
  }

  .hero-ctas {
    animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    opacity: 0;
  }

  .hero-mockup {
    animation: heroMockupPop 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-text,
    .hero-ctas,
    .hero-mockup {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
