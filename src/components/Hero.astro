---
---

<section id="hero" class="relative min-h-[100svh] overflow-hidden pt-28 pb-14 md:pt-32">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-wash"></div>
    <div class="hero-grid"></div>
    <div class="hero-fade"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-4xl text-center">
      <div id="hero-badge" class="inline-flex items-center gap-2 rounded-full border border-slate-200/80 bg-white/85 px-4 py-2 text-sm font-black text-slate-950 shadow-xl shadow-blue-500/5 backdrop-blur-2xl">
        <span class="h-2 w-2 rounded-full bg-blue-600 shadow-[0_0_8px_rgba(59,130,246,0.6)]"></span>
        <span>14-day free trial for Instagram boutiques</span>
      </div>

      <h1 id="hero-title" class="mx-auto mt-6 max-w-4xl text-[2.65rem] font-black leading-[1.02] tracking-normal text-slate-950 sm:text-6xl lg:text-7xl">
        Turn Instagram interest into WhatsApp-ready boutique chats.
      </h1>

      <p id="hero-description" class="mx-auto mt-6 max-w-2xl text-lg font-semibold leading-relaxed text-slate-600 sm:text-xl">
        VoluChat replies to Instagram shoppers, answers product questions, checks catalog details, and prepares clean WhatsApp handoffs for your boutique team.
      </p>

      <div id="hero-actions" class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/contact" class="group relative inline-flex w-full items-center justify-center gap-3 rounded-full bg-zinc-950 px-8 py-4.5 text-base font-black text-white shadow-2xl transition-all duration-300 hover:scale-[1.03] hover:bg-blue-600 sm:w-auto overflow-hidden">
          <span class="relative z-10">Start 14-day free trial</span>
          <span class="h-2 w-2 rounded-full bg-blue-400 group-hover:bg-white transition-colors duration-300 relative z-10"></span>
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
        </a>
        <a href="#demo" class="group inline-flex w-full items-center justify-center gap-2 rounded-full border border-slate-200/80 bg-white/70 px-8 py-4.5 text-base font-black text-slate-900 shadow-sm backdrop-blur-xl transition-all duration-300 hover:bg-white hover:border-slate-300 hover:scale-[1.03] sm:w-auto cursor-pointer">
          Watch boutique flow
        </a>
      </div>
    </div>

    <div id="hero-scene" class="relative mx-auto mt-20 w-full max-w-5xl overflow-visible">
      <div class="absolute inset-0 -z-10 overflow-visible flex items-center justify-center pointer-events-none">
        <div class="absolute w-[120%] h-[300px] bg-gradient-to-r from-blue-400/15 via-indigo-500/20 to-emerald-400/15 blur-[100px] rounded-full"></div>
      </div>

      <div class="grid gap-8 lg:grid-cols-2 items-center relative">
        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-12 hidden lg:flex items-center justify-center z-20 pointer-events-none">
          <div class="w-full h-[3px] bg-gradient-to-r from-blue-500 via-indigo-500 to-emerald-500 rounded-full relative overflow-hidden shadow-[0_0_12px_rgba(59,130,246,0.5)]">
            <div class="absolute inset-0 bg-white w-1/3 animate-laser-flow"></div>
          </div>
        </div>

        <div class="glass-panel-premium rounded-[2.5rem] p-6 shadow-2xl relative border-slate-200/50 hover:scale-[1.02] hover:shadow-indigo-500/10 transition-all duration-500 group/insta">
          <div class="absolute top-4 left-6 flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-red-400"></span>
            <span class="h-2 w-2 rounded-full bg-yellow-400"></span>
            <span class="h-2 w-2 rounded-full bg-green-400"></span>
          </div>
          <div class="text-center border-b border-slate-100 pb-3 mb-5">
            <div class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400 group-hover/insta:text-slate-600 transition-colors">Fashion boutique Instagram DM</div>
            <div class="text-xs font-black text-slate-900 mt-0.5">@buyer_chat</div>
          </div>

          <div class="space-y-4 min-h-[290px] flex flex-col justify-start">
            <div class="flex gap-2">
              <img src="/buyer_avatar.webp" alt="Buyer avatar" class="h-7 w-7 rounded-full object-cover shrink-0 shadow-sm border border-slate-100" />
              <div class="rounded-2xl bg-slate-100 px-3 py-2 text-xs font-medium text-slate-800 shadow-sm max-w-[80%]">
                Hi, is the linen co-ord set from today's Reel available in Size M?
              </div>
            </div>

            <div class="flex gap-2 justify-end">
              <div class="rounded-2xl bg-blue-600 px-3 py-2 text-xs font-semibold text-white shadow-md max-w-[80%]">
                Yes, Size M is available in sage and ivory. Let me check delivery. What is your PIN code?
              </div>
              <div class="h-7 w-7 rounded-full bg-blue-50 border border-blue-100 shrink-0 flex items-center justify-center p-1.5 shadow-sm">
                <img src="/voluchat_logo.svg" alt="VoluChat AI" class="w-full h-full object-contain" />
              </div>
            </div>

            <div class="flex gap-2">
              <img src="/buyer_avatar.webp" alt="Buyer avatar" class="h-7 w-7 rounded-full object-cover shrink-0 shadow-sm border border-slate-100" />
              <div class="rounded-2xl bg-slate-100 px-3 py-2 text-xs font-medium text-slate-800 shadow-sm max-w-[80%]">
                Pune 411014. Can I pay on WhatsApp after you confirm the shade?
              </div>
            </div>

            <div class="flex gap-2 justify-end">
              <div class="rounded-2xl bg-blue-600 px-3 py-2 text-xs font-semibold text-white shadow-md max-w-[80%]">
                Done. I sent the product, size, shade preference, and PIN to WhatsApp so your order team can confirm quickly.
              </div>
              <div class="h-7 w-7 rounded-full bg-blue-50 border border-blue-100 shrink-0 flex items-center justify-center p-1.5 shadow-sm">
                <img src="/voluchat_logo.svg" alt="VoluChat AI" class="w-full h-full object-contain" />
              </div>
            </div>
          </div>
        </div>

        <div class="glass-panel-premium rounded-[2.5rem] p-6 shadow-2xl relative border-emerald-500/20 hover:scale-[1.02] hover:shadow-emerald-500/10 transition-all duration-500 group/wa">
          <div class="absolute inset-0 bg-emerald-500/[0.01] rounded-[2.5rem] pointer-events-none"></div>
          
          <div class="text-center border-b border-slate-100 pb-3 mb-5">
            <div class="text-[9px] font-black uppercase tracking-[0.2em] text-emerald-600 group-hover/wa:text-emerald-700 transition-colors">WhatsApp handoff panel</div>
            <div class="text-xs font-black text-slate-900 mt-0.5">Buyer summary for staff</div>
          </div>

          <div class="space-y-3 min-h-[290px] flex flex-col justify-center">
            <div class="bg-white border border-slate-100 rounded-xl p-3 shadow-sm flex items-center justify-between">
              <div>
                <div class="text-[8px] font-black uppercase tracking-wider text-slate-400">Matched catalog item</div>
                <div class="text-xs font-black text-slate-950 mt-0.5">Linen co-ord set</div>
              </div>
              <span class="text-[10px] font-black text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full border border-blue-100">Catalog match</span>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="bg-white border border-slate-100 rounded-xl p-3 shadow-sm">
                <div class="text-[8px] font-black uppercase tracking-wider text-slate-400">Size</div>
                <div class="text-xs font-black text-slate-950 mt-0.5">Size M</div>
              </div>
              <div class="bg-white border border-slate-100 rounded-xl p-3 shadow-sm">
                <div class="text-[8px] font-black uppercase tracking-wider text-slate-400">PIN code</div>
                <div class="text-xs font-black text-slate-950 mt-0.5">Pune 411014</div>
              </div>
            </div>

            <div class="bg-white border border-slate-100 rounded-xl p-3 shadow-sm">
              <div class="text-[8px] font-black uppercase tracking-wider text-slate-400">Buyer note</div>
              <div class="text-xs font-semibold text-slate-800 mt-0.5">Confirm sage shade before payment</div>
            </div>

            <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-3 shadow-sm flex items-center justify-between">
              <div>
                <div class="text-[8px] font-black uppercase tracking-wider text-emerald-600">Handoff status</div>
                <div class="text-xs font-black text-emerald-800 mt-0.5">Ready for WhatsApp handoff</div>
              </div>
              <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)] animate-pulse"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 42% at 50% 0%, rgba(59, 130, 246, 0.18), transparent 72%),
      radial-gradient(circle at 18% 40%, rgba(14, 165, 233, 0.12), transparent 28rem),
      linear-gradient(180deg, rgba(248, 251, 255, 0.66) 0%, rgba(248, 251, 255, 0.2) 70%, transparent 100%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(15, 23, 42, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, 0.05) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 78%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 78%);
  }

  .hero-fade {
    position: absolute;
    inset: auto 0 0;
    height: 180px;
    background: linear-gradient(to top, rgba(248, 251, 255, 0.88), transparent);
  }

  @keyframes laser-flow {
    0% { left: -100%; }
    100% { left: 100%; }
  }

  .animate-laser-flow {
    animation: laser-flow 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
  }
</style>
