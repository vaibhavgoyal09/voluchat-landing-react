---

---

<section
  id="hero"
  class="hero-section relative isolate overflow-hidden pt-[7.5rem] pb-16 sm:pt-[8.5rem] lg:pt-[9rem] lg:pb-24"
>
  <!-- Modern layered background (pure CSS, zero JS) -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-grid"></div>
    <div class="hero-bg-mesh"></div>
    <div class="hero-bg-orb hero-bg-orb--teal"></div>
    <div class="hero-bg-orb hero-bg-orb--emerald"></div>
    <div class="hero-bg-orb hero-bg-orb--violet"></div>
    <div class="hero-bg-scan"></div>
    <div class="hero-bg-vignette"></div>
  </div>

  <div class="page-shell relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <!-- Copy Block -->
      <div class="text-center lg:text-left">
        <!-- Private Pilot Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/25 bg-[#101012] px-3.5 py-1 text-xs font-medium text-emerald-300">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Private Pilot Cohort: <strong class="font-semibold text-white">10 Fashion &amp; Boutique Brands Only</strong></span>
        </div>

        <h1
          class="hero-title mt-7 font-heading text-[2.75rem] font-bold leading-[1.02] tracking-[-0.035em] sm:text-[3.25rem] lg:text-[3.6rem] xl:text-[4rem] text-[#fcfdff]"
        >
          <span>
            Your Instagram Reels Bring the Traffic.
          </span>
          <span class="block text-emerald-400 pb-1">VoluChat Closes the Sale on WhatsApp.</span>
        </h1>

        <p
          class="hero-text mx-auto mt-6 max-w-xl text-lg font-normal leading-relaxed text-[rgba(252,253,255,0.7)] sm:text-xl lg:mx-0"
        >
          Turn Instagram comments and DMs into WhatsApp conversations — and conversations into orders, automatically.
        </p>

        <div
          class="hero-ctas mt-8 flex flex-col items-center gap-3.5 sm:flex-row sm:justify-center lg:justify-start"
        >
          <a href="/contact" class="btn-primary">
            Apply for 1 of 10 Fashion Pilot Spots &rarr;
          </a>
          <a href="#how-it-works-flow" class="btn-secondary">
            See How It Works
          </a>
        </div>

        <!-- Trust Metrics Bar -->
        <div class="mt-9 grid grid-cols-3 gap-3 border-t border-white/[0.08] pt-6 text-left max-w-lg mx-auto lg:mx-0">
          <div>
            <div class="font-heading text-xl sm:text-2xl font-bold text-white tracking-tight">2.0<span class="text-emerald-400">s</span></div>
            <p class="text-[11px] font-normal text-slate-400 mt-0.5">Comment-to-DM Reply</p>
          </div>
          <div>
            <div class="font-heading text-xl sm:text-2xl font-bold text-white tracking-tight">&lt;90<span class="text-emerald-400">s</span></div>
            <p class="text-[11px] font-normal text-slate-400 mt-0.5">WhatsApp Checkout</p>
          </div>
          <div>
            <div class="font-heading text-xl sm:text-2xl font-bold text-white tracking-tight">10<span class="text-emerald-400">x</span></div>
            <p class="text-[11px] font-normal text-slate-400 mt-0.5">Pilot ROI Standard</p>
          </div>
        </div>
      </div>

      <!-- Hero Visual: phone on a subtle glowing stage -->
      <div class="hero-mockup relative mx-auto w-full max-w-[260px] sm:max-w-[280px] lg:mx-0 lg:justify-self-center -mt-8 lg:-mt-12" data-tilt-strength="2">
        <!-- Stage atmospheric glow (Resend subtle radial) -->
        <div class="absolute left-1/2 top-1/2 -z-10 h-[380px] w-[380px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-emerald-500/10 blur-[80px]"></div>

        <!-- Phone Frame -->
        <div class="tilt relative rounded-[2.5rem] border border-white/[0.14] bg-[#0a0a0c] p-[4px]">
          <div class="relative overflow-hidden rounded-[2.25rem] bg-[#000000]" style="aspect-ratio: 9 / 20.5;">
            <!-- Dynamic Island / Notch -->
            <div class="absolute left-1/2 top-2 z-20 h-5 w-24 -translate-x-1/2 rounded-full bg-[#101012]"></div>
            <video
              src="/voluchat_demo_optimized.mp4"
              class="absolute inset-0 h-full w-full object-cover"
              autoplay
              loop
              muted
              playsinline>
            </video>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroMockupPop {
    from {
      opacity: 0;
      transform: translateY(22px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .hero-title {
    animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-text {
    animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
    opacity: 0;
  }

  .hero-ctas {
    animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    opacity: 0;
  }

  .hero-mockup {
    animation: heroMockupPop 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-text,
    .hero-ctas,
    .hero-mockup {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
