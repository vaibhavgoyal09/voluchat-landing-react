---
---

<section id="hero" class="relative min-h-[100dvh] overflow-hidden pt-28 pb-20 md:pt-34">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-wash"></div>
    <div class="hero-grid"></div>
    <div class="hero-fade"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6">
    <div class="grid items-end gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="max-w-4xl text-left">
      <div id="hero-badge" class="inline-flex items-center gap-2 rounded-lg border border-primary-200/80 bg-primary-50/80 px-4 py-2 text-sm font-semibold text-primary-900 shadow-sm backdrop-blur-2xl">
        <span class="h-2 w-2 rounded-full bg-primary-600 shadow-[0_0_8px_rgba(51,141,115,0.42)]"></span>
        <span>14-day free trial for Instagram boutiques</span>
      </div>

      <h1 id="hero-title" class="mt-7 max-w-4xl text-[2.8rem] font-semibold leading-[0.96] text-stone-950 sm:text-6xl lg:text-7xl">
        Turn Instagram interest into WhatsApp-ready boutique chats.
      </h1>

      <p id="hero-description" class="mt-7 max-w-2xl text-lg font-medium leading-relaxed text-stone-600 sm:text-xl">
        VoluChat replies to Instagram shoppers, answers product questions, checks catalog details, and prepares clean WhatsApp handoffs for your boutique team.
      </p>

      <div id="hero-actions" class="mt-10 flex flex-col items-stretch gap-4 sm:flex-row sm:items-center">
        <a href="/contact" class="group relative inline-flex w-full items-center justify-center gap-3 rounded-xl bg-stone-950 px-8 py-4.5 text-base font-semibold text-white shadow-2xl shadow-stone-900/15 transition-all duration-300 hover:-translate-y-1 hover:bg-primary-700 sm:w-auto overflow-hidden">
          <span class="relative z-10">Start 14-day free trial</span>
          <span class="h-2 w-2 rounded-full bg-primary-300 group-hover:bg-white transition-colors duration-300 relative z-10"></span>
        </a>
        <a href="#demo" class="group inline-flex w-full items-center justify-center gap-2 rounded-xl border border-stone-200/80 bg-white/70 px-8 py-4.5 text-base font-semibold text-stone-900 shadow-sm backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:border-stone-300 sm:w-auto cursor-pointer">
          Watch boutique flow
        </a>
      </div>

      <dl class="mt-12 grid max-w-xl grid-cols-3 gap-4 border-t border-stone-200/80 pt-6">
        <div>
          <dt class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-stone-400">Setup</dt>
          <dd class="mt-1 text-sm font-semibold text-stone-900">Guided</dd>
        </div>
        <div>
          <dt class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-stone-400">Handoff</dt>
          <dd class="mt-1 text-sm font-semibold text-stone-900">WhatsApp</dd>
        </div>
        <div>
          <dt class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-stone-400">Trial</dt>
          <dd class="mt-1 text-sm font-semibold text-stone-900">14 days</dd>
        </div>
      </dl>
      </div>

      <aside class="hidden rounded-3xl border border-white/70 bg-white/46 p-5 shadow-premium backdrop-blur-2xl lg:block">
        <div class="aspect-[4/3] overflow-hidden rounded-2xl bg-stone-950">
          <img src="/dashboard-preview.png" alt="VoluChat dashboard preview with boutique conversation queues" class="h-full w-full object-cover opacity-90 mix-blend-screen" />
        </div>
        <div class="mt-5 flex items-center justify-between gap-4">
          <div>
            <p class="text-sm font-semibold text-stone-950">Boutique queue view</p>
            <p class="mt-1 text-xs font-medium text-stone-500">DMs grouped by status before staff handoff.</p>
          </div>
          <span class="rounded-lg border border-primary-200 bg-primary-50 px-3 py-1.5 text-xs font-semibold text-primary-800">Live demo</span>
        </div>
      </aside>
    </div>

    <div id="hero-scene" class="relative mx-auto mt-16 w-full max-w-6xl overflow-visible">
      <div class="absolute inset-0 -z-10 overflow-visible flex items-center justify-center pointer-events-none">
        <div class="absolute h-[260px] w-[112%] rounded-full bg-primary-500/12 blur-[100px]"></div>
      </div>

      <div class="grid gap-8 lg:grid-cols-2 items-center relative">
        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-12 hidden lg:flex items-center justify-center z-20 pointer-events-none">
          <div class="w-full h-[3px] bg-gradient-to-r from-primary-600 via-primary-500 to-emerald-500 rounded-full relative overflow-hidden shadow-[0_0_12px_rgba(51,141,115,0.38)]">
            <div class="absolute inset-0 bg-white w-1/3 animate-laser-flow"></div>
          </div>
        </div>

        <div class="glass-panel-premium rounded-3xl p-6 shadow-2xl relative border-stone-200/50 transition-all duration-500 group/insta">
          <div class="absolute top-4 left-6 flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-red-400"></span>
            <span class="h-2 w-2 rounded-full bg-yellow-400"></span>
            <span class="h-2 w-2 rounded-full bg-green-400"></span>
          </div>
          <div class="text-center border-b border-stone-100 pb-3 mb-5">
            <div class="text-[9px] font-semibold uppercase tracking-[0.18em] text-stone-400 group-hover/insta:text-stone-600 transition-colors">Fashion boutique Instagram DM</div>
            <div class="text-xs font-semibold text-stone-900 mt-0.5">@buyer_chat</div>
          </div>

          <div class="space-y-4 min-h-[290px] flex flex-col justify-start">
            <div class="flex gap-2">
              <img src="/buyer_avatar.webp" alt="Buyer avatar" class="h-7 w-7 rounded-full object-cover shrink-0 shadow-sm border border-stone-100" />
              <div class="rounded-2xl bg-stone-100 px-3 py-2 text-xs font-medium text-stone-800 shadow-sm max-w-[80%]">
                Hi, is the linen co-ord set from today's Reel available in Size M?
              </div>
            </div>

            <div class="flex gap-2 justify-end">
              <div class="rounded-2xl bg-primary-700 px-3 py-2 text-xs font-semibold text-white shadow-md max-w-[80%]">
                Yes, Size M is available in sage and ivory. Let me check delivery. What is your PIN code?
              </div>
              <div class="h-7 w-7 rounded-full bg-primary-50 border border-primary-100 shrink-0 flex items-center justify-center p-1.5 shadow-sm">
                <img src="/voluchat_logo.svg" alt="VoluChat AI" class="w-full h-full object-contain" />
              </div>
            </div>

            <div class="flex gap-2">
              <img src="/buyer_avatar.webp" alt="Buyer avatar" class="h-7 w-7 rounded-full object-cover shrink-0 shadow-sm border border-stone-100" />
              <div class="rounded-2xl bg-stone-100 px-3 py-2 text-xs font-medium text-stone-800 shadow-sm max-w-[80%]">
                Pune 411014. Can I pay on WhatsApp after you confirm the shade?
              </div>
            </div>

            <div class="flex gap-2 justify-end">
              <div class="rounded-2xl bg-primary-700 px-3 py-2 text-xs font-semibold text-white shadow-md max-w-[80%]">
                Done. I sent the product, size, shade preference, and PIN to WhatsApp so your order team can confirm quickly.
              </div>
              <div class="h-7 w-7 rounded-full bg-primary-50 border border-primary-100 shrink-0 flex items-center justify-center p-1.5 shadow-sm">
                <img src="/voluchat_logo.svg" alt="VoluChat AI" class="w-full h-full object-contain" />
              </div>
            </div>
          </div>
        </div>

        <div class="glass-panel-premium rounded-3xl p-6 shadow-2xl relative border-primary-500/20 transition-all duration-500 group/wa lg:translate-y-12">
          <div class="absolute inset-0 bg-primary-500/[0.015] rounded-3xl pointer-events-none"></div>
          
          <div class="text-center border-b border-stone-100 pb-3 mb-5">
            <div class="text-[9px] font-semibold uppercase tracking-[0.18em] text-primary-700 group-hover/wa:text-primary-800 transition-colors">WhatsApp handoff panel</div>
            <div class="text-xs font-semibold text-stone-900 mt-0.5">Buyer summary for staff</div>
          </div>

          <div class="space-y-3 min-h-[290px] flex flex-col justify-center">
            <div class="bg-white border border-stone-100 rounded-xl p-3 shadow-sm flex items-center justify-between">
              <div>
                <div class="text-[8px] font-semibold uppercase tracking-wider text-stone-400">Matched catalog item</div>
                <div class="text-xs font-semibold text-stone-950 mt-0.5">Linen co-ord set</div>
              </div>
              <span class="text-[10px] font-semibold text-primary-700 bg-primary-50 px-2 py-0.5 rounded-full border border-primary-100">Catalog match</span>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="bg-white border border-stone-100 rounded-xl p-3 shadow-sm">
                <div class="text-[8px] font-semibold uppercase tracking-wider text-stone-400">Size</div>
                <div class="text-xs font-semibold text-stone-950 mt-0.5">Size M</div>
              </div>
              <div class="bg-white border border-stone-100 rounded-xl p-3 shadow-sm">
                <div class="text-[8px] font-semibold uppercase tracking-wider text-stone-400">PIN code</div>
                <div class="text-xs font-semibold text-stone-950 mt-0.5">Pune 411014</div>
              </div>
            </div>

            <div class="bg-white border border-stone-100 rounded-xl p-3 shadow-sm">
              <div class="text-[8px] font-semibold uppercase tracking-wider text-stone-400">Buyer note</div>
              <div class="text-xs font-semibold text-stone-800 mt-0.5">Confirm sage shade before payment</div>
            </div>

            <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-3 shadow-sm flex items-center justify-between">
              <div>
                <div class="text-[8px] font-semibold uppercase tracking-wider text-emerald-600">Handoff status</div>
                <div class="text-xs font-semibold text-emerald-800 mt-0.5">Ready for WhatsApp handoff</div>
              </div>
              <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)] animate-pulse"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 42% at 45% 0%, rgba(51, 141, 115, 0.16), transparent 72%),
      radial-gradient(circle at 18% 40%, rgba(120, 113, 108, 0.1), transparent 28rem),
      linear-gradient(180deg, rgba(251, 250, 247, 0.78) 0%, rgba(251, 250, 247, 0.2) 70%, transparent 100%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(68, 64, 60, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(68, 64, 60, 0.05) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 78%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 78%);
  }

  .hero-fade {
    position: absolute;
    inset: auto 0 0;
    height: 180px;
    background: linear-gradient(to top, rgba(251, 250, 247, 0.9), transparent);
  }

  @keyframes laser-flow {
    0% { left: -100%; }
    100% { left: 100%; }
  }

  .animate-laser-flow {
    animation: laser-flow 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
  }
</style>
