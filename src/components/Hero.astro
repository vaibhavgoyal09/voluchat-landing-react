---
---

<section id="hero" class="relative min-h-[100svh] overflow-hidden pt-28 pb-12 md:pt-32">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-wash"></div>
    <div class="hero-grid"></div>
    <div class="hero-fade"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div id="hero-badge" class="glass inline-flex items-center gap-2 rounded-full px-4 py-2 opacity-0 translate-y-4">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#0668E1] text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </span>
        <span class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-700">Official Meta Tech Partner</span>
      </div>

      <div id="hero-intro" class="mt-8 text-lg font-black text-indigo-600 uppercase tracking-[0.2em] opacity-0 translate-y-4">
        Introducing VoluChat AI Agent
      </div>

      <h1 id="hero-title" class="mt-4 text-4xl font-black leading-[1.1] tracking-tight text-slate-950 opacity-0 translate-y-8 sm:text-5xl lg:text-7xl">
        Stop typing. <br />
        <span class="text-gradient-primary">Start selling.</span>
      </h1>

      <p id="hero-description" class="mx-auto mt-8 max-w-3xl text-lg font-medium leading-relaxed text-slate-600 opacity-0 translate-y-8 sm:text-xl">
        Stores lose 20–40% of potential buyers due to delayed replies. Our smart chatbot replies to every Instagram comment and DM instantly, 24/7.
      </p>

      <div id="hero-actions" class="mt-8 flex flex-col items-center justify-center gap-4 opacity-0 translate-y-8 sm:flex-row">
        <a href="/contact" class="group inline-flex w-full items-center justify-center rounded-full bg-slate-950 px-7 py-4 text-base font-bold text-white shadow-xl shadow-slate-900/15 transition hover:-translate-y-0.5 hover:bg-slate-800 sm:w-auto">
          Start capturing missed customers today
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-2 transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="#demo" class="glass inline-flex w-full items-center justify-center rounded-full px-7 py-4 text-base font-bold text-slate-800 transition hover:-translate-y-0.5 hover:text-indigo-700 sm:w-auto">
          See how it works
        </a>
      </div>

      <div id="hero-trust" class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 opacity-0 translate-y-8">
        <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.16em] text-slate-500">
          Made for scaling Indian brands
        </span>
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Official Meta APIs</span>
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">No password sharing</span>
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Enterprise Security</span>
      </div>
    </div>

    <!-- Glass Orchestra Container -->
    <div id="hero-scene" class="relative mx-auto mt-24 max-w-6xl opacity-0 translate-y-10 min-h-[650px]">
      <!-- Central Chat Panel (The Lead) -->
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 w-full max-w-lg lg:max-w-xl animate-float-slow">
        <div class="glass-panel-premium rounded-[2.5rem] p-8 shadow-[0_40px_80px_-15px_rgba(0,0,0,0.08)] ring-1 ring-white/50">
          <div class="flex items-center justify-between mb-8 pb-4 border-b border-white/20">
            <div class="flex items-center gap-3">
              <div class="h-3 w-3 rounded-full bg-slate-300"></div>
              <div class="h-3 w-3 rounded-full bg-slate-300"></div>
              <div class="h-3 w-3 rounded-full bg-slate-300"></div>
            </div>
            <div class="flex items-center gap-2 px-3 py-1 bg-indigo-500/10 rounded-full border border-indigo-500/20">
              <span class="h-1.5 w-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
              <span class="text-[10px] font-black text-indigo-600 uppercase tracking-widest">AI Intelligent Agent</span>
            </div>
          </div>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="h-10 w-10 rounded-2xl bg-gradient-to-br from-slate-100 to-slate-200 border border-white flex-shrink-0"></div>
              <div class="bg-white/40 rounded-2xl rounded-tl-none px-5 py-4 text-sm font-medium text-slate-700 leading-relaxed border border-white/60">
                Hi! Is the <span class="font-bold text-slate-900">Floral Summer Dress</span> available in size L?
              </div>
            </div>
            <div class="flex flex-row-reverse items-start gap-4">
              <div class="h-10 w-10 rounded-2xl bg-indigo-600 shadow-lg shadow-indigo-200 flex-shrink-0 flex items-center justify-center text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
              </div>
              <div class="bg-indigo-600 rounded-2xl rounded-tr-none px-6 py-4 text-sm font-bold text-white leading-relaxed shadow-xl shadow-indigo-100">
                Yes! We have 2 left in stock. I've added it to your wishlist. Would you like to check out now?
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Secondary Floating Panels -->
      
      <!-- Top Left: Success Rate -->
      <div class="absolute -top-10 left-10 lg:left-0 z-30 animate-float" style="animation-delay: 1s;">
        <div class="glass-card-premium rounded-3xl p-6 shadow-2xl min-w-[180px]">
          <div class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Automated</div>
          <div class="flex items-baseline gap-1">
            <span class="text-4xl font-black text-slate-900">84</span>
            <span class="text-xl font-black text-indigo-600">%</span>
          </div>
          <div class="mt-3 h-1.5 w-full bg-slate-100 rounded-full overflow-hidden">
            <div class="h-full w-[84%] bg-indigo-600 rounded-full shadow-[0_0_8px_rgba(79,70,229,0.4)]"></div>
          </div>
        </div>
      </div>

      <!-- Top Right: Interactive Toggle -->
      <div class="absolute top-0 right-10 lg:-right-10 z-30 animate-float" style="animation-delay: 0.5s;">
        <div class="glass-card-premium rounded-full px-6 py-3 shadow-xl flex items-center gap-4">
          <span class="text-xs font-black text-slate-700 uppercase tracking-wider">Smart Auto-Reply</span>
          <div class="h-6 w-11 rounded-full bg-indigo-600 p-1 flex justify-end shadow-inner">
            <div class="h-4 w-4 rounded-full bg-white shadow-sm"></div>
          </div>
        </div>
      </div>

      <!-- Bottom Right: Product Discovery -->
      <div class="absolute bottom-0 right-10 lg:-right-20 z-30 animate-float" style="animation-delay: 1.5s;">
        <div class="glass-card-premium rounded-3xl p-5 shadow-2xl w-64">
          <div class="flex gap-4 items-center mb-4">
            <div class="h-12 w-12 rounded-xl bg-gradient-to-br from-indigo-50 to-white border border-white flex-shrink-0 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-indigo-600"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <div>
              <div class="text-[10px] font-black text-slate-400 uppercase tracking-widest">AI Discovery</div>
              <div class="text-xs font-black text-slate-900 leading-none mt-1">Matching Products...</div>
            </div>
          </div>
          <div class="space-y-2">
            <div class="h-12 w-full bg-white/40 border border-white/60 rounded-xl flex items-center px-4 gap-3">
              <div class="h-6 w-6 rounded-md bg-white shadow-sm"></div>
              <div class="h-2 w-24 bg-slate-200 rounded-full"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Left: Satisfaction -->
      <div class="absolute bottom-10 left-10 lg:-left-10 z-30 animate-float" style="animation-delay: 2s;">
        <div class="glass-card-premium rounded-2xl p-4 shadow-xl max-w-[220px]">
          <div class="flex items-center gap-3">
            <div class="flex -space-x-2">
              {[1,2,3].map(i => (
                <div class="h-7 w-7 rounded-full border-2 border-white bg-slate-100 overflow-hidden shadow-sm">
                  <img src={`https://api.dicebear.com/7.x/avataaars/svg?seed=${i}`} alt="user" />
                </div>
              ))}
            </div>
            <div class="text-[10px] font-bold text-slate-600 leading-tight">
              Loved by <span class="text-indigo-600">500+</span> store owners
            </div>
          </div>
        </div>
      </div>

      <!-- Background Accents -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] h-[140%] -z-10 overflow-hidden">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-indigo-400/5 blur-[120px] rounded-full"></div>
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-emerald-400/5 blur-[120px] rounded-full"></div>
        <div class="absolute inset-0 hero-dot-grid opacity-20"></div>
      </div>
    </div>


  </div>
</section>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 42% at 50% 0%, rgba(79, 70, 229, 0.2), transparent 72%),
      radial-gradient(circle at 18% 40%, rgba(14, 165, 233, 0.12), transparent 28rem),
      linear-gradient(180deg, rgba(248,251,255,0.66) 0%, rgba(248,251,255,0.2) 70%, transparent 100%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(15, 23, 42, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, 0.05) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 78%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 78%);
  }

  .hero-fade {
    position: absolute;
    inset: auto 0 0;
    height: 180px;
    background: linear-gradient(to top, rgba(248,251,255,0.88), transparent);
  }

  .hero-dot-grid {
    background-image: radial-gradient(circle, #cbd5e1 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 60% 60% at 50% 50%, black 20%, transparent 100%);
    opacity: 0.4;
  }

  .floating-card {
    transition: transform 0.3s ease;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  @keyframes float-slow {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-20px) scale(1.02); }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-float-slow {
    animation: float-slow 8s ease-in-out infinite;
  }
</style>

<script>
  import { gsap } from 'gsap';

  window.addEventListener('load', () => {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out', duration: 1 } });

    tl.to('#hero-badge', { opacity: 1, y: 0, delay: 0.2 })
      .to('#hero-intro', { opacity: 1, y: 0 }, '-=0.7')
      .to('#hero-title', { opacity: 1, y: 0 }, '-=0.8')
      .to('#hero-description', { opacity: 1, y: 0 }, '-=0.8')
      .to('#hero-actions', { opacity: 1, y: 0 }, '-=0.8')
      .to('#hero-trust', { opacity: 1, y: 0 }, '-=0.8')
      .to('#hero-scene', { opacity: 1, y: 0 }, '-=0.6');
  });
</script>
