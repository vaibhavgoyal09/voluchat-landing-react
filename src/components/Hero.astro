---
---
<section id="hero" class="relative pt-24 pb-16 lg:pt-32 lg:pb-20 overflow-hidden min-h-[100svh] flex flex-col items-center justify-center">
  <!-- Professional CSS Background -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-wash"></div>
    <div class="hero-spotlight"></div>
    <div class="hero-mesh hero-mesh-1"></div>
    <div class="hero-mesh hero-mesh-2"></div>
    <div class="hero-beam hero-beam-1"></div>
    <div class="hero-beam hero-beam-2"></div>
    <div class="hero-ring"></div>
    <div class="hero-grid"></div>
    <div class="hero-noise"></div>
    <!-- Bottom fade -->
    <div class="hero-fade"></div>
  </div>

  <!-- Content -->
  <div class="container-wide relative z-10 px-6 text-center max-w-5xl">
    <div id="hero-badge" class="inline-flex overflow-hidden relative items-center gap-2 px-1 py-1 rounded-full bg-slate-900/5 backdrop-blur-xl border border-slate-900/10 shadow-[0_0_20px_rgba(79,70,229,0.1)] mb-6 opacity-0 translate-y-4 transition-all hover:bg-slate-900/10 cursor-pointer group">
      <div class="px-3 py-1.5 rounded-full bg-white/90 shadow-sm flex items-center gap-2">
        <div class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0668E1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 11 11 13 15 9"/></svg>
          <span class="text-slate-900 text-[10px] sm:text-xs font-black tracking-wider uppercase">Official Meta Tech Provider</span>
        </div>
      </div>
      <span class="text-slate-700 text-xs sm:text-sm font-medium pr-4 pl-1 group-hover:text-indigo-700 transition-colors">100% Account Safety &rarr;</span>
    </div>

    <h1 id="hero-title" class="text-4xl sm:text-6xl lg:text-[4.5rem] font-bold tracking-tight text-slate-900 leading-[1.05] mb-4 opacity-0 translate-y-8 drop-shadow-sm">
      Automate <span class="text-gradient-primary transition-all duration-700">Instagram & Facebook</span> <br class="hidden lg:block" />
      <span class="relative inline-block mt-2 sm:mt-0">
        <span class="absolute -inset-2 bg-gradient-to-r from-indigo-100 to-purple-100 blur-xl opacity-50 rounded-full"></span>
        <span class="relative font-serif italic text-slate-700 font-medium">
          Sales 24/7
        </span>
      </span>
    </h1>

    <p id="hero-description" class="text-lg sm:text-xl text-slate-600 leading-relaxed max-w-2xl mx-auto mb-6 font-medium opacity-0 translate-y-8">
      The ultimate DM automation tool built specifically for small businesses selling online. <br class="hidden md:block" />
      Automate comments, stories, and order processing <span class="text-indigo-600 font-semibold border-b-2 border-indigo-200">while you sleep.</span>
    </p>

    <div id="hero-actions" class="flex flex-col sm:flex-row gap-6 items-center justify-center opacity-0 translate-y-8 mb-6">
      <div class="relative group w-full sm:w-auto">
        <div class="absolute -inset-1 bg-gradient-to-r from-indigo-600 to-purple-600 rounded-full blur opacity-25 group-hover:opacity-75 transition duration-500"></div>
        <a href="https://dashboard.voluchat.com" class="relative flex items-center justify-center px-8 py-4 bg-slate-900 text-white rounded-full font-semibold text-lg transition-all duration-300 group-hover:scale-105 group-active:scale-95 shadow-xl">
          Get Started for Free
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-2 group-hover:translate-x-1.5 transition-transform duration-300"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
      <a href="#demo" class="relative group flex items-center justify-center px-8 py-4 bg-white/40 backdrop-blur-xl border border-white/60 text-slate-800 rounded-full font-semibold text-lg transition-all duration-300 hover:bg-white/60 hover:shadow-lg hover:-translate-y-1 w-full sm:w-auto">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 text-slate-500 group-hover:text-indigo-600 transition-colors"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
        Watch Demo
      </a>
    </div>

    <!-- Meta Trust line -->
    <div class="flex items-center justify-center gap-2 mb-12 opacity-0 translate-y-8" id="hero-trust">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#0668E1"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
      <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Meta Business Partner Integration</span>
    </div>

    <!-- Stats Bar -->
    <div id="hero-stats" class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6 opacity-0 translate-y-8 py-6 border-y border-slate-200/50 bg-slate-50/30 backdrop-blur-sm rounded-2xl px-8">
      <div class="flex flex-col items-center sm:items-start">
        <span class="text-2xl font-bold text-slate-900">80%</span>
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-widest">Queries Automated</span>
      </div>
      <div class="w-px h-8 bg-slate-200 hidden sm:block"></div>
      <div class="flex flex-col items-center sm:items-start">
        <span class="text-2xl font-bold text-slate-900">&lt; 1s</span>
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-widest">AI Response Time</span>
      </div>
      <div class="w-px h-8 bg-slate-200 hidden sm:block"></div>
      <div class="flex flex-col items-center sm:items-start">
        <span class="text-2xl font-bold text-slate-900">₹1.4L+</span>
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-widest">Potential Revenue/Mo</span>
      </div>
    </div>
  </div>

  <!-- Decorative elements (Floating UI Cards) -->
  <div id="hero-deco-1" class="absolute right-4 lg:right-16 top-1/4 hidden md:block opacity-0 z-20 pointer-events-none">
    <div class="w-64 h-auto bg-white/40 backdrop-blur-2xl border border-white/50 p-5 rounded-3xl shadow-[0_8px_40px_rgb(0,0,0,0.08)] animate-float rotate-6 transform transition-transform hover:scale-110 hover:rotate-0" style="animation-duration: 6s;">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
          <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Live Revenue</span>
        </div>
        <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">+12.5%</span>
      </div>
      <div class="text-3xl font-black text-slate-900 tracking-tighter mb-1">₹1,45,280</div>
      <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Potential Growth</div>
    </div>
  </div>
  <div id="hero-deco-2" class="absolute left-4 lg:left-16 top-1/2 hidden md:block opacity-0 z-20 pointer-events-none">
    <div class="w-56 h-auto bg-white/40 backdrop-blur-2xl border border-white/50 p-5 rounded-3xl shadow-[0_8px_40px_rgb(0,0,0,0.08)] animate-float -rotate-3 transform transition-transform hover:scale-110 hover:rotate-0" style="animation-duration: 8s; animation-delay: 1s;">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
        <span class="text-[10px] font-black text-slate-800 uppercase tracking-widest">AI Status</span>
      </div>
      <div class="space-y-3">
        <div class="flex justify-between items-center">
          <div class="h-1.5 w-24 bg-indigo-200/50 rounded-full overflow-hidden">
            <div class="h-full w-4/5 bg-indigo-600 rounded-full animate-pulse"></div>
          </div>
          <span class="text-[9px] font-bold text-indigo-600">80% Auto</span>
        </div>
        <div class="flex justify-between items-center">
          <div class="h-1.5 w-24 bg-emerald-200/50 rounded-full overflow-hidden">
            <div class="h-full w-[95%] bg-emerald-500 rounded-full"></div>
          </div>
          <span class="text-[9px] font-bold text-emerald-600">Active</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 14% 15%, rgba(39, 180, 255, 0.3) 0%, rgba(39, 180, 255, 0) 46%),
      radial-gradient(circle at 83% 23%, rgba(59, 130, 246, 0.28) 0%, rgba(59, 130, 246, 0) 50%),
      radial-gradient(circle at 50% 82%, rgba(14, 165, 233, 0.22) 0%, rgba(14, 165, 233, 0) 47%);
  }

  .hero-spotlight {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 75% 50% at 50% 42%, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.45) 40%, rgba(255, 255, 255, 0) 100%);
  }

  .hero-mesh {
    position: absolute;
    border-radius: 999px;
    filter: blur(70px);
    will-change: transform;
    mix-blend-mode: multiply;
  }

  .hero-mesh-1 {
    width: 720px;
    height: 520px;
    left: -180px;
    top: -120px;
    background: radial-gradient(circle at 50% 50%, rgba(14, 165, 233, 0.38) 0%, rgba(20, 184, 166, 0.2) 40%, rgba(14, 165, 233, 0) 75%);
    animation: floatMeshA 24s ease-in-out infinite;
  }

  .hero-mesh-2 {
    width: 660px;
    height: 460px;
    right: -150px;
    top: 90px;
    background: radial-gradient(circle at 50% 50%, rgba(29, 78, 216, 0.33) 0%, rgba(56, 189, 248, 0.2) 45%, rgba(59, 130, 246, 0) 75%);
    animation: floatMeshB 30s ease-in-out infinite;
  }

  .hero-beam {
    position: absolute;
    width: 60vw;
    max-width: 760px;
    min-width: 280px;
    height: 160px;
    border-radius: 999px;
    filter: blur(38px);
    transform-origin: center;
    will-change: transform;
    opacity: 0.48;
  }

  .hero-beam-1 {
    top: 8%;
    right: -20%;
    transform: rotate(-18deg);
    background: linear-gradient(90deg, rgba(14, 165, 233, 0) 0%, rgba(14, 165, 233, 0.4) 40%, rgba(59, 130, 246, 0.56) 60%, rgba(59, 130, 246, 0) 100%);
    animation: beamDriftA 16s ease-in-out infinite;
  }

  .hero-beam-2 {
    top: 34%;
    left: -25%;
    transform: rotate(13deg);
    background: linear-gradient(90deg, rgba(20, 184, 166, 0) 0%, rgba(20, 184, 166, 0.34) 43%, rgba(14, 165, 233, 0.5) 58%, rgba(56, 189, 248, 0) 100%);
    animation: beamDriftB 19s ease-in-out infinite;
  }

  .hero-ring {
    position: absolute;
    width: 620px;
    height: 620px;
    top: 56%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: inset 0 0 80px rgba(14, 165, 233, 0.16), 0 0 120px rgba(14, 165, 233, 0.12);
    opacity: 0.8;
    animation: ringPulse 9s ease-in-out infinite;
  }

  /* Dot grid */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(15, 23, 42, 0.2) 0.9px, transparent 1.1px);
    background-size: 30px 30px;
    opacity: 0.28;
    mask-image: radial-gradient(ellipse 88% 66% at 50% 44%, black 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 88% 66% at 50% 44%, black 30%, transparent 100%);
  }

  .hero-noise {
    position: absolute;
    inset: 0;
    opacity: 0.1;
    background-image:
      radial-gradient(circle at 25% 35%, rgba(15, 23, 42, 0.2) 0.7px, transparent 1.2px),
      radial-gradient(circle at 75% 65%, rgba(15, 23, 42, 0.16) 0.6px, transparent 1.1px);
    background-size: 4px 4px, 5px 5px;
    mix-blend-mode: multiply;
  }

  /* Bottom white fade so the section blends into the next */
  .hero-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 240px;
    background: linear-gradient(to top, #ffffff, transparent);
  }

  @keyframes floatMeshA {
    0%, 100% { transform: translate(0, 0) scale(1); }
    35% { transform: translate(52px, 30px) scale(1.05); }
    70% { transform: translate(-20px, -25px) scale(0.95); }
  }

  @keyframes floatMeshB {
    0%, 100% { transform: translate(0, 0) scale(1); }
    45% { transform: translate(-34px, 38px) scale(1.08); }
    75% { transform: translate(24px, -18px) scale(0.97); }
  }

  @keyframes beamDriftA {
    0%, 100% { transform: rotate(-18deg) translateX(0); }
    50% { transform: rotate(-14deg) translateX(-26px); }
  }

  @keyframes beamDriftB {
    0%, 100% { transform: rotate(13deg) translateX(0); }
    50% { transform: rotate(10deg) translateX(32px); }
  }

  @keyframes ringPulse {
    0%, 100% { opacity: 0.55; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 0.8; transform: translate(-50%, -50%) scale(1.06); }
  }

  @media (max-width: 768px) {
    .hero-ring {
      width: 460px;
      height: 460px;
      top: 52%;
      opacity: 0.46;
    }

    .hero-beam {
      opacity: 0.3;
      filter: blur(30px);
    }

    .hero-mesh-1 {
      width: 520px;
      height: 360px;
      left: -180px;
      top: -80px;
    }

    .hero-mesh-2 {
      width: 420px;
      height: 320px;
      right: -170px;
      top: 150px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  // Entrance Animations with GSAP
  window.addEventListener('load', () => {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out', duration: 1 } });
    
    tl.to('#hero-badge', { opacity: 1, y: 0, delay: 0.2 })
      .to('#hero-title', { opacity: 1, y: 0 }, '-=0.6')
      .to('#hero-description', { opacity: 1, y: 0 }, '-=0.7')
      .to('#hero-actions', { opacity: 1, y: 0 }, '-=0.8')
      .to('#hero-trust', { opacity: 1, y: 0 }, '-=0.8')
      .to('#hero-stats', { opacity: 1, y: 0 }, '-=0.8')
      .to('#hero-deco-1', { opacity: 1, x: -50 }, '-=0.5')
      .to('#hero-deco-2', { opacity: 1, x: 50 }, '-=1');
  });
</script>
