---
import HeroAutomationScene from './HeroAutomationScene.astro';
---

<section id="hero" class="relative isolate overflow-hidden pt-28 pb-12 sm:pt-36 lg:min-h-[calc(100dvh-4rem)] lg:pt-32 lg:pb-14">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_12%_18%,rgba(83,111,159,0.11),transparent_28%),radial-gradient(circle_at_82%_10%,rgba(203,217,234,0.16),transparent_26%),linear-gradient(180deg,rgba(255,255,255,0.92),rgba(247,249,252,0.86)_58%,rgba(255,255,255,0.96))]"></div>
  <div class="ambient-noise"></div>

  <div class="page-shell relative z-10 w-full">
    <div class="grid items-center gap-8 lg:grid-cols-[0.92fr_1.08fr] xl:gap-12">
      <div class="max-w-xl text-left">
        <div id="hero-badge" class="chip">
          24/7 product reply and checkout agent
        </div>

        <h1 id="hero-title" class="mt-5 max-w-[17ch] text-[2.9rem] font-semibold leading-[0.94] text-stone-950 sm:mt-6 sm:text-[3.7rem] sm:leading-[0.98] lg:mt-5 lg:text-[3.75rem] xl:text-[4.05rem]">
          <span class="sr-only">Stop Losing Sales to Slow Replies</span>
          <span aria-hidden="true" class="block">Stop Losing</span>
          <span aria-hidden="true" class="block">Sales</span>
          <span aria-hidden="true" class="accent-gradient-text block">to Slow Replies</span>
        </h1>

        <p id="hero-description" class="mt-5 max-w-lg text-base font-medium leading-relaxed text-stone-600 sm:mt-6 sm:text-lg">
          VoluChat keeps Instagram buyers moving from first question to order details while your team focuses on closing.
        </p>

        <p class="mt-3 hidden max-w-lg text-sm font-semibold leading-relaxed text-stone-500 sm:block">
          The agent replies instantly, follows your catalog and policies, and gathers the context your sales team needs before a buyer drops off.
        </p>

        <div id="hero-actions" class="mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row">
          <a href="/contact" class="btn-primary">
            Book demo call
          </a>
          <a href="#demo" class="btn-secondary">
            See automated replies
          </a>
        </div>

        <ol class="mt-7 hidden max-w-lg grid-cols-3 gap-2.5 sm:gap-3 lg:grid" aria-label="VoluChat reply workflow highlights">
          <li class="hero-metric-card kinetic-card">
            <p class="mini-label">Buyer asks</p>
            <p class="mt-2 text-sm font-semibold leading-snug text-stone-950 sm:text-base">Price, size, stock</p>
          </li>
          <li class="hero-metric-card kinetic-card">
            <p class="mini-label">Agent builds</p>
            <p class="mt-2 text-sm font-semibold leading-snug text-stone-950 sm:text-base">Cart + address</p>
          </li>
          <li class="hero-metric-card kinetic-card">
            <p class="mini-label">Store confirms</p>
            <p class="mt-2 text-sm font-semibold leading-snug text-stone-950 sm:text-base">UPI QR + order</p>
          </li>
        </ol>
      </div>

      <HeroAutomationScene />
    </div>
  </div>
</section>
