---
---

<section id="hero" class="relative overflow-hidden pt-28 pb-16 sm:pt-32 lg:min-h-[100dvh] lg:pt-24 lg:pb-12 lg:flex lg:items-center">
  <div class="page-shell relative z-10 w-full">
    <div class="grid items-center gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-10 xl:gap-16">
      <div class="max-w-2xl text-left">
        <div id="hero-badge" class="chip">
          14-day free trial for online stores
        </div>

        <h1 id="hero-title" class="mt-6 text-[2.7rem] font-semibold leading-[1.02] text-stone-950 sm:text-6xl lg:mt-4 lg:text-[3.25rem] xl:text-[3.85rem]">
          Stop Losing Sales to Slow Replies
        </h1>

        <p id="hero-description" class="mt-6 max-w-xl text-base font-medium leading-relaxed text-stone-600 sm:text-lg lg:mt-4 lg:text-base lg:leading-relaxed">
          VoluChat automates repeated product questions across Instagram and Facebook Pages, so shoppers get fast answers about price, size, stock, delivery, and offers. Your team saves hours and steps in when buyers are ready.
        </p>

        <div id="hero-actions" class="mt-8 flex flex-col gap-3 sm:flex-row lg:mt-6">
          <a href="/contact" class="btn-primary">
            Start 14-day free trial
          </a>
          <a href="#demo" class="btn-secondary">
            See automated replies
          </a>
        </div>

        <p class="mt-4 max-w-xl text-xs font-semibold leading-relaxed text-stone-500">
          Built for shoe stores, accessories, premium fashion, jewelry, beauty, and other product-heavy stores where slow replies lose buyers.
        </p>

        <dl class="mt-9 grid max-w-lg grid-cols-3 gap-3 border-t border-stone-200/80 pt-5 lg:mt-6 lg:pt-4">
          <div>
            <dt class="mini-label">Setup</dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950">Guided</dd>
          </div>
          <div>
            <dt class="mini-label">Handoff</dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950">WhatsApp</dd>
          </div>
          <div>
            <dt class="mini-label">Trial</dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950">14 days</dd>
          </div>
        </dl>
      </div>

      <!-- Live CSS/HTML Simplified Dashboard Mockup -->
      <div class="relative lg:pl-6">
        <div class="absolute -inset-8 -z-10 rounded-[2rem] bg-stone-300/10 blur-3xl"></div>

        <div class="surface rounded-3xl p-3 sm:p-4 lg:p-3">
          
          <!-- Pure CSS Dashboard Display -->
          <div class="overflow-hidden rounded-2xl bg-[#faf9f5] border border-stone-200/80 aspect-[16/10] p-4 sm:p-6 lg:p-4 flex flex-col justify-between text-stone-950 shadow-inner relative group/dash">
            <!-- Mock Header -->
            <div class="flex items-center justify-between border-b border-stone-200/60 pb-3">
              <div class="flex items-center gap-2">
                <span class="font-heading font-semibold text-[11px] tracking-wider text-stone-900">VoluChat</span>
                <span class="text-[9px] font-medium text-stone-400">/ store setup</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-stone-900 animate-pulse"></span>
                <span class="text-[8px] font-mono font-bold uppercase tracking-wider text-stone-500">SYSTEM LIVE</span>
              </div>
            </div>

            <!-- Mock Main Body -->
            <div class="grid grid-cols-[1.1fr_0.9fr] gap-4 items-center my-auto">
              <!-- Left side: Single ultra-clean ON card -->
              <div class="space-y-4">
                <div class="rounded-2xl border border-stone-200/80 bg-white p-4 shadow-sm space-y-4 max-w-[240px] hover:border-stone-300 transition-colors">
                  <div class="flex justify-between items-start gap-4">
                    <div>
                      <p class="text-[9px] font-bold uppercase tracking-wider text-stone-400">Instagram + Facebook Sync</p>
                      <h4 class="text-sm font-bold text-stone-900 mt-1">Automation Active</h4>
                    </div>
                    <!-- Luxury CSS Toggle Switch -->
                    <div class="w-9 h-5 rounded-full bg-stone-900 p-0.5 flex items-center justify-end transition-all duration-300 cursor-pointer shadow-inner">
                      <span class="w-4 h-4 rounded-full bg-white shadow-sm"></span>
                    </div>
                  </div>
                  <div class="pt-2.5 border-t border-stone-100 flex items-center justify-between text-[9px] font-semibold text-stone-500">
                    <span>Connected Pages:</span>
                    <span class="text-stone-900">@yourstore</span>
                  </div>
                </div>

                <!-- Small Stats Row -->
                <div class="flex gap-2">
                  <div class="rounded-xl border border-stone-200/50 bg-white/40 px-3 py-1.5">
                    <span class="text-xs font-bold text-stone-900">145</span>
                    <span class="text-[8px] text-stone-500 ml-1 font-semibold">items synced</span>
                  </div>
                  <div class="rounded-xl border border-stone-200/50 bg-white/40 px-3 py-1.5">
                    <span class="text-xs font-bold text-stone-900">100%</span>
                    <span class="text-[8px] text-stone-500 ml-1 font-semibold">automated</span>
                  </div>
                </div>
              </div>

              <!-- Right side: Pre-filled Handoff Ticket -->
              <div class="rounded-2xl border border-stone-300 bg-stone-950 text-white p-4 shadow-xl max-w-[190px] space-y-3 font-mono text-[8px] leading-normal">
                <div class="flex justify-between border-b border-stone-850 pb-2 text-stone-500 font-bold uppercase tracking-wider">
                  <span>Handoff Ticket</span>
                  <span class="text-stone-300">READY</span>
                </div>
                <div class="space-y-1.5">
                  <div class="flex justify-between">
                    <span class="text-stone-500">Customer:</span>
                    <span class="text-stone-200">@priya_sharma</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-stone-500">Product:</span>
                    <span class="text-stone-200">Premium Sneaker</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-stone-500">Size / Color:</span>
                    <span class="text-stone-200">UK 9 / White</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-stone-500">PIN Code:</span>
                    <span class="text-stone-200">Pune 411014</span>
                  </div>
                </div>
                <div class="pt-2 border-t border-stone-850 flex justify-between text-stone-400">
                  <span>Chat Handoff:</span>
                  <span class="text-stone-100 font-bold">WhatsApp ↗</span>
                </div>
              </div>
            </div>

            <!-- Mock Footer -->
            <div class="text-[8px] text-stone-400 font-medium flex justify-between border-t border-stone-200/60 pt-2">
              <span>VoluChat B2B Sync v1.0</span>
              <span>Zero-setup integration</span>
            </div>
          </div>

          <div class="grid gap-3 pt-4 md:grid-cols-[1fr_0.72fr] lg:gap-2.5 lg:pt-3">
            <div class="rounded-2xl border border-stone-200/70 bg-white/70 p-4 lg:p-3">
              <p class="text-sm font-semibold text-stone-950 lg:text-[13px]">Online store reply automation</p>
              <p class="mt-1 text-xs font-medium leading-relaxed text-stone-500 lg:text-[11px] lg:leading-normal">Instagram and Facebook Page questions grouped before staff handoff.</p>
            </div>
            <div class="rounded-2xl border border-stone-200/75 bg-stone-100/70 p-4 lg:p-3">
              <p class="mini-label">WhatsApp handoff</p>
              <p class="mt-2 text-sm font-semibold text-stone-950 lg:mt-1 lg:text-[13px] lg:leading-normal">Product, size, shade, and delivery details ready.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="hero-scene" class="mt-10 grid gap-5 lg:grid-cols-[1fr_0.82fr] lg:items-start">
      <div class="surface-soft rounded-2xl p-5 reveal-on-scroll">
        <div class="mb-5 flex items-center justify-between border-b border-stone-200/70 pb-4">
          <div>
            <p class="mini-label">Online store Instagram DM</p>
            <p class="mt-1 text-sm font-semibold text-stone-950">@buyer_chat</p>
          </div>
          <span class="rounded-lg bg-stone-100 px-3 py-1 text-xs font-semibold text-stone-600">Inbox</span>
        </div>

        <div class="space-y-4">
          <div class="flex gap-2">
            <img src="/buyer_avatar.webp" alt="Buyer avatar" class="h-8 w-8 shrink-0 rounded-full border border-stone-200 object-cover" />
            <div class="max-w-[78%] rounded-2xl bg-stone-100 px-3 py-2 text-xs font-medium text-stone-800">
              Hi, is the premium sneaker from today's post available in UK 9?
            </div>
          </div>

          <div class="flex justify-end gap-2">
            <div class="max-w-[78%] rounded-2xl bg-stone-900 px-3 py-2 text-xs font-semibold text-white">
              Yes, UK 9 is available in white and black. What is your PIN code?
            </div>
            <div class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-stone-200 bg-stone-100 p-1.5">
              <img src="/voluchat_logo.svg" alt="VoluChat AI" class="h-full w-full object-contain" />
            </div>
          </div>

          <div class="flex gap-2">
            <img src="/buyer_avatar.webp" alt="Buyer avatar" class="h-8 w-8 shrink-0 rounded-full border border-stone-200 object-cover" />
            <div class="max-w-[78%] rounded-2xl bg-stone-100 px-3 py-2 text-xs font-medium text-stone-800">
              Pune 411014. Can your team confirm the color before payment?
            </div>
          </div>
        </div>
      </div>

      <div class="surface rounded-2xl p-5 reveal-on-scroll reveal-delay-100 lg:translate-y-10">
        <div class="mb-5 border-b border-stone-200/70 pb-4">
            <p class="mini-label">Sales handoff panel</p>
          <p class="mt-1 text-sm font-semibold text-stone-950">Buyer summary for staff</p>
        </div>

        <div class="space-y-3">
          <div class="rounded-xl border border-stone-200/70 bg-white/78 p-3">
            <p class="mini-label">Matched catalog item</p>
            <p class="mt-1 text-sm font-semibold text-stone-950">Premium sneaker</p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl border border-stone-200/70 bg-white/78 p-3">
              <p class="mini-label">Size</p>
              <p class="mt-1 text-sm font-semibold text-stone-950">UK 9</p>
            </div>
            <div class="rounded-xl border border-stone-200/70 bg-white/78 p-3">
              <p class="mini-label">PIN code</p>
              <p class="mt-1 text-sm font-semibold text-stone-950">Pune 411014</p>
            </div>
          </div>
          <div class="rounded-xl border border-stone-200/80 bg-stone-100/75 p-3">
            <p class="mini-label">Buyer note</p>
            <p class="mt-1 text-sm font-semibold text-stone-950">Confirm white color before payment.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
