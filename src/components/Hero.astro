---
---

<section id="hero" class="relative min-h-[100svh] overflow-hidden pt-28 pb-12 md:pt-32">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-wash"></div>
    <div class="hero-grid"></div>
    <div class="hero-fade"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-4xl text-center">
      <div id="hero-badge" class="inline-flex items-center gap-2 rounded-full border border-slate-200/80 bg-white/85 px-4 py-2 text-sm font-black text-slate-950 shadow-xl shadow-blue-500/5 backdrop-blur-2xl">
        <span class="h-2 w-2 rounded-full bg-blue-600 shadow-[0_0_8px_rgba(59,130,246,0.6)]"></span>
        <span>24/7 AI DM Helpdesk</span>
      </div>

      <h1 id="hero-title" class="mx-auto mt-6 max-w-4xl text-5xl font-black leading-[0.98] tracking-tight text-slate-950 sm:text-6xl lg:text-7xl">
        AI DM helpdesk for Instagram stores
      </h1>

      <p id="hero-description" class="mx-auto mt-6 max-w-2xl text-lg font-semibold leading-relaxed text-slate-600 sm:text-xl">
        VoluChat replies instantly, handles repeat buyer questions, finds products from your catalog, and prepares clean WhatsApp chats for your staff to close.
      </p>

      <div id="hero-actions" class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/contact" class="group inline-flex w-full items-center justify-center gap-2 rounded-full bg-blue-600 px-7 py-4 text-base font-black text-white shadow-xl shadow-blue-500/25 transition hover:-translate-y-0.5 hover:bg-blue-700 sm:w-auto">
          Request Demo
          <span class="h-2 w-2 rounded-full bg-white"></span>
        </a>
        <a href="#features" class="inline-flex w-full items-center justify-center rounded-full border border-slate-200/80 bg-white/70 px-7 py-4 text-base font-black text-slate-900 shadow-sm backdrop-blur-xl transition hover:-translate-y-0.5 hover:bg-white sm:w-auto">
          See capabilities
        </a>
      </div>
    </div>

    <!-- State-of-the-Art Live AI Handoff Simulator -->
    <div id="hero-scene" class="relative mx-auto mt-16 w-full max-w-5xl overflow-visible">
      
      <!-- Ambient light behind the simulator -->
      <div class="absolute inset-0 -z-10 overflow-visible flex items-center justify-center pointer-events-none">
        <div class="absolute w-[120%] h-[300px] bg-gradient-to-r from-blue-400/15 via-indigo-500/20 to-emerald-400/15 blur-[100px] rounded-full"></div>
      </div>

      <div class="grid gap-8 lg:grid-cols-2 items-center relative">
        
        <!-- Animated Connecting Line between the two phones (desktop only) -->
        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-12 hidden lg:flex items-center justify-center z-20 pointer-events-none">
          <div class="w-full h-[3px] bg-gradient-to-r from-blue-500 via-indigo-500 to-emerald-500 rounded-full relative overflow-hidden shadow-[0_0_12px_rgba(59,130,246,0.5)]">
            <div class="absolute inset-0 bg-white w-1/3 animate-laser-flow"></div>
          </div>
        </div>

        <!-- Left Column: Instagram DM Mockup -->
        <div class="glass-panel-premium rounded-[2.5rem] p-6 shadow-2xl relative border-slate-200/50">
          <div class="absolute top-4 left-6 flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-red-400"></span>
            <span class="h-2 w-2 rounded-full bg-yellow-400"></span>
            <span class="h-2 w-2 rounded-full bg-green-400"></span>
          </div>
          <div class="text-center border-b border-slate-100 pb-3 mb-5">
            <div class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">Instagram DM Chat</div>
            <div class="text-xs font-black text-slate-900 mt-0.5">@buyer_chat</div>
          </div>

          <!-- Animated Chat Timeline -->
          <div class="space-y-4 min-h-[290px] flex flex-col justify-end">
            <!-- Bubble 1 -->
            <div class="flex gap-2 animate-bubble-1">
              <div class="h-7 w-7 rounded-full bg-gradient-to-tr from-pink-500 to-violet-600 shrink-0 flex items-center justify-center text-[9px] font-black text-white shadow-sm">IG</div>
              <div class="rounded-2xl bg-slate-100 px-3 py-2 text-xs font-medium text-slate-800 shadow-sm max-w-[80%]">
                Hi, is the White Runner sneaker in stock in size 9?
              </div>
            </div>

            <!-- Bubble 2 -->
            <div class="flex gap-2 justify-end animate-bubble-2">
              <div class="rounded-2xl bg-blue-600 px-3 py-2 text-xs font-semibold text-white shadow-md max-w-[80%]">
                Yes! White Runner is in stock in Size 9. ⚡️ Let me check shipping. What is your PIN code?
              </div>
              <div class="h-7 w-7 rounded-full bg-blue-100 border border-blue-200 shrink-0 flex items-center justify-center text-[9px] font-black text-blue-700">AI</div>
            </div>

            <!-- Bubble 3 -->
            <div class="flex gap-2 animate-bubble-3">
              <div class="h-7 w-7 rounded-full bg-gradient-to-tr from-pink-500 to-violet-600 shrink-0 flex items-center justify-center text-[9px] font-black text-white shadow-sm">IG</div>
              <div class="rounded-2xl bg-slate-100 px-3 py-2 text-xs font-medium text-slate-800 shadow-sm max-w-[80%]">
                Nice, my PIN is Pune 411014. Can I pay via GPay?
              </div>
            </div>

            <!-- Bubble 4 -->
            <div class="flex gap-2 justify-end animate-bubble-4">
              <div class="rounded-2xl bg-blue-600 px-3 py-2 text-xs font-semibold text-white shadow-md max-w-[80%]">
                Perfect! Yes, GPay is accepted. I've sent your size, PIN, and reserved order summary to WhatsApp so you can close in 1 click! 🚀
              </div>
              <div class="h-7 w-7 rounded-full bg-blue-100 border border-blue-200 shrink-0 flex items-center justify-center text-[9px] font-black text-blue-700">AI</div>
            </div>
          </div>
        </div>

        <!-- Right Column: WhatsApp Pre-filled Summary Card -->
        <div class="glass-panel-premium rounded-[2.5rem] p-6 shadow-2xl relative border-emerald-500/20">
          <div class="absolute inset-0 bg-emerald-500/[0.01] rounded-[2.5rem] pointer-events-none"></div>
          
          <div class="text-center border-b border-slate-100 pb-3 mb-5">
            <div class="text-[9px] font-black uppercase tracking-[0.2em] text-emerald-600">WhatsApp Handoff Panel</div>
            <div class="text-xs font-black text-slate-900 mt-0.5">Pre-qualified Lead Card</div>
          </div>

          <div class="space-y-3 min-h-[290px] flex flex-col justify-center">
            <!-- Product Identification -->
            <div class="bg-white border border-slate-100 rounded-xl p-3 shadow-sm flex items-center justify-between animate-ticket-1">
              <div>
                <div class="text-[8px] font-black uppercase tracking-wider text-slate-400">AI MATCHED PRODUCT</div>
                <div class="text-xs font-black text-slate-950 mt-0.5">White Runner Sneaker</div>
              </div>
              <span class="text-[10px] font-black text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full border border-blue-100">98% Match</span>
            </div>

            <!-- Collected Variants -->
            <div class="grid grid-cols-2 gap-3 animate-ticket-2">
              <div class="bg-white border border-slate-100 rounded-xl p-3 shadow-sm">
                <div class="text-[8px] font-black uppercase tracking-wider text-slate-400">UK SIZE</div>
                <div class="text-xs font-black text-slate-950 mt-0.5">Size 9</div>
              </div>
              <div class="bg-white border border-slate-100 rounded-xl p-3 shadow-sm">
                <div class="text-[8px] font-black uppercase tracking-wider text-slate-400">PIN CODE</div>
                <div class="text-xs font-black text-slate-950 mt-0.5">Pune 411014</div>
              </div>
            </div>

            <!-- Payment preference detected -->
            <div class="bg-white border border-slate-100 rounded-xl p-3 shadow-sm animate-ticket-3">
              <div class="text-[8px] font-black uppercase tracking-wider text-slate-400">PAYMENT PREFERENCE</div>
              <div class="text-xs font-semibold text-slate-800 mt-0.5">UPI / GPay Requested</div>
            </div>

            <!-- Handoff state -->
            <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-3 shadow-sm flex items-center justify-between animate-ticket-4">
              <div>
                <div class="text-[8px] font-black uppercase tracking-wider text-emerald-600">HANDOFF STATUS</div>
                <div class="text-xs font-black text-emerald-800 mt-0.5">Ready for WhatsApp Sales Closing</div>
              </div>
              <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)] animate-pulse"></span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style is:global>
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 42% at 50% 0%, rgba(59, 130, 246, 0.18), transparent 72%),
      radial-gradient(circle at 18% 40%, rgba(14, 165, 233, 0.12), transparent 28rem),
      linear-gradient(180deg, rgba(248, 251, 255, 0.66) 0%, rgba(248, 251, 255, 0.2) 70%, transparent 100%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(15, 23, 42, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, 0.05) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 78%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 78%);
  }

  .hero-fade {
    position: absolute;
    inset: auto 0 0;
    height: 180px;
    background: linear-gradient(to top, rgba(248, 251, 255, 0.88), transparent);
  }

  /* Laser Flow in the Center Handoff Tube */
  @keyframes laser-flow {
    0% { left: -100%; }
    100% { left: 100%; }
  }
  .animate-laser-flow {
    animation: laser-flow 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
  }

  /* Core Looping Simulator Timeline Animation */
  @keyframes fade-in-out-bubble-1 {
    0%, 100% { opacity: 0; transform: translateY(8px); }
    8%, 90% { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-in-out-bubble-2 {
    0%, 18% { opacity: 0; transform: translateY(8px); }
    26%, 90% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; }
  }
  @keyframes fade-in-out-bubble-3 {
    0%, 38% { opacity: 0; transform: translateY(8px); }
    46%, 90% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; }
  }
  @keyframes fade-in-out-bubble-4 {
    0%, 58% { opacity: 0; transform: translateY(8px); }
    66%, 90% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; }
  }

  .animate-bubble-1 {
    animation: fade-in-out-bubble-1 12s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  .animate-bubble-2 {
    animation: fade-in-out-bubble-2 12s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  .animate-bubble-3 {
    animation: fade-in-out-bubble-3 12s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  .animate-bubble-4 {
    animation: fade-in-out-bubble-4 12s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  /* WhatsApp Ticket elements sync */
  @keyframes fade-in-out-ticket-1 {
    0%, 20% { opacity: 0; transform: translateY(5px) scale(0.98); }
    28%, 90% { opacity: 1; transform: translateY(0) scale(1); }
    100% { opacity: 0; }
  }
  @keyframes fade-in-out-ticket-2 {
    0%, 48% { opacity: 0; transform: translateY(5px) scale(0.98); }
    56%, 90% { opacity: 1; transform: translateY(0) scale(1); }
    100% { opacity: 0; }
  }
  @keyframes fade-in-out-ticket-3 {
    0%, 58% { opacity: 0; transform: translateY(5px) scale(0.98); }
    66%, 90% { opacity: 1; transform: translateY(0) scale(1); }
    100% { opacity: 0; }
  }
  @keyframes fade-in-out-ticket-4 {
    0%, 70% { opacity: 0; transform: translateY(5px) scale(0.98); }
    78%, 90% { opacity: 1; transform: translateY(0) scale(1); }
    100% { opacity: 0; }
  }

  .animate-ticket-1 {
    animation: fade-in-out-ticket-1 12s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  .animate-ticket-2 {
    animation: fade-in-out-ticket-2 12s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  .animate-ticket-3 {
    animation: fade-in-out-ticket-3 12s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  .animate-ticket-4 {
    animation: fade-in-out-ticket-4 12s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
</style>


