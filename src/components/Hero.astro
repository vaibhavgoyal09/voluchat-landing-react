---

---

<section
  id="hero"
  class="hero-section relative isolate overflow-hidden pt-[7.5rem] pb-16 sm:pt-[8.5rem] lg:pt-[9rem] lg:pb-24"
>
  <!-- Modern layered background (pure CSS, zero JS) -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-grid"></div>
    <div class="hero-bg-mesh"></div>
    <div class="hero-bg-orb hero-bg-orb--teal"></div>
    <div class="hero-bg-orb hero-bg-orb--emerald"></div>
    <div class="hero-bg-orb hero-bg-orb--violet"></div>
    <div class="hero-bg-scan"></div>
    <div class="hero-bg-vignette"></div>
  </div>

  <div class="page-shell relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <!-- Copy Block -->
      <div class="text-center lg:text-left">
        <!-- Private Pilot Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/25 bg-[#101012] px-3.5 py-1 text-xs font-medium text-emerald-300">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Private Pilot Cohort: <strong class="font-semibold text-white">10 Fashion &amp; Boutique Brands Only</strong></span>
        </div>

        <h1
          class="hero-title mt-7 font-heading text-[2.75rem] font-bold leading-[1.02] tracking-[-0.035em] sm:text-[3.25rem] lg:text-[3.6rem] xl:text-[4rem] text-[#fcfdff]"
        >
          <span>
            Your Instagram Reels Bring the Traffic.
          </span>
          <span class="block text-emerald-400 pb-1">VoluChat Closes the Sale on WhatsApp.</span>
        </h1>

        <p
          class="hero-text mx-auto mt-6 max-w-xl text-[1.05rem] font-normal leading-relaxed text-[rgba(252,253,255,0.7)] sm:text-lg lg:mx-0"
        >
          When shoppers comment <span class="text-white font-medium">"Price?"</span> or <span class="text-white font-medium">"Size L available?"</span> at 11 PM, VoluChat auto-replies in 2 seconds, qualifies their fit on WhatsApp, and collects instant UPI payment — before they scroll to another brand.
        </p>

        <p class="mx-auto mt-4 max-w-lg text-sm font-medium leading-relaxed text-slate-400 lg:mx-0">
          <span class="text-emerald-400 font-semibold">⚡ Zero flowchart buttons.</span> No sending them to a slow website link. Just 90-second conversational checkout directly inside chat.
        </p>

        <div
          class="hero-ctas mt-9 flex flex-col items-center gap-3.5 sm:flex-row sm:justify-center lg:justify-start"
        >
          <a href="/contact" class="btn-primary">
            Apply for 1 of 10 Fashion Pilot Spots &rarr;
          </a>
          <a href="#revenue-loop" class="btn-secondary">
            See the 90-Second Sales Loop
          </a>
        </div>

        <!-- Trust Features Strip -->
        <div class="mt-9 flex flex-wrap items-center justify-center gap-y-2 gap-x-7 text-[13px] font-medium text-slate-400 lg:justify-start">
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>Zero flowcharts / rigid buttons</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>Native In-DM UPI / Draft Orders</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>100% Done-For-You Setup</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual: phone on a subtle glowing stage -->
      <div class="hero-mockup relative mx-auto w-full max-w-[260px] sm:max-w-[280px] lg:mx-0 lg:justify-self-center -mt-8 lg:-mt-12" data-tilt-strength="2">
        <!-- Stage atmospheric glow (Resend subtle radial) -->
        <div class="absolute left-1/2 top-1/2 -z-10 h-[380px] w-[380px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-emerald-500/10 blur-[80px]"></div>

        <!-- Phone Frame -->
        <div class="tilt relative rounded-[2.5rem] border border-white/[0.14] bg-[#0a0a0c] p-[4px]">
          <div class="relative overflow-hidden rounded-[2.25rem] bg-[#000000]" style="aspect-ratio: 9 / 20.5;">
            <!-- Dynamic Island / Notch -->
            <div class="absolute left-1/2 top-2 z-20 h-5 w-24 -translate-x-1/2 rounded-full bg-[#101012]"></div>
            <video
              src="/voluchat_demo_optimized.mp4"
              class="absolute inset-0 h-full w-full object-cover"
              autoplay
              loop
              muted
              playsinline>
            </video>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReduced) return;

    const heroTl = gsap.timeline({ defaults: { ease: "power3.out" } });

    heroTl
      .from(".hero-title", { opacity: 0, y: 24, duration: 0.6, immediateRender: true })
      .from(".hero-text", { opacity: 0, y: 16, duration: 0.5, immediateRender: true }, "-=0.35")
      .from(".hero-ctas", { opacity: 0, y: 14, duration: 0.4, immediateRender: true }, "-=0.3")
      .from(".hero-mockup", { opacity: 0, scale: 0.95, y: 20, duration: 0.7, ease: "power2.out", immediateRender: true }, "-=0.4");
  });
</script>
