---

---

<section
  id="hero"
  class="hero-section relative isolate overflow-hidden pt-[7.5rem] pb-16 sm:pt-[8.5rem] lg:pt-[9rem] lg:pb-24"
>
  <!-- Modern layered background (pure CSS, zero JS) -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-grid"></div>
    <div class="hero-bg-mesh"></div>
    <div class="hero-bg-vignette"></div>
  </div>

  <div class="page-shell relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <!-- Copy Block -->
      <div class="text-center lg:text-left">
        <!-- Single Clean Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-50 px-4 py-1.5 text-xs font-semibold text-emerald-800 shadow-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
          </span>
          <span>AI Sales Agent for Fashion Boutiques &bull; <strong class="font-bold text-slate-900">Auto-replies while you sleep</strong></span>
        </div>

        <h1
          class="hero-title mt-7 font-heading text-[2.75rem] font-bold leading-[1.02] tracking-[-0.035em] sm:text-[3.25rem] lg:text-[3.6rem] xl:text-[4rem] text-slate-900"
        >
          <span>
            Your boutique keeps selling&mdash;even when you&rsquo;re <em class="serif-accent">asleep</em>.
          </span>
          <span class="block pb-1 text-slate-800"><span class="serif-accent">&ldquo;Price?&rdquo;</span> answered in <span class="text-emerald-600 font-bold">seconds</span>&mdash;even at 2am.</span>
        </h1>

        <p
          class="hero-text mx-auto mt-6 max-w-xl text-lg font-normal leading-relaxed text-slate-600 sm:text-xl lg:mx-0"
        >
          Every &ldquo;Price?&rdquo; comment gets a reply in 2 seconds &mdash; sizing from your chart, address collected, 1-click UPI link sent, with polite follow-ups till they pay. You wake up to paid orders, not cold chats. Across Instagram, Facebook Pages, and WhatsApp.
        </p>

        <div
          class="hero-ctas mt-8 flex flex-col items-center gap-3.5 sm:flex-row sm:justify-center lg:justify-start"
        >
          <a href="/free-trial" class="btn-primary !px-7 !py-3.5 !text-base shadow-[0_8px_24px_rgba(5,150,105,0.25)]">
            Start My 30-Day Free Trial &rarr;
          </a>
          <a
            href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary inline-flex items-center gap-2"
          >
            Try it on WhatsApp &rarr;
          </a>
        </div>
        <p class="mt-3.5 text-xs text-slate-500 font-mono">
          White-glove setup in 48 hours. Zero technical skills needed. Works on Instagram, Facebook Messenger, and WhatsApp.
        </p>

        <!-- Trust Metrics: open Apple strip, no box -->
        <div class="mt-10 max-w-xl mx-auto lg:mx-0 border-t border-slate-200 pt-5">
          <div class="grid grid-cols-4 gap-3 text-left">
            <div>
              <div class="font-heading text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">2<span class="text-emerald-600">s</span></div>
              <p class="text-[11px] font-medium text-slate-500 mt-0.5">Comment-to-DM</p>
            </div>
            <div>
              <div class="font-heading text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">24<span class="text-emerald-600">/7</span></div>
              <p class="text-[11px] font-medium text-slate-500 mt-0.5">Follows up till paid</p>
            </div>
            <div>
              <div class="font-heading text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">4<span class="text-emerald-600"> Jobs</span></div>
              <p class="text-[11px] font-medium text-slate-500 mt-0.5">One AI Sales Agent</p>
            </div>
            <div>
              <div class="font-heading text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">48<span class="text-emerald-600">h</span></div>
              <p class="text-[11px] font-medium text-slate-500 mt-0.5">White-Glove Setup</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Hero Visual: phone on an illuminated glowing stage with high-contrast chassis -->
      <div class="hero-mockup relative mx-auto w-full max-w-[245px] sm:max-w-[260px] lg:max-w-[275px] xl:max-w-[285px] lg:mx-0 lg:justify-self-center -mt-6 lg:-mt-10">
        <!-- Stage atmospheric illumination (clean single centered radial aura) -->
        <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[380px] w-[380px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(16,185,129,0.15)_0%,rgba(20,184,166,0.05)_45%,transparent_70%)] blur-[60px]"></div>

        <!-- Floating Live Highlights (Contextual Liquid Glass Capsules) -->
        <div class="animate-float-slow absolute -top-4 -left-6 z-30 hidden sm:flex items-center gap-2 rounded-full border border-white/20 bg-slate-950/80 px-3.5 py-1.5 shadow-[0_12px_28px_rgba(0,0,0,0.8),inset_0_1px_1px_rgba(255,255,255,0.25)] backdrop-blur-xl">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-[11px] font-medium text-slate-200">
            <strong class="text-emerald-400 font-semibold">2.0s</strong> Comment-to-DM
          </span>
        </div>

        <div class="animate-float absolute -bottom-3 right-[-1rem] z-30 hidden sm:flex items-center gap-2.5 rounded-full border border-white/20 bg-slate-950/80 px-3.5 py-1.5 shadow-[0_12px_28px_rgba(0,0,0,0.8),inset_0_1px_1px_rgba(255,255,255,0.25)] backdrop-blur-xl">
          <div class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div class="text-left">
            <p class="text-[9px] uppercase font-semibold tracking-wider text-slate-400">1-Tap UPI</p>
            <p class="text-xs font-bold text-white">₹7,999 Paid</p>
          </div>
        </div>

        <!-- Interactive Tilt Phone Device -->
        <div class="tilt relative" data-tilt-strength="3">
          <!-- Metallic Hardware Buttons (Catch light against dark page) -->
          <!-- Silent Switch -->
          <div class="absolute -left-[5px] top-24 h-6 w-[3px] rounded-l-sm bg-gradient-to-r from-slate-400 to-slate-600 shadow-sm"></div>
          <!-- Volume Up -->
          <div class="absolute -left-[5px] top-36 h-10 w-[3px] rounded-l-sm bg-gradient-to-r from-slate-400 to-slate-600 shadow-sm"></div>
          <!-- Volume Down -->
          <div class="absolute -left-[5px] top-50 h-10 w-[3px] rounded-l-sm bg-gradient-to-r from-slate-400 to-slate-600 shadow-sm"></div>
          <!-- Power Button -->
          <div class="absolute -right-[5px] top-36 h-14 w-[3px] rounded-r-sm bg-gradient-to-l from-slate-400 to-slate-600 shadow-sm"></div>

          <!-- Phone Chassis: Natural Titanium Metallic Edge with Defined Specular Rim -->
          <div class="relative rounded-[2.85rem] bg-gradient-to-b from-slate-600 via-slate-700 to-slate-800 p-[3px] shadow-[0_25px_60px_-15px_rgba(0,0,0,0.95),0_0_50px_rgba(16,185,129,0.2),inset_0_1px_1px_rgba(255,255,255,0.6)]">
            
            <!-- Inner Dark Chamfer & Display Frame -->
            <div class="rounded-[2.65rem] bg-[#16171d] p-[4px] ring-1 ring-white/10">
              
              <!-- Screen Container (Exact 9:20 matching the video aspect ratio perfectly) -->
              <div class="relative overflow-hidden rounded-[2.4rem] bg-[#000000] ring-1 ring-black" style="aspect-ratio: 9 / 20;">

                <!-- Dynamic Island -->
                <div class="absolute left-1/2 top-2.5 z-30 h-[22px] w-[76px] -translate-x-1/2 rounded-full bg-black shadow-[inset_0_0_0_1px_rgba(255,255,255,0.06)]" aria-hidden="true">
                  <span class="absolute right-2.5 top-1/2 h-1.5 w-1.5 -translate-y-1/2 rounded-full bg-[#1a1d29] shadow-[inset_0_0_2px_rgba(0,0,0,0.9)]"></span>
                </div>

                <!-- Status bar: time + radios, sits over the demo video -->
                <div class="pointer-events-none absolute inset-x-0 top-0 z-30 flex items-center justify-between px-6 pt-3 text-[10px] font-semibold text-white" aria-hidden="true">
                  <span class="tracking-wide">11:14</span>
                  <span class="flex items-center gap-1">
                    <svg class="h-2.5 w-3.5" viewBox="0 0 16 12" fill="currentColor"><rect x="0" y="7" width="3" height="5" rx="0.5"/><rect x="4.5" y="5" width="3" height="7" rx="0.5"/><rect x="9" y="2.5" width="3" height="9.5" rx="0.5"/><rect x="13" y="7" width="3" height="5" rx="0.5" opacity="0.4"/></svg>
                    <svg class="h-2.5 w-3.5" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M1.5 4.5a10 10 0 0 1 13 0"/><path d="M4 7.2a6.4 6.4 0 0 1 8 0"/><circle cx="8" cy="10" r="1" fill="currentColor" stroke="none"/></svg>
                    <svg class="h-2.5 w-5" viewBox="0 0 22 12" fill="none"><rect x="0.5" y="0.5" width="17" height="11" rx="3" stroke="currentColor" opacity="0.5"/><rect x="2.5" y="2.5" width="11" height="7" rx="1.5" fill="currentColor"/><rect x="19" y="4" width="2" height="4" rx="1" fill="currentColor" opacity="0.5"/></svg>
                  </span>
                </div>
                <!-- Top scrim so the status bar reads over bright video frames -->
                <div class="pointer-events-none absolute inset-x-0 top-0 z-20 h-12 bg-gradient-to-b from-black/50 to-transparent"></div>
                
                <!-- Realistic Screen Glass Specular Sheen -->
                <div class="pointer-events-none absolute inset-0 z-20 bg-gradient-to-tr from-transparent via-white/[0.02] to-white/[0.07]"></div>

                <!-- Video Stream (Full uncropped 9:20 fit) -->
                <video
                  poster="/voluchat_demo_poster.webp"
                  class="absolute inset-0 h-full w-full object-cover"
                  autoplay
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  aria-label="VoluChat automated WhatsApp sales demo"
                >
                  <source src="/voluchat_demo_optimized.webm" type="video/webm" />
                  <source src="/voluchat_demo_optimized.mp4" type="video/mp4" />
                </video>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroMockupPop {
    from {
      opacity: 0;
      transform: translateY(22px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .hero-title {
    animation: heroFadeUp 0.7s var(--ease-out) forwards;
  }

  .hero-text {
    animation: heroFadeUp 0.7s var(--ease-out) 0.1s forwards;
    opacity: 0;
  }

  .hero-ctas {
    animation: heroFadeUp 0.7s var(--ease-out) 0.2s forwards;
    opacity: 0;
  }

  .hero-mockup {
    animation: heroMockupPop 0.85s var(--ease-out) 0.15s forwards;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-text,
    .hero-ctas,
    .hero-mockup {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
