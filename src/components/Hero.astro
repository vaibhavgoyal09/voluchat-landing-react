---

---

<section
  id="hero"
  class="hero-section relative isolate overflow-hidden pt-[7.5rem] pb-24 sm:pt-[8.5rem] lg:pt-[9.5rem] lg:pb-32"
>
  <!-- Modern layered background (pure CSS, zero JS) -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-grid"></div>
    <div class="hero-bg-mesh"></div>
    <div class="hero-bg-orb hero-bg-orb--teal"></div>
    <div class="hero-bg-orb hero-bg-orb--emerald"></div>
    <div class="hero-bg-orb hero-bg-orb--violet"></div>
    <div class="hero-bg-scan"></div>
    <div class="hero-bg-vignette"></div>
  </div>

  <!-- Localized Dynamic Core Shield Label -->
  <div
    class="absolute bottom-6 right-8 sm:right-12 pointer-events-none select-none hidden lg:flex flex-col gap-1 items-end opacity-50 z-10"
  >
    <div
      id="hero-core-status"
      class="flex items-center gap-1.5 text-[9px] font-mono tracking-widest uppercase text-teal-400 font-bold"
      data-state="idle"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-teal-400 animate-pulse"></span>
      <span id="hero-core-status-label">Active Guardrail Core</span>
    </div>
    <span id="hero-core-status-copy" class="text-[8px] font-mono text-slate-400"
      >Scanning incoming shopper queries</span
    >
  </div>

  <div class="page-shell relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16 lg:items-start">
      <!-- Copy Block -->
      <div class="text-center lg:text-left">
        <div
          class="hero-eyebrow inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.045] px-4 py-1.5 text-xs font-bold text-slate-200 backdrop-blur-md"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-teal-300 animate-pulse-ring"
          ></span>
          Margin-safe AI agents for Shopify
        </div>

        <h1
          class="hero-title mt-6 text-[2.5rem] font-bold leading-[1.02] tracking-tight sm:text-[2.75rem] lg:text-[3.15rem] xl:text-[3.8rem] font-heading"
        >
          <span
            class="bg-clip-text text-transparent bg-gradient-to-br from-white via-slate-100 to-slate-400"
            >AI agents for Shopify operations —
          </span>
          <span class="block gradient-text-anim">with human approval built in.</span>
        </h1>

        <p
          class="hero-text mt-6 max-w-xl text-[1.05rem] font-medium leading-relaxed text-slate-300 sm:text-lg lg:max-w-2xl"
        >
          VoluChat helps Shopify teams turn customer messages, order issues, and repetitive follow-ups into AI-recommended workflows your team can approve before anything happens.
        </p>

        <div
          class="hero-ctas mt-8 flex flex-col gap-3.5 sm:flex-row sm:justify-center lg:justify-start"
        >
          <a href="/contact" class="btn-primary btn-sheen">
            See VoluChat in action
          </a>
          <a href="#workflows" class="btn-secondary">
            View example workflows
          </a>
        </div>

        <div class="mt-8 text-sm text-slate-400 max-w-md text-center lg:text-left">
          Built for lean Shopify teams handling support, order follow-ups, customer updates, and operational tasks manually.
        </div>
      </div>

      <!-- Hero Visual: Ecommerce Operator View (Redesigned visual-heavy panel) -->
      <div class="hero-mockup lg:hero-stage relative tilt lg:mt-14" data-tilt-strength="2">
        <div class="absolute -inset-6 rounded-[2.5rem] bg-teal-500/15 blur-3xl opacity-50 animate-pulse"></div>

        <div class="relative rounded-[1.5rem] border border-white/10 bg-white/[0.02] p-2 shadow-[0_50px_140px_-70px_rgba(0,0,0,0.95)] backdrop-blur-xl group overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-tr from-teal-500/10 via-transparent to-violet-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
          <img
            src="/hero_image_dashboard.webp"
            alt="VoluChat Shopify AI Agent Operator Dashboard"
            class="w-full h-auto rounded-[1.1rem] border border-white/10 object-cover transform transition-transform duration-700 group-hover:scale-[1.02]"
            decoding="async"
          />
          
          <!-- Interactive overlay badge indicating live workflow -->
          <div class="absolute bottom-6 left-6 bg-slate-900/90 backdrop-blur-md border border-white/10 px-3.5 py-2 rounded-xl flex items-center gap-2 shadow-lg">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-[10px] font-mono font-bold tracking-wider text-slate-200 uppercase">Live Workspace Active</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
</style>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // We wait a tiny bit to ensure tilt scripts have initialized
    setTimeout(() => {
      const tl = gsap.timeline();

      tl.fromTo([".hero-eyebrow", ".hero-title", ".hero-text", ".hero-ctas"],
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 0.8, stagger: 0.15, ease: "power3.out" }
      );

      tl.fromTo(".hero-mockup",
        { opacity: 0, y: 40, scale: 0.95 },
        { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power4.out" },
        "-=0.6"
      );
    }, 50);
  });
</script>
