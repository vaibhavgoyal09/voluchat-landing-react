---

---

<section
  id="hero"
  class="hero-section relative isolate overflow-hidden pt-[7.5rem] pb-24 sm:pt-[8.5rem] lg:pt-[9.5rem] lg:pb-32"
>
  <!-- Modern layered background (pure CSS, zero JS) -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-grid"></div>
    <div class="hero-bg-mesh"></div>
    <div class="hero-bg-orb hero-bg-orb--teal"></div>
    <div class="hero-bg-orb hero-bg-orb--emerald"></div>
    <div class="hero-bg-orb hero-bg-orb--violet"></div>
    <div class="hero-bg-scan"></div>
    <div class="hero-bg-vignette"></div>
  </div>

  <!-- Localized Dynamic Core Shield Label -->
  <div
    class="absolute bottom-6 right-8 sm:right-12 pointer-events-none select-none hidden lg:flex flex-col gap-1 items-end opacity-50 z-10"
  >
    <div
      class="flex items-center gap-1.5 text-[9px] font-mono tracking-widest uppercase text-teal-400 font-bold"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-teal-400 animate-pulse"></span>
      Active Guardrail Core
    </div>
    <span class="text-[8px] font-mono text-slate-400"
      >Scanning incoming shopper queries</span
    >
  </div>

  <div class="page-shell relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <!-- Copy Block -->
      <div class="text-center lg:text-left">
        <div
          class="hero-eyebrow inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.045] px-4 py-1.5 text-xs font-bold text-slate-200 backdrop-blur-md"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-teal-300 animate-pulse-ring"
          ></span>
          Margin-safe AI agents for Shopify
        </div>

        <h1
          class="hero-title mt-6 text-[2.85rem] font-bold leading-[1.02] tracking-tight sm:text-[3.4rem] lg:text-[4rem] xl:text-[4.65rem] font-heading"
        >
          <span
            class="bg-clip-text text-transparent bg-gradient-to-br from-white via-slate-100 to-slate-400"
            >Scale your store's operations
          </span>
          <span class="gradient-text-anim block"
            >without expanding your team.</span
          >
        </h1>

        <p
          class="hero-text mt-6 max-w-xl text-base font-medium leading-relaxed text-slate-300 sm:text-lg lg:max-w-2xl"
        >
          Recover abandoned carts, answer buyer questions, and execute
          follow-ups instantly with AI agents built for Shopify.
        </p>

        <div
          class="hero-ctas mt-8 flex flex-col gap-3.5 sm:flex-row sm:justify-center lg:justify-start"
        >
          <a href="/contact" class="btn-primary btn-sheen hero-magnetic">
            Request an Agent Review
          </a>
          <a href="#demo-flow" class="btn-secondary">
            See the Operating Loop
          </a>
        </div>
      </div>

      <!-- Hero Visual: Interactive Agent Console -->
      <div class="hero-mockup lg:hero-stage relative">
        <div
          class="absolute -inset-6 rounded-[2.5rem] bg-teal-500/10 blur-3xl opacity-40"
          aria-hidden="true"
        >
        </div>

        <div
          class="hero-console relative rounded-[1.5rem] border border-white/10 bg-white/[0.02] p-2 shadow-[0_50px_140px_-70px_rgba(0,0,0,0.95)] backdrop-blur-xl border-glow-anim"
        >
          <div
            class="relative rounded-[1.1rem] border border-white/10 bg-[#080f1a] overflow-hidden"
          >
            <!-- Title bar -->
            <div
              class="flex items-center justify-between border-b border-white/[0.06] px-5 py-3.5 bg-white/[0.015]"
            >
              <div class="flex items-center gap-2.5">
                <span class="hero-dot bg-rose-400/70"></span>
                <span class="hero-dot bg-amber-400/70"></span>
                <span class="hero-dot bg-teal-400/70"></span>
                <span
                  class="ml-2 font-mono text-[11px] font-bold uppercase tracking-wider text-slate-400"
                  >voluchat · agent console</span
                >
              </div>
              <div class="flex items-center gap-2">
                <span
                  class="h-1.5 w-1.5 rounded-full bg-teal-400 animate-pulse"
                ></span>
                <span
                  class="font-mono text-[10px] font-bold uppercase tracking-wider text-teal-300/80"
                  >connected</span
                >
              </div>
            </div>

            <!-- Terminal body -->
            <div
              class="hero-term font-mono text-[13px] leading-relaxed p-5 h-[400px] sm:h-[440px] overflow-y-auto"
              id="hero-output"
            >
              <div class="hero-line hero-line--title">
                VoluChat Agent Console
              </div>
              <div class="hero-line hero-line--body">
                Shopify agents for recovery, product answers, follow-up, and
                campaigns.
              </div>
              <div class="hero-line hero-line--body">
                Every action stays inside your margin and approval rules.
              </div>
              <div class="hero-line hero-line--blank"></div>
            </div>

            <!-- Input line -->
            <div
              class="flex items-center gap-3 border-t border-white/[0.06] px-5 py-4 bg-white/[0.015]"
            >
              <span
                class="font-mono text-sm font-bold text-teal-300 select-none"
                >›</span
              >
              <input
                type="text"
                id="hero-input"
                class="hero-input flex-1 bg-transparent font-mono text-[13px] text-slate-100 placeholder:text-slate-600 outline-none"
                placeholder="try 'recover', 'rules', or 'leaks'"
                autocomplete="off"
                spellcheck="false"
                aria-label="Agent console command input"
              />
              <button
                id="hero-send"
                class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-500 hover:text-teal-300 transition-colors duration-300"
              >
                ↵ send
              </button>
            </div>
          </div>
        </div>

        <!-- Floating suggestion chips -->
        <div
          class="absolute -bottom-3 left-6 sm:left-10 flex items-center gap-2 rounded-full border border-white/10 bg-[#0b1521] px-4 py-2 shadow-xl"
        >
          <span
            class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-400"
            >try</span
          >
          <button
            class="hero-suggest font-mono text-[11px] font-bold text-teal-300 hover:text-teal-200 transition-colors cursor-pointer"
            data-cmd="agents"
          >
            agents
          </button>
          <span class="text-slate-600">·</span>
          <button
            class="hero-suggest font-mono text-[11px] font-bold text-teal-300 hover:text-teal-200 transition-colors cursor-pointer"
            data-cmd="recover"
          >
            recover
          </button>
          <span class="text-slate-600">·</span>
          <button
            class="hero-suggest font-mono text-[11px] font-bold text-teal-300 hover:text-teal-200 transition-colors cursor-pointer"
            data-cmd="rules"
          >
            rules
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 9999px;
    display: inline-block;
  }
  .hero-term {
    scrollbar-width: thin;
    scrollbar-color: rgba(45, 212, 191, 0.2) transparent;
  }
  .hero-term::-webkit-scrollbar {
    width: 6px;
  }
  .hero-term::-webkit-scrollbar-track {
    background: transparent;
  }
  .hero-term::-webkit-scrollbar-thumb {
    background: rgba(45, 212, 191, 0.18);
    border-radius: 9999px;
  }
  .hero-line {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .hero-line--prompt {
    color: #e2e8f0;
  }
  .hero-line--prompt .hero-cmd {
    color: #5eeac9;
    font-weight: 700;
  }
  .hero-line--title {
    color: #5eeac9;
    font-weight: 700;
    margin-top: 0.4rem;
  }
  .hero-line--body {
    color: #94a3b8;
  }
  .hero-line--accent {
    color: #34d399;
    font-weight: 700;
  }
  .hero-line--blank {
    height: 0.5rem;
  }
  .hero-input:focus {
    caret-color: #5eeac9;
  }
</style>

<script>
  // Lightweight, dependency-free hero interactions.
  // Content is visible by default (no JS-gated LCP). Progressive enhancements
  // only — staggered entrance, magnetic CTA, and the interactive agent console.
  (() => {
    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const isCoarse = window.matchMedia("(pointer: coarse)").matches;
    const scheduleIdle = (fn: () => void, timeout = 2200) => {
      if ("requestIdleCallback" in window) {
        (window as any).requestIdleCallback(fn, { timeout });
      } else {
        setTimeout(fn, Math.min(timeout, 600));
      }
    };

    /* 1. Staggered entrance (CSS-driven; JS only adds the trigger class) */
    const initEntrance = () => {
      const targets = [
        ".hero-eyebrow",
        ".hero-title",
        ".hero-text",
        ".hero-ctas",
        ".hero-mockup",
      ];
      if (prefersReduced) {
        targets.forEach((s) =>
          document.querySelector(s)?.classList.add("hero-in"),
        );
      } else {
        targets.forEach((s, i) => {
          const el = document.querySelector<HTMLElement>(s);
          if (el) {
            el.style.setProperty("--hero-delay", `${i * 90}ms`);
            requestAnimationFrame(() =>
              requestAnimationFrame(() => el.classList.add("hero-in")),
            );
          }
        });
      }
    };

    /* 2. Magnetic CTA (pointer devices only) */
    const initMagnetic = () => {
      const btn = document.querySelector<HTMLElement>(".hero-magnetic");
      if (!btn || isCoarse || prefersReduced) return;
      let rafId = 0;
      let tx = 0,
        ty = 0,
        cx = 0,
        cy = 0;
      btn.addEventListener("pointermove", (e) => {
        const r = btn.getBoundingClientRect();
        tx = (e.clientX - r.left - r.width / 2) * 0.35;
        ty = (e.clientY - r.top - r.height / 2) * 0.35;
      });
      btn.addEventListener("pointerleave", () => {
        tx = 0;
        ty = 0;
      });
      const loop = () => {
        cx += (tx - cx) * 0.18;
        cy += (ty - cy) * 0.18;
        btn.style.transform = `translate(${cx.toFixed(2)}px, ${cy.toFixed(2)}px)`;
        rafId = requestAnimationFrame(loop);
      };
      btn.addEventListener("pointerenter", () => {
        if (!rafId) rafId = requestAnimationFrame(loop);
      });
      btn.addEventListener("pointerleave", () => {
        const stop = () => {
          if (Math.abs(tx - cx) < 0.5 && Math.abs(ty - cy) < 0.5) {
            cancelAnimationFrame(rafId);
            rafId = 0;
            btn.style.transform = "";
            return;
          }
          rafId = requestAnimationFrame(stop);
        };
        cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(stop);
      });
    };

    /* 3. Interactive Agent Console — real capabilities, no fake metrics */
    const COMMANDS: Record<string, string[]> = {
      help: [
        "# Available commands",
        "  agents        List available agent modules",
        "  recover       Cart recovery agent",
        "  answer        Product assistant agent",
        "  leaks         Revenue leak detection",
        "  campaign      Approval-gated campaigns",
        "  rules         How guardrails work",
        "  about         What VoluChat is",
        "  clear         Clear the console",
      ],
      agents: [
        "# Available agent modules",
        "",
        "  Cart Recovery",
        ">  /agents/cart-recovery",
        "  Product Assistant",
        ">  /agents/product-assistant",
        "  Upsell & Bundles",
        ">  /agents/upsell",
        "  Inventory Clearance",
        ">  /agents/inventory-clearance",
        "  Customer Follow-Up",
        ">  /agents/customer-follow-up",
        "  Revenue Leak Detection",
        ">  /agents/revenue-leak-detection",
        "",
        "  Type a command like 'recover' for details.",
      ],
      recover: [
        "# Cart Recovery Agent",
        "  Detects checkout drop-off, identifies the likely",
        "  objection, and uses approved recovery offers only",
        "  when margin rules allow it.",
        ">  /agents/cart-recovery",
      ],
      answer: [
        "# Product Assistant Agent",
        "  Handles sizing, stock, delivery, returns, and",
        "  product-fit questions from live catalog data before",
        "  the buyer leaves the product page.",
        ">  /agents/product-assistant",
      ],
      upsell: [
        "# Upsell & Bundles Agent",
        "  Suggests add-ons and upgrades when intent is clear,",
        "  then backs off cleanly when the buyer wants to",
        "  checkout.",
        ">  /agents/upsell",
      ],
      stock: [
        "# Inventory Clearance Agent",
        "  Turns aging inventory into targeted offers for",
        "  shoppers already browsing related products — no",
        "  store-wide discounting.",
        ">  /agents/inventory-clearance",
      ],
      "follow-up": [
        "# Customer Follow-Up Agent",
        "  Checks satisfaction, routes issues to support, asks",
        "  for reviews, and prompts repeat purchases when",
        "  timing is right.",
        ">  /agents/customer-follow-up",
      ],
      leaks: [
        "# Revenue Leak Detection",
        "  Ranks operational gaps across unanswered demand,",
        "  abandoned carts, slow inventory, and product-page",
        "  hesitation — so you fix the biggest leak first.",
        ">  /agents/revenue-leak-detection",
      ],
      campaign: [
        "# Approval-Gated Campaigns",
        "  Generates marketing campaigns for existing customers",
        "  from shopper signals and catalog data — then waits",
        "  for your approval before anything is sent.",
      ],
      rules: [
        "# Guardrails & Control",
        "  Every agent acts only inside your rules. Discounts,",
        "  campaigns, and escalations can require human review",
        "  before an agent moves. You approve, it executes.",
      ],
      about: [
        "# VoluChat",
        "  Margin-safe AI agents for Shopify. Reviews your store,",
        "  finds the revenue leaks worth fixing first, and deploys",
        "  agents that act only inside your rules.",
      ],
    };

    const initConsole = () => {
      const out = document.getElementById("hero-output");
      const input = document.getElementById(
        "hero-input",
      ) as HTMLInputElement | null;
      if (!out || !input) return;

      const history: string[] = [];
      let hi = -1;

      const addLine = (text: string, cls: string) => {
        const d = document.createElement("div");
        d.className = `hero-line ${cls}`;
        d.textContent = text;
        out.appendChild(d);
      };
      const addPrompt = (cmd: string) => {
        const d = document.createElement("div");
        d.className = "hero-line hero-line--prompt";
        d.innerHTML = `› <span class="hero-cmd">${cmd}</span>`;
        out.appendChild(d);
      };
      const scroll = () => {
        out.scrollTop = out.scrollHeight;
      };
      const print = (lines: string[]) => {
        lines.forEach((l) => {
          if (l === "") {
            addLine("", "hero-line--blank");
            return;
          }
          if (l.startsWith("#")) {
            addLine(l.slice(2), "hero-line--title");
            return;
          }
          if (l.startsWith(">")) {
            addLine(l.slice(2), "hero-line--accent");
            return;
          }
          addLine(l, "hero-line--body");
        });
        scroll();
      };
      const run = (raw: string) => {
        const cmd = raw.trim().toLowerCase();
        if (!cmd) return;
        addPrompt(cmd);
        history.push(cmd);
        hi = history.length;
        if (cmd === "clear") {
          out.innerHTML = "";
          return;
        }
        const lines = COMMANDS[cmd];
        print(
          lines || [
            `# command not found: ${cmd}`,
            "  type 'help' for available commands.",
          ],
        );
      };

      // Auto-type intro (delayed until entrance animation completes)
      const startConsole = () => {
        if (!prefersReduced) {
          const intro = "help";
          let i = 0;
          const t = setInterval(() => {
            input.value = intro.slice(0, ++i);
            if (i >= intro.length) {
              clearInterval(t);
              setTimeout(() => {
                run(intro);
                input.value = "";
              }, 400);
            }
          }, 80);
        } else {
          run("help");
        }
      };

      if (prefersReduced) {
        startConsole();
      } else {
        setTimeout(startConsole, 900);
      }

      // Keyboard: Enter to submit, ↑/↓ for history
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          run(input.value);
          input.value = "";
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          if (hi > 0) input.value = history[--hi];
        } else if (e.key === "ArrowDown") {
          e.preventDefault();
          if (hi < history.length - 1) input.value = history[++hi];
          else {
            hi = history.length;
            input.value = "";
          }
        }
      });

      // Send button
      document
        .getElementById("hero-send")
        ?.addEventListener("click", () => {
          run(input.value);
          input.value = "";
          input.focus();
        });

      // Suggestion chips
      document.querySelectorAll<HTMLElement>(".hero-suggest").forEach((b) => {
        b.addEventListener("click", () => {
          const c = b.getAttribute("data-cmd") || "";
          run(c);
          input.focus();
        });
      });
    };

    /* INIT */
    const init = () => {
      initEntrance();
      scheduleIdle(() => {
        initMagnetic();
        initConsole();
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>
