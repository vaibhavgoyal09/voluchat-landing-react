---
---

<section id="hero" class="relative min-h-[100svh] overflow-hidden pt-28 pb-12 md:pt-32">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-wash"></div>
    <div class="hero-grid"></div>
    <div class="hero-fade"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div id="hero-badge" class="glass inline-flex items-center gap-2 rounded-full px-4 py-2 opacity-0 translate-y-4">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#0668E1] text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </span>
        <span class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-700">Official Meta Tech Partner</span>
      </div>

      <h1 id="hero-title" class="mt-6 text-4xl font-black leading-[1.02] tracking-tight text-slate-950 opacity-0 translate-y-8 sm:text-6xl lg:text-7xl">
        AI chatbot for
        <span class="text-gradient-primary">comments & DMs.</span>
      </h1>

      <p id="hero-description" class="mx-auto mt-6 max-w-3xl text-lg font-medium leading-relaxed text-slate-600 opacity-0 translate-y-8 sm:text-xl">
        VoluChat helps ecommerce stores auto-reply to Instagram and Facebook comments, answer customer DMs, recommend products, and send ready buyers to WhatsApp or checkout.
      </p>

      <div id="hero-actions" class="mt-8 flex flex-col items-center justify-center gap-4 opacity-0 translate-y-8 sm:flex-row">
        <a href="https://dashboard.voluchat.com" class="group inline-flex w-full items-center justify-center rounded-full bg-slate-950 px-7 py-4 text-base font-bold text-white shadow-xl shadow-slate-900/15 transition hover:-translate-y-0.5 hover:bg-slate-800 sm:w-auto">
          Start free
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-2 transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="#demo" class="glass inline-flex w-full items-center justify-center rounded-full px-7 py-4 text-base font-bold text-slate-800 transition hover:-translate-y-0.5 hover:text-indigo-700 sm:w-auto">
          See how it works
        </a>
      </div>

      <div id="hero-trust" class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 opacity-0 translate-y-8">
        <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.16em] text-slate-500">
          Made for Indian online sellers
        </span>
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Official Meta APIs</span>
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">No password sharing</span>
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">No credit card</span>
      </div>
    </div>

    <div id="hero-product" class="relative mx-auto mt-12 max-w-6xl opacity-0 translate-y-10">
      <div class="absolute inset-x-10 -top-6 h-24 rounded-full bg-indigo-500/10 blur-3xl"></div>
      <div class="glass-panel relative overflow-hidden rounded-[1.75rem]">
        <div class="flex items-center justify-between border-b border-slate-100 bg-slate-950 px-4 py-3">
          <div class="flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-rose-400"></span>
            <span class="h-3 w-3 rounded-full bg-amber-400"></span>
            <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
          </div>
          <div class="hidden rounded-full bg-white/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.18em] text-white/70 sm:block">VoluChat AI Chatbot</div>
        </div>

        <div class="grid min-h-[430px] grid-cols-1 lg:grid-cols-[0.9fr_1.1fr]">
          <div class="border-b border-white/60 bg-white/35 p-5 backdrop-blur-xl lg:border-b-0 lg:border-r">
            <div class="mb-4 flex items-center justify-between">
              <div>
                <div class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Comment to DM</div>
                <div class="mt-1 text-lg font-black text-slate-950">Buyer asks on a post</div>
              </div>
              <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">Auto-reply on</span>
            </div>

            <div class="space-y-4">
              <div class="max-w-[82%] rounded-2xl rounded-tl-sm bg-slate-100 px-4 py-3 text-sm font-medium text-slate-700">
                Comment: Price for blue cotton kurti in size M?
              </div>
              <div class="ml-auto max-w-[88%] rounded-2xl rounded-tr-sm bg-slate-950 px-4 py-3 text-sm font-medium text-white">
                Auto DM sent: Teal Office Kurti is Rs 1,299 and available in M. Should I send photos?
              </div>
              <div class="max-w-[80%] rounded-2xl rounded-tl-sm bg-slate-100 px-4 py-3 text-sm font-medium text-slate-700">
                Send the teal one. Is it good for summer?
              </div>
              <div class="ml-auto max-w-[88%] rounded-2xl rounded-tr-sm bg-indigo-600 px-4 py-3 text-sm font-medium text-white">
                Yes, it is 100% cotton and good for summer. I can add size M to cart now.
              </div>
            </div>
          </div>

          <div class="bg-white/25 p-5 backdrop-blur-xl">
            <div class="grid gap-4 sm:grid-cols-3">
              <div class="glass-card rounded-2xl p-4">
                <div class="text-xs font-bold uppercase tracking-widest text-slate-400">Auto answered</div>
                <div class="mt-3 text-3xl font-black text-slate-950">80%</div>
              </div>
              <div class="glass-card rounded-2xl p-4">
                <div class="text-xs font-bold uppercase tracking-widest text-slate-400">Reply time</div>
                <div class="mt-3 text-3xl font-black text-slate-950">&lt;1s</div>
              </div>
              <div class="glass-card rounded-2xl p-4">
                <div class="text-xs font-bold uppercase tracking-widest text-slate-400">Product search</div>
                <div class="mt-3 text-3xl font-black text-slate-950">24/7</div>
              </div>
            </div>

            <div class="glass-card mt-4 rounded-2xl p-4">
              <div class="mb-4 flex items-center justify-between">
                <div>
                  <div class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Products found</div>
                  <div class="mt-1 font-black text-slate-950">Search products from customer messages</div>
                </div>
                <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">3 found</span>
              </div>
              <div class="grid gap-3 sm:grid-cols-3">
                {[
                  ["Teal Office Kurti", "Rs 1,299", "In stock"],
                  ["Blue Cotton Set", "Rs 1,449", "Size M"],
                  ["Mint Workwear Top", "Rs 999", "Low stock"],
                ].map((item) => (
                  <div class="rounded-xl border border-white/60 bg-white/48 p-3 backdrop-blur-xl">
                    <div class="mb-3 aspect-[4/3] rounded-lg bg-gradient-to-br from-cyan-100 via-emerald-100 to-indigo-100"></div>
                    <div class="text-sm font-bold text-slate-900">{item[0]}</div>
                    <div class="mt-1 flex items-center justify-between text-xs">
                      <span class="font-bold text-slate-600">{item[1]}</span>
                      <span class="text-emerald-600">{item[2]}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="mt-4 grid gap-4 md:grid-cols-2">
              <div class="glass-card rounded-2xl p-4">
                <div class="text-xs font-bold uppercase tracking-widest text-slate-400">Product writing</div>
                <p class="mt-2 text-sm font-medium leading-relaxed text-slate-600">Create product titles and descriptions faster with AI.</p>
              </div>
              <div class="glass-card rounded-2xl p-4">
                <div class="text-xs font-bold uppercase tracking-widest text-slate-400">WhatsApp follow-up</div>
                <p class="mt-2 text-sm font-medium leading-relaxed text-slate-600">Send serious buyers to WhatsApp when they are ready to order.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 42% at 50% 0%, rgba(79, 70, 229, 0.2), transparent 72%),
      radial-gradient(circle at 18% 40%, rgba(14, 165, 233, 0.12), transparent 28rem),
      linear-gradient(180deg, rgba(248,251,255,0.66) 0%, rgba(248,251,255,0.2) 70%, transparent 100%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(15, 23, 42, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, 0.05) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 78%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 78%);
  }

  .hero-fade {
    position: absolute;
    inset: auto 0 0;
    height: 180px;
    background: linear-gradient(to top, rgba(248,251,255,0.88), transparent);
  }
</style>

<script>
  import { gsap } from 'gsap';

  window.addEventListener('load', () => {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out', duration: 0.9 } });

    tl.to('#hero-badge', { opacity: 1, y: 0, delay: 0.1 })
      .to('#hero-title', { opacity: 1, y: 0 }, '-=0.55')
      .to('#hero-description', { opacity: 1, y: 0 }, '-=0.65')
      .to('#hero-actions', { opacity: 1, y: 0 }, '-=0.7')
      .to('#hero-trust', { opacity: 1, y: 0 }, '-=0.65')
      .to('#hero-product', { opacity: 1, y: 0 }, '-=0.55');
  });
</script>
