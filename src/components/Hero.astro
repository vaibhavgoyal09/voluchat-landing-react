---
---

<section id="hero" class="relative min-h-[100svh] overflow-hidden pt-28 pb-12 md:pt-32">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-wash"></div>
    <div class="hero-grid"></div>
    <div class="hero-fade"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div id="hero-badge" class="inline-flex items-center gap-3 rounded-full border border-blue-500/20 bg-white/80 px-3 py-2.5 shadow-2xl shadow-blue-500/10 ring-1 ring-white/80 backdrop-blur-2xl opacity-0 translate-y-4">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-[#0668E1] to-[#38bdf8] text-white shadow-lg shadow-blue-500/25">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </span>
        <span class="flex flex-col items-start leading-none">
          <span class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-950">Official Meta Tech Partner</span>
          <span class="mt-1 text-[10px] font-bold uppercase tracking-[0.18em] text-blue-700">Instagram + WhatsApp setup</span>
        </span>
      </div>

      <div id="hero-intro" class="mt-8 text-lg font-black text-indigo-600 uppercase tracking-[0.2em] opacity-0 translate-y-4">
        Built for Instagram shoe stores in India
      </div>

      <h1 id="hero-title" class="mt-4 text-4xl font-black leading-[1.1] tracking-tight text-slate-950 opacity-0 translate-y-8 sm:text-5xl lg:text-7xl">
        Turn <span class="text-gradient-primary">"price?" comments</span><br />
        into <span class="text-gradient-primary">WhatsApp orders</span>
      </h1>

      <p id="hero-description" class="mx-auto mt-8 max-w-3xl text-lg font-medium leading-relaxed text-slate-600 opacity-0 translate-y-8 sm:text-xl">
        VoluChat replies to Instagram comments, talks to buyers in DM, answers common shoe questions like size, color, price, and delivery, then sends ready buyers to your WhatsApp with order details.
      </p>

      <div id="hero-actions" class="mt-8 flex flex-col items-center justify-center gap-4 opacity-0 translate-y-8 sm:flex-row">
        <a href="/contact" class="group inline-flex w-full items-center justify-center rounded-full bg-gradient-to-r from-indigo-600 via-violet-600 to-blue-600 px-7 py-4 text-base font-bold text-white shadow-xl shadow-indigo-500/25 transition hover:-translate-y-0.5 hover:shadow-violet-500/30 sm:w-auto">
          Request Demo
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-2 transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="#demo" class="glass inline-flex w-full items-center justify-center rounded-full px-7 py-4 text-base font-bold text-slate-800 transition hover:-translate-y-0.5 hover:text-indigo-700 sm:w-auto">
          See how it works
        </a>
      </div>

      <div id="hero-trust" class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 opacity-0 translate-y-8">
        <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.16em] text-slate-500">
          Built for Indian shoe stores selling through Instagram Reels and WhatsApp.
        </span>
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Official Meta APIs</span>
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">No Instagram password sharing</span>
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Now onboarding a small batch of founding stores with hands-on setup.</span>
      </div>
    </div>

    <!-- Premium Buyer Flow -->
    <div id="hero-scene" class="relative mx-auto mt-20 max-w-6xl opacity-0 translate-y-10">
      <div class="relative overflow-hidden rounded-[2.5rem] border border-white/70 bg-white/45 p-4 shadow-[0_40px_110px_-40px_rgba(15,23,42,0.35)] ring-1 ring-white/80 backdrop-blur-3xl md:p-6 lg:p-8">
        <div class="absolute inset-0 hero-dot-grid opacity-20"></div>
        <div class="relative grid gap-5 lg:grid-cols-[0.85fr_1.2fr_0.85fr] lg:items-center">
          <div class="grid gap-5">
            <div class="glass-card-premium rounded-3xl p-5">
              <div class="mb-4 flex items-center justify-between gap-3">
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Reel comment captured</span>
                <span class="rounded-full bg-pink-50 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-pink-700">Instagram</span>
              </div>
              <div class="rounded-2xl border border-white/70 bg-white/65 p-4">
                <div class="text-xs font-black uppercase tracking-widest text-slate-400">Customer commented</div>
                <div class="mt-2 text-lg font-black text-slate-950">"price?" on Reel · LINK</div>
              </div>
            </div>

            <div class="glass-card-premium rounded-3xl p-5">
              <div class="mb-4 flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-600 via-violet-600 to-blue-600 text-white shadow-xl shadow-indigo-500/20">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg>
                </div>
                <div>
                  <div class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Shoe details collected</div>
                  <div class="mt-1 text-sm font-black text-slate-900">Ready before WhatsApp</div>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-2 text-sm font-bold">
                <div class="rounded-2xl bg-white/65 p-3 text-slate-600"><span class="block text-[10px] uppercase tracking-widest text-slate-400">Size</span>8</div>
                <div class="rounded-2xl bg-white/65 p-3 text-slate-600"><span class="block text-[10px] uppercase tracking-widest text-slate-400">Color</span>Black</div>
                <div class="rounded-2xl bg-white/65 p-3 text-slate-600"><span class="block text-[10px] uppercase tracking-widest text-slate-400">Budget</span>Rs 2,000</div>
                <div class="rounded-2xl bg-white/65 p-3 text-slate-600"><span class="block text-[10px] uppercase tracking-widest text-slate-400">Need</span>Photos</div>
              </div>
            </div>
          </div>

          <div class="glass-panel-premium rounded-[2rem] p-5 shadow-[0_28px_80px_-30px_rgba(15,23,42,0.35)] ring-1 ring-white/50 md:p-7 lg:animate-float-slow">
            <div class="mb-7 flex items-center justify-between border-b border-white/30 pb-4">
              <div class="flex items-center gap-2">
                <span class="h-3 w-3 rounded-full bg-slate-300"></span>
                <span class="h-3 w-3 rounded-full bg-slate-300"></span>
                <span class="h-3 w-3 rounded-full bg-slate-300"></span>
              </div>
              <div class="flex items-center gap-2 rounded-full border border-indigo-500/20 bg-indigo-500/10 px-3 py-1">
                <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
                <span class="text-[10px] font-black uppercase tracking-widest text-indigo-600">VoluChat sent DM</span>
              </div>
            </div>

            <div class="space-y-5">
              <div class="flex items-start gap-3">
                <div class="h-10 w-10 flex-shrink-0 rounded-2xl border border-white bg-gradient-to-br from-slate-100 to-slate-200"></div>
                <div class="rounded-2xl rounded-tl-none border border-white/60 bg-white/50 px-5 py-4 text-sm font-semibold leading-relaxed text-slate-700">
                  <span class="mb-1 block text-[10px] font-black uppercase tracking-widest text-slate-400">Buyer replied</span>
                  Size 8, black, under Rs 2,000
                </div>
              </div>
              <div class="flex flex-row-reverse items-start gap-3">
                <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-200">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m21 21-4.3-4.3"/><circle cx="11" cy="11" r="8"/></svg>
                </div>
                <div class="rounded-2xl rounded-tr-none bg-indigo-600 px-6 py-4 text-sm font-bold leading-relaxed text-white shadow-xl shadow-indigo-100">
                  <span class="mb-1 block text-[10px] font-black uppercase tracking-widest text-indigo-100">VoluChat found options</span>
                  I found 2 black sneakers in size 8. I can send the details to WhatsApp now.
                </div>
              </div>
              <div class="rounded-2xl border border-emerald-100 bg-emerald-50/80 p-4">
                <div class="text-[10px] font-black uppercase tracking-[0.2em] text-emerald-700">WhatsApp ready</div>
                <div class="mt-2 text-sm font-black leading-relaxed text-slate-900">Size 8 black sneaker, buyer wants photos, delivery, and final price.</div>
              </div>
            </div>
          </div>

          <div class="grid gap-5">
            <div class="glass-card-premium rounded-3xl p-5">
              <div class="mb-5 flex items-center justify-between gap-3">
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">DM assistant active</span>
                <span class="flex h-8 w-14 items-center justify-end rounded-full bg-indigo-600 p-1 shadow-inner">
                  <span class="h-6 w-6 rounded-full bg-white shadow-sm"></span>
                </span>
              </div>
              <div class="grid grid-cols-2 gap-2">
                {["Size", "Color", "Price", "Delivery"].map((item) => (
                  <div class="rounded-2xl border border-indigo-100 bg-indigo-50/70 px-3 py-2 text-center text-xs font-black uppercase tracking-widest text-indigo-700">{item}</div>
                ))}
              </div>
            </div>

            <div class="glass-card-premium rounded-3xl p-5">
              <div class="mb-4 flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-500 text-white shadow-xl shadow-emerald-200">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.77.63 2.6a2 2 0 0 1-.45 2.11L8.1 9.91a16 16 0 0 0 6 6l1.48-1.19a2 2 0 0 1 2.11-.45c.83.3 1.7.51 2.6.63A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <div class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">WhatsApp handoff ready</div>
                  <div class="mt-1 text-sm font-black text-slate-900">Open WhatsApp with details</div>
                </div>
              </div>
              <div class="rounded-2xl border border-emerald-100 bg-emerald-50/70 p-4 text-sm font-bold leading-relaxed text-slate-700">
                Buyer wants black sneaker, size 8. Send photos, delivery time, and final price.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>


  </div>
</section>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 42% at 50% 0%, rgba(79, 70, 229, 0.2), transparent 72%),
      radial-gradient(circle at 18% 40%, rgba(14, 165, 233, 0.12), transparent 28rem),
      linear-gradient(180deg, rgba(248,251,255,0.66) 0%, rgba(248,251,255,0.2) 70%, transparent 100%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(15, 23, 42, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, 0.05) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 78%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 78%);
  }

  .hero-fade {
    position: absolute;
    inset: auto 0 0;
    height: 180px;
    background: linear-gradient(to top, rgba(248,251,255,0.88), transparent);
  }

  .hero-dot-grid {
    background-image: radial-gradient(circle, #cbd5e1 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 60% 60% at 50% 50%, black 20%, transparent 100%);
    opacity: 0.4;
  }

  .floating-card {
    transition: transform 0.3s ease;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  @keyframes float-slow {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-20px) scale(1.02); }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-float-slow {
    animation: float-slow 8s ease-in-out infinite;
  }
</style>

<script>
  import { gsap } from 'gsap';

  window.addEventListener('load', () => {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out', duration: 1 } });

    tl.to('#hero-badge', { opacity: 1, y: 0, delay: 0.2 })
      .to('#hero-intro', { opacity: 1, y: 0 }, '-=0.7')
      .to('#hero-title', { opacity: 1, y: 0 }, '-=0.8')
      .to('#hero-description', { opacity: 1, y: 0 }, '-=0.8')
      .to('#hero-actions', { opacity: 1, y: 0 }, '-=0.8')
      .to('#hero-trust', { opacity: 1, y: 0 }, '-=0.8')
      .to('#hero-scene', { opacity: 1, y: 0 }, '-=0.6');
  });
</script>
