---

---

<section
  id="hero"
  class="hero-section relative isolate overflow-hidden pt-[7.5rem] pb-16 sm:pt-[8.5rem] lg:pt-[9rem] lg:pb-24"
>
  <!-- Modern layered background (pure CSS, zero JS) -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-grid"></div>
    <div class="hero-bg-mesh"></div>
    <div class="hero-bg-orb hero-bg-orb--teal"></div>
    <div class="hero-bg-orb hero-bg-orb--emerald"></div>
    <div class="hero-bg-orb hero-bg-orb--violet"></div>
    <div class="hero-bg-scan"></div>
    <div class="hero-bg-vignette"></div>
  </div>

  <div class="page-shell relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <!-- Copy Block -->
      <div class="text-center lg:text-left">
        <!-- Private Pilot Badge -->
        <div class="inline-flex items-center gap-2.5 rounded-full border border-emerald-500/25 bg-emerald-950/40 px-4 py-1.5 text-xs font-semibold text-emerald-300 backdrop-blur-md shadow-[0_0_20px_-5px_rgba(16,185,129,0.3)]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Private Founder Cohort: <strong>Limited to 10 Stores</strong></span>
        </div>

        <h1
          class="hero-title mt-7 font-heading text-[2.75rem] font-bold leading-[1.02] tracking-[-0.035em] sm:text-[3.25rem] lg:text-[3.6rem] xl:text-[4rem]"
        >
          <span class="bg-clip-text text-transparent bg-gradient-to-b from-white via-white to-slate-400">
            Turn Instagram DMs &amp; WhatsApp Chats into
          </span>
          <span class="block gradient-text-anim pb-2">24/7 Automated Revenue.</span>
        </h1>

        <p
          class="hero-text mx-auto mt-6 max-w-xl text-[1.05rem] font-normal leading-relaxed text-slate-400 sm:text-lg lg:mx-0"
        >
          Stop losing 50%+ of your DM buyers when your sales team is offline. VoluChat's Autonomous AI Agent answers sizing doubts, checks live stock, and completes native WhatsApp orders 24/7.
        </p>

        <p class="mx-auto mt-4 max-w-lg text-sm font-medium leading-relaxed text-slate-500 lg:mx-0">
          <strong class="text-slate-400">What is VoluChat?</strong> A WhatsApp sales automation tool that uses AI to close Shopify orders in 90 seconds — from Instagram comment capture to in-chat UPI checkout — without human intervention.
        </p>

        <div
          class="hero-ctas mt-9 flex flex-col items-center gap-3.5 sm:flex-row sm:justify-center lg:justify-start"
        >
          <a href="/contact" class="btn-primary btn-sheen">
            Apply for 1 of 10 Pilot Spots &rarr;
          </a>
          <a href="#how-it-works" class="btn-secondary">
            See the 4-Step Revenue Flow
          </a>
        </div>

        <!-- Trust Features Strip -->
        <div class="mt-9 flex flex-wrap items-center justify-center gap-y-2 gap-x-7 text-[13px] font-medium text-slate-500 lg:justify-start">
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>Zero flowcharts / rigid buttons</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>Native In-DM UPI / Draft Orders</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>100% Done-For-You Setup</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual: phone on a glowing stage -->
      <div class="hero-mockup relative mx-auto w-full max-w-[260px] sm:max-w-[280px] lg:mx-0 lg:justify-self-center" data-tilt-strength="2">
        <!-- Stage glow -->
        <div class="absolute left-1/2 top-1/2 -z-10 h-[420px] w-[420px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-emerald-500/15 blur-[100px]"></div>

        <!-- Phone Frame -->
        <div class="tilt relative rounded-[2.75rem] border border-white/10 bg-slate-950 p-[5px] shadow-[0_60px_140px_-40px_rgba(16,185,129,0.35)]">
          <div class="relative overflow-hidden rounded-[2.4rem] bg-slate-950">
            <!-- Dynamic Island / Notch -->
            <div class="absolute left-1/2 top-2 z-20 h-5 w-24 -translate-x-1/2 rounded-full bg-slate-900"></div>
            <video
              src="/voluchat_demo_optimized.mp4"
              class="block h-auto w-full object-cover"
              autoplay
              loop
              muted
              playsinline>
            </video>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Text & CTAs pop in fast and crisp
    const heroTl = gsap.timeline({ defaults: { ease: "power3.out" } });

    heroTl
      .fromTo(".hero-title", { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.6 })
      .fromTo(".hero-text", { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.5 }, "-=0.35")
      .fromTo(".hero-ctas", { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.4 }, "-=0.3")
      .fromTo(".hero-mockup", { opacity: 0, scale: 0.95, y: 20 }, { opacity: 1, scale: 1, y: 0, duration: 0.7, ease: "power2.out" }, "-=0.4");
  });
</script>
