---

---

<section
  id="hero"
  class="hero-section relative isolate overflow-hidden pt-[7.5rem] pb-24 sm:pt-[8.5rem] lg:pt-[9.5rem] lg:pb-32"
>
  <!-- Modern layered background (pure CSS, zero JS) -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-grid"></div>
    <div class="hero-bg-depth">
      <span class="hero-bg-depth-plane hero-bg-depth-plane--near"></span>
      <span class="hero-bg-depth-plane hero-bg-depth-plane--mid"></span>
      <span class="hero-bg-depth-plane hero-bg-depth-plane--far"></span>
    </div>
    <div class="hero-bg-mesh"></div>
    <div class="hero-bg-orb hero-bg-orb--teal"></div>
    <div class="hero-bg-orb hero-bg-orb--emerald"></div>
    <div class="hero-bg-orb hero-bg-orb--violet"></div>
    <div class="hero-bg-scan"></div>
    <div class="hero-bg-vignette"></div>
  </div>

  <!-- Localized Dynamic Core Shield Label -->
  <div
    class="absolute bottom-6 right-8 sm:right-12 pointer-events-none select-none hidden lg:flex flex-col gap-1 items-end opacity-50 z-10"
  >
    <div
      id="hero-core-status"
      class="flex items-center gap-1.5 text-[9px] font-mono tracking-widest uppercase text-teal-400 font-bold"
      data-state="idle"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-teal-400 animate-pulse"></span>
      <span id="hero-core-status-label">Active Guardrail Core</span>
    </div>
    <span id="hero-core-status-copy" class="text-[8px] font-mono text-slate-400"
      >Scanning incoming shopper queries</span
    >
  </div>

  <div class="page-shell relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16 lg:items-start">
      <!-- Copy Block -->
      <div class="text-center lg:text-left">
        <div
          class="hero-eyebrow inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.045] px-4 py-1.5 text-xs font-bold text-slate-200 backdrop-blur-md"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-teal-300 animate-pulse-ring"
          ></span>
          Margin-safe AI agents for Shopify
        </div>

        <h1
          class="hero-title mt-6 text-[2.5rem] font-bold leading-[1.02] tracking-tight sm:text-[2.75rem] lg:text-[3.15rem] xl:text-[3.8rem] font-heading"
        >
          <span
            class="bg-clip-text text-transparent bg-gradient-to-br from-white via-slate-100 to-slate-400"
            >AI agents for Shopify operations —
          </span>
          <span class="block text-teal-100">with human approval built in.</span>
        </h1>

        <p
          class="hero-text mt-6 max-w-xl text-[1.05rem] font-medium leading-relaxed text-slate-300 sm:text-lg lg:max-w-2xl"
        >
          VoluChat helps Shopify teams turn customer messages, order issues, and repetitive follow-ups into AI-recommended workflows your team can approve before anything happens.
        </p>

        <div
          class="hero-ctas mt-8 flex flex-col gap-3.5 sm:flex-row sm:justify-center lg:justify-start"
        >
          <a href="/contact" class="btn-primary btn-sheen">
            See VoluChat in action
          </a>
          <a href="#workflows" class="btn-secondary">
            View example workflows
          </a>
        </div>

        <div class="mt-8 text-sm text-slate-400 max-w-md text-center lg:text-left">
          Built for lean Shopify teams handling support, order follow-ups, customer updates, and operational tasks manually.
        </div>
      </div>

      <!-- Hero Visual: Ecommerce Operator View -->
      <div class="hero-mockup lg:hero-stage relative tilt lg:mt-14" data-tilt-strength="2">
        <div class="absolute -inset-6 rounded-[2.5rem] bg-teal-500/10 blur-3xl opacity-40"></div>

        <div class="relative rounded-[1.5rem] border border-white/10 bg-white/[0.02] p-2 shadow-[0_50px_140px_-70px_rgba(0,0,0,0.95)] backdrop-blur-xl">
          <div class="relative rounded-[1.1rem] border border-white/10 bg-[#0b1625] overflow-hidden flex flex-col h-auto sm:h-[440px]">
            
            <!-- Top nav bar -->
            <div class="flex items-center justify-between border-b border-white/[0.06] px-5 py-3.5 bg-black/20">
              <div class="flex items-center gap-3">
                <div class="h-2 w-2 rounded-full bg-teal-400 animate-pulse"></div>
                <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-300">VoluChat Inbox</span>
              </div>
              <div class="flex items-center gap-2 text-[10px] font-bold text-slate-500">
                 Cart recovery • Approval required
              </div>
            </div>

            <!-- Main body split -->
            <div class="flex flex-1 overflow-hidden flex-col sm:flex-row bg-[#0b1625]">
              
              <!-- Left Column: Request & Context -->
              <div class="w-full sm:w-[48%] border-b sm:border-b-0 sm:border-r border-white/5 flex flex-col p-4 sm:p-5 overflow-y-auto">
                
                <!-- Step 1: Customer Request -->
                <div class="mb-5 relative">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="flex h-4 w-4 items-center justify-center rounded-full bg-slate-800 text-[9px] font-bold text-slate-300">1</span>
                    <span class="text-[10px] uppercase tracking-wider font-bold text-slate-400">Incoming Request</span>
                  </div>
                  <div class="flex items-start gap-2.5">
                    <div class="h-7 w-7 rounded-full bg-indigo-500/20 text-indigo-300 flex items-center justify-center font-bold text-[10px] shrink-0">RJ</div>
                    <div>
                      <div class="text-[11px] font-bold text-slate-200">Rahul Jenkins</div>
                      <div class="text-[9px] text-slate-500 mb-1.5">Cart inactive for 42 min</div>
                      <div class="text-[11px] text-slate-300 bg-white/5 border border-white/10 p-2.5 rounded-lg rounded-tl-none leading-relaxed">
                        "I like these, but the total is a little higher than I expected."
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- Step 2: Shopify Context -->
                <div class="mt-auto relative pt-4 border-t border-white/5">
                  <div class="flex items-center gap-2 mb-2.5">
                    <span class="flex h-4 w-4 items-center justify-center rounded-full bg-slate-800 text-[9px] font-bold text-slate-300">2</span>
                    <span class="text-[10px] uppercase tracking-wider font-bold text-slate-400">Shopify Context</span>
                  </div>
                  <div class="bg-black/20 rounded-lg p-2.5 border border-white/5 flex gap-3 items-center">
                    <img src="/aero_runners_thumbnail.jpg" alt="Aero Runners" class="h-10 w-10 shrink-0 rounded object-cover border border-white/10" />
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center justify-between mb-0.5">
                        <div class="text-[11px] font-bold text-slate-200 truncate">Aero Runners (Sz 8)</div>
                        <div class="text-[9px] font-bold text-emerald-400 bg-emerald-400/10 px-1.5 py-0.5 rounded">Delivered</div>
                      </div>
                      <div class="text-[10px] text-slate-400 flex items-center gap-1 mb-1.5">
                        ₹9,999 <span class="text-white/20">•</span> 3 units left
                      </div>
                      <div class="flex flex-wrap gap-1">
                        <span class="text-[8px] font-bold text-teal-300 bg-teal-400/10 px-1.5 py-0.5 rounded border border-teal-400/20">Margin OK</span>
                        <span class="text-[8px] font-bold text-indigo-300 bg-indigo-400/10 px-1.5 py-0.5 rounded border border-indigo-400/20">Discount capped</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Right Column: AI & Action -->
              <div class="w-full sm:w-[52%] bg-[#08111d] p-4 sm:p-5 flex flex-col relative overflow-hidden">
                <div class="absolute -right-16 -top-16 h-36 w-36 rounded-full bg-teal-500/10 blur-3xl opacity-60"></div>
                
                <!-- Step 3: AI Recommendation -->
                <div class="flex-1 relative z-10 flex flex-col">
                  <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2">
                      <span class="flex h-4 w-4 items-center justify-center rounded-full bg-teal-500/20 text-[9px] font-bold text-teal-400">3</span>
                      <span class="text-[10px] font-bold uppercase tracking-wider text-teal-400">AI Recommendation</span>
                    </div>
                    <div class="text-[8px] font-bold text-emerald-400 bg-emerald-400/10 border border-emerald-400/20 px-1.5 py-0.5 rounded flex items-center gap-1">
                      <span class="h-1 w-1 rounded-full bg-emerald-400 animate-pulse"></span>
                      Response Ready
                    </div>
                  </div>
                  
                  <div class="bg-teal-500/5 border border-teal-500/20 rounded-xl p-3 mb-auto">
                    <div class="text-[11px] font-bold text-white mb-2 flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                      Send a 10% recovery offer
                    </div>
                    
                    <div class="text-[9px] uppercase font-bold text-slate-500 mb-1">Reasoning</div>
                    <div class="text-[10px] text-slate-300 leading-relaxed mb-3 pl-2 border-l-2 border-slate-700">
                      Cart value is above the recovery threshold. Inventory is available. A 10% offer stays within the approved margin floor.
                    </div>
                    
                    <div class="bg-black/40 border border-white/5 p-2.5 rounded-lg group">
                       <div class="flex justify-between items-center mb-1.5">
                         <div class="text-[8px] text-slate-500 uppercase font-bold">Draft Reply</div>
                         <div class="text-[8px] text-slate-500 hover:text-slate-300 cursor-pointer transition">Edit</div>
                       </div>
                       <div class="text-[10px] text-slate-300 italic leading-relaxed">
                         "Hi Rahul, your Aero Runners are still available. I can apply 10% off if you complete the order today."
                       </div>
                    </div>
                  </div>
                </div>
                
                <!-- Step 4: Approval -->
                <div class="mt-4 relative z-10 pt-3 border-t border-white/10">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="flex h-4 w-4 items-center justify-center rounded-full bg-slate-800 text-[9px] font-bold text-slate-300">4</span>
                    <span class="text-[9px] text-slate-400 font-medium">Discounted recovery message needs approval.</span>
                  </div>
                  <div class="flex gap-2">
                    <button type="button" class="w-[30%] bg-white/5 hover:bg-white/10 text-slate-300 text-[11px] font-bold py-2.5 rounded-lg border border-white/10 transition">Reject</button>
                    <button type="button" class="w-[70%] bg-teal-500 hover:bg-teal-400 text-[#042f2e] text-[11px] font-bold py-2.5 rounded-lg transition shadow-[0_0_15px_rgba(20,184,166,0.2)]">Approve Offer</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg-depth {
    position: absolute;
    inset: -14% -8% -22%;
    overflow: hidden;
    perspective: 900px;
    transform-style: preserve-3d;
    opacity: 0.42;
    -webkit-mask-image: radial-gradient(
      ellipse at 62% 44%,
      #000 0%,
      rgba(0, 0, 0, 0.86) 34%,
      transparent 76%
    );
    mask-image: radial-gradient(
      ellipse at 62% 44%,
      #000 0%,
      rgba(0, 0, 0, 0.86) 34%,
      transparent 76%
    );
  }
  .hero-bg-depth-plane {
    position: absolute;
    left: 50%;
    top: 50%;
    display: block;
    width: min(82rem, 128vw);
    height: min(44rem, 72vw);
    border: 1px solid rgba(94, 234, 201, 0.1);
    background-image:
      linear-gradient(rgba(94, 234, 201, 0.11) 1px, transparent 1px),
      linear-gradient(90deg, rgba(94, 234, 201, 0.09) 1px, transparent 1px),
      radial-gradient(circle at 50% 50%, rgba(20, 184, 166, 0.12), transparent 58%);
    background-size:
      82px 82px,
      82px 82px,
      100% 100%;
    border-radius: 9999px;
    transform-origin: center;
    will-change: transform, opacity;
    animation: heroDepthDrift 18s ease-in-out infinite alternate;
  }
  .hero-bg-depth-plane--near {
    transform: translate3d(-38%, -36%, 100px) rotateX(64deg) rotateZ(-13deg);
    opacity: 0.72;
  }
  .hero-bg-depth-plane--mid {
    width: min(74rem, 116vw);
    height: min(38rem, 64vw);
    background-size:
      68px 68px,
      68px 68px,
      100% 100%;
    transform: translate3d(-54%, -48%, -20px) rotateX(67deg) rotateZ(11deg);
    opacity: 0.42;
    animation-duration: 22s;
    animation-delay: -6s;
  }
  .hero-bg-depth-plane--far {
    width: min(66rem, 108vw);
    height: min(32rem, 58vw);
    background-size:
      54px 54px,
      54px 54px,
      100% 100%;
    transform: translate3d(-30%, -58%, -120px) rotateX(70deg) rotateZ(-24deg);
    opacity: 0.24;
    animation-duration: 28s;
    animation-delay: -12s;
  }
  @keyframes heroDepthDrift {
    from {
      translate: 0 0;
      scale: 1;
    }
    to {
      translate: 1.8rem -1rem;
      scale: 1.035;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-depth-plane {
      animation: none;
      will-change: auto;
    }
  }
