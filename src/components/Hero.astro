---

---

<section
  id="hero"
  class="hero-section relative isolate overflow-hidden pt-[7.5rem] pb-24 sm:pt-[8.5rem] lg:pt-[9.5rem] lg:pb-32"
>
  <!-- Modern layered background (pure CSS, zero JS) -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-grid"></div>
    <div class="hero-bg-mesh"></div>
    <div class="hero-bg-orb hero-bg-orb--teal"></div>
    <div class="hero-bg-orb hero-bg-orb--emerald"></div>
    <div class="hero-bg-orb hero-bg-orb--violet"></div>
    <div class="hero-bg-scan"></div>
    <div class="hero-bg-vignette"></div>
  </div>

  <!-- Localized Dynamic Core Shield Label -->
  <div
    class="absolute bottom-6 right-8 sm:right-12 pointer-events-none select-none hidden lg:flex flex-col gap-1 items-end opacity-50 z-10"
  >
    <div
      class="flex items-center gap-1.5 text-[9px] font-mono tracking-widest uppercase text-teal-400 font-bold"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-teal-400 animate-pulse"></span>
      Active Guardrail Core
    </div>
    <span class="text-[8px] font-mono text-slate-400"
      >Scanning incoming shopper queries</span
    >
  </div>

  <div class="page-shell relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <!-- Copy Block -->
      <div class="text-center lg:text-left">
        <div
          class="hero-eyebrow inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.045] px-4 py-1.5 text-xs font-bold text-slate-200 backdrop-blur-md"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-teal-300 animate-pulse-ring"
          ></span>
          Margin-safe AI agents for Shopify
        </div>

        <h1
          class="hero-title mt-6 text-[2.85rem] font-bold leading-[1.02] tracking-tight sm:text-[3.4rem] lg:text-[4rem] xl:text-[4.65rem] font-heading"
        >
          <span
            class="bg-clip-text text-transparent bg-gradient-to-br from-white via-slate-100 to-slate-400"
            >Scale your store's operations
          </span>
          <span class="block text-teal-100">without expanding your team.</span>
        </h1>

        <p
          class="hero-text mt-6 max-w-xl text-base font-medium leading-relaxed text-slate-300 sm:text-lg lg:max-w-2xl"
        >
          Recover abandoned carts, answer buyer questions, and execute
          follow-ups instantly with AI agents built for Shopify.
        </p>

        <div
          class="hero-ctas mt-8 flex flex-col gap-3.5 sm:flex-row sm:justify-center lg:justify-start"
        >
          <a href="/contact" class="btn-primary btn-sheen">
            Request an Agent Review
          </a>
          <a href="#demo-flow" class="btn-secondary">
            See the Operating Loop
          </a>
        </div>
      </div>

      <!-- Hero Visual: Interactive Agent Console -->
      <div class="hero-mockup lg:hero-stage relative">
        <div
          class="absolute -inset-6 rounded-[2.5rem] bg-teal-500/10 blur-3xl opacity-40"
          aria-hidden="true"
        >
        </div>

        <div
          class="hero-console relative rounded-[1.5rem] border border-white/10 bg-white/[0.02] p-2 shadow-[0_50px_140px_-70px_rgba(0,0,0,0.95)] backdrop-blur-xl border-glow-anim"
        >
          <div
            class="relative rounded-[1.1rem] border border-white/10 bg-[#080f1a] overflow-hidden"
          >
            <!-- Title bar -->
            <div
              class="flex items-center justify-between border-b border-white/[0.06] px-5 py-3.5 bg-white/[0.015]"
            >
              <div class="flex items-center gap-2.5">
                <span class="hero-dot bg-rose-400/70"></span>
                <span class="hero-dot bg-amber-400/70"></span>
                <span class="hero-dot bg-teal-400/70"></span>
                <span
                  class="ml-2 font-mono text-[11px] font-bold uppercase tracking-wider text-slate-400"
                  >voluchat · agent console</span
                >
              </div>
              <div class="flex items-center gap-2">
                <span
                  class="h-1.5 w-1.5 rounded-full bg-teal-400 animate-pulse"
                ></span>
                <span
                  class="font-mono text-[10px] font-bold uppercase tracking-wider text-teal-300/80"
                  >connected</span
                >
              </div>
            </div>

            <!-- Terminal body -->
            <div
              class="hero-term font-mono text-[13px] leading-relaxed p-5 h-[400px] sm:h-[440px] overflow-y-auto"
              id="hero-output"
            >
              <div class="hero-line hero-line--title">
                VoluChat Agent Console
              </div>
              <div class="hero-line hero-line--body">
                Shopify agents for recovery, product answers, follow-up, and
                campaigns.
              </div>
              <div class="hero-line hero-line--body">
                Every action stays inside your margin and approval rules.
              </div>
              <div class="hero-line hero-line--blank"></div>
            </div>

            <!-- Static prompt line -->
            <div
              class="flex items-center gap-3 border-t border-white/[0.06] px-5 py-4 bg-white/[0.015]"
            >
              <span
                class="font-mono text-sm font-bold text-teal-300 select-none"
                >›</span
              >
              <span class="flex-1 font-mono text-[13px] text-slate-500"
                >review-first commerce agents</span
              >
              <a
                href="/features"
                class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-500 hover:text-teal-300 transition-colors duration-300"
              >
                explore
              </a>
            </div>
          </div>
        </div>

        <!-- Floating suggestion chips -->
        <div
          class="absolute -bottom-3 left-6 sm:left-10 flex items-center gap-2 rounded-full border border-white/10 bg-[#0b1521] px-4 py-2 shadow-xl"
        >
          <span
            class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-400"
            >try</span
          >
          <a
            href="/features"
            class="font-mono text-[11px] font-bold text-teal-300 hover:text-teal-200 transition-colors"
          >
            agents
          </a>
          <span class="text-slate-600">·</span>
          <a
            href="/agents/cart-recovery"
            class="font-mono text-[11px] font-bold text-teal-300 hover:text-teal-200 transition-colors"
          >
            recover
          </a>
          <span class="text-slate-600">·</span>
          <a
            href="/security"
            class="font-mono text-[11px] font-bold text-teal-300 hover:text-teal-200 transition-colors"
          >
            rules
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 9999px;
    display: inline-block;
  }
  .hero-term {
    scrollbar-width: thin;
    scrollbar-color: rgba(45, 212, 191, 0.2) transparent;
  }
  .hero-term::-webkit-scrollbar {
    width: 6px;
  }
  .hero-term::-webkit-scrollbar-track {
    background: transparent;
  }
  .hero-term::-webkit-scrollbar-thumb {
    background: rgba(45, 212, 191, 0.18);
    border-radius: 9999px;
  }
  .hero-line {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .hero-line--prompt {
    color: #e2e8f0;
  }
  .hero-line--prompt .hero-cmd {
    color: #5eeac9;
    font-weight: 700;
  }
  .hero-line--title {
    color: #5eeac9;
    font-weight: 700;
    margin-top: 0.4rem;
  }
  .hero-line--body {
    color: #94a3b8;
  }
  .hero-line--accent {
    color: #34d399;
    font-weight: 700;
  }
  .hero-line--blank {
    height: 0.5rem;
  }
  .hero-title {
    font-family:
      ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }
</style>
