---
import HeroAutomationScene from './HeroAutomationScene.astro';
---

<section id="hero" class="relative isolate overflow-hidden pt-[5.5rem] pb-8 sm:pt-[6.5rem] lg:min-h-[calc(100dvh-4rem)] lg:pt-24 lg:pb-8">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_12%_18%,rgba(83,111,159,0.11),transparent_28%),radial-gradient(circle_at_82%_10%,rgba(203,217,234,0.16),transparent_26%),linear-gradient(180deg,rgba(255,255,255,0.92),rgba(247,249,252,0.86)_58%,rgba(255,255,255,0.96))]"></div>
  <div class="ambient-noise"></div>

  <div class="page-shell relative z-10 w-full">
    <div class="grid items-center gap-6 lg:grid-cols-[1.06fr_0.94fr] xl:gap-10">
      <div class="mx-auto max-w-2xl text-center lg:mx-0 lg:text-left">
        <div id="hero-badge" class="chip mx-auto lg:mx-0">
          For Instagram-led stores closing on WhatsApp
        </div>

        <h1 id="hero-title" class="mx-auto mt-3 max-w-[13ch] text-[2.65rem] font-semibold leading-[1.14] text-stone-950 sm:mt-4 sm:max-w-[13ch] sm:text-[2.9rem] sm:leading-[1.14] lg:mx-0 lg:mt-3 lg:max-w-[15ch] lg:text-[3.15rem] lg:leading-[1.1] xl:text-[3.55rem]">
          <span class="sr-only">Stop losing Instagram buyers to slow replies</span>
          <span aria-hidden="true" class="block">Stop losing</span>
          <span aria-hidden="true" class="accent-gradient-text block py-1">Instagram buyers</span>
          <span aria-hidden="true" class="block">to slow replies.</span>
        </h1>

        <p id="hero-description" class="mx-auto mt-4 max-w-lg text-base font-medium leading-relaxed text-stone-600 sm:text-lg lg:mx-0">
          VoluChat answers repeated product questions, recommends catalog items, collects delivery details, and prepares a WhatsApp order message your team can review and close.
        </p>

        <p class="mx-auto mt-3 hidden max-w-lg text-sm font-semibold leading-relaxed text-stone-500 xl:block lg:mx-0">
          Your team keeps control of confirmation, payment, and exceptions without answering the same size, stock, COD, and delivery questions all day.
        </p>

        <div id="hero-actions" class="mt-5 flex flex-col gap-3 sm:mt-6 sm:flex-row sm:justify-center lg:justify-start">
          <a href="https://dashboard.voluchat.com/register" class="btn-primary">
            Start Free Setup
          </a>
          <a href="https://ig.me/m/airwalks.shoes" target="_blank" rel="noopener" class="btn-secondary">
            Watch Live Demo
          </a>
        </div>

      </div>

      <HeroAutomationScene />
    </div>
  </div>
</section>
