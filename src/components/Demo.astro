---
const demoSteps = [
  {
    label: "Product match",
    title: "The right products show up",
    text: "A casual sneaker question is matched to catalog options the shopper can tap.",
  },
  {
    label: "Variant capture",
    title: "Size and color are saved",
    text: "The shopper picks what they want without being sent to a form.",
  },
  {
    label: "Address check",
    title: "Delivery details are checked",
    text: "Address and phone number are collected before your store steps in.",
  },
  {
    label: "WhatsApp text",
    title: "WhatsApp is ready",
    text: "The final message is organized so your store can confirm quickly.",
  },
];
---

<section id="demo" class="dark-technical-bg relative overflow-hidden py-16 sm:py-24 lg:py-28">
  <div class="page-shell relative z-10">
    <div class="grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-center">
      <div class="mx-auto w-full max-w-[17rem] reveal-on-scroll lg:max-w-[19rem]">
        <div class="relative">
          <div class="relative rounded-[2.15rem] border border-white/16 bg-white/10 p-3 shadow-[0_42px_120px_rgba(0,0,0,0.34)] backdrop-blur-xl">
            <div class="rounded-[1.75rem] bg-stone-950 p-2 shadow-inner">
              <div class="relative overflow-hidden rounded-[1.45rem] bg-stone-950">
                <img
                  src="/demo-screenshot-04.webp"
                  alt="WhatsApp message showing the selected product, total, shipping address, and phone number from the social checkout flow"
                  class="aspect-[9/20] w-full bg-stone-950 object-cover"
                  loading="lazy"
                  decoding="async"
                  width="540"
                  height="1200"
                />

                <div class="pointer-events-none absolute inset-x-0 top-0 flex justify-center pt-2">
                  <div class="h-4 w-20 rounded-full bg-stone-950/85"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="reveal-on-scroll reveal-delay-100">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-primary-100/70">Demo breakdown</p>
        <h2 class="mt-4 max-w-3xl text-[2.15rem] font-semibold leading-[1.06] text-white sm:text-5xl lg:text-[3.45rem]">
          From DM to WhatsApp order message.
        </h2>
        <p class="mt-5 max-w-2xl text-base font-medium leading-relaxed text-primary-50/76 sm:text-lg">
          VoluChat keeps the buyer moving from product discovery to a complete WhatsApp message your store can review and close, without forcing them into a separate form.
        </p>

        <div class="mt-10 divide-y divide-white/12 border-y border-white/12">
          {demoSteps.map((step, index) => (
            <article class="grid gap-4 py-5 transition duration-300 hover:bg-white/[0.04] sm:grid-cols-[4rem_1fr]">
              <span class="font-mono text-sm font-semibold text-primary-200">0{index + 1}</span>
              <div>
                <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-primary-100/58">{step.label}</p>
                <h3 class="mt-2 text-xl font-semibold leading-tight text-white">{step.title}</h3>
                <p class="mt-2 max-w-xl text-sm font-medium leading-relaxed text-primary-50/68">{step.text}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="https://dashboard.voluchat.com/register" class="btn-primary bg-white text-stone-950 hover:bg-primary-50">
            Start Free Setup
          </a>
          <a href="https://ig.me/m/airwalks.shoes" target="_blank" rel="noopener" class="btn-secondary border-white/18 bg-white/8 text-white hover:bg-white/14">
            Try the Live DM
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
