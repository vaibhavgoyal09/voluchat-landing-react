---
const demoSteps = [
  {
    label: "Product match",
    title: "Request becomes options",
    text: "A casual sneaker ask is matched to catalog items the buyer can tap.",
  },
  {
    label: "Variant capture",
    title: "Choices are narrowed",
    text: "Size and color are collected without sending the buyer to a form.",
  },
  {
    label: "Address check",
    title: "Delivery details are confirmed",
    text: "The shipping address and phone number are verified before escalation.",
  },
  {
    label: "WhatsApp text",
    title: "The order is structured",
    text: "The final message is ready for a rep to review and close.",
  },
];
---

<section id="demo" class="section-pad relative overflow-hidden">
  <div class="ambient-noise"></div>

  <div class="page-shell relative z-10">
    <div class="solid-card overflow-hidden p-0">
      <div class="grid gap-8 p-5 sm:p-7 lg:grid-cols-[0.82fr_1.18fr] lg:items-center lg:p-9">
        <div class="mx-auto w-full max-w-[17rem] lg:max-w-[18rem] reveal-on-scroll">
          <div class="relative rounded-[2rem] border border-stone-200 bg-white p-3 shadow-[0_28px_90px_rgba(28,25,23,0.13)]">
            <div class="rounded-[1.65rem] bg-stone-950 p-2 shadow-inner">
              <div class="relative overflow-hidden rounded-[1.35rem] bg-stone-950">
                <img
                  src="/demo-screenshot-04.webp"
                  alt="WhatsApp message showing the selected product, total, shipping address, and phone number from the Instagram checkout flow"
                  class="aspect-[9/20] w-full bg-stone-950 object-cover"
                  loading="lazy"
                  decoding="async"
                  width="540"
                  height="1200"
                />

                <div class="pointer-events-none absolute inset-x-0 top-0 flex justify-center pt-2">
                  <div class="h-4 w-20 rounded-full bg-stone-950/85"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="reveal-on-scroll reveal-delay-100">
          <p class="section-eyebrow">Demo breakdown</p>
          <h2 class="section-title mt-4">
            One Instagram chat, ready for WhatsApp close.
          </h2>
          <p class="section-copy mt-5 max-w-2xl">
            VoluChat qualifies the buyer, captures the order details, and gives your team a clean message to close from.
          </p>

          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {demoSteps.map((step, index) => (
              <article class="rounded-xl border border-stone-200 bg-stone-50/80 p-4">
                <div class="flex items-start gap-3">
                  <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-primary-800 font-mono text-[11px] font-semibold text-white">
                    0{index + 1}
                  </span>
                  <div>
                    <p class="mini-label">{step.label}</p>
                    <h3 class="mt-2 text-base font-semibold leading-snug text-stone-950">{step.title}</h3>
                    <p class="mt-2 text-sm font-medium leading-relaxed text-stone-600">{step.text}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
