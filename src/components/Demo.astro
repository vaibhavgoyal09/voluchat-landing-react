---
---

<section id="demo" class="relative overflow-hidden py-24 md:py-32">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-10"></div>
    <div class="absolute -right-44 top-1/4 h-[36rem] w-[36rem] rounded-full bg-blue-300/10 blur-3xl"></div>
    <div class="absolute -left-44 bottom-12 h-[36rem] w-[36rem] rounded-full bg-emerald-300/10 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-3xl text-center mb-20">
      <!-- Standardized Glowing Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50/70 px-4 py-1.5 text-xs font-black text-blue-700 shadow-sm backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-blue-600 shadow-[0_0_8px_rgba(59,130,246,0.6)]"></span>
        <span>The flow</span>
      </div>
      <!-- Consistent Responsive Heading -->
      <h2 class="text-3xl font-heading font-black leading-[1.1] tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
        From messy Instagram chat to one-click sales.
      </h2>
      <p class="mx-auto mt-6 text-lg font-semibold leading-relaxed text-slate-600 sm:text-xl">
        VoluChat qualifies interested buyers in your DMs first, then delivers a pre-filled customer card straight to WhatsApp for final confirmation.
      </p>
    </div>

    <!-- Simulator Workspace -->
    <div class="grid gap-12 lg:grid-cols-2 max-w-5xl mx-auto items-center">
      
      <!-- Left: Instagram DM Experience -->
      <div class="glass-panel-premium rounded-[2.5rem] p-8 shadow-2xl relative">
        <div class="absolute top-4 left-6 flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
        </div>
        <div class="text-center border-b border-slate-100 pb-4 mb-6">
          <div class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Instagram DM Automation</div>
          <div class="text-xs font-black text-slate-900 mt-1">@buyer_chat</div>
        </div>

        <div class="space-y-4 min-h-[300px] flex flex-col justify-end">
          <!-- Chat bubbles -->
          <div class="flex gap-2">
            <img src="/buyer_avatar.png" alt="Buyer Avatar" class="h-8 w-8 rounded-full object-cover shrink-0 shadow-sm border border-slate-100" />
            <div class="rounded-2xl bg-slate-100 p-3 text-xs font-medium text-slate-800 shadow-sm max-w-[80%]">
              Hey! I saw your reel. How much is the White Runner and do you deliver to Bangalore?
            </div>
          </div>

          <div class="flex gap-2 justify-end">
            <div class="rounded-2xl bg-blue-600 p-3 text-xs font-semibold text-white shadow-md max-w-[80%]">
              Hey there! The White Runner is ₹2,999. Yes, we deliver to Bangalore with free express shipping! 🚚 What size do you need?
            </div>
            <div class="h-8 w-8 rounded-full bg-blue-50 border border-blue-100 shrink-0 flex items-center justify-center p-1.5 shadow-sm">
              <img src="/voluchat_logo.svg" alt="VoluChat AI" class="w-full h-full object-contain" />
            </div>
          </div>

          <div class="flex gap-2">
            <img src="/buyer_avatar.png" alt="Buyer Avatar" class="h-8 w-8 rounded-full object-cover shrink-0 shadow-sm border border-slate-100" />
            <div class="rounded-2xl bg-slate-100 p-3 text-xs font-medium text-slate-800 shadow-sm max-w-[80%]">
              Perfect, size 9 please. Address is Indiranagar, Bangalore 560038.
            </div>
          </div>

          <div class="flex gap-2 justify-end">
            <div class="rounded-2xl bg-blue-600 p-3 text-xs font-semibold text-white shadow-md max-w-[80%]">
              Great! White Runner in Size 9 is reserved for you. I am preparing your WhatsApp handoff link so you can complete payment. One moment! ⚡️
            </div>
            <div class="h-8 w-8 rounded-full bg-blue-50 border border-blue-100 shrink-0 flex items-center justify-center p-1.5 shadow-sm">
              <img src="/voluchat_logo.svg" alt="VoluChat AI" class="w-full h-full object-contain" />
            </div>
          </div>
        </div>
      </div>

      <!-- Right: WhatsApp Structured Handoff -->
      <div class="glass-panel-premium rounded-[2.5rem] p-8 shadow-2xl relative border-emerald-500/30">
        <div class="absolute inset-0 bg-emerald-500/[0.02] rounded-[2.5rem] pointer-events-none"></div>
        
        <div class="text-center border-b border-slate-100 pb-4 mb-6">
          <div class="text-[10px] font-black uppercase tracking-[0.2em] text-emerald-600">WhatsApp Sales Handoff</div>
          <div class="text-xs font-black text-slate-900 mt-1">Pre-filled Order Summary</div>
        </div>

        <div class="space-y-4">
          <!-- Structured Fields -->
          <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-sm flex items-center justify-between">
            <div>
              <div class="text-[9px] font-black uppercase tracking-wider text-slate-400">Product Interest</div>
              <div class="text-sm font-black text-slate-900 mt-0.5">White Runner Sneaker</div>
            </div>
            <span class="text-xs font-bold text-slate-600">₹2,999</span>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-sm">
              <div class="text-[9px] font-black uppercase tracking-wider text-slate-400">Selected Size</div>
              <div class="text-sm font-black text-slate-900 mt-0.5">UK Size 9</div>
            </div>
            <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-sm">
              <div class="text-[9px] font-black uppercase tracking-wider text-slate-400">Quantity</div>
              <div class="text-sm font-black text-slate-900 mt-0.5">1 Pair</div>
            </div>
          </div>

          <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-sm">
            <div class="text-[9px] font-black uppercase tracking-wider text-slate-400">Shipping Address</div>
            <div class="text-xs font-semibold text-slate-800 mt-1">Indiranagar, Bangalore — 560038</div>
          </div>

          <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-4 shadow-sm flex items-center justify-between">
            <div>
              <div class="text-[9px] font-black uppercase tracking-wider text-emerald-600">Handoff Action</div>
              <div class="text-xs font-black text-emerald-800 mt-0.5">Staff confirms payment & closes</div>
            </div>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)] animate-pulse"></span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

