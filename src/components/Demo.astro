---
---

<section id="demo" class="py-20 md:py-32 relative overflow-hidden">
  <!-- Background Accents -->
  <div class="absolute inset-0 pointer-events-none -z-10">
    <div class="sect-grid opacity-5"></div>
    <div class="sect-orb" style="width:700px;height:700px;background:radial-gradient(circle,rgba(79,70,229,0.05) 0%,transparent 70%);top:50%;left:50%;transform:translate(-50%, -50%);"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="section-badge mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" class="mr-1"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        Product Proof
      </span>
      <h2 class="text-4xl sm:text-5xl font-heading font-bold text-slate-900 mb-6 leading-tight">
        Built for the work inside your <span class="text-gradient-primary">actual store.</span>
      </h2>
      <p class="text-lg text-slate-600 leading-relaxed">
        From social comments to product lookup, carts, orders, and customer conversations, VoluChat gives your team one place to run AI-assisted commerce.
      </p>
    </div>

    <div class="relative max-w-5xl mx-auto group">
      <div class="glass-panel relative overflow-hidden rounded-[1.75rem]">
        <img src="/dashboard-preview.png" alt="VoluChat dashboard showing ecommerce automation analytics" class="w-full object-cover" loading="lazy" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/90 via-slate-950/55 to-transparent p-6 md:p-8">
          <div class="grid gap-4 md:grid-cols-3">
            <div class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
              <div class="text-xs font-bold uppercase tracking-[0.18em] text-white/60">Inbox automation</div>
              <div class="mt-2 text-lg font-black text-white">DMs, comments, replies</div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
              <div class="text-xs font-bold uppercase tracking-[0.18em] text-white/60">Commerce context</div>
              <div class="mt-2 text-lg font-black text-white">Products, carts, orders</div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
              <div class="text-xs font-bold uppercase tracking-[0.18em] text-white/60">AI assistant</div>
              <div class="mt-2 text-lg font-black text-white">Copy, search, answers</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Stats / Footnote -->
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto text-center">
      <div>
        <div class="text-3xl font-heading font-bold text-slate-900">2s</div>
        <div class="text-sm text-slate-500 font-medium">AI Response Time</div>
      </div>
      <div>
        <div class="text-3xl font-heading font-bold text-slate-900">24/7</div>
        <div class="text-sm text-slate-500 font-medium">Sales Engine</div>
      </div>
      <div>
        <div class="text-3xl font-heading font-bold text-slate-900">100%</div>
        <div class="text-sm text-slate-500 font-medium">Meta Compliant</div>
      </div>
      <div>
        <div class="text-3xl font-heading font-bold text-slate-900">80%</div>
        <div class="text-sm text-slate-500 font-medium">Queries Automated</div>
      </div>
    </div>
  </div>
</section>
