---
const demoSteps = [
  { label: "Buyer asks", value: "Is the white sneaker available in UK 9?" },
  { label: "VoluChat checks", value: "Product, stock, price, delivery, offer rules" },
  { label: "Reply sent", value: "Yes. UK 9 is available. Delivery to Pune works." },
  { label: "Team sees", value: "Buyer intent, product, size, PIN code, next step" },
];
---

<section id="demo" class="section-pad relative overflow-hidden">
  <div class="ambient-noise"></div>

  <div class="page-shell">
    <div class="mx-auto max-w-3xl text-center reveal-on-scroll">
      <p class="section-eyebrow">Live workflow preview</p>
      <h2 class="section-title mt-4">
        Watch one question become a sales-ready reply.
      </h2>
      <p class="section-copy mx-auto mt-5 max-w-2xl">
        Repeated product questions, answered automatically for any shoe, fashion, beauty, jewelry, or accessory store.
      </p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="rounded-[2rem] border border-stone-200/70 bg-white/72 p-5 shadow-[0_24px_80px_rgba(28,25,23,0.09)] backdrop-blur-2xl reveal-on-scroll">
        <div class="flex items-center justify-between border-b border-stone-200/70 pb-4">
          <div>
            <p class="mini-label">Incoming buyer</p>
            <p class="mt-1 text-sm font-semibold text-stone-950">Instagram DM</p>
          </div>
          <span class="rounded-full bg-primary-50 px-3 py-1 text-[10px] font-semibold text-primary-700">new</span>
        </div>

        <div class="mt-5 space-y-4">
          <div class="max-w-[83%] rounded-2xl bg-stone-100 px-4 py-3 text-sm font-medium leading-relaxed text-stone-800">
            Is the white premium sneaker available in UK 9? Need delivery to Pune.
          </div>
          <div class="ml-auto max-w-[83%] rounded-2xl bg-[linear-gradient(135deg,#283957,#536f9f)] px-4 py-3 text-sm font-semibold leading-relaxed text-white shadow-[0_16px_42px_rgba(40,57,87,0.18)]">
            Yes. UK 9 is available in white. Delivery to Pune 411014 is supported.
          </div>
        </div>
      </div>

      <div class="grid gap-3 reveal-on-scroll reveal-delay-100">
        {demoSteps.map((step, index) => (
          <article class="kinetic-card rounded-[1.35rem] border border-white/80 bg-white/70 p-4 shadow-[0_16px_55px_rgba(28,25,23,0.08)] backdrop-blur-2xl">
            <div class="flex items-center gap-4">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-primary-800 font-mono text-xs font-semibold text-white shadow-[0_12px_30px_rgba(40,57,87,0.16)]">0{index + 1}</span>
              <div>
                <p class="mini-label">{step.label}</p>
                <p class="mt-1 text-sm font-semibold leading-relaxed text-stone-950">{step.value}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
