---
---

<section id="demo" class="py-20 md:py-32 relative overflow-hidden bg-[#fafafa]">
  <!-- Background Accents -->
  <div class="absolute inset-0 pointer-events-none -z-10">
    <div class="sect-grid opacity-5"></div>
    <div class="sect-orb" style="width:700px;height:700px;background:radial-gradient(circle,rgba(79,70,229,0.05) 0%,transparent 70%);top:50%;left:50%;transform:translate(-50%, -50%);"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="section-badge mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" class="mr-1"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        Product Demo
      </span>
      <h2 class="text-4xl sm:text-5xl font-heading font-bold text-slate-900 mb-6 leading-tight">
        See VoluChat in <span class="text-gradient-primary">Action</span>
      </h2>
      <p class="text-lg text-slate-600 leading-relaxed">
        Watch how our AI automates your Instagram growth, qualification, and sales handoff in real-time.
      </p>
    </div>

    <!-- Video Container -->
    <div class="relative max-w-5xl mx-auto group">
      <!-- Decorative Frame -->
      <div class="absolute -inset-4 rounded-[2.5rem] bg-gradient-to-tr from-indigo-500/10 via-purple-500/10 to-pink-500/10 blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
      
      <div class="relative bg-slate-900 rounded-[2rem] border border-white/10 shadow-2xl overflow-hidden aspect-video">
        <!-- Replace this with a real video source when available -->
        <div class="absolute inset-0 flex items-center justify-center bg-[url('/dashboard-preview.png')] bg-cover bg-center opacity-40 group-hover:scale-105 transition-transform duration-700"></div>
        
        <!-- Video Overlay / Play Button -->
        <div class="absolute inset-0 bg-slate-900/40 flex items-center justify-center backdrop-blur-[2px] group-hover:backdrop-blur-0 transition-all duration-500">
          <button class="w-20 h-20 rounded-full bg-white text-indigo-600 flex items-center justify-center shadow-2xl hover:scale-110 active:scale-95 transition-all duration-300 group/btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" class="ml-1"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            
            <!-- Pulse Effect -->
            <div class="absolute inset-0 rounded-full bg-white/50 animate-ping -z-10 group-hover:animate-none group-hover:scale-150 group-hover:opacity-0 transition-all duration-500"></div>
          </button>
        </div>

        <!-- Floating UI Mockups (Decorative) -->
        <div class="absolute bottom-6 left-6 right-6 flex justify-between items-end pointer-events-none">
          <div class="glass py-2 px-4 rounded-full text-xs font-bold text-slate-900 shadow-lg translate-y-12 group-hover:translate-y-0 transition-transform duration-700 delay-100">
            Auto-reply Active • 98% Success Rate
          </div>
          <div class="glass py-2 px-4 rounded-full text-xs font-bold text-slate-900 shadow-lg translate-y-12 group-hover:translate-y-0 transition-transform duration-700 delay-200">
             Lead Qualified: "Deepak Sharma"
          </div>
        </div>
      </div>

      <!-- Bottom Shadow -->
      <div class="absolute -bottom-10 left-10 right-10 h-10 bg-indigo-500/20 blur-3xl -z-10 rounded-full"></div>
    </div>
    
    <!-- Stats / Footnote -->
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto text-center">
      <div>
        <div class="text-3xl font-heading font-bold text-slate-900">2s</div>
        <div class="text-sm text-slate-500 font-medium">Avg. Response Time</div>
      </div>
      <div>
        <div class="text-3xl font-heading font-bold text-slate-900">24/7</div>
        <div class="text-sm text-slate-500 font-medium">Sales Engine</div>
      </div>
      <div>
        <div class="text-3xl font-heading font-bold text-slate-900">100%</div>
        <div class="text-sm text-slate-500 font-medium">Meta Compliant</div>
      </div>
      <div>
        <div class="text-3xl font-heading font-bold text-slate-900">10x</div>
        <div class="text-sm text-slate-500 font-medium">ROAS Boost</div>
      </div>
    </div>
  </div>
</section>
