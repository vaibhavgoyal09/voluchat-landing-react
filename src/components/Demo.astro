---
const demoScreenshots = [
  {
    label: "Product match",
    title: "A vague sneaker request becomes shoppable options",
    caption: "VoluChat understands the buyer's message, searches the catalog, and replies with products they can choose from.",
    src: "/demo-screenshot-01.webp",
    alt: "Instagram DM showing VoluChat replying to a sneaker request with matching product cards",
  },
  {
    label: "Variant capture",
    title: "Size, color, and cart total are confirmed in chat",
    caption: "Instead of sending the buyer to a form, the agent collects the missing choices and keeps the cart state updated.",
    src: "/demo-screenshot-02.webp",
    alt: "Instagram DM showing VoluChat asking for size and color before adding the product to cart",
  },
  {
    label: "Address confirmation",
    title: "Delivery details are confirmed before handoff",
    caption: "VoluChat asks the buyer to confirm the shipping address and phone number before the order moves out of Instagram.",
    src: "/demo-screenshot-03.webp",
    alt: "Instagram DM showing VoluChat asking the buyer to confirm delivery address before checkout",
  },
  {
    label: "WhatsApp handoff",
    title: "Your team receives structured WhatsApp text",
    caption: "The handoff includes the selected product, size, color, total, address, and phone number in one message.",
    src: "/demo-screenshot-04.webp",
    alt: "WhatsApp message showing the selected product, total, shipping address, and phone number from the Instagram checkout flow",
  },
];
---

<section id="demo" class="section-pad relative overflow-hidden">
  <div class="ambient-noise"></div>

  <div class="page-shell relative z-10">
    <div class="mx-auto max-w-3xl text-center reveal-on-scroll">
      <p class="section-eyebrow">Demo breakdown</p>
      <h2 class="section-title mt-4">
        The moments that turn a DM into a checkout-ready order.
      </h2>
      <p class="section-copy mx-auto mt-5 max-w-2xl">
        The hero shows the full recording. These stills isolate what matters: matching products, collecting variants, and preparing the handoff your team can act on.
      </p>
    </div>

    <div class="mx-auto mt-10 grid max-w-5xl gap-5">
      {demoScreenshots.map((screenshot, index) => (
        <article class={`kinetic-card solid-card overflow-hidden p-0 reveal-on-scroll ${index === 1 ? 'reveal-delay-100' : ''}`}>
          <div class={`grid items-center gap-6 p-5 sm:p-6 lg:grid-cols-[0.78fr_1fr] lg:gap-9 ${index % 2 === 1 ? 'lg:[&>.demo-phone]:order-2' : ''}`}>
            <div class="demo-phone mx-auto w-full max-w-[15rem] sm:max-w-[16.5rem] lg:max-w-[17.5rem]">
            <div class="relative rounded-[1.75rem] border border-stone-200 bg-white p-2 shadow-[0_22px_70px_rgba(28,25,23,0.12)]">
              <div class="rounded-[1.45rem] bg-stone-950 p-1.5 shadow-inner">
                <div class="relative overflow-hidden rounded-[1.15rem] bg-stone-950">
                  <img
                    src={screenshot.src}
                    alt={screenshot.alt}
                    class="aspect-[9/20] w-full bg-stone-950 object-cover"
                    loading="lazy"
                    decoding="async"
                    width="540"
                    height="1200"
                  />

                  <div class="pointer-events-none absolute inset-x-0 top-0 flex justify-center pt-1.5">
                    <div class="h-3 w-16 rounded-full bg-stone-950/85"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

            <div class="mx-auto max-w-lg text-center lg:mx-0 lg:text-left">
              <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-800 font-mono text-xs font-semibold text-white shadow-[0_12px_30px_rgba(40,57,87,0.16)]">
                0{index + 1}
              </div>
              <p class="mini-label mt-5">{screenshot.label}</p>
              <h3 class="mt-3 text-2xl font-semibold leading-tight text-stone-950 sm:text-3xl">
              {screenshot.title}
              </h3>
              <p class="mt-4 text-base font-medium leading-relaxed text-stone-600">
              {screenshot.caption}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
