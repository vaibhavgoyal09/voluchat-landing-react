---
const demoSteps = [
  { label: "Buyer asks", value: "Is the linen co-ord available in Size M?" },
  { label: "VoluChat checks", value: "Product, stock, price, delivery, offer rules" },
  { label: "Cart built", value: "Linen co-ord, Size M, Ivory, Qty 1" },
  { label: "Checkout draft", value: "Prefilled WhatsApp text with cart and delivery address" },
];
---

<section id="demo" class="section-pad relative overflow-hidden">
  <div class="ambient-noise"></div>

  <div class="page-shell">
    <div class="mx-auto max-w-3xl text-center reveal-on-scroll">
      <p class="section-eyebrow">Live workflow preview</p>
      <h2 class="section-title mt-4">
        Watch a product question become a checkout-ready WhatsApp draft.
      </h2>
      <p class="section-copy mx-auto mt-5 max-w-2xl">
        One concrete example, from incoming DM to a handoff your team can actually act on.
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="solid-card reveal-on-scroll">
        <div class="flex items-center justify-between border-b border-stone-200/70 pb-4">
          <div>
            <p class="mini-label">Incoming buyer</p>
            <p class="mt-1 text-sm font-semibold text-stone-950">Instagram DM</p>
          </div>
          <span class="rounded-full bg-primary-50 px-3 py-1 text-[10px] font-semibold text-primary-700">new</span>
        </div>

        <div class="mt-5 space-y-4">
          <div class="max-w-[83%] rounded-xl bg-stone-100 px-4 py-3 text-sm font-medium leading-relaxed text-stone-800">
            Is the linen co-ord available in Size M? Need delivery to Delhi.
          </div>
          <div class="ml-auto max-w-[83%] rounded-xl bg-primary-900 px-4 py-3 text-sm font-semibold leading-relaxed text-white shadow-[0_16px_42px_rgba(40,57,87,0.18)]">
            Yes. Size M is available in ivory. Share your delivery address and I will prepare the checkout message.
          </div>
          <div class="ml-auto max-w-[83%] rounded-xl bg-primary-900 px-4 py-3 text-sm font-semibold leading-relaxed text-white shadow-[0_16px_42px_rgba(40,57,87,0.18)]">
            Checkout draft ready for WhatsApp: Linen Co-ord Set, Size M, Ivory, Qty 1, Delhi 110024.
          </div>
        </div>
      </div>

      <div class="grid gap-3 reveal-on-scroll reveal-delay-100">
        {demoSteps.map((step, index) => (
          <article class="kinetic-card solid-card-compact">
            <div class="flex items-center gap-4">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-primary-800 font-mono text-xs font-semibold text-white shadow-[0_12px_30px_rgba(40,57,87,0.16)]">0{index + 1}</span>
              <div>
                <p class="mini-label">{step.label}</p>
                <p class="mt-1 text-sm font-semibold leading-relaxed text-stone-950">{step.value}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
