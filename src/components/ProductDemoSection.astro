---
const demos = [
  {
    channel: "Instagram Reel DM",
    channelIcon: "📸",
    badge: "2s Response",
    badgeColor: "text-pink-400 bg-pink-500/10 border-pink-500/20",
    inquiryTitle: "Price & Fit Inquiry",
    buyerMsg: "Price of the emerald floral kurta? Is size M available?",
    buyerSub: "Comment on Reel #104 • 11:24 PM",
    agentMsg: "Hey Priya! Emerald Set is ₹2,899. 3 units left in M. Tap below to reserve your size with free shipping ✨",
    ctaText: "Open WhatsApp Sizing Link",
    statusText: "Transferred to WhatsApp with SKU & size context",
  },
  {
    channel: "WhatsApp AI Stylist",
    channelIcon: "👗",
    badge: "Live Shopify Sync",
    badgeColor: "text-teal-400 bg-teal-500/10 border-teal-500/20",
    inquiryTitle: "Sizing Qualification",
    buyerMsg: "I'm a 38 bust. Should I pick M or L? Does the silk stretch?",
    buyerSub: "WhatsApp Shopper • 11:26 PM",
    agentMsg: "Pure Chanderi Silk has zero stretch, so Size L gives the relaxed fit shown in our reel. We have 4 units left in L!",
    ctaText: "Check Bangalore Delivery SLA",
    statusText: "Express 2-day delivery confirmed for Pin 560001",
  },
  {
    channel: "Native 1-Click Checkout",
    channelIcon: "⚡",
    badge: "Instant UPI Link",
    badgeColor: "text-emerald-400 bg-emerald-500/10 border-emerald-500/20",
    inquiryTitle: "In-Chat Checkout",
    buyerMsg: "Can I pay via GPay now?",
    buyerSub: "Ready to Purchase • 11:27 PM",
    agentMsg: "Total: ₹2,749 (includes ₹150 prepaid discount). Tap below to pay via GPay, PhonePe, or Paytm:",
    isPaymentCard: true,
    upiAmount: "₹2,749",
    upiDiscount: "₹150 PREPAID SAVINGS APPLIED",
    statusText: "✓ Paid in 18s • Shopify Order #4928 Draft Created",
  },
];
---

<section id="product-demo" class="relative overflow-hidden py-24 sm:py-32 bg-[#000000]">
  <!-- Subtle ambient grid glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-20%,rgba(16,185,129,0.06),transparent)] pointer-events-none"></div>

  <div class="page-shell relative z-10">
    <div class="mb-16 max-w-2xl">
      <div class="chip mb-4">
        <span class="mini-label text-emerald-400">Live Demonstrations</span>
      </div>
      <h2 class="section-title text-[#fcfdff] font-heading">
        Real conversations that <span class="text-emerald-400">close boutique buyers</span>.
      </h2>
      <p class="section-copy mt-3">
        See how VoluChat answers complex fit questions and collects UPI checkout in under 90 seconds.
      </p>
    </div>

    <!-- 3 Ultra-Polished App-Frame Chat Cards -->
    <div class="grid gap-8 lg:grid-cols-3 items-stretch">
      {
        demos.map((demo, idx) => (
          <div class={`reveal-on-scroll reveal-delay-${idx + 1} group rounded-3xl border border-white/[0.10] bg-[#070709] p-6 sm:p-7 flex flex-col justify-between hover:border-emerald-500/30 transition-all duration-300 shadow-2xl relative overflow-hidden`}>
            <!-- Top Card Header -->
            <div>
              <div class="flex items-center justify-between border-b border-white/[0.06] pb-4 mb-6">
                <div class="flex items-center gap-2.5">
                  <span class="text-sm">{demo.channelIcon}</span>
                  <span class="font-mono text-xs font-semibold text-slate-300 tracking-wide">
                    {demo.channel}
                  </span>
                </div>
                <span class={`rounded-full border px-2.5 py-0.5 text-[10px] font-mono font-medium ${demo.badgeColor}`}>
                  {demo.badge}
                </span>
              </div>

              <!-- Message Sequence Flow Container -->
              <div class="space-y-4">
                <!-- Buyer Message -->
                <div class="flex flex-col items-start max-w-[92%]">
                  <div class="rounded-2xl rounded-tl-sm border border-white/[0.08] bg-[#141418] px-4 py-3.5 shadow-sm">
                    <p class="text-[13px] sm:text-sm font-normal text-white leading-relaxed">
                      "{demo.buyerMsg}"
                    </p>
                  </div>
                  <span class="text-[10px] font-mono text-slate-500 mt-1.5 ml-1">
                    {demo.buyerSub}
                  </span>
                </div>

                <!-- Agent Message -->
                <div class="flex flex-col items-end max-w-[94%] ml-auto">
                  <div class="rounded-2xl rounded-tr-sm border border-emerald-500/25 bg-[#091a13] px-4 py-3.5 shadow-md">
                    <div class="flex items-center gap-1.5 mb-1.5">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                      <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-emerald-400">VoluChat Stylist</span>
                    </div>
                    <p class="text-[13px] sm:text-sm font-normal text-emerald-100 leading-relaxed">
                      {demo.agentMsg}
                    </p>

                    {demo.isPaymentCard ? (
                      <!-- Native Payment Pill inside chat bubble -->
                      <div class="mt-3.5 rounded-xl border border-emerald-500/40 bg-emerald-500/10 p-3 text-center">
                        <div class="text-[10px] font-mono font-bold tracking-wider text-emerald-300 mb-0.5">
                          {demo.upiDiscount}
                        </div>
                        <div class="font-heading text-lg font-bold text-white">
                          Pay {demo.upiAmount} via UPI
                        </div>
                        <div class="text-[10px] text-emerald-400/80 font-mono mt-0.5">
                          1-Tap GooglePay / PhonePe / Paytm
                        </div>
                      </div>
                    ) : (
                      <!-- Interactive Link Pill -->
                      <div class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-3 py-1.5 text-xs font-medium text-emerald-300">
                        <span>{demo.ctaText}</span>
                        <span>&rarr;</span>
                      </div>
                    )}
                  </div>
                  <span class="text-[10px] font-mono text-emerald-400/70 mt-1.5 mr-1">
                    Delivered &bull; Read instantly
                  </span>
                </div>
              </div>
            </div>

            <!-- Bottom Outcome Row -->
            <div class="mt-8 pt-4 border-t border-white/[0.06] flex items-center justify-between text-xs font-mono">
              <span class="text-slate-400 text-[11px] truncate pr-2">
                {demo.statusText}
              </span>
              <span class="text-emerald-400 font-bold shrink-0">
                100% Automated
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
