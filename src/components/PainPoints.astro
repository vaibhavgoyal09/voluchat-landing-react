---
const frictionPoints = [
  {
    num: "01",
    issue: "Comments & DMs left waiting",
    desc: "A shopper asks for price or size while your team is busy packing orders. By the time you reply, the impulse interest has cooled down."
  },
  {
    num: "02",
    issue: "Manual catalog double-entry",
    desc: "Staff has to scroll through endless posts, highlights, and excel sheets to check if a specific satin kurta is in stock or matches the size."
  },
  {
    num: "03",
    issue: "Order questions repeat on WhatsApp",
    desc: "Even after reaching WhatsApp, you spend hours re-asking for size, color, shipping address, and delivery PIN codes manually."
  }
];

interface ChatMockup {
  type: "chat";
  lines: Array<{ sender: string; text: string }>;
}

interface CatalogMockup {
  type: "catalog";
  name: string;
  price: string;
  status: string;
  img: string;
}

interface TicketMockup {
  type: "ticket";
  items: Array<{ label: string; val: string }>;
}

interface FlowCard {
  badge: string;
  title: string;
  desc: string;
  mockup: ChatMockup | CatalogMockup | TicketMockup;
}

const flowCards: FlowCard[] = [
  {
    badge: "Always Online Cover",
    title: "Instant coverage on every post & Reel",
    desc: "VoluChat replies to comments and DMs instantly, ensuring shoppers get prices and sizing details the second interest is fresh.",
    mockup: {
      type: "chat",
      lines: [
        { sender: "buyer", text: "Is the ivory linen set available in Size S?" },
        { sender: "voluchat", text: "Yes, Size S is available. Ready to sync size M & L too. Can I sync this to WhatsApp?" }
      ]
    }
  },
  {
    badge: "Synced Catalog",
    title: "Zero-effort database matching",
    desc: "Shoppers send screenshots or write descriptions. VoluChat queries your live Meta inventory in 0.8 seconds to verify stock and price.",
    mockup: {
      type: "catalog",
      name: "Satin Kurta Set",
      price: "Rs. 4,500",
      status: "In Stock",
      img: "/satin_kurta_thumb.png"
    }
  },
  {
    badge: "Clean Handoff",
    title: "WhatsApp starts with order details done",
    desc: "VoluChat pre-collects sizing, shade choice, and shipping PIN codes, passing a neat order summary ticket to your WhatsApp team.",
    mockup: {
      type: "ticket",
      items: [
        { label: "Product", val: "Linen co-ord" },
        { label: "Size Selected", val: "Size M" },
        { label: "PIN Code", val: "Pune 411014" }
      ]
    }
  }
];
---

<section id="transformation" class="section-pad relative overflow-hidden">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="absolute left-1/4 top-1/4 h-[30rem] w-[30rem] rounded-full bg-stone-300/10 blur-3xl"></div>
  </div>

  <div class="page-shell">
    <div class="grid gap-12 lg:grid-cols-12 items-start">
      
      <!-- Left Column: Sticky Friction Description -->
      <div class="lg:col-span-5 lg:sticky lg:top-28 space-y-8 reveal-on-scroll">
        <div>
          <p class="section-eyebrow">The boutique workload</p>
          <h2 class="text-3xl font-heading font-semibold leading-[1.08] text-stone-950 sm:text-5xl mt-3">
            Why DM sales feel so slow <span class="text-stone-400 font-normal italic">& exhausting</span>.
          </h2>
          <p class="section-copy mt-5">
            Fashion boutiques shouldn't spend the day manually re-typing price lists, size charts, shipping rates, and address forms for every single Instagram commenter.
          </p>
        </div>

        <!-- Vertical Friction Stepper -->
        <div class="space-y-6 pt-6 border-t border-stone-200/80">
          {frictionPoints.map((point) => (
            <div class="flex gap-4 group">
              <span class="font-mono text-xs font-bold text-stone-600 bg-white border border-stone-200/80 rounded-xl h-9 w-9 shrink-0 flex items-center justify-center shadow-sm group-hover:border-stone-300 transition-colors">
                {point.num}
              </span>
              <div>
                <h4 class="text-sm font-bold text-stone-900 group-hover:text-stone-950 transition-colors">{point.issue}</h4>
                <p class="text-xs text-stone-500 mt-1.5 leading-relaxed font-medium">{point.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Staggered Premium Flow Cards -->
      <div class="lg:col-span-7 space-y-8">
        <div class="text-[10px] font-bold uppercase tracking-[0.22em] text-stone-700 bg-stone-100/70 border border-stone-200/80 px-4.5 py-2 rounded-xl inline-block mb-2 backdrop-blur-md shadow-sm">
          The Flow: Powered by VoluChat
        </div>

        {flowCards.map((card, index) => (
          <article class={`glass-card-premium rounded-[2.25rem] p-6 md:p-8 hover:-translate-y-1.5 hover:shadow-2xl hover:border-white transition-all duration-500 group reveal-on-scroll ${index === 1 ? 'reveal-delay-100' : index === 2 ? 'reveal-delay-200' : ''}`}>
            <div class="grid gap-6 md:grid-cols-[1.1fr_0.9fr] items-center">
              
              <!-- Content -->
              <div class="space-y-4">
                <span class="chip">{card.badge}</span>
                <h3 class="font-heading text-xl font-semibold text-stone-950 leading-tight">
                  {card.title}
                </h3>
                <p class="text-xs font-semibold leading-relaxed text-stone-600">
                  {card.desc}
                </p>
              </div>

              <!-- Interactive Mockup Inside Card -->
              <div class="rounded-2xl border border-stone-200/50 bg-stone-50/50 p-4.5 shadow-inner">
                {card.mockup.type === "chat" && (
                  <div class="space-y-3">
                    <div class="flex gap-2">
                      <div class="h-6 w-6 rounded-full bg-stone-200 shrink-0 border border-stone-300 overflow-hidden flex items-center justify-center font-bold text-[8px] text-stone-500">B</div>
                      <div class="max-w-[80%] rounded-2xl bg-white border border-stone-200/80 px-3 py-2 text-[10px] font-semibold text-stone-850 shadow-sm leading-normal">
                        {card.mockup.lines![0].text}
                      </div>
                    </div>
                    <div class="flex justify-end gap-2">
                      <div class="max-w-[80%] rounded-2xl bg-stone-950 px-3 py-2 text-[10px] font-semibold text-white leading-normal shadow-sm border border-stone-900">
                        {card.mockup.lines![1].text}
                      </div>
                      <div class="h-6 w-6 rounded-full bg-white border border-stone-200 flex items-center justify-center shrink-0 shadow-sm p-1">
                        <img src="/voluchat_logo.svg" alt="VoluChat AI" class="h-full w-full object-contain" />
                      </div>
                    </div>
                  </div>
                )}

                {card.mockup.type === "catalog" && (
                  <div class="flex items-center gap-3 bg-white border border-stone-200/80 p-3 rounded-xl shadow-md hover:scale-[1.02] transition-transform duration-300">
                    <img src={card.mockup.img} alt={card.mockup.name} class="h-11 w-11 rounded-lg border border-stone-100 object-contain bg-stone-50 p-0.5" />
                    <div class="flex-1 min-w-0">
                      <p class="text-xs font-bold text-stone-900 truncate">{card.mockup.name}</p>
                      <p class="text-[10px] text-stone-500 font-bold mt-0.5">{card.mockup.price}</p>
                    </div>
                    <span class="rounded-lg bg-emerald-50 border border-emerald-100 px-2 py-0.5 text-[9px] font-bold text-emerald-700 shrink-0">
                      {card.mockup.status}
                    </span>
                  </div>
                )}

                {card.mockup.type === "ticket" && (
                  <div class="space-y-1.5 font-mono text-[9px] bg-white border border-stone-200/80 rounded-xl p-3.5 shadow-sm">
                    <div class="border-b border-stone-200 pb-1.5 flex justify-between text-stone-400 font-bold">
                      <span>HANDOFF TICKET</span>
                      <span class="text-stone-900 font-bold flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        READY
                      </span>
                    </div>
                    {card.mockup.items?.map((it) => (
                      <div class="flex justify-between py-0.5 border-b border-stone-100/50">
                        <span class="text-stone-500">{it.label}:</span>
                        <span class="font-bold text-stone-900">{it.val}</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>

            </div>
          </article>
        ))}
      </div>

    </div>
    
    <div class="mt-16 flex justify-center reveal-on-scroll">
      <a href="/contact" class="btn-primary">
        Start 14-day free trial
      </a>
    </div>
  </div>
</section>
