---
const painPoints = [
  {
    label: "01",
    title: "Simple questions steal hours",
    text: "Buyers ask the same few things in different words, across DMs, comments, and follow-up messages.",
  },
  {
    label: "02",
    title: "Every answer needs store context",
    text: "Availability, serviceability, return rules, COD, and offer logic all have to be checked before a confident reply.",
  },
  {
    label: "03",
    title: "Interested buyers lose momentum",
    text: "When the conversation jumps channels too early, teams have to reconstruct what the buyer wanted.",
  },
];
---

<section id="transformation" class="section-pad relative overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_18%_24%,rgba(243,247,251,0.7),transparent_30%),radial-gradient(circle_at_86%_18%,rgba(229,237,246,0.68),transparent_34%)]"></div>
  <div class="ambient-noise"></div>

  <div class="page-shell">
    <div class="grid gap-10 lg:grid-cols-[0.86fr_1.14fr] lg:items-end">
      <div class="max-w-xl reveal-on-scroll">
        <p class="section-eyebrow">The repeated-question workload</p>
        <h2 class="section-title mt-4">
          The same questions and checkout steps hit every inbox.
        </h2>
        <p class="section-copy mt-5">
          Whether one person or ten handle chats, the real cost is context switching: every buyer needs the same facts assembled quickly and consistently.
        </p>
      </div>

      <div class="dark-band rounded-2xl p-5 reveal-on-scroll reveal-delay-100">
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-white/10 bg-white/[0.06] p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary-100/70">Incoming chats</p>
            <p class="mt-3 text-2xl font-semibold">High intent</p>
            <p class="mt-1 text-xs font-medium text-primary-50/70">low patience</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/[0.08] p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary-100/70">Cart context</p>
            <p class="mt-3 text-2xl font-semibold">Store rules</p>
            <p class="mt-1 text-xs font-medium text-primary-50/70">scattered facts</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/[0.12] p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary-200">WhatsApp checkout</p>
            <p class="mt-3 text-2xl font-semibold">Cleaner close</p>
            <p class="mt-1 text-xs font-medium text-primary-100/80">less backtracking</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {painPoints.map((point, index) => (
        <article class={`kinetic-card solid-card reveal-on-scroll ${index === 1 ? 'reveal-delay-100' : index === 2 ? 'reveal-delay-200' : ''}`}>
          <p class="font-mono text-xs font-semibold text-primary-700">{point.label}</p>
          <h3 class="mt-5 text-2xl font-semibold tracking-tight text-stone-950">{point.title}</h3>
          <p class="mt-4 text-sm font-medium leading-relaxed text-stone-600">{point.text}</p>
        </article>
      ))}
    </div>

    <div class="mt-10 flex justify-center reveal-on-scroll">
      <a href="/contact" class="btn-primary">
        Book demo call
      </a>
    </div>
  </div>
</section>
