---
const painPoints = [
  {
    label: "01",
    title: "Price and size questions pile up",
    text: "Buyers ask for price, size, color, and fit across Instagram DMs, Facebook Page comments, and WhatsApp handoffs.",
  },
  {
    label: "02",
    title: "Stock and delivery checks repeat",
    text: "Every answer depends on availability, delivery PIN code, return rules, and COD before a buyer can decide.",
  },
  {
    label: "03",
    title: "Cart and checkout details stall",
    text: "Cart items, quantities, variant choices, delivery address, and offer codes should be collected before the buyer moves to WhatsApp.",
  },
];
---

<section id="transformation" class="section-pad relative overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_18%_24%,rgba(243,247,251,0.7),transparent_30%),radial-gradient(circle_at_86%_18%,rgba(229,237,246,0.68),transparent_34%)]"></div>
  <div class="ambient-noise"></div>

  <div class="page-shell">
    <div class="grid gap-10 lg:grid-cols-[0.86fr_1.14fr] lg:items-end">
      <div class="max-w-xl reveal-on-scroll">
        <p class="section-eyebrow">The repeated-question workload</p>
        <h2 class="section-title mt-4">
          The same questions and checkout steps hit every inbox.
        </h2>
        <p class="section-copy mt-5">
          Whether one person or ten handle chats, ecommerce stores should not ask buyers to restart on WhatsApp before the cart, variants, and delivery address are ready.
        </p>
      </div>

      <div class="rounded-[2rem] border border-primary-200/20 bg-[radial-gradient(circle_at_10%_0%,rgba(255,255,255,0.18),transparent_36%),radial-gradient(circle_at_92%_12%,rgba(174,191,215,0.18),transparent_34%),linear-gradient(135deg,#283957,#536f9f)] p-5 text-white shadow-[0_32px_100px_rgba(40,57,87,0.22)] reveal-on-scroll reveal-delay-100">
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-2xl border border-primary-100/10 bg-white/[0.055] p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary-100/70">Incoming chats</p>
            <p class="mt-3 text-2xl font-semibold">Price, size</p>
            <p class="mt-1 text-xs font-medium text-primary-50/70">delivery questions</p>
          </div>
          <div class="rounded-2xl border border-primary-100/10 bg-primary-500/[0.08] p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary-100/70">Cart context</p>
            <p class="mt-3 text-2xl font-semibold">Stock, offers</p>
            <p class="mt-1 text-xs font-medium text-primary-50/70">variants and address</p>
          </div>
          <div class="rounded-2xl border border-primary-100/10 bg-primary-500/18 p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary-200">WhatsApp checkout</p>
            <p class="mt-3 text-2xl font-semibold">Prefilled text</p>
            <p class="mt-1 text-xs font-medium text-primary-100/80">payment left</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {painPoints.map((point, index) => (
        <article class={`kinetic-card rounded-[1.5rem] border border-white/80 bg-white/68 p-6 shadow-[0_18px_60px_rgba(28,25,23,0.08)] backdrop-blur-2xl reveal-on-scroll ${index === 1 ? 'reveal-delay-100 bg-primary-50/45' : index === 2 ? 'reveal-delay-200 bg-sky-soft/45' : 'bg-white/72'}`}>
          <p class="font-mono text-xs font-semibold text-primary-700">{point.label}</p>
          <h3 class="mt-5 text-2xl font-semibold tracking-tight text-stone-950">{point.title}</h3>
          <p class="mt-4 text-sm font-medium leading-relaxed text-stone-600">{point.text}</p>
        </article>
      ))}
    </div>

    <div class="mt-10 flex justify-center reveal-on-scroll">
      <a href="/contact" class="btn-primary">
        Start 14-day free trial
      </a>
    </div>
  </div>
</section>
