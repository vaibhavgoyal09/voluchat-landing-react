---
const comparisons = [
  {
    id: "01",
    pain: {
      title: "Customers comment, then wait",
      description: "Someone asks for price or size on your Reel. If the reply comes late, they forget, get confused, or move on.",
      icon: "clock"
    },
    gain: {
      title: "VoluChat replies while they are interested",
      description: "When a buyer comments, VoluChat can send a helpful DM and keep the conversation moving.",
      icon: "zap"
    }
  },
  {
    id: "02",
    pain: {
      title: "You answer the same shoe questions all day",
      description: "Price, size, color, photos, delivery, and stock questions keep repeating in comments and DMs.",
      icon: "users"
    },
    gain: {
      title: "Buyers get clear answers in Instagram DM",
      description: "VoluChat can use your shoe details to answer common questions before the chat reaches WhatsApp.",
      icon: "check-circle"
    }
  },
  {
    id: "03",
    pain: {
      title: "WhatsApp chats start with no context",
      description: "You open WhatsApp and still need to ask which shoe, size, color, and budget the buyer wanted.",
      icon: "refresh"
    },
    gain: {
      title: "WhatsApp opens with useful order details",
      description: "VoluChat sends serious buyers to WhatsApp after collecting the product, size, color, and question they asked.",
      icon: "shopping-cart"
    }
  }
];
---

<section id="transformation" class="py-24 md:py-40 relative overflow-hidden">
  <!-- Background Accents -->
  <div class="absolute inset-0 pointer-events-none -z-10">
    <div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-indigo-50/40 rounded-full blur-[150px] opacity-60"></div>
    <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-purple-50/30 rounded-full blur-[150px] opacity-40"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center max-w-4xl mx-auto mb-24">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-100/50 border border-slate-200/50 backdrop-blur-md mb-8">
        <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
        <span class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-500">The problem</span>
      </div>
      <h2 class="text-5xl sm:text-7xl font-heading font-black text-slate-950 mb-10 leading-[1.05] tracking-tight">
        Instagram comments should not <br class="hidden md:block"/><span class="text-gradient-primary">turn into missed orders.</span>
      </h2>
      <p class="text-xl md:text-2xl text-slate-600 leading-relaxed font-medium max-w-3xl mx-auto">
        Most shoe stores already get interest on Reels. The hard part is replying fast and collecting the details before the buyer loses interest.
      </p>
    </div>

    <!-- Comparison Grid -->
    <div class="space-y-12">
      {comparisons.map((item) => (
        <div class="glass-panel-premium group relative rounded-[3rem] overflow-hidden transition-all duration-700 shadow-2xl hover:shadow-indigo-500/10">
          <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-100/50">
            <!-- Pain Side -->
            <div class="p-10 md:p-16 relative overflow-hidden bg-slate-50/20">
              <div class="relative z-10">
                <div class="flex items-center gap-4 mb-8">
                  <span class="text-xs font-black text-slate-400 font-heading tracking-widest">{item.id}</span>
                  <span class="px-4 py-1.5 rounded-full bg-slate-200/40 text-slate-500 text-[10px] font-black uppercase tracking-[0.2em]">Today</span>
                </div>
                
                <h3 class="text-3xl font-heading font-black text-slate-400 mb-6 line-through decoration-slate-300 tracking-tight">
                  {item.pain.title}
                </h3>
                <p class="text-slate-500 text-xl leading-relaxed font-bold">
                  {item.pain.description}
                </p>
              </div>
              
              <!-- Subtle Icon Background -->
              <div class="absolute -bottom-10 -right-10 opacity-[0.04] group-hover:opacity-[0.07] transition-all duration-700 group-hover:-translate-x-5 group-hover:-translate-y-5">
                {item.pain.icon === "clock" && <svg xmlns="http://www.w3.org/2000/svg" width="250" height="250" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
                {item.pain.icon === "users" && <svg xmlns="http://www.w3.org/2000/svg" width="250" height="250" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>}
                {item.pain.icon === "refresh" && <svg xmlns="http://www.w3.org/2000/svg" width="250" height="250" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>}
              </div>
            </div>

            <!-- Gain Side -->
            <div class="p-10 md:p-16 relative overflow-hidden transition-all duration-700 bg-white/40 group-hover:bg-indigo-50/40">
              <div class="relative z-10">
                <div class="flex items-center gap-4 mb-8">
                  <div class="w-10 h-10 rounded-2xl bg-indigo-600 flex items-center justify-center text-white shadow-xl shadow-indigo-200 group-hover:scale-110 transition-transform duration-500">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </div>
                  <span class="px-4 py-1.5 rounded-full bg-indigo-100 text-indigo-700 text-[10px] font-black uppercase tracking-[0.2em]">With VoluChat</span>
                </div>
                
                <h3 class="text-3xl font-heading font-black text-slate-950 mb-6 group-hover:text-indigo-600 transition-colors tracking-tight">
                  {item.gain.title}
                </h3>
                <p class="text-slate-600 text-xl leading-relaxed font-black tracking-tight">
                  {item.gain.description}
                </p>
              </div>

              <!-- Decorative Accent -->
              <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-100 rounded-full blur-[100px] opacity-0 group-hover:opacity-40 transition-opacity duration-1000"></div>
            </div>
          </div>
          
          <!-- Transformation Arrow Indicator (Desktop) -->
          <div class="glass-card-premium hidden lg:flex absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-16 h-16 rounded-full items-center justify-center z-20 group-hover:scale-110 group-hover:bg-slate-950 group-hover:text-white transition-all duration-700 border-2 border-white shadow-2xl">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </div>
      ))}
    </div>

    <!-- Final CTA -->
    <div class="mt-24 text-center">
      <div class="glass-panel-premium inline-flex flex-col sm:flex-row items-center gap-5 p-4 sm:p-3 sm:pr-8 rounded-[2rem] sm:rounded-full transition-all group cursor-default shadow-xl">
        <div class="w-12 h-12 rounded-full bg-slate-950 flex shrink-0 items-center justify-center text-white font-black text-lg shadow-lg">!</div>
        <p class="text-center sm:text-left text-slate-600 font-black text-sm tracking-tight">Stop missing sales from your comments. <span class="text-indigo-600">Let VoluChat handle the replies for you.</span></p>
        <a href="/contact" class="sm:ml-6 flex items-center gap-2 group/link px-6 py-2.5 bg-zinc-900 text-white rounded-full font-black text-sm transition-all hover:scale-105 hover:bg-zinc-800 shadow-lg shadow-zinc-900/20">
          Request Demo
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover/link:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Use global grid/orb styles where possible, or define local refinements */
  .sect-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, #cbd5e1 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.18;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black, transparent);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black, transparent);
  }
</style>
