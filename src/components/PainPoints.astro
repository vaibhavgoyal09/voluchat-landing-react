---
const transformations = [
  {
    title: "Instant 24/7 Response",
    frictionTitle: "Staff away = ghosted buyers",
    friction: "When staff sleeps or is busy, hot leads get no replies and purchase elsewhere.",
    flowTitle: "Replies in under 2s, 24/7",
    flow: "Every comment and message is qualified instantly, holding buyer attention.",
    icon: "clock",
    badge: "Response time"
  },
  {
    title: "AI Catalog Search",
    frictionTitle: "Manual gallery scroll",
    friction: "Staff spends minutes matching screenshots to photos, causing long buyer wait times.",
    flowTitle: "Instant visual catalog match",
    flow: "AI searches catalog in real-time, matching photos and text instantly.",
    icon: "search",
    badge: "Product discovery"
  },
  {
    title: "Structured Handoff",
    frictionTitle: "Repetitive questions",
    friction: "Hours spent manually asking for PIN code, address, and size over and over.",
    flowTitle: "1-Click brief on WhatsApp",
    flow: "Presents a pre-filled purchase card to your sales team to close payment.",
    icon: "zap",
    badge: "Sales velocity"
  }
];
---

<section id="transformation" class="relative overflow-hidden py-24 md:py-32">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-15"></div>
    <div class="absolute -right-44 top-32 h-[32rem] w-[32rem] rounded-full bg-blue-400/10 blur-3xl"></div>
    <div class="absolute -left-44 bottom-32 h-[32rem] w-[32rem] rounded-full bg-indigo-400/10 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <!-- Standardized Glowing Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50/70 px-4 py-1.5 text-xs font-black text-blue-700 shadow-sm backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-blue-600 shadow-[0_0_8px_rgba(59,130,246,0.6)]"></span>
        <span>The transformation</span>
      </div>
      <!-- Consistent Responsive Heading -->
      <h2 class="text-3xl font-heading font-black leading-[1.1] tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
        Chasing details in Instagram DMs is slowing you down.
      </h2>
      <p class="mt-6 text-lg font-semibold leading-relaxed text-slate-600 sm:text-xl">
        VoluChat automates the repetitive, manual tasks that tire your staff and cause interested buyers to ghost.
      </p>
    </div>

    <!-- Transformation Grid -->
    <div class="grid gap-8 md:grid-cols-3">
      {transformations.map((item, index) => (
        <div class="glass-card-premium relative rounded-[2rem] p-8 shadow-xl flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-4 mb-6">
              <span class="text-[10px] font-black uppercase tracking-[0.18em] text-blue-600 bg-blue-50/50 border border-blue-100/50 px-3 py-1 rounded-full">{item.badge}</span>
              <span class="text-xs font-black text-slate-300">0{index + 1}</span>
            </div>

            <!-- Icon + Title -->
            <div class="flex items-center gap-3 mb-6">
              <div class="grid h-12 w-12 place-items-center rounded-xl bg-blue-50 border border-blue-100 text-blue-600 shadow-sm shrink-0">
                {item.icon === "clock" && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
                {item.icon === "search" && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>}
                {item.icon === "zap" && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>}
              </div>
              <h3 class="font-heading text-xl font-black tracking-tight text-slate-950">{item.title}</h3>
            </div>

            <!-- Friction Box (Before / Old Way) -->
            <div class="mb-5 p-4 rounded-2xl bg-rose-50/40 border border-rose-100/50">
              <div class="flex items-center justify-between mb-3">
                <span class="text-[9px] font-black uppercase tracking-wider text-rose-500">Old Way</span>
                <span class="text-[9px] font-black uppercase tracking-wider text-rose-600 bg-rose-100/30 px-2 py-0.5 rounded-md">Friction</span>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-start gap-2 text-rose-950 text-xs font-black leading-tight">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-rose-500 shrink-0 mt-0.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  <span>{item.frictionTitle}</span>
                </div>
                <div class="text-[11px] font-medium text-rose-800/80 leading-normal pl-5.5">
                  {item.friction}
                </div>
              </div>
            </div>

            <!-- Flow Box (With VoluChat) -->
            <div class="p-4 rounded-2xl bg-emerald-50/40 border border-emerald-100/50">
              <div class="flex items-center justify-between mb-3">
                <span class="text-[9px] font-black uppercase tracking-wider text-emerald-600">VoluChat Way</span>
                <span class="text-[9px] font-black uppercase tracking-wider text-emerald-700 bg-emerald-100/30 px-2 py-0.5 rounded-md">Automated</span>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-start gap-2 text-emerald-950 text-xs font-black leading-tight">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600 shrink-0 mt-0.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{item.flowTitle}</span>
                </div>
                <div class="text-[11px] font-medium text-emerald-800/80 leading-normal pl-5.5">
                  {item.flow}
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Centered Action Box -->
    <div class="mt-16 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center gap-5 justify-center rounded-3xl sm:rounded-full border border-white/80 bg-white/50 p-4 sm:px-8 sm:py-4 shadow-xl backdrop-blur-xl w-full sm:w-auto">
        <span class="text-sm font-bold text-slate-700">Ready to transform your DM workload?</span>
        <a href="/contact" class="group inline-flex items-center justify-center gap-2 rounded-full bg-blue-600 px-6 py-3 text-sm font-black text-white shadow-xl shadow-blue-500/20 transition hover:bg-blue-700 hover:scale-[1.02] w-full sm:w-auto">
          Request a Demo
          <span class="h-2 w-2 rounded-full bg-white"></span>
        </a>
      </div>
    </div>
  </div>
</section>


