---
const comparisons = [
  {
    id: "01",
    pain: {
      title: "Drowning in DMs",
      description: "Instagram and Facebook DMs pile up while you're busy packing orders or sleeping.",
      icon: "clock"
    },
    gain: {
      title: "Instant AI Responses",
      description: "Every comment and DM is handled in under 1 second, 24/7, even while you sleep.",
      icon: "zap"
    }
  },
  {
    id: "02",
    pain: {
      title: "Losing Sales to Delay",
      description: "Buyers lose interest and buy from competitors if you don't reply in minutes.",
      icon: "users"
    },
    gain: {
      title: "80% Auto-Pilot Growth",
      description: "Our bot automatically answers 80% of pricing, sizing, and stock questions for you.",
      icon: "check-circle"
    }
  },
  {
    id: "03",
    pain: {
      title: "Repetitive Typing",
      description: "Manually typing the same prices, details, and payment instructions 100x a day.",
      icon: "refresh"
    },
    gain: {
      title: "Secure Payment Handoff",
      description: "AI handles the initial interest, then hands off hot leads to WhatsApp for secure closing.",
      icon: "shopping-cart"
    }
  }
];
---

<section id="transformation" class="py-20 md:py-32 relative overflow-hidden bg-[#fafafa]">
  <!-- Background Accents -->
  <div class="absolute inset-0 pointer-events-none -z-10">
    <div class="sect-grid opacity-10"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-gradient-to-b from-indigo-50/50 to-transparent"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <span class="section-badge mb-5">
        The Transformation
      </span>
        <h2 class="text-4xl sm:text-6xl font-heading font-bold text-slate-900 mb-6 leading-[1.1] tracking-tight">
          Why type DMs <span class="text-slate-400">manually</span> when you can <span class="text-gradient-primary">automate?</span>
        </h2>
      <p class="text-xl text-slate-600 leading-relaxed">
        Stop losing sales to slow responses. Here's how VoluChat transforms your daily grind into a seamless revenue machine.
      </p>
    </div>

    <!-- Comparison Grid -->
    <div class="space-y-8">
      {comparisons.map((item) => (
        <div class="group relative bg-white/40 backdrop-blur-sm rounded-[2.5rem] border border-slate-200/60 overflow-hidden transition-all duration-500 hover:shadow-2xl hover:shadow-indigo-500/5 hover:border-indigo-100">
          <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-100">
            <!-- Pain Side -->
            <div class="p-8 md:p-12 relative overflow-hidden bg-slate-50/30 transition-colors group-hover:bg-white/0">
              <div class="relative z-10">
                <div class="flex items-center gap-3 mb-6">
                  <span class="text-sm font-bold text-slate-400 font-heading">{item.id}</span>
                  <span class="px-3 py-1 rounded-full bg-slate-200/50 text-slate-500 text-[10px] font-bold uppercase tracking-wider">The Old Way</span>
                </div>
                
                <h3 class="text-2xl font-heading font-bold text-slate-400 mb-4 line-through decoration-slate-300">
                  {item.pain.title}
                </h3>
                <p class="text-slate-500 text-lg leading-relaxed">
                  {item.pain.description}
                </p>
              </div>
              
              <!-- Subtle Icon Background -->
              <div class="absolute bottom-[-20%] right-[-5%] opacity-[0.03] group-hover:opacity-[0.05] transition-opacity duration-500">
                {item.pain.icon === "clock" && <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
                {item.pain.icon === "users" && <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>}
                {item.pain.icon === "refresh" && <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>}
              </div>
            </div>

            <!-- Gain Side -->
            <div class="p-8 md:p-12 relative overflow-hidden transition-all duration-500 group-hover:bg-indigo-50/30">
              <div class="relative z-10">
                <div class="flex items-center gap-3 mb-6">
                  <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-white shadow-lg shadow-indigo-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </div>
                  <span class="px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 text-[10px] font-bold uppercase tracking-wider">The VoluChat Way</span>
                </div>
                
                <h3 class="text-2xl font-heading font-bold text-slate-900 mb-4 group-hover:text-indigo-600 transition-colors">
                  {item.gain.title}
                </h3>
                <p class="text-slate-600 text-lg leading-relaxed font-medium">
                  {item.gain.description}
                </p>
              </div>

              <!-- Decorative Accent -->
              <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-100 rounded-full blur-[100px] opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
            </div>
          </div>
          
          <!-- Transformation Arrow Indicator (Desktop) -->
          <div class="hidden lg:flex absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-white border border-slate-200 shadow-xl items-center justify-center z-20 group-hover:scale-110 group-hover:bg-indigo-600 group-hover:border-indigo-600 group-hover:text-white transition-all duration-500">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </div>
      ))}
    </div>

    <!-- Final CTA -->
    <div class="mt-20 text-center">
      <div class="inline-flex items-center gap-3 p-2 pr-6 bg-white rounded-full border border-slate-200 shadow-sm transition-all hover:shadow-md hover:border-slate-300 group cursor-default">
        <div class="w-10 h-10 rounded-full bg-indigo-600 flex items-center justify-center text-white font-bold">!</div>
        <p class="text-slate-600 font-medium text-sm">Most brands see a <span class="text-indigo-600 font-bold">10x faster response time</span> in just 24 hours.</p>
        <a href="https://dashboard.voluchat.com" class="ml-4 text-indigo-600 font-bold text-sm hover:underline flex items-center gap-1 group/link">
          Try it yourself
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover/link:translate-x-0.5 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Use global grid/orb styles where possible, or define local refinements */
  .sect-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, #cbd5e1 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.18;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black, transparent);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black, transparent);
  }
</style>
