---
const painPoints = [
  {
    label: "01",
    title: "Warm buyers wait too long",
    text: "A customer asks for price, size, stock, or COD. If the reply is late, they often disappear.",
  },
  {
    label: "02",
    title: "Your team repeats the same work",
    text: "The same product answers, delivery checks, and address questions get typed again and again.",
  },
  {
    label: "03",
    title: "WhatsApp handoffs start messy",
    text: "When the order details are incomplete, the final close turns into another long back-and-forth.",
  },
];

const segments = [
  "Instagram-led stores",
  "Busy launch days",
  "Variant-heavy catalogs",
  "Fashion, footwear, beauty, and lifestyle teams",
];
---

<section id="transformation" class="section-pad relative overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_18%_24%,rgba(243,247,251,0.7),transparent_30%),radial-gradient(circle_at_86%_18%,rgba(229,237,246,0.68),transparent_34%)]"></div>
  <div class="ambient-noise"></div>

  <div class="page-shell">
    <div class="grid gap-10 lg:grid-cols-[0.86fr_1.14fr] lg:items-end">
      <div class="max-w-xl reveal-on-scroll">
        <p class="section-eyebrow">The DM workload</p>
        <h2 class="section-title mt-4">
          Slow replies turn warm buyers cold.
        </h2>
        <p class="section-copy mt-5">
          Every interested buyer needs the same facts assembled quickly: product match, variant, delivery details, and the next step on WhatsApp.
        </p>
        <div class="mt-6 flex flex-wrap gap-2.5" aria-label="Store types VoluChat is built for">
          {segments.map((segment) => (
            <span class="rounded-full border border-stone-200 bg-white/72 px-3 py-1.5 text-xs font-semibold text-stone-700 shadow-sm">
              {segment}
            </span>
          ))}
        </div>
      </div>

      <div class="dark-band rounded-2xl p-5 reveal-on-scroll reveal-delay-100">
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-white/10 bg-white/[0.06] p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary-100/70">Incoming chats</p>
            <p class="mt-3 text-2xl font-semibold">Ready buyers</p>
            <p class="mt-1 text-xs font-medium text-primary-50/70">waiting for answers</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/[0.08] p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary-100/70">Repeated replies</p>
            <p class="mt-3 text-2xl font-semibold">Same details</p>
            <p class="mt-1 text-xs font-medium text-primary-50/70">every day</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/[0.12] p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary-200">WhatsApp checkout</p>
            <p class="mt-3 text-2xl font-semibold">Ready order</p>
            <p class="mt-1 text-xs font-medium text-primary-100/80">less back-and-forth</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {painPoints.map((point, index) => (
        <article class={`kinetic-card solid-card reveal-on-scroll ${index === 1 ? 'reveal-delay-100' : index === 2 ? 'reveal-delay-200' : ''}`}>
          <p class="font-mono text-xs font-semibold text-primary-700">{point.label}</p>
          <h3 class="mt-5 text-2xl font-semibold tracking-tight text-stone-950">{point.title}</h3>
          <p class="mt-4 text-sm font-medium leading-relaxed text-stone-600">{point.text}</p>
        </article>
      ))}
    </div>

  </div>
</section>
