---
const painPoints = [
  {
    label: "01",
    title: "Warm buyers wait too long",
    text: "A customer asks for price, size, stock, or COD. If the reply is late, they often disappear.",
  },
  {
    label: "02",
    title: "Your team repeats the same work",
    text: "The same product answers, delivery checks, and address questions get typed again and again.",
  },
  {
    label: "03",
    title: "WhatsApp handoffs start messy",
    text: "When the order details are incomplete, the final close turns into another long back-and-forth.",
  },
];

const segments = [
  "Instagram-led stores",
  "Busy launch days",
  "Variant-heavy catalogs",
  "Fashion, footwear, beauty, and lifestyle teams",
];
---

<section id="transformation" class="section-pad section-band relative overflow-hidden">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-stone-200 to-transparent"></div>

  <div class="page-shell">
    <div class="grid gap-10 lg:grid-cols-[0.68fr_1.32fr] lg:items-start">
      <div class="max-w-md reveal-on-scroll lg:pt-4">
        <p class="section-eyebrow">The DM workload</p>
        <h2 class="mt-4 text-[2.45rem] font-semibold leading-[1.04] text-stone-950 sm:text-[3.25rem] lg:text-[3.6rem]">
          Slow replies turn warm buyers cold.
        </h2>
        <p class="mt-5 text-base font-semibold leading-relaxed text-stone-600">
          Every interested buyer needs the same facts assembled quickly: product match, variant, delivery details, and the next step on WhatsApp.
        </p>
        <div class="mt-6 flex flex-wrap gap-2" aria-label="Store types VoluChat is built for">
          {segments.map((segment) => (
            <span class="rounded-full border border-primary-100 bg-white/70 px-3 py-1.5 text-xs font-semibold text-primary-800">
              {segment}
            </span>
          ))}
        </div>
      </div>

      <div class="reveal-on-scroll reveal-delay-100">
        <div class="overflow-hidden rounded-[1.35rem] border border-primary-900/10 bg-primary-900/92 text-white shadow-[0_24px_70px_rgba(29,43,67,0.16)]">
          <div class="grid border-b border-white/10 sm:grid-cols-3">
            <div class="px-5 py-5">
              <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-primary-100/58">Incoming chats</p>
              <p class="mt-2 text-xl font-semibold">Ready buyers</p>
              <p class="mt-1 text-sm font-medium text-primary-50/62">waiting for answers</p>
            </div>
            <div class="border-y border-white/10 px-5 py-5 sm:border-x sm:border-y-0">
              <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-primary-100/58">Repeated replies</p>
              <p class="mt-2 text-xl font-semibold">Same details</p>
              <p class="mt-1 text-sm font-medium text-primary-50/62">typed again</p>
            </div>
            <div class="px-5 py-5">
              <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-primary-100/58">WhatsApp checkout</p>
              <p class="mt-2 text-xl font-semibold">Missing context</p>
              <p class="mt-1 text-sm font-medium text-primary-50/62">before close</p>
            </div>
          </div>

          <div class="divide-y divide-white/10">
            {painPoints.map((point) => (
              <article class="grid gap-4 px-5 py-5 transition duration-300 hover:bg-white/[0.04] sm:grid-cols-[4rem_1fr] sm:px-6">
                <p class="font-mono text-xs font-semibold text-primary-200">{point.label}</p>
                <div>
                  <h3 class="text-xl font-semibold leading-tight">{point.title}</h3>
                  <p class="mt-2 max-w-2xl text-sm font-medium leading-relaxed text-primary-50/68">{point.text}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
