---
const problems = [
  { icon: "clock", text: "Missed DMs while packing orders or busy." },
  { icon: "users", text: "Customers leave if you reply late." },
  { icon: "message-square", text: "Manually sending payment details repeatedly." },
];

const solutions = [
  { text: "Instant, human-like auto-replies 24/7." },
  { text: "Smart flows that qualify & close sales." },
  { text: "Auto-send offers, stock & payment links." },
];
---

<section class="py-24 relative overflow-hidden bg-slate-50/50">
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="text-center mb-16 max-w-3xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-heading font-bold text-slate-900 mb-6">
        Transform your <span class="text-gradient-primary">sales process</span>
      </h2>
      <p class="text-xl text-slate-600 font-light">
        See the difference VoluChat makes in your daily operations.
      </p>
    </div>

    <div class="relative grid lg:grid-cols-2 gap-8 lg:gap-24 items-center">
      <!-- Central Connector (Desktop) -->
      <div class="hidden lg:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 flex-col items-center justify-center gap-2">
        <div class="w-12 h-12 rounded-full bg-white shadow-xl border border-slate-100 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </div>
      </div>

      <!-- Left: The Hard Way -->
      <div class="relative group">
        <div class="absolute inset-0 bg-red-50/50 rounded-[2.5rem] transform rotate-1 group-hover:rotate-0 transition-transform duration-500"></div>
        <div class="relative bg-white/60 backdrop-blur-md border border-red-100 rounded-[2rem] p-8 lg:p-10 shadow-sm transition-all duration-500 hover:shadow-red-100/50 hover:border-red-200">
          <div class="flex items-center gap-3 mb-8">
            <div class="p-2 bg-red-100 rounded-lg text-red-600">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-900">The Hard Way</h3>
          </div>

          <div class="space-y-6">
            {problems.map(problem => (
              <div class="flex items-start gap-4 p-4 rounded-xl bg-red-50/30 border border-red-100/50">
                <div class="text-red-500 mt-1 flex-shrink-0">
                  {problem.icon === "clock" && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
                  {problem.icon === "users" && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
                  {problem.icon === "message-square" && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>}
                </div>
                <p class="text-slate-700 font-medium">{problem.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: The VoluChat Way -->
      <div class="relative group">
        <div class="absolute inset-0 bg-indigo-50/50 rounded-[2.5rem] transform -rotate-1 group-hover:rotate-0 transition-transform duration-500"></div>
        <div class="relative bg-white/80 backdrop-blur-xl border border-indigo-100 rounded-[2rem] p-8 lg:p-10 shadow-premium transition-all duration-500 hover:shadow-premium-lg hover:-translate-y-1">
          <div class="flex items-center gap-3 mb-8">
            <div class="p-2 bg-indigo-100 rounded-lg text-indigo-600">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-900">The VoluChat Way</h3>
          </div>

          <div class="space-y-6">
            {solutions.map(solution => (
              <div class="flex items-start gap-4 p-4 rounded-xl bg-white border border-indigo-100 shadow-sm">
                <div class="w-5 h-5 rounded-full bg-indigo-100 flex items-center justify-center mt-1 flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <p class="text-slate-800 font-semibold">{solution.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
