---
const painPoints = [
  {
    label: "01",
    title: "Warm buyers need structured follow-up",
    text: "A customer asks for price, size, stock, COD, or a recommendation. If the next step is unclear, momentum drops.",
  },
  {
    label: "02",
    title: "Your team repeats high-volume sales work",
    text: "The same qualification, product answers, delivery checks, and escalation decisions happen across chats every day.",
  },
  {
    label: "03",
    title: "Handoffs start without enough context",
    text: "When buyer intent, product choices, and exceptions are incomplete, the final close turns into another long back-and-forth.",
  },
];
---

<section id="transformation" class="section-pad relative overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_18%_24%,rgba(243,247,251,0.7),transparent_30%),radial-gradient(circle_at_86%_18%,rgba(229,237,246,0.68),transparent_34%)]"></div>
  <div class="ambient-noise"></div>

  <div class="page-shell">
    <div class="grid gap-10 lg:grid-cols-[0.86fr_1.14fr] lg:items-end">
      <div class="max-w-xl reveal-on-scroll">
        <p class="section-eyebrow">The sales workflow gap</p>
        <h2 class="section-title mt-4">
          Growing teams need more than faster replies.
        </h2>
        <p class="section-copy mt-5">
          Every interested buyer needs the right workflow: qualification, product context, delivery rules, escalation logic, and a clear next step for the sales team.
        </p>
      </div>

      <div class="dark-band rounded-2xl p-5 reveal-on-scroll reveal-delay-100">
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-white/10 bg-white/[0.06] p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary-100/70">Incoming chats</p>
            <p class="mt-3 text-2xl font-semibold">Buyer intent</p>
            <p class="mt-1 text-xs font-medium text-primary-50/70">captured early</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/[0.08] p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary-100/70">Workflow rules</p>
            <p class="mt-3 text-2xl font-semibold">Team logic</p>
            <p class="mt-1 text-xs font-medium text-primary-50/70">applied consistently</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/[0.12] p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary-200">Sales handoff</p>
            <p class="mt-3 text-2xl font-semibold">Ready context</p>
            <p class="mt-1 text-xs font-medium text-primary-100/80">less back-and-forth</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {painPoints.map((point, index) => (
        <article class={`kinetic-card solid-card reveal-on-scroll ${index === 1 ? 'reveal-delay-100' : index === 2 ? 'reveal-delay-200' : ''}`}>
          <p class="font-mono text-xs font-semibold text-primary-700">{point.label}</p>
          <h3 class="mt-5 text-2xl font-semibold tracking-tight text-stone-950">{point.title}</h3>
          <p class="mt-4 text-sm font-medium leading-relaxed text-stone-600">{point.text}</p>
        </article>
      ))}
    </div>

    <div class="mt-10 flex justify-center reveal-on-scroll">
      <a href="/contact" class="btn-primary">
        Book demo call
      </a>
    </div>
  </div>
</section>
