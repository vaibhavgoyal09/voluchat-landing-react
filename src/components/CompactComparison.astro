---
const comparisonRows = [
  {
    alternative: "Generic chatbot builders",
    usualFit: "Flexible builders, broadcasts, and lots of channels.",
    voluChatFit: "DM-to-order conversations where the buyer needs product help before WhatsApp checkout.",
  },
  {
    alternative: "WhatsApp inbox tools",
    usualFit: "Shared inboxes, templates, campaigns, and follow-up.",
    voluChatFit: "Works before the handoff, while the buyer is still choosing size, shade, quantity, and delivery.",
  },
  {
    alternative: "Manual DM replies",
    usualFit: "Personal and flexible, but tiring when the same questions repeat all day.",
    voluChatFit: "Handles the repeated parts so your team spends time on confirmation, payment, and exceptions.",
  },
];
---

<section id="comparison" class="section-pad section-band-quiet relative overflow-hidden">
  <div class="page-shell relative z-10">
    <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-start">
      <div class="max-w-lg reveal-on-scroll lg:sticky lg:top-28">
        <p class="section-eyebrow">Focused by design</p>
        <h2 class="section-title mt-4">
          Not a giant chatbot builder you have to figure out.
        </h2>
        <p class="section-copy mt-5">
          VoluChat is narrower on purpose: it handles the product questions, variant capture, and delivery details that happen before your team closes on WhatsApp.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
          <a href="https://dashboard.voluchat.com/register" class="btn-primary">
            Start Free Setup
          </a>
          <a href="/compare" class="btn-secondary">
            Compare alternatives
          </a>
        </div>
      </div>

      <div class="overflow-hidden rounded-[1.5rem] border border-stone-200 bg-white/70 shadow-[0_24px_80px_rgba(28,25,23,0.08)] backdrop-blur-xl reveal-on-scroll reveal-delay-100">
        <div class="grid grid-cols-[0.9fr_1.1fr] border-b border-stone-200 bg-stone-50/80">
          <p class="px-4 py-3 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-stone-500 sm:px-5">Common default</p>
          <p class="border-l border-stone-200 px-4 py-3 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-primary-700 sm:px-5">VoluChat focus</p>
        </div>

        {comparisonRows.map((row) => (
          <article class="grid border-b border-stone-200 last:border-b-0 md:grid-cols-[0.9fr_1.1fr]">
            <div class="px-4 py-5 sm:px-5">
              <p class="font-semibold leading-snug text-stone-950">{row.alternative}</p>
              <p class="mt-3 text-sm font-medium leading-relaxed text-stone-600">{row.usualFit}</p>
            </div>

            <div class="border-t border-stone-200 bg-primary-50/72 px-4 py-5 md:border-l md:border-t-0 sm:px-5">
              <p class="text-base font-semibold leading-relaxed text-stone-950">{row.voluChatFit}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
