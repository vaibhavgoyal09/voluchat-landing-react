---
const perks = [
  {
    num: "01",
    title: "Done With You in 48 Hours",
    desc: "We connect your Instagram, WhatsApp, collection photos, and courier preferences directly with you.",
  },
  {
    num: "02",
    title: "Calibrated to Your Boutique Tone",
    desc: "Trained on your exact words, fabric details, size chart guidelines, and return rules.",
  },
  {
    num: "03",
    title: "Direct Line with Founders",
    desc: "Direct WhatsApp access with our founder to calibrate responses and guarantee smooth daily operations.",
  },
];
---

<section id="early-access" class="relative overflow-hidden py-28 sm:py-32 lg:py-36 border-t border-white/[0.08] bg-[#000000]">
  <div class="page-shell relative z-10">
    <div class="rounded-3xl border border-white/[0.08] bg-[#070709] p-8 sm:p-12 lg:p-16 relative overflow-hidden">
      <div class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr] items-center">
        <div>
          <div class="chip mb-4">
            <span class="mini-label text-emerald-400">Founding Boutique Cohort</span>
          </div>

          <h2 class="font-heading text-3xl sm:text-4xl font-bold text-white tracking-tight leading-tight">
            Join the first boutique cohort testing <span class="text-emerald-400">VoluChat</span>.
          </h2>

          <p class="mt-5 text-base text-slate-400 font-normal leading-relaxed max-w-xl">
            We work directly with forward-thinking fashion brands to automate sales, parcel tracking, and exchange operations. 100% white-glove setup.
          </p>

          <!-- 3 Perks with generous breathing room -->
          <div class="mt-10 grid gap-6 sm:grid-cols-3">
            {
              perks.map((perk) => (
                <div class="space-y-2">
                  <span class="font-mono text-xs font-bold text-emerald-400 block">{perk.num}</span>
                  <h4 class="text-sm font-semibold text-white tracking-tight">{perk.title}</h4>
                  <p class="text-xs text-slate-400 leading-relaxed">{perk.desc}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Intake Box -->
        <div class="rounded-2xl border border-white/[0.08] bg-[#0c0d12] p-8 text-center sm:text-left flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono font-semibold text-emerald-400 uppercase tracking-wider block mb-2">
              Cohort Intake
            </span>
            <h3 class="font-heading text-xl font-bold text-white mb-2">
              Ready for your first automated conversation?
            </h3>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-8">
              Lock in foundational early-access pricing with white-glove onboarding directly from our founding team.
            </p>
          </div>

          <div class="space-y-3.5">
            <a href="/free-trial" class="btn-primary !w-full justify-center text-center">
              Apply for Early Access &rarr;
            </a>
            <a
              href="https://wa.me/919530840375?text=Hi%2C%20I%27d%20like%20to%20apply%20for%20VoluChat%20early%20access."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary inline-flex !w-full items-center justify-center gap-2 text-center text-xs sm:text-sm"
            >
              💬 Chat on WhatsApp
            </a>
          </div>

          <!-- Founder Direct Commitment Anchor -->
          <div class="mt-8 pt-5 border-t border-white/[0.08] flex items-center gap-3.5">
            <img
              src="/founder_portrait.webp"
              alt="Vaibhav Goyal - Founder"
              class="h-10 w-10 rounded-full object-cover border border-white/20"
              width="40"
              height="40"
              loading="lazy"
            />
            <div class="text-left">
              <div class="text-xs font-semibold text-white">Vaibhav Goyal</div>
              <p class="text-[10px] text-slate-400 font-mono">Founder &bull; Personally onboarding each boutique</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
