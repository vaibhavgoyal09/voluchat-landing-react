---
const perks = [
  {
    num: "01",
    title: "Guided 48-Hour Setup",
    desc: "We work directly with you to connect your Instagram, WhatsApp Business API, catalog, and courier preferences without writing any code.",
    badge: "Done-With-You",
  },
  {
    num: "02",
    title: "Boutique Calibration",
    desc: "We tune the AI's vocabulary, sizing charts, fabric knowledge, and policy thresholds to match your boutique's exact tone.",
    badge: "Brand Aligned",
  },
  {
    num: "03",
    title: "Direct Founder Channel",
    desc: "Get a dedicated private WhatsApp channel directly with our founding engineers for fast feature requests and continuous monitoring.",
    badge: "Founder Support",
  },
];
---

<section id="early-access" class="relative overflow-hidden py-28 sm:py-32 lg:py-36 border-t border-white/[0.08] bg-[#050507]">
  <div class="page-shell relative z-10">
    <div class="titanium-surface rounded-3xl p-8 sm:p-12 lg:p-14 border border-emerald-500/30 bg-gradient-to-b from-emerald-950/20 via-[#0a0a0d] to-[#0a0a0d] relative overflow-hidden">
      <!-- Glow background -->
      <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>

      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] items-center">
        <div>
          <div class="chip mb-4">
            <span class="mini-label text-emerald-400">Early-Access Cohort</span>
          </div>

          <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight leading-tight">
            Join the first boutiques shaping <span class="text-emerald-400">VoluChat</span>.
          </h2>

          <p class="mt-4 text-sm sm:text-base text-slate-300 font-normal leading-relaxed">
            VoluChat is currently opening its early-access cohort for fashion and apparel boutiques. Work directly with our founding team to configure your catalog, brand voice, sizing intelligence, and post-purchase policies before opening to the public.
          </p>

          <!-- Perks Grid -->
          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            {
              perks.map((perk) => (
                <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
                  <span class="font-mono text-xs font-bold text-emerald-400 block mb-1">{perk.num}</span>
                  <h4 class="text-xs sm:text-sm font-semibold text-white tracking-tight">{perk.title}</h4>
                  <p class="text-[11px] sm:text-xs text-slate-400 mt-1 leading-relaxed">{perk.desc}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Action Box -->
        <div class="p-6 sm:p-8 rounded-2xl bg-white/[0.03] border border-white/[0.08] text-center lg:text-left flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono font-semibold text-emerald-400 uppercase tracking-wider block mb-1">
              Cohort Intake
            </span>
            <h3 class="font-heading text-xl font-bold text-white mb-2">
              Ready for your first conversation?
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed mb-6">
              Lock in foundational early-access pricing and receive white-glove onboarding directly from the founders.
            </p>
          </div>

          <div class="space-y-3">
            <a href="/free-trial" class="btn-primary !w-full justify-center text-center">
              Apply for Early Access &rarr;
            </a>
            <a
              href="https://wa.me/919530840375?text=Hi%2C%20I%27d%20like%20to%20apply%20for%20VoluChat%20early%20access."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary inline-flex !w-full items-center justify-center gap-2 text-center text-xs"
            >
              💬 Chat with Founders on WhatsApp
            </a>
          </div>

          <!-- Founder Direct Commitment Anchor -->
          <div class="mt-6 pt-4 border-t border-white/[0.08] flex items-center gap-3">
            <img
              src="/founder_portrait.webp"
              alt="Vaibhav Goyal - Founder"
              class="h-9 w-9 rounded-full object-cover border border-white/20"
              width="36"
              height="36"
              loading="lazy"
            />
            <div class="text-left">
              <div class="text-xs font-semibold text-white">Vaibhav Goyal</div>
              <p class="text-[10px] text-slate-400 font-mono">Founder &bull; Personally onboarding first stores</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
