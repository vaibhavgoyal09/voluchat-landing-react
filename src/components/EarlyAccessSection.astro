---
const perks = [
  {
    num: "01",
    title: "Done With You in 48 Hours",
    desc: "We connect your Instagram, Facebook Page, WhatsApp, collection photos, and courier preferences directly with you.",
  },
  {
    num: "02",
    title: "Calibrated to Your Boutique Tone",
    desc: "Trained on your exact words, fabric details, size chart guidelines, and return rules.",
  },
  {
    num: "03",
    title: "Direct Line with Founders",
    desc: "Direct WhatsApp access with our founder to calibrate responses and guarantee smooth daily operations.",
  },
];
---

<section id="early-access" class="relative scroll-mt-28 py-20 sm:py-24">
  <div class="page-shell relative z-10">
    <div class="relative overflow-hidden rounded-[24px] p-8 sm:p-12 lg:p-14" style="background: linear-gradient(135deg, #fff7e8 0%, #ffede0 45%, #fffdf9 100%); border: 1px solid rgba(15,23,42,0.07)">
      <div class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr] items-center">
        <div>
          <p class="section-eyebrow">Founding boutique cohort</p>

          <h2 class="mt-4 text-3xl sm:text-4xl leading-[1.1]">
            White-glove AI Sales Agent <em class="serif-accent">tuned in 48 hours</em>.
          </h2>

          <p class="mt-5 text-base text-slate-600 font-normal leading-relaxed max-w-xl">
            We connect your Instagram, Facebook Page, WhatsApp, catalog, and courier preferences directly with you. Trained on your exact words, your prices, your exchange rules. 100% white-glove setup.
          </p>

          <!-- 3 Perks with generous breathing room -->
          <div class="mt-10 grid gap-6 sm:grid-cols-3">
            {
              perks.map((perk) => (
                <div class="space-y-2">
                  <span class="font-mono text-xs font-bold text-emerald-700 block">{perk.num}</span>
                  <h4 class="text-sm font-semibold text-slate-900 tracking-tight">{perk.title}</h4>
                  <p class="text-xs text-slate-600 leading-relaxed">{perk.desc}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Intake Box -->
        <div class="rounded-2xl border border-slate-200/90 bg-slate-50/80 p-8 text-center sm:text-left flex flex-col justify-between shadow-xs">
          <div>
            <span class="text-xs font-mono font-bold text-emerald-700 uppercase tracking-wider block mb-2">
              Cohort Intake
            </span>
            <h3 class="font-heading text-xl font-bold text-slate-900 mb-2">
              Ready for your first automated conversation?
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-8">
              Lock in foundational early-access pricing with white-glove onboarding directly from our founding team.
            </p>
          </div>

          <div class="space-y-3.5">
            <a href="/free-trial" class="btn-primary !w-full justify-center text-center">
              Start My 30-Day Free Trial &rarr;
            </a>
            <a
              href="https://wa.me/918847568693?text=Hi%20Vaibhav%2C%20I%27d%20like%20to%20apply%20for%20VoluChat%20early%20access%20for%20my%20boutique."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary inline-flex !w-full items-center justify-center gap-2 text-center text-xs sm:text-sm"
            >
              Message Vaibhav on WhatsApp &rarr;
            </a>
          </div>

          <!-- Founder Direct Commitment Anchor -->
          <div class="mt-8 pt-5 border-t border-slate-200/80 flex items-center gap-3.5">
            <img
              src="/founder_portrait.webp"
              alt="Vaibhav Goyal - Founder"
              class="h-10 w-10 rounded-full object-cover border border-slate-200 shadow-2xs"
              width="40"
              height="40"
              loading="lazy"
            />
            <div class="text-left">
              <div class="text-xs font-semibold text-slate-900">Vaibhav Goyal</div>
              <p class="text-[10px] text-slate-600 font-mono font-medium">Founder &bull; Personally onboarding each boutique</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
