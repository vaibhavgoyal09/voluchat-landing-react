---
declare global {
  interface Window {
    dataLayer: unknown[];
    gtag: (...args: unknown[]) => void;
  }
}
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "";
---

<aside
  id="cookie-consent"
  class="cookie-consent fixed inset-x-3 bottom-3 z-[70] ml-auto max-w-[25rem] rounded-xl border border-white/[0.14] bg-[#0a0a0c]/95 p-4 opacity-0 shadow-2xl backdrop-blur-xl transition-all duration-300 sm:inset-x-auto sm:right-6 sm:bottom-6 sm:p-5"
  data-ga-measurement-id={gaMeasurementId}
  aria-label="Cookie consent"
  hidden
>
  <div class="flex items-start gap-3">
    <span class="cookie-mark mt-1 shrink-0" aria-hidden="true"></span>
    <div class="min-w-0">
      <h2
        class="text-base font-heading font-semibold leading-tight text-[#fcfdff]"
      >
        Analytics cookies
      </h2>
      <p class="mt-1.5 text-[13px] font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">
        Help us improve VoluChat pages. Essential cookies stay on either way.
      </p>
      <a
        href="/privacy"
        class="mt-2 inline-flex text-[13px] font-medium text-emerald-400 underline decoration-emerald-500/35 underline-offset-4 transition hover:text-emerald-300"
      >
        Privacy policy
      </a>
      <p class="mt-2 text-[11px] font-normal leading-relaxed text-slate-500">
        Scrolling this page also accepts analytics cookies.
      </p>
    </div>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-2">
    <button
      type="button"
      class="inline-flex min-h-9 items-center justify-center rounded-lg border border-white/[0.14] bg-[#101012] px-4 py-2 text-[13px] font-medium text-slate-300 transition hover:bg-white/[0.08] active:scale-[0.98]"
      data-cookie-reject
    >
      Decline
    </button>
    <button
      type="button"
      class="inline-flex min-h-9 items-center justify-center rounded-lg bg-[#fcfdff] px-4 py-2 text-[13px] font-medium text-[#000000] transition hover:bg-[#f1f7fe] active:scale-[0.98]"
      data-cookie-accept
    >
      Accept
    </button>
  </div>
</aside>

<style>
  .cookie-consent:not([hidden]):not(.is-hiding) {
    opacity: 1;
    transform: translateY(0);
  }

  .cookie-consent {
    transform: translateY(18px);
  }

  .cookie-consent.is-hiding {
    opacity: 0;
    transform: translateY(28px);
    pointer-events: none;
  }

  .cookie-mark {
    position: relative;
    display: inline-block;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background:
      radial-gradient(circle at 63% 34%, #ffffff 0 1.5px, transparent 2px),
      radial-gradient(circle at 35% 62%, #ffffff 0 1.5px, transparent 2px),
      radial-gradient(circle at 58% 74%, #ffffff 0 1px, transparent 1.5px),
      linear-gradient(135deg, #1d2b43, #536f9f);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.36),
      0 6px 14px rgba(29, 43, 67, 0.16);
  }

  .cookie-mark::after {
    content: "";
    position: absolute;
    right: -1px;
    top: -1px;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: white;
    box-shadow: -1px 5px 0 -2px white;
  }
</style>

<script>
  const CONSENT_KEY = "voluchat-cookie-consent";
  const banner = document.getElementById("cookie-consent");
  const measurementId = banner?.dataset.gaMeasurementId;
  const acceptButton = banner?.querySelector("[data-cookie-accept]");
  const rejectButton = banner?.querySelector("[data-cookie-reject]");
  const HIDE_ANIMATION_MS = 500;
  const SCROLL_ACCEPT_THRESHOLD = 80;
  let initialScrollY = 0;
  let hasScrollBaseline = false;

  const loadGoogleAnalytics = () => {
    if (
      !measurementId ||
      window.dataLayer ||
      document.querySelector(`script[src*="${measurementId}"]`)
    ) {
      return;
    }

    window.dataLayer = window.dataLayer || [];
    window.gtag =
      window.gtag ||
      function gtag() {
        window.dataLayer.push(arguments);
      };
    window.gtag("js", new Date());
    window.gtag("config", measurementId);

    const script = document.createElement("script");
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
    document.head.append(script);
  };

  const hideBanner = () => {
    if (!banner || banner.classList.contains("is-hiding")) {
      return;
    }

    banner.classList.add("is-hiding");
    window.setTimeout(() => {
      banner?.setAttribute("hidden", "");
      banner?.classList.remove("is-hiding");
    }, HIDE_ANIMATION_MS);
  };

  const acceptConsent = () => {
    localStorage.setItem(CONSENT_KEY, "accepted");
    loadGoogleAnalytics();
    hideBanner();
    window.removeEventListener("scroll", handleScrollConsent);
  };

  const handleScrollConsent = () => {
    if (!hasScrollBaseline) {
      initialScrollY = window.scrollY;
      hasScrollBaseline = true;
      return;
    }

    if (Math.abs(window.scrollY - initialScrollY) < SCROLL_ACCEPT_THRESHOLD) {
      return;
    }

    acceptConsent();
  };

  const savedConsent = localStorage.getItem(CONSENT_KEY);

  if (savedConsent === "accepted") {
    loadGoogleAnalytics();
  } else if (savedConsent !== "rejected") {
    banner?.classList.remove("is-hiding");
    banner?.removeAttribute("hidden");
    window.addEventListener("scroll", handleScrollConsent, { passive: true });
  }

  acceptButton?.addEventListener("click", acceptConsent);

  rejectButton?.addEventListener("click", () => {
    localStorage.setItem(CONSENT_KEY, "rejected");
    window.removeEventListener("scroll", handleScrollConsent);
    hideBanner();
  });
</script>
