---
import Layout from "../layouts/Layout.astro";
import Header from "./Navbar.astro";
import Footer from "./Footer.astro";
import FAQ from "./FAQ.astro";

const {
  seoTitle,
  seoDescription,
  eyebrow = "VoluChat Agents",
  title,
  description,
  heroSignal,
  heroDecision,
  heroAction,
  heroOutcome,
  painTitle,
  painCopy,
  workflow = [],
  useCases = [],
  guardrails = [],
  relatedLinks = [],
} = Astro.props;
---

<Layout title={seoTitle} description={seoDescription}>
  <Header />

  <main class="pt-20">
    <section
      class="relative isolate overflow-hidden pt-20 pb-16 sm:pt-24 lg:pb-24"
    >
      <div
        class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#07111f_0%,#0b1728_50%,#07111f_100%)]"
      >
      </div>
      <div
        class="absolute inset-x-0 top-0 -z-10 mx-auto h-[32rem] max-w-5xl bg-[radial-gradient(circle_at_50%_0%,rgba(45,212,191,0.16),transparent_58%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="agent-hero grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
          <div class="agent-hero-text opacity-0">
            <div class="chip">{eyebrow}</div>
            <h1
              class="mt-6 max-w-3xl text-4xl font-semibold leading-[1.02] text-white sm:text-6xl lg:text-7xl"
            >
              {title}
            </h1>
            <p class="section-copy mt-6 max-w-2xl">
              {description}
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/contact" class="btn-primary"
                >Map this agent to my store</a
              >
              <a href="/features" class="btn-secondary">Explore all agents</a>
            </div>
          </div>

          <div class="agent-hero-mockup relative opacity-0">
            <div
              class="absolute -inset-4 rounded-[2rem] bg-teal-300/10 blur-3xl"
            >
            </div>
            <div
              class="relative rounded-[1.75rem] border border-white/10 bg-[#0d192b]/95 p-3 shadow-[0_32px_120px_-56px_rgba(45,212,191,0.5)]"
            >
              <div
                class="rounded-[1.35rem] border border-white/10 bg-[#07111f] p-5 sm:p-6"
              >
                <div
                  class="flex items-center justify-between gap-4 border-b border-white/10 pb-5"
                >
                  <div>
                    <p class="mini-label text-teal-200">Agent workspace</p>
                    <h2 class="mt-2 text-xl font-semibold text-white">
                      Live workflow preview
                    </h2>
                  </div>
                  <span
                    class="rounded-full border border-teal-300/25 bg-teal-300/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] text-teal-100"
                    >Guarded</span
                  >
                </div>

                <div class="mt-5 space-y-3">
                  <div
                    class="rounded-2xl border border-white/10 bg-white/[0.04] p-4"
                  >
                    <p class="text-sm font-bold text-slate-200">
                      Signal detected
                    </p>
                    <p
                      class="mt-3 text-base font-semibold leading-snug text-white"
                    >
                      {heroSignal}
                    </p>
                  </div>
                  <div
                    class="rounded-2xl border border-white/10 bg-[#101b2e] p-4"
                  >
                    <p class="text-sm font-bold text-slate-200">
                      Agent decision
                    </p>
                    <p
                      class="mt-3 text-sm font-medium leading-relaxed text-slate-300"
                    >
                      {heroDecision}
                    </p>
                  </div>
                  <div class="grid gap-3 sm:grid-cols-2">
                    <div
                      class="rounded-2xl border border-teal-300/20 bg-teal-300/10 p-4"
                    >
                      <p class="text-sm font-bold text-teal-100">
                        Approved action
                      </p>
                      <p
                        class="mt-3 text-sm font-medium leading-relaxed text-slate-200"
                      >
                        {heroAction}
                      </p>
                    </div>
                    <div
                      class="rounded-2xl border border-white/10 bg-white/[0.04] p-4"
                    >
                      <p class="text-sm font-bold text-slate-200">
                        Outcome tracked
                      </p>
                      <p
                        class="mt-3 text-sm font-medium leading-relaxed text-slate-300"
                      >
                        {heroOutcome}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="agent-why-section relative border-y border-white/10 bg-[#081321] py-20 sm:py-24"
    >
      <div class="page-shell">
        <div class="grid gap-10 lg:grid-cols-[0.86fr_1.14fr] lg:items-start">
          <div class="agent-why-text opacity-0">
            <p class="section-eyebrow">Why this agent exists</p>
            <h2
              class="mt-4 max-w-xl text-3xl font-heading font-semibold leading-[1.04] text-white sm:text-5xl"
            >
              {painTitle}
            </h2>
            <p
              class="mt-5 max-w-xl text-lg font-medium leading-relaxed text-slate-300"
            >
              {painCopy}
            </p>
          </div>

          <div class="grid gap-4">
            {
              workflow.map((item, index) => (
                <article class="agent-why-card opacity-0 rounded-[1.25rem] border border-white/10 bg-white/[0.045] p-5 shadow-[0_24px_70px_-54px_rgba(0,0,0,0.95)] sm:p-6">
                  <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
                    <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-teal-300/10 font-mono text-sm font-bold text-teal-100">
                      0{index + 1}
                    </span>
                    <div>
                      <h3 class="text-xl font-semibold leading-tight text-white">
                        {item.title}
                      </h3>
                      <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                        {item.text}
                      </p>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="agent-where-section relative overflow-hidden py-20 sm:py-28">
      <div
        class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#07111f_0%,#0b1728_52%,#07111f_100%)]"
      >
      </div>
      <div class="page-shell">
        <div
          class="agent-where-text opacity-0 flex flex-col justify-between gap-6 lg:flex-row lg:items-end"
        >
          <div>
            <p class="section-eyebrow">Where it helps</p>
            <h2
              class="mt-4 max-w-2xl text-3xl font-heading font-semibold leading-[1.04] text-white sm:text-5xl"
            >
              Practical workflows, not abstract AI.
            </h2>
          </div>
          <p
            class="max-w-xl text-lg font-medium leading-relaxed text-slate-300"
          >
            The agent is scoped to repeatable commerce moments where speed,
            context, and consistency change the outcome.
          </p>
        </div>

        <div class="mt-12 grid gap-4 md:grid-cols-3">
          {
            useCases.map((item) => (
              <article class="agent-where-card opacity-0 rounded-[1.25rem] border border-white/10 bg-[#101b2e] p-6 shadow-[0_24px_70px_-54px_rgba(0,0,0,0.95)]">
                <p class="mini-label text-teal-200">{item.label}</p>
                <h3 class="mt-4 text-xl font-semibold leading-tight text-white">
                  {item.title}
                </h3>
                <p class="mt-4 text-base font-medium leading-relaxed text-slate-300">
                  {item.text}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="agent-guard-section relative pb-24">
      <div class="page-shell">
        <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
          <div
            class="agent-guard-left opacity-0 rounded-[1.75rem] border border-white/10 bg-[#0d192b] p-6 shadow-[0_32px_100px_-70px_rgba(45,212,191,0.5)] sm:p-10"
          >
            <p class="section-eyebrow">Guardrails</p>
            <h2
              class="mt-4 text-3xl font-heading font-semibold leading-[1.04] text-white sm:text-5xl"
            >
              Built to act inside your rules.
            </h2>
            <p class="mt-5 text-lg font-medium leading-relaxed text-slate-300">
              VoluChat is designed for operators who want agents to move work
              forward without giving up approval, brand safety, or margin
              discipline.
            </p>
            <div class="mt-8 grid gap-3">
              {
                guardrails.map((item) => (
                  <div class="flex gap-3 rounded-2xl border border-white/10 bg-[#101b2e] p-4">
                    <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-teal-300/10 text-teal-100">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                    </span>
                    <p class="text-base font-semibold leading-relaxed text-slate-200">
                      {item}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>

          <aside
            class="agent-guard-right opacity-0 rounded-[1.75rem] border border-white/10 bg-[#07111f] p-6 sm:p-8"
          >
            <p class="section-eyebrow">Related agents</p>
            <h2
              class="mt-4 text-2xl font-heading font-semibold leading-tight text-white"
            >
              Build the full commerce layer.
            </h2>
            <div class="mt-6 space-y-3">
              {
                relatedLinks.map((link) => (
                  <a
                    href={link.href}
                    class="group flex items-center justify-between gap-4 rounded-2xl border border-white/10 bg-white/[0.045] p-4 transition hover:border-teal-300/30 hover:bg-teal-300/10"
                  >
                    <span class="text-base font-bold text-slate-100">
                      {link.label}
                    </span>
                    <span class="text-sm font-bold text-teal-200 transition group-hover:translate-x-1">
                      Open
                    </span>
                  </a>
                ))
              }
            </div>
            <a href="/contact" class="btn-primary mt-8 w-full"
              >Discuss my agent mix</a
            >
          </aside>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // Hero
    const heroTl = gsap.timeline();
    heroTl.fromTo(".agent-hero-text",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" }
    ).fromTo(".agent-hero-mockup",
      { opacity: 0, scale: 0.95, rotateY: 10 },
      { opacity: 1, scale: 1, rotateY: 0, duration: 1, ease: "power4.out" },
      "-=0.6"
    );

    // Why section
    const whyTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".agent-why-section",
        start: "top 75%",
        toggleActions: "play none none reverse"
      }
    });
    whyTl.fromTo(".agent-why-text",
      { opacity: 0, x: -30 },
      { opacity: 1, x: 0, duration: 0.8, ease: "power2.out" }
    ).fromTo(".agent-why-card",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.6, stagger: 0.15, ease: "power2.out" },
      "-=0.5"
    );

    // Where section
    const whereTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".agent-where-section",
        start: "top 80%",
        toggleActions: "play none none reverse"
      }
    });
    whereTl.fromTo(".agent-where-text",
      { opacity: 0, scale: 0.95 },
      { opacity: 1, scale: 1, duration: 0.8, ease: "power3.out" }
    ).fromTo(".agent-where-card",
      { opacity: 0, y: 40, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 0.5, stagger: { amount: 0.4, from: "start" }, ease: "back.out(1.2)" },
      "-=0.5"
    );

    // Guardrails section
    const guardTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".agent-guard-section",
        start: "top 80%",
        toggleActions: "play none none reverse"
      }
    });
    guardTl.fromTo(".agent-guard-left",
      { opacity: 0, x: -30 },
      { opacity: 1, x: 0, duration: 0.8, ease: "power2.out" }
    ).fromTo(".agent-guard-right",
      { opacity: 0, x: 30 },
      { opacity: 1, x: 0, duration: 0.8, ease: "power2.out" },
      "-=0.6"
    );
  });
</script>
