---
// Compact Founder Credibility & Commitment Section
---

<section class="band-warm relative overflow-hidden py-20 sm:py-24 lg:py-28">
  <!-- Atmospheric glow and subtle grid pattern -->
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_75%_55%_at_50%_35%,rgba(232,220,200,0.07),transparent_70%)] pointer-events-none"></div>

  <div class="page-shell relative z-10">
    <!-- Open keynote quote — no box, centered -->
    <div class="reveal-on-scroll relative mx-auto max-w-3xl text-center">
      
      <!-- Subtle Decorative Quotation Mark -->
      <div class="pointer-events-none absolute -top-3 left-6 sm:left-8 select-none font-serif text-6xl sm:text-7xl font-bold leading-none text-slate-900/[0.04]" aria-hidden="true">
        &ldquo;
      </div>

      <!-- Credibility Hook as Section Eyebrow -->
      <div class="relative z-10 inline-flex items-center gap-2 rounded-full border border-[#e8dcc8]/25 bg-white/[0.04] px-4 py-1 text-xs font-semibold text-[#e8dcc8] mb-5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.15)] backdrop-blur-md">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full rounded-full bg-[#e8dcc8] opacity-60"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#e8dcc8]"></span>
        </span>
        <span>Why I personally handle your 48-hour setup</span>
      </div>

      <!-- Main Centerpiece Quote -->
      <blockquote class="relative z-10 mx-auto max-w-2xl">
        <p class="font-heading font-semibold leading-[1.2] tracking-[-0.03em] text-slate-900" style="font-size: clamp(1.4rem, 3vw, 1.9rem);">
          &ldquo;Boutique founders shouldn't spend nights replying &lsquo;Price?&rsquo; and chasing UPI screenshots. My commitment: <em class="serif-accent">VoluChat delivers 10x the value you pay, or we don't deserve your business.</em>&rdquo;
        </p>
      </blockquote>

      <!-- Supporting Founder Note -->
      <p class="relative z-10 mx-auto mt-5 max-w-xl text-sm sm:text-base font-normal leading-relaxed text-slate-600">
        I personally handle your catalog, Meta APIs, and brand-voice tuning during your 48-hour white-glove setup. Start free today.
      </p>

      <!-- Founder Visual Anchor & Headshot Card -->
      <div class="relative z-10 mt-6 pt-5 border-t border-slate-200 flex items-center justify-center gap-3.5">
        <!-- Styled Founder Avatar with Active Indicator -->
        <div class="relative shrink-0">
          <img
            src="/founder_portrait.webp"
            alt="Vaibhav Goyal - Founder of VoluChat"
            class="h-10 w-10 sm:h-11 sm:w-11 rounded-full object-cover border border-slate-300 shadow-[0_4px_16px_rgba(0,0,0,0.08)]"
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute bottom-0 right-0 h-2.5 w-2.5 rounded-full bg-emerald-500 ring-2 ring-[#0c0d12]"></span>
        </div>

        <!-- Name & Credibility Details -->
        <div class="text-left">
          <div class="flex items-center gap-2">
            <h4 class="font-heading text-sm font-semibold text-white">Vaibhav Goyal</h4>
            <span class="rounded-full bg-white/[0.06] border border-white/[0.12] px-2 py-0.5 text-[9px] font-mono font-medium text-[#e8dcc8]">
              Founder &amp; Engineer
            </span>
          </div>
          <p class="text-[11px] text-slate-400 font-normal">
            VoluChat &bull; QubitNine Technologies Pvt Ltd
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
