---
// Compact Founder Credibility & Commitment Section
---

<section class="relative overflow-hidden py-28 sm:py-32 lg:py-36 bg-[#000000] border-t border-white/[0.08]">
  <!-- Atmospheric glow and subtle grid pattern -->
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_75%_55%_at_50%_35%,rgba(16,185,129,0.06),transparent_70%)] pointer-events-none"></div>

  <div class="page-shell relative z-10">
    <!-- Open keynote quote — no box, centered -->
    <div class="reveal-on-scroll relative mx-auto max-w-3xl text-center">
      
      <!-- Subtle Decorative Quotation Mark -->
      <div class="pointer-events-none absolute -top-3 left-6 sm:left-8 select-none font-serif text-6xl sm:text-7xl font-bold leading-none text-white/[0.04]" aria-hidden="true">
        &ldquo;
      </div>

      <!-- Credibility Hook as Section Eyebrow -->
      <div class="relative z-10 inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-950/20 px-4 py-1 text-xs font-semibold text-emerald-300 mb-5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.15)] backdrop-blur-md">
        <span class="relative flex h-1.5 w-1.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
        </span>
        <span>Why I'm Personally Onboarding the First 10 Stores</span>
      </div>

      <!-- Main Centerpiece Quote -->
      <blockquote class="relative z-10 mx-auto max-w-2xl">
        <p class="font-heading font-semibold leading-[1.2] tracking-[-0.03em] text-[#f5f5f7]" style="font-size: clamp(1.4rem, 3vw, 1.9rem);">
          &ldquo;Boutique founders shouldn't spend nights replying &lsquo;Price?&rsquo; and chasing UPI screenshots. My commitment: <span class="text-emerald-400">VoluChat delivers 10x the value you pay, or we don't deserve your business.</span>&rdquo;
        </p>
      </blockquote>

      <!-- Supporting Founder Note -->
      <p class="relative z-10 mx-auto mt-5 max-w-xl text-sm sm:text-base font-normal leading-relaxed text-[#86868b]">
        First 10 stores get a 30-day free trial — I personally handle your catalog, Meta APIs, and brand-voice tuning.
      </p>

      <!-- Founder Visual Anchor & Headshot Card -->
      <div class="relative z-10 mt-6 pt-5 border-t border-white/[0.08] flex items-center justify-center gap-3.5">
        <!-- Styled Founder Avatar with Active Indicator -->
        <div class="relative shrink-0">
          <img
            src="/founder_portrait.webp"
            alt="Vaibhav Goyal - Founder of VoluChat"
            class="h-10 w-10 sm:h-11 sm:w-11 rounded-full object-cover border border-white/20 shadow-[0_4px_16px_rgba(0,0,0,0.5)]"
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute bottom-0 right-0 h-2.5 w-2.5 rounded-full bg-emerald-500 ring-2 ring-[#0c0d12]"></span>
        </div>

        <!-- Name & Credibility Details -->
        <div class="text-left">
          <div class="flex items-center gap-2">
            <h4 class="font-heading text-sm font-semibold text-white">Vaibhav Goyal</h4>
            <span class="rounded-full bg-white/[0.06] border border-white/[0.12] px-2 py-0.5 text-[9px] font-mono font-medium text-emerald-300">
              Founder &amp; Engineer
            </span>
          </div>
          <p class="text-[11px] text-slate-400 font-normal">
            VoluChat &bull; QubitNine Technologies Pvt Ltd
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
