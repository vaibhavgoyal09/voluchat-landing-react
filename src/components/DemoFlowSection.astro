---
const steps = [
  "Customer message",
  "VoluChat detects the issue",
  "AI recommends an action",
  "Team approves",
  "Shopify/customer update happens",
];
---

<section
  id="demo-flow"
  class="relative overflow-hidden bg-[#07111f] py-24 sm:py-32"
>
  <div class="page-shell">
    <!-- Stacked Header (Compliant with split-header ban) -->
    <div class="max-w-3xl reveal-on-scroll">
      <div class="chip mb-6">
        <span class="mini-label">Operating loop</span>
      </div>
      <h2 class="section-title text-white">
        From store signal to approved action
      </h2>
      <p
        class="mt-6 max-w-2xl text-lg font-medium leading-relaxed text-slate-300"
      >
        VoluChat does not blindly automate sensitive actions. It recommends the next step, explains why, and lets your team approve before anything important happens.
      </p>
    </div>

    <!-- Process Flow Cards -->
    <div class="mt-16 border-y border-white/10 py-10 relative">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {
          steps.map((step, index) => (
            <div class="reveal-on-scroll group relative rounded-2xl border border-white/5 bg-white/[0.015] p-6 hover:bg-[#101b2b]/40 hover:border-teal-500/20 transition-all duration-300 shadow-[0_16px_50px_-40px_rgba(0,0,0,0.8)]">
              <div class="flex items-center justify-between gap-3 mb-5">
                <span class="font-mono text-xs font-semibold text-teal-400">
                  0{index + 1}
                </span>
                {index < steps.length - 1 && (
                  <span class="hidden lg:block absolute top-[2.25rem] -right-3.5 z-20 text-slate-600 font-bold group-hover:text-teal-400 transition-colors">
                    &rarr;
                  </span>
                )}
              </div>
              <p class="text-base font-semibold leading-snug text-white group-hover:text-teal-100 transition-colors font-heading">
                {step}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-[1fr_auto] lg:items-center">
      <p class="max-w-2xl text-base font-medium leading-relaxed text-slate-400">
        Example outcome: a saved cart without giving an agent open-ended
        permission to discount or message customers freely.
      </p>
      <a href="/contact" class="btn-secondary lg:justify-self-end"
        >Book Demo</a
      >
    </div>
  </div>
</section>
