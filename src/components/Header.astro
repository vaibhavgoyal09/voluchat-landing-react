---
const companyLinks = [
  { title: "About Us", href: "/about" },
  { title: "Proof", href: "/#testimonials" },
  { title: "Blog", href: "/blog" },
];

---

<header id="main-header" class="fixed top-3 left-0 right-0 z-50 px-3 transition-all duration-500 sm:px-6">
  <nav id="nav-container" class="mx-auto flex items-center justify-between rounded-2xl border border-white/70 bg-stone-50/84 px-3 py-3 shadow-premium backdrop-blur-2xl max-w-6xl sm:px-6 md:px-8">
    <div class="flex items-center gap-10">
      <a href="/" class="flex items-center gap-2.5 group hover:opacity-90 transition-opacity">
        <div class="relative w-9 h-9">
          <img src="/voluchat_logo.svg" alt="VoluChat" class="w-full h-full object-contain" />
        </div>
        <span class="font-heading text-2xl font-semibold text-stone-950 hidden md:inline">
          VoluChat
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-2">
        <a href="/features" class="relative h-10 inline-flex items-center px-4 text-[13px] font-semibold text-stone-600 hover:text-stone-950 transition-all group/nav">
          <span>Features</span>
          <span class="absolute bottom-1 left-4 right-4 h-[2px] bg-primary-600 scale-x-0 group-hover/nav:scale-x-100 origin-center transition-transform duration-300 ease-out"></span>
        </a>
        <a href="/pricing" class="relative h-10 inline-flex items-center px-4 text-[13px] font-semibold text-stone-600 hover:text-stone-950 transition-all group/nav">
          <span>Pricing</span>
          <span class="absolute bottom-1 left-4 right-4 h-[2px] bg-primary-600 scale-x-0 group-hover/nav:scale-x-100 origin-center transition-transform duration-300 ease-out"></span>
        </a>
        <a href="/compare" class="relative h-10 inline-flex items-center px-4 text-[13px] font-semibold text-stone-600 hover:text-stone-950 transition-all group/nav">
          <span>Compare</span>
          <span class="absolute bottom-1 left-4 right-4 h-[2px] bg-primary-600 scale-x-0 group-hover/nav:scale-x-100 origin-center transition-transform duration-300 ease-out"></span>
        </a>
        <a href="/about" class="relative h-10 inline-flex items-center px-4 text-[13px] font-semibold text-stone-600 hover:text-stone-950 transition-all group/nav">
          <span>About</span>
          <span class="absolute bottom-1 left-4 right-4 h-[2px] bg-primary-600 scale-x-0 group-hover/nav:scale-x-100 origin-center transition-transform duration-300 ease-out"></span>
        </a>
        <a href="/blog" class="relative h-10 inline-flex items-center px-4 text-[13px] font-semibold text-stone-600 hover:text-stone-950 transition-all group/nav">
          <span>Blog</span>
          <span class="absolute bottom-1 left-4 right-4 h-[2px] bg-primary-600 scale-x-0 group-hover/nav:scale-x-100 origin-center transition-transform duration-300 ease-out"></span>
        </a>
      </div>
    </div>

    <!-- Right Side Actions -->
    <div class="hidden md:flex items-center gap-4">
      <a href="/contact" class="group relative flex items-center justify-center gap-2 rounded-xl bg-stone-950 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-stone-900/15 transition-all duration-300 hover:-translate-y-0.5 hover:bg-primary-700 overflow-hidden">
        <span class="relative z-10">Start 14-day free trial</span>
        <span class="h-1.5 w-1.5 rounded-full bg-primary-300 group-hover:bg-white transition-colors duration-300"></span>
      </a>
    </div>

    <!-- Mobile Actions -->
    <div class="flex items-center gap-3 lg:hidden">
      <a href="/contact" class="rounded-xl bg-stone-950 px-5 py-2.5 text-xs font-semibold text-white shadow-md transition-all hover:bg-primary-700">
        <span class="hidden min-[390px]:inline">Free Trial</span>
        <span class="min-[390px]:hidden">Trial</span>
      </a>
      
      <!-- Mobile Menu Toggle -->
      <button id="mobile-menu-toggle" class="p-2.5 rounded-xl bg-white border border-stone-200/80 hover:bg-stone-50 transition-all shadow-sm cursor-pointer" aria-label="Toggle Menu">
        <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-stone-950">
          <line x1="4" x2="20" y1="12" y2="12" class="line-1 transition-all duration-300"></line>
          <line x1="4" x2="20" y1="6" y2="6" class="line-2 transition-all duration-300"></line>
          <line x1="4" x2="20" y1="18" y2="18" class="line-3 transition-all duration-300"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Backdrop -->
  <div id="mobile-menu-backdrop" class="fixed inset-0 bg-stone-950/40 backdrop-blur-md lg:hidden -z-10"></div>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-x-6 top-28 p-8 z-40 bg-stone-50/95 backdrop-blur-2xl border border-stone-200/80 rounded-3xl lg:hidden shadow-[0_40px_100px_-20px_rgba(68,64,60,0.18)]">
    <div class="flex flex-col gap-6">
      <div class="text-[10px] font-semibold text-stone-400 uppercase tracking-[0.18em]">Navigation</div>
      <div class="grid grid-cols-2 gap-4">
        <a href="/features" class="text-lg font-semibold text-stone-950 p-4 bg-white/70 hover:bg-white/95 rounded-2xl border border-stone-200/50 transition-all shadow-sm">Features</a>
        <a href="/pricing" class="text-lg font-semibold text-stone-950 p-4 bg-white/70 hover:bg-white/95 rounded-2xl border border-stone-200/50 transition-all shadow-sm">Pricing</a>
        <a href="/compare" class="text-lg font-semibold text-stone-950 p-4 bg-white/70 hover:bg-white/95 rounded-2xl border border-stone-200/50 transition-all shadow-sm">Compare</a>
        <a href="/about" class="text-lg font-semibold text-stone-950 p-4 bg-white/70 hover:bg-white/95 rounded-2xl border border-stone-200/50 transition-all shadow-sm">About</a>
        <a href="/contact" class="text-lg font-semibold text-stone-950 p-4 bg-white/70 hover:bg-white/95 rounded-2xl border border-stone-200/50 transition-all shadow-sm">Contact</a>
      </div>
      
      <div class="h-px bg-stone-100"></div>
      
      <div class="flex flex-col gap-4">
        <a href="/contact" class="w-full py-4 bg-stone-950 text-white rounded-xl text-center font-semibold text-base shadow-2xl shadow-stone-900/15 hover:bg-primary-700 transition-all">Start 14-day free trial</a>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <a href="mailto:support@voluchat.com" class="flex flex-col items-center justify-center gap-2 p-4 rounded-2xl bg-primary-50 border border-primary-100 group hover:bg-primary-100/50 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary-700"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span class="text-[10px] font-semibold text-primary-800 uppercase tracking-widest">Email Support</span>
        </a>
        <a href="tel:+918847568693" class="flex flex-col items-center justify-center gap-2 p-4 rounded-2xl bg-emerald-50 border border-emerald-100 group hover:bg-emerald-100/50 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span class="text-[10px] font-semibold text-emerald-700 uppercase tracking-widest">Call Support</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  #mobile-menu {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-20px) scale(0.95);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
  }

  #mobile-menu-backdrop {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
  }

  .mobile-menu-open #menu-icon .line-1 { transform: translateY(6px) rotate(45deg); }
  .mobile-menu-open #menu-icon .line-2 { opacity: 0; transform: scaleX(0); }
  .mobile-menu-open #menu-icon .line-3 { transform: translateY(-6px) rotate(-45deg); }
  
  #mobile-menu.mobile-menu-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  #mobile-menu-backdrop.mobile-menu-active {
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  // Scroll Logic
  const header = document.getElementById('main-header');
  const navContainer = document.getElementById('nav-container');
  
  window.addEventListener('scroll', () => {
    if (!header || !navContainer) return;
    if (window.scrollY > 20) {
      header.classList.add('top-2');
      header.classList.remove('top-3');
      navContainer.classList.add('max-w-5xl', 'shadow-premium');
      navContainer.classList.remove('max-w-6xl');
    } else {
      header.classList.add('top-3');
      header.classList.remove('top-2');
      navContainer.classList.add('max-w-6xl');
      navContainer.classList.remove('max-w-5xl', 'shadow-premium');
    }
  });

  // Mobile Menu Logic
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const body = document.body;

  toggle?.addEventListener('click', () => {
    if (!menu || !toggle || !backdrop) return;
    const isOpen = menu.classList.contains('mobile-menu-active');
    
    if (isOpen) {
      menu.classList.remove('mobile-menu-active');
      backdrop.classList.remove('mobile-menu-active');
      toggle.classList.remove('mobile-menu-open');
      body.style.overflow = '';
    } else {
      menu.classList.add('mobile-menu-active');
      backdrop.classList.add('mobile-menu-active');
      toggle.classList.add('mobile-menu-open');
      body.style.overflow = 'hidden';
    }
  });

  // Close menu on backdrop click
  backdrop?.addEventListener('click', () => {
    if (!menu || !toggle || !backdrop) return;
    menu.classList.remove('mobile-menu-active');
    backdrop.classList.remove('mobile-menu-active');
    toggle.classList.remove('mobile-menu-open');
    body.style.overflow = '';
  });

  // Close menu on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (!menu || !toggle || !backdrop) return;
      menu.classList.remove('mobile-menu-active');
      backdrop.classList.remove('mobile-menu-active');
      toggle.classList.remove('mobile-menu-open');
      body.style.overflow = '';
    });
  });
</script>
