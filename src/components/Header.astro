---
const companyLinks = [
  { title: "About Us", href: "/about" },
  { title: "Testimonials", href: "/#testimonials" },
  { title: "Blog", href: "/blog" },
];
---

<header id="main-header" class="fixed top-6 left-0 right-0 z-50 transition-all duration-500 px-6">
  <nav id="nav-container" class="mx-auto flex items-center justify-between px-8 py-4 rounded-3xl transition-all duration-500 glass-panel-premium max-w-5xl shadow-2xl shadow-slate-200/50">
    <div class="flex items-center gap-10">
      <a href="/" class="flex items-center gap-2.5 group hover:opacity-90 transition-opacity">
        <div class="relative w-9 h-9">
          <img src="/voluchat_logo.svg" alt="VoluChat" class="w-full h-full object-contain" />
        </div>
        <span class="font-heading font-black text-2xl text-slate-950 tracking-tighter hidden md:inline">
          VoluChat
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-2">
        <a href="/features" class="h-10 inline-flex items-center px-5 text-[13px] font-bold text-slate-600 hover:text-slate-950 uppercase tracking-widest hover:bg-slate-50 rounded-xl transition-all">Features</a>
        <a href="/pricing" class="h-10 inline-flex items-center px-5 text-[13px] font-bold text-slate-600 hover:text-slate-950 uppercase tracking-widest hover:bg-slate-50 rounded-xl transition-all">Pricing</a>
        <a href="/about" class="h-10 inline-flex items-center px-5 text-[13px] font-bold text-slate-600 hover:text-slate-950 uppercase tracking-widest hover:bg-slate-50 rounded-xl transition-all">About</a>
        <a href="/blog" class="h-10 inline-flex items-center px-5 text-[13px] font-bold text-slate-600 hover:text-slate-950 uppercase tracking-widest hover:bg-slate-50 rounded-xl transition-all">Blog</a>
      </div>
    </div>

    <!-- Right Side Actions -->
    <div class="hidden md:flex items-center gap-4">

      <a href="/contact" class="group relative flex items-center justify-center gap-2 px-7 py-2.5 bg-blue-600 text-white rounded-full font-black text-sm transition-all duration-300 hover:scale-[1.05] hover:bg-blue-700 shadow-xl shadow-blue-500/20 overflow-hidden">
        <span class="relative z-10">Request Demo</span>
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
      </a>
    </div>

    <!-- Mobile Actions -->
    <div class="flex items-center gap-3 lg:hidden">
      <a href="/contact" class="px-5 py-2.5 bg-blue-600 text-white rounded-full text-xs font-black uppercase tracking-widest shadow-lg shadow-blue-500/20 hover:bg-blue-700 transition-all">
        Request Demo
      </a>
      
      <!-- Mobile Menu Toggle -->
      <button id="mobile-menu-toggle" class="p-2.5 rounded-xl bg-slate-50 border border-slate-100 hover:bg-white transition-all shadow-sm" aria-label="Toggle Menu">
        <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-slate-950">
          <line x1="4" x2="20" y1="12" y2="12" class="line-1 transition-all duration-300"></line>
          <line x1="4" x2="20" y1="6" y2="6" class="line-2 transition-all duration-300"></line>
          <line x1="4" x2="20" y1="18" y2="18" class="line-3 transition-all duration-300"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-x-6 top-28 p-8 z-40 glass-panel-premium rounded-[2.5rem] lg:hidden opacity-0 invisible translate-y-8 transition-all duration-500 shadow-[0_40px_100px_-20px_rgba(0,0,0,0.15)]">
    <div class="flex flex-col gap-6">
      <div class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Navigation</div>
      <div class="grid grid-cols-2 gap-4">
        <a href="/features" class="text-lg font-black text-slate-950 p-4 bg-slate-50/50 rounded-2xl border border-slate-100">Features</a>
        <a href="/pricing" class="text-lg font-black text-slate-950 p-4 bg-slate-50/50 rounded-2xl border border-slate-100">Pricing</a>
        <a href="/about" class="text-lg font-black text-slate-950 p-4 bg-slate-50/50 rounded-2xl border border-slate-100">About</a>
        <a href="/contact" class="text-lg font-black text-slate-950 p-4 bg-slate-50/50 rounded-2xl border border-slate-100">Contact</a>
      </div>
      
      <div class="h-px bg-slate-100"></div>
      
      <div class="flex flex-col gap-4">

        <a href="/contact" class="w-full py-4 bg-blue-600 text-white rounded-full text-center font-black text-base shadow-2xl shadow-blue-500/20 hover:bg-blue-700 transition-all">Request Demo</a>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <a href="mailto:support@voluchat.com" class="flex flex-col items-center justify-center gap-2 p-4 rounded-2xl bg-indigo-50 border border-indigo-100 group">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span class="text-[10px] font-black text-indigo-700 uppercase tracking-widest">Email Support</span>
        </a>
        <a href="tel:+918847568693" class="flex flex-col items-center justify-center gap-2 p-4 rounded-2xl bg-emerald-50 border border-emerald-100 group">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span class="text-[10px] font-black text-emerald-700 uppercase tracking-widest">Call Support</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .mobile-menu-open #menu-icon .line-1 { transform: translateY(6px) rotate(45deg); }
  .mobile-menu-open #menu-icon .line-2 { opacity: 0; transform: scaleX(0); }
  .mobile-menu-open #menu-icon .line-3 { transform: translateY(-6px) rotate(-45deg); }
  
  .mobile-menu-active { opacity: 1 !important; visibility: visible !important; transform: translateY(0) !important; }
</style>

<script>
  // Scroll Logic
  const header = document.getElementById('main-header');
  const navContainer = document.getElementById('nav-container');
  
  window.addEventListener('scroll', () => {
    if (!header || !navContainer) return;
    if (window.scrollY > 20) {
      header.classList.add('top-2');
      header.classList.remove('top-4');
      navContainer.classList.add('max-w-6xl', 'shadow-premium');
      navContainer.classList.remove('max-w-5xl');
    } else {
      header.classList.add('top-4');
      header.classList.remove('top-2');
      navContainer.classList.add('max-w-5xl');
      navContainer.classList.remove('max-w-6xl', 'shadow-premium');
    }
  });

  // Mobile Menu Logic
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const body = document.body;

  toggle?.addEventListener('click', () => {
    if (!menu || !toggle) return;
    const isOpen = menu.classList.contains('mobile-menu-active');
    
    if (isOpen) {
      menu.classList.remove('mobile-menu-active');
      toggle.classList.remove('mobile-menu-open');
      body.style.overflow = '';
    } else {
      menu.classList.add('mobile-menu-active');
      toggle.classList.add('mobile-menu-open');
      body.style.overflow = 'hidden';
    }
  });

  // Close menu on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (!menu || !toggle) return;
      menu.classList.remove('mobile-menu-active');
      toggle.classList.remove('mobile-menu-open');
      body.style.overflow = '';
    });
  });
</script>
