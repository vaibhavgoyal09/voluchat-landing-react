---
const navItems = [
  { title: "Features", href: "/features" },
  { title: "Pricing", href: "/pricing" },
  { title: "Compare", href: "/compare" },
  { title: "About", href: "/about" },
  { title: "Blog", href: "/blog" },
];
---

<header class="fixed inset-x-0 top-3 z-50 px-2.5 sm:px-6">
  <nav class="mx-auto flex h-16 w-[calc(100%-0.25rem)] max-w-[24.25rem] items-center justify-between rounded-2xl border border-stone-200 bg-white px-3.5 shadow-[0_14px_44px_rgba(68,64,60,0.10)] sm:h-[68px] sm:w-full sm:max-w-6xl sm:px-5">
    <a href="/" class="flex items-center gap-2.5 rounded-xl pr-2 transition hover:opacity-85">
      <img src="/voluchat_logo.svg" alt="VoluChat" class="h-9 w-9 object-contain sm:h-8 sm:w-8" width="36" height="36" />
      <span class="hidden font-heading text-xl font-semibold text-stone-950 md:inline">VoluChat</span>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {navItems.map((item) => (
        <a href={item.href} class="rounded-xl px-3.5 py-2 text-[13px] font-semibold text-stone-600 transition hover:bg-white/70 hover:text-stone-950">
          {item.title}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <a href="/contact" class="btn-primary px-4 py-3 text-[13px] sm:px-4 sm:text-sm md:px-5 md:py-3">
        <span class="sm:hidden">Book demo</span>
        <span class="hidden sm:inline">Book demo call</span>
      </a>

      <button id="mobile-menu-toggle" class="grid h-11 w-11 place-items-center rounded-full border border-white/85 bg-white/82 text-stone-950 shadow-[0_8px_22px_rgba(68,64,60,0.10)] transition hover:bg-white lg:hidden" aria-label="Toggle menu" aria-expanded="false">
        <span class="menu-line menu-line-a"></span>
        <span class="menu-line menu-line-b"></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu-backdrop" class="fixed inset-0 -z-10 bg-stone-950/35 backdrop-blur-sm lg:hidden"></div>

  <div id="mobile-menu" class="fixed left-1/2 top-20 z-40 w-[calc(100%-2.5rem)] max-w-[22rem] rounded-2xl border border-stone-200 bg-white p-5 shadow-[0_32px_90px_rgba(68,64,60,0.18)] sm:top-24 lg:hidden">
    <div class="grid gap-2">
      {navItems.map((item) => (
        <a href={item.href} class="rounded-xl border border-stone-200/70 bg-white/68 px-4 py-3 text-base font-semibold text-stone-950 transition hover:bg-white">
          {item.title}
        </a>
      ))}
      <a href="/contact" class="btn-primary mt-2 w-full">
        Book demo call
      </a>
    </div>
  </div>
</header>

<style>
  .menu-line {
    display: block;
    grid-area: 1 / 1;
    height: 1.5px;
    width: 17px;
    border-radius: 999px;
    background: currentColor;
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-line-a {
    transform: translateY(-3.5px);
  }

  .menu-line-b {
    transform: translateY(3.5px);
  }

  #mobile-menu,
  #mobile-menu-backdrop {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.28s ease, transform 0.28s ease, visibility 0.28s ease;
  }

  #mobile-menu {
    transform: translateX(-50%) translateY(-12px) scale(0.98);
  }

  #mobile-menu.mobile-menu-active,
  #mobile-menu-backdrop.mobile-menu-active {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  #mobile-menu-backdrop.mobile-menu-active {
    transform: none;
  }

  .mobile-menu-open .menu-line-a {
    transform: translateY(0) rotate(45deg);
  }

  .mobile-menu-open .menu-line-b {
    transform: translateY(0) rotate(-45deg);
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const body = document.body;

  const closeMenu = () => {
    menu?.classList.remove('mobile-menu-active');
    backdrop?.classList.remove('mobile-menu-active');
    toggle?.classList.remove('mobile-menu-open');
    toggle?.setAttribute('aria-expanded', 'false');
    body.style.overflow = '';
  };

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('mobile-menu-active');
    if (isOpen) {
      closeMenu();
      return;
    }

    menu?.classList.add('mobile-menu-active');
    backdrop?.classList.add('mobile-menu-active');
    toggle.classList.add('mobile-menu-open');
    toggle.setAttribute('aria-expanded', 'true');
    body.style.overflow = 'hidden';
  });

  backdrop?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
</script>
