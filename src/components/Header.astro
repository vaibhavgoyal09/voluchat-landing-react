---
const navItems = [
  { title: "Features", href: "/features" },
  { title: "Pricing", href: "/pricing" },
  { title: "Compare", href: "/compare" },
  { title: "About", href: "/about" },
  { title: "Blog", href: "/blog" },
];
---

<header class="fixed inset-x-0 top-3 z-50 px-3 sm:px-6">
  <nav class="mx-auto flex h-[68px] max-w-6xl items-center justify-between rounded-2xl border border-white/75 bg-stone-50/86 px-3 shadow-[0_18px_60px_rgba(68,64,60,0.11)] backdrop-blur-2xl sm:px-5">
    <a href="/" class="flex items-center gap-2.5 rounded-xl pr-2 transition hover:opacity-85">
      <img src="/voluchat_logo.svg" alt="VoluChat" class="h-8 w-8 object-contain" />
      <span class="hidden font-heading text-xl font-semibold text-stone-950 md:inline">VoluChat</span>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {navItems.map((item) => (
        <a href={item.href} class="rounded-xl px-3.5 py-2 text-[13px] font-semibold text-stone-600 transition hover:bg-white/70 hover:text-stone-950">
          {item.title}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <a href="/contact" class="btn-primary hidden px-5 py-3 md:inline-flex">
        Start 14-day free trial
      </a>

      <button id="mobile-menu-toggle" class="grid h-11 w-11 place-items-center rounded-xl border border-stone-200/80 bg-white/80 text-stone-950 shadow-sm transition hover:bg-white lg:hidden" aria-label="Toggle menu" aria-expanded="false">
        <span class="menu-line menu-line-a"></span>
        <span class="menu-line menu-line-b"></span>
        <span class="menu-line menu-line-c"></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu-backdrop" class="fixed inset-0 -z-10 bg-stone-950/35 backdrop-blur-sm lg:hidden"></div>

  <div id="mobile-menu" class="fixed inset-x-4 top-24 z-40 rounded-2xl border border-white/75 bg-stone-50/96 p-5 shadow-[0_32px_90px_rgba(68,64,60,0.2)] backdrop-blur-2xl lg:hidden">
    <div class="grid gap-2">
      {navItems.map((item) => (
        <a href={item.href} class="rounded-xl border border-stone-200/70 bg-white/68 px-4 py-3 text-base font-semibold text-stone-950 transition hover:bg-white">
          {item.title}
        </a>
      ))}
      <a href="/contact" class="btn-primary mt-2 w-full">
        Start 14-day free trial
      </a>
    </div>
  </div>
</header>

<style>
  .menu-line {
    display: block;
    height: 2px;
    width: 18px;
    border-radius: 999px;
    background: currentColor;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  #mobile-menu,
  #mobile-menu-backdrop {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.28s ease, transform 0.28s ease, visibility 0.28s ease;
  }

  #mobile-menu {
    transform: translateY(-12px) scale(0.98);
  }

  #mobile-menu.mobile-menu-active,
  #mobile-menu-backdrop.mobile-menu-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .mobile-menu-open .menu-line-a {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu-open .menu-line-b {
    opacity: 0;
  }

  .mobile-menu-open .menu-line-c {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const body = document.body;

  const closeMenu = () => {
    menu?.classList.remove('mobile-menu-active');
    backdrop?.classList.remove('mobile-menu-active');
    toggle?.classList.remove('mobile-menu-open');
    toggle?.setAttribute('aria-expanded', 'false');
    body.style.overflow = '';
  };

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('mobile-menu-active');
    if (isOpen) {
      closeMenu();
      return;
    }

    menu?.classList.add('mobile-menu-active');
    backdrop?.classList.add('mobile-menu-active');
    toggle.classList.add('mobile-menu-open');
    toggle.setAttribute('aria-expanded', 'true');
    body.style.overflow = 'hidden';
  });

  backdrop?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
</script>
