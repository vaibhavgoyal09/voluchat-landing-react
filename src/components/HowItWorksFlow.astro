---
const steps = [
  {
    num: "01",
    label: "Instagram, WhatsApp & Storefront",
    title: "Customer Inquiry",
    detail: "Shopper asks 'Price?' on your Reel at 11 PM, sends a voice note on WhatsApp, or visits your website widget.",
    badge: "Multi-Channel",
    badgeColor: "text-pink-400 bg-pink-500/10 border-pink-500/20",
  },
  {
    num: "02",
    label: "Auto DM (2s)",
    title: "Instant AI Response",
    detail: "Public reply boosts algorithmic reach + private DM with exact sizes and prices.",
    badge: "2s Latency",
    badgeColor: "text-emerald-400 bg-emerald-500/10 border-emerald-500/20",
  },
  {
    num: "03",
    label: "Official WhatsApp",
    title: "Fit & Sizing Qualification",
    detail: "Answers fabric doubts ('Pure cotton?'), checks live stock, and confirms sizing.",
    badge: "AI Stylist",
    badgeColor: "text-teal-400 bg-teal-500/10 border-teal-500/20",
  },
  {
    num: "04",
    label: "1-Click UPI",
    title: "Native In-Chat Checkout",
    detail: "1-click UPI link generated. Payment verified and order saved in under 90 seconds.",
    badge: "Closed Sale",
    badgeColor: "text-emerald-300 bg-emerald-500/15 border-emerald-500/30",
  },
];
---

<section id="how-it-works" class="relative overflow-hidden py-20 sm:py-24 border-t border-white/[0.08] bg-[#06060a]">
  <div class="page-shell relative z-10">
    <div class="mb-14 max-w-2xl">
      <div class="chip mb-4">
        <span class="mini-label text-emerald-400">The 90-Second Loop</span>
      </div>
      <h2 class="section-title text-[#fcfdff] font-heading">
        How an Instagram comment turns into a <span class="text-emerald-400">paid order in 90 seconds</span>.
      </h2>
      <p class="section-copy mt-3">
        Zero flowchart menus. No sending shoppers to slow website links.
      </p>
    </div>

    <!-- Connected Pipeline Timeline Track -->
    <div class="relative rounded-2xl border border-white/[0.10] bg-[#0a0a0c] p-6 sm:p-8 lg:p-10 overflow-hidden">
      <!-- Horizontal connector track line across desktop -->
      <div class="hidden lg:block absolute top-[4.5rem] left-12 right-12 h-px bg-gradient-to-r from-pink-500/40 via-emerald-500/40 to-emerald-400/60 z-0"></div>

      <div class="grid gap-8 lg:grid-cols-4 relative z-10">
        {
          steps.map((step, idx) => (
            <div class={`reveal-on-scroll reveal-delay-${idx + 1} flex flex-col justify-between group`}>
              <div>
                <!-- Step Indicator Circle -->
                <div class="flex items-center gap-3 mb-6">
                  <div class="h-10 w-10 rounded-full border border-white/[0.14] bg-[#101012] flex items-center justify-center font-mono text-xs font-bold text-white group-hover:border-emerald-400 group-hover:text-emerald-300 transition-all shadow-lg">
                    {step.num}
                  </div>
                  <span class={`lg:hidden rounded-full border px-2 py-0.5 text-[9px] font-mono uppercase font-medium ${step.badgeColor}`}>
                    {step.badge}
                  </span>
                </div>

                <div class="space-y-1.5">
                  <span class="text-[10px] uppercase font-mono tracking-wider text-emerald-400 font-bold block">
                    {step.label}
                  </span>
                  <h3 class="font-heading text-lg font-bold text-white group-hover:text-emerald-300 transition-colors">
                    {step.title}
                  </h3>
                  <p class="text-xs text-[rgba(252,253,255,0.7)] font-normal leading-relaxed pt-1">
                    {step.detail}
                  </p>
                </div>
              </div>

              <div class="mt-6 pt-3 border-t border-white/[0.06] flex items-center justify-between">
                <span class={`hidden lg:inline-block rounded-full border px-2.5 py-0.5 text-[9px] font-mono uppercase font-medium ${step.badgeColor}`}>
                  {step.badge}
                </span>
                <span class="text-[11px] font-mono text-slate-500">
                  {idx < 3 ? "Next Stage →" : "✓ Settled"}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
