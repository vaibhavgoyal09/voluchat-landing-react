---
const jobs = [
  {
    num: "01",
    label: "Selling & Sizing",
    title: "Sell & Close",
    detail: "Turns casual 'Price?' comments and DMs into completed orders with size guidance and direct 1-click UPI links.",
    badge: "Revenue",
  },
  {
    num: "02",
    label: "Courier Updates",
    title: "Track Parcels",
    detail: "Answers 'Where is my parcel?' instantly by fetching live status directly from Delhivery, Shiprocket, or your courier.",
    badge: "Fulfillment",
  },
  {
    num: "03",
    label: "Policy & Exchanges",
    title: "Resolve Exchanges",
    detail: "Handles routine exchange requests by verifying your 7-day policy, collecting tag photos, and creating tickets.",
    badge: "Operations",
  },
  {
    num: "04",
    label: "Store & Care FAQs",
    title: "24/7 Support",
    detail: "Answers questions on pure fabrics, lining, wash care, boutique timings, and shipping timelines in your tone.",
    badge: "Support",
  },
];
---

<section id="how-it-works" class="relative overflow-hidden py-28 sm:py-32 lg:py-36 border-t border-white/[0.08] bg-[#000000]">
  <div class="page-shell relative z-10">
    <div class="mb-16 lg:mb-20 max-w-3xl">
      <div class="chip mb-4">
        <span class="mini-label text-emerald-400">Core Scope of Work</span>
      </div>
      <h2 class="section-title font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
        4 Jobs. <span class="text-emerald-400">One AI Employee</span>.
      </h2>
      <p class="section-copy mt-5 text-base sm:text-lg text-slate-400 font-normal leading-relaxed">
        What work does your AI Employee actually execute every single day? Four core daily store jobs running autonomously under your exact business rules.
      </p>
    </div>

    <!-- 4 Clean Modular Cards with Generous Spacing -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 items-stretch">
      {
        jobs.map((job, idx) => (
          <div class={`reveal-on-scroll reveal-delay-${idx + 1} rounded-3xl border border-white/[0.08] bg-[#070709] p-7 sm:p-8 flex flex-col justify-between hover:border-white/[0.18] transition-all duration-300 group`}>
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="font-mono text-xs font-bold text-emerald-400">
                  {job.num}
                </span>
                <span class="rounded-full border border-white/[0.10] bg-white/[0.04] px-2.5 py-0.5 text-[10px] font-mono text-slate-400">
                  {job.badge}
                </span>
              </div>

              <span class="text-[11px] uppercase font-mono tracking-wider text-slate-400 font-semibold block mb-1">
                {job.label}
              </span>
              <h3 class="font-heading text-xl font-bold text-white group-hover:text-emerald-300 transition-colors">
                {job.title}
              </h3>
              <p class="text-sm text-slate-400 font-normal leading-relaxed mt-3">
                {job.detail}
              </p>
            </div>

            <div class="mt-8 pt-4 border-t border-white/[0.06] flex items-center justify-between text-[11px] font-mono text-slate-400">
              <span>Job 0{idx + 1}</span>
              <span class="text-emerald-400 font-medium group-hover:translate-x-1 transition-transform">Active 24/7 &rarr;</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
