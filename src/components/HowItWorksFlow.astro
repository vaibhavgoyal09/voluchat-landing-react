---
const jobs = [
  {
    num: "01",
    title: "Sell & close",
    detail: "'Price?' comments and DMs become paid orders — size guidance plus 1-click UPI link in chat.",
    meta: "2.0s avg reply",
  },
  {
    num: "02",
    title: "Track parcels",
    detail: "'Where is my parcel?' answered instantly from Delhivery / Shiprocket live status.",
    meta: "100% automated",
  },
  {
    num: "03",
    title: "Resolve exchanges",
    detail: "7-day policy checked, tag photo collected, exchange ticket created — no staff needed.",
    meta: "Zero friction",
  },
  {
    num: "04",
    title: "24/7 support",
    detail: "Fabrics, lining, wash care, timings, shipping — answered in your boutique's tone.",
    meta: "Instant answers",
  },
];
---

<section id="how-it-works" class="relative scroll-mt-28 py-20 sm:py-24">
  <div class="page-shell relative z-10">
    <div class="mx-auto max-w-2xl text-center">
      <p class="section-eyebrow">Core scope of work</p>
      <h2 class="mt-4 text-4xl sm:text-5xl leading-[1.05]">
        4 daily jobs. <em class="serif-accent">One autonomous engine</em>.
      </h2>
      <p class="section-copy mt-5">
        Four boutique operations running every day under your exact guidelines.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-6xl gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        jobs.map((job) => (
          <div class="border-t-2 border-slate-900/[0.1] pt-6">
            <p class="font-accent text-5xl italic text-slate-300" style="font-family: var(--font-accent)">{job.num}</p>
            <h3 class="mt-3 text-lg">{job.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{job.detail}</p>
            <p class="mt-3 font-mono text-[11px] font-bold uppercase tracking-wider text-emerald-700">
              {job.meta}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
