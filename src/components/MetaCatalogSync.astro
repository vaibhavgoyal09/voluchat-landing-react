---
---

<section id="catalog-sync" class="relative overflow-hidden py-28 md:py-36">
  <!-- Glowing Background Orbs -->
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-15"></div>
    <div class="absolute -left-44 top-1/4 h-[36rem] w-[36rem] rounded-full bg-blue-300/10 blur-3xl"></div>
    <div class="absolute right-12 bottom-24 h-[36rem] w-[36rem] rounded-full bg-indigo-300/15 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-7xl px-6">
    <div class="grid gap-12 lg:grid-cols-12 items-center">
      
      <!-- Left side: Text descriptions and key highlights -->
      <div class="lg:col-span-5 space-y-8 reveal-on-scroll">
        <!-- Glowing Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-indigo-100 bg-indigo-50/70 px-4 py-1.5 text-xs font-black text-indigo-700 shadow-sm backdrop-blur-md">
          <span class="h-2 w-2 rounded-full bg-indigo-600 shadow-[0_0_8px_rgba(99,102,241,0.6)] animate-pulse"></span>
          <span>1-Click Catalog Integration</span>
        </div>

        <h2 class="text-3xl font-heading font-black leading-[1.1] tracking-tight text-slate-950 sm:text-5xl">
          Natively synced with your <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">Meta Catalog</span>.
        </h2>
        
        <p class="text-lg font-semibold leading-relaxed text-slate-600">
          VoluChat connects directly and securely with your existing **Meta Business Manager Catalog** (the exact same one you already use for Instagram Shopping). No plugins, no Shopify setups, and no WooCommerce configuration headaches required.
        </p>

        <div class="space-y-4">
          <!-- Benefit 1 -->
          <div class="flex gap-4">
            <div class="w-6 h-6 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600 shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 text-sm">Real-time Stock & Price Checks</h4>
              <p class="text-xs text-slate-500 mt-1">We read variant prices, custom sizes, stock counts, and sneaker images directly from Meta, ensuring customers never buy out-of-stock sizes.</p>
            </div>
          </div>

          <!-- Benefit 2 -->
          <div class="flex gap-4">
            <div class="w-6 h-6 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600 shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 text-sm">Zero Catalog Double-Entry</h4>
              <p class="text-xs text-slate-500 mt-1">If you update a price or add a new shoe in Meta Business Suite, VoluChat reflects it in your DM responses instantly.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right side: Breathtaking visual mockup of Meta catalog dashboard sync -->
      <div class="lg:col-span-7 reveal-on-scroll reveal-delay-100">
        <div class="bg-slate-950 rounded-[2rem] p-6 md:p-8 shadow-2xl relative border border-slate-800 text-slate-200">
          
          <!-- Mac-like Header -->
          <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-6">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
              <span class="text-[10px] text-slate-500 ml-4 font-sans font-bold uppercase tracking-wider">Catalog Integration Panel</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)] animate-pulse"></span>
              <span class="text-[9px] font-black tracking-wider text-emerald-400 uppercase font-mono">Meta API Active</span>
            </div>
          </div>

          <div class="space-y-6">
            <!-- Connection Card -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col md:flex-row items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <!-- Meta Logo Placeholder -->
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-purple-600 p-0.5 flex items-center justify-center">
                  <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center p-1.5">
                    <span class="font-heading font-black text-sm text-white">M</span>
                  </div>
                </div>
                <div>
                  <div class="text-xs font-black text-white">Meta Catalog Manager</div>
                  <div class="text-[10px] text-slate-500 mt-0.5">ID: 827103849502910</div>
                </div>
              </div>
              
              <div class="flex items-center gap-2 bg-indigo-950/40 border border-indigo-900/50 px-3 py-1.5 rounded-full">
                <span class="text-[10px] font-bold text-indigo-300">Live Syncing</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3 text-indigo-400 animate-spin">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
              </div>
            </div>

            <!-- Synced Products List Mockup -->
            <div class="space-y-3">
              <div class="text-[9px] font-black uppercase tracking-wider text-slate-500 font-sans">Synced products inventory</div>
              
              <!-- Product 1 -->
              <div class="flex items-center justify-between gap-4 bg-slate-900/40 border border-slate-800/60 p-3 rounded-xl hover:scale-[1.01] hover:border-indigo-500/20 transition-all duration-300">
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 object-contain bg-white border border-slate-100 rounded-lg shrink-0 flex items-center justify-center p-1 text-slate-950 font-bold text-xs">👟</div>
                  <div>
                    <div class="text-xs font-black text-slate-100">Air Force Retro</div>
                    <div class="text-[10px] text-slate-500 mt-0.5">8 sizes • 3 colors • Rs. 8,000</div>
                  </div>
                </div>
                <span class="text-[10px] font-black text-emerald-400 bg-emerald-950/30 px-2 py-0.5 rounded-full border border-emerald-900/30">In Stock</span>
              </div>

              <!-- Product 2 -->
              <div class="flex items-center justify-between gap-4 bg-slate-900/40 border border-slate-800/60 p-3 rounded-xl hover:scale-[1.01] hover:border-indigo-500/20 transition-all duration-300">
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 object-contain bg-white border border-slate-100 rounded-lg shrink-0 flex items-center justify-center p-1 text-slate-950 font-bold text-xs">👟</div>
                  <div>
                    <div class="text-xs font-black text-slate-100">White Runner Classic</div>
                    <div class="text-[10px] text-slate-500 mt-0.5">6 sizes • 2 colors • Rs. 10,000</div>
                  </div>
                </div>
                <span class="text-[10px] font-black text-emerald-400 bg-emerald-950/30 px-2 py-0.5 rounded-full border border-emerald-900/30">In Stock</span>
              </div>

              <!-- Product 3 -->
              <div class="flex items-center justify-between gap-4 bg-slate-900/40 border border-slate-800/60 p-3 rounded-xl hover:scale-[1.01] hover:border-indigo-500/20 transition-all duration-300">
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 object-contain bg-white border border-slate-100 rounded-lg shrink-0 flex items-center justify-center p-1 text-slate-950 font-bold text-xs">👟</div>
                  <div>
                    <div class="text-xs font-black text-slate-100">Black Trainer Pro</div>
                    <div class="text-[10px] text-slate-500 mt-0.5">4 sizes • 1 color • Rs. 11,000</div>
                  </div>
                </div>
                <span class="text-[10px] font-black text-amber-400 bg-amber-950/30 px-2 py-0.5 rounded-full border border-amber-900/30">Low Stock</span>
              </div>
            </div>

            <!-- Sync Log Terminal -->
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-3.5 font-mono text-[9px] text-slate-400 space-y-1 shadow-inner">
              <div class="flex items-center justify-between text-slate-500 border-b border-slate-800 pb-1.5 mb-1.5">
                <span>SYSTEM LOGS</span>
                <span>UTC-5</span>
              </div>
              <div class="flex gap-2">
                <span class="text-indigo-400">[info]</span>
                <span>Connecting to Meta Graph Catalog node...</span>
              </div>
              <div class="flex gap-2">
                <span class="text-emerald-400">[ok]</span>
                <span>Meta credentials authorized securely. Scopes match.</span>
              </div>
              <div class="flex gap-2">
                <span class="text-indigo-400">[sync]</span>
                <span>Synced 156 product catalog items with 1,248 variant records in 0.82s</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
