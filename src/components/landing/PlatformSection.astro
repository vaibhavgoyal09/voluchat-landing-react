---
const layers = [
  {
    code: "01",
    title: "Customer context",
    text: "Cart activity, previous orders, questions, preferences, and lifecycle stage in one operating context.",
    tag: "Buyer signal"
  },
  {
    code: "02",
    title: "Catalog awareness",
    text: "Live Shopify products, variants, stock, pricing, eligibility, and policy constraints before the agent answers.",
    tag: "Store truth"
  },
  {
    code: "03",
    title: "Agent reasoning",
    text: "Product guidance, recovery timing, upsell fit, clearance logic, and handoff decisions happen against your rules.",
    tag: "Decision layer"
  },
  {
    code: "04",
    title: "Action history",
    text: "Every recommendation, approval, sent message, and attributed outcome is logged for operators to review.",
    tag: "Control plane"
  }
];
---

<section id="platform" class="relative overflow-hidden border-y border-white/10 bg-[#0a1726] py-24 sm:py-32">
  <div class="sect-grid"></div>
  
  <div class="page-shell relative z-10">
    <div class="max-w-3xl">
      <span class="section-eyebrow">The Platform</span>
      <h2 class="section-title mt-4 text-white">One intelligence layer for commerce operations.</h2>
      <p class="section-copy mt-6 max-w-2xl text-slate-300">
        VoluChat brings your entire storefront ecosystem together. Our platform acts as a unified operator, aligning customer data with catalog logic to drive real commerce outcomes.
      </p>
    </div>

    <div class="mt-14 grid gap-4 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="rounded-[1.5rem] border border-white/10 bg-[#101f31] p-5 sm:p-7">
        <div class="grid gap-3 sm:grid-cols-2">
          {layers.map((layer) => (
            <article class="kinetic-card rounded-2xl border border-white/10 bg-[#0b1726] p-5">
              <div class="flex items-center justify-between gap-4">
                <span class="font-mono text-xs font-semibold text-slate-500">{layer.code}</span>
                <span class="text-[11px] font-bold uppercase tracking-[0.16em] text-teal-200">{layer.tag}</span>
              </div>
              <h3 class="mt-8 text-xl font-semibold leading-tight text-white">{layer.title}</h3>
              <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">{layer.text}</p>
            </article>
          ))}
        </div>
      </div>

      <aside class="rounded-[1.5rem] border border-white/10 bg-[#142437] p-7">
        <p class="mini-label text-slate-400">Operator view</p>
        <div class="mt-8 space-y-5">
          <div>
            <p class="text-sm font-semibold text-slate-400">Revenue signal</p>
            <p class="mt-2 text-2xl font-semibold text-white">High-intent cart left behind</p>
          </div>
          <div class="h-px bg-white/10"></div>
          <div>
            <p class="text-sm font-semibold text-slate-400">Recommended agent</p>
            <p class="mt-2 text-2xl font-semibold text-white">Cart Recovery</p>
          </div>
          <div class="rounded-2xl bg-teal-300/10 p-4">
            <p class="text-sm font-semibold leading-relaxed text-teal-100">Approval required because the recovery offer touches margin rules.</p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
