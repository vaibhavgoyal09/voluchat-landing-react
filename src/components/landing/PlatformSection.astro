---
---

<section id="platform" class="relative overflow-hidden py-20 sm:py-24">
  <div class="sect-grid"></div>
  <div class="sect-orb absolute top-1/3 left-10 h-[300px] w-[300px] bg-teal-500/10 opacity-30"></div>
  
  <div class="page-shell relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <span class="section-eyebrow text-teal-300 font-bold uppercase tracking-wider text-xs">The Platform</span>
      <h2 class="section-title mt-4 text-white">One intelligence layer for commerce operations.</h2>
      <p class="section-copy mt-6 text-slate-300">
        VoluChat brings your entire storefront ecosystem together. Our platform acts as a unified operator, aligning customer data with catalog logic to drive real commerce outcomes.
      </p>
    </div>

    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      
      <!-- Card 1 -->
      <div class="surface kinetic-card rounded-2xl p-6 flex flex-col justify-between bg-[#121c2d] border border-[rgba(148,163,184,0.18)]">
        <div>
          <div class="h-12 w-12 rounded-xl bg-[#1e293b] flex items-center justify-center text-teal-300 border border-[rgba(148,163,184,0.18)] font-bold text-xl shadow-sm">
            👥
          </div>
          <h3 class="font-heading text-lg font-semibold text-white mt-6">Customer Intelligence</h3>
          <p class="text-sm text-slate-300 mt-3 leading-relaxed">
            Track customer behavior, purchase history, cart activity, questions, preferences, and lifecycle stage. Build deep profiles of every buyer automatically.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[rgba(148,163,184,0.18)] text-xs font-bold text-teal-400 uppercase tracking-wider">
          Real-time behavior context
        </div>
      </div>

      <!-- Card 2 -->
      <div class="surface kinetic-card rounded-2xl p-6 flex flex-col justify-between bg-[#121c2d] border border-[rgba(148,163,184,0.18)]">
        <div>
          <div class="h-12 w-12 rounded-xl bg-[#1e293b] flex items-center justify-center text-teal-300 border border-[rgba(148,163,184,0.18)] font-bold text-xl shadow-sm">
            📦
          </div>
          <h3 class="font-heading text-lg font-semibold text-white mt-6">Product & Inventory Awareness</h3>
          <p class="text-sm text-slate-300 mt-3 leading-relaxed">
            Recommend only relevant, available, margin-safe products. Fully integrated with your Shopify catalog, variant stock levels, and real-time inventory signals.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[rgba(148,163,184,0.18)] text-xs font-bold text-teal-400 uppercase tracking-wider">
          No stock-out recommendations
        </div>
      </div>

      <!-- Card 3 -->
      <div class="surface kinetic-card rounded-2xl p-6 flex flex-col justify-between bg-[#121c2d] border border-[rgba(148,163,184,0.18)]">
        <div>
          <div class="h-12 w-12 rounded-xl bg-[#1e293b] flex items-center justify-center text-teal-300 border border-[rgba(148,163,184,0.18)] font-bold text-xl shadow-sm">
            💬
          </div>
          <h3 class="font-heading text-lg font-semibold text-white mt-6">AI Conversation Engine</h3>
          <p class="text-sm text-slate-300 mt-3 leading-relaxed">
            Answer complex customer support questions, guide detailed product discovery, compare products, address buyer hesitation, and assist throughout checkout.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[rgba(148,163,184,0.18)] text-xs font-bold text-teal-400 uppercase tracking-wider">
          Beyond standard FAQ macros
        </div>
      </div>

      <!-- Card 4 -->
      <div class="surface kinetic-card rounded-2xl p-6 flex flex-col justify-between bg-[#121c2d] border border-[rgba(148,163,184,0.18)]">
        <div>
          <div class="h-12 w-12 rounded-xl bg-[#1e293b] flex items-center justify-center text-teal-300 border border-[rgba(148,163,184,0.18)] font-bold text-xl shadow-sm">
            ⚡
          </div>
          <h3 class="font-heading text-lg font-semibold text-white mt-6">Action Automation</h3>
          <p class="text-sm text-slate-300 mt-3 leading-relaxed">
            Generate micro-segments, campaigns, customized offers, support macros, smart upsell flows, recurring reorder alerts, and old stock-clearance campaigns.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[rgba(148,163,184,0.18)] text-xs font-bold text-teal-400 uppercase tracking-wider">
          Auto-executed ecommerce plays
        </div>
      </div>

    </div>
  </div>
</section>
