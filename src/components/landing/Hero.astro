---
---

<section id="hero" class="relative isolate overflow-hidden pt-[7.5rem] pb-24 sm:pt-[8.5rem] lg:pt-[9.5rem] lg:pb-32">
  <div class="sect-grid opacity-45"></div>
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"></div>
  
  <div class="page-shell relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      
      <!-- Copy Block -->
      <div class="text-center lg:text-left">
        <div class="reveal-on-scroll inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.045] px-4 py-1.5 text-xs font-bold text-slate-200">
          <span class="h-1.5 w-1.5 rounded-full bg-teal-300"></span>
          AI Commerce Operations for Shopify
        </div>

        <h1 class="reveal-on-scroll reveal-delay-100 mt-6 text-[2.85rem] font-bold leading-[1.02] tracking-tight text-white sm:text-[3.4rem] lg:text-[4rem] xl:text-[4.65rem]">
          Running an online business was never meant to be a <span class="text-slate-300">headache.</span>
        </h1>

        <p class="reveal-on-scroll reveal-delay-200 mt-6 max-w-xl text-base font-medium leading-relaxed text-slate-200 sm:text-lg lg:max-w-2xl">
          VoluChat gives growing Shopify stores AI agents that handle repetitive commerce operations — from product questions and cart recovery to upsells, follow-ups, and revenue leak detection.
        </p>

        <div class="reveal-on-scroll reveal-delay-200 mt-8 flex flex-col gap-3.5 sm:flex-row sm:justify-center lg:justify-start">
          <a href="#demo" class="btn-primary">
            Book a Demo
          </a>
          <a href="#demo-flow" class="btn-secondary">
            See How It Works
          </a>
        </div>
      </div>

      <!-- Hero Visual -->
      <div class="reveal-on-scroll reveal-delay-100 lg:hero-stage">
        <div class="relative rounded-[1.75rem] border border-white/10 bg-white/[0.035] p-2 shadow-[0_40px_110px_-76px_rgba(0,0,0,0.95)]">
        <div class="relative rounded-[1.25rem] border border-white/10 bg-[#0b1625] p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]">
          <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-5">
            <div class="flex items-center gap-2.5">
              <span class="h-2 w-2 rounded-full bg-teal-300"></span>
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-300">VoluChat Core Loop</span>
            </div>
            <span class="rounded-md border border-white/10 bg-white/[0.045] px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-300">Live trace</span>
          </div>

          <div class="space-y-4">
            
            <!-- Step 1 & 2 -->
            <div class="flex items-start gap-4 rounded-xl border border-white/10 bg-white/[0.035] p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.045)] kinetic-card">
              <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg border border-white/10 bg-[#101b2b] font-mono text-xs font-bold text-slate-300">01</div>
              <div class="space-y-3 w-full">
                <div>
                  <div class="text-[10px] font-bold text-slate-300 uppercase tracking-wider">01. Customer Question</div>
                  <div class="text-sm font-bold text-white mt-0.5">"Do you have running shoes in size 10?"</div>
                </div>
                <div class="border-t border-white/5 pt-3">
                  <div class="text-[10px] font-bold text-slate-300 uppercase tracking-wider">02. Product Recommendation</div>
                  <div class="text-sm font-bold text-white mt-0.5">"Yes! The Aero Runners are in stock in size 10."</div>
                </div>
              </div>
            </div>

            <!-- Step 3 & 4 -->
            <div class="relative flex items-start gap-4 overflow-hidden rounded-xl border border-white/10 bg-white/[0.035] p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.045)] kinetic-card">
              <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg border border-white/10 bg-[#101b2b] font-mono text-xs font-bold text-slate-300">02</div>
              <div class="space-y-3 w-full relative z-10">
                <div>
                  <div class="text-[10px] font-bold text-amber-300 uppercase tracking-wider">03. Cart abandoned</div>
                  <div class="text-sm font-bold text-white mt-0.5">Rs. 9,600 cart left behind at checkout.</div>
                </div>
                <div class="border-t border-white/5 pt-3">
                  <div class="text-[10px] font-bold text-amber-300 uppercase tracking-wider">04. Recovery message drafted</div>
                  <div class="text-xs font-semibold text-slate-200 mt-0.5 bg-[#07111f] p-2 rounded border border-white/10">"Still interested in the Aero Runners? Your size is still available."</div>
                </div>
              </div>
            </div>

            <!-- Step 5 & 6 -->
            <div class="flex items-center justify-between rounded-xl border border-white/10 bg-[#07111f] p-4 text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.045)] kinetic-card">
              <div class="flex items-center gap-3">
                <span class="flex h-7 w-7 items-center justify-center rounded-full border border-teal-300/25 bg-teal-300/10 font-mono text-[10px] font-bold text-teal-100">05</span>
                <div>
                  <div class="text-[10px] font-bold text-primary-300 uppercase tracking-wider">05. Approval pending</div>
                  <div class="text-sm font-bold">Review 10% discount offer</div>
                </div>
              </div>
              <button class="rounded-lg bg-white px-4 py-2 text-xs font-bold text-slate-950 transition-all hover:bg-slate-200">
                Approve
              </button>
            </div>

            <!-- Step 7 & 8 -->
            <div class="grid grid-cols-2 gap-3 rounded-xl border border-white/10 bg-white/[0.035] p-4 text-center shadow-[inset_0_1px_0_rgba(255,255,255,0.045)] kinetic-card">
              <div class="rounded-lg border border-white/10 bg-[#07111f] p-3">
                <div class="text-[10px] font-bold text-slate-300 uppercase">06. Campaign export ready</div>
                <div class="text-sm font-extrabold text-white mt-1">Synced to campaigns</div>
              </div>
              <div class="relative overflow-hidden rounded-lg border border-teal-300/20 bg-teal-300/10 p-3">
                <div class="text-[10px] font-bold text-emerald-400 uppercase relative z-10">07. Outcome tracked</div>
                <div class="text-sm font-extrabold text-emerald-400 mt-1 relative z-10">+Rs. 8,640 Recovered</div>
              </div>
            </div>

          </div>
        </div>
        </div>
      </div>
    </div>
  </div>
</section>
