---
---

<section id="hero" class="relative isolate overflow-hidden pt-[7.5rem] pb-24 sm:pt-[8.5rem] lg:pt-[9.5rem] lg:pb-32">
  <div class="sect-grid opacity-45"></div>
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"></div>
  
  <!-- Neural Automation/Robotics Background Diagram -->
  <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none select-none opacity-30">
    <svg class="absolute left-1/2 top-1/2 h-[900px] w-[1400px] -translate-x-1/2 -translate-y-1/2 fill-none" viewBox="0 0 1400 900" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="neural-glow-1" cx="30%" cy="40%" r="35%">
          <stop offset="0%" stop-color="#2dd4bf" stop-opacity="0.2" />
          <stop offset="100%" stop-color="#2dd4bf" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="neural-glow-2" cx="70%" cy="50%" r="40%">
          <stop offset="0%" stop-color="#0d9488" stop-opacity="0.15" />
          <stop offset="100%" stop-color="#0d9488" stop-opacity="0" />
        </radialGradient>
      </defs>
      
      <!-- Ambient Glow Orbs -->
      <rect width="1400" height="900" fill="url(#neural-glow-1)" />
      <rect width="1400" height="900" fill="url(#neural-glow-2)" />
      
      <!-- Stylized Robotic Face Profile Outline -->
      <path d="M 640 160 Q 540 180 520 280 L 480 340 L 520 360 Q 500 400 520 420 L 500 450 L 540 480 Q 540 540 600 560 L 620 680" stroke="#2dd4bf" stroke-opacity="0.35" stroke-width="2" />
            
      <!-- Back of Head / Brain Boundary -->
      <path d="M 640 160 Q 780 140 850 250 T 830 460 Q 760 520 600 560" stroke="#2dd4bf" stroke-opacity="0.2" stroke-width="1.5" stroke-dasharray="5 5" />

      <!-- Spine / Central Nervous System Circuit -->
      <path d="M 620 680 L 620 850" stroke="#2dd4bf" stroke-opacity="0.25" stroke-width="3" />
      <path d="M 620 720 L 580 760 L 450 760" stroke="#2dd4bf" stroke-opacity="0.15" stroke-width="1.5" stroke-dasharray="3 3" />
      <path d="M 620 770 L 660 810 L 780 810" stroke="#2dd4bf" stroke-opacity="0.15" stroke-width="1.5" />
      
      <!-- Artificial Brain Neural Network Connections -->
      <g stroke="#2dd4bf" stroke-opacity="0.3" stroke-width="1">
        <!-- Frontal Lobe Connections -->
        <line x1="620" y1="240" x2="680" y2="210" />
        <line x1="620" y1="240" x2="650" y2="290" />
        <line x1="680" y1="210" x2="740" y2="230" />
        <line x1="650" y1="290" x2="740" y2="230" />
        
        <!-- Parietal & Motor Cortex Connections -->
        <line x1="740" y1="230" x2="780" y2="200" />
        <line x1="740" y1="230" x2="770" y2="290" />
        <line x1="780" y1="200" x2="840" y2="240" />
        
        <!-- Occipital Lobe Connections -->
        <line x1="840" y1="240" x2="860" y2="330" />
        <line x1="840" y1="240" x2="800" y2="340" />
        <line x1="860" y1="330" x2="820" y2="420" />
        
        <!-- Temporal & Sensory Connections -->
        <line x1="650" y1="290" x2="710" y2="340" />
        <line x1="770" y1="290" x2="710" y2="340" />
        <line x1="770" y1="290" x2="800" y2="340" />
        <line x1="710" y1="340" x2="670" y2="400" />
        <line x1="710" y1="340" x2="750" y2="410" />
        <line x1="800" y1="340" x2="750" y2="410" />
        <line x1="800" y1="340" x2="820" y2="420" />
        
        <!-- Cerebellum & Brain Stem Connections -->
        <line x1="750" y1="410" x2="780" y2="480" />
        <line x1="820" y1="420" x2="780" y2="480" />
        <line x1="670" y1="400" x2="750" y2="410" />
        <line x1="780" y1="480" x2="620" y2="520" />
        <line x1="620" y1="520" x2="620" y2="680" stroke-width="2" stroke-opacity="0.4" />
      </g>

      <!-- Robotic Face Inner Circuits -->
      <g stroke="#2dd4bf" stroke-opacity="0.25" stroke-width="1.5">
        <!-- Robotic Eye Slot -->
        <path d="M 540 310 L 590 310 L 610 330 L 560 330 Z" fill="#2dd4bf" fill-opacity="0.1" />
        <circle cx="585" cy="320" r="3" fill="#2dd4bf" />
        <circle cx="585" cy="320" r="8" stroke="#2dd4bf" stroke-opacity="0.5" stroke-width="1" class="animate-pulse" />
        
        <!-- Cheek circuit board pattern -->
        <path d="M 570 380 L 610 380 L 630 410" />
        <path d="M 590 440 L 630 440" />
      </g>

      <!-- Brain Nodes / Synapses -->
      <g fill="#0d192b" stroke="#2dd4bf" stroke-width="2">
        <circle cx="620" cy="240" r="4.5" />
        <circle cx="680" cy="210" r="4.5" />
        <circle cx="650" cy="290" r="4.5" />
        <circle cx="740" cy="230" r="5" stroke="#2dd4bf" stroke-width="2.5" />
        <circle cx="740" cy="230" r="12" stroke="#2dd4bf" stroke-opacity="0.4" stroke-width="1" class="animate-pulse" />
        
        <circle cx="780" cy="200" r="4.5" />
        <circle cx="770" cy="290" r="4.5" />
        <circle cx="840" cy="240" r="5" />
        <circle cx="860" cy="330" r="5" />
        <circle cx="800" cy="340" r="5" />
        <circle cx="710" cy="340" r="4.5" />
        
        <circle cx="670" cy="400" r="5.5" stroke="#2dd4bf" stroke-width="2.5" />
        <circle cx="670" cy="400" r="14" stroke="#2dd4bf" stroke-opacity="0.4" stroke-width="1" class="animate-pulse" style="animation-duration: 3s" />
        
        <circle cx="750" cy="410" r="4.5" />
        <circle cx="820" cy="420" r="5" />
        <circle cx="780" cy="480" r="5.5" stroke="#2dd4bf" stroke-width="2.5" />
        <circle cx="780" cy="480" r="16" stroke="#2dd4bf" stroke-opacity="0.4" stroke-width="1" class="animate-pulse" style="animation-duration: 4.5s" />
        
        <circle cx="620" cy="520" r="5" />
      </g>

      <!-- Data Synapses Text Indicators -->
      <g fill="#2dd4bf" fill-opacity="0.4" font-family="monospace" font-size="9" font-weight="bold">
        <text x="690" y="190">SYS_ON</text>
        <text x="800" y="180">0101</text>
        <text x="870" y="280">1</text>
        <text x="850" y="380">0</text>
        <text x="730" y="370">CTX_OK</text>
        <text x="790" y="460">ROUT_A</text>
        <text x="590" y="550">SHPFY_OK</text>
      </g>
    </svg>
  </div>
  
  <div class="page-shell relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      
      <!-- Copy Block -->
      <div class="text-center lg:text-left">
        <div class="reveal-on-scroll inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.045] px-4 py-1.5 text-xs font-bold text-slate-200">
          <span class="h-1.5 w-1.5 rounded-full bg-teal-300 animate-pulse"></span>
          Margin-safe AI agents for Shopify
        </div>

        <h1 class="reveal-on-scroll reveal-delay-100 mt-6 text-[2.85rem] font-bold leading-[1.02] tracking-tight sm:text-[3.4rem] lg:text-[4rem] xl:text-[4.65rem] bg-clip-text text-transparent bg-gradient-to-br from-white via-slate-100 to-slate-400 font-heading">
          Recover carts, answer buyers, and follow up faster without hiring another operator.
        </h1>

        <p class="reveal-on-scroll reveal-delay-200 mt-6 max-w-xl text-base font-medium leading-relaxed text-slate-300 sm:text-lg lg:max-w-2xl">
          VoluChat reviews your Shopify store, finds the revenue leaks worth fixing first, and deploys AI agents that act only inside your rules.
        </p>

        <div class="reveal-on-scroll reveal-delay-200 mt-8 flex flex-col gap-3.5 sm:flex-row sm:justify-center lg:justify-start">
          <a href="#demo" class="btn-primary">
            Request an Agent Review
          </a>
          <a href="#demo-flow" class="btn-secondary">
            See the Operating Loop
          </a>
        </div>
      </div>

      <!-- Hero Visual -->
      <div class="reveal-on-scroll reveal-delay-100 lg:hero-stage relative">
        <!-- Ambient background glow behind the mockup window -->
        <div class="absolute -inset-4 rounded-[2rem] bg-teal-500/10 blur-3xl opacity-50"></div>
        
        <div class="relative rounded-[1.75rem] border border-white/10 bg-white/[0.02] p-2.5 shadow-[0_45px_120px_-60px_rgba(0,0,0,0.95)] backdrop-blur-xl">
          <div class="relative rounded-[1.25rem] border border-white/10 bg-[#0d192b] p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]">
            <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-5">
              <div class="flex items-center gap-2.5">
                <span class="h-2 w-2 rounded-full bg-teal-400 animate-pulse"></span>
                <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-300">Agent operating trace</span>
              </div>
              <span class="rounded-md border border-teal-500/25 bg-teal-500/10 px-3 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-teal-300">Live View</span>
            </div>

            <div class="space-y-4">
              
              <!-- Segment 1: Repeated question (Product Assistant) -->
              <div class="flex items-start gap-4 rounded-xl border border-white/10 bg-white/[0.015] p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.02)] transition-all hover:bg-white/[0.035]">
                <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg border border-white/10 bg-[#101b2b] font-mono text-xs font-bold text-slate-400">01</div>
                <div class="space-y-3 w-full">
                  <div>
                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider font-mono">01. Query Detected</div>
                    <div class="text-sm font-semibold text-white mt-0.5">"Do you have running shoes in size 10?"</div>
                  </div>
                  <div class="border-t border-white/5 pt-3">
                    <div class="text-[10px] font-bold text-teal-300 uppercase tracking-wider font-mono">02. Automated Response Drafted</div>
                    <div class="text-sm font-semibold text-slate-200 mt-0.5">"Yes! The Aero Runners are in stock in size 10."</div>
                  </div>
                </div>
              </div>

              <!-- Segment 2: Abandoned Cart (Cart Recovery) -->
              <div class="flex items-start gap-4 rounded-xl border border-amber-500/20 bg-gradient-to-br from-[#0d192b] to-[#452a0a]/10 p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.02)] transition-all hover:to-[#452a0a]/20">
                <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg border border-amber-500/20 bg-[#101b2b] font-mono text-xs font-bold text-amber-400">02</div>
                <div class="space-y-3 w-full">
                  <div>
                    <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider font-mono">03. High-Intent Cart Abandoned</div>
                    <div class="text-sm font-bold text-white mt-0.5">Rs. 9,600 checkout left at recovery step.</div>
                  </div>
                  <div class="border-t border-amber-500/10 pt-3">
                    <div class="text-[10px] font-bold text-amber-300 uppercase tracking-wider font-mono">04. Margin-Safe Recovery Prepared</div>
                    <div class="text-xs font-semibold text-slate-300 mt-0.5 bg-[#07111f]/60 p-2.5 rounded-lg border border-white/5">
                      "Still interested in Aero Runners? Sizing is locked. Use your link to checkout."
                    </div>
                  </div>
                </div>
              </div>

              <!-- Segment 3: Human Approval (Control Plane) -->
              <div class="flex items-center justify-between rounded-xl border border-teal-500/25 bg-teal-500/5 p-4 text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.02)] transition-all hover:bg-teal-500/10">
                <div class="flex items-center gap-3">
                  <span class="flex h-7 w-7 items-center justify-center rounded-full border border-teal-500/25 bg-teal-500/10 font-mono text-[10px] font-bold text-teal-300">05</span>
                  <div>
                    <div class="text-[10px] font-bold text-teal-300 uppercase tracking-wider font-mono">05. Handoff Required</div>
                    <div class="text-sm font-bold">Review 10% discount offer</div>
                  </div>
                </div>
                <button class="rounded-lg bg-white px-4 py-2 text-xs font-bold text-slate-950 transition-all hover:bg-slate-200 active:scale-[0.98]">
                  Approve
                </button>
              </div>

              <!-- Segment 4: Success Attribution (Revenue Recovery) -->
              <div class="grid grid-cols-2 gap-3 font-mono">
                <div class="rounded-xl border border-white/10 bg-white/[0.015] p-3 text-center transition-all hover:bg-white/[0.03]">
                  <div class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">06. Action Sync</div>
                  <div class="text-xs font-bold text-white mt-1">Dispatched WhatsApp</div>
                </div>
                <div class="relative overflow-hidden rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-3 text-center transition-all hover:bg-emerald-500/15">
                  <div class="text-[9px] font-bold text-emerald-400 uppercase tracking-wider">07. Attribution Log</div>
                  <div class="text-xs font-extrabold text-emerald-300 mt-1">+Rs. 8,640 Recovered</div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
