---
---

<section id="hero" class="relative isolate overflow-hidden pt-28 pb-20 sm:pt-32 lg:pt-36 lg:pb-28">
  <div class="sect-grid"></div>
  <div class="sect-orb absolute -top-40 left-1/4 h-[350px] w-[350px] bg-primary-300/20 opacity-60"></div>
  <div class="sect-orb absolute top-20 right-1/4 h-[400px] w-[400px] bg-primary-400/10 opacity-40"></div>
  
  <div class="page-shell relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      
      <!-- Copy Block -->
      <div class="text-center lg:text-left">
        <div class="reveal-on-scroll inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-4 py-1.5 text-xs font-bold text-indigo-300 backdrop-blur-md shadow-[0_0_15px_rgba(79,70,229,0.2)]">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
          AI Commerce Operations for Shopify
        </div>

        <h1 class="reveal-on-scroll reveal-delay-100 mt-6 text-[2.75rem] font-bold leading-[1.1] tracking-tight text-white sm:text-[3.25rem] lg:text-[3.75rem] xl:text-[4.25rem]">
          Running an online business was never meant to be a <span class="bg-gradient-to-r from-coral-500 to-indigo-400 bg-clip-text text-transparent">headache.</span>
        </h1>

        <p class="reveal-on-scroll reveal-delay-200 mt-6 text-base font-medium leading-relaxed text-slate-400 sm:text-lg">
          VoluChat gives growing Shopify stores AI agents that handle repetitive commerce operations — from product questions and cart recovery to upsells, follow-ups, and revenue leak detection.
        </p>

        <div class="reveal-on-scroll reveal-delay-200 mt-8 flex flex-col gap-3.5 sm:flex-row sm:justify-center lg:justify-start">
          <a href="#demo" class="btn-primary">
            Book a Demo
          </a>
          <a href="#demo-flow" class="btn-secondary">
            See How It Works
          </a>
        </div>
      </div>

      <!-- Hero Visual -->
      <div class="reveal-on-scroll reveal-delay-100 lg:hero-stage">
        <div class="relative rounded-2xl border border-white/10 bg-slate-900/40 p-6 shadow-2xl backdrop-blur-xl">
          <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-5">
            <div class="flex items-center gap-2.5">
              <span class="flex h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-400">VoluChat Core Loop</span>
            </div>
            <span class="text-[11px] font-bold text-indigo-300 bg-indigo-500/20 px-3 py-1 rounded-md uppercase tracking-wider border border-indigo-500/30">Live Trace</span>
          </div>

          <div class="space-y-4">
            
            <!-- Step 1 & 2 -->
            <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-800/50 border border-white/5 kinetic-card">
              <div class="h-9 w-9 rounded-lg bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center text-lg flex-shrink-0">🙋</div>
              <div class="space-y-3 w-full">
                <div>
                  <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">01. Customer Question</div>
                  <div class="text-sm font-bold text-white mt-0.5">"Do you have running shoes in size 10?"</div>
                </div>
                <div class="border-t border-white/5 pt-3">
                  <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">02. Product Recommendation</div>
                  <div class="text-sm font-bold text-white mt-0.5">"Yes! The Aero Runners are in stock in size 10."</div>
                </div>
              </div>
            </div>

            <!-- Step 3 & 4 -->
            <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-800/50 border border-white/5 kinetic-card relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-r from-transparent via-amber-500/5 to-transparent pointer-events-none"></div>
              <div class="h-9 w-9 rounded-lg bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-lg flex-shrink-0">🛒</div>
              <div class="space-y-3 w-full relative z-10">
                <div>
                  <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider">03. Cart abandoned</div>
                  <div class="text-sm font-bold text-white mt-0.5">$120 cart left behind at checkout.</div>
                </div>
                <div class="border-t border-white/5 pt-3">
                  <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider">04. Recovery message drafted</div>
                  <div class="text-xs font-semibold text-slate-300 mt-0.5 bg-slate-900/60 p-2 rounded border border-white/10">"Hey! Left the Aero Runners behind? Here's 10% off."</div>
                </div>
              </div>
            </div>

            <!-- Step 5 & 6 -->
            <div class="flex items-center justify-between p-4 rounded-xl bg-primary-950 text-white kinetic-card">
              <div class="flex items-center gap-3">
                <span class="h-6 w-6 rounded-full bg-primary-800 flex items-center justify-center text-xs border border-primary-700">⚖️</span>
                <div>
                  <div class="text-[10px] font-bold text-primary-300 uppercase tracking-wider">05. Approval pending</div>
                  <div class="text-sm font-bold">Review 10% discount offer</div>
                </div>
              </div>
              <button class="rounded-lg bg-emerald-500 hover:bg-emerald-600 px-4 py-2 text-xs font-bold text-white transition-all shadow-sm">
                Approve
              </button>
            </div>

            <!-- Step 7 & 8 -->
            <div class="grid grid-cols-2 gap-3 p-4 rounded-xl bg-slate-800/50 border border-white/5 text-center kinetic-card">
              <div class="bg-slate-900/60 rounded-lg p-3 border border-white/5 shadow-sm">
                <div class="text-[10px] font-bold text-slate-400 uppercase">06. WhatsApp export ready</div>
                <div class="text-sm font-extrabold text-white mt-1">Synced to campaigns</div>
              </div>
              <div class="bg-emerald-500/10 rounded-lg p-3 border border-emerald-500/20 shadow-sm relative overflow-hidden">
                <div class="absolute inset-0 bg-emerald-500/5 animate-pulse pointer-events-none"></div>
                <div class="text-[10px] font-bold text-emerald-400 uppercase relative z-10">07. Outcome tracked</div>
                <div class="text-sm font-extrabold text-emerald-400 mt-1 relative z-10">+$108 Recovered</div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</section>
