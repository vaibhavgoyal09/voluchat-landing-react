---
---

<section id="hero" class="relative isolate overflow-hidden pt-[7.5rem] pb-24 sm:pt-[8.5rem] lg:pt-[9.5rem] lg:pb-32">
  <div class="sect-grid"></div>
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-teal-300/40 to-transparent"></div>
  <div class="sect-orb absolute -top-44 left-1/4 h-[360px] w-[360px] bg-teal-400/12 opacity-60"></div>
  <div class="sect-orb absolute top-28 right-1/4 h-[420px] w-[420px] bg-slate-400/8 opacity-40"></div>
  
  <div class="page-shell relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      
      <!-- Copy Block -->
      <div class="text-center lg:text-left">
        <div class="reveal-on-scroll inline-flex items-center gap-2 rounded-full border border-teal-500/30 bg-teal-500/10 px-4 py-1.5 text-xs font-bold text-teal-300 backdrop-blur-md shadow-[0_0_15px_rgba(45,212,191,0.1)]">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
          AI Commerce Operations for Shopify
        </div>

        <h1 class="reveal-on-scroll reveal-delay-100 mt-6 text-[2.85rem] font-bold leading-[1.02] tracking-tight text-white sm:text-[3.4rem] lg:text-[4rem] xl:text-[4.65rem]">
          Running an online business was never meant to be a <span class="bg-gradient-to-r from-teal-200 via-white to-emerald-300 bg-clip-text text-transparent">headache.</span>
        </h1>

        <p class="reveal-on-scroll reveal-delay-200 mt-6 max-w-xl text-base font-medium leading-relaxed text-slate-200 sm:text-lg lg:max-w-2xl">
          VoluChat gives growing Shopify stores AI agents that handle repetitive commerce operations — from product questions and cart recovery to upsells, follow-ups, and revenue leak detection.
        </p>

        <div class="reveal-on-scroll reveal-delay-200 mt-8 flex flex-col gap-3.5 sm:flex-row sm:justify-center lg:justify-start">
          <a href="#demo" class="btn-primary">
            Book a Demo
          </a>
          <a href="#demo-flow" class="btn-secondary">
            See How It Works
          </a>
        </div>
      </div>

      <!-- Hero Visual -->
      <div class="reveal-on-scroll reveal-delay-100 lg:hero-stage">
        <div class="relative rounded-[1.75rem] border border-white/10 bg-white/[0.045] p-2 shadow-[0_40px_120px_-70px_rgba(45,212,191,0.5)]">
        <div class="relative rounded-[1.25rem] border border-[rgba(148,163,184,0.22)] bg-[rgba(14,25,42,0.95)] p-6 shadow-[0_20px_54px_-22px_rgba(0,0,0,0.86)]">
          <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-5">
            <div class="flex items-center gap-2.5">
              <span class="flex h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-300">VoluChat Core Loop</span>
            </div>
            <span class="text-[11px] font-bold text-teal-300 bg-teal-500/20 px-3 py-1 rounded-md uppercase tracking-wider border border-teal-500/30">Live Trace</span>
          </div>

          <div class="space-y-4">
            
            <!-- Step 1 & 2 -->
            <div class="flex items-start gap-4 rounded-xl border border-[rgba(148,163,184,0.2)] bg-[#142238] p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.055)] kinetic-card">
              <div class="h-9 w-9 rounded-lg bg-teal-500/20 border border-teal-500/30 flex items-center justify-center text-lg flex-shrink-0 text-teal-200">🙋</div>
              <div class="space-y-3 w-full">
                <div>
                  <div class="text-[10px] font-bold text-slate-300 uppercase tracking-wider">01. Customer Question</div>
                  <div class="text-sm font-bold text-white mt-0.5">"Do you have running shoes in size 10?"</div>
                </div>
                <div class="border-t border-white/5 pt-3">
                  <div class="text-[10px] font-bold text-slate-300 uppercase tracking-wider">02. Product Recommendation</div>
                  <div class="text-sm font-bold text-white mt-0.5">"Yes! The Aero Runners are in stock in size 10."</div>
                </div>
              </div>
            </div>

            <!-- Step 3 & 4 -->
            <div class="relative flex items-start gap-4 overflow-hidden rounded-xl border border-[rgba(148,163,184,0.2)] bg-[#142238] p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.055)] kinetic-card">
              <div class="absolute inset-0 bg-gradient-to-r from-transparent via-amber-500/5 to-transparent pointer-events-none"></div>
              <div class="h-9 w-9 rounded-lg bg-amber-400/20 border border-amber-400/35 flex items-center justify-center text-lg flex-shrink-0">🛒</div>
              <div class="space-y-3 w-full relative z-10">
                <div>
                  <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider">03. Cart abandoned</div>
                  <div class="text-sm font-bold text-white mt-0.5">$120 cart left behind at checkout.</div>
                </div>
                <div class="border-t border-white/5 pt-3">
                  <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider">04. Recovery message drafted</div>
                  <div class="text-xs font-semibold text-slate-200 mt-0.5 bg-[#08111f] p-2 rounded border border-white/10">"Hey! Left the Aero Runners behind? Here's 10% off."</div>
                </div>
              </div>
            </div>

            <!-- Step 5 & 6 -->
            <div class="flex items-center justify-between rounded-xl border border-[rgba(148,163,184,0.22)] bg-[#0a1424] p-4 text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.055)] kinetic-card">
              <div class="flex items-center gap-3">
                <span class="h-6 w-6 rounded-full bg-primary-800 flex items-center justify-center text-xs border border-primary-700">⚖️</span>
                <div>
                  <div class="text-[10px] font-bold text-primary-300 uppercase tracking-wider">05. Approval pending</div>
                  <div class="text-sm font-bold">Review 10% discount offer</div>
                </div>
              </div>
              <button class="rounded-lg bg-emerald-500 hover:bg-emerald-600 px-4 py-2 text-xs font-bold text-white transition-all shadow-sm">
                Approve
              </button>
            </div>

            <!-- Step 7 & 8 -->
            <div class="grid grid-cols-2 gap-3 rounded-xl border border-[rgba(148,163,184,0.2)] bg-[#142238] p-4 text-center shadow-[inset_0_1px_0_rgba(255,255,255,0.055)] kinetic-card">
              <div class="bg-[#0d1829] rounded-lg p-3 border border-[rgba(148,163,184,0.14)] shadow-sm">
                <div class="text-[10px] font-bold text-slate-300 uppercase">06. Campaign export ready</div>
                <div class="text-sm font-extrabold text-white mt-1">Synced to campaigns</div>
              </div>
              <div class="bg-emerald-500/10 rounded-lg p-3 border border-emerald-500/20 shadow-sm relative overflow-hidden">
                <div class="absolute inset-0 bg-emerald-500/5 animate-pulse pointer-events-none"></div>
                <div class="text-[10px] font-bold text-emerald-400 uppercase relative z-10">07. Outcome tracked</div>
                <div class="text-sm font-extrabold text-emerald-400 mt-1 relative z-10">+$108 Recovered</div>
              </div>
            </div>

          </div>
        </div>
        </div>
      </div>
    </div>
  </div>
</section>
