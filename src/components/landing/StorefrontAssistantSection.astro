---
---

<section id="storefront-assistant" class="relative overflow-hidden py-20 sm:py-24">
  <div class="sect-grid"></div>
  <div class="sect-orb absolute top-10 right-10 h-[300px] w-[300px] bg-indigo-500/20 opacity-40"></div>
  
  <div class="page-shell relative z-10">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      
      <!-- Mockup Visual -->
      <div class="order-2 lg:order-1">
        <div class="relative rounded-2xl border border-white/10 bg-slate-900/40 p-5 shadow-2xl backdrop-blur-md">
          
          <!-- Mockup Store Header -->
          <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-slate-700"></span>
              <span class="text-xs font-bold text-slate-400 font-sans">shop-modern.com / pdp</span>
            </div>
            <div class="h-2.5 w-12 rounded bg-slate-800"></div>
          </div>

          <!-- Product Details Mini View -->
          <div class="flex gap-4 items-center bg-slate-800/40 rounded-xl p-3 border border-white/5 mb-6">
            <div class="h-14 w-14 rounded-lg bg-slate-700 flex items-center justify-center text-lg">🏃‍♂️</div>
            <div>
              <h4 class="text-xs font-bold text-white">Aero Runner Black</h4>
              <p class="text-[10px] text-slate-400 font-semibold mt-0.5">$120.00 — In Stock</p>
            </div>
          </div>

          <!-- Chat Assistant Widget Mockup -->
          <div class="rounded-xl border border-indigo-500/20 bg-gradient-to-b from-indigo-500/10 to-slate-900/80 p-4 shadow-sm">
            
            <!-- Chat Header -->
            <div class="flex items-center gap-2 pb-3 border-b border-white/10 mb-3">
              <div class="h-6 w-6 rounded-full bg-indigo-500 flex items-center justify-center text-[10px] text-white">⚡</div>
              <div>
                <h5 class="text-xs font-bold text-white">VoluChat Assistant</h5>
                <p class="text-[9px] text-emerald-400 font-bold">Online</p>
              </div>
            </div>

            <!-- Assistant Bubble -->
            <div class="flex gap-3">
              <div class="h-7 w-7 rounded-full bg-indigo-600 text-white flex-shrink-0 flex items-center justify-center text-xs">🤖</div>
              <div class="rounded-2xl bg-slate-800 border border-white/10 p-3.5 shadow-sm max-w-[85%]">
                <p class="text-xs text-white leading-relaxed font-semibold">
                  Need help choosing the right size? This style runs slightly narrow. I can recommend the safest fit.
                </p>
              </div>
            </div>

            <!-- Dynamic Product Card Recommendations -->
            <div class="mt-4 pl-10 grid gap-2.5 sm:grid-cols-3">
              
              <!-- Card 1 -->
              <div class="rounded-lg border border-white/10 bg-slate-800/60 p-2.5 text-center shadow-xs">
                <div class="text-[10px] font-bold text-slate-400 uppercase">Safest Fit</div>
                <div class="text-xs font-bold text-white mt-1">Recommended Size</div>
                <button class="w-full mt-2 rounded bg-indigo-500 hover:bg-indigo-400 py-1 text-[9px] font-bold text-white uppercase tracking-wider transition">
                  Select Size 10
                </button>
              </div>

              <!-- Card 2 -->
              <div class="rounded-lg border border-white/10 bg-slate-800/60 p-2.5 text-center shadow-xs">
                <div class="text-[10px] font-bold text-slate-400 uppercase">Alternative</div>
                <div class="text-xs font-bold text-white mt-1">Aero Runner White</div>
                <button class="w-full mt-2 rounded bg-slate-700 hover:bg-slate-600 py-1 text-[9px] font-bold text-white uppercase tracking-wider transition">
                  View Detail
                </button>
              </div>

              <!-- Card 3 -->
              <div class="rounded-lg border border-white/10 bg-slate-800/60 p-2.5 text-center shadow-xs">
                <div class="text-[10px] font-bold text-slate-400 uppercase">Extra Margin</div>
                <div class="text-xs font-bold text-white mt-1">Bundle Socks (+$12)</div>
                <button class="w-full mt-2 rounded bg-slate-700 hover:bg-slate-600 py-1 text-[9px] font-bold text-white uppercase tracking-wider transition">
                  Add Bundle
                </button>
              </div>

            </div>
          </div>

        </div>
      </div>

      <!-- Copy Block -->
      <div class="order-1 lg:order-2">
        <span class="section-eyebrow">Onsite Conversion</span>
        <h2 class="section-title mt-4">A proactive shopping assistant that sells like your best store rep.</h2>
        <p class="section-copy mt-6">
          It does not wait for the customer to ask. It notices buying intent, recommends products, compares options, answers objections, recovers carts, and pushes the right offer at the right moment.
        </p>

        <ul class="mt-8 space-y-4">
          <li class="flex items-start gap-3">
            <span class="mt-1 flex h-2 w-2 rounded-full bg-indigo-500"></span>
            <p class="text-sm font-medium text-slate-400">
              <strong class="text-white">Context-aware conversations:</strong> Resolves sizing and fit queries before shoppers drop off.
            </p>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 flex h-2 w-2 rounded-full bg-indigo-500"></span>
            <p class="text-sm font-medium text-slate-400">
              <strong class="text-white">Catalog comparisons:</strong> Directly shows side-by-side spec sheets and feature options.
            </p>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 flex h-2 w-2 rounded-full bg-indigo-500"></span>
            <p class="text-sm font-medium text-slate-400">
              <strong class="text-white">Integrated checkout assistance:</strong> Pulls dynamic coupon parameters based on custom margin caps.
            </p>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>
