---
---

<section id="guardrails" class="relative overflow-hidden py-20 sm:py-24 border-y border-white/5">
  <div class="sect-grid"></div>
  <div class="sect-orb absolute top-10 left-1/3 h-[350px] w-[350px] bg-amber-500/10 opacity-30"></div>
  
  <div class="page-shell relative z-10">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      
      <!-- Copy Block -->
      <div>
        <span class="section-eyebrow text-amber-400 font-bold uppercase tracking-wider text-xs">Agent Guardrails</span>
        <h2 class="section-title mt-4 text-white">Built for brands that cannot afford reckless AI.</h2>
        <p class="section-copy mt-6 text-slate-300">
          Generative AI becomes a liability when it can discount, recommend, or message customers without rules. VoluChat wraps every agent action in store-specific limits before it reaches a buyer.
        </p>

        <!-- CTA in section -->
        <div class="mt-8">
          <a href="#demo" class="btn-primary">
            Review My Agent Guardrails
          </a>
        </div>
      </div>

      <!-- Guardrails List Box -->
      <div class="rounded-2xl border border-[rgba(148,163,184,0.18)] bg-[#121c2d]/90 p-6 sm:p-8 shadow-[0_20px_40px_-10px_rgba(0,0,0,0.5)] backdrop-blur-xl">
        <h3 class="font-heading text-sm font-bold uppercase tracking-wider text-slate-300">Deterministic Rule Enforcement</h3>
        
        <div class="mt-6 space-y-4">
          
          <!-- Rule 1 -->
          <div class="flex items-start gap-3">
            <span class="mt-1 flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500/20 border border-emerald-500/30 text-[10px] font-bold text-emerald-400">✓</span>
            <div>
              <h4 class="text-sm font-bold text-white">No out-of-stock recommendations</h4>
              <p class="text-xs text-slate-300 mt-0.5">Real-time inventory lookup blocks suggestions for out-of-stock items or variants.</p>
            </div>
          </div>

          <!-- Rule 2 -->
          <div class="flex items-start gap-3">
            <span class="mt-1 flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500/20 border border-emerald-500/30 text-[10px] font-bold text-emerald-400">✓</span>
            <div>
              <h4 class="text-sm font-bold text-white">No margin-breaking discounts</h4>
              <p class="text-xs text-slate-300 mt-0.5">Strict discount caps prevent coupons from crossing specified product margin limits.</p>
            </div>
          </div>

          <!-- Rule 3 -->
          <div class="flex items-start gap-3">
            <span class="mt-1 flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500/20 border border-emerald-500/30 text-[10px] font-bold text-emerald-400">✓</span>
            <div>
              <h4 class="text-sm font-bold text-white">New arrival exemptions</h4>
              <p class="text-xs text-slate-300 mt-0.5">Define category and tag boundaries to exempt new arrivals and premium products from clearance discounts.</p>
            </div>
          </div>

          <!-- Rule 4 -->
          <div class="flex items-start gap-3">
            <span class="mt-1 flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500/20 border border-emerald-500/30 text-[10px] font-bold text-emerald-400">✓</span>
            <div>
              <h4 class="text-sm font-bold text-white">No promoting high-return items</h4>
              <p class="text-xs text-slate-300 mt-0.5">Dynamically suppresses recommendation of products with sizing return rates exceeding custom thresholds.</p>
            </div>
          </div>

          <!-- Rule 5 -->
          <div class="flex items-start gap-3">
            <span class="mt-1 flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500/20 border border-emerald-500/30 text-[10px] font-bold text-emerald-400">✓</span>
            <div>
              <h4 class="text-sm font-bold text-white">SLA-backed delivery promises</h4>
              <p class="text-xs text-slate-300 mt-0.5">Enforces shipping and delivery estimations strict to zip-code zones, preventing over-promising.</p>
            </div>
          </div>

          <!-- Rule 6 -->
          <div class="flex items-start gap-3">
            <span class="mt-1 flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500/20 border border-emerald-500/30 text-[10px] font-bold text-emerald-400">✓</span>
            <div>
              <h4 class="text-sm font-bold text-white">Sensitive Action Approvals & Voice Control</h4>
              <p class="text-xs text-slate-300 mt-0.5">Enable manual validation steps for large-scale campaigns. Strict brand guidelines lock tone parameters.</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
