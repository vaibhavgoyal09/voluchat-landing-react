---
const navigation = [
  { name: "Platform", href: "#platform" },
  { name: "Use Cases", href: "#use-cases" },
  { name: "How It Works", href: "#how-it-works" },
  { name: "Guardrails", href: "#guardrails" },
  { name: "Demo", href: "#demo" },
];
---

<header id="lp-navbar" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="lp-nav-inner mx-auto w-full max-w-7xl px-5 sm:px-6 lg:px-8">
    <nav class="flex h-20 items-center justify-between" aria-label="Global">
      <div class="flex lg:flex-1">
        <a href="/" class="-m-1.5 p-1.5 focus-visible:ring-offset-0">
          <span class="sr-only">VoluChat</span>
          <div class="flex items-center gap-2.5">
            <img src="/voluchat_logo.svg" alt="VoluChat Logo" class="h-8 w-8 object-contain" />
            <span class="font-heading text-[1.4rem] font-extrabold tracking-tight text-white">VoluChat</span>
          </div>
        </a>
      </div>

      <div class="hidden lg:flex lg:gap-x-1 border border-white/10 bg-slate-900/60 px-2 py-1.5 rounded-2xl shadow-lg backdrop-blur-md">
        {navigation.map((item) => (
          <a
            href={item.href}
            class="rounded-xl px-3.5 py-2 text-[13px] font-semibold text-slate-300 transition-all duration-200 hover:bg-white/10 hover:text-white"
          >
            {item.name}
          </a>
        ))}
      </div>

      <div class="hidden lg:flex lg:flex-1 lg:justify-end">
        <a
          href="#demo"
          class="inline-flex items-center justify-center rounded-full bg-white px-5 py-2.5 text-[13px] font-bold text-slate-950 transition hover:bg-slate-200 shadow-[0_0_15px_rgba(255,255,255,0.2)]"
        >
          Book a Demo
        </a>
      </div>

      <div class="flex lg:hidden">
        <button
          type="button"
          id="lp-mobile-menu-btn"
          class="grid h-11 w-11 place-items-center rounded-full border border-white/10 bg-slate-900/80 text-white shadow-sm backdrop-blur-xl transition hover:bg-white/10"
          aria-expanded="false"
        >
          <span class="sr-only">Open menu</span>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="lp-mobile-backdrop" class="fixed inset-0 -z-10 bg-slate-950/60 backdrop-blur-sm lg:hidden" aria-hidden="true"></div>
  <div 
    id="lp-mobile-menu"
    class="fixed left-1/2 top-20 z-40 w-[calc(100%-2.5rem)] max-w-[22rem] rounded-2xl border border-white/10 bg-slate-900 p-5 shadow-[0_32px_90px_rgba(0,0,0,0.5)] lg:hidden"
    role="dialog"
    aria-modal="true"
  >
    <div class="flex flex-col gap-2">
      {navigation.map((item) => (
        <a
          href={item.href}
          class="lp-mobile-link rounded-xl border border-white/5 bg-slate-800/60 px-4 py-3 text-[15px] font-semibold text-white transition hover:bg-slate-700 hover:border-white/10"
        >
          {item.name}
        </a>
      ))}
      <a
        href="#demo"
        class="lp-mobile-link mt-4 flex items-center justify-center rounded-xl bg-white px-4 py-3 text-[15px] font-bold text-slate-950 transition hover:bg-slate-200"
      >
        Book a Demo
      </a>
    </div>
  </div>
</header>

<style>
  #lp-navbar {
    transition: transform 0.3s ease;
  }

  /* Optional: we can add a tiny border to the top of the header if we want, or just leave it transparent */
  #lp-navbar.scrolled {
    /* No solid background, keep it floating */
  }

  .lp-menu-line {
    display: block;
    grid-area: 1 / 1;
    height: 1.5px;
    width: 17px;
    border-radius: 999px;
    background: currentColor;
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.32s ease;
  }

  .lp-menu-a { transform: translateY(-3.5px); }
  .lp-menu-b { transform: translateY(3.5px); }

  #lp-mobile-menu,
  #lp-mobile-backdrop {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.28s ease, transform 0.28s ease, visibility 0.28s ease;
  }

  #lp-mobile-menu {
    transform: translateX(-50%) translateY(-10px) scale(0.98);
  }

  #lp-mobile-menu.lp-menu-open,
  #lp-mobile-backdrop.lp-menu-open {
    opacity: 1;
    visibility: visible;
  }

  #lp-mobile-menu.lp-menu-open {
    transform: translateX(-50%) translateY(0) scale(1);
  }

  #lp-mobile-backdrop.lp-menu-open {
    transform: none;
  }

  .lp-toggle-open .lp-menu-a {
    transform: translateY(0) rotate(45deg);
  }

  .lp-toggle-open .lp-menu-b {
    transform: translateY(0) rotate(-45deg);
  }
</style>

<script>
  // Scroll behavior
  const navbar = document.getElementById('lp-navbar');
  const onScroll = () => {
    if (window.scrollY > 20) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile menu
  const toggle = document.getElementById('lp-mobile-menu-btn');
  const menu = document.getElementById('lp-mobile-menu');
  const backdrop = document.getElementById('lp-mobile-backdrop');

  const closeMenu = () => {
    menu?.classList.remove('lp-menu-open');
    backdrop?.classList.remove('lp-menu-open');
    toggle?.classList.remove('lp-toggle-open');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('lp-menu-open');
    if (isOpen) { closeMenu(); return; }
    menu?.classList.add('lp-menu-open');
    backdrop?.classList.add('lp-menu-open');
    toggle.classList.add('lp-toggle-open');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  });

  backdrop?.addEventListener('click', closeMenu);
  document.querySelectorAll('.lp-mobile-link').forEach(link => link.addEventListener('click', closeMenu));
</script>
