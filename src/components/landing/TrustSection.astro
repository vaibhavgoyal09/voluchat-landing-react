---
const trustCards = [
  {
    code: "01",
    title: "Approval before sensitive outreach",
    description: "Discounts, campaigns, and targeted follow-ups can sit in a queue until your team approves the exact action."
  },
  {
    code: "02",
    title: "Decision history stays visible",
    description: "See what the agent recommended, which rule was applied, who approved it, and what happened afterward."
  },
  {
    code: "03",
    title: "Store context limits the agent",
    description: "Answers and actions are grounded in live Shopify inventory, cart data, historical orders, and your policies."
  },
  {
    code: "04",
    title: "Revenue is tied back to the workflow",
    description: "Recovered carts, accepted offers, and cleared stock are attributed to the agent action that influenced them."
  }
];
---

<section class="section-band-quiet py-24 lg:py-32">
  <div class="page-shell">
    <div class="grid gap-8 lg:grid-cols-[0.8fr_1fr] lg:items-end">
      <div>
        <div class="reveal-on-scroll chip mb-6">
          <span class="mini-label">Safe & Controlled</span>
        </div>
        <h2 class="reveal-on-scroll section-title">
          AI recommends.<br class="hidden sm:inline" />
          <span class="text-slate-300">You stay in control.</span>
        </h2>
      </div>
      <p class="reveal-on-scroll section-copy max-w-2xl text-slate-300">
        VoluChat does not blindly spam customers. Sensitive actions go through approval, every recommendation is logged, and outcomes are tracked back to the original opportunity.
      </p>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-4">
      {trustCards.map((card, index) => (
        <article class={`reveal-on-scroll rounded-[1.25rem] border border-white/10 bg-[#0f1b2b] p-6 ${index === 1 ? 'md:mt-10' : index === 2 ? 'md:mt-4' : ''} reveal-delay-${(index % 4) * 100}`}>
          <span class="font-mono text-sm font-semibold text-slate-500">{card.code}</span>
          <h3 class="mt-8 text-lg font-bold leading-tight text-white">{card.title}</h3>
          <p class="mt-4 text-base font-medium leading-relaxed text-slate-300">
            {card.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
