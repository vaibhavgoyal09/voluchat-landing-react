---
---

<section id="back-office-actions" class="relative overflow-hidden py-20 sm:py-24 border-y border-white/5">
  <div class="sect-grid"></div>
  <div class="sect-orb absolute bottom-0 left-1/4 h-[350px] w-[350px] bg-indigo-500/10 opacity-30"></div>
  
  <div class="page-shell relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <span class="section-eyebrow">Back-Office Command</span>
      <h2 class="section-title mt-4">Your team gets daily commerce actions, not raw analytics.</h2>
      <p class="section-copy mt-6">
        Instead of endless graphs to decipher, VoluChat monitors operations in the background and delivers pre-packaged, ready-to-run operations suggestions straight to your inbox.
      </p>
    </div>

    <!-- Actions Grid -->
    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      
      <!-- Action 1 -->
      <div class="solid-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-indigo-400 bg-indigo-500/10 border border-indigo-500/20 px-2 py-0.5 rounded">Segmentation</span>
            <span class="text-xs text-slate-500 font-bold font-mono">10:42 AM</span>
          </div>
          <h3 class="font-heading text-sm font-bold text-white mt-4">Create Klaviyo segment</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Target 412 buyers who viewed shoes 3+ times without checking out, matching safe-fit logic.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex justify-end">
          <button class="rounded-lg bg-slate-700 hover:bg-slate-600 px-3 py-1.5 text-[11px] font-bold text-white transition">
            Sync Segment
          </button>
        </div>
      </div>

      <!-- Action 2 -->
      <div class="solid-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded">Campaign</span>
            <span class="text-xs text-slate-500 font-bold font-mono">09:15 AM</span>
          </div>
          <h3 class="font-heading text-sm font-bold text-white mt-4">Export WhatsApp campaign</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Target list of 244 customers due for Aero Runner replenishment this week.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex justify-end">
          <button class="rounded-lg bg-slate-700 hover:bg-slate-600 px-3 py-1.5 text-[11px] font-bold text-white transition">
            Export List
          </button>
        </div>
      </div>

      <!-- Action 3 -->
      <div class="solid-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-300 bg-slate-700/50 border border-white/10 px-2 py-0.5 rounded">Support</span>
            <span class="text-xs text-slate-500 font-bold font-mono">08:00 AM</span>
          </div>
          <h3 class="font-heading text-sm font-bold text-white mt-4">Generate support macro</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Based on 54 customer questions on "Narrow fit" sizes, draft sizing updates.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex justify-end">
          <button class="rounded-lg bg-slate-700 hover:bg-slate-600 px-3 py-1.5 text-[11px] font-bold text-white transition">
            Review Macro
          </button>
        </div>
      </div>

      <!-- Action 4 -->
      <div class="solid-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-amber-400 bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 rounded">Shopify Draft</span>
            <span class="text-xs text-slate-500 font-bold font-mono">Yesterday</span>
          </div>
          <h3 class="font-heading text-sm font-bold text-white mt-4">Create Shopify discount draft</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            15% off Aero Runner White series matching 90-day warehouse clearance goals.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex justify-end">
          <button class="rounded-lg bg-slate-700 hover:bg-slate-600 px-3 py-1.5 text-[11px] font-bold text-white transition">
            Generate Code
          </button>
        </div>
      </div>

      <!-- Action 5 -->
      <div class="solid-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-purple-400 bg-purple-500/10 border border-purple-500/20 px-2 py-0.5 rounded">Recommendation</span>
            <span class="text-xs text-slate-500 font-bold font-mono">Yesterday</span>
          </div>
          <h3 class="font-heading text-sm font-bold text-white mt-4">Recommend product bundle</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Create high-converting bundle proposal for runner shoe matching custom socks.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex justify-end">
          <button class="rounded-lg bg-slate-700 hover:bg-slate-600 px-3 py-1.5 text-[11px] font-bold text-white transition">
            Approve Bundle
          </button>
        </div>
      </div>

      <!-- Action 6 -->
      <div class="solid-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-rose-400 bg-rose-500/10 border border-rose-500/20 px-2 py-0.5 rounded">Stock Clearance</span>
            <span class="text-xs text-slate-500 font-bold font-mono">Yesterday</span>
          </div>
          <h3 class="font-heading text-sm font-bold text-white mt-4">Old-stock clearance campaign</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Target 150 legacy catalog item variants with localized discount actions.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex justify-end">
          <button class="rounded-lg bg-slate-700 hover:bg-slate-600 px-3 py-1.5 text-[11px] font-bold text-white transition">
            Build Campaign
          </button>
        </div>
      </div>

      <!-- Action 7 -->
      <div class="solid-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-blue-400 bg-blue-500/10 border border-blue-500/20 px-2 py-0.5 rounded">Storefront update</span>
            <span class="text-xs text-slate-500 font-bold font-mono">Yesterday</span>
          </div>
          <h3 class="font-heading text-sm font-bold text-white mt-4">Add PDP FAQ suggestion</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Add sizing fit warnings automatically to product pages with narrow-sole queries.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex justify-end">
          <button class="rounded-lg bg-slate-700 hover:bg-slate-600 px-3 py-1.5 text-[11px] font-bold text-white transition">
            Publish FAQ
          </button>
        </div>
      </div>

      <!-- Action 8 -->
      <div class="solid-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded">LTV Retention</span>
            <span class="text-xs text-slate-500 font-bold font-mono">Yesterday</span>
          </div>
          <h3 class="font-heading text-sm font-bold text-white mt-4">Create reorder campaign</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Automate SMS post-delivery checkin sequence for repeat apparel purchases.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex justify-end">
          <button class="rounded-lg bg-slate-700 hover:bg-slate-600 px-3 py-1.5 text-[11px] font-bold text-white transition">
            Launch campaign
          </button>
        </div>
      </div>

    </div>
  </div>
</section>
