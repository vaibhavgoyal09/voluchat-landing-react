---
const workflows = [
  {
    code: "CR",
    href: "/agents/cart-recovery",
    title: "Recover carts with context, not reminder spam",
    text: "Detect checkout drop-off, identify the likely objection, and use approved recovery offers only when they make commercial sense.",
    metric: "Cart recovery"
  },
  {
    code: "PA",
    href: "/agents/product-assistant",
    title: "Answer buying questions from live catalog data",
    text: "Handle sizing, stock, delivery, returns, and product-fit questions before the buyer leaves the product page.",
    metric: "Product confidence"
  },
  {
    code: "UB",
    href: "/agents/upsell",
    title: "Introduce relevant bundles at the right moment",
    text: "Suggest add-ons and upgrades when intent is clear, then back off cleanly when the buyer wants to checkout.",
    metric: "Order value"
  },
  {
    code: "IC",
    href: "/agents/inventory-clearance",
    title: "Move slow stock without store-wide discounting",
    text: "Turn aging inventory into targeted offers for shoppers already browsing related products or categories.",
    metric: "Stock velocity"
  },
  {
    code: "CF",
    href: "/agents/customer-follow-up",
    title: "Turn delivery moments into retention workflows",
    text: "Check satisfaction, route issues to support, ask for reviews, and prompt repeat purchases when timing is right.",
    metric: "Repeat purchase"
  },
  {
    code: "RL",
    href: "/agents/revenue-leak-detection",
    title: "Find the revenue leaks hiding between tools",
    text: "Rank operational gaps across unanswered demand, abandoned carts, slow inventory, and product-page hesitation.",
    metric: "Leak detection"
  }
];
---

<section id="workflows" class="relative overflow-hidden bg-[#07111f] py-28 sm:py-36">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/12 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-white/12 to-transparent"></div>
  <div class="page-shell relative z-10">
    <div class="grid gap-8 lg:grid-cols-[0.78fr_1fr] lg:items-end">
      <div>
        <span class="section-eyebrow">Revenue workflows</span>
        <h2 class="section-title mt-4 text-white">Automate the work that moves revenue.</h2>
      </div>
      <p class="section-copy max-w-2xl text-slate-300">
        Deploy agent workflows that connect customer intent with catalog details, inventory pressure, approval rules, and measurable outcomes.
      </p>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-6">
      {workflows.map((workflow, index) => (
        <a href={workflow.href} class={`reveal-on-scroll group flex min-h-[16rem] flex-col justify-between rounded-[1.35rem] border border-white/10 bg-[#101b2b] p-6 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-slate-400/30 hover:bg-[#142438] md:col-span-3 ${index === 0 || index === 5 ? 'lg:col-span-3' : 'lg:col-span-2'} reveal-delay-${(index % 3) * 100}`}>
          <div>
            <div class="flex items-center justify-between gap-4">
              <span class="font-mono text-sm font-semibold text-slate-500">{workflow.code}</span>
              <span class="text-[11px] font-bold uppercase tracking-[0.16em] text-teal-200">{workflow.metric}</span>
            </div>
            <h3 class="mt-8 text-xl font-semibold leading-tight text-white">{workflow.title}</h3>
            <p class="mt-4 text-[15px] font-medium leading-relaxed text-slate-300">{workflow.text}</p>
          </div>
          <div class="mt-8 flex items-center justify-between border-t border-white/10 pt-4 text-sm font-bold">
            <span class="text-slate-400">Agent page</span>
            <span class="text-teal-200 transition group-hover:translate-x-1">Open</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
