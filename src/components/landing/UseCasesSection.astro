---
---

<section id="workflows" class="relative overflow-hidden py-20 sm:py-24">
  <div class="sect-grid"></div>
  <div class="sect-orb absolute top-10 right-1/4 h-[300px] w-[300px] bg-primary-100/30 opacity-40"></div>
  
  <div class="page-shell relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <span class="section-eyebrow">Revenue Workflows</span>
      <h2 class="section-title mt-4">Automate the workflows that actually move revenue.</h2>
      <p class="section-copy mt-6">
        Deploy pre-configured operations plays that connect customer intent with catalog details to increase checkout conversion, average order value, and stock velocity.
      </p>
    </div>

    <!-- Core Workflows Grid -->
    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      
      <!-- Workflow 1 -->
      <div class="solid-card hover:border-primary-200 hover:shadow-lg transition duration-300 flex flex-col justify-between">
        <div>
          <div class="h-10 w-10 rounded-lg bg-primary-50 border border-primary-100 flex items-center justify-center text-lg">🛒</div>
          <h3 class="font-heading text-base font-bold text-stone-900 mt-5">Recover abandoned carts with personalized offers</h3>
          <p class="text-xs text-stone-500 mt-3 leading-relaxed">
            Detect abandoned checkout sequences and trigger targeted recovery flows on SMS, WhatsApp, or email. Dynamically customize coupons based on the exact margins of the cart item.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between text-[11px] font-bold text-primary-800">
          <span>Target Metric: Cart Recovery Rate</span>
          <span>WhatsApp / SMS</span>
        </div>
      </div>

      <!-- Workflow 2 -->
      <div class="solid-card hover:border-primary-200 hover:shadow-lg transition duration-300 flex flex-col justify-between">
        <div>
          <div class="h-10 w-10 rounded-lg bg-primary-50 border border-primary-100 flex items-center justify-center text-lg">👟</div>
          <h3 class="font-heading text-base font-bold text-stone-900 mt-5">Recommend products based on browsing and purchase history</h3>
          <p class="text-xs text-stone-500 mt-3 leading-relaxed">
            Provide real-time sizing guidance and product fit matches right on the product page. Prevent customers from leaving due to size doubt.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between text-[11px] font-bold text-primary-800">
          <span>Target Metric: PDP Conversion</span>
          <span>Storefront Widget</span>
        </div>
      </div>

      <!-- Workflow 3 -->
      <div class="solid-card hover:border-primary-200 hover:shadow-lg transition duration-300 flex flex-col justify-between">
        <div>
          <div class="h-10 w-10 rounded-lg bg-primary-50 border border-primary-100 flex items-center justify-center text-lg">📈</div>
          <h3 class="font-heading text-base font-bold text-stone-900 mt-5">Upsell before and after checkout</h3>
          <p class="text-xs text-stone-500 mt-3 leading-relaxed">
            Offer margin-safe bundle deals, complementary accessories, or subscription upgrades during checkout review and immediately post-purchase.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between text-[11px] font-bold text-primary-800">
          <span>Target Metric: Average Order Value</span>
          <span>Checkout Flows</span>
        </div>
      </div>

      <!-- Workflow 4 -->
      <div class="solid-card hover:border-primary-200 hover:shadow-lg transition duration-300 flex flex-col justify-between">
        <div>
          <div class="h-10 w-10 rounded-lg bg-primary-50 border border-primary-100 flex items-center justify-center text-lg">🔥</div>
          <h3 class="font-heading text-base font-bold text-stone-900 mt-5">Clear slow-moving inventory with targeted campaigns</h3>
          <p class="text-xs text-stone-500 mt-3 leading-relaxed">
            Identify catalog variants that have been in the warehouse for 90+ days. Automatically extract segments of previous category buyers and launch clearance offers.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between text-[11px] font-bold text-primary-800">
          <span>Target Metric: Stock Velocity</span>
          <span>Email / WhatsApp</span>
        </div>
      </div>

      <!-- Workflow 5 -->
      <div class="solid-card hover:border-primary-200 hover:shadow-lg transition duration-300 flex flex-col justify-between">
        <div>
          <div class="h-10 w-10 rounded-lg bg-primary-50 border border-primary-100 flex items-center justify-center text-lg">🤝</div>
          <h3 class="font-heading text-base font-bold text-stone-900 mt-5">Automate repetitive support without losing brand control</h3>
          <p class="text-xs text-stone-500 mt-3 leading-relaxed">
            Resolve shipping disputes, policy queries, and delivery status updates instantly. Restrict responses to deterministic policies with strict human review guardrails.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between text-[11px] font-bold text-primary-800">
          <span>Target Metric: Support First Reply Time</span>
          <span>Multi-Channel Inbox</span>
        </div>
      </div>

      <!-- Workflow 6 -->
      <div class="solid-card hover:border-primary-200 hover:shadow-lg transition duration-300 flex flex-col justify-between">
        <div>
          <div class="h-10 w-10 rounded-lg bg-primary-50 border border-primary-100 flex items-center justify-center text-lg">🔄</div>
          <h3 class="font-heading text-base font-bold text-stone-900 mt-5">Trigger win-back campaigns for existing customers</h3>
          <p class="text-xs text-stone-500 mt-3 leading-relaxed">
            Identify customers whose average replenishment period has elapsed. Automatically send reorder prompts containing their previously selected variants.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between text-[11px] font-bold text-primary-800">
          <span>Target Metric: Customer Lifetime Value</span>
          <span>SMS / Email</span>
        </div>
      </div>

    </div>
  </div>
</section>
