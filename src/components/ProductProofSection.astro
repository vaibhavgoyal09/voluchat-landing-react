---
const scenarios = [
  {
    id: "discover",
    label: "01 — Sizing & Stock Check",
    title: "Reel Inquiry to Live Inventory Check",
    subtitle: "Searches your synced boutique catalog and verifies real-time variant stock in 2 seconds.",
    category: "Instant Sizing",
    messages: [
      {
        sender: "customer",
        time: "11:14 PM",
        text: "Price of the Chanderi Silk Anarkali from your latest reel? Is Size M in stock?",
      },
      {
        sender: "ai",
        time: "11:14 PM",
        text: "Hi Priya! ✨ That's our handcrafted Chanderi Silk Anarkali Set with zardozi handwork.",
        productCard: {
          title: "Chanderi Silk Anarkali Set",
          price: "₹3,899",
          originalPrice: "₹4,500",
          sizes: [
            { label: "S (36\")", stock: "In Stock", active: false },
            { label: "M (38\")", stock: "2 Left", active: true },
            { label: "L (40\")", stock: "In Stock", active: false },
          ],
          fabric: "Pure Chanderi Silk • Full Shantoon Lining",
        },
      },
      {
        sender: "customer",
        time: "11:15 PM",
        text: "Can you add Size M to my bag?",
      },
      {
        sender: "ai",
        time: "11:15 PM",
        text: "Added Chanderi Silk Anarkali (Size M) to your bag! Total: ₹3,899. Would you like to complete checkout or see matching dupattas?",
        badge: "Live Stock Verified from Catalog",
      },
    ],
    note: "Reads your synced catalog, verifies exact variant stock in real time, and manages the customer's cart directly in chat.",
    prompts: [
      { label: "💬 Ask about fabric lining", reply: "Yes! It comes with a pure Shantoon cotton lining for full comfort." },
      { label: "🛍️ Reserve Size M now", reply: "Reserved Size M for 15 minutes! Please share your shipping address to generate 1-click UPI link." },
    ],
  },
  {
    id: "visual",
    label: "02 — Visual Search Match",
    title: "Customer Photo to Catalog Match",
    subtitle: "Identifies outfits from customer screenshots and recommends matching catalog pieces.",
    category: "Visual AI",
    messages: [
      {
        sender: "customer",
        time: "03:20 PM",
        text: "Hi! Do you have any outfit similar to this pastel lehenga for a sangeet?",
        imageAttachment: "📸 Photo: Pastel Organza Lehenga with Mirror Work",
      },
      {
        sender: "ai",
        time: "03:20 PM",
        text: "Found 2 matching pieces from our festive collection! ✨",
        productCard: {
          title: "Blush Rose Organza Lehenga",
          price: "₹6,499",
          originalPrice: "₹7,999",
          sizes: [
            { label: "S", stock: "In Stock", active: false },
            { label: "M", stock: "In Stock", active: false },
            { label: "L (40\")", stock: "Ready to Dispatch", active: true },
          ],
          fabric: "Pure Organza • Thread & Mirror Embroidery",
        },
        badge: "Visual AI Match from Catalog",
      },
      {
        sender: "customer",
        time: "03:21 PM",
        text: "The Blush Rose Lehenga looks gorgeous! Is size L ready to dispatch?",
      },
      {
        sender: "ai",
        time: "03:21 PM",
        text: "Yes! Size L (Bust 40\") is ready to dispatch within 24 hours. Free express shipping included!",
      },
    ],
    note: "Customers share Pinterest or Instagram photos. VoluChat's visual search matches similar garments in your active inventory.",
    prompts: [
      { label: "👗 Recommend matching jewellery", reply: "We recommend our Kundan Polki Choker Set (₹1,899) — pairs beautifully with Blush Rose!" },
      { label: "⚡ Proceed to 1-Click Pay", reply: "Great! Let me generate your 1-click UPI checkout link." },
    ],
  },
  {
    id: "checkout",
    label: "03 — 1-Click UPI Pay",
    title: "Address Collection to 1-Click UPI",
    subtitle: "Collects delivery address in-chat and generates a 1-click UPI checkout link.",
    category: "Zero Cart Drops",
    messages: [
      {
        sender: "customer",
        time: "08:40 PM",
        text: "I want to order the Blush Rose Lehenga in Size L. Can I pay via GPay?",
      },
      {
        sender: "ai",
        time: "08:40 PM",
        text: "Added Size L to your order! Please share your full delivery address and pincode to proceed.",
      },
      {
        sender: "customer",
        time: "08:41 PM",
        text: "Flat 402, Palm Heights, 12th Main, Indiranagar, Bangalore - 560038",
      },
      {
        sender: "ai",
        time: "08:41 PM",
        text: "Here is your 1-click UPI payment link for ₹6,499. Once paid, your order is instantly confirmed!",
        upiCard: {
          amount: "₹6,499",
          orderId: "ORD-9842",
          items: "Blush Rose Organza Lehenga (Size L)",
