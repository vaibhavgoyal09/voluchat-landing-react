];
---

<section id="proof" class="relative overflow-hidden py-28 sm:py-32 lg:py-36 border-t border-slate-200/80 bg-[#f8fafc]">
  <!-- Backdrop gradient -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center">
    <div class="h-[600px] w-[900px] rounded-full bg-[radial-gradient(circle_at_center,rgba(16,185,129,0.08)_0%,rgba(20,184,166,0.03)_50%,transparent_70%)] blur-[120px]"></div>
  </div>

  <div class="page-shell relative z-10">
    <div class="mb-16 lg:mb-20 max-w-3xl">
      <div class="chip-emerald mb-4 inline-flex">
        <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-700">Interactive Demonstration</span>
      </div>
      <h2 class="section-title font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight">
        See your AI Sales Agent <em class="serif-accent">at work</em>.
      </h2>
      <p class="section-copy mt-5 text-base sm:text-lg text-slate-600 font-normal leading-relaxed">
        Real-world simulations across core boutique responsibilities. Explore live customer interactions from the first Reel inquiry to post-purchase fulfillment. Click tabs or test interactive prompts below.
      </p>
    </div>

    <!-- Tab Container -->
    <div class="product-proof-wrapper max-w-5xl mx-auto">
      <!-- Tab Navigation Buttons: Apple-style pill segmented control -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 p-1.5 rounded-3xl sm:rounded-full bg-slate-200/60 border border-slate-200/90 backdrop-blur-xl mb-10 max-w-2xl mx-auto" role="tablist" aria-label="Boutique scenarios">
        {
          scenarios.map((scenario, index) => (
            <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              class={`proof-tab-btn flex-1 min-w-[140px] px-3.5 py-2 rounded-full text-xs font-mono font-medium transition-[background-color,color,box-shadow] duration-200 text-slate-600 hover:text-slate-900 hover:bg-white/60 active:scale-[0.98] ${index === 0 ? "is-active text-slate-900 bg-white shadow-xs font-bold" : ""}`}
              data-target={scenario.id}
            >
              {scenario.label}
            </button>
          ))
        }
      </div>

      <!-- Scenarios Panels -->
      <div class="proof-stage relative">
        {
          scenarios.map((scenario, index) => (
            <div
              id={`proof-panel-${scenario.id}`}
              class={`proof-panel transition-opacity duration-300 ${index === 0 ? "block opacity-100" : "hidden opacity-0"}`}
            >
              <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:gap-12 items-center">
                
                <!-- Chat Window Mockup with Rich Interactive Elements -->
                <div class="rounded-3xl p-5 sm:p-7 border border-slate-200/90 bg-[#efeae2]/80 shadow-[0_20px_50px_rgba(0,0,0,0.06),0_0_20px_rgba(16,185,129,0.06)] relative overflow-hidden flex min-h-[480px] flex-col justify-between backdrop-blur-2xl">
                
                  <!-- Chat Header -->
                  <div>
                    <div class="flex items-center justify-between border-b border-slate-300/80 pb-3.5 mb-5 bg-white/70 -mx-5 -mt-5 p-4 rounded-t-3xl backdrop-blur-md">
                      <div class="flex items-center gap-3">
                        <div class="relative h-9 w-9 rounded-full bg-emerald-600 border border-emerald-500 flex items-center justify-center text-white font-bold text-xs shadow-2xs">
                          VC
                          <span class="absolute bottom-0 right-0 h-2.5 w-2.5 rounded-full bg-emerald-400 ring-2 ring-white"></span>
                        </div>
                        <div>
                          <div class="text-xs sm:text-sm font-semibold text-slate-900">VoluChat AI Sales Agent</div>
                          <div class="text-[10px] text-emerald-700 font-mono flex items-center gap-1 font-semibold">
                            Online &bull; 2.0s Instant Reply
                          </div>
                        </div>
                      </div>
                      <span class="rounded-full border border-emerald-600/20 bg-emerald-50 px-2.5 py-0.5 text-[10px] font-mono text-emerald-800 font-bold">
                        {scenario.category}
                      </span>
                    </div>

                    <!-- Messages Flow -->
                    <div class="space-y-3.5 flex flex-col justify-end" id={`chat-stream-${scenario.id}`}>
                      {
                        scenario.messages.map((msg) => (
                          <div class={`flex flex-col ${msg.sender === "customer" ? "items-end" : "items-start"}`}>
                            {msg.imageAttachment && (
                              <div class="mb-1 rounded-xl border border-pink-200 bg-pink-50 px-3 py-1.5 text-xs text-pink-900 font-medium">
                                {msg.imageAttachment}
                              </div>
                            )}

                            <div
                              class={`max-w-[88%] rounded-2xl px-4 py-2.5 text-xs sm:text-[13px] leading-relaxed shadow-2xs ${
                                msg.sender === "customer"
                                  ? "wa-out rounded-br-md text-emerald-950 font-medium"
                                  : "wa-in rounded-bl-md text-slate-900 font-normal"
                              }`}
                            >
                              {msg.text}
                            </div>
                            
                            <!-- Rich Product Card Rendering -->
                            {msg.productCard && (
                              <div class="mt-2 w-full max-w-[92%] rounded-2xl border border-slate-200/90 bg-white p-3.5 text-xs space-y-2.5 shadow-xs">
                                <div class="flex items-center justify-between">
                                  <span class="font-semibold text-slate-900 text-[13px]">{msg.productCard.title}</span>
                                  <div class="flex items-center gap-1.5 font-mono">
                                    <span class="font-bold text-emerald-700 text-xs">{msg.productCard.price}</span>
                                    <span class="text-[10px] text-slate-600 line-through">{msg.productCard.originalPrice}</span>
                                  </div>
                                </div>
                                <div class="text-[11px] text-slate-600 font-normal">
                                  {msg.productCard.fabric}
                                </div>
                                <div class="flex items-center gap-2 pt-1 border-t border-slate-100">
                                  <span class="text-[10px] font-mono text-slate-500 font-semibold">Available:</span>
                                  {msg.productCard.sizes.map((s) => (
                                    <span class={`px-2 py-0.5 rounded text-[10px] font-mono ${s.active ? "bg-emerald-600 text-white font-bold ring-1 ring-emerald-500" : "bg-slate-100 text-slate-700"}`}>
                                      {s.label}
                                    </span>
                                  ))}
                                </div>
                              </div>
                            )}

                            <!-- Rich UPI Payment Card -->
                            {msg.upiCard && (
                              <div class="mt-2 w-full max-w-[92%] rounded-2xl border border-emerald-500/40 bg-white p-3.5 space-y-2.5 shadow-sm">
                                <div class="flex items-center justify-between text-xs">
                                  <span class="font-mono text-slate-600 font-semibold">1-Click UPI Payment</span>
                                  <span class="font-bold text-emerald-700 font-mono text-sm">{msg.upiCard.amount}</span>
                                </div>
                                <div class="text-[11px] text-slate-700 font-medium">
                                  {msg.upiCard.items}
                                </div>
                                <button class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-xs active:scale-[0.99] transition-all">
                                  <span>⚡ Pay {msg.upiCard.amount} via UPI</span>
                                </button>
                                <div class="flex items-center justify-center gap-3 text-[10px] font-mono text-slate-500 pt-1">
                                  <span>GPay</span> &bull; <span>PhonePe</span> &bull; <span>Paytm</span> &bull; <span>BHIM</span>
                                </div>
                              </div>
                            )}

                            <!-- Rich Courier Tracking Card -->
                            {msg.trackingCard && (
                              <div class="mt-2 w-full max-w-[92%] rounded-2xl border border-slate-200/90 bg-white p-3.5 space-y-2 text-xs shadow-xs">
                                <div class="flex items-center justify-between">
                                  <span class="font-bold text-slate-900 flex items-center gap-1.5">
                                    <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                    {msg.trackingCard.courier}
                                  </span>
                                  <span class="font-mono text-[10px] text-slate-500">{msg.trackingCard.awb}</span>
                                </div>
                                <div class="bg-slate-50 rounded-xl p-2.5 border border-slate-100 space-y-1.5">
                                  <div class="flex justify-between text-[11px]">
                                    <span class="text-emerald-700 font-bold">{msg.trackingCard.status}</span>
                                    <span class="text-slate-800 font-mono font-semibold">{msg.trackingCard.eta}</span>
                                  </div>
                                  <div class="w-full bg-slate-200 rounded-full h-1.5 overflow-hidden">
                                    <div class="bg-gradient-to-r from-emerald-500 to-teal-500 h-1.5 rounded-full w-5/6"></div>
                                  </div>
                                  <div class="text-[10px] text-slate-500">Destination: {msg.trackingCard.city}</div>
                                </div>
                              </div>
                            )}

                            {msg.badge && (
                              <div class="mt-1.5 flex items-center gap-1.5 rounded-md bg-emerald-50 border border-emerald-500/30 px-2.5 py-1 text-[10px] font-mono text-emerald-800 font-semibold">
                                <span>✓</span>
                                <span>{msg.badge}</span>
                              </div>
                            )}

                            <span class="text-[9px] text-slate-600 font-mono mt-1 px-1">
                              {msg.time}{msg.sender !== "customer" ? "  ✓✓" : ""}
                            </span>
                          </div>
                        ))
                      }
                    </div>
                  </div>

                  <!-- Interactive Shopper Prompt Chips (Try-it-live) -->
                  <div class="mt-4 pt-3.5 border-t border-slate-300/80">
                    <div class="text-[10px] font-mono text-slate-600 mb-2 flex items-center gap-1.5 font-semibold">
                      <span class="text-emerald-600">⚡</span>
                      <span>Try clicking a prompt to simulate live response:</span>
                    </div>
                    <div class="flex flex-wrap gap-1.5">
                      {scenario.prompts.map((p) => (
                        <button
                          type="button"
                          class="interactive-prompt-chip text-[11px] font-mono px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-800 hover:border-emerald-500 hover:bg-emerald-50 hover:text-emerald-900 transition-all text-left shadow-2xs active:scale-[0.98] font-medium"
                          data-chat={scenario.id}
                          data-user={p.label}
                          data-reply={p.reply}
                        >
                          {p.label}
                        </button>
                      ))}
                    </div>
                  </div>

                </div>

                <!-- Scenario Explanation -->
                <div class="space-y-6 lg:pl-2">
                  <div class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/80 px-3 py-1 text-xs font-mono text-slate-700 shadow-2xs">
                    <span class="text-emerald-500">●</span> Scenario Context
                  </div>

                  <h3 class="font-heading text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
                    {scenario.title}
                  </h3>

                  <p class="text-sm sm:text-base text-slate-600 font-normal leading-relaxed">
                    {scenario.subtitle}
                  </p>

                  <div class="p-5 rounded-2xl bg-white/90 border border-slate-200/90 space-y-2 shadow-2xs backdrop-blur-xl">
                    <div class="text-xs font-mono font-semibold text-emerald-700 uppercase tracking-wider">
                      System Capability
                    </div>
                    <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
                      {scenario.note}
                    </p>
                  </div>

                  <div class="pt-2 flex flex-col sm:flex-row items-start sm:items-center gap-3">
                    <a
                      href="/free-trial"
                      class="btn-primary !py-2.5 !px-5 inline-flex items-center gap-2 text-xs font-semibold"
                    >
                      <span>Deploy for Your Boutique</span> &rarr;
                    </a>
                    <a
                      href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-secondary !py-2.5 !px-4 inline-flex items-center gap-2 text-xs"
                    >
                      <span>Test on WhatsApp</span> &rarr;
                    </a>
                  </div>
                </div>

              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  function setupProofTabs() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".proof-tab-btn");
    const panels = document.querySelectorAll<HTMLDivElement>(".proof-panel");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");

        buttons.forEach((b) => {
          b.classList.remove("is-active", "text-slate-900", "bg-slate-100", "shadow-sm");
          b.setAttribute("aria-selected", "false");
        });
        btn.classList.add("is-active", "text-slate-900", "bg-slate-100", "shadow-sm");
        btn.setAttribute("aria-selected", "true");

        // Update Panels
        panels.forEach((p) => {
          if (p.id === `proof-panel-${targetId}`) {
            p.classList.remove("hidden");
            setTimeout(() => {
              p.classList.remove("opacity-0");
              p.classList.add("opacity-100");
            }, 10);
          } else {
            p.classList.add("hidden", "opacity-0");
            p.classList.remove("opacity-100");
          }
        });
      });
    });

    // Handle interactive prompt chips
    const chips = document.querySelectorAll<HTMLButtonElement>(".interactive-prompt-chip");
    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const chatId = chip.getAttribute("data-chat");
        const userText = chip.getAttribute("data-user");
        const replyText = chip.getAttribute("data-reply");
        if (!chatId || !userText || !replyText) return;

        const stream = document.getElementById(`chat-stream-${chatId}`);
        if (!stream) return;

        // Disable chip once clicked to prevent double spam
        chip.disabled = true;
        chip.classList.add("opacity-50", "pointer-events-none");

        // Append user bubble
        const userMsg = document.createElement("div");
        userMsg.className = "flex flex-col items-end animate-fade-in";
        userMsg.innerHTML = `
          <div class="max-w-[88%] rounded-2xl rounded-br-md px-4 py-2.5 text-xs sm:text-[13px] leading-relaxed wa-out text-emerald-950 shadow-sm">
            ${userText.replace(/^[^\s]+\s/, "")}
          </div>
          <span class="text-[9px] text-slate-500 font-mono mt-1 px-1">Just now</span>
        `;
        stream.appendChild(userMsg);

        // Typing indicator
        const typingIndicator = document.createElement("div");
        typingIndicator.className = "flex flex-col items-start";
        typingIndicator.innerHTML = `
          <div class="rounded-2xl rounded-bl-md px-3.5 py-2 text-xs wa-in text-emerald-600 font-mono flex items-center gap-1.5">
            <span class="animate-pulse">●</span> VoluChat AI is typing...
          </div>
        `;
        stream.appendChild(typingIndicator);

        setTimeout(() => {
          typingIndicator.remove();
          const aiMsg = document.createElement("div");
          aiMsg.className = "flex flex-col items-start animate-fade-in";
          aiMsg.innerHTML = `
            <div class="max-w-[88%] rounded-2xl rounded-bl-md px-4 py-2.5 text-xs sm:text-[13px] leading-relaxed wa-in text-slate-800 shadow-sm">
              ${replyText}
            </div>
            <div class="mt-1 flex items-center gap-1 rounded-md bg-emerald-100 border border-emerald-300 px-2 py-0.5 text-[9px] font-mono text-emerald-800">
              ✓ Interactive Live Simulated
            </div>
            <span class="text-[9px] text-slate-500 font-mono mt-1 px-1">Just now ✓✓</span>
          `;
          stream.appendChild(aiMsg);
        }, 600);
      });
    });
  }

  setupProofTabs();
  document.addEventListener("astro:page-load", setupProofTabs);
</script>
