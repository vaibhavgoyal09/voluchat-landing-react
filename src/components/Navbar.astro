---
const navigation = [
  { name: "Features", href: "/features" },
{
      name: "Compare",
      href: "/compare",
      children: [
        { name: "vs Wati", href: "/compare/wati" },
        { name: "vs Manychat", href: "/compare/manychat" },
        { name: "vs Interakt", href: "/compare/interakt" },
        { name: "vs Bik.ai", href: "/compare/bik" },
        { name: "vs Limechat", href: "/compare/limechat" },
        { name: "vs AiSensy", href: "/compare/aisensy" },
        { name: "vs Respond.io", href: "/compare/respond-io" },
        { name: "vs Chatfuel", href: "/compare/chatfuel" },
        { name: "vs Tidio", href: "/compare/tidio" },
        { name: "vs Zoko", href: "/compare/zoko" },
        { name: "vs Manual Reps", href: "/compare/manual-reps" },
        { name: "All Comparisons", href: "/compare" },
        { name: "Alternatives Hub", href: "/alternatives" },
      ],
    },
  {
    name: "Integrations",
    href: "/integrations",
    children: [
      { name: "Shopify", href: "/integrations/shopify" },
      { name: "Razorpay", href: "/integrations/razorpay" },
      { name: "Cashfree", href: "/integrations/cashfree" },
      { name: "All integrations", href: "/integrations" },
    ],
  },
  {
    name: "Learn",
    href: "/learn",
    children: [
      { name: "What-is guides", href: "/what-is" },
      { name: "Glossary", href: "/glossary" },
      { name: "Blog", href: "/blog" },
      { name: "Revenue calculator", href: "/comment-revenue-leak-calculator" },
    ],
  },
  { name: "Pricing", href: "/pricing" },
  { name: "About", href: "/about" },
];

const demoHref = "/free-trial";
---

<header
  id="lp-navbar"
  class="fixed inset-x-0 top-0 z-50"
>
  <div class="lp-nav-container mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <nav
      class="relative flex h-14 sm:h-16 items-center justify-between px-3 sm:px-6"
      aria-label="Global"
    >
      <!-- Dedicated pill background layer: hardware accelerated opacity + scale -->
      <div
        class="lp-nav-pill-bg pointer-events-none absolute inset-0 rounded-full border border-slate-200/90 bg-white/85 shadow-[0_12px_36px_-4px_rgba(0,0,0,0.06),inset_0_1px_1px_0_rgba(255,255,255,1)] backdrop-blur-2xl"
        aria-hidden="true"
      >
      </div>

      <!-- Brand / Logo -->
      <div class="relative z-10 flex items-center pl-1 lg:flex-1 lg:pl-0">
        <a href="/" class="group -m-1.5 p-1.5 focus-visible:ring-offset-0">
          <span class="sr-only">VoluChat</span>
          <div class="flex items-center gap-3">
            <img
              src="/voluchat_logo.svg"
              alt="VoluChat Logo"
              class="h-8 w-8 sm:h-9 sm:w-9 rounded-xl object-contain drop-shadow-[0_2px_8px_rgba(5,150,105,0.2)] transition-transform duration-200 group-hover:scale-105"
            />
            <span
              class="font-heading text-[1.2rem] sm:text-[1.25rem] font-bold tracking-tight text-slate-900 transition-colors group-hover:text-emerald-700"
              >VoluChat</span
            >
          </div>
        </a>
      </div>

      <!-- Desktop Nav Links -->
      <div class="relative z-10 hidden lg:flex lg:gap-x-7 items-center">
        {
          navigation.map((item) => (
            item.children ? (
              <div class="nav-dropdown-wrap group relative">
                <a
                  href={item.href}
                  class="nav-link relative inline-flex items-center gap-1 py-1 text-[13.5px] font-semibold text-slate-700 transition-colors duration-200 hover:text-slate-900"
                  aria-haspopup="true"
                >
                  {item.name}
                  <svg class="h-3 w-3 text-slate-500 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </a>
                <div class="nav-dropdown invisible absolute left-1/2 top-full z-50 w-56 -translate-x-1/2 translate-y-1 pt-3 opacity-0 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                  <div class="overflow-hidden rounded-2xl border border-slate-200/90 bg-white/95 p-1.5 shadow-[0_24px_60px_rgba(0,0,0,0.12)] backdrop-blur-2xl">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class="flex items-center justify-between rounded-xl px-3.5 py-2.5 text-[13px] font-semibold text-slate-700 transition hover:bg-slate-100 hover:text-slate-900"
                      >
                        <span>{child.name}</span>
                        <span class="text-slate-400">→</span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class="nav-link relative py-1 text-[13.5px] font-semibold text-slate-700 transition-colors duration-200 hover:text-slate-900"
              >
                {item.name}
              </a>
            )
          ))
        }
      </div>

      <!-- Desktop CTA -->
      <div class="relative z-10 hidden lg:flex lg:flex-1 lg:justify-end">
        <a
          href={demoHref}
          class="btn-primary !w-auto !px-4.5 !py-2 !text-[13px] shadow-[0_4px_16px_rgba(5,150,105,0.25)] hover:shadow-[0_6px_20px_rgba(5,150,105,0.35)]"
        >
          30-Day Free Trial &rarr;
        </a>
      </div>

      <!-- Mobile Controls (Trial Button + Animated Hamburger) -->
      <div class="relative z-10 flex items-center gap-2.5 lg:hidden">
        <a
          href={demoHref}
          class="inline-flex h-8.5 items-center justify-center rounded-full bg-emerald-600 px-3.5 text-[12.5px] font-semibold text-white transition hover:bg-emerald-500 shadow-xs whitespace-nowrap active:scale-95"
        >
          Free Trial &rarr;
        </a>
        <button
          type="button"
          id="lp-mobile-menu-btn"
          class="grid h-9 w-9 place-items-center rounded-full border border-slate-200 bg-white text-slate-900 backdrop-blur-xl transition hover:bg-slate-50 active:scale-95 shadow-2xs"
          aria-expanded="false"
          aria-label="Toggle navigation menu"
        >
          <span class="sr-only">Toggle navigation</span>
          <span class="lp-menu-line lp-menu-a"></span>
          <span class="lp-menu-line lp-menu-b"></span>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Drawer Backdrop -->
  <div
    id="lp-mobile-backdrop"
    class="fixed inset-0 top-[60px] -z-10 bg-slate-100/80 backdrop-blur-sm lg:hidden"
    aria-hidden="true"
  >
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="lp-mobile-menu"
    class="fixed inset-x-4 top-[70px] z-40 max-w-lg mx-auto rounded-3xl border border-slate-200/90 bg-white/95 p-4 sm:p-5 backdrop-blur-2xl shadow-[0_24px_60px_rgba(0,0,0,0.12),inset_0_1px_1px_rgba(255,255,255,1)] lg:hidden"
    role="dialog"
    aria-modal="true"
  >
    <div class="flex flex-col gap-1">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="lp-mobile-link group flex items-center justify-between rounded-2xl px-4 py-3 text-[15px] font-semibold text-slate-800 transition hover:bg-slate-100 hover:text-slate-900 active:bg-slate-200"
          >
            <span>{item.name}</span>
            <svg
              class="h-4 w-4 text-slate-400 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-emerald-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))
      }
    </div>

    <!-- Mobile Menu Bottom Action Strip -->
    <div class="mt-4 pt-3.5 border-t border-slate-200/80 flex flex-col gap-2.5">
      <a
        href={demoHref}
        class="lp-mobile-link flex w-full items-center justify-center gap-2 rounded-2xl bg-emerald-600 hover:bg-emerald-500 py-3 text-center text-[14px] font-semibold text-white shadow-[0_4px_16px_rgba(5,150,105,0.25)] transition active:scale-[0.98]"
      >
        <span>Start 30-Day Free Trial</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
      <div class="flex items-center justify-center gap-2 text-[11.5px] text-slate-500 pt-1 font-medium">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span>Official Meta Partner &bull; Zero credit card needed</span>
      </div>
    </div>
  </div>
</header>

<style>
  #lp-navbar {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Scrolled header state */
  #lp-navbar.scrolled {
    transform: translateY(-2px);
  }

  /* Glass pill background element - graceful fade & scale */
  .lp-nav-pill-bg {
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  #lp-navbar.scrolled .lp-nav-pill-bg {
    opacity: 1;
    transform: scale(1);
  }

  /* Container bounds smoothly and visibly glide inward */
  .lp-nav-container {
    max-width: 80rem; /* max-w-7xl */
    transition: max-width 0.48s cubic-bezier(0.22, 1, 0.36, 1);
  }

  #lp-navbar.scrolled .lp-nav-container {
    max-width: 68rem; /* max-w-5xl compact pill container */
  }

  /* Dropdown panel scales from its trigger, not from center. */
  .nav-dropdown {
    transform-origin: top center;
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out),
      visibility 200ms;
  }

  /* Animated underline for desktop nav links */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1.5px;
    border-radius: 999px;
    background: linear-gradient(90deg, #2dd4bf, #5eeac9);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0.85;
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }

  /* Mobile menu button lines (clean CSS hamburger -> X animation) */
  #lp-mobile-menu-btn {
    position: relative;
  }

  .lp-menu-line {
    position: absolute;
    display: block;
    height: 1.5px;
    width: 16px;
    border-radius: 999px;
    background: currentColor;
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.2s ease;
  }

  .lp-menu-a {
    transform: translateY(-3.5px);
  }
  .lp-menu-b {
    transform: translateY(3.5px);
  }

  .lp-toggle-open .lp-menu-a {
    transform: translateY(0) rotate(45deg);
  }

  .lp-toggle-open .lp-menu-b {
    transform: translateY(0) rotate(-45deg);
  }

  /* Mobile menu dropdown & backdrop with fast GPU transitions */
  #lp-mobile-menu,
  #lp-mobile-backdrop {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 180ms var(--ease-out),
      transform 180ms var(--ease-out),
      visibility 180ms;
  }

  #lp-mobile-menu {
    transform: translateY(-8px) scale(0.98);
    transform-origin: top center;
    will-change: opacity, transform;
  }

  #lp-mobile-menu.lp-menu-open,
  #lp-mobile-backdrop.lp-menu-open {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  #lp-mobile-menu.lp-menu-open {
    transform: translateY(0) scale(1);
  }

  #lp-mobile-backdrop.lp-menu-open {
    transform: none;
  }
</style>

<script>
  const navbar = document.getElementById("lp-navbar");
  let isScrolled = false;
  let ticking = false;

  const updateScroll = () => {
    const shouldBeScrolled = window.scrollY > 30;
    if (shouldBeScrolled !== isScrolled) {
      isScrolled = shouldBeScrolled;
      navbar?.classList.toggle("scrolled", isScrolled);
    }
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      window.requestAnimationFrame(updateScroll);
      ticking = true;
    }
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  // Initial check
  updateScroll();

  // Mobile menu
  const toggle = document.getElementById("lp-mobile-menu-btn");
  const menu = document.getElementById("lp-mobile-menu");
  const backdrop = document.getElementById("lp-mobile-backdrop");

  const closeMenu = () => {
    menu?.classList.remove("lp-menu-open");
    backdrop?.classList.remove("lp-menu-open");
    toggle?.classList.remove("lp-toggle-open");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("lp-menu-open");
    if (isOpen) {
      closeMenu();
      return;
    }
    menu?.classList.add("lp-menu-open");
    backdrop?.classList.add("lp-menu-open");
    toggle.classList.add("lp-toggle-open");
    toggle.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  });

  backdrop?.addEventListener("click", closeMenu);
  document
    .querySelectorAll(".lp-mobile-link")
    .forEach((link) => link.addEventListener("click", closeMenu));
</script>
