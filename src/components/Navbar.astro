---
const isHome = Astro.url.pathname === "/";
const homeHref = (hash: string) => (isHome ? hash : `/${hash}`);

const navigation = [
  { name: "Features", href: "/features" },
  { name: "How It Works", href: homeHref("#how-it-works") },
  { name: "Pricing", href: "/pricing" },
  { name: "Compare", href: "/compare" },
  { name: "About", href: "/about" },
];

const demoHref = "/free-trial";
---

<header
  id="lp-navbar"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
>
  <div class="lp-nav-inner mx-auto w-full max-w-6xl px-4 pt-3 sm:px-6 lg:px-8">
    <nav
      class="flex h-14 items-center justify-between rounded-full border border-white/[0.12] bg-[#0c0d12]/75 px-4 backdrop-blur-2xl sm:px-6 shadow-[0_8px_32px_rgba(0,0,0,0.5),inset_0_1px_1px_rgba(255,255,255,0.18)]"
      aria-label="Global"
    >
      <div class="flex pl-1 lg:flex-1 lg:pl-0">
        <a href="/" class="-m-1.5 p-1.5 focus-visible:ring-offset-0">
          <span class="sr-only">VoluChat</span>
          <div class="flex items-center gap-2.5">
            <img
              src="/voluchat_logo.svg"
              alt="VoluChat Logo"
              class="h-6 w-6 object-contain drop-shadow-[0_2px_8px_rgba(16,185,129,0.3)]"
            />
            <span
              class="hidden font-heading text-[1.05rem] font-bold tracking-tight text-[#fcfdff] sm:inline"
              >VoluChat</span
            >
          </div>
        </a>
      </div>

      <div class="hidden lg:flex lg:gap-x-7 items-center">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              class="nav-link relative py-1 text-[13px] font-medium text-[rgba(245,245,247,0.72)] transition-colors duration-200 hover:text-[#ffffff]"
            >
              {item.name}
            </a>
          ))
        }
      </div>

      <div class="hidden lg:flex lg:flex-1 lg:justify-end">
        <a
          href={demoHref}
          class="btn-primary !w-auto !px-4 !py-1.5 !text-[12.5px]"
        >
          30-Day Free Trial &rarr;
        </a>
      </div>

      <div class="flex items-center gap-2 lg:hidden">
        <a
          href={demoHref}
          class="inline-flex h-8 items-center justify-center rounded-full bg-[#fcfdff] px-3 text-[12px] font-medium text-[#000000] transition hover:bg-white shadow-[0_2px_8px_rgba(255,255,255,0.2)] whitespace-nowrap"
        >
          Free Trial &rarr;
        </a>
        <button
          type="button"
          id="lp-mobile-menu-btn"
          class="grid h-8 w-8 place-items-center rounded-full border border-white/[0.14] bg-white/[0.06] text-white backdrop-blur-xl transition hover:bg-white/10"
          aria-expanded="false"
        >
          <span class="sr-only">Open menu</span>
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="lp-mobile-backdrop"
    class="fixed inset-0 -z-10 bg-black/75 backdrop-blur-md lg:hidden"
    aria-hidden="true"
  >
  </div>
  <div
    id="lp-mobile-menu"
    class="fixed left-1/2 top-20 z-40 w-[calc(100%-2.5rem)] max-w-[22rem] rounded-2xl border border-white/[0.16] bg-[#0f1118]/85 p-4 backdrop-blur-2xl shadow-[0_20px_50px_rgba(0,0,0,0.8),inset_0_1px_1px_rgba(255,255,255,0.18)] lg:hidden"
    role="dialog"
    aria-modal="true"
  >
    <div class="flex flex-col gap-1.5">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="lp-mobile-link rounded-xl border border-white/[0.06] bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-[#fcfdff] transition hover:bg-white/[0.08]"
          >
            {item.name}
          </a>
        ))
      }
    </div>
  </div>
</header>

<style>
  #lp-navbar {
    transition: transform 0.3s ease;
  }

  /* Scroll-aware shrink + lift with a soft glow */
  #lp-navbar.scrolled .lp-nav-inner nav {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.20);
    background-color: rgba(10, 12, 18, 0.85);
    box-shadow:
      0 12px 36px -4px rgba(0, 0, 0, 0.7),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.25);
  }
  .lp-nav-inner nav {
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease,
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  /* Animated underline for desktop nav links */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1.5px;
    border-radius: 999px;
    background: linear-gradient(90deg, #2dd4bf, #5eeac9);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0.85;
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .lp-menu-line {
    display: block;
    grid-area: 1 / 1;
    height: 1.5px;
    width: 17px;
    border-radius: 999px;
    background: currentColor;
    transition:
      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.32s ease;
  }

  .lp-menu-a {
    transform: translateY(-3.5px);
  }
  .lp-menu-b {
    transform: translateY(3.5px);
  }

  #lp-mobile-menu,
  #lp-mobile-backdrop {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.28s ease,
      transform 0.28s ease,
      visibility 0.28s ease;
  }

  #lp-mobile-menu {
    transform: translateX(-50%) translateY(-10px) scale(0.98);
  }

  #lp-mobile-menu.lp-menu-open,
  #lp-mobile-backdrop.lp-menu-open {
    opacity: 1;
    visibility: visible;
  }

  #lp-mobile-menu.lp-menu-open {
    transform: translateX(-50%) translateY(0) scale(1);
  }

  #lp-mobile-backdrop.lp-menu-open {
    transform: none;
  }

  .lp-toggle-open .lp-menu-a {
    transform: translateY(0) rotate(45deg);
  }

  .lp-toggle-open .lp-menu-b {
    transform: translateY(0) rotate(-45deg);
  }
</style>

<script>
  // Scroll behavior
  const navbar = document.getElementById("lp-navbar");
  let navScrollFrame = 0;
  const onScroll = () => {
    if (navScrollFrame) return;
    navScrollFrame = window.requestAnimationFrame(() => {
      navScrollFrame = 0;
      navbar?.classList.toggle("scrolled", window.scrollY > 20);
    });
  };
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mobile menu
  const toggle = document.getElementById("lp-mobile-menu-btn");
  const menu = document.getElementById("lp-mobile-menu");
  const backdrop = document.getElementById("lp-mobile-backdrop");

  const closeMenu = () => {
    menu?.classList.remove("lp-menu-open");
    backdrop?.classList.remove("lp-menu-open");
    toggle?.classList.remove("lp-toggle-open");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("lp-menu-open");
    if (isOpen) {
      closeMenu();
      return;
    }
    menu?.classList.add("lp-menu-open");
    backdrop?.classList.add("lp-menu-open");
    toggle.classList.add("lp-toggle-open");
    toggle.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  });

  backdrop?.addEventListener("click", closeMenu);
  document
    .querySelectorAll(".lp-mobile-link")
    .forEach((link) => link.addEventListener("click", closeMenu));
</script>
