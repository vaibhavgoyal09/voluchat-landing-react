---
// Simple & Intuitive Revenue Recovery Calculator
---

<section id="roi-calculator" class="relative overflow-hidden py-16 sm:py-20 bg-[#000000] border-t border-white/[0.08]">
  <div class="page-shell">
    <!-- Header aligned with ProblemSection & HowItWorksFlow -->
    <div class="max-w-2xl mb-10">
      <div class="chip mb-3">
        <span class="mini-label text-emerald-400">Revenue Recovery Calculator</span>
      </div>
      <h2 class="section-title text-[#fcfdff] font-heading">
        How much extra sales can <span class="text-emerald-400">your boutique make</span>?
      </h2>
      <p class="section-copy mt-2 text-sm sm:text-base">
        See how much revenue you recover when night-time Reel comments and WhatsApp chats get answered in 2 seconds.
      </p>
    </div>

    <!-- 2-Column Balanced Deck with Apple Liquid Glass Style -->
    <div class="grid gap-6 lg:grid-cols-2 max-w-5xl mx-auto items-stretch">
      <!-- Left: Simple Inputs (Liquid Glass Panel) -->
      <div class="rounded-3xl border border-white/[0.12] bg-white/[0.04] backdrop-blur-2xl p-6 sm:p-8 flex flex-col justify-between shadow-[0_16px_40px_-10px_rgba(0,0,0,0.6),inset_0_1px_1.5px_rgba(255,255,255,0.16)]">
        <div class="space-y-6">
          <div class="flex items-center justify-between border-b border-white/[0.08] pb-3.5">
            <h3 class="font-heading text-base sm:text-lg font-semibold text-white">Your Monthly Numbers</h3>
            <span class="text-[11px] font-mono font-medium text-slate-300 bg-white/[0.06] border border-white/[0.12] px-3 py-0.5 rounded-full shadow-[inset_0_1px_1px_rgba(255,255,255,0.15)]">
              Interactive
            </span>
          </div>

          <!-- Slider 1: Messages -->
          <div class="space-y-2.5">
            <div class="flex justify-between items-center">
              <label for="calc-inquiries" class="text-sm font-medium text-slate-200">
                Monthly Inquiries &amp; Comments
              </label>
              <span id="label-inquiries" class="font-mono text-sm font-bold text-emerald-300 bg-emerald-500/15 border border-emerald-500/30 px-3 py-0.5 rounded-full shadow-[inset_0_1px_1px_rgba(255,255,255,0.15)]">
                1,500 chats
              </span>
            </div>
            <input
              type="range"
              id="calc-inquiries"
              min="300"
              max="10000"
              step="100"
              value="1500"
              class="w-full accent-emerald-400 h-2 bg-white/10 rounded-lg cursor-pointer"
            />
            <div class="flex justify-between text-[11px] font-mono text-slate-400">
              <span>300</span>
              <span>5,000</span>
              <span>10,000+</span>
            </div>
          </div>

          <!-- Slider 2: Average Outfit Price -->
          <div class="space-y-2.5">
            <div class="flex justify-between items-center">
              <label for="calc-aov" class="text-sm font-medium text-slate-200">
                Average Outfit Price
              </label>
              <span id="label-aov" class="font-mono text-sm font-bold text-emerald-300 bg-emerald-500/15 border border-emerald-500/30 px-3 py-0.5 rounded-full shadow-[inset_0_1px_1px_rgba(255,255,255,0.15)]">
                ₹2,800
              </span>
            </div>
            <input
              type="range"
              id="calc-aov"
              min="800"
              max="15000"
              step="100"
              value="2800"
              class="w-full accent-emerald-400 h-2 bg-white/10 rounded-lg cursor-pointer"
            />
            <div class="flex justify-between text-[11px] font-mono text-slate-400">
              <span>₹800</span>
              <span>₹7,500</span>
              <span>₹15,000</span>
            </div>
          </div>

          <!-- Direct Takeaway Box -->
          <div class="rounded-2xl border border-white/[0.08] bg-white/[0.03] backdrop-blur-md p-4 text-xs space-y-1.5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)]">
            <p class="font-semibold text-white flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
              Why this extra revenue is captured:
            </p>
            <p class="text-slate-300 leading-relaxed pl-4">
              Over 50% of boutique DMs arrive after 9 PM. When you reply in 2 seconds instead of the next morning, customers buy before clicking onto a competitor's Reel.
            </p>
          </div>
        </div>

        <p class="text-[11px] text-slate-400 mt-5 pt-3.5 border-t border-white/[0.06]">
          * Conservative estimate: calculates closing just 5 extra orders per 100 missed chats.
        </p>
      </div>

      <!-- Right: Clear Results (Emerald Liquid Glass) -->
      <div class="rounded-3xl border border-emerald-500/30 bg-emerald-950/20 backdrop-blur-2xl p-6 sm:p-8 flex flex-col justify-between shadow-[0_16px_40px_-10px_rgba(0,0,0,0.6),inset_0_1px_1.5px_rgba(255,255,255,0.2)] relative overflow-hidden">
        <div>
          <div class="flex items-center justify-between border-b border-emerald-500/20 pb-3.5">
            <h3 class="font-heading text-base sm:text-lg font-semibold text-white">Your Extra Revenue</h3>
            <span class="text-[11px] font-mono font-semibold text-emerald-300 bg-emerald-500/15 px-3 py-0.5 rounded-full border border-emerald-500/30 shadow-[inset_0_1px_1px_rgba(255,255,255,0.18)]">
              Every Month
            </span>
          </div>

          <div class="my-6">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-300 block font-semibold">Estimated New Monthly Sales</span>
            <div class="mt-2 flex items-baseline gap-2">
              <span id="stat-revenue" class="font-heading text-4xl sm:text-5xl font-bold text-white tracking-tight leading-none drop-shadow-sm">
                ₹2,10,000
              </span>
              <span class="text-emerald-400 text-sm font-semibold font-mono">/ mo</span>
            </div>
          </div>

          <!-- Key Metrics in Crisp Cards -->
          <div class="space-y-3 rounded-2xl bg-black/40 backdrop-blur-xl border border-white/[0.10] p-4 text-sm shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)]">
            <div class="flex justify-between items-center text-slate-200">
              <span>Extra orders closed:</span>
              <span id="stat-orders" class="font-bold text-white font-mono text-base">+75 orders</span>
            </div>
            <div class="flex justify-between items-center text-slate-200">
              <span>Time saved typing replies:</span>
              <span id="stat-hours" class="font-bold text-emerald-300 font-mono text-base">75 hrs / mo</span>
            </div>
            <div class="flex justify-between items-center text-slate-200">
              <span>Response time:</span>
              <span class="font-bold text-emerald-300 font-mono text-base">Instant (2.0s)</span>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-emerald-500/20 space-y-3">
          <a href="/free-trial" class="btn-primary !w-full justify-center text-center">
            Start 30-Day Free Trial &rarr;
          </a>
          <a
            href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary inline-flex !w-full items-center justify-center gap-2 text-center text-xs sm:text-sm"
          >
            💬 Test Drive the Bot on WhatsApp
          </a>
          <p class="text-center text-[11px] text-slate-400">
            Free 100% white-glove setup &bull; No credit card &bull; 30 days free
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const inquiriesInput = document.getElementById("calc-inquiries") as HTMLInputElement | null;
    const aovInput = document.getElementById("calc-aov") as HTMLInputElement | null;
    const labelInquiries = document.getElementById("label-inquiries");
    const labelAov = document.getElementById("label-aov");
    const statRevenue = document.getElementById("stat-revenue");
    const statOrders = document.getElementById("stat-orders");
    const statHours = document.getElementById("stat-hours");
    const statLeaks = document.getElementById("stat-leaks");

    // Realistic baseline: turning 5% of missed inquiries into completed orders
    const recoveryRate = 0.05;

    function updateCalc() {
      if (!inquiriesInput || !aovInput) return;
      const inquiries = parseInt(inquiriesInput.value, 10) || 1500;
      const aov = parseInt(aovInput.value, 10) || 2800;

      // Update input labels
      if (labelInquiries) labelInquiries.textContent = `${inquiries.toLocaleString("en-IN")} messages`;
      if (labelAov) labelAov.textContent = `₹${aov.toLocaleString("en-IN")}`;

      // Calculated numbers
      const additionalOrders = Math.round(inquiries * recoveryRate);
      const additionalRevenue = additionalOrders * aov;
      const lostNightChatsSaved = Math.round(inquiries * 0.50 * 0.65);
      const hoursSaved = Math.round((inquiries * 3) / 60);

      if (statRevenue) statRevenue.textContent = `₹${additionalRevenue.toLocaleString("en-IN")}`;
      if (statOrders) statOrders.textContent = `+${additionalOrders.toLocaleString("en-IN")} orders`;
      if (statLeaks) statLeaks.textContent = `~${lostNightChatsSaved.toLocaleString("en-IN")} buyers`;
      if (statHours) statHours.textContent = `${hoursSaved} hours / mo`;
    }

    if (inquiriesInput && aovInput) {
      inquiriesInput.addEventListener("input", updateCalc);
      aovInput.addEventListener("input", updateCalc);
    }

    updateCalc();
  });
</script>
