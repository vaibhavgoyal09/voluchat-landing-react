---
// Workload & Economics Estimator
---

<section id="roi-calculator" class="relative overflow-hidden py-28 sm:py-32 lg:py-36 bg-[#000000] border-t border-white/[0.08]">
  <div class="page-shell">
    <div class="max-w-3xl mb-16 lg:mb-20">
      <div class="chip mb-4">
        <span class="mini-label text-emerald-400">Revenue Estimator</span>
      </div>
      <h2 class="section-title font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
        How many sales could your <span class="text-emerald-400">AI Employee close</span>?
      </h2>
      <p class="section-copy mt-5 text-base sm:text-lg text-slate-400 font-normal leading-relaxed">
        Your AI employee handles sizing, checkout, tracking, and exchanges — 24/7. See the revenue impact.
      </p>
    </div>

    <!-- 2-Column Clean Interactive Estimator -->
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-14 max-w-5xl mx-auto items-start">
      <!-- Left: open inputs, hairline rows with generous spacing -->
      <div class="rounded-3xl border border-white/[0.08] bg-[#070709] p-8 sm:p-10 flex flex-col justify-between">
        <div class="space-y-8">
          <div class="flex items-center justify-between pb-4 border-b border-white/[0.08]">
            <h3 class="font-heading text-lg font-semibold text-white">Your Store Activity</h3>
            <span class="text-[10px] font-mono font-medium text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-0.5 rounded-full">
              Live Estimator
            </span>
          </div>

          <!-- Slider 1: Messages -->
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <label for="calc-inquiries" class="text-sm font-medium text-slate-200">
                Monthly Inquiries &amp; Comments
              </label>
              <span id="label-inquiries" class="font-mono text-sm font-bold text-white bg-white/[0.06] border border-white/[0.12] px-3 py-0.5 rounded-full">
                1,500 chats
              </span>
            </div>
            <input
              type="range"
              id="calc-inquiries"
              min="300"
              max="10000"
              step="100"
              value="1500"
              class="w-full accent-emerald-400 h-2 bg-white/10 rounded-lg cursor-pointer"
            />
            <div class="flex justify-between text-[11px] font-mono text-slate-500">
              <span>300</span>
              <span>5,000</span>
              <span>10,000+</span>
            </div>
          </div>

          <!-- Slider 2: Average Outfit Price -->
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <label for="calc-aov" class="text-sm font-medium text-slate-200">
                Average Outfit Price
              </label>
              <span id="label-aov" class="font-mono text-sm font-bold text-white bg-white/[0.06] border border-white/[0.12] px-3 py-0.5 rounded-full">
                ₹3,500
              </span>
            </div>
            <input
              type="range"
              id="calc-aov"
              min="1500"
              max="15000"
              step="100"
              value="3500"
              class="w-full accent-emerald-400 h-2 bg-white/10 rounded-lg cursor-pointer"
            />
            <div class="flex justify-between text-[11px] font-mono text-slate-500">
              <span>₹1,500</span>
              <span>₹7,500</span>
              <span>₹15,000</span>
            </div>
          </div>


        </div>

        <p class="text-[11px] text-slate-500 mt-8 pt-4 border-t border-white/[0.06]">
          * Illustrative model based on conservative conversion metrics.
        </p>
      </div>

      <!-- Right: Impact Model Card with high contrast and clean typography -->
      <div class="rounded-3xl border border-white/[0.08] bg-[#070709] p-8 sm:p-10 flex flex-col justify-between relative overflow-hidden">
        <div>
          <div class="flex items-center justify-between pb-4 border-b border-white/[0.08]">
            <h3 class="font-heading text-lg font-semibold text-white">Monthly Impact Model</h3>
            <span class="text-[10px] font-mono font-semibold text-emerald-300 bg-emerald-500/10 px-3 py-0.5 rounded-full border border-emerald-500/20">
              Revenue
            </span>
          </div>

          <div class="my-8">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-400 block font-medium">Estimated Recovered Boutique Revenue</span>
            <div class="mt-2 flex items-baseline gap-2">
              <span id="stat-revenue" class="font-heading text-4xl sm:text-5xl font-bold text-white tracking-tight leading-none">
                ₹2,10,000
              </span>
              <span class="text-emerald-400 text-sm font-semibold font-mono">/ mo</span>
            </div>
          </div>

          <!-- Key Metrics -->
          <div class="divide-y divide-white/[0.06] text-sm">
            <div class="flex justify-between items-center text-slate-300 py-3.5">
              <span>Chats handled:</span>
              <span id="stat-conversations" class="font-bold text-white font-mono text-base">1,125 chats</span>
            </div>
            <div class="flex justify-between items-center text-slate-300 py-3.5">
              <span>Hours saved:</span>
              <span id="stat-hours" class="font-bold text-white font-mono text-base">75 hrs / mo</span>
            </div>

          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-white/[0.08] space-y-3.5">
          <a href="/free-trial" class="btn-primary !w-full justify-center text-center">
            Start My 30-Day Free Trial &rarr;
          </a>
          <a
            href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary inline-flex !w-full items-center justify-center gap-2 text-center text-xs sm:text-sm"
          >
            💬 Test Drive on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupRoiCalc() {
    const inquiriesInput = document.getElementById("calc-inquiries") as HTMLInputElement | null;
    const aovInput = document.getElementById("calc-aov") as HTMLInputElement | null;

    const labelInquiries = document.getElementById("label-inquiries");
    const labelAov = document.getElementById("label-aov");

    const statRevenue = document.getElementById("stat-revenue");
    const statConversations = document.getElementById("stat-conversations");
    const statHours = document.getElementById("stat-hours");

    const conversionRate = 0.04;

    function updateCalc() {
      if (!inquiriesInput || !aovInput) return;
      const inquiries = parseInt(inquiriesInput.value, 10) || 1500;
      const aov = parseInt(aovInput.value, 10) || 3500;

      if (labelInquiries) labelInquiries.textContent = `${inquiries.toLocaleString("en-IN")} chats`;
      if (labelAov) labelAov.textContent = `₹${aov.toLocaleString("en-IN")}`;

      const handledUnassisted = Math.round(inquiries * 0.75);
      const hoursSaved = Math.round((handledUnassisted * 4) / 60);
      const potentialOrders = Math.round(handledUnassisted * conversionRate);
      const potentialRevenue = potentialOrders * aov;

      if (statRevenue) statRevenue.textContent = `₹${potentialRevenue.toLocaleString("en-IN")}`;
      if (statConversations) statConversations.textContent = `${handledUnassisted.toLocaleString("en-IN")} chats`;
      if (statHours) statHours.textContent = `${hoursSaved} hrs / mo`;
    }

    if (inquiriesInput && aovInput) {
      inquiriesInput.addEventListener("input", updateCalc);
      aovInput.addEventListener("input", updateCalc);
    }

    updateCalc();
  }

  setupRoiCalc();
  document.addEventListener("astro:page-load", setupRoiCalc);
</script>
