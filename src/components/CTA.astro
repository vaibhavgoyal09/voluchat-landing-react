---
<section class="w-full py-28 md:py-36 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="glass-panel-premium relative rounded-2xl overflow-hidden hover:scale-[1.01] hover:shadow-primary-700/10 hover:border-primary-500/20 transition-all duration-500 group/panel">
      <div class="absolute inset-0 pointer-events-none">
        <div class="sect-grid" style="opacity:0.08;"></div>
      </div>

      <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-12 p-10 md:p-12 lg:p-16">
        <div class="flex-1 text-center lg:text-left">
          <h3 class="text-4xl md:text-5xl font-heading font-semibold text-stone-950 leading-[1.1] tracking-tight mb-6">
            Ready to automate repeated questions?
          </h3>
          <p class="text-stone-600 text-base md:text-lg font-medium leading-relaxed max-w-xl mx-auto lg:mx-0">
            Start the 14-day free trial and we will help configure Instagram and Facebook Page replies, catalog answers, and sales handoffs around your real workflow.
          </p>
        </div>

        <div class="flex flex-col items-center gap-4 flex-shrink-0 w-full sm:w-auto">
          <a href="/contact" class="group relative flex items-center justify-center gap-3 w-full sm:w-auto px-10 py-5 bg-zinc-950 text-white rounded-2xl font-semibold text-base transition-all duration-300 hover:scale-[1.03] hover:bg-primary-700 hover:shadow-2xl hover:shadow-primary-700/15 overflow-hidden">
            <span class="relative z-10">Start 14-day free trial</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="relative z-10 transition-transform group-hover:translate-x-1.5">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
          </a>
          <span class="text-[10px] font-bold text-stone-400 uppercase tracking-widest">Guided setup included</span>
        </div>
      </div>
    </div>
  </div>
</section>
