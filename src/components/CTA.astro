---
---
<section class="w-full px-6 py-20 md:py-24">
  <div class="max-w-5xl mx-auto">
    <div class="dark-band relative overflow-hidden rounded-2xl transition-all duration-500 group/panel">
      <div class="absolute inset-0 pointer-events-none">
        <div class="sect-grid" style="opacity:0.08;"></div>
      </div>

      <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-12 p-10 md:p-12 lg:p-16">
        <div class="flex-1 text-center lg:text-left">
          <h3 class="mb-6 font-heading text-4xl font-semibold leading-[1.1] tracking-tight text-white md:text-5xl">
            Ready to turn more DMs into orders?
          </h3>
          <p class="mx-auto max-w-xl text-base font-medium leading-relaxed text-primary-50/78 md:text-lg lg:mx-0">
            Book a demo call and we will walk through your DM volume, current reply process, catalog, and WhatsApp order handoff.
          </p>
        </div>

        <div class="flex flex-col items-center gap-4 flex-shrink-0 w-full sm:w-auto">
          <a href="/contact" class="btn-primary group w-full gap-3 px-10 py-5 text-base sm:w-auto">
            <span class="relative z-10">Book demo call</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="relative z-10 transition-transform group-hover:translate-x-1.5">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <span class="text-[10px] font-bold uppercase tracking-widest text-primary-100/70">Founder-led setup included</span>
        </div>
      </div>
    </div>
  </div>
</section>
