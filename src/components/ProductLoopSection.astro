---
const loopSteps = [
  {
    number: "01",
    title: "Connect store data",
    desc: "Connects to Shopify to understand your products, variants, inventory levels, cart data, and customer history.",
  },
  {
    number: "02",
    title: "Detect opportunities",
    desc: "Monitors events continuously to spot abandoned carts, missed upsells, old-stock opportunities, and repeated support questions.",
  },
  {
    number: "03",
    title: "Recommend actions",
    desc: "Prepares a context-aware follow-up, cart recovery message, or upsell offer tailored to the exact customer segment.",
  },
  {
    number: "04",
    title: "Ask for approval",
    desc: "Keeps the human in control. Review the suggested action and approve it before the AI talks to your customers.",
  },
  {
    number: "05",
    title: "Execute follow-up",
    desc: "Sends the message through your preferred channel or exports a ready-to-use campaign list for your marketing tool.",
  },
  {
    number: "06",
    title: "Attribute outcome",
    desc: "Tracks the result of the action, clearly showing you recovered carts, cleared stock, and the exact revenue generated.",
  },
];
---

<section
  id="how-it-works"
  class="relative overflow-hidden border-y border-white/10 bg-[#0b1828] py-20 sm:py-24"
>
  <div class="page-shell">
    <div class="loop-header mx-auto mb-12 max-w-3xl text-center opacity-0">
      <div class="chip mb-5">
        <span class="mini-label">The Core Loop</span>
      </div>
      <h2 class="section-title text-white font-heading">
        How VoluChat turns store signals into <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-teal-200 to-emerald-400"
          >approved actions</span
        >
      </h2>
      <p class="mt-5 section-copy text-center text-slate-300">
        It watches your Shopify data, spots revenue opportunities, drafts the
        right action, asks for approval when needed, and tracks what happened.
      </p>
    </div>

    <div class="relative mx-auto max-w-5xl">
      <!-- Glow gradient connecting vertical route -->
      <div
        class="loop-line absolute left-[27px] top-[40px] bottom-[40px] w-px bg-gradient-to-b from-teal-500/50 via-white/10 to-teal-500/50 lg:left-1/2 lg:-ml-[0.5px] origin-top scale-y-0"
      >
      </div>

      <div class="space-y-8 lg:space-y-10">
        {
          loopSteps.map((step, index) => (
            <div
              class={`loop-step group relative flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 lg:gap-10 ${index % 2 === 0 ? "lg:flex-row" : "lg:flex-row-reverse"} opacity-0`}
            >
              {/* Staggered Number Badge in center */}
              <div class="absolute left-0 top-0 lg:left-1/2 lg:top-1/2 z-10 flex h-12 w-12 items-center justify-center rounded-full border-[4px] border-[#07121d] bg-[#0d192b] lg:-ml-6 lg:-mt-6">
                <div class="flex h-8 w-8 items-center justify-center rounded-full border border-teal-500/20 bg-teal-500/5 font-mono text-[11px] font-bold text-teal-300 group-hover:bg-teal-400 group-hover:text-slate-950 group-hover:border-teal-300 group-hover:scale-105 transition-all duration-300 shadow-[0_0_12px_rgba(45,212,191,0.15)]">
                  {step.number}
                </div>
              </div>

              {/* Content Card */}
              <div class="ml-16 lg:ml-0 w-[calc(100%-4rem)] lg:w-[calc(50%-2.25rem)] rounded-2xl border border-white/10 bg-[#0d192b]/60 backdrop-blur-md p-5 sm:p-6 hover:bg-[#142438]/80 hover:border-teal-500/30 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 shadow-[0_24px_60px_-48px_rgba(0,0,0,0.85)]">
                <span class="text-[10px] font-bold text-teal-300 uppercase tracking-widest">
                  Step {step.number}
                </span>
                <h3 class="text-lg font-bold text-white mt-2 font-heading">
                  {step.title}
                </h3>
                <p class="text-sm text-slate-300 font-medium leading-relaxed mt-1.5">
                  {step.desc}
                </p>

                {/* Inline Contextual Mockups for each loop step */}
                {index === 0 && (
                  <div class="mt-4 flex items-center gap-2 rounded-xl bg-teal-500/5 border border-teal-500/10 px-3 py-2 w-fit text-[11px] font-mono text-teal-200">
                    <span class="h-1.5 w-1.5 rounded-full bg-teal-400 animate-pulse" />
                    Shopify Store Connected
                  </div>
                )}

                {index === 1 && (
                  <div class="mt-4 flex items-center gap-2 rounded-xl bg-red-500/5 border border-red-500/10 px-3 py-2 w-fit text-[11px] font-mono text-red-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-red-400 animate-pulse" />
                    Scanning active checkouts...
                  </div>
                )}

                {index === 2 && (
                  <div class="mt-4 rounded-xl bg-white/[0.02] border border-white/5 p-3 text-[11px] text-slate-400 font-mono">
                    <div class="text-[9px] uppercase tracking-wider text-slate-300 font-bold mb-1">
                      Drafting Offer
                    </div>
                    <p class="text-white font-medium">
                      "Still interested in Aero Runners? Checkout link ready."
                    </p>
                  </div>
                )}

                {index === 3 && (
                  <div class="mt-4 flex items-center gap-2 text-[11px] font-mono">
                    <span class="rounded-lg bg-white text-slate-950 px-3 py-1.5 font-bold cursor-default hover:bg-slate-200 transition">
                      Approve
                    </span>
                    <span class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 font-semibold text-slate-400 cursor-default">
                      Ignore
                    </span>
                  </div>
                )}

                {index === 4 && (
                  <div class="mt-4 flex items-center gap-2 text-[11px] text-slate-400 font-mono">
                    <span class="rounded-full bg-teal-300/10 border border-teal-300/25 px-2 py-0.5 text-teal-300 font-bold">
                      WhatsApp
                    </span>
                    <span>&rarr; Dispatched successfully</span>
                  </div>
                )}

                {index === 5 && (
                  <div class="mt-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 p-3 flex justify-between items-center shadow-inner">
                    <div>
                      <span class="text-[9px] uppercase text-emerald-400 font-bold font-mono">
                        Sample Attributed Revenue
                      </span>
                      <p class="text-lg font-bold text-white mt-0.5">
                        Example recovery
                      </p>
                    </div>
                    <span class="text-[10px] font-bold font-mono text-emerald-300 bg-emerald-400/10 px-2 py-1 rounded-md border border-emerald-500/15">
                      Attributed
                    </span>
                  </div>
                )}
              </div>
              {/* Empty space for staggered layout on desktop */}
              <div class="hidden lg:block lg:w-[calc(50%-2.25rem)]" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // 1. Header fades in
    gsap.fromTo(".loop-header",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", scrollTrigger: { trigger: "#how-it-works", start: "top 80%" } }
    );

    // 2. Center line draws itself down
    gsap.to(".loop-line", {
      scaleY: 1,
      duration: 1.5,
      ease: "power3.inOut",
      scrollTrigger: {
        trigger: ".loop-line",
        start: "top 60%",
      }
    });

    // 3. Each step triggers individually as you scroll to it
    const steps = gsap.utils.toArray('.loop-step');
    steps.forEach((step: any, index: number) => {
      const isEven = index % 2 === 0;
      gsap.fromTo(step, 
        { opacity: 0, x: isEven ? -40 : 40, y: 30 },
        { 
          opacity: 1, x: 0, y: 0, 
          duration: 0.7, 
          ease: "power2.out",
          scrollTrigger: {
            trigger: step,
            start: "top 85%",
            toggleActions: "play reverse play reverse"
          }
        }
      );
    });
  });
</script>
