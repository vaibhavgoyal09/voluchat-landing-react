---
const loopSteps = [
  {
    number: "01",
    title: "Connect store data",
    desc: "Connects to Shopify to understand your products, variants, inventory levels, cart data, and customer history.",
  },
  {
    number: "02",
    title: "Detect opportunities",
    desc: "Monitors events continuously to spot abandoned carts, missed upsells, old-stock opportunities, and repeated support questions.",
  },
  {
    number: "03",
    title: "Recommend actions",
    desc: "Prepares a context-aware follow-up, cart recovery message, or upsell offer tailored to the exact customer segment.",
  },
  {
    number: "04",
    title: "Ask for approval",
    desc: "Keeps the human in control. Review the suggested action and approve it before the AI talks to your customers.",
  },
  {
    number: "05",
    title: "Execute follow-up",
    desc: "Sends the message through your preferred channel or exports a ready-to-use campaign list for your marketing tool.",
  },
  {
    number: "06",
    title: "Attribute outcome",
    desc: "Tracks the result of the action, clearly showing you recovered carts, cleared stock, and the exact revenue generated.",
  },
];
---

<section
  id="how-it-works"
  class="relative overflow-hidden border-y border-white/10 bg-[#0b1828] py-24 sm:py-32"
>
  <div class="page-shell">
    <div class="mx-auto max-w-3xl text-center mb-20">
      <div class="reveal-on-scroll chip mb-6">
        <span class="mini-label">The Core Loop</span>
      </div>
      <h2 class="reveal-on-scroll section-title text-white font-heading">
        How VoluChat turns store signals into <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-teal-200 to-emerald-400"
          >approved actions</span
        >
      </h2>
      <p class="reveal-on-scroll mt-6 section-copy text-center text-slate-300">
        It watches your Shopify data, spots revenue opportunities, drafts the
        right action, asks for approval when needed, and tracks what happened.
      </p>
    </div>

    <div class="relative mx-auto max-w-5xl">
      <!-- Glow gradient connecting vertical route -->
      <div
        class="absolute left-[27px] top-[40px] bottom-[40px] w-px bg-gradient-to-b from-teal-500/50 via-white/10 to-teal-500/50 lg:left-1/2 lg:-ml-[0.5px]"
      >
      </div>

      <div class="space-y-12 lg:space-y-20">
        {
          loopSteps.map((step, index) => (
            <div
              class={`reveal-on-scroll group relative flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 lg:gap-16 ${index % 2 === 0 ? "lg:flex-row" : "lg:flex-row-reverse"}`}
            >
              {/* Staggered Number Badge in center */}
              <div class="absolute left-0 top-0 lg:left-1/2 lg:top-1/2 z-10 flex h-[56px] w-[56px] items-center justify-center rounded-full border-[4px] border-[#07121d] bg-[#0d192b] lg:-ml-[28px] lg:-mt-[28px]">
                <div class="flex h-9 w-9 items-center justify-center rounded-full border border-teal-500/20 bg-teal-500/5 font-mono text-xs font-bold text-teal-300 group-hover:bg-teal-400 group-hover:text-slate-950 group-hover:border-teal-300 group-hover:scale-105 transition-all duration-300 shadow-[0_0_12px_rgba(45,212,191,0.15)]">
                  {step.number}
                </div>
              </div>

              {/* Content Card */}
              <div class="ml-20 lg:ml-0 w-[calc(100%-5rem)] lg:w-[calc(50%-3rem)] rounded-[2rem] border border-white/10 bg-[#0d192b]/60 backdrop-blur-md p-6 sm:p-8 hover:bg-[#142438]/80 hover:border-teal-500/30 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 shadow-[0_24px_60px_-48px_rgba(0,0,0,0.85)]">
                <span class="text-[10px] font-bold text-teal-300 uppercase tracking-widest">
                  Step {step.number}
                </span>
                <h3 class="text-xl font-bold text-white mt-2 font-heading">
                  {step.title}
                </h3>
                <p class="text-sm text-slate-300 font-medium leading-relaxed mt-2">
                  {step.desc}
                </p>

                {/* Inline Contextual Mockups for each loop step */}
                {index === 0 && (
                  <div class="mt-5 flex items-center gap-2 rounded-xl bg-teal-500/5 border border-teal-500/10 px-3 py-2 w-fit text-[11px] font-mono text-teal-200">
                    <span class="h-1.5 w-1.5 rounded-full bg-teal-400 animate-pulse" />
                    Shopify Store Connected
                  </div>
                )}

                {index === 1 && (
                  <div class="mt-5 flex items-center gap-2 rounded-xl bg-red-500/5 border border-red-500/10 px-3 py-2 w-fit text-[11px] font-mono text-red-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-red-400 animate-pulse" />
                    Scanning active checkouts...
                  </div>
                )}

                {index === 2 && (
                  <div class="mt-5 rounded-xl bg-white/[0.02] border border-white/5 p-3.5 text-[11px] text-slate-400 font-mono">
                    <div class="text-[9px] uppercase tracking-wider text-slate-500 font-bold mb-1">
                      Drafting Offer
                    </div>
                    <p class="text-white font-medium">
                      "Still interested in Aero Runners? Checkout link ready."
                    </p>
                  </div>
                )}

                {index === 3 && (
                  <div class="mt-5 flex items-center gap-2 text-[11px] font-mono">
                    <span class="rounded-lg bg-white text-slate-950 px-3 py-1.5 font-bold cursor-default hover:bg-slate-200 transition">
                      Approve
                    </span>
                    <span class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 font-semibold text-slate-400 cursor-default">
                      Ignore
                    </span>
                  </div>
                )}

                {index === 4 && (
                  <div class="mt-5 flex items-center gap-2 text-[11px] text-slate-400 font-mono">
                    <span class="rounded-full bg-teal-300/10 border border-teal-300/25 px-2 py-0.5 text-teal-300 font-bold">
                      WhatsApp
                    </span>
                    <span>&rarr; Dispatched successfully</span>
                  </div>
                )}

                {index === 5 && (
                  <div class="mt-5 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 p-3.5 flex justify-between items-center shadow-inner">
                    <div>
                      <span class="text-[9px] uppercase text-emerald-400 font-bold font-mono">
                        Sample Attributed Revenue
                      </span>
                      <p class="text-lg font-bold text-white mt-0.5">
                        Example recovery
                      </p>
                    </div>
                    <span class="text-[10px] font-bold font-mono text-emerald-300 bg-emerald-400/10 px-2 py-1 rounded-md border border-emerald-500/15">
                      Attributed
                    </span>
                  </div>
                )}
              </div>
              {/* Empty space for staggered layout on desktop */}
              <div class="hidden lg:block lg:w-[calc(50%-3rem)]" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
