---
const loopSteps = [
  {
    number: "01",
    title: "Reel / Ad Comment Detected",
    desc: "A prospective shopper comments 'Price please', 'Available?', or drops an emoji on your Instagram post, Reel, or Meta ad.",
  },
  {
    number: "02",
    title: "Instant 2-Second IG Direct Message",
    desc: "VoluChat triggers a personalized DM with exact pricing, high-res photos, size availability, and answers pre-purchase questions.",
  },
  {
    number: "03",
    title: "1-Click WhatsApp Handoff",
    desc: "When the buyer is ready to purchase, VoluChat transfers them seamlessly to your official WhatsApp Business chat with all context intact.",
  },
  {
    number: "04",
    title: "Conversational Objection Handling",
    desc: "The WhatsApp AI checks real-time inventory, calculates delivery estimates for their specific pincode, and handles sizing or COD doubts.",
  },
  {
    number: "05",
    title: "In-DM Native Order & UPI Payment",
    desc: "Pushes a 1-click UPI / Razorpay payment link or native WhatsApp catalog order with an optional pre-payment discount to prevent RTO.",
  },
  {
    number: "06",
    title: "Shopify Sync & Automated Tracking",
    desc: "Creates a paid order in your Shopify admin, reserves inventory, and dispatches automated delivery tracking directly in WhatsApp.",
  },
];
---

<section
  id="revenue-loop"
  class="relative overflow-hidden border-y border-white/10 bg-[#08111d] py-20 sm:py-28"
>
  <div class="page-shell">
    <div class="loop-header mx-auto mb-14 max-w-3xl text-center opacity-0">
      <div class="chip mb-5">
        <span class="mini-label">The Social Revenue Loop</span>
      </div>
      <h2 class="section-title text-white font-heading">
        How an Instagram comment turns into a <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-emerald-400"
          >completed order in 90 seconds</span
        >
      </h2>
      <p class="mt-5 section-copy text-center text-slate-300">
        No lost leads. No flowchart buttons. No manual typing. Just an intelligent conversational closer that never sleeps.
      </p>
    </div>

    <div class="relative mx-auto max-w-5xl">
      <!-- Glow gradient connecting vertical route -->
      <div
        class="loop-line absolute left-[27px] top-[40px] bottom-[40px] w-px bg-gradient-to-b from-emerald-500/50 via-teal-400/20 to-emerald-500/50 lg:left-1/2 lg:-ml-[0.5px] origin-top scale-y-0"
      >
      </div>

      <div class="space-y-8 lg:space-y-10">
        {
          loopSteps.map((step, index) => (
            <div
              class={`loop-step group relative flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 lg:gap-10 ${index % 2 === 0 ? "lg:flex-row" : "lg:flex-row-reverse"} opacity-0`}
            >
              {/* Staggered Number Badge in center */}
              <div class="absolute left-0 top-0 lg:left-1/2 lg:top-1/2 z-10 flex h-12 w-12 items-center justify-center rounded-full border-[4px] border-[#07121d] bg-[#0d192b] lg:-ml-6 lg:-mt-6">
                <div class="flex h-8 w-8 items-center justify-center rounded-full border border-emerald-500/30 bg-emerald-500/10 font-mono text-[11px] font-bold text-emerald-300 group-hover:bg-emerald-400 group-hover:text-slate-950 group-hover:border-emerald-300 group-hover:scale-105 transition-all duration-300 shadow-[0_0_14px_rgba(16,185,129,0.25)]">
                  {step.number}
                </div>
              </div>

              {/* Content Card */}
              <div class="ml-16 lg:ml-0 w-[calc(100%-4rem)] lg:w-[calc(50%-2.25rem)] rounded-2xl border border-white/10 bg-[#0c1626]/80 backdrop-blur-md p-6 hover:bg-[#112035]/90 hover:border-emerald-500/40 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 shadow-[0_24px_60px_-48px_rgba(0,0,0,0.85)]">
                <span class="text-[10px] font-bold text-emerald-400 uppercase tracking-widest">
                  Step {step.number}
                </span>
                <h3 class="text-xl font-bold text-white mt-2 font-heading">
                  {step.title}
                </h3>
                <p class="text-sm text-slate-300 font-medium leading-relaxed mt-2">
                  {step.desc}
                </p>

                {/* Contextual badge preview */}
                {index === 0 && (
                  <div class="mt-4 flex items-center gap-2 rounded-xl bg-pink-500/10 border border-pink-500/20 px-3 py-2 w-fit text-[11px] font-mono text-pink-200">
                    <span class="h-1.5 w-1.5 rounded-full bg-pink-400 animate-pulse" />
                    Reel #849 &bull; 48 comments/hr
                  </div>
                )}

                {index === 1 && (
                  <div class="mt-4 rounded-xl bg-white/[0.03] border border-white/10 p-3 text-[11px] text-slate-300 font-mono">
                    <span class="text-emerald-400 font-bold block mb-1">⚡ Auto DM dispatched:</span>
                    "Hey! Emerald Kurta is ₹2,899 (Size S-XXL in stock)..."
                  </div>
                )}

                {index === 2 && (
                  <div class="mt-4 flex items-center gap-2 rounded-xl bg-emerald-500/10 border border-emerald-500/20 px-3 py-2 w-fit text-[11px] font-mono text-emerald-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-[#25D366] animate-pulse" />
                    Transferred to WhatsApp with SKU & size context
                  </div>
                )}

                {index === 3 && (
                  <div class="mt-4 rounded-xl bg-slate-900/80 border border-white/10 p-3 text-[11px] text-slate-300 font-mono">
                    <span class="text-slate-400 block text-[10px] uppercase font-bold mb-1">Pincode SLA Checked:</span>
                    "Express 2-day delivery available to Delhi (110001)."
                  </div>
                )}

                {index === 4 && (
                  <div class="mt-4 flex items-center gap-2 rounded-xl bg-[#25D366]/15 border border-[#25D366]/30 px-3 py-2 w-fit text-[11px] font-mono text-emerald-200">
                    <span class="font-bold text-white">UPI Pay Link:</span>
                    <span>₹2,899 generated in-chat</span>
                  </div>
                )}

                {index === 5 && (
                  <div class="mt-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 p-3 flex justify-between items-center shadow-inner">
                    <div>
                      <span class="text-[9px] uppercase text-emerald-400 font-bold font-mono">
                        Shopify Order Synced
                      </span>
                      <p class="text-base font-bold text-white mt-0.5">
                        Order #4829 Paid & Fulfilled
                      </p>
                    </div>
                    <span class="text-[10px] font-bold font-mono text-emerald-300 bg-emerald-400/10 px-2 py-1 rounded-md border border-emerald-500/20">
                      ✓ Done
                    </span>
                  </div>
                )}
              </div>
              {/* Empty space for staggered layout on desktop */}
              <div class="hidden lg:block lg:w-[calc(50%-2.25rem)]" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    gsap.fromTo(".loop-header",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", scrollTrigger: { trigger: "#revenue-loop", start: "top 80%" } }
    );

    gsap.to(".loop-line", {
      scaleY: 1,
      duration: 1.5,
      ease: "power3.inOut",
      scrollTrigger: {
        trigger: ".loop-line",
        start: "top 60%",
      }
    });

    const steps = gsap.utils.toArray('.loop-step');
    steps.forEach((step: any, index: number) => {
      const isEven = index % 2 === 0;
      gsap.fromTo(step, 
        { opacity: 0, x: isEven ? -40 : 40, y: 30 },
        { 
          opacity: 1, x: 0, y: 0, 
          duration: 0.7, 
          ease: "power2.out",
          scrollTrigger: {
            trigger: step,
            start: "top 85%",
            toggleActions: "play none none reverse"
          }
        }
      );
    });
  });
</script>
