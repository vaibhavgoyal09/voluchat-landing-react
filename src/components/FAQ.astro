---
const faqs = [
  {
    question: "How does VoluChat help stores reply faster on Instagram and Facebook?",
    answer: "VoluChat answers common product questions from comments and DMs, collects size and delivery details, and prepares a WhatsApp order message before the shopper loses interest.",
  },
  {
    question: "Can VoluChat find products from photos or shopper messages?",
    answer: "Yes. Shoppers can describe a product, ask for a size or shade, or send an image. VoluChat can use your catalog to suggest relevant matches.",
  },
  {
    question: "Does VoluChat replace the human touch?",
    answer: "No. VoluChat handles repeat questions and detail collection. Your store still confirms the order, shares payment details, and steps in when the chat needs a person.",
  },
  {
    question: "Does VoluChat create the WhatsApp checkout message?",
    answer: "Yes. After collecting products, variant choices, quantity, and delivery address, VoluChat prepares WhatsApp text so the order is easier to confirm.",
  },
  {
    question: "Does VoluChat manage cart, address, and offer details?",
    answer: "Yes. It can collect product, size, color, quantity, shipping address, COD preference, and discount or offer-code details before the final payment step.",
  },
  {
    question: "Does VoluChat process orders or payments?",
    answer: "No. Your store still handles final confirmation and payment details. Most stores send their UPI QR code or payment instructions after VoluChat prepares the order message.",
  },
  {
    question: "How is VoluChat different from Manychat, WATI, Interakt, respond.io, AiSensy, or Gallabox?",
    answer: "Those tools are strong options when you need broad automation. VoluChat is focused on faster setup for Instagram and Facebook product conversations, comment-to-DM flows, and ready-to-confirm order chats.",
  },
  {
    question: "Do I need technical knowledge to use it?",
    answer: "No. You get help connecting Instagram and Facebook Pages, adding catalog details, tuning replies, and setting up WhatsApp order messages.",
  },
  {
    question: "How much does VoluChat cost?",
    answer: "Early access pricing is Rs. 5,000 for one-time setup and Rs. 3,000 per month, with a 30-day money-back guarantee.",
  },
];
---

<section id="faq" class="section-pad relative overflow-hidden">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-20"></div>
  </div>

  <div class="page-shell">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <p class="section-eyebrow">FAQ</p>
      <h2 class="section-title mt-4">
        Common questions
      </h2>
      <p class="section-copy mx-auto mt-5 max-w-xl">
        The practical details store owners usually ask before connecting Instagram and Facebook.
      </p>
    </div>

    <div class="mx-auto max-w-3xl divide-y divide-stone-100 overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-[0_18px_60px_rgba(28,25,23,0.07)]">
      {faqs.slice(0, 7).map((faq, index) => (
        <div class="faq-item transition-all duration-300" data-index={index}>
          <button class="faq-toggle group flex w-full items-center justify-between gap-6 px-6 py-5 sm:px-8 sm:py-6 text-left transition-colors hover:bg-stone-50/70">
            <span class="font-heading text-base sm:text-lg font-semibold leading-snug tracking-tight text-stone-950 transition-colors group-hover:text-primary-800">
              {faq.question}
            </span>
            <span class="faq-icon-wrap flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border border-stone-100 bg-white shadow-sm transition-all duration-300 group-hover:border-primary-100 group-hover:bg-primary-50">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="faq-chevron text-stone-400 transition-all duration-300 group-hover:text-primary-700">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-all duration-500 ease-in-out">
            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
              <p class="text-xs sm:text-sm font-semibold leading-relaxed text-stone-600">{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item.active {
    background-color: rgba(68, 64, 60, 0.035);
  }
  .faq-item.active .faq-chevron {
    transform: rotate(180deg);
    color: #1c1917;
  }
  .faq-item.active .faq-icon-wrap {
    background-color: #f5f5f4;
    border-color: #e7e5e4;
  }
  .faq-item.active .faq-body {
    max-height: 420px;
  }
</style>

<script>
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(item => {
    item.querySelector('.faq-toggle')?.addEventListener('click', () => {
      const isActive = item.classList.contains('active');
      faqItems.forEach(i => i.classList.remove('active'));
      if (!isActive) item.classList.add('active');
    });
  });
</script>
