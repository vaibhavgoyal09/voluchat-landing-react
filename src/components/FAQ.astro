---
import { faqs } from "../lib/faqSchema.mjs";
---

<section
  id="faq"
  class="section-pad section-band-quiet relative overflow-hidden bg-[#000000] border-t border-white/[0.08]"
>
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-20"></div>
  </div>

  <div class="page-shell">
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <div class="chip mb-4 mx-auto inline-flex">
        <span class="mini-label text-emerald-400">Questions &amp; Answers</span>
      </div>
      <h2 class="section-title font-heading mt-2">
        Frequently asked <em class="serif-accent">questions</em>.
      </h2>
      <p class="section-copy mx-auto mt-4 max-w-xl">
        Everything boutique founders want to know about hiring an AI Employee for online operations.
      </p>
    </div>

    <div
      class="reveal-on-scroll mx-auto max-w-3xl border-t border-white/[0.08]"
    >
      {
        faqs.map((faq, index) => (
          <div class="faq-item border-b border-white/[0.08] transition-colors duration-200" data-index={index}>
            <button class="faq-toggle group flex w-full items-center justify-between gap-6 py-6 text-left transition-colors">
              <span class="font-heading text-lg sm:text-xl font-semibold leading-snug tracking-tight text-[#f5f5f7] transition-colors group-hover:text-emerald-300">
                {faq.question}
              </span>
              <span class="faq-icon-wrap flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/[0.14] bg-transparent transition-colors duration-200 group-hover:border-emerald-500/40">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="faq-chevron text-slate-400 transition-[transform,color] duration-200 group-hover:text-emerald-300"
                >
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </span>
            </button>
            <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-200 ease-out">
              <div class="pb-7">
                <p class="text-base font-normal leading-relaxed text-[#86868b]">
                  {faq.answer}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  function setupFaqAccordion() {
    const items = document.querySelectorAll(".faq-item");

    items.forEach((item) => {
      const toggle = item.querySelector(".faq-toggle");
      const body = item.querySelector(".faq-body") as HTMLElement | null;
      const chevron = item.querySelector(".faq-chevron");

      if (!toggle || !body) return;

      toggle.addEventListener("click", () => {
        const isOpen = body.style.maxHeight && body.style.maxHeight !== "0px";

        // Close all
        items.forEach((other) => {
          const otherBody = other.querySelector(".faq-body") as HTMLElement | null;
          const otherChevron = other.querySelector(".faq-chevron");
          if (otherBody) otherBody.style.maxHeight = "0px";
          if (otherChevron) otherChevron.classList.remove("rotate-180");
        });

        // Toggle clicked
        if (!isOpen) {
          body.style.maxHeight = body.scrollHeight + "px";
          if (chevron) chevron.classList.add("rotate-180");
        }
      });
    });
  }

  setupFaqAccordion();
  document.addEventListener("astro:page-load", setupFaqAccordion);
</script>
