---
import { faqs as defaultFaqs } from "../lib/faqSchema.mjs";

interface FaqItem {
  question: string;
  answer: string;
}

const { faqs: customFaqs } = Astro.props as { faqs?: FaqItem[] };
const faqs = customFaqs && customFaqs.length > 0 ? customFaqs : defaultFaqs;
---

<section
  id="faq"
  class="section-pad section-band-quiet relative overflow-hidden bg-[#f8fafc] border-t border-slate-200/80"
>
  <div class="page-shell">
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <div class="chip-emerald mb-4 mx-auto inline-flex">
        <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-700">Questions &amp; Answers</span>
      </div>
      <h2 class="section-title font-heading mt-2 text-slate-900">
        Frequently asked <em class="serif-accent">questions</em>.
      </h2>
      <p class="section-copy mx-auto mt-4 max-w-xl text-slate-600">
        Everything boutique founders want to know about setting up an AI Sales Agent for online operations.
      </p>
    </div>

    <div
      class="reveal-on-scroll mx-auto max-w-3xl border-t border-slate-200/80"
    >
      {
        faqs.map((faq, index) => (
          <div class="faq-item border-b border-slate-200/80 transition-colors duration-200" data-index={index}>
            <button class="faq-toggle group flex w-full items-center justify-between gap-6 py-6 text-left transition-colors">
              <span class="font-heading text-lg sm:text-xl font-semibold leading-snug tracking-tight text-slate-900 transition-colors group-hover:text-emerald-700">
                {faq.question}
              </span>
              <span class="faq-icon-wrap flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white transition-colors duration-200 group-hover:border-emerald-500 shadow-2xs">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="faq-chevron text-slate-500 transition-[transform,color] duration-200 group-hover:text-emerald-700"
                >
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </span>
            </button>
            <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-200 ease-out">
              <div class="pb-7">
                <p class="text-base font-normal leading-relaxed text-slate-600">
                  {faq.answer}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  function setupFaqAccordion() {
    const items = document.querySelectorAll(".faq-item");

    items.forEach((item) => {
      const toggle = item.querySelector(".faq-toggle");
      const body = item.querySelector(".faq-body") as HTMLElement | null;
      const chevron = item.querySelector(".faq-chevron");

      if (!toggle || !body) return;

      toggle.addEventListener("click", () => {
        const isOpen = body.style.maxHeight && body.style.maxHeight !== "0px";

        // Close all
        items.forEach((other) => {
          const otherBody = other.querySelector(".faq-body") as HTMLElement | null;
          const otherChevron = other.querySelector(".faq-chevron");
          if (otherBody) otherBody.style.maxHeight = "0px";
          if (otherChevron) otherChevron.classList.remove("rotate-180");
        });

        // Toggle clicked
        if (!isOpen) {
          body.style.maxHeight = body.scrollHeight + "px";
          if (chevron) chevron.classList.add("rotate-180");
        }
      });
    });
  }

  setupFaqAccordion();
  document.addEventListener("astro:page-load", setupFaqAccordion);
</script>
