---
const faqs = [
  {
    question: "Is VoluChat safe for my Instagram account?",
    answer: "VoluChat connects through official Meta APIs, so you do not share your Instagram password with us.",
  },
  {
    question: "Do I need technical knowledge to use it?",
    answer: "No. Founding stores get hands-on setup help for Instagram, shoe details, buyer messages, and WhatsApp handoff.",
  },
  {
    question: "What happens after a customer comments on my Reel?",
    answer: "VoluChat can send the buyer an Instagram DM, ask helpful questions, answer common product details, and guide them to WhatsApp when they are ready.",
  },
  {
    question: "How does the WhatsApp handoff work?",
    answer: "When the buyer is ready, VoluChat opens WhatsApp with useful details like the shoe, size, color, budget, and question they asked. Your team can then process the order manually.",
  },
  {
    question: "Can VoluChat answer shoe-specific questions?",
    answer: "Yes. You can add product names, prices, sizes, colors, photos, stock notes, and delivery details so buyers get clearer answers in Instagram DM.",
  },
  {
    question: "Does it support Hindi or Hinglish?",
    answer: "VoluChat can be set up for English, Hindi, and Hinglish buyer messages. We can tune the tone during onboarding.",
  },
  {
    question: "How much does VoluChat cost?",
    answer: "Pricing is shared after a demo because founding stores may need different setup support depending on catalog size, message volume, and WhatsApp workflow.",
  },
];
---

<section id="faq" class="py-20 md:py-32 relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none -z-10">
    <div class="sect-grid"></div>
  </div>

  <div class="max-w-2xl mx-auto px-6">
    <div class="text-center mb-14">
      <span class="section-badge mb-5 inline-flex">FAQ</span>
      <h2 class="text-4xl sm:text-6xl font-heading font-bold text-slate-900 mb-6 leading-[1.1] tracking-tight">
        Common Questions
      </h2>
    </div>

    <div class="glass-panel-premium divide-y divide-slate-100 rounded-[2.5rem] overflow-hidden shadow-2xl">
      {faqs.map((faq, index) => (
        <div class="faq-item" data-index={index}>
          <button class="faq-toggle w-full py-7 px-8 text-left flex justify-between items-center gap-6 group transition-colors hover:bg-slate-50/50">
            <span class="font-heading font-black text-slate-950 text-lg leading-tight group-hover:text-indigo-600 transition-colors tracking-tight">
              {faq.question}
            </span>
            <div class="faq-icon-wrap w-8 h-8 rounded-xl border border-slate-100 bg-white flex items-center justify-center flex-shrink-0 transition-all duration-300 group-hover:border-indigo-100 group-hover:bg-indigo-50 shadow-sm group-hover:shadow-indigo-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="faq-chevron text-slate-400 group-hover:text-indigo-600 transition-all duration-300">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-all duration-500 ease-in-out">
            <div class="px-8 pb-8">
              <p class="text-slate-600 font-medium leading-relaxed text-base">{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item.active .faq-chevron {
    transform: rotate(180deg);
    color: #6366f1;
  }
  .faq-item.active .faq-icon-wrap {
    background-color: #eef2ff;
    border-color: #c7d2fe;
  }
  .faq-item.active .faq-body {
    max-height: 400px;
  }
</style>

<script>
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(item => {
    item.querySelector('.faq-toggle')?.addEventListener('click', () => {
      const isActive = item.classList.contains('active');
      faqItems.forEach(i => i.classList.remove('active'));
      if (!isActive) item.classList.add('active');
    });
  });
</script>
