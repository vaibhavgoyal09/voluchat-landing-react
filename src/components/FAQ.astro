---
const faqs = [
  {
    question: "How does VoluChat build custom sales workflows?",
    answer: "We map how your team sells today, then configure AI workflows for repeated buyer questions, catalog recommendations, qualification, escalation rules, and WhatsApp handoffs.",
  },
  {
    question: "Can VoluChat recommend products from my catalog?",
    answer: "Yes. Shoppers can describe what they want, ask for a size or shade, or send product context. VoluChat uses your catalog to suggest relevant matches.",
  },
  {
    question: "Is VoluChat limited to Instagram-to-WhatsApp handoff?",
    answer: "No. Instagram-to-WhatsApp is one common workflow. VoluChat can also be configured around buyer qualification, catalog matching, team escalation, delivery checks, offer rules, and follow-up context.",
  },
  {
    question: "Does VoluChat process payments or fully confirm orders?",
    answer: "No. Your team still handles final confirmation and payment details. VoluChat prepares cleaner buyer context and sales handoffs so your team can close faster.",
  },
  {
    question: "Will my team still control the final sale?",
    answer: "Yes. VoluChat handles repeated replies and detail collection. Your team stays in control of confirmation, payment instructions, exceptions, and customer judgment.",
  },
  {
    question: "Do I need technical knowledge to use it?",
    answer: "No. You get founder-led help mapping the workflow, connecting the right channels, adding catalog and policy details, tuning replies, and launching the pilot.",
  },
  {
    question: "How much does VoluChat cost?",
    answer: "Founder-led pilot pricing is Rs. 5,000 for one-time setup and Rs. 3,000 per month, with a 30-day money-back guarantee.",
  },
];
---

<section id="faq" class="section-pad relative overflow-hidden">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-20"></div>
  </div>

  <div class="page-shell">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <p class="section-eyebrow">FAQ</p>
      <h2 class="section-title mt-4">
        Common questions
      </h2>
      <p class="section-copy mx-auto mt-5 max-w-xl">
        The practical details growing D2C teams usually ask before launching a custom AI sales workflow.
      </p>
    </div>

    <div class="mx-auto max-w-3xl divide-y divide-stone-100 overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-[0_18px_60px_rgba(28,25,23,0.07)]">
      {faqs.slice(0, 7).map((faq, index) => (
        <div class="faq-item transition-all duration-300" data-index={index}>
          <button class="faq-toggle group flex w-full items-center justify-between gap-6 px-6 py-5 sm:px-8 sm:py-6 text-left transition-colors hover:bg-stone-50/70">
            <span class="font-heading text-base sm:text-lg font-semibold leading-snug tracking-tight text-stone-950 transition-colors group-hover:text-primary-800">
              {faq.question}
            </span>
            <span class="faq-icon-wrap flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border border-stone-100 bg-white shadow-sm transition-all duration-300 group-hover:border-primary-100 group-hover:bg-primary-50">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="faq-chevron text-stone-400 transition-all duration-300 group-hover:text-primary-700">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-all duration-500 ease-in-out">
            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
              <p class="text-xs sm:text-sm font-semibold leading-relaxed text-stone-600">{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item.active {
    background-color: rgba(68, 64, 60, 0.035);
  }
  .faq-item.active .faq-chevron {
    transform: rotate(180deg);
    color: #1c1917;
  }
  .faq-item.active .faq-icon-wrap {
    background-color: #f5f5f4;
    border-color: #e7e5e4;
  }
  .faq-item.active .faq-body {
    max-height: 420px;
  }
</style>

<script>
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(item => {
    item.querySelector('.faq-toggle')?.addEventListener('click', () => {
      const isActive = item.classList.contains('active');
      faqItems.forEach(i => i.classList.remove('active'));
      if (!isActive) item.classList.add('active');
    });
  });
</script>
