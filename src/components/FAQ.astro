---
const faqs = [
  {
    question: "How does VoluChat turn Instagram DMs into WhatsApp-ready chats?",
    answer: "VoluChat replies to buyers in Instagram DM, answers repeat questions, finds products from your catalog, collects useful details, and prepares a WhatsApp-ready chat for your staff.",
  },
  {
    question: "Can VoluChat find products from photos or buyer messages?",
    answer: "Yes. Buyers can describe what they want or send an image. VoluChat can use catalog data and vector search to find relevant product matches.",
  },
  {
    question: "Does VoluChat replace my store staff?",
    answer: "No. VoluChat handles the repetitive first layer of DM work so your staff can spend more time on buyers who are ready to close.",
  },
  {
    question: "Does VoluChat manage cart, address, and offer details?",
    answer: "Yes. It can collect product, size, color, quantity, shipping address, and discount or offer-code details before the WhatsApp handoff.",
  },
  {
    question: "Does VoluChat process orders or payments?",
    answer: "No. Your team still handles final order confirmation and payment manually in WhatsApp. VoluChat prepares the conversation with the details your staff needs.",
  },
  {
    question: "Can store owners track missed chats and team workload?",
    answer: "VoluChat is designed to make DM ownership clearer by separating handled chats, follow-ups, and WhatsApp-ready conversations.",
  },
  {
    question: "Do I need technical knowledge to use it?",
    answer: "No. Founding stores get hands-on help connecting Instagram, adding catalog details, tuning replies, and setting up the WhatsApp handoff.",
  },
];
---

<section id="faq" class="relative overflow-hidden py-20 md:py-32">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-20"></div>
  </div>

  <div class="mx-auto max-w-2xl px-6">
    <div class="mb-14 text-center">
      <!-- Standardized Glowing Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50/70 px-4 py-1.5 text-xs font-black text-blue-700 shadow-sm backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-blue-600 shadow-[0_0_8px_rgba(59,130,246,0.6)]"></span>
        <span>FAQ</span>
      </div>
      <!-- Consistent Responsive Heading -->
      <h2 class="mb-8 text-3xl font-heading font-black leading-[1.1] tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
        Common Questions
      </h2>
    </div>

    <!-- Main Accordion Container (Responsive padding & premium glass) -->
    <div class="divide-y divide-slate-100 overflow-hidden glass-card-premium rounded-[2rem] sm:rounded-[2.5rem] shadow-2xl">
      {faqs.map((faq, index) => (
        <div class="faq-item" data-index={index}>
          <button class="faq-toggle group flex w-full items-center justify-between gap-6 px-6 py-5 sm:px-8 sm:py-6 text-left transition-colors hover:bg-slate-50/70">
            <span class="font-heading text-base sm:text-lg font-black leading-snug tracking-tight text-slate-950 transition-colors group-hover:text-blue-700">
              {faq.question}
            </span>
            <span class="faq-icon-wrap flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border border-slate-100 bg-white shadow-sm transition-all duration-300 group-hover:border-blue-100 group-hover:bg-blue-50">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="faq-chevron text-slate-400 transition-all duration-300 group-hover:text-blue-600">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-all duration-500 ease-in-out">
            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
              <p class="text-xs sm:text-sm font-semibold leading-relaxed text-slate-600">{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item.active .faq-chevron {
    transform: rotate(180deg);
    color: #2563eb;
  }
  .faq-item.active .faq-icon-wrap {
    background-color: #eff6ff;
    border-color: #bfdbfe;
  }
  .faq-item.active .faq-body {
    max-height: 420px;
  }
</style>

<script>
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(item => {
    item.querySelector('.faq-toggle')?.addEventListener('click', () => {
      const isActive = item.classList.contains('active');
      faqItems.forEach(i => i.classList.remove('active'));
      if (!isActive) item.classList.add('active');
    });
  });
</script>
