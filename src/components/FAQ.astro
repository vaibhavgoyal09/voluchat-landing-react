---
const faqs = [
  {
    question: "How does VoluChat stop ecommerce stores losing sales to slow replies?",
    answer: "VoluChat acts as a shared AI reply layer for ecommerce sales teams, answering repeated product questions across Instagram and Facebook Pages before a buyer loses interest.",
  },
  {
    question: "Can VoluChat find products from photos or buyer messages?",
    answer: "Yes. Shoppers can describe a product, ask for size or shade, or send an image. VoluChat can use catalog data and vector search to find relevant product matches.",
  },
  {
    question: "Does VoluChat replace my sales team?",
    answer: "No. VoluChat handles the repetitive first layer of product questions so your sales team can spend more time on shoppers who are ready to buy.",
  },
  {
    question: "Can VoluChat support multiple sales reps or WhatsApp numbers?",
    answer: "Yes. VoluChat is built as a shared AI reply layer, so one owner or a 5-10 person sales team can keep consistent answers across agents, connected Meta channels, and WhatsApp handoffs. Native WhatsApp automation is coming after Meta review.",
  },
  {
    question: "Does VoluChat manage cart, address, and offer details?",
    answer: "Yes. It can collect product, size, color, quantity, shipping address, and discount or offer-code details before the WhatsApp handoff.",
  },
  {
    question: "Does VoluChat process orders or payments?",
    answer: "No. Your team still handles final order confirmation and payment. VoluChat prepares the conversation with the product, buyer, and handoff details your sales reps need.",
  },
  {
    question: "Can sales managers track missed chats and team workload?",
    answer: "VoluChat is designed to make conversation ownership clearer by separating handled chats, follow-ups, and WhatsApp-ready conversations across the team.",
  },
  {
    question: "How is VoluChat different from Manychat, WATI, Interakt, respond.io, AiSensy, or Gallabox?",
    answer: "Those tools are strong options for broad chat automation, WhatsApp inboxes, or customer support workflows. VoluChat is focused on ecommerce product conversations where slow manual replies can cost sales.",
  },
  {
    question: "Do I need technical knowledge to use it?",
    answer: "No. Store teams get hands-on help connecting Instagram and Facebook Pages, adding catalog details, tuning replies, and setting up the handoff during the 14-day trial.",
  },
];
---

<section id="faq" class="relative overflow-hidden py-28 md:py-36">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-20"></div>
  </div>

  <div class="mx-auto max-w-2xl px-6">
    <div class="mb-24 text-center">
      <!-- Standardized Glowing Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-lg border border-primary-200/70 bg-primary-50/70 px-4 py-1.5 text-xs font-semibold text-primary-800 shadow-sm backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-primary-600 shadow-[0_0_8px_rgba(51,141,115,0.42)]"></span>
        <span>FAQ</span>
      </div>
      <!-- Consistent Responsive Heading -->
      <h2 class="mb-8 text-3xl font-heading font-semibold leading-[1.1] tracking-tight text-stone-950 sm:text-5xl lg:text-6xl">
        Common Questions
      </h2>
    </div>

    <!-- Main Accordion Container (Responsive padding & premium glass) -->
    <div class="divide-y divide-stone-100 overflow-hidden glass-card-premium rounded-2xl sm:rounded-3xl shadow-2xl">
      {faqs.map((faq, index) => (
        <div class="faq-item transition-all duration-300" data-index={index}>
          <button class="faq-toggle group flex w-full items-center justify-between gap-6 px-6 py-5 sm:px-8 sm:py-6 text-left transition-colors hover:bg-stone-50/70">
            <span class="font-heading text-base sm:text-lg font-semibold leading-snug tracking-tight text-stone-950 transition-colors group-hover:text-primary-800">
              {faq.question}
            </span>
            <span class="faq-icon-wrap flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border border-stone-100 bg-white shadow-sm transition-all duration-300 group-hover:border-primary-100 group-hover:bg-primary-50">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="faq-chevron text-stone-400 transition-all duration-300 group-hover:text-primary-700">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-all duration-500 ease-in-out">
            <div class="px-6 pb-6 sm:px-8 sm:pb-8">
              <p class="text-xs sm:text-sm font-semibold leading-relaxed text-stone-600">{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item.active {
    background-color: rgba(68, 64, 60, 0.035);
  }
  .faq-item.active .faq-chevron {
    transform: rotate(180deg);
    color: #1c1917;
  }
  .faq-item.active .faq-icon-wrap {
    background-color: #f5f5f4;
    border-color: #e7e5e4;
  }
  .faq-item.active .faq-body {
    max-height: 420px;
  }
</style>

<script>
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(item => {
    item.querySelector('.faq-toggle')?.addEventListener('click', () => {
      const isActive = item.classList.contains('active');
      faqItems.forEach(i => i.classList.remove('active'));
      if (!isActive) item.classList.add('active');
    });
  });
</script>
