---
const faqs = [
  {
    question: "Is VoluChat safe for my Instagram and Facebook accounts?",
    answer: "Yes. VoluChat connects through official Meta APIs, so you do not share your Instagram or Facebook password with us.",
  },
  {
    question: "Can the AI answer product-specific questions?",
    answer: "Yes. VoluChat is designed to use your product catalog, variants, pricing, stock, categories, and policies to answer detailed buyer questions and recommend relevant products.",
  },
  {
    question: "Does it only send fixed templates?",
    answer: "No. You can use templates for predictable flows, but the AI can also understand natural language questions like budget, color, size, occasion, delivery, and product comparisons.",
  },
  {
    question: "Can it generate product titles and descriptions?",
    answer: "Yes. VoluChat includes AI-assisted product copy generation so your store data becomes cleaner and your chatbot has stronger context for replies.",
  },
  {
    question: "How much does VoluChat cost?",
    answer: "We offer bespoke pricing tailored to your store's specific volume and automation needs. Since we provide white-glove onboarding and custom infrastructure for each brand, we recommend requesting a demo to receive a personalized quote.",
  },
];
---

<section id="faq" class="py-20 md:py-32 relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none -z-10">
    <div class="sect-grid"></div>
  </div>

  <div class="max-w-2xl mx-auto px-6">
    <div class="text-center mb-14">
      <span class="section-badge mb-5 inline-flex">FAQ</span>
      <h2 class="text-4xl sm:text-6xl font-heading font-bold text-slate-900 mb-6 leading-[1.1] tracking-tight">
        Common Questions
      </h2>
    </div>

    <div class="glass-panel-premium divide-y divide-slate-100 rounded-[2.5rem] overflow-hidden shadow-2xl">
      {faqs.map((faq, index) => (
        <div class="faq-item" data-index={index}>
          <button class="faq-toggle w-full py-7 px-8 text-left flex justify-between items-center gap-6 group transition-colors hover:bg-slate-50/50">
            <span class="font-heading font-black text-slate-950 text-lg leading-tight group-hover:text-indigo-600 transition-colors tracking-tight">
              {faq.question}
            </span>
            <div class="faq-icon-wrap w-8 h-8 rounded-xl border border-slate-100 bg-white flex items-center justify-center flex-shrink-0 transition-all duration-300 group-hover:border-indigo-100 group-hover:bg-indigo-50 shadow-sm group-hover:shadow-indigo-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="faq-chevron text-slate-400 group-hover:text-indigo-600 transition-all duration-300">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-all duration-500 ease-in-out">
            <div class="px-8 pb-8">
              <p class="text-slate-600 font-medium leading-relaxed text-base">{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item.active .faq-chevron {
    transform: rotate(180deg);
    color: #6366f1;
  }
  .faq-item.active .faq-icon-wrap {
    background-color: #eef2ff;
    border-color: #c7d2fe;
  }
  .faq-item.active .faq-body {
    max-height: 400px;
  }
</style>

<script>
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(item => {
    item.querySelector('.faq-toggle')?.addEventListener('click', () => {
      const isActive = item.classList.contains('active');
      faqItems.forEach(i => i.classList.remove('active'));
      if (!isActive) item.classList.add('active');
    });
  });
</script>
