---
const includes = [
  "Instagram comment and DM reply setup",
  "Boutique catalog search and product matching",
  "Size, shade, stock, delivery, and offer-code collection",
  "WhatsApp-ready buyer summary handoffs",
  "Hindi, English, and Hinglish reply tuning",
  "Hands-on setup during your 14-day trial"
];
---

<section id="pricing" class="relative overflow-hidden py-28 md:py-36">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-15"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-6">
    <div class="mb-24 text-center">
      <!-- Standardized Glowing Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50/70 px-4 py-1.5 text-xs font-black text-blue-700 shadow-sm backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-blue-600 shadow-[0_0_8px_rgba(59,130,246,0.6)]"></span>
        <span>Trial-first pricing</span>
      </div>
      <!-- Consistent Responsive Heading -->
      <h2 class="text-3xl font-heading font-black leading-[1.1] tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
        Try the boutique workflow free for 14 days.
      </h2>
      <p class="mx-auto mt-6 max-w-3xl text-lg font-semibold leading-relaxed text-slate-600 sm:text-xl">
        We help map your catalog, common Instagram questions, and WhatsApp handoff rules before you decide whether VoluChat fits your boutique.
      </p>
    </div>

    <!-- Main Pricing Panel -->
    <div class="glass-card-premium rounded-[2.5rem] p-8 md:p-12 shadow-2xl overflow-hidden relative hover:scale-[1.01] hover:shadow-indigo-500/5 transition-all duration-500 group/panel">
      <div class="grid gap-12 md:grid-cols-[1.1fr_0.9fr] items-center">
        
        <!-- Left: Includes list -->
        <div>
          <div class="text-[10px] font-black uppercase tracking-[0.25em] text-blue-600 mb-6">Boutique trial setup</div>
          <h3 class="font-heading text-2xl font-black text-slate-950 tracking-tight mb-8">What is included during the trial</h3>
          
          <ul class="space-y-4">
            {includes.map((item) => (
              <li class="flex items-start gap-3.5 text-sm font-semibold leading-relaxed text-slate-700 hover:text-slate-950 transition-colors duration-200 group/item">
                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-lg border border-emerald-100 bg-emerald-50 group-hover/item:bg-emerald-100 group-hover/item:scale-110 transition-all duration-300">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Right: Call to action box -->
        <div class="rounded-3xl border border-slate-100 bg-slate-50/50 p-8 shadow-inner text-center">
          <div class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 mb-2">
            No-risk evaluation
          </div>
          <div class="font-heading text-4xl font-black text-slate-950 mb-3">
            14-day free trial
          </div>
          <div class="mb-4">
            <span class="font-heading text-5xl font-black text-slate-950">Free</span>
            <span class="text-sm font-bold text-slate-500"> for 14 days</span>
          </div>
          <p class="text-xs font-semibold leading-relaxed text-slate-500 mb-8">
            Test Instagram DM replies, catalog answers, Hinglish message tuning, and WhatsApp handoff with guided setup. Continue only if the workflow helps your team.
          </p>
          
          <a href="/contact" class="group relative flex items-center justify-center gap-3 rounded-full bg-zinc-950 py-4 px-6 text-sm font-black text-white shadow-2xl overflow-hidden transition-all duration-300 hover:scale-[1.03] hover:bg-blue-600">
            <span class="relative z-10">Start 14-day free trial</span>
            <span class="h-2.5 w-2.5 rounded-full bg-blue-400 group-hover:bg-white transition-colors duration-300 relative z-10"></span>
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>
