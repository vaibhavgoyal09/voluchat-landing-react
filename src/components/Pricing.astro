---
const includes = [
  "Instagram comments and DM reply setup",
  "Meta catalog connection and product matching",
  "Store policy, COD, delivery, and offer rules",
  "Conversation handoff and payment workflow planning",
  "Hindi, English, and Hinglish reply tuning",
  "Founder-led launch support"
];
---

<section id="pricing" class="relative overflow-hidden py-20 md:py-24">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-15"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-6">
    <div class="mb-12 text-center">
      <!-- Standardized Glowing Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-primary-200/70 bg-primary-50/70 px-4 py-1.5 text-xs font-semibold text-primary-800 shadow-sm backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-primary-600 shadow-[0_0_8px_rgba(83,111,159,0.42)]"></span>
        <span>Early access pricing</span>
      </div>
      <!-- Consistent Responsive Heading -->
      <h2 class="text-3xl font-heading font-semibold leading-[1.1] tracking-tight text-stone-950 sm:text-5xl lg:text-6xl">
        Early pricing for high-volume Instagram stores.
      </h2>
      <p class="mx-auto mt-6 max-w-3xl text-lg font-semibold leading-relaxed text-stone-600 sm:text-xl">
        Simple early pricing, founder-led setup, and a 30-day money-back guarantee if VoluChat is not a fit.
      </p>
    </div>

    <!-- Main Pricing Panel -->
    <div class="dark-band overflow-hidden rounded-2xl p-6 md:p-10">
      <div class="grid gap-10 md:grid-cols-[1.05fr_0.95fr] md:items-center">
        
        <!-- Left: Includes list -->
        <div>
          <div class="mb-6 text-[10px] font-semibold uppercase tracking-[0.25em] text-primary-200">Founder-led setup</div>
          <h3 class="mb-8 font-heading text-2xl font-semibold tracking-tight text-white">What is included when you launch</h3>
          
          <ul class="grid gap-3 sm:grid-cols-2">
            {includes.map((item) => (
              <li class="flex items-start gap-3 text-sm font-semibold leading-relaxed text-primary-50/88">
                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-white/12 text-primary-100">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Right: Call to action box -->
        <div class="rounded-2xl border border-white/15 bg-white p-7 text-center shadow-[0_24px_70px_rgba(0,0,0,0.22)]">
          <div class="mb-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-primary-700">
            Early access plan
          </div>
          <div class="mb-2 font-heading text-4xl font-semibold text-stone-950">
            Rs. 3,000/month
          </div>
          <div class="mb-5 rounded-xl border border-stone-200 bg-stone-50 px-4 py-3">
            <span class="font-heading text-3xl font-semibold text-stone-950">Rs. 5,000</span>
            <span class="block text-xs font-bold uppercase tracking-[0.16em] text-stone-500">one-time setup</span>
          </div>
          <p class="mb-6 text-xs font-semibold leading-relaxed text-stone-500">
            Includes setup, policy mapping, reply tuning, handoff planning, and a 30-day money-back guarantee.
          </p>
          
          <a href="/contact" class="btn-primary group w-full gap-3 px-6 py-4">
            <span class="relative z-10">Book demo call</span>
            <span class="h-2.5 w-2.5 rounded-full bg-primary-300 group-hover:bg-white transition-colors duration-300 relative z-10"></span>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>
