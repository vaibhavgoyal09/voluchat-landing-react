---
const includes = [
  "Instagram and Facebook comment and DM setup",
  "Shopify inventory sync and product matching",
  "Store policy, COD, delivery, and offer rules",
  "WhatsApp order message handoff",
  "Hindi, English, and Hinglish reply tuning",
  "Founder-led launch help"
];
---

<section id="pricing" class="section-pad relative overflow-hidden">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-10"></div>
  </div>

  <div class="page-shell relative z-10">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <p class="section-eyebrow">Early access pricing</p>
      <h2 class="section-title mt-4">
        Early pricing for DM-to-order automation.
      </h2>
      <p class="section-copy mx-auto mt-5 max-w-2xl">
        Simple early pricing, hands-on setup, and a 30-day money-back guarantee if VoluChat is not a fit for your store.
      </p>
    </div>

    <div class="dark-band mx-auto max-w-5xl overflow-hidden rounded-2xl p-5 md:p-8 lg:p-10">
      <div class="grid gap-10 md:grid-cols-[1.05fr_0.95fr] md:items-center">
        <div>
          <div class="mb-6 text-[10px] font-semibold uppercase tracking-[0.25em] text-primary-200">Hands-on setup</div>
          <h3 class="mb-8 font-heading text-2xl font-semibold tracking-tight text-white">What we set up with you</h3>
          
          <ul class="grid gap-3 sm:grid-cols-2">
            {includes.map((item) => (
              <li class="flex items-start gap-3 text-sm font-semibold leading-relaxed text-primary-50/88">
                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-white/12 text-primary-100">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-white/15 bg-white p-7 text-center shadow-[0_24px_70px_rgba(0,0,0,0.2)]">
          <div class="mb-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-primary-700">
            Early access plan
          </div>
          <div class="mb-2 font-heading text-4xl font-semibold leading-none text-stone-950">
            Rs. 3,000/month
          </div>
          <div class="mb-5 rounded-xl border border-stone-200 bg-stone-50 px-4 py-3">
            <span class="font-heading text-3xl font-semibold text-stone-950">Rs. 5,000</span>
            <span class="block text-xs font-bold uppercase tracking-[0.16em] text-stone-500">one-time setup</span>
          </div>
          <p class="mb-6 text-xs font-semibold leading-relaxed text-stone-500">
            Includes setup, store rule mapping, reply tuning, WhatsApp order handoff, and a 30-day money-back guarantee.
          </p>
          
          <a href="/contact" class="btn-primary group w-full gap-3 px-6 py-4">
            <span class="relative z-10">Book demo call</span>
            <span class="h-2.5 w-2.5 rounded-full bg-primary-300 group-hover:bg-white transition-colors duration-300 relative z-10"></span>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>
