---
const includes = [
  "Instagram and Facebook Page reply setup",
  "Product catalog search and item matching",
  "Size, color, stock, delivery, and offer-code replies",
  "Buyer summary handoffs for your sales team",
  "Hindi, English, and Hinglish reply tuning",
  "Hands-on setup during your 14-day trial"
];
---

<section id="pricing" class="relative overflow-hidden py-28 md:py-36">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-15"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-6">
    <div class="mb-24 text-center">
      <!-- Standardized Glowing Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-lg border border-primary-200/70 bg-primary-50/70 px-4 py-1.5 text-xs font-semibold text-primary-800 shadow-sm backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-primary-600 shadow-[0_0_8px_rgba(51,141,115,0.42)]"></span>
        <span>Trial-first pricing</span>
      </div>
      <!-- Consistent Responsive Heading -->
      <h2 class="text-3xl font-heading font-semibold leading-[1.1] tracking-tight text-stone-950 sm:text-5xl lg:text-6xl">
        Try automated replies free for 14 days.
      </h2>
      <p class="mx-auto mt-6 max-w-3xl text-lg font-semibold leading-relaxed text-stone-600 sm:text-xl">
        We help map your catalog, repeated product questions, and sales handoff rules before you decide whether VoluChat fits your store.
      </p>
    </div>

    <!-- Main Pricing Panel -->
    <div class="glass-card-premium rounded-3xl p-8 md:p-12 shadow-2xl overflow-hidden relative hover:scale-[1.01] hover:shadow-primary-700/10 transition-all duration-500 group/panel">
      <div class="grid gap-12 md:grid-cols-[1.1fr_0.9fr] items-center">
        
        <!-- Left: Includes list -->
        <div>
          <div class="text-[10px] font-semibold uppercase tracking-[0.25em] text-primary-700 mb-6">Store trial setup</div>
          <h3 class="font-heading text-2xl font-semibold text-stone-950 tracking-tight mb-8">What is included during the trial</h3>
          
          <ul class="space-y-4">
            {includes.map((item) => (
              <li class="flex items-start gap-3.5 text-sm font-semibold leading-relaxed text-stone-700 hover:text-stone-950 transition-colors duration-200 group/item">
                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-lg border border-emerald-100 bg-emerald-50 group-hover/item:bg-emerald-100 group-hover/item:scale-110 transition-all duration-300">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Right: Call to action box -->
        <div class="rounded-3xl border border-stone-100 bg-stone-50/50 p-8 shadow-inner text-center">
          <div class="text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-400 mb-2">
            No-risk evaluation
          </div>
          <div class="font-heading text-4xl font-semibold text-stone-950 mb-3">
            14-day free trial
          </div>
          <div class="mb-4">
            <span class="font-heading text-5xl font-semibold text-stone-950">Free</span>
            <span class="text-sm font-bold text-stone-500"> for 14 days</span>
          </div>
          <p class="text-xs font-semibold leading-relaxed text-stone-500 mb-8">
            Test Instagram and Facebook Page replies, catalog answers, Hinglish message tuning, and sales handoff with guided setup. Continue only if the workflow helps your team.
          </p>
          
          <a href="/contact" class="group relative flex items-center justify-center gap-3 rounded-xl bg-zinc-950 py-4 px-6 text-sm font-semibold text-white shadow-2xl overflow-hidden transition-all duration-300 hover:scale-[1.03] hover:bg-primary-700">
            <span class="relative z-10">Start 14-day free trial</span>
            <span class="h-2.5 w-2.5 rounded-full bg-primary-300 group-hover:bg-white transition-colors duration-300 relative z-10"></span>
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>
