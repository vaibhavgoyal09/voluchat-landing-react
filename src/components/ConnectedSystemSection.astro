---
const systemPillars = [
  {
    step: "01",
    label: "Customer Channels",
    title: "Omnichannel Inquiries",
    desc: "Seamlessly intercepts high-intent buyers across all your active social storefronts.",
    features: [
      "Instagram Reel comments & Story replies",
      "Instagram Direct Messages (DMs)",
      "Official WhatsApp Business API",
      "Storefront website live chat widget",
    ],
    badge: "Capture & Engage",
  },
  {
    step: "02",
    label: "Digital Employee",
    title: "Boutique Intelligence",
    desc: "Executes conversations with your exact tone, garment knowledge, and pricing rules.",
    features: [
      "Calibrated to your boutique voice & tone",
      "Understands garment fabrics & size charts",
      "Protects strict minimum price margins",
      "Enforces your 7-day exchange window",
    ],
    badge: "AI Brain",
    highlight: true,
  },
  {
    step: "03",
    label: "Store Operations",
    title: "Ecosystem Sync",
    desc: "Connects your inventory, couriers, and payment gateways for 100% automated operations.",
    features: [
      "Shopify & product catalog inventory sync",
      "Real-time courier tracking (Delhivery, Shiprocket)",
      "1-click UPI payments (GPay, PhonePe, Paytm)",
      "Instant draft order generation & sync",
    ],
    badge: "Fulfillment & Pay",
  },
];
---

<section id="system" class="relative overflow-hidden py-28 sm:py-32 lg:py-36 border-t border-white/[0.08] bg-[#000000]">
  <div class="page-shell relative z-10">
    <div class="mb-16 lg:mb-20 max-w-3xl">
      <div class="chip mb-4">
        <span class="mini-label text-emerald-400">Sales Channel</span>
      </div>
      <h2 class="section-title font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
        One AI employee. <em class="serif-accent">Your online sales on autopilot</em>.
      </h2>
      <p class="section-copy mt-5 text-base sm:text-lg text-slate-400 font-normal leading-relaxed">
        VoluChat connects directly to your Instagram, WhatsApp, catalog, and couriers — qualifying sizing, taking payments, and sending parcel updates without you typing a word.
      </p>
    </div>

    <!-- 3-Pillar Clean Architecture Grid -->
    <div class="grid gap-8 lg:grid-cols-3 items-stretch">
      {
        systemPillars.map((pillar) => (
          <div class={`rounded-3xl border ${pillar.highlight ? "border-emerald-500/40 bg-gradient-to-b from-emerald-950/20 via-[#070709] to-[#070709]" : "border-white/[0.08] bg-[#070709]"} p-8 sm:p-9 flex flex-col justify-between transition-[border-color] duration-200 hover:border-white/[0.2]`}>
            <div>
              <div class="flex items-center justify-between pb-4 border-b border-white/[0.08] mb-6">
                <span class="font-mono text-xs text-emerald-400 font-bold uppercase tracking-wider">
                  Step {pillar.step}
                </span>
                <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 text-[10px] font-mono text-slate-300">
                  {pillar.badge}
                </span>
              </div>

              <span class="text-[11px] uppercase font-mono tracking-wider text-slate-400 font-semibold block mb-1">
                {pillar.label}
              </span>
              <h3 class="font-heading text-xl font-bold text-white mb-3">
                {pillar.title}
              </h3>
              <p class="text-sm text-slate-400 font-normal leading-relaxed mb-6">
                {pillar.desc}
              </p>

              <div class="space-y-3 pt-2">
                {
                  pillar.features.map((feat) => (
                    <div class="flex items-start gap-2.5 text-xs text-slate-300">
                      <span class="text-emerald-400 mt-0.5 shrink-0 font-bold">✓</span>
                      <span>{feat}</span>
                    </div>
                  ))
                }
              </div>
            </div>

            {pillar.highlight ? (
              <div class="mt-8 pt-4 border-t border-emerald-500/30 flex items-center justify-between text-xs font-mono text-emerald-300">
                <span>Autonomous Intelligence</span>
                <span class="font-bold">Zero Manual Work</span>
              </div>
            ) : (
              <div class="mt-8 pt-4 border-t border-white/[0.06] text-xs font-mono text-slate-500">
                Full System Synchronization
              </div>
            )}
          </div>
        ))
      }
    </div>

    <!-- Architectural Pipeline Ribbon -->
    <div class="mt-12 rounded-2xl border border-white/[0.08] bg-[#070709] p-6">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <div class="flex items-center gap-3">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-xs sm:text-sm text-slate-300 font-medium">
            <strong class="text-white font-semibold">End-to-End Loop:</strong> Reel Comment &rarr; Size Advisory &rarr; UPI Payment &rarr; Live Courier Tracking &rarr; Routine Exchange
          </span>
        </div>
        <span class="text-xs font-mono text-emerald-400 font-medium shrink-0">
          From First DM to Final Delivery
        </span>
      </div>
    </div>

  </div>
</section>
