---
const pillars = [
  {
    step: "01",
    title: "Omnichannel inbound",
    desc: "Catches buyers the second they touch your content.",
    features: ["Reel comments & story DMs", "WhatsApp Cloud API sync", "Messenger auto-engagement"],
  },
  {
    step: "02",
    title: "AI stylist brain",
    desc: "Sells in your voice, fabrics and size charts.",
    features: ["Bust / waist / length fit", "Fabric & lining guidance", "Margin & policy enforcement"],
  },
  {
    step: "03",
    title: "Settle & courier",
    desc: "Address, UPI payment and tracking — automatically.",
    features: ["1-click UPI links", "Draft order sync", "Live courier tracking"],
  },
];

const integrations = ["Instagram", "WhatsApp", "Messenger", "Shopify", "Razorpay", "Delhivery"];
---

<section id="system" class="relative scroll-mt-28 py-20 sm:py-24">
  <div class="page-shell relative z-10">
    <div class="mx-auto max-w-2xl text-center">
      <p class="section-eyebrow">Connected system</p>
      <h2 class="mt-4 text-4xl sm:text-5xl leading-[1.05]">
        One AI agent. <em class="serif-accent">Your entire store connected</em>.
      </h2>
      <p class="section-copy mt-5">
        Between your channels, catalog, payments and couriers — running the loop on its own.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-6xl rounded-[20px] border border-slate-900/[0.07] bg-[#fffdf9]">
      <p class="border-b border-slate-900/[0.07] px-7 py-4 text-center text-xs font-mono text-slate-500">{integrations.join("  ·  ")}</p>
      <div class="grid lg:grid-cols-3">
      {
        pillars.map((pillar, i) => (
          <div class={`p-7 sm:p-8 ${i > 0 ? "border-t border-slate-900/[0.07] lg:border-t-0 lg:border-l" : ""}`}>
            <p class="font-mono text-xs font-bold text-slate-400">Step {pillar.step}</p>
            <h3 class="mt-1 text-xl">{pillar.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{pillar.desc}</p>
            <ul class="mt-5 space-y-2.5">
              {pillar.features.map((feat) => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <span class="mt-0.5 font-bold text-emerald-600">✓</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      </div>
    </div>
  </div>
</section>
