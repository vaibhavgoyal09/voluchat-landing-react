---
const guardrailRules = [
  {
    num: "01",
    title: "Fixed Price & Discount Limits",
    desc: "The AI never offers unapproved discounts or bargains below your minimum prices. Your margins are strictly protected.",
    badge: "Margin Protected",
  },
  {
    num: "02",
    title: "Live Stock Verification",
    desc: "Checks exact size and color availability in real time before confirming orders. You'll never oversell out-of-stock items.",
    badge: "Real-Time Stock",
  },
  {
    num: "03",
    title: "Strict Policy Compliance",
    desc: "Enforces your 7-day exchange window, verifies tag photos, and strictly follows your boutique return policies.",
    badge: "Zero Ambiguity",
  },
  {
    num: "04",
    title: "1-Tap Human Handover",
    desc: "For custom bridal stitching, VIP clients, or complex queries, the AI immediately alerts you on WhatsApp to take over seamlessly.",
    badge: "100% Control",
  },
];
---

<section id="guardrails" class="relative overflow-hidden py-28 sm:py-32 lg:py-36 border-t border-white/[0.08] bg-[#000000]">
  <div class="page-shell relative z-10">
    <div class="mb-16 lg:mb-20 max-w-3xl">
      <div class="chip mb-4">
        <span class="mini-label text-emerald-400">Total Store Control</span>
      </div>
      <h2 class="section-title font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
        Automated selling with <em class="serif-accent">zero brand risk</em>.
      </h2>
      <p class="section-copy mt-5 text-base sm:text-lg text-slate-400 font-normal leading-relaxed">
        You configure the boundaries. The AI executes them 24/7. It never offers unauthorized discounts, never oversells inventory, and alerts you the instant personal styling is needed.
      </p>
    </div>

    <!-- Editorial Spec Rows with Generous Whitespace -->
    <div class="max-w-4xl mx-auto divide-y divide-white/[0.08]">
      {
        guardrailRules.map((rule, idx) => (
          <div class={`reveal-on-scroll reveal-delay-${idx + 1} py-8 sm:py-9 grid gap-4 sm:grid-cols-[60px_1fr_auto] sm:gap-8 items-start`}>
            <span class="font-mono text-sm text-emerald-400 font-bold mt-0.5">{rule.num}</span>
            <div class="space-y-1.5">
              <h3 class="text-lg sm:text-xl font-semibold text-white font-heading tracking-tight">
                {rule.title}
              </h3>
              <p class="text-sm text-slate-400 font-normal leading-relaxed max-w-2xl">
                {rule.desc}
              </p>
            </div>
            <span class="self-start inline-block rounded-full border border-white/[0.10] bg-white/[0.04] px-3 py-1 text-[11px] font-mono font-medium text-slate-300">
              {rule.badge}
            </span>
          </div>
        ))
      }
    </div>

    <!-- Human Oversight Capsule -->
    <div class="mt-14 max-w-4xl mx-auto rounded-2xl border border-white/[0.08] bg-[#070709] p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3.5 text-center sm:text-left">
        <span class="relative flex h-2.5 w-2.5 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <p class="text-xs sm:text-sm text-slate-300 font-normal">
          <strong class="text-white font-semibold">Human Oversight Guarantee:</strong> Step into any customer conversation with 1 tap at any time.
        </p>
      </div>
      <a href="/security" class="shrink-0 text-xs font-mono text-emerald-400 hover:text-emerald-300 underline underline-offset-4 transition-colors">
        Review Safety Specs &rarr;
      </a>
    </div>
  </div>
</section>
