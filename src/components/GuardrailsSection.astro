---
const guardrailRules = [
  {
    num: "01",
    title: "Margin Rules",
    desc: "Never offers discounts outside your configured rules. Your boutique's profitability and price floors are completely protected.",
    badge: "Margin Control",
    highlight: "Locked Price Floors",
  },
  {
    num: "02",
    title: "Live Inventory",
    desc: "Checks current product and variant availability against your catalog before confirming. Prevents out-of-stock orders and customer frustration.",
    badge: "Live Stock",
    highlight: "Inventory Synced",
  },
  {
    num: "03",
    title: "Policy Rules",
    desc: "Follows your configured return, exchange, and alteration policies to the letter. Collects required photos and order timestamps automatically.",
    badge: "Policy Bound",
    highlight: "Strict Policy Adherence",
  },
  {
    num: "04",
    title: "Human Takeover",
    desc: "Escalate exceptions instantly. When an inquiry falls outside configured rules or requires custom bridal tailoring, your team takes over with 1 tap.",
    badge: "Human Control",
    highlight: "1-Tap Escalation",
  },
];
---

<section id="guardrails" class="relative overflow-hidden py-28 sm:py-32 lg:py-36 border-y border-white/[0.08] bg-[#000000]">
  <div class="page-shell relative z-10">
    <div class="mb-14 max-w-3xl">
      <div class="chip mb-4">
        <span class="mini-label text-emerald-400">Control &amp; Guardrails</span>
      </div>
      <h2 class="section-title font-heading">
        Autonomous doesn't mean <span class="text-emerald-400">uncontrolled</span>.
      </h2>
      <p class="section-copy mt-4">
        Built with strict commercial rules so your boutique is always represented accurately. The AI never invents policies, oversteps margins, or promises unavailable inventory.
      </p>
    </div>

    <!-- Titanium spec sheet — dividers, not cards -->
    <div class="max-w-5xl mx-auto">
      {
        guardrailRules.map((rule, idx) => (
          <div class={`hairline-row reveal-on-scroll reveal-delay-${idx + 1} grid gap-3 sm:grid-cols-[72px_1fr_auto] sm:gap-8 sm:items-baseline`}>
            <span class="font-mono text-xs text-[#a1a1a6] font-bold">{rule.num}</span>
            <div>
              <h3 class="text-xl font-semibold text-white font-heading">
                {rule.title}
              </h3>
              <p class="mt-1 text-sm text-[#86868b] font-normal leading-relaxed">
                {rule.desc}
              </p>
              <span class="mt-2 inline-block font-mono text-xs font-bold text-emerald-400">{rule.highlight}</span>
            </div>
            <span class="hidden sm:inline-block rounded-full border border-white/[0.14] bg-white/[0.04] px-3 py-1 text-xs font-mono font-medium text-slate-300">
              {rule.badge}
            </span>
          </div>
        ))
      }
    </div>

    <!-- Human Oversight Guarantee — titanium capsule, green dot only -->
    <div class="titanium-surface mt-10 max-w-5xl mx-auto rounded-full px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3.5 text-center sm:text-left">
        <span class="relative flex h-3 w-3 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
        </span>
        <p class="text-sm text-slate-300 font-medium">
          <strong class="text-white font-semibold">Human Oversight Guarantee:</strong> Your team can review chat logs, modify responses, or step into any conversation at any time with 1 tap.
        </p>
      </div>
      <a href="/security" class="shrink-0 text-xs font-mono text-emerald-300 hover:text-emerald-200 underline underline-offset-4">
        Review Safety Specs &rarr;
      </a>
    </div>
  </div>
</section>
