---
const guardrailRules = [
  {
    icon: "🏷️",
    title: "Strict Price Guardrails",
    desc: "The AI agent can only offer pre-approved discounts (e.g. max 10% for prepaid UPI). It never drops prices below your cost margin.",
    badge: "Margin Safe",
    highlight: "text-emerald-400 border-emerald-500/20 bg-emerald-500/10",
  },
  {
    icon: "📦",
    title: "Zero Out-of-Stock Promises",
    desc: "Real-time Shopify inventory checks prevent the AI from ever selling unavailable variants, avoiding dead checkouts.",
    badge: "Live Stock",
    highlight: "text-teal-400 border-teal-500/20 bg-teal-500/10",
  },
  {
    icon: "⚙️",
    title: "100% White-Glove Setup",
    desc: "We configure your Meta Business APIs, WhatsApp Business accounts, and sync your Shopify product catalog for you.",
    badge: "Done For You",
    highlight: "text-purple-400 border-purple-500/20 bg-purple-500/10",
  },
  {
    icon: "⚡",
    title: "Anti-Spam & Brand Voice",
    desc: "Trained exclusively on your brand's tone. Caps follow-up frequency so customers feel assisted rather than spammed.",
    badge: "Brand Voice",
    highlight: "text-indigo-400 border-indigo-500/20 bg-indigo-500/10",
  },
  {
    icon: "📊",
    title: "Attributed Revenue Reporting",
    desc: "Track every rupee generated. See exactly how many orders were closed by the AI agent and which campaigns drove them.",
    badge: "Clear ROI",
    highlight: "text-blue-400 border-blue-500/20 bg-blue-500/10",
  },
  {
    icon: "🛡️",
    title: "Instant Human Takeover",
    desc: "Custom orders, VIP clients, or complex queries alert your human team on WhatsApp for a seamless 1-click takeover.",
    badge: "Human Control",
    highlight: "text-amber-400 border-amber-500/20 bg-amber-500/10",
  },
];
---

<section id="guardrails" class="relative overflow-hidden py-10 sm:py-14 border-y border-white/5 bg-[#060c15]">
  <div class="sect-grid"></div>

  <div class="page-shell relative z-10">
    <div class="guardrails-header max-w-3xl mx-auto text-center opacity-0 mb-8">
      <div class="chip mb-4 border-emerald-500/20 bg-emerald-500/10">
        <span class="mini-label text-emerald-300">Safety & Guardrails</span>
      </div>
      <h2 class="section-title text-white font-heading">
        AI sales with <span class="gradient-text-anim">ironclad brand safety.</span>
      </h2>
      <p class="section-copy mt-5 text-slate-300 max-w-2xl mx-auto">
        Never worry about AI hallucinations or unauthorized discounts. VoluChat operates strictly within the rules and margin floors you define.
      </p>
    </div>

    <!-- Clean 6-Grid Guardrail Cards -->
    <div class="grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto">
      {
        guardrailRules.map((rule) => (
          <div class="guardrail-card opacity-0 group flex flex-col items-start pt-5 border-t border-white/10 transition-colors duration-300 hover:border-emerald-500/40">
            <div class="flex items-center gap-4 mb-4 w-full justify-between">
              <span class="text-2xl">{rule.icon}</span>
              <span class={`rounded-full border px-3 py-1 text-[10px] font-bold font-mono uppercase tracking-wider ${rule.highlight}`}>
                {rule.badge}
              </span>
            </div>

            <h3 class="text-xl font-bold text-white font-heading group-hover:text-emerald-50 transition-colors">
              {rule.title}
            </h3>
            <p class="mt-2.5 text-sm text-slate-400 font-medium leading-relaxed">
              {rule.desc}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Human-in-the-loop guarantee banner -->
    <div class="mt-10 max-w-5xl mx-auto rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3 text-center sm:text-left">
        <span class="h-3 w-3 rounded-full bg-emerald-400 shrink-0"></span>
        <p class="text-sm font-medium text-slate-200">
          <strong class="text-white">Human Oversight Guarantee:</strong> Your team can review chat logs, modify responses, or pause the AI on any customer thread with a single tap.
        </p>
      </div>
      <a href="/contact" class="btn-secondary text-xs shrink-0 py-2.5 px-5">
        Test Guardrails &rarr;
      </a>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  document.addEventListener("DOMContentLoaded", () => {
    gsap.registerPlugin(ScrollTrigger);

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    gsap.fromTo(".guardrails-header", 
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.45, ease: "power3.out", scrollTrigger: { trigger: "#guardrails", start: "top 85%" } }
    );

    gsap.fromTo(".guardrail-card",
      { opacity: 0, y: 20, scale: 0.98 },
      { 
        opacity: 1, y: 0, scale: 1, 
        duration: 0.4, 
        stagger: 0.06, 
        ease: "power2.out",
        scrollTrigger: { trigger: ".guardrail-card", start: "top 90%" }
      }
    );
  });
</script>

<style>
  .sect-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
    pointer-events: none;
    z-index: 0;
  }
</style>
