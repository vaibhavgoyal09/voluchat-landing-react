---
const guardrailRules = [
  {
    num: "01",
    title: "Strict Price & Margin Floor",
    desc: "Cryptographically locked from offering unauthorized discounts below your margin limits.",
    badge: "Margin Safe",
    highlight: "100% Margin Floor",
  },
  {
    num: "02",
    title: "Live Shopify Stock Check",
    desc: "Checks real-time variant stock before confirming. Zero overselling or dead checkouts.",
    badge: "Live Stock",
    highlight: "Zero Out-of-Stock",
  },
  {
    num: "03",
    title: "Instant Human Takeover",
    desc: "VIP buyers and custom requests instantly alert your human sales reps — on WhatsApp, Instagram, or your storefront widget.",
    badge: "Human Control",
    highlight: "1-Tap Escalation",
  },
  {
    num: "04",
    title: "Brand Voice Calibration",
    desc: "Trained exclusively on your tone and vocabulary. Never sounds like a generic robot.",
    badge: "Voice Tuned",
    highlight: "Boutique Calibrated",
  },
];
---

<section id="guardrails" class="relative overflow-hidden py-20 sm:py-24 border-y border-white/[0.08] bg-[#000000]">
  <div class="page-shell relative z-10">
    <div class="mb-14 max-w-2xl">
      <div class="chip mb-4">
        <span class="mini-label text-emerald-400">Brand Safety Standards</span>
      </div>
      <h2 class="section-title text-[#fcfdff] font-heading">
        Autonomous sales with <span class="text-emerald-400">total brand control</span>.
      </h2>
      <p class="section-copy mt-3">
        Zero unauthorized discounts, zero out-of-stock promises, and instant 1-tap human takeover.
      </p>
    </div>

    <!-- Clean 2x2 Punchy Guardrails Grid -->
    <div class="grid gap-6 sm:grid-cols-2 max-w-5xl mx-auto">
      {
        guardrailRules.map((rule, idx) => (
          <div class={`reveal-on-scroll reveal-delay-${idx + 1} rounded-2xl border border-white/[0.12] bg-[#0a0a0c] p-6 sm:p-8 flex flex-col justify-between hover:border-emerald-500/40 transition-all`}>
            <div>
              <div class="flex items-center justify-between border-b border-white/[0.08] pb-4 mb-5">
                <span class="font-mono text-xs text-slate-500 font-bold">GUARDRAIL {rule.num}</span>
                <span class="rounded-full border border-emerald-500/25 bg-emerald-500/10 px-3 py-0.5 text-xs font-mono font-medium text-emerald-300">
                  {rule.badge}
                </span>
              </div>
              <h3 class="text-xl font-bold text-white font-heading mb-2">
                {rule.title}
              </h3>
              <p class="text-sm text-[rgba(252,253,255,0.7)] font-normal leading-relaxed">
                {rule.desc}
              </p>
            </div>
            
            <div class="mt-6 pt-4 border-t border-white/[0.08] flex items-center justify-between font-mono text-xs">
              <span class="font-bold text-emerald-400">{rule.highlight}</span>
              <span class="text-slate-500">Enforced by Policy</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Human Oversight Guarantee Bar -->
    <div class="mt-8 max-w-5xl mx-auto rounded-2xl border border-white/[0.12] bg-[#0a0a0c] p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3.5 text-center sm:text-left">
        <span class="relative flex h-3 w-3 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
        </span>
        <p class="text-sm text-slate-300 font-medium">
          <strong class="text-white font-semibold">Human Oversight Guarantee:</strong> Your team can review chat logs, modify responses, or pause the AI at any time with 1 tap.
        </p>
      </div>
      <a href="/security" class="shrink-0 text-xs font-mono text-emerald-400 hover:text-emerald-300 underline underline-offset-4">
        Review Safety Specs &rarr;
      </a>
    </div>
  </div>
</section>
