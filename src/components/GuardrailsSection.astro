---
const guardrails = [
  {
    num: "01",
    title: "Margin & discount protection",
    desc: "Never offers unapproved discounts or goes below your minimum price.",
    input: "“35% off de do?”",
    defense: "Floor ₹3,499 enforced — offers a free potli instead.",
  },
  {
    num: "02",
    title: "Real-time stock check",
    desc: "Confirms exact variant availability before promising anything.",
    input: "“Book XS in peach organza”",
    defense: "XS is out — suggests S with alteration or pre-order.",
  },
  {
    num: "03",
    title: "Policy compliance",
    desc: "Enforces your 7-day exchange window and tag-photo proof.",
    input: "“Exchange a kurta from 18 days ago”",
    defense: "Window expired — offers 10% loyalty credit instead.",
  },
  {
    num: "04",
    title: "VIP & bridal handover",
    desc: "Custom, bridal or bulk orders alert you instantly on WhatsApp.",
    input: "“15-piece bridal trousseau”",
    defense: "Stylist alerted with 1-tap takeover and client notes.",
  },
];
---

<section id="guardrails" class="relative scroll-mt-28 py-20 sm:py-24">
  <div class="page-shell relative z-10">
    <div class="mx-auto max-w-2xl text-center">
      <p class="section-eyebrow">Total brand safety</p>
      <h2 class="mt-4 text-4xl sm:text-5xl leading-[1.05]">
        Automated selling with <em class="serif-accent">zero brand risk</em>.
      </h2>
      <p class="section-copy mt-5">
        You set the boundaries. The AI holds them 24/7 — no rogue discounts, no overselling.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-4xl rounded-[20px] border border-slate-900/[0.07] bg-[#fffdf9] px-7 sm:px-10">
      {
        guardrails.map((rule, i) => (
          <div class={`grid gap-2 py-7 sm:grid-cols-[64px_1fr_1.2fr] sm:gap-6 sm:items-baseline ${i > 0 ? "border-t border-slate-900/[0.07]" : ""}`}>
            <p class="font-mono text-sm font-bold text-slate-300">{rule.num}</p>
            <div>
              <h3 class="text-lg">{rule.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-600">{rule.desc}</p>
            </div>
            <div class="sm:border-l sm:border-slate-900/[0.07] sm:pl-6">
              <p class="text-sm text-slate-500 italic">{rule.input}</p>
              <p class="mt-1 text-sm font-medium text-emerald-800">{rule.defense}</p>
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-slate-600">
      <strong class="font-semibold text-slate-900">Human oversight:</strong> jump into any chat with 1 tap.
      <a href="/security" class="ml-1 font-semibold text-emerald-700 underline underline-offset-4 hover:text-emerald-800">
        Safety specs &rarr;
      </a>
    </p>
  </div>
</section>
