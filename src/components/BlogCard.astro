---
interface Props {
  id: number;
  slug: string;
  title: string;
  content: string;
  published: number;
  author_id: number;
  created_at?: string;
}

const { slug, title, content, created_at } = Astro.props;

// Format date
const date = created_at ? new Date(created_at).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}) : 'Recently published';

// Extract a short excerpt from content
const excerpt = content.length > 150 ? content.substring(0, 150) + '...' : content;
---

<a href={`/blog/${slug}`} class="glass-card group relative flex flex-col h-full rounded-2xl overflow-hidden">
  <!-- Card Header / Image Placeholder -->
  <div class="relative aspect-[16/9] overflow-hidden bg-white/35">
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/10 to-purple-500/10 group-hover:scale-110 transition-transform duration-700"></div>
    
    <!-- Decorative Pattern -->
    <div class="absolute inset-0 opacity-20 group-hover:opacity-30 transition-opacity">
      <div class="sect-grid"></div>
    </div>

    <!-- Badge -->
    <div class="absolute top-4 left-4">
      <span class="section-badge bg-white/90 backdrop-blur-md shadow-sm">Article</span>
    </div>

    <!-- Icon Overlay -->
    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-indigo-600/5 backdrop-blur-[2px]">
      <div class="glass w-12 h-12 rounded-full flex items-center justify-center text-indigo-600 scale-75 group-hover:scale-100 transition-transform duration-500">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </div>
    </div>
  </div>

  <!-- Card Content -->
  <div class="flex flex-col flex-grow p-8">
    <div class="flex items-center gap-3 mb-4">
      <div class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-wider">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        {date}
      </div>
      <span class="w-1 h-1 rounded-full bg-slate-200"></span>
      <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">5 min read</span>
    </div>

    <h3 class="text-xl font-bold text-slate-900 mb-4 group-hover:text-indigo-600 transition-colors line-clamp-2 leading-tight">
      {title}
    </h3>

    <p class="text-slate-600 text-sm leading-relaxed mb-8 line-clamp-3">
      {excerpt}
    </p>

    <!-- Footer -->
    <div class="mt-auto pt-6 border-t border-white/55 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-full bg-white/65 flex items-center justify-center font-bold text-[10px] text-indigo-600 border border-white/60">
          VT
        </div>
        <span class="text-xs font-bold text-slate-700">VoluChat Team</span>
      </div>
      
      <div class="text-indigo-600 font-bold text-xs flex items-center gap-1 group-hover:gap-2 transition-all">
        Read More
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </div>
    </div>
  </div>
</a>
