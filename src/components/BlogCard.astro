---
interface Props {
  blog: {
    href: string;
    slug: string;
    title: string;
    excerpt: string;
    dateLabel: string;
    featuredImageUrl?: string;
    featuredImageAlt?: string;
    author: {
      name: string;
      avatarUrl?: string;
    };
    categories: Array<{ name: string; slug: string }>;
  };
}

const { blog } = Astro.props;
const category = blog.categories[0]?.name || 'Article';
const authorInitials = blog.author.name
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<a href={blog.href} class="solid-card group relative flex h-full flex-col overflow-hidden transition-all duration-500 hover:-translate-y-1 hover:border-primary-500/20 hover:shadow-2xl">
  <!-- Card Header / Image Placeholder -->
  <div class="relative aspect-[16/9] overflow-hidden bg-white/35">
    {blog.featuredImageUrl ? (
      <img
        src={blog.featuredImageUrl}
        alt={blog.featuredImageAlt || blog.title}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-[800ms] ease-out group-hover:scale-[1.06]"
      />
    ) : (
      <>
        <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(83,111,159,0.12),rgba(255,255,255,0.5),rgba(203,217,234,0.16))] transition-transform duration-[800ms] group-hover:scale-110"></div>
        <div class="absolute inset-0 opacity-20 group-hover:opacity-30 transition-opacity">
          <div class="sect-grid"></div>
        </div>
      </>
    )}

    <!-- Badge -->
    <div class="absolute top-4 left-4">
      <span class="chip bg-white/90 shadow-sm">{category}</span>
    </div>

    <!-- Icon Overlay -->
    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-primary-600/5 backdrop-blur-[2px]">
      <div class="glass w-12 h-12 rounded-full flex items-center justify-center text-primary-700 scale-75 group-hover:scale-100 transition-transform duration-500">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </div>
    </div>
  </div>

  <!-- Card Content -->
  <div class="flex flex-col flex-grow p-8">
    <div class="flex items-center gap-3 mb-4">
      <div class="flex items-center gap-2 text-xs font-bold text-stone-400 uppercase tracking-wider">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        {blog.dateLabel}
      </div>
      <span class="w-1 h-1 rounded-full bg-slate-200"></span>
      <span class="text-xs font-bold text-stone-400 uppercase tracking-wider">5 min read</span>
    </div>

    <h3 class="text-xl font-bold text-stone-900 mb-4 group-hover:text-primary-700 transition-colors line-clamp-2 leading-tight">
      {blog.title}
    </h3>

    <p class="text-stone-600 text-sm leading-relaxed mb-8 line-clamp-3">
      {blog.excerpt}
    </p>

    <!-- Footer -->
    <div class="mt-auto pt-6 border-t border-white/55 flex items-center justify-between">
      <div class="flex items-center gap-2">
        {blog.author.avatarUrl ? (
          <img
            src={blog.author.avatarUrl}
            alt=""
            loading="lazy"
            decoding="async"
            width="32"
            height="32"
            class="h-8 w-8 rounded-full object-cover border border-white/60"
          />
        ) : (
          <div class="w-8 h-8 rounded-full bg-white/65 flex items-center justify-center font-bold text-[10px] text-primary-700 border border-white/60">
            {authorInitials || 'VT'}
          </div>
        )}
        <span class="text-xs font-bold text-stone-700">{blog.author.name}</span>
      </div>
      
      <div class="text-primary-700 font-bold text-xs flex items-center gap-1.5">
        Read More
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </div>
    </div>
  </div>
</a>
