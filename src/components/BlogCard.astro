---
interface Props {
  blog: {
    href: string;
    slug: string;
    title: string;
    excerpt: string;
    dateLabel: string;
    featuredImageUrl?: string;
    featuredImageAlt?: string;
    author: {
      name: string;
      avatarUrl?: string;
    };
    categories: Array<{ name: string; slug: string }>;
  };
}

const { blog } = Astro.props;
const category = blog.categories[0]?.name || "Article";
const authorInitials = blog.author.name
  .split(/\s+/)
  .map((part) => part[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<a
  href={blog.href}
  class="group relative flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-white/10 bg-[#0c1728] transition-all duration-500 hover:-translate-y-1 hover:border-teal-300/20 hover:shadow-2xl"
>
  <!-- Card Header / Image Placeholder -->
  <div class="relative aspect-[16/9] overflow-hidden bg-[#0b1526]">
    {
      blog.featuredImageUrl ? (
        <img
          src={blog.featuredImageUrl}
          alt={blog.featuredImageAlt || blog.title}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-[800ms] ease-out group-hover:scale-[1.06]"
        />
      ) : (
        <>
          <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(45,212,191,0.12),rgba(16,27,46,0.5),rgba(45,212,191,0.08))] transition-transform duration-[800ms] group-hover:scale-110" />
          <div class="absolute inset-0 opacity-20 group-hover:opacity-30 transition-opacity">
            <div class="sect-grid" />
          </div>
        </>
      )
    }

    <!-- Badge -->
    <div class="absolute top-4 left-4">
      <span class="chip">{category}</span>
    </div>

    <!-- Icon Overlay -->
    <div
      class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-teal-300/5 backdrop-blur-[2px]"
    >
      <div
        class="w-12 h-12 rounded-full flex items-center justify-center text-teal-200 bg-[#0b1526]/80 border border-white/10 scale-75 group-hover:scale-100 transition-transform duration-500"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </div>
    </div>
  </div>

  <!-- Card Content -->
  <div class="flex flex-col flex-grow p-8">
    <div class="flex items-center gap-3 mb-4">
      <div
        class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-wider"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line
            x1="16"
            y1="2"
            x2="16"
            y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
            x1="3"
            y1="10"
            x2="21"
            y2="10"></line></svg
        >
        {blog.dateLabel}
      </div>
      <span class="w-1 h-1 rounded-full bg-slate-600"></span>
      <span class="text-xs font-bold text-slate-400 uppercase tracking-wider"
        >5 min read</span
      >
    </div>

    <h2
      class="text-xl font-bold text-white mb-4 group-hover:text-teal-200 transition-colors line-clamp-2 leading-tight"
    >
      {blog.title}
    </h2>

    <p class="text-slate-300 text-sm leading-relaxed mb-8 line-clamp-3">
      {blog.excerpt}
    </p>

    <!-- Footer -->
    <div
      class="mt-auto pt-6 border-t border-white/10 flex items-center justify-between"
    >
      <div class="flex items-center gap-2">
        {
          blog.author.avatarUrl ? (
            <img
              src={blog.author.avatarUrl}
              alt=""
              loading="lazy"
              decoding="async"
              width="32"
              height="32"
              class="h-8 w-8 rounded-full object-cover border border-white/10"
            />
          ) : (
            <div class="w-8 h-8 rounded-full bg-teal-500/20 flex items-center justify-center font-bold text-[10px] text-teal-200 border border-white/10">
              {authorInitials || "VT"}
            </div>
          )
        }
        <span class="text-xs font-bold text-slate-200">{blog.author.name}</span>
      </div>

      <div class="text-teal-200 font-bold text-xs flex items-center gap-1.5">
        Read More
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform duration-300 group-hover:translate-x-1"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </div>
    </div>
  </div>
</a>
