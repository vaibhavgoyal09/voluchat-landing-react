---
const capabilities = [
  {
    eyebrow: "Reply automation",
    title: "Answers the same questions first",
    text: "The repeated questions handled before a sales rep steps in: price, size, stock, delivery, COD, and offers.",
  },
  {
    eyebrow: "Catalog context",
    title: "Keeps answers consistent across agents",
    text: "Buyers can describe a product, send a screenshot, or ask for a variant. VoluChat matches it against the same catalog context for every agent.",
  },
  {
    eyebrow: "Team handoff",
    title: "Escalates when intent is clear",
    text: "Your sales team receives product, size, delivery, and buyer context instead of opening every chat cold.",
  },
];
---

<section id="features" class="section-pad relative overflow-hidden">
  <div class="page-shell">
    <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start lg:gap-10">
      <div class="relative z-10 max-w-xl reveal-on-scroll lg:sticky lg:top-28">
        <p class="section-eyebrow">AI reply layer for ecommerce sales teams</p>
        <h2 class="section-title mt-4">
          A shared reply layer for every product channel.
        </h2>
        <p class="section-copy mt-5">
          VoluChat covers common buying questions across Instagram, Facebook Pages, and WhatsApp workflows while your team keeps the final sale.
        </p>
      </div>

      <div class="relative z-20 grid gap-4">
        {capabilities.map((item, index) => (
          <article class={`kinetic-card group rounded-[1.75rem] border border-white/80 bg-white/92 p-4 shadow-[0_18px_70px_rgba(28,25,23,0.08)] transition duration-500 hover:-translate-y-1 hover:bg-white sm:p-5 lg:bg-white/70 lg:backdrop-blur-2xl reveal-on-scroll ${index === 1 ? 'reveal-delay-100' : index === 2 ? 'reveal-delay-200' : ''}`}>
            <div class="grid gap-4 sm:grid-cols-[0.8fr_1.2fr] sm:items-center sm:gap-5">
              <div class="rounded-2xl border border-stone-200/70 bg-primary-50/70 p-4 sm:p-5">
                <p class="mini-label">{item.eyebrow}</p>
                <div class="mt-5 h-2 rounded-full bg-stone-200 sm:mt-6">
                  <div class={`h-full rounded-full bg-primary-800 ${index === 0 ? 'w-[88%]' : index === 1 ? 'w-[72%]' : 'w-[62%]'}`}></div>
                </div>
                <div class="mt-4 grid grid-cols-3 gap-2">
                  {["Price", "Stock", "Size"].map((label) => (
                    <span class="rounded-lg border border-stone-200/70 bg-white px-2 py-1 text-center text-[10px] font-semibold text-stone-600">{label}</span>
                  ))}
                </div>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-stone-950 sm:text-2xl">{item.title}</h3>
                <p class="mt-3 text-sm font-medium leading-relaxed text-stone-600">{item.text}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
