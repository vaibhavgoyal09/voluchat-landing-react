---
const setupAdvantages = [
  {
    eyebrow: "DM replies",
    title: "Answer the questions that slow your team down",
    text: "VoluChat handles repeated questions about price, size, stock, COD, delivery, offers, and policies using your store context.",
    steps: ["Product question", "Store context", "Helpful reply", "Next step"],
    metric: "01",
    metricValue: "Reply queue",
  },
  {
    eyebrow: "Product matching",
    title: "Sync live with Shopify inventory",
    text: "VoluChat connects to your Shopify inventory so product, size, color, and stock changes are reflected in replies without manual CSV work.",
    steps: ["Store sync", "Live inventory", "Variant choice", "Cart item"],
    metric: "02",
    metricValue: "Catalog match",
  },
  {
    eyebrow: "WhatsApp handoff",
    title: "Prepare the order before your team steps in",
    text: "VoluChat collects cart and delivery details, then sends the customer to WhatsApp with the order message already filled in.",
    steps: ["Cart details", "Address", "WhatsApp text", "Store close"],
    metric: "03",
    metricValue: "Order handoff",
  },
];

const replyBoard = [
  {
    label: "Instagram DM",
    customer: "Is this kurta available in M?",
    reply: "Yes, M is in stock. Want the ivory or blue variant?",
    status: "Answered",
  },
  {
    label: "Product check",
    customer: "COD possible for Jaipur?",
    reply: "COD is available. Delivery usually takes 3-4 days.",
    status: "Policy matched",
  },
  {
    label: "WhatsApp handoff",
    customer: "Book blue M, please.",
    reply: "Cart, address prompt, and WhatsApp order text are ready.",
    status: "Ready",
  },
];
---

<section id="features" class="section-pad relative overflow-hidden bg-white/35">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-stone-200 to-transparent"></div>
  <div class="page-shell relative z-10">
    <div class="grid gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-center lg:gap-14">
      <div class="reveal-on-scroll">
        <div class="max-w-2xl">
          <p class="section-eyebrow">DM-to-order automation</p>
          <h2 class="section-title mt-4">
            Turn messy buyer DMs into a clean order path.
          </h2>
          <p class="section-copy mt-5">
            VoluChat does the repetitive work around every sale: answer product questions, match inventory, collect details, and prepare the WhatsApp handoff.
          </p>
        </div>

        <div class="mt-8 overflow-hidden rounded-[1.35rem] border border-primary-900/10 bg-primary-900 shadow-[0_34px_90px_rgba(29,43,67,0.22)]">
          <div class="flex items-center justify-between border-b border-white/10 px-4 py-3 sm:px-5">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-primary-200"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-white/35"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
            </div>
            <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-primary-100/72">Live reply desk</p>
          </div>

          <div class="grid gap-1 p-3 sm:p-4">
            {replyBoard.map((item, index) => (
              <article class={`rounded-2xl border border-white/10 bg-white/[0.06] p-4 transition duration-500 hover:bg-white/[0.09] ${index === 1 ? 'sm:ml-8' : index === 2 ? 'sm:ml-16' : ''}`}>
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-primary-100/68">{item.label}</p>
                  <span class="rounded-md border border-white/10 bg-white/10 px-2.5 py-1 font-mono text-[10px] font-semibold text-white">{item.status}</span>
                </div>
                <p class="mt-4 max-w-[24rem] text-sm font-semibold leading-relaxed text-white">{item.customer}</p>
                <p class="mt-3 rounded-xl bg-white px-4 py-3 text-sm font-semibold leading-relaxed text-primary-900 shadow-[0_14px_32px_rgba(0,0,0,0.18)]">{item.reply}</p>
              </article>
            ))}
          </div>

          <div class="grid grid-cols-3 border-t border-white/10 text-center">
            <div class="px-3 py-4">
              <p class="font-mono text-lg font-semibold leading-none text-white">24/7</p>
              <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-primary-100/58">Replies</p>
            </div>
            <div class="border-x border-white/10 px-3 py-4">
              <p class="font-mono text-lg font-semibold leading-none text-white">Live</p>
              <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-primary-100/58">Stock</p>
            </div>
            <div class="px-3 py-4">
              <p class="font-mono text-lg font-semibold leading-none text-white">WA</p>
              <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-primary-100/58">Handoff</p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid gap-4 reveal-on-scroll reveal-delay-100">
        {setupAdvantages.map((item, index) => (
          <article class="group rounded-[1.35rem] border border-stone-200/80 bg-white/78 p-5 shadow-[0_18px_54px_rgba(28,25,23,0.06)] backdrop-blur-xl transition duration-500 hover:-translate-y-1 hover:border-primary-200 hover:bg-white hover:shadow-[0_26px_80px_rgba(29,43,67,0.12)] sm:p-6">
            <div class="grid gap-5 sm:grid-cols-[auto_1fr] sm:items-start">
              <div class="flex items-center gap-3 sm:block">
                <span class="grid h-11 w-11 place-items-center rounded-2xl bg-primary-900 font-mono text-sm font-semibold text-white shadow-[0_14px_34px_rgba(29,43,67,0.18)]">
                  {item.metric}
                </span>
                <p class="mini-label text-primary-700 sm:mt-4">{item.metricValue}</p>
              </div>

              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-stone-400">{item.eyebrow}</p>
                <h3 class="mt-2 text-2xl font-semibold leading-tight text-stone-950">{item.title}</h3>
                <p class="mt-3 max-w-2xl text-sm font-medium leading-relaxed text-stone-600 sm:text-base">{item.text}</p>

                <div class="mt-5 grid gap-2 sm:grid-cols-4">
                  {item.steps.map((label, stepIndex) => (
                    <div class="relative rounded-xl border border-stone-200/80 bg-stone-50/78 px-3 py-3 transition duration-300 group-hover:border-primary-100 group-hover:bg-primary-50/70">
                      <span class="font-mono text-[10px] font-semibold text-primary-700">0{stepIndex + 1}</span>
                      <p class="mt-1 text-xs font-semibold leading-snug text-stone-700">{label}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
