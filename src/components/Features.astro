---
const features = [
  {
    title: "Comment-to-DM Automation",
    description: "Instantly reply to comments and send DMs. Turn engagement into leads without lifting a finger.",
    icon: "message-square",
    span: "md:col-span-2",
  },
  {
    title: "Regional Language AI",
    description: "Chat in Hindi, Hinglish, Tamil & more. Our AI understands context and culture.",
    icon: "globe",
    span: "md:col-span-1",
  },
  {
    title: "Smart Lead Qualification",
    description: "Filter tire-kickers from real buyers automatically using smart flows.",
    icon: "zap",
    span: "md:col-span-1",
  },
  {
    title: "WhatsApp Handoff",
    description: "Seamlessly move hot leads from Instagram DMs to WhatsApp for closing.",
    icon: "smartphone",
    span: "md:col-span-2",
  },
  {
    title: "Growth Analytics",
    description: "Track every conversion, reply, and sale in real-time.",
    icon: "bar-chart",
    span: "md:col-span-1",
  },
  {
    title: "Enterprise Security",
    description: "Bank-grade encryption and Meta-compliant API usage.",
    icon: "shield",
    span: "md:col-span-1",
  },
];
---

<section id="features" class="py-28 relative overflow-hidden bg-white">
  <!-- Background -->
  <div class="absolute inset-0 pointer-events-none -z-10">
    <div class="sect-grid"></div>
    <div class="sect-orb" style="width:600px;height:600px;background:radial-gradient(circle,rgba(99,102,241,0.10) 0%,transparent 70%);top:-100px;right:-150px;"></div>
    <div class="sect-orb" style="width:500px;height:500px;background:radial-gradient(circle,rgba(168,85,247,0.09) 0%,transparent 70%);bottom:-100px;left:-100px;"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="section-badge mb-5 inline-flex">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Powerful Features
      </span>
      <h2 class="text-4xl sm:text-5xl font-heading font-bold text-slate-900 mb-4 leading-tight">
        Everything you need to<br /><span class="text-gradient-primary">dominate Instagram sales</span>
      </h2>
      <p class="text-lg text-slate-500 leading-relaxed">
        Stop manually replying to "PP?" and start automating your revenue engine.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      {features.map((feature) => (
        <div class={`group relative rounded-3xl border border-slate-100 bg-white p-8 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1 ${feature.span}`}>
          <!-- Hover glow -->
          <div class="absolute inset-0 rounded-3xl bg-gradient-to-br from-indigo-50/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

          <div class="relative z-10 flex flex-col h-full">
            <!-- Icon -->
            <div class="mb-6 w-12 h-12 rounded-2xl bg-slate-900 flex items-center justify-center text-white flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
              {feature.icon === "message-square" && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>}
              {feature.icon === "globe" && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>}
              {feature.icon === "zap" && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>}
              {feature.icon === "smartphone" && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>}
              {feature.icon === "bar-chart" && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>}
              {feature.icon === "shield" && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
            </div>

            <h3 class="text-lg font-heading font-bold text-slate-900 mb-2 group-hover:text-indigo-700 transition-colors">
              {feature.title}
            </h3>
            <p class="text-slate-500 text-sm leading-relaxed">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
