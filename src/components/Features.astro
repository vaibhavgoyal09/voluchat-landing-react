---
const matches = [
  { name: "Premium sneaker", image: "/white_runner_thumb.png", score: "Best match" },
  { name: "Satin kurta set", image: "/satin_kurta_thumb.png", score: "Fashion match" },
  { name: "Denim overshirt", image: "/denim_overshirt_thumb.png", score: "Related style" }
];
---

<section id="features" class="section-pad relative overflow-hidden">
  <div class="page-shell">
    <div class="mx-auto max-w-3xl text-center">
      <p class="section-eyebrow">AI reply automation for product sellers</p>
      <h2 class="section-title mt-4">
        The repeated questions handled before staff steps in.
      </h2>
      <p class="section-copy mx-auto mt-5 max-w-2xl">
        VoluChat takes care of routine product questions and buyer details so your staff can focus on conversations that are ready to move forward.
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
      <!-- 24/7 Smart Cover -->
      <article class="surface rounded-[2.25rem] p-8 md:p-10 reveal-on-scroll">
        <div class="grid gap-8 md:grid-cols-[0.9fr_1.1fr] md:items-center">
          <div class="space-y-4">
            <span class="chip">Always online</span>
            <h3 class="font-heading text-3xl font-semibold leading-tight text-stone-950">24/7 Smart Cover</h3>
            <p class="section-copy text-sm sm:text-base">
              Never keep a shopper waiting. VoluChat replies to Instagram and Facebook Page questions while your store team is busy.
            </p>
          </div>

          <div class="rounded-2xl border border-stone-200/60 bg-stone-50/50 p-5 shadow-inner space-y-3">
            <div class="flex gap-2">
              <img src="/buyer_avatar.webp" alt="Buyer avatar" class="h-8 w-8 rounded-full object-cover border border-stone-200 shadow-sm shrink-0" />
              <div class="max-w-[80%] rounded-2xl bg-white border border-stone-200/80 px-3.5 py-2 text-xs font-semibold text-stone-850 shadow-sm">
                Hi, is the white sneaker available in UK 9?
              </div>
            </div>
            <div class="mt-3 flex justify-end gap-2">
              <div class="max-w-[80%] rounded-2xl bg-stone-950 px-3.5 py-2 text-xs font-semibold text-white shadow-sm border border-stone-900">
                Yes, UK 9 is available. Should I mark this for staff follow-up?
              </div>
              <div class="h-8 w-8 rounded-full bg-white border border-stone-200 flex items-center justify-center shrink-0 shadow-sm p-1.5">
                <img src="/voluchat_logo.svg" alt="VoluChat AI" class="h-full w-full object-contain" />
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- AI Product Matching -->
      <article class="surface-soft rounded-[2.25rem] p-8 md:p-10 reveal-on-scroll reveal-delay-100 flex flex-col justify-between">
        <div class="space-y-4">
          <span class="chip">Vector search</span>
          <h3 class="font-heading text-2xl font-semibold text-stone-950">AI Product Matching</h3>
          <p class="text-xs sm:text-sm font-semibold leading-relaxed text-stone-600">
            Buyers can describe a product or send a screenshot. VoluChat matches descriptions and photos to your ecommerce catalog.
          </p>
        </div>
        <div class="mt-8 space-y-3">
          {matches.map((item) => (
            <div class="flex items-center justify-between gap-3 rounded-xl border border-stone-200/80 bg-white/70 p-3 hover:scale-[1.01] hover:shadow-md transition-all duration-300">
              <div class="flex items-center gap-3">
                <img src={item.image} alt={item.name} class="h-12 w-12 rounded-lg border border-stone-150 bg-white object-contain p-1 shrink-0" />
                <p class="text-xs sm:text-sm font-bold text-stone-950">{item.name}</p>
              </div>
              <span class="rounded-lg bg-stone-100 border border-stone-200/60 px-2.5 py-1 text-[10px] font-bold text-stone-700">{item.score}</span>
            </div>
          ))}
        </div>
      </article>

      <!-- Buyer Details Collected -->
      <article class="surface-soft rounded-[2.25rem] p-8 md:p-10 reveal-on-scroll lg:col-span-2">
        <div class="grid gap-8 md:grid-cols-[0.8fr_1.2fr] md:items-center">
          <div class="space-y-4">
            <span class="chip">Ready to close</span>
            <h3 class="font-heading text-2xl font-semibold text-stone-950">Buyer Details Collected</h3>
            <p class="text-xs sm:text-sm font-semibold leading-relaxed text-stone-600">
              VoluChat gathers sizing, color, quantity, and delivery address before passing the buyer to your team on WhatsApp.
            </p>
          </div>
          <div class="grid gap-4 sm:grid-cols-3">
            {["UK 9", "White", "Pune 411014"].map((item) => (
              <div class="rounded-2xl border border-stone-200/80 bg-gradient-to-br from-white to-stone-50/50 p-6 text-center hover:scale-[1.03] hover:shadow-md hover:border-stone-300 transition-all duration-300 group/collected">
                <p class="mini-label">Collected</p>
                <p class="mt-3 text-base font-bold text-stone-950 group-hover:text-stone-800">{item}</p>
                <div class="mt-3 inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-600">
                  <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
              </div>
            ))}
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
