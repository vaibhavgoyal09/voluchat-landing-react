---
const features = [
  {
    title: "Turn comments into DMs",
    description: "When someone comments 'price?', 'available?', or 'size?', VoluChat can reply and continue the chat in DM.",
    stat: "Comment to DM",
  },
  {
    title: "Show the right products",
    description: "Customers can ask by budget, color, size, or need. VoluChat finds matching products.",
    stat: "Smart search",
  },
  {
    title: "Send buyers to WhatsApp",
    description: "When a customer is ready, move them to WhatsApp for payment or final confirmation.",
    stat: "Easy follow-up",
  },
  {
    title: "Manage products easily",
    description: "Keep products, prices, variants, and stock ready for the chatbot to use in replies.",
    stat: "Catalog ready",
  },
  {
    title: "Write product details with AI",
    description: "Create better product titles and descriptions from simple notes.",
    stat: "Faster listing",
  },
  {
    title: "Track chats and orders",
    description: "See customer conversations, carts, orders, and store activity in one dashboard.",
    stat: "One place",
  },
];
---

<section id="features" class="relative overflow-hidden py-20 md:py-28">
  <div class="absolute inset-0 pointer-events-none -z-10">
    <div class="sect-grid opacity-10"></div>
  </div>

  <div class="mx-auto max-w-7xl px-6">
    <div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <div class="lg:sticky lg:top-28">
        <span class="section-badge mb-5">Features</span>
        <h2 class="max-w-xl text-4xl font-heading font-bold leading-[1.08] tracking-tight text-slate-950 sm:text-5xl">
          Everything your store needs to sell from comments and DMs.
        </h2>
        <p class="mt-5 max-w-lg text-lg leading-relaxed text-slate-600">
          VoluChat is made for Indian small businesses that get product questions on posts, reels, DMs, and WhatsApp every day.
        </p>

        <div class="glass-dark mt-8 overflow-hidden rounded-2xl">
          <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
            <div>
              <div class="text-xs font-bold uppercase tracking-[0.18em] text-white/40">Today</div>
              <div class="mt-1 text-lg font-black text-white">Your AI assistant is working</div>
            </div>
            <span class="rounded-full bg-emerald-400/10 px-3 py-1 text-xs font-bold text-emerald-300">Live</span>
          </div>

          <div class="space-y-3 p-5">
            <div class="rounded-xl bg-white/8 p-4">
              <div class="mb-3 flex items-center justify-between">
                <span class="text-sm font-bold text-white">Customer commented</span>
                <span class="text-xs font-semibold text-white/40">Instagram post</span>
              </div>
              <p class="text-sm leading-relaxed text-white/70">Price? Available in blue, size M?</p>
            </div>

            <div class="rounded-xl bg-indigo-500 p-4">
              <div class="mb-3 flex items-center justify-between">
                <span class="text-sm font-bold text-white">VoluChat replied</span>
                <span class="text-xs font-semibold text-white/70">&lt;1 sec</span>
              </div>
              <p class="text-sm leading-relaxed text-white">Sent you the price, photos, and size details in DM.</p>
            </div>

            <div class="grid gap-3 sm:grid-cols-3">
              <div class="rounded-xl border border-white/60 bg-white/80 p-3 backdrop-blur-xl">
                <div class="text-xs font-bold uppercase tracking-widest text-slate-400">Comments handled</div>
                <div class="mt-2 text-2xl font-black text-slate-950">80%</div>
              </div>
              <div class="rounded-xl border border-white/60 bg-white/80 p-3 backdrop-blur-xl">
                <div class="text-xs font-bold uppercase tracking-widest text-slate-400">Products found</div>
                <div class="mt-2 text-2xl font-black text-slate-950">3</div>
              </div>
              <div class="rounded-xl border border-white/60 bg-white/80 p-3 backdrop-blur-xl">
                <div class="text-xs font-bold uppercase tracking-widest text-slate-400">Next step</div>
                <div class="mt-2 text-sm font-black text-slate-950">WhatsApp</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {features.map((feature, index) => (
          <div class={`glass-card rounded-2xl p-6 ${index === 0 ? 'sm:col-span-2' : ''}`}>
            <div class="mb-5 flex items-center justify-between gap-4">
              <div class={`flex h-11 w-11 items-center justify-center rounded-xl ${index === 0 ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-500/20' : 'bg-white/65 text-slate-700'}`}>
                {index === 0 && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>}
                {index === 1 && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>}
                {index === 2 && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.77.63 2.6a2 2 0 0 1-.45 2.11L8.1 9.91a16 16 0 0 0 6 6l1.48-1.19a2 2 0 0 1 2.11-.45c.83.3 1.7.51 2.6.63A2 2 0 0 1 22 16.92z"/></svg>}
                {index === 3 && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>}
                {index === 4 && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.4 2.6a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4Z"/></svg>}
                {index === 5 && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>}
              </div>
              <span class={`rounded-full border border-white/60 bg-white/55 px-3 py-1 text-xs font-bold backdrop-blur-xl ${index === 0 ? 'text-indigo-700' : 'text-slate-500'}`}>{feature.stat}</span>
            </div>
            <h3 class="text-xl font-heading font-bold text-slate-950">{feature.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
