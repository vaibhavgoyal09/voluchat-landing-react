---
const outcomes = [
  {
    label: "Answers repeated questions",
    detail: "Availability, size, COD, delivery, and basic policy replies happen inside the DM.",
  },
  {
    label: "Uses store context",
    detail: "Replies are grounded in product, inventory, delivery, and offer rules instead of generic scripts.",
  },
  {
    label: "Prepares the handoff",
    detail: "When the buyer is ready, the conversation moves toward a WhatsApp-ready order.",
  },
];
---

<section id="features" class="section-pad section-band-quiet relative overflow-hidden">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-stone-200 to-transparent"></div>

  <div class="page-shell relative z-10">
    <div class="mx-auto max-w-3xl text-center reveal-on-scroll">
      <p class="section-eyebrow">DM-to-order automation</p>
      <h2 class="section-title mt-4">
        Real replies, ready for WhatsApp close.
      </h2>
      <p class="section-copy mx-auto mt-5 max-w-2xl">
        VoluChat handles the repetitive product conversation before your team steps in to confirm the order.
      </p>
    </div>

    <div class="mt-12 reveal-on-scroll reveal-delay-100">
      <div class="grid gap-10 lg:grid-cols-[0.86fr_1.14fr] lg:items-center">
        <div class="relative mx-auto w-full max-w-[18.5rem]">
          <img
            src="/feature-dm-workflow.png"
            alt="Instagram DM conversation where VoluChat answers product availability, COD, and prepares a WhatsApp order handoff"
            class="w-full rounded-[1.65rem] border border-stone-200 bg-white shadow-[0_28px_90px_rgba(28,25,23,0.16)]"
            loading="lazy"
            decoding="async"
            width="266"
            height="468"
          />
        </div>

        <div class="mx-auto w-full max-w-2xl lg:mx-0">
          <div class="rounded-[1.5rem] border border-stone-200 bg-white/86 p-5 shadow-[0_24px_80px_rgba(28,25,23,0.075)] backdrop-blur-xl sm:p-6 lg:p-7">
            <div class="flex flex-wrap items-center gap-3 border-b border-stone-200 pb-5">
              <span class="rounded-full bg-primary-900 px-3 py-1.5 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-white">
                Live DM flow
              </span>
              <span class="text-sm font-semibold text-stone-500">
                Buyer asks, VoluChat answers, handoff gets prepared.
              </span>
            </div>

            <div class="divide-y divide-stone-200">
              {outcomes.map((item, index) => (
                <article class="grid gap-4 py-5 sm:grid-cols-[3rem_1fr]">
                  <span class="grid h-10 w-10 place-items-center rounded-xl bg-primary-50 font-mono text-xs font-semibold text-primary-800 ring-1 ring-primary-100">
                    0{index + 1}
                  </span>
                  <div>
                    <h3 class="text-xl font-semibold leading-tight text-stone-950">
                      {item.label}
                    </h3>
                    <p class="mt-2 text-sm font-medium leading-relaxed text-stone-600">
                      {item.detail}
                    </p>
                  </div>
                </article>
              ))}
            </div>

            <div class="rounded-2xl bg-primary-900 px-5 py-4 text-white">
              <p class="text-sm font-semibold leading-relaxed text-primary-50/84">
                Your team stays in control of confirmation, payment, exceptions, and customer judgment.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
