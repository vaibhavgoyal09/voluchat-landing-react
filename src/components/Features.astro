---
const features = [
  {
    title: "24/7 Smart Cover",
    description: "Never keep a shopper waiting. VoluChat replies to comments and DMs while your boutique team is busy.",
    stat: "Always online",
    badge: "Automated engagement"
  },
  {
    title: "AI Catalog Search",
    description: "Buyers can describe an outfit, shade, size, or screenshot. VoluChat matches it against your boutique catalog.",
    stat: "Vector search",
    badge: "Catalog discovery"
  },
  {
    title: "Buyer Details Collected",
    description: "VoluChat collects size, color, quantity, delivery, and offer details before passing the chat to WhatsApp.",
    stat: "Ready to close",
    badge: "Zero repetitive typing"
  }
];

const matches = [
  { name: "Linen co-ord", image: "/white_runner_thumb.webp", score: "Best match" },
  { name: "Satin kurta set", image: "/grey_runner_thumb.webp", score: "Close match" },
  { name: "Denim overshirt", image: "/grey_runner_thumb.webp", score: "Related style" }
];
---

<section id="features" class="relative overflow-hidden py-28 md:py-36">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-15"></div>
    <div class="absolute -left-44 top-24 h-[36rem] w-[36rem] rounded-full bg-primary-300/12 blur-3xl"></div>
    <div class="absolute right-0 bottom-12 h-[36rem] w-[36rem] rounded-full bg-stone-300/12 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-3xl text-center mb-24">
      <!-- Standardized Glowing Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-lg border border-primary-200/70 bg-primary-50/70 px-4 py-1.5 text-xs font-semibold text-primary-800 shadow-sm backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-primary-600 shadow-[0_0_8px_rgba(51,141,115,0.42)]"></span>
        <span>AI helpdesk capabilities for boutique sellers</span>
      </div>
      <!-- Consistent Responsive Heading -->
      <h2 class="text-3xl font-heading font-semibold leading-[1.1] tracking-tight text-stone-950 sm:text-5xl lg:text-6xl">
        The first layer of boutique DM work, handled before staff steps in.
      </h2>
      <p class="mx-auto mt-6 text-lg font-semibold leading-relaxed text-stone-600 sm:text-xl">
        VoluChat takes care of routine catalog questions and buyer details so your staff can focus on real conversations in WhatsApp.
      </p>
    </div>

    <!-- 3-Column Feature Grid with Interactive Micro-UIs -->
    <div class="grid gap-8 lg:grid-cols-3">
      
      <!-- Feature 1: 24/7 Smart Cover -->
      <div class="glass-card-premium rounded-2xl p-8 shadow-xl flex flex-col justify-between h-full hover:-translate-y-2 hover:shadow-2xl hover:border-primary-500/20 transition-all duration-500 group/card reveal-on-scroll">
        <div>
          <div class="flex items-center justify-between gap-4 mb-6">
            <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-primary-700 bg-primary-50/50 border border-primary-100/50 px-3 py-1 rounded-full">Always online</span>
            <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)] animate-pulse"></span>
          </div>

          <h3 class="font-heading text-2xl font-semibold tracking-tight text-stone-950 mb-3">24/7 Smart Cover</h3>
          <p class="text-sm font-semibold leading-relaxed text-stone-600 mb-8">Never keep a shopper waiting. VoluChat replies to comments and DMs while your boutique team is busy.</p>
        </div>

        <!-- Micro-UI: DM Mockup -->
        <div class="rounded-2xl border border-stone-100 bg-stone-50/50 p-4 space-y-3 shadow-inner">
          <div class="flex gap-2">
            <img src="/buyer_avatar.webp" alt="Buyer Avatar" class="h-6 w-6 rounded-full object-cover shrink-0 shadow-sm border border-stone-100" />
            <div class="rounded-2xl bg-white border border-stone-100 p-2.5 text-[11px] font-medium text-stone-800 shadow-sm max-w-[80%]">
              Hi, is the sage co-ord set available in Size M?
            </div>
          </div>
          <div class="flex gap-2 justify-end">
            <div class="rounded-2xl bg-primary-700 p-2.5 text-[11px] font-semibold text-white shadow-md max-w-[80%]">
              Yes, Size M is available. Delivery is possible to your PIN code. Should I send this to WhatsApp?
            </div>
            <div class="h-6 w-6 rounded-full bg-primary-50 border border-primary-100 shrink-0 flex items-center justify-center p-1 shadow-sm">
              <img src="/voluchat_logo.svg" alt="VoluChat AI" class="w-full h-full object-contain" />
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 2: AI Product Matching -->
      <div class="glass-card-premium rounded-2xl p-8 shadow-xl flex flex-col justify-between h-full hover:-translate-y-2 hover:shadow-2xl hover:border-primary-500/20 transition-all duration-500 group/card reveal-on-scroll reveal-delay-100">
        <div>
          <div class="flex items-center justify-between gap-4 mb-6">
            <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-primary-700 bg-primary-50/50 border border-primary-100/50 px-3 py-1 rounded-full">Vector search</span>
            <span class="text-xs font-semibold text-stone-300">02</span>
          </div>

          <h3 class="font-heading text-2xl font-semibold tracking-tight text-stone-950 mb-3">AI Product Matching</h3>
          <p class="text-sm font-semibold leading-relaxed text-stone-600 mb-8">Buyers can describe a product or send a screenshot. VoluChat matches descriptions and photos to your boutique catalog.</p>
        </div>

        <!-- Micro-UI: Search Catalog Mockup -->
        <div class="rounded-2xl border border-stone-100 bg-stone-50/50 p-4 space-y-2.5 shadow-inner">
          <div class="text-[9px] font-semibold uppercase tracking-wider text-stone-400">Semantic matches found</div>
          {matches.map((item) => (
            <div class="flex items-center justify-between gap-3 bg-white border border-stone-100 p-2 rounded-xl shadow-sm hover:scale-[1.03] hover:shadow-md transition-all duration-300 group/item">
              <div class="flex items-center gap-2">
                <img src={item.image} alt={item.name} class="h-10 w-10 object-contain bg-white border border-stone-100 rounded-lg flex-shrink-0 p-0.5" />
                <div class="text-xs font-semibold text-stone-950 group-hover/item:text-primary-700 transition-colors">{item.name}</div>
              </div>
              <span class="text-[10px] font-semibold text-primary-700 bg-primary-50 px-2 py-0.5 rounded-full border border-primary-100/30">{item.score}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Feature 3: Buyer Details Collection -->
      <div class="glass-card-premium rounded-2xl p-8 shadow-xl flex flex-col justify-between h-full hover:-translate-y-2 hover:shadow-2xl hover:border-primary-500/20 transition-all duration-500 group/card reveal-on-scroll reveal-delay-200">
        <div>
          <div class="flex items-center justify-between gap-4 mb-6">
            <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-primary-700 bg-primary-50/50 border border-primary-100/50 px-3 py-1 rounded-full">Ready to close</span>
            <span class="text-xs font-semibold text-stone-300">03</span>
          </div>

          <h3 class="font-heading text-2xl font-semibold tracking-tight text-stone-950 mb-3">Buyer Details Collected</h3>
          <p class="text-sm font-semibold leading-relaxed text-stone-600 mb-8">VoluChat gathers sizing, color, quantity, and delivery address in the DM before passing the buyer to your team on WhatsApp.</p>
        </div>

        <!-- Micro-UI: Structured Lead Handoff Card -->
        <div class="rounded-2xl border border-stone-100 bg-stone-50/50 p-4 space-y-2 shadow-inner">
          <div class="text-[9px] font-semibold uppercase tracking-wider text-stone-400">Buyer Summary Card</div>
          <div class="grid grid-cols-2 gap-2">
            <div class="bg-white border border-stone-100 p-2 rounded-xl shadow-sm text-center hover:scale-[1.03] hover:border-primary-100 hover:shadow-md transition-all duration-300">
              <div class="text-[8px] font-semibold uppercase tracking-wider text-stone-400">Size</div>
              <div class="text-xs font-semibold text-stone-900 mt-0.5">Size M</div>
            </div>
            <div class="bg-white border border-stone-100 p-2 rounded-xl shadow-sm text-center hover:scale-[1.03] hover:border-primary-100 hover:shadow-md transition-all duration-300">
              <div class="text-[8px] font-semibold uppercase tracking-wider text-stone-400">Color</div>
              <div class="text-xs font-semibold text-stone-900 mt-0.5">Sage</div>
            </div>
            <div class="bg-white border border-stone-100 p-2.5 rounded-xl shadow-sm col-span-2 flex items-center justify-between hover:scale-[1.03] hover:border-emerald-100 hover:shadow-md transition-all duration-300">
              <div>
                <div class="text-[8px] font-semibold uppercase tracking-wider text-stone-400">Shipping Pin</div>
                <div class="text-xs font-semibold text-stone-900 mt-0.5">Pune 411014</div>
              </div>
              <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
