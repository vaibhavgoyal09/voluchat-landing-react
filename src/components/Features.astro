---
const setupAdvantages = [
  {
    eyebrow: "Buyer qualification",
    title: "Qualify buyers before your team steps in",
    text: "VoluChat can ask the right follow-ups, identify purchase intent, collect useful context, and separate routine questions from conversations that need a human.",
    steps: ["Buyer intent", "Need captured", "Priority tagged", "Next step"],
    metric: "Workflow",
    metricValue: "Qualified chats",
  },
  {
    eyebrow: "Catalog logic",
    title: "Shape replies around your products and rules",
    text: "The agent uses your catalog, variants, policies, offers, delivery rules, COD rules, and brand voice so replies match how your store actually sells.",
    steps: ["Buyer need", "Catalog match", "Rule check", "Helpful reply"],
    metric: "Context",
    metricValue: "Store-aware",
  },
  {
    eyebrow: "Team handoff",
    title: "Route clean sales context to the right next step",
    text: "VoluChat can prepare WhatsApp handoffs, summarize buyer context, flag exceptions, and keep your team focused on confirmation, payment, and judgment calls.",
    steps: ["Context summary", "Exception check", "Handoff route", "Team close"],
    metric: "Handoff",
    metricValue: "Ready context",
  },
];
---

<section id="features" class="section-pad relative overflow-hidden">
  <div class="page-shell">
    <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start lg:gap-10">
      <div class="relative z-10 max-w-xl reveal-on-scroll lg:sticky lg:top-28">
        <p class="section-eyebrow">Custom sales workflows</p>
        <h2 class="section-title mt-4">
          Configure the repeat sales work around your team.
        </h2>
        <p class="section-copy mt-5">
          VoluChat starts with the repeated conversations your team handles every day, then turns them into a workflow for qualification, catalog help, routing, and handoff.
        </p>
        <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          <div class="rounded-xl border border-stone-200 bg-white/80 p-4 shadow-sm">
            <p class="mini-label">Broad tools</p>
            <p class="mt-2 text-sm font-semibold leading-snug text-stone-600">More builders, more branches, more setup choices.</p>
          </div>
          <div class="rounded-xl border border-primary-100 bg-primary-50/80 p-4 shadow-sm">
            <p class="mini-label text-primary-700">VoluChat</p>
            <p class="mt-2 text-sm font-semibold leading-snug text-stone-700">A custom AI sales workflow configured with your catalog, rules, and team process.</p>
          </div>
        </div>
      </div>

      <div class="relative z-20 grid gap-4">
        {setupAdvantages.map((item, index) => (
          <article class={`kinetic-card group solid-card transition duration-500 hover:-translate-y-1 hover:bg-white sm:p-5 reveal-on-scroll ${index === 1 ? 'reveal-delay-100' : index === 2 ? 'reveal-delay-200' : ''}`}>
            <div class="grid gap-5 sm:grid-cols-[0.9fr_1.1fr] sm:items-center">
              <div class="rounded-xl border border-stone-200 bg-stone-50 p-4">
                <div class="flex items-center justify-between gap-3">
                  <p class="mini-label">{item.metric}</p>
                  <span class="rounded-md bg-white px-2.5 py-1 font-mono text-[10px] font-semibold text-primary-700 shadow-sm">{item.metricValue}</span>
                </div>
                <div class="mt-4 space-y-2">
                  {item.steps.map((label, stepIndex) => (
                    <div class="flex items-center gap-3 rounded-lg border border-stone-200 bg-white px-3 py-2">
                      <span class="grid h-6 w-6 shrink-0 place-items-center rounded-md bg-primary-800 font-mono text-[10px] font-semibold text-white">
                        {stepIndex + 1}
                      </span>
                      <span class="text-xs font-semibold text-stone-700">{label}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div>
                <p class="mini-label text-primary-700">{item.eyebrow}</p>
                <h3 class="text-xl font-semibold text-stone-950 sm:text-2xl">{item.title}</h3>
                <p class="mt-3 text-sm font-medium leading-relaxed text-stone-600">{item.text}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
