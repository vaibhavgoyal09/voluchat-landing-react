---
const features = [
  {
    title: "24/7 Smart Cover",
    description: "Never keep a buyer waiting. VoluChat instantly replies to comments and DMs, keeping the excitement alive day or night.",
    stat: "Always online",
    badge: "Automated engagement"
  },
  {
    title: "AI Product Matching",
    description: "Buyers can describe a product or send a screenshot. VoluChat uses vector search to match it against your catalog in seconds.",
    stat: "Vector search",
    badge: "Catalog discovery"
  },
  {
    title: "Lead Qualification",
    description: "VoluChat collects size, color, quantity, and delivery address before passing the chat to WhatsApp, pre-qualifying the lead.",
    stat: "Ready to close",
    badge: "Zero repetitive typing"
  }
];

const matches = ["White Runner", "Grey Runner", "Black Trainer"];
---

<section id="features" class="relative overflow-hidden py-24 md:py-32">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-15"></div>
    <div class="absolute -left-44 top-24 h-[36rem] w-[36rem] rounded-full bg-blue-300/15 blur-3xl"></div>
    <div class="absolute right-0 bottom-12 h-[36rem] w-[36rem] rounded-full bg-indigo-300/10 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-3xl text-center mb-20">
      <!-- Standardized Glowing Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50/70 px-4 py-1.5 text-xs font-black text-blue-700 shadow-sm backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-blue-600 shadow-[0_0_8px_rgba(59,130,246,0.6)]"></span>
        <span>AI Capabilities</span>
      </div>
      <!-- Consistent Responsive Heading -->
      <h2 class="text-3xl font-heading font-black leading-[1.1] tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
        Automate the first layer of Instagram DM sales.
      </h2>
      <p class="mx-auto mt-6 text-lg font-semibold leading-relaxed text-slate-600 sm:text-xl">
        Our AI DM helpdesk takes care of routine catalog queries and details so your staff can focus purely on closing sales on WhatsApp.
      </p>
    </div>

    <!-- 3-Column Feature Grid with Interactive Micro-UIs -->
    <div class="grid gap-8 lg:grid-cols-3">
      
      <!-- Feature 1: 24/7 Smart Cover -->
      <div class="glass-card-premium rounded-[2rem] p-8 shadow-xl flex flex-col justify-between h-full">
        <div>
          <div class="flex items-center justify-between gap-4 mb-6">
            <span class="text-[10px] font-black uppercase tracking-[0.18em] text-blue-600 bg-blue-50/50 border border-blue-100/50 px-3 py-1 rounded-full">Always online</span>
            <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)] animate-pulse"></span>
          </div>

          <h3 class="font-heading text-2xl font-black tracking-tight text-slate-950 mb-3">24/7 Smart Cover</h3>
          <p class="text-sm font-semibold leading-relaxed text-slate-600 mb-8">Never keep a buyer waiting. VoluChat instantly replies to comments and DMs, keeping the excitement alive day or night.</p>
        </div>

        <!-- Micro-UI: DM Mockup -->
        <div class="rounded-2xl border border-slate-100 bg-slate-50/50 p-4 space-y-3 shadow-inner">
          <div class="flex gap-2">
            <div class="h-6 w-6 rounded-full bg-slate-200 shrink-0"></div>
            <div class="rounded-2xl bg-white border border-slate-100 p-2.5 text-[11px] font-medium text-slate-800 shadow-sm max-w-[80%]">
              Hi, is the white sneaker in stock in size 9?
            </div>
          </div>
          <div class="flex gap-2 justify-end">
            <div class="rounded-2xl bg-blue-600 p-2.5 text-[11px] font-semibold text-white shadow-md max-w-[80%]">
              Yes, white runner sneaker is available in size 9! ⚡️ Shipping is free today. Should I secure it for you?
            </div>
            <div class="h-6 w-6 rounded-full bg-blue-100 border border-blue-200 shrink-0 flex items-center justify-center text-[8px] font-black text-blue-700">AI</div>
          </div>
        </div>
      </div>

      <!-- Feature 2: AI Product Matching -->
      <div class="glass-card-premium rounded-[2rem] p-8 shadow-xl flex flex-col justify-between h-full">
        <div>
          <div class="flex items-center justify-between gap-4 mb-6">
            <span class="text-[10px] font-black uppercase tracking-[0.18em] text-blue-600 bg-blue-50/50 border border-blue-100/50 px-3 py-1 rounded-full">Vector search</span>
            <span class="text-xs font-black text-slate-300">02</span>
          </div>

          <h3 class="font-heading text-2xl font-black tracking-tight text-slate-950 mb-3">AI Product Matching</h3>
          <p class="text-sm font-semibold leading-relaxed text-slate-600 mb-8">Buyers can describe a product or send a screenshot. VoluChat matches descriptions and photos to your catalog in seconds.</p>
        </div>

        <!-- Micro-UI: Search Catalog Mockup -->
        <div class="rounded-2xl border border-slate-100 bg-slate-50/50 p-4 space-y-2.5 shadow-inner">
          <div class="text-[9px] font-black uppercase tracking-wider text-slate-400">Semantic matches found</div>
          {matches.map((item, index) => (
            <div class="flex items-center justify-between gap-3 bg-white border border-slate-100 p-2 rounded-xl shadow-sm">
              <div class="flex items-center gap-2">
                <div class="h-8 w-10 bg-gradient-to-br from-blue-50 to-indigo-50 border border-slate-100 rounded-lg flex items-center justify-center text-[8px] font-black text-slate-400">IMG</div>
                <div class="text-xs font-black text-slate-950">{item}</div>
              </div>
              <span class="text-[10px] font-black text-blue-600">{index === 0 ? "98%" : index === 1 ? "84%" : "72%"} Match</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Feature 3: Lead Qualification -->
      <div class="glass-card-premium rounded-[2rem] p-8 shadow-xl flex flex-col justify-between h-full">
        <div>
          <div class="flex items-center justify-between gap-4 mb-6">
            <span class="text-[10px] font-black uppercase tracking-[0.18em] text-blue-600 bg-blue-50/50 border border-blue-100/50 px-3 py-1 rounded-full">Ready to close</span>
            <span class="text-xs font-black text-slate-300">03</span>
          </div>

          <h3 class="font-heading text-2xl font-black tracking-tight text-slate-950 mb-3">Lead Qualification</h3>
          <p class="text-sm font-semibold leading-relaxed text-slate-600 mb-8">VoluChat gathers sizing, color, quantity, and delivery address before passing the chat to WhatsApp, pre-qualifying the lead.</p>
        </div>

        <!-- Micro-UI: Structured Lead Handoff Card -->
        <div class="rounded-2xl border border-slate-100 bg-slate-50/50 p-4 space-y-2 shadow-inner">
          <div class="text-[9px] font-black uppercase tracking-wider text-slate-400">Buyer Summary Card</div>
          <div class="grid grid-cols-2 gap-2">
            <div class="bg-white border border-slate-100 p-2 rounded-xl shadow-sm text-center">
              <div class="text-[8px] font-black uppercase tracking-wider text-slate-400">Size</div>
              <div class="text-xs font-black text-slate-900 mt-0.5">UK 9</div>
            </div>
            <div class="bg-white border border-slate-100 p-2 rounded-xl shadow-sm text-center">
              <div class="text-[8px] font-black uppercase tracking-wider text-slate-400">Color</div>
              <div class="text-xs font-black text-slate-900 mt-0.5">Classic White</div>
            </div>
            <div class="bg-white border border-slate-100 p-2.5 rounded-xl shadow-sm col-span-2 flex items-center justify-between">
              <div>
                <div class="text-[8px] font-black uppercase tracking-wider text-slate-400">Shipping Pin</div>
                <div class="text-xs font-black text-slate-900 mt-0.5">Pune 411014</div>
              </div>
              <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

