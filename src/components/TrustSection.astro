---
const trustCards = [
  {
    code: "01",
    title: "100% White-Glove Setup Included",
    description:
      "We configure your Meta Business APIs, WhatsApp Business accounts, and sync your Shopify product catalog with zero developer effort on your side.",
  },
  {
    code: "02",
    title: "Instant Human Takeover Anytime",
    description:
      "If a high-ticket customer requests a customized order or VIP human assistance, your reps can seamlessly take over the WhatsApp chat with one click.",
  },
  {
    code: "03",
    title: "Strict Price & Discount Guardrails",
    description:
      "The AI strictly adheres to your configured pricing floors and coupon policies. It never offers unauthorized discounts or fabric guarantees.",
  },
  {
    code: "04",
    title: "Real Attributed Revenue Reporting",
    description:
      "Track every rupee generated. See exactly how many orders were closed by the AI agent in DMs and which Instagram Reels drove the sales.",
  },
];
---

<section class="section-band-quiet py-24 lg:py-32 relative overflow-hidden">
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
  >
  </div>

  <div class="page-shell">
    <div class="trust-header max-w-3xl opacity-0">
      <div class="chip mb-6 border-emerald-500/20 bg-emerald-500/10">
        <span class="mini-label text-emerald-300">White-Glove & Controlled</span>
      </div>
      <h2 class="section-title text-white">
        Zero technical setup.<br class="hidden sm:inline" />
        <span class="gradient-text-anim">Total brand control.</span>
      </h2>
      <p class="section-copy mt-6 max-w-2xl text-slate-300">
        You don't need to learn prompt engineering or build API connections. Our team builds, tests, and deploys your sales agent, while you maintain 100% oversight on every conversation.
      </p>
    </div>

    <!-- Editorial List Layout -->
    <div class="mt-16 md:mt-20 border-b border-white/10">
      {
        trustCards.map((card) => (
          <article
            class={`trust-row group relative border-t border-white/10 py-8 md:py-12 transition-all duration-500 hover:bg-gradient-to-r hover:from-emerald-500/[0.04] hover:to-transparent opacity-0`}
          >
            <!-- Hover left border indicator -->
            <div class="absolute left-0 top-0 bottom-0 w-[3px] bg-emerald-400 scale-y-0 group-hover:scale-y-100 origin-center transition-transform duration-500 ease-out"></div>
            
            <div class="grid items-start gap-4 md:grid-cols-12 md:gap-8 lg:gap-12 px-5 md:px-8">
              <!-- Large Typographic Number -->
              <div class="md:col-span-2 hidden md:block">
                <span class="font-heading text-5xl xl:text-6xl font-bold tracking-tighter text-white/5 group-hover:text-emerald-400/20 transition-colors duration-500">
                  {card.code}
                </span>
              </div>
              
              <!-- Title -->
              <div class="md:col-span-5 lg:col-span-4 flex flex-col justify-center">
                <span class="md:hidden font-mono text-xs font-bold tracking-widest text-emerald-400/60 mb-3">{card.code}</span>
                <h3 class="text-xl md:text-2xl lg:text-[1.65rem] font-bold leading-tight text-slate-200 font-heading group-hover:text-white transition-colors duration-500">
                  {card.title}
                </h3>
              </div>
              
              <!-- Description -->
              <div class="md:col-span-5 lg:col-span-6 flex flex-col justify-center">
                <p class="text-[1.05rem] font-medium leading-relaxed text-slate-400 group-hover:text-slate-200 transition-colors duration-500">
                  {card.description}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: ".trust-header",
        start: "top 78%",
      }
    });

    tl.fromTo(".trust-header", 
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }
    );

    // Editorial rows unroll horizontally with staggered slide
    tl.fromTo(".trust-row",
      { opacity: 0, x: -25 },
      { opacity: 1, x: 0, duration: 0.45, stagger: 0.1, ease: "power2.out" },
      "-=0.2"
    );
  });
</script>
