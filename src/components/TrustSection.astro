---
const trustCards = [
  {
    code: "01",
    title: "Approval before sensitive outreach",
    description:
      "Discounts, campaigns, and targeted follow-ups can sit in a queue until your team approves the exact action.",
  },
  {
    code: "02",
    title: "Decision history stays visible",
    description:
      "See what the agent recommended, which rule was applied, who approved it, and what happened afterward.",
  },
  {
    code: "03",
    title: "Store context limits the agent",
    description:
      "Answers and actions are grounded in live Shopify inventory, cart data, historical orders, and your policies.",
  },
  {
    code: "04",
    title: "Revenue is tied back to the workflow",
    description:
      "Recovered carts, accepted offers, and cleared stock are attributed to the agent action that influenced them.",
  },
];
---

<section class="section-band-quiet py-24 lg:py-32 relative overflow-hidden">
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
  >
  </div>

  <div class="page-shell">
    <!-- Stacked Header (Compliant with split-header ban) -->
    <div class="trust-header max-w-3xl opacity-0">
      <div class="chip mb-6">
        <span class="mini-label">Safe & Controlled</span>
      </div>
      <h2 class="section-title text-white">
        AI recommends.<br class="hidden sm:inline" />
        <span class="gradient-text-anim">Your team stays in control.</span>
      </h2>
      <p class="section-copy mt-6 max-w-2xl text-slate-300">
        VoluChat surfaces the right next step, shows the context behind the recommendation, and keeps your team in charge of approving important actions.
      </p>
    </div>

    <!-- Editorial List Layout (No Cards) -->
    <div class="mt-16 md:mt-20 border-b border-white/10">
      {
        trustCards.map((card, index) => (
          <article
            class={`trust-row group relative border-t border-white/10 py-8 md:py-12 transition-all duration-500 hover:bg-gradient-to-r hover:from-teal-500/[0.04] hover:to-transparent opacity-0`}
          >
            <!-- Hover left border indicator -->
            <div class="absolute left-0 top-0 bottom-0 w-[3px] bg-teal-400 scale-y-0 group-hover:scale-y-100 origin-center transition-transform duration-500 ease-out"></div>
            
            <div class="grid items-start gap-4 md:grid-cols-12 md:gap-8 lg:gap-12 px-5 md:px-8">
              <!-- Large Typographic Number -->
              <div class="md:col-span-2 hidden md:block">
                <span class="font-heading text-5xl xl:text-6xl font-bold tracking-tighter text-white/5 group-hover:text-teal-400/20 transition-colors duration-500">
                  {card.code}
                </span>
              </div>
              
              <!-- Title -->
              <div class="md:col-span-5 lg:col-span-4 flex flex-col justify-center">
                <span class="md:hidden font-mono text-xs font-bold tracking-widest text-teal-400/60 mb-3">{card.code}</span>
                <h3 class="text-xl md:text-2xl lg:text-[1.65rem] font-bold leading-tight text-slate-200 font-heading group-hover:text-white transition-colors duration-500">
                  {card.title}
                </h3>
              </div>
              
              <!-- Description -->
              <div class="md:col-span-5 lg:col-span-6 flex flex-col justify-center">
                <p class="text-[1.05rem] font-medium leading-relaxed text-slate-400 group-hover:text-slate-200 transition-colors duration-500">
                  {card.description}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: ".trust-header",
        start: "top 80%",
        end: "bottom 20%",
        toggleActions: "play reverse play reverse"
      }
    });

    tl.fromTo(".trust-header", 
      { opacity: 0, y: 30, filter: "blur(10px)" },
      { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.8, ease: "power3.out" }
    );

    tl.fromTo(".trust-row",
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 0.7, stagger: 0.15, ease: "power2.out" },
      "-=0.4"
    );
  });
</script>
