---
const trustPillars = [
  {
    label: "Meta access",
    title: "Official APIs only",
    text: "VoluChat uses Meta login and scoped permissions. You never share your Instagram or Facebook password with us.",
    detail: "OAuth permissions",
  },
  {
    label: "Store data",
    title: "Your catalog stays yours",
    text: "Product data, buyer chats, and customer details are used to run your reply workflow, not resold or shared.",
    detail: "Private by default",
  },
  {
    label: "Team control",
    title: "Humans keep the final close",
    text: "Your team still approves the order, shares payment instructions, and decides when a conversation needs attention.",
    detail: "Sales-led handoff",
  },
];
---

<section id="security" class="section-pad relative overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_14%_18%,rgba(229,237,246,0.58),transparent_30%),radial-gradient(circle_at_86%_12%,rgba(255,255,255,0.8),transparent_28%)]"></div>
  <div class="ambient-noise"></div>

  <div class="page-shell relative z-10">
    <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-center">
      <div class="max-w-xl reveal-on-scroll">
        <p class="section-eyebrow">Trust and control</p>
        <h2 class="section-title mt-4">
          Connect safely without handing over your Instagram or Facebook account.
        </h2>
        <p class="section-copy mt-5">
          VoluChat is designed for stores that want faster replies without giving up account access, data ownership, or judgment on the final sale.
        </p>
        <a href="/security" class="btn-secondary mt-7">
          Read security details
        </a>
      </div>

      <div class="solid-card reveal-on-scroll reveal-delay-100">
        <div class="flex flex-col gap-5 border-b border-stone-200/80 pb-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="mini-label">Connection method</p>
            <h3 class="mt-2 text-2xl font-semibold leading-tight text-stone-950">Meta Graph API</h3>
          </div>
          <div class="rounded-xl border border-primary-100 bg-primary-50 px-4 py-3 text-right">
            <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-primary-700">No password sharing</p>
            <p class="mt-1 text-sm font-semibold text-stone-950">Scoped login</p>
          </div>
        </div>

        <div class="mt-6 grid gap-4">
          {trustPillars.map((pillar) => (
            <article class="rounded-xl border border-stone-200/80 bg-stone-50/70 p-4">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <p class="mini-label">{pillar.label}</p>
                  <h4 class="mt-2 text-lg font-semibold text-stone-950">{pillar.title}</h4>
                  <p class="mt-2 text-sm font-medium leading-relaxed text-stone-600">{pillar.text}</p>
                </div>
                <span class="shrink-0 rounded-full border border-white bg-white px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-primary-700 shadow-sm">
                  {pillar.detail}
                </span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
