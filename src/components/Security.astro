---
---

<section id="security" class="relative overflow-hidden py-28 md:py-36">
  <!-- Background elements -->
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="sect-grid opacity-15"></div>
    <div class="absolute -right-44 top-1/4 h-[36rem] w-[36rem] rounded-full bg-blue-300/10 blur-3xl"></div>
    <div class="absolute left-12 bottom-24 h-[36rem] w-[36rem] rounded-full bg-indigo-300/15 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-3xl text-center mb-20">
      <!-- Standardized Glowing Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50/70 px-4 py-1.5 text-xs font-black text-blue-700 shadow-sm backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-blue-600 shadow-[0_0_8px_rgba(59,130,246,0.6)] animate-pulse"></span>
        <span>Meta Partner & Compliance</span>
      </div>
      <!-- Consistent Responsive Heading -->
      <h2 class="text-3xl font-heading font-black leading-[1.1] tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
        Security you can bet <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">your store on</span>.
      </h2>
      <p class="mx-auto mt-6 text-lg font-semibold leading-relaxed text-slate-600 sm:text-xl">
        We handle your access tokens and store data with uncompromising security. Built exclusively on official APIs and military-grade cryptography.
      </p>
    </div>

    <!-- Main Content: Premium Banner + Grid -->
    <div class="space-y-12">
      <!-- Meta Tech Partner Premium Banner -->
      <div class="relative overflow-hidden rounded-[2.5rem] border border-blue-100/70 bg-gradient-to-r from-blue-50/80 via-indigo-50/30 to-purple-50/60 p-8 md:p-12 backdrop-blur-xl shadow-xl hover:shadow-2xl transition-all duration-500 reveal-on-scroll">
        <div class="absolute -right-16 -top-16 w-56 h-56 rounded-full bg-indigo-500/10 blur-3xl pointer-events-none"></div>
        <div class="absolute -left-16 -bottom-16 w-56 h-56 rounded-full bg-purple-500/10 blur-3xl pointer-events-none"></div>
        
        <div class="flex flex-col lg:flex-row items-center gap-10 relative z-10">
          <!-- Badge / Icon Container with pulsing glowing effects -->
          <div class="flex-shrink-0 w-32 h-32 rounded-3xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-purple-600 p-0.5 shadow-xl shadow-indigo-500/20 flex items-center justify-center group/seal">
            <div class="w-full h-full bg-slate-950 rounded-[22px] flex flex-col items-center justify-center p-4 text-center transition-all duration-500 group-hover/seal:bg-slate-900">
              <span class="text-[10px] font-black tracking-widest text-indigo-400 uppercase">OFFICIAL</span>
              <span class="font-heading font-black text-2xl text-white leading-none tracking-tighter mt-1">Meta</span>
              <span class="text-[9px] font-bold text-slate-400 mt-2 uppercase tracking-wider">Tech Partner</span>
            </div>
          </div>
          
          <div class="flex-1 text-center lg:text-left space-y-4">
            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3">
              <span class="inline-flex items-center gap-1.5 text-xs font-black text-indigo-700 bg-indigo-100/60 px-3.5 py-1.5 rounded-full border border-indigo-200 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-indigo-600 animate-ping"></span>
                Meta Verified Tech Partner
              </span>
              <span class="text-[11px] font-black text-slate-400 uppercase tracking-[0.18em]">Audited & Approved</span>
            </div>
            
            <h3 class="text-2xl font-heading font-black text-slate-955 tracking-tight sm:text-3xl">
              Direct Meta-Vetted Integration
            </h3>
            <p class="text-sm sm:text-base font-semibold leading-relaxed text-slate-600">
              VoluChat is recognized as an official <strong class="text-slate-900">Meta Tech Partner</strong>. Our app integration with the Meta Graph API has undergone comprehensive, direct security audits by Meta's developer operations team. We comply 100% with the strictest platform safety and access guidelines, ensuring your Instagram page and brand assets are protected at all times.
            </p>
          </div>
        </div>
      </div>

      <!-- 3-Column Pillar Grid -->
      <div class="grid gap-8 md:grid-cols-3">
        
        <!-- Pillar 1: Meta's Secure Graph API Only -->
        <div class="glass-card-premium rounded-[2rem] p-8 shadow-xl flex flex-col justify-between h-full hover:-translate-y-2 hover:shadow-2xl hover:border-blue-500/20 transition-all duration-500 group/pillar reveal-on-scroll">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 mb-6 group-hover/pillar:scale-110 transition-transform duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 16.875V16.5m-1.05-11.85a4.875 4.875 0 0 0-4.836 4.492m11.414 0a4.875 4.875 0 0 0-4.836-4.492m-5.593 14.197H12m0 0h-.013m-.013 0H8.25m4-13.481L12 14.25" />
              </svg>
            </div>

            <h3 class="font-heading text-xl font-black tracking-tight text-slate-955 mb-3">Official Meta Graph API</h3>
            <p class="text-xs font-semibold leading-relaxed text-slate-500 mb-6">
              We never ask for your Instagram password, and we absolutely do not use fragile, policy-violating browser scrapers. We interact exclusively through the secure, official Meta Graph API endpoints using scoped OAuth tokens.
            </p>
          </div>

          <div class="rounded-xl border border-slate-100 bg-slate-50/50 p-4 space-y-2 shadow-inner font-mono text-[9px]">
            <div class="flex items-center justify-between text-slate-400">
              <span>API PROTOCOL</span>
              <span class="text-blue-600 font-bold">OAUTH 2.0</span>
            </div>
            <div class="bg-white border border-slate-100 p-2 rounded-lg text-slate-800 flex items-center justify-between shadow-sm">
              <span class="truncate">https://graph.instagram.com/v20.0/me...</span>
              <span class="text-emerald-500 font-bold shrink-0">TLS 1.3</span>
            </div>
          </div>
        </div>

        <!-- Pillar 2: No Third-Party Data Sharing -->
        <div class="glass-card-premium rounded-[2rem] p-8 shadow-xl flex flex-col justify-between h-full hover:-translate-y-2 hover:shadow-2xl hover:border-blue-500/20 transition-all duration-500 group/pillar reveal-on-scroll reveal-delay-100">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 mb-6 group-hover/pillar:scale-110 transition-transform duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>

            <h3 class="font-heading text-xl font-black tracking-tight text-slate-955 mb-3">No Third-Party Sharing</h3>
            <p class="text-xs font-semibold leading-relaxed text-slate-500 mb-6">
              Your catalog items, buyer chats, and customer details are entirely yours. We never share, rent, or sell your account data, conversations, or buyer metrics to any third-party advertising or analytics networks.
            </p>
          </div>

          <div class="rounded-xl border border-emerald-100/50 bg-emerald-50/20 p-4 space-y-2 shadow-inner font-mono text-[9px]">
            <div class="flex items-center justify-between text-slate-400">
              <span>DATA GOVERNANCE</span>
              <span class="text-emerald-600 font-bold">100% PRIVATE</span>
            </div>
            <div class="bg-white border border-slate-100 p-2 rounded-lg text-slate-800 flex items-center gap-2 shadow-sm">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 shrink-0 animate-pulse"></span>
              <span>Strict DB Tenant Isolation Active</span>
            </div>
          </div>
        </div>

        <!-- Pillar 3: Advanced Cryptographic Locking -->
        <div class="glass-card-premium rounded-[2rem] p-8 shadow-xl flex flex-col justify-between h-full hover:-translate-y-2 hover:shadow-2xl hover:border-blue-500/20 transition-all duration-500 group/pillar reveal-on-scroll reveal-delay-200">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-purple-50 border border-purple-100 flex items-center justify-center text-purple-600 mb-6 group-hover/pillar:scale-110 transition-transform duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
              </svg>
            </div>

            <h3 class="font-heading text-xl font-black tracking-tight text-slate-955 mb-3">Military-Grade Security</h3>
            <p class="text-xs font-semibold leading-relaxed text-slate-500 mb-6">
              All stored credentials, catalog details, and session keys are locked using advanced AES-256-GCM. We apply salt and pepper configurations alongside memory-hard Argon2id hashing algorithms for zero leak risk.
            </p>
          </div>

          <div class="rounded-xl border border-slate-100 bg-slate-50/50 p-4 space-y-2 shadow-inner font-mono text-[9px]">
            <div class="flex items-center justify-between text-slate-400">
              <span>SECURITY VAULT</span>
              <span class="text-purple-600 font-bold">AES-256-GCM</span>
            </div>
            <div class="bg-white border border-slate-100 p-2 rounded-lg text-slate-800 flex items-center justify-between shadow-sm">
              <span class="truncate">ENC: $argon2id$v=19$m=65536...</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 text-emerald-500 shrink-0">
                <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 00-2 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd" />
              </svg>
            </div>
          </div>
        </div>

      </div>

      <!-- CTA to Detailed Standards Page -->
      <div class="text-center mt-12 reveal-on-scroll">
        <a href="/security" class="group inline-flex items-center gap-2 rounded-full border border-slate-200/80 bg-white/70 px-8 py-4 text-base font-black text-slate-900 shadow-sm backdrop-blur-xl transition-all duration-300 hover:bg-white hover:border-slate-300 hover:scale-[1.03] cursor-pointer">
          <span>Read our full Cryptographic Standards</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-slate-900 group-hover:translate-x-1 transition-transform">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
