---
const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: "Product",
    links: [
      { label: "Features", href: "/features" },
      { label: "Pricing", href: "/pricing" },
      { label: "All Integrations", href: "/integrations" },
      { label: "Shopify Integration", href: "/integrations/shopify" },
      { label: "Security & Guardrails", href: "/security" },
    ],
  },
  {
    title: "Compare",
    links: [
      { label: "vs Wati", href: "/compare/wati" },
      { label: "vs Bik.ai", href: "/compare/bik" },
      { label: "vs Limechat", href: "/compare/limechat" },
      { label: "vs Manychat", href: "/compare/manychat" },
      { label: "vs Interakt", href: "/compare/interakt" },
      { label: "vs Manual Reps", href: "/compare/manual-reps" },
      { label: "vs AiSensy", href: "/compare/aisensy" },
      { label: "vs Respond.io", href: "/compare/respond-io" },
      { label: "vs Chatfuel", href: "/compare/chatfuel" },
      { label: "vs Tidio", href: "/compare/tidio" },
      { label: "vs Zoko", href: "/compare/zoko" },
      { label: "All Comparisons", href: "/compare" },
      { label: "Alternatives Hub", href: "/alternatives" },
    ],
  },
  {
    title: "Learn",
    links: [
      { label: "Learn Hub", href: "/learn" },
      { label: "What-is Guides", href: "/what-is" },
      { label: "Glossary", href: "/glossary" },
      { label: "Blog", href: "/blog" },
      { label: "Revenue Calculator", href: "/comment-revenue-leak-calculator" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About VoluChat", href: "/about" },
      { label: "30-Day Free Trial", href: "/free-trial" },
      { label: "Chat on WhatsApp", href: "https://wa.me/918847568693?text=Hi%20Vaibhav%2C%20I'd%20like%20to%20know%20more%20about%20VoluChat." },
      { label: "Contact Us", href: "/contact" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Privacy Policy", href: "/privacy" },
      { label: "Terms & Conditions", href: "/terms" },
    ],
  },
];
---

<footer
  class="relative overflow-hidden border-t border-slate-200/80 bg-[#f8fafc] py-16"
>
  <div class="page-shell relative z-10">
    <section
      id="demo"
      class="rounded-3xl border border-slate-200/90 bg-white/80 mb-24 p-8 text-center sm:p-14 lg:p-16 relative overflow-hidden backdrop-blur-2xl shadow-sm"
    >
      <div class="chip-emerald mb-4 mx-auto inline-flex">
        <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-700">Online Sales Automation</span>
      </div>
      <h2
        class="mx-auto max-w-2xl text-3xl font-heading font-bold leading-tight text-slate-900 sm:text-4xl lg:text-5xl tracking-tight"
      >
        Your boutique keeps selling <em class="serif-accent">24/7</em>.
      </h2>
      <p
        class="mx-auto mt-5 max-w-2xl text-base font-normal leading-relaxed text-slate-600 sm:text-lg"
      >
        30 days free. White-glove setup in 48 hours. Zero technical skills needed.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/free-trial" class="btn-primary !px-7 !py-3.5">Start My 30-Day Free Trial &rarr;</a>
        <a
          href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-semibold text-slate-700 underline decoration-slate-300 underline-offset-4 transition-colors hover:text-emerald-700"
        >
          or test drive on WhatsApp &rarr;
        </a>
      </div>
      <div class="mt-8 flex items-center justify-center gap-4 text-xs font-mono text-slate-500 font-medium">
        <span>✓ 30 Days Free</span>
        <span>&bull;</span>
        <span>✓ 48h White-Glove Setup</span>
        <span>&bull;</span>
        <span>✓ Founder Support</span>
      </div>
    </section>

    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.2fr_repeat(5,1fr)]">
      <!-- Brand column -->
      <div class="flex flex-col gap-4">
        <a
          href="/"
          class="flex items-center gap-2.5 rounded-xl pr-2 transition hover:opacity-85"
          aria-label="VoluChat home"
        >
          <img
            src="/voluchat_logo.svg"
            alt="VoluChat Logo"
            class="h-8 w-8 object-contain"
          />
          <span class="font-heading text-xl font-bold text-slate-900">VoluChat</span
          >
        </a>
        <p
          class="text-xs text-slate-600 font-medium leading-relaxed max-w-[28ch]"
        >
          Official Meta Tech Partner. Autonomous WhatsApp, Instagram &amp; Facebook sales agents for fashion boutiques.
        </p>
        <div class="flex items-center gap-3 pt-1">
          <a
            href="https://www.instagram.com/voluchat"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-slate-900 transition p-1.5 -m-1.5 rounded-md hover:bg-slate-100"
            aria-label="VoluChat on Instagram"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
            </svg>
          </a>
          <a
            href="https://www.facebook.com/Voluchat"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-slate-900 transition p-1.5 -m-1.5 rounded-md hover:bg-slate-100"
            aria-label="VoluChat on Facebook"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
            </svg>
          </a>
          <a
            href="https://x.com/voluchat"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-slate-900 transition p-1.5 -m-1.5 rounded-md hover:bg-slate-100"
            aria-label="VoluChat on X (Twitter)"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/company/voluchat"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-slate-900 transition p-1.5 -m-1.5 rounded-md hover:bg-slate-100"
            aria-label="VoluChat on LinkedIn"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />
            </svg>
          </a>
          <a
            href="https://www.youtube.com/@voluchat"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-slate-900 transition p-1.5 -m-1.5 rounded-md hover:bg-slate-100"
            aria-label="VoluChat on YouTube"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" clip-rule="evenodd" />
            </svg>
          </a>
          <a
            href="https://github.com/voluchat"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-slate-900 transition p-1.5 -m-1.5 rounded-md hover:bg-slate-100"
            aria-label="VoluChat on GitHub"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>

      {
        footerSections.map((section) => (
          <div>
            <h3 class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-900">
              {section.title}
            </h3>
            <ul class="mt-4 space-y-2.5">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-xs text-slate-600 font-medium hover:text-slate-900 transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-16 pt-8 border-t border-slate-200/80 flex flex-col items-center justify-between gap-6 sm:flex-row"
    >
      <p
        class="text-[11px] font-medium text-slate-500 uppercase tracking-widest text-center sm:text-left leading-relaxed"
      >
        © {currentYear} QubitNine Technologies Pvt Ltd. All rights reserved.
      </p>
        <p class="text-xs text-slate-500 font-mono text-center sm:text-left">
          Autonomous AI Sales Agent for Fashion Boutiques on Instagram, Facebook Messenger &amp; WhatsApp.
        </p>

      <div
        class="flex gap-2.5 items-center px-3.5 py-1 rounded-full border border-slate-200 bg-white shadow-2xs"
      >
        <span
          class="h-2 w-2 rounded-full bg-emerald-500"
        ></span>
        <span
          class="text-[10px] font-semibold text-slate-700 uppercase tracking-widest"
          >Agent Engine Active</span
        >
      </div>
    </div>
  </div>
</footer>
