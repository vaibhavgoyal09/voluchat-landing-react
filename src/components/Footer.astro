---
import CTA from "./CTA.astro";
const currentYear = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-white/55 bg-white/25 backdrop-blur-2xl">
  <div class="max-w-7xl mx-auto px-6 relative z-10">

    <!-- CTA -->
    <CTA />

    <!-- Nav grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 py-12 border-t border-white/55">
      <div>
        <h3 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-4">Product</h3>
        <ul class="space-y-3">
          <li><a href="/features" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">Features</a></li>
          <li><a href="/pricing" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">Pricing</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-4">Company</h3>
        <ul class="space-y-3">
          <li><a href="/about" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">About Us</a></li>
          <li><a href="https://dashboard.voluchat.com" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">Get Started</a></li>
          <li><a href="/contact" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">Contact</a></li>
          <li><a href="/blog" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">Blog</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-4">Legal</h3>
        <ul class="space-y-3">
          <li><a href="/privacy" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">Privacy Policy</a></li>
          <li><a href="/terms" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">Terms of Service</a></li>
          <li><a href="#" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">Cookie Policy</a></li>
          <li><a href="#" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">GDPR</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-4">Support</h3>
        <ul class="space-y-3">
          <li><a href="/contact" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">Help Center</a></li>
          <li><a href="/#faq" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">FAQ</a></li>
          <li><a href="mailto:support@voluchat.com" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">Email Support</a></li>
          <li><a href="https://docs.voluchat.com" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-medium">Documentation</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-5 py-7 border-t border-white/55">
      <div class="flex items-center gap-2.5">
        <img src="/voluchat_logo.svg" alt="VoluChat" class="w-7 h-7" />
        <span class="font-heading font-bold text-lg text-slate-900">VoluChat</span>
      </div>
      <p class="text-sm text-slate-400">© {currentYear} VoluChat. All rights reserved.</p>
      <div class="flex gap-5 items-center">
        <a href="https://twitter.com/voluchat" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-indigo-600 transition-colors" aria-label="Twitter">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"/></svg>
        </a>
        <a href="https://linkedin.com/company/voluchat" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-indigo-600 transition-colors" aria-label="LinkedIn">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
