---
import CTA from "./CTA.astro";
const currentYear = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-stone-100 bg-white/40 backdrop-blur-3xl pt-24">
  <div class="relative z-10">
    <!-- CTA -->
    <CTA />

    <div class="max-w-7xl mx-auto px-6">
      <!-- Nav grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-12 py-20 border-t border-stone-100 mt-24">
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-stone-400 mb-6">Product</h3>
          <ul class="space-y-4">
            <li><a href="/features" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">Features</a></li>
            <li><a href="/pricing" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">Pricing</a></li>
            <li><a href="/compare" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">Compare</a></li>
            <li><a href="https://docs.voluchat.com" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">Documentation</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-stone-400 mb-6">Company</h3>
          <ul class="space-y-4">
            <li><a href="/about" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">About Us</a></li>
            <li><a href="/contact" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">Book Demo</a></li>
            <li><a href="/contact" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">Contact Support</a></li>
            <li><a href="/blog" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">Our Blog</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-stone-400 mb-6">Legal</h3>
          <ul class="space-y-4">
            <li><a href="/privacy" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">Privacy Policy</a></li>
            <li><a href="/terms" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">Terms of Service</a></li>
            <li><a href="/security" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">Security Standards</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-stone-400 mb-6">Connect</h3>
          <ul class="space-y-4">
            <li><a href="https://twitter.com/voluchat" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">Twitter / X</a></li>
            <li><a href="https://linkedin.com/company/voluchat" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">LinkedIn</a></li>
            <li><a href="https://instagram.com/voluchat" class="inline-block text-sm text-stone-600 hover:text-primary-700 hover:translate-x-1 transition-all duration-300 font-bold">Instagram</a></li>
          </ul>
        </div>
      </div>

      <!-- Bottom bar -->
      <div class="flex flex-col md:flex-row justify-between items-center gap-6 py-10 border-t border-stone-100">
        <div class="flex items-center gap-3 group/logo cursor-pointer">
          <img src="/voluchat_logo.svg" alt="VoluChat" class="w-8 h-8 transition-transform duration-500 group-hover/logo:rotate-12 group-hover/logo:scale-110" width="32" height="32" loading="lazy" decoding="async" />
          <span class="font-heading font-semibold text-xl text-stone-950 group-hover/logo:text-primary-700 transition-colors duration-300">VoluChat</span>
        </div>
        <p class="text-[11px] font-bold text-stone-400 uppercase tracking-widest leading-loose text-center">
          © {currentYear} QubitNine Technologies Private Limited. <br class="md:hidden" />
          Built for ecommerce stores that need faster product replies.
        </p>
        <div class="flex gap-3 items-center px-4 py-2 rounded-full border border-primary-100 bg-primary-50/70 backdrop-blur-md hover:scale-[1.03] transition-transform duration-300">
          <span class="h-2 w-2 rounded-full bg-primary-500 shadow-[0_0_8px_rgba(83,111,159,0.48)] animate-pulse"></span>
          <span class="text-[10px] font-semibold text-primary-800 uppercase tracking-widest">Demo calls open</span>
        </div>
      </div>
    </div>
  </div>
</footer>
