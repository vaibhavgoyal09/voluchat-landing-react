---
import CTA from "./CTA.astro";
const currentYear = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-slate-100 bg-white/40 backdrop-blur-3xl pt-24">
  <div class="max-w-7xl mx-auto px-6 relative z-10">

    <!-- CTA -->
    <CTA />

    <!-- Nav grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-12 py-20 border-t border-slate-100 mt-24">
      <div>
        <h3 class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-400 mb-6">Product</h3>
        <ul class="space-y-4">
          <li><a href="/features" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-bold">Features</a></li>
          <li><a href="/pricing" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-bold">Pricing</a></li>
          <li><a href="https://docs.voluchat.com" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-bold">Documentation</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-400 mb-6">Company</h3>
        <ul class="space-y-4">
          <li><a href="/about" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-bold">About Us</a></li>
          <li><a href="https://dashboard.voluchat.com" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-bold">Get Started</a></li>
          <li><a href="/contact" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-bold">Contact Support</a></li>
          <li><a href="/blog" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-bold">Our Blog</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-400 mb-6">Legal</h3>
        <ul class="space-y-4">
          <li><a href="/privacy" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-bold">Privacy Policy</a></li>
          <li><a href="/terms" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-bold">Terms of Service</a></li>
          <li><a href="#" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-bold">Security Standards</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-400 mb-6">Connect</h3>
        <ul class="space-y-4">
          <li><a href="https://twitter.com/voluchat" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-bold">Twitter / X</a></li>
          <li><a href="https://linkedin.com/company/voluchat" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-bold">LinkedIn</a></li>
          <li><a href="https://instagram.com/voluchat" class="text-sm text-slate-600 hover:text-indigo-600 transition-colors font-bold">Instagram</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-6 py-10 border-t border-slate-100">
      <div class="flex items-center gap-3">
        <img src="/voluchat_logo.svg" alt="VoluChat" class="w-8 h-8" />
        <span class="font-heading font-black text-xl text-slate-950 tracking-tighter">VoluChat</span>
      </div>
      <p class="text-[11px] font-bold text-slate-400 uppercase tracking-widest leading-loose text-center">
        © {currentYear} VoluChat Automation Private Limited. <br class="md:hidden" />
        Crafted with precision for the next generation of commerce.
      </p>
      <div class="flex gap-6 items-center">
        <div class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
        <span class="text-[10px] font-black text-emerald-700 uppercase tracking-widest">All Systems Operational</span>
      </div>
    </div>
  </div>
</footer>
