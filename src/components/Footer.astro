---
import CTA from "./CTA.astro";
const currentYear = new Date().getFullYear();
---

<footer class="bg-transparent border-t border-slate-200 pt-8 pb-8 relative overflow-hidden">
  <div class="absolute inset-0 bg-white/50 pointer-events-none -z-10"></div>
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <!-- CTA Component -->
    <CTA />

    <!-- Footer Navigation -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 pt-12 pb-12 border-t border-slate-100">
      <!-- Product -->
      <div>
        <h3 class="font-semibold text-slate-900 mb-4 font-heading uppercase tracking-widest text-xs">Product</h3>
        <ul class="space-y-3">
          <li><a href="#features" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">Features</a></li>
          <li><a href="#pricing" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">Pricing</a></li>
          <li><a href="#how-it-works" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">How It Works</a></li>
          <li><a href="#testimonials" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">Testimonials</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="font-semibold text-slate-900 mb-4 font-heading uppercase tracking-widest text-xs">Company</h3>
        <ul class="space-y-3">
          <li><a href="/about" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">About Us</a></li>
          <li><a href="https://dashboard.voluchat.com" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">Get Started</a></li>
          <li><a href="/contact" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">Contact</a></li>
          <li><a href="/blog" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">Blog</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="font-semibold text-slate-900 mb-4 font-heading uppercase tracking-widest text-xs">Legal</h3>
        <ul class="space-y-3">
          <li><a href="/privacy" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">Privacy Policy</a></li>
          <li><a href="/terms" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">Terms of Service</a></li>
          <li><a href="#" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">Cookie Policy</a></li>
          <li><a href="#" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">GDPR</a></li>
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h3 class="font-semibold text-slate-900 mb-4 font-heading uppercase tracking-widest text-xs">Support</h3>
        <ul class="space-y-3">
          <li><a href="/contact" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">Help Center</a></li>
          <li><a href="#faq" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">FAQ</a></li>
          <li><a href="mailto:support@voluchat.com" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">Email Support</a></li>
          <li><a href="https://docs.voluchat.com" class="text-slate-600 hover:text-blue-600 transition-colors text-sm font-medium">Documentation</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-6 pt-8 border-t border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8">
          <img src="/voluchat_logo.svg" alt="VoluChat" class="w-full h-full" />
        </div>
        <span class="font-heading font-bold text-xl text-slate-900">
          VoluChat
        </span>
      </div>

      <div class="text-sm text-slate-500 font-medium text-center">
        © {currentYear} VoluChat. All rights reserved. Made for growth.
      </div>

      <div class="flex gap-6">
        <a href="https://twitter.com/voluchat" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-blue-600 transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" /></svg>
        </a>
        <a href="https://linkedin.com/company/voluchat" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-blue-600 transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" /></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
