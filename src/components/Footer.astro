---
const currentYear = new Date().getFullYear();
const isHome = Astro.url.pathname === "/";
const homeHref = (hash) => (isHome ? hash : `/${hash}`);

const footerSections = [
  {
    title: "Product",
    links: [
      { label: "Comment-to-DM Engine", href: homeHref("#how-it-works") },
      { label: "WhatsApp Sales Closer", href: homeHref("#how-it-works") },
      { label: "90-Second Revenue Loop", href: homeHref("#revenue-loop") },
      { label: "Guardrails & Safety", href: homeHref("#guardrails") },
    ],
  },
  {
    title: "Pilot Cohort",
    links: [
      { label: "Apply for Pilot (10 Stores)", href: "/contact" },
      { label: "White-Glove Setup Scope", href: "/contact" },
      { label: "Founder Desk Support", href: "mailto:support@voluchat.com" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About VoluChat", href: "/about" },
      { label: "Founder Story", href: "/about" },
      { label: "Blog", href: "/blog" },
      { label: "Contact Us", href: "/contact" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Security & Guardrails", href: "/security" },
      { label: "Privacy Policy", href: "/privacy" },
      { label: "Terms & Conditions", href: "/terms" },
    ],
  },
];
---

<footer
  class="relative overflow-hidden border-t border-[rgba(148,163,184,0.16)] bg-[#060d18] py-16"
>
  <div class="page-shell relative z-10">
    <section
      id="demo"
      class="mb-8 rounded-[1.75rem] border border-emerald-500/25 bg-[radial-gradient(circle_at_50%_0%,rgba(16,185,129,0.15),transparent_48%),rgba(10,21,35,0.95)] p-6 text-center shadow-[0_32px_90px_-56px_rgba(16,185,129,0.4)] sm:p-10"
    >
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-bold text-emerald-300 mb-4">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Limited Pilot Cohort &bull; 10 Brands
      </div>
      <h2
        class="mx-auto max-w-2xl text-3xl font-heading font-bold leading-tight text-white sm:text-5xl"
      >
        Turn your Instagram DMs & WhatsApp into 24/7 revenue.
      </h2>
      <p
        class="mx-auto mt-5 max-w-2xl text-base font-medium leading-relaxed text-slate-200 sm:text-lg"
      >
        We build, configure, and manage your autonomous sales agent end-to-end with 100% white-glove setup.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3.5 sm:flex-row">
        <a href="/contact" class="btn-primary btn-sheen">Apply for Pilot Store Deployment &rarr;</a>
        <a href="#how-it-works" class="btn-secondary">See How It Works</a>
      </div>
    </section>

    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.2fr_repeat(4,1fr)]">
      <!-- Brand column -->
      <div class="flex flex-col gap-4">
        <a
          href="/"
          class="flex items-center gap-2.5 rounded-xl pr-2 transition hover:opacity-85"
          aria-label="VoluChat home"
        >
          <img
            src="/voluchat_logo.svg"
            alt="VoluChat Logo"
            class="h-8 w-8 object-contain"
          />
          <span class="font-heading text-xl font-bold text-white">VoluChat</span
          >
        </a>
        <p
          class="text-xs text-slate-300 font-medium leading-relaxed max-w-[24ch]"
        >
          Autonomous WhatsApp & Instagram sales agents for modern D2C brands.
        </p>
      </div>

      {
        footerSections.map((section) => (
          <div>
            <h3 class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-300">
              {section.title}
            </h3>
            <ul class="mt-4 space-y-2">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-xs text-slate-200 font-semibold hover:text-white transition"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-16 pt-8 border-t border-[rgba(148,163,184,0.1)] flex flex-col items-center justify-between gap-6 sm:flex-row"
    >
      <p
        class="text-[11px] font-bold text-slate-300 uppercase tracking-widest text-center sm:text-left leading-relaxed"
      >
        © {currentYear} QubitNine Technologies Pvt Ltd. All rights reserved. <br
        />
        Autonomous social commerce agent platform.
      </p>

      <div
        class="flex gap-2.5 items-center px-4 py-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 backdrop-blur-md"
      >
        <span
          class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)] animate-pulse"
        ></span>
        <span
          class="text-[9px] font-bold text-emerald-400 uppercase tracking-widest"
          >Agent Engine Active</span
        >
      </div>
    </div>
  </div>
</footer>
