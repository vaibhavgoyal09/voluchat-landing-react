---
const assurances = [
  "10 mins setup",
  "No coding required",
  "Cancel Anytime",
];
---

<section id="hero-assurances" class="relative z-10 -mt-5 pb-8 sm:pb-10" aria-label="Setup assurances">
  <div class="page-shell">
    <div class="rounded-[1.35rem] border border-white/80 bg-white/72 p-2 shadow-[0_18px_54px_rgba(28,25,23,0.07)] backdrop-blur-xl">
      <div class="grid gap-2 sm:grid-cols-3">
        {assurances.map((item) => (
          <div class="grid grid-cols-[1.25rem_minmax(8.5rem,8.5rem)] items-center justify-center gap-2.5 rounded-2xl bg-stone-50/82 px-4 py-3 text-left ring-1 ring-stone-200/70 sm:flex sm:text-center sm:py-3.5">
            <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-primary-900 text-white shadow-[0_8px_20px_rgba(29,43,67,0.18)]">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m5 12 4 4 10-10" />
              </svg>
            </span>
            <span class="font-heading text-sm font-semibold leading-tight text-stone-950 sm:text-base">
              {item}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
