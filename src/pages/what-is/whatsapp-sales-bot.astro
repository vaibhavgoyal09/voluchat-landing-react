---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import { getFaqSchema } from "../../lib/faqSchema.mjs";

const seoTitle = "What is a WhatsApp Sales Bot? | E-Commerce Guide";
const seoDescription =
  "What is a WhatsApp sales bot? Learn how AI sales agents qualify buyers, handle sizing, recommend upsells, and close orders in WhatsApp chats.";
const seoKeywords =
  "WhatsApp sales bot, WhatsApp e-commerce automation, cart recovery WhatsApp, upsell cross-sell chatbot, Instagram DM sales bot";
const siteUrl = "https://www.voluchat.com";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: seoTitle,
    description: seoDescription,
    url: `${siteUrl}/what-is/whatsapp-sales-bot`,
  },
  {
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    name: "WhatsApp Sales Bot",
    description:
      "An AI-powered conversational agent operating inside WhatsApp that qualifies buyers from Instagram and other channels, answers product questions with live Shopify inventory data, handles objections, and completes orders via UPI or draft orders — all without human intervention.",
    url: `${siteUrl}/what-is/whatsapp-sales-bot`,
  },
];

const types = [
  {
    type: "Flowchart Bots",
    example: "Wati, Interakt",
    description: "Rigid 'Press 1 for tracking, Press 2 for sizing' menus. Work for simple FAQ automation and broadcast messages but drop off 70%+ of buyers who have conversational questions.",
    fit: "Basic order tracking, broadcast promotions, simple FAQ responses.",
  },
  {
    type: "Keyword Auto-Responders",
    example: "Manychat, basic chat widgets",
    description: "Trigger on exact keyword matches ('price', 'size') and send static messages or external links. Cannot check live inventory or handle nuanced conversations.",
    fit: "Coupon distribution, lead capture, simple keyword-triggered replies.",
  },
  {
    type: "E-Commerce Automation Agents",
    example: "VoluChat",
    description: "Generative AI that understands natural language, recommends products with upsells and cross-sells, recovers abandoned carts, enforces margin guardrails, and completes native UPI checkout — all inside WhatsApp.",
    fit: "End-to-end e-commerce automation: qualification, product recommendations, upsells, cross-sells, cart recovery, and in-chat payment.",
  },
];

const howItWorks = [
  {
    step: "1",
    title: "Buyer arrives from Instagram or Meta Ads",
    detail:
      "A shopper comments on your Reel or ad, triggering a comment-to-DM sequence. Within 2 seconds, they receive a personalized DM with exact pricing and stock info for the specific product.",
  },
  {
    step: "2",
    title: "AI qualifies and answers product questions",
    detail:
      "The buyer asks about sizing, fabric, delivery time, or COD availability. The AI reads your live Shopify catalog to answer accurately — no hallucinations, no guessing.",
  },
  {
    step: "3",
    title: "Objections handled, margin protected",
    detail:
      "The buyer hesitates. The AI offers a pre-approved prepaid discount (5–10% off for UPI), checks delivery feasibility for their pincode, and addresses concerns — all within your strict margin ceilings.",
  },
  {
    step: "4",
    title: "Order completed in-chat",
    detail:
      "A 1-click UPI link or Shopify draft order is generated directly in WhatsApp. The buyer pays, receives confirmation, and the order is synced to your Shopify admin with tracking.",
  },
];

const pageFaqs = [
  {
    question: "What is a WhatsApp sales bot?",
    answer:
      "A WhatsApp sales bot is an e-commerce automation agent that operates inside WhatsApp to qualify buyers, recommend products with upsells and cross-sells, recover abandoned carts, and complete orders via UPI or draft orders. Unlike basic flowchart bots, e-commerce automation agents understand natural language and can execute the full commerce loop — from qualification to checkout — without human intervention.",
  },
  {
    question: "How is a WhatsApp sales bot different from a WhatsApp chatbot?",
    answer:
      "A WhatsApp chatbot typically handles FAQ responses and order tracking through rigid button menus. A WhatsApp sales bot goes further — it qualifies buyers, recommends upsells and cross-sells, recovers abandoned carts, enforces margin guardrails, and completes native checkout inside the chat. The key difference is driving revenue, not just answering questions.",
  },
  {
    question: "Can a WhatsApp sales bot check real-time inventory?",
    answer:
      "Yes, advanced WhatsApp sales bots like VoluChat connect directly to your product catalog via webhooks and GraphQL to read live variant stock levels. This means the bot never confirms availability for out-of-stock items and can suggest alternatives when a specific size or color is unavailable.",
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/what-is/whatsapp-sales-bot", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema(pageFaqs)]}
>
  <Header />

  <main class="pt-20">
    <section class="relative overflow-hidden pt-20 pb-16 sm:pt-24 lg:pb-20">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_14%,rgba(16,185,129,0.15),transparent_34%),linear-gradient(180deg,rgba(8,17,31,0.96),rgba(6,13,24,0.96))]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="whatis-hero-text mx-auto max-w-4xl text-center">
          <div class="chip mb-4">
            <span class="mini-label">Definition</span>
          </div>
          <h1
            class="text-4xl font-semibold leading-[1.04] text-white sm:text-6xl lg:text-7xl font-heading"
          >
            What is a WhatsApp Sales Bot?
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl text-slate-300">
            A WhatsApp sales bot is an e-commerce automation agent that qualifies buyers, recommends products with upsells and cross-sells, recovers abandoned carts, and completes orders directly inside WhatsApp — without human intervention.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl">
          <p class="section-eyebrow text-emerald-400 mb-4">Types of WhatsApp bots</p>
          <h2 class="text-3xl font-heading font-semibold text-white mb-8">
            Not all WhatsApp bots are equal
          </h2>
          <div class="space-y-4">
            {
              types.map((item) => (
                <article class="whatis-type solid-card p-6 md:p-8">
                  <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                    <div class="max-w-xl">
                      <h3 class="text-xl font-heading font-semibold text-white">
                        {item.type}
                      </h3>
                      <p class="mt-1 text-sm text-slate-500">e.g. {item.example}</p>
                      <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                        {item.description}
                      </p>
                    </div>
                    <div class="md:text-right">
                      <p class="mini-label text-slate-400">Best for</p>
                      <p class="mt-1 text-sm font-medium text-slate-300">
                        {item.fit}
                      </p>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl">
          <p class="section-eyebrow text-emerald-400 mb-4">How it works</p>
          <h2 class="text-3xl font-heading font-semibold text-white mb-8">
            The 4-step AI sales flow
          </h2>
          <div class="space-y-4">
            {
              howItWorks.map((item) => (
                <article class="whatis-step solid-card p-6 md:p-8">
                  <div class="flex items-start gap-5">
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-emerald-500/20 border border-emerald-500/30 font-mono text-sm font-bold text-emerald-300">
                      {item.step}
                    </span>
                    <div>
                      <h3 class="text-xl font-heading font-semibold text-white">
                        {item.title}
                      </h3>
                      <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                        {item.detail}
                      </p>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl text-center">
          <p class="section-eyebrow text-emerald-400 mb-4">See it in action</p>
          <h2 class="text-3xl font-heading font-semibold text-white mb-4">
            Ready to deploy e-commerce automation on WhatsApp?
          </h2>
          <p class="section-copy mx-auto mb-8 max-w-2xl text-slate-300">
            VoluChat is a WhatsApp e-commerce automation agent that goes beyond chatbots — it qualifies buyers, recommends upsells and cross-sells, recovers abandoned carts, and closes orders with native UPI checkout in 90 seconds.
          </p>
          <div class="flex flex-col justify-center gap-3.5 sm:flex-row">
            <a href="/contact" class="btn-primary">Apply for 1 of 10 Pilot Spots &rarr;</a>
            <a href="/compare" class="btn-secondary">Compare vs Wati / Manychat</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    gsap.fromTo(".whatis-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    gsap.utils.toArray<HTMLElement>(".whatis-type, .whatis-step").forEach((card, i) => {
      gsap.fromTo(card,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          delay: i * 0.08,
          ease: "power2.out",
          scrollTrigger: {
            trigger: card,
            start: "top 85%",
            toggleActions: "play none none reverse",
          },
        }
      );
    });
  });
</script>
