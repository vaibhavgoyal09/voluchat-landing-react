---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import { getFaqSchema } from "../../lib/faqSchema.mjs";

const seoTitle = "What is a WhatsApp Sales Bot? | AI-Powered Social Commerce Explained";
const seoDescription =
  "A WhatsApp sales bot is an AI agent that qualifies buyers, answers product questions, checks live inventory, handles objections, and completes orders directly inside WhatsApp — without human intervention.";
const seoKeywords =
  "WhatsApp sales bot, WhatsApp AI bot for ecommerce, WhatsApp sales automation, Shopify WhatsApp bot, Instagram DM sales bot";
const siteUrl = "https://www.voluchat.com";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: seoTitle,
    description: seoDescription,
    url: `${siteUrl}/what-is/whatsapp-sales-bot`,
  },
  {
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    name: "WhatsApp Sales Bot",
    description:
      "An AI-powered conversational agent operating inside WhatsApp that qualifies buyers from Instagram and other channels, answers product questions with live Shopify inventory data, handles objections, and completes orders via UPI or draft orders — all without human intervention.",
    url: `${siteUrl}/what-is/whatsapp-sales-bot`,
  },
];

const types = [
  {
    type: "Flowchart Bots",
    example: "Wati, Interakt",
    description: "Rigid 'Press 1 for tracking, Press 2 for sizing' menus. Work for simple FAQ automation and broadcast messages but drop off 70%+ of buyers who have conversational questions.",
    fit: "Basic order tracking, broadcast promotions, simple FAQ responses.",
  },
  {
    type: "Keyword Auto-Responders",
    example: "Manychat, basic chat widgets",
    description: "Trigger on exact keyword matches ('price', 'size') and send static messages or external links. Cannot check live inventory or handle nuanced conversations.",
    fit: "Coupon distribution, lead capture, simple keyword-triggered replies.",
  },
  {
    type: "AI Sales Agents",
    example: "VoluChat",
    description: "Generative AI that understands natural language, reads live Shopify inventory, checks delivery pincodes, handles objections, enforces margin guardrails, and completes native UPI checkout — all inside WhatsApp.",
    fit: "End-to-end social commerce: qualification, sizing, stock checks, objection handling, and in-chat payment.",
  },
];

const howItWorks = [
  {
    step: "1",
    title: "Buyer arrives from Instagram or Meta Ads",
    detail:
      "A shopper comments on your Reel or ad, triggering a comment-to-DM sequence. Within 2 seconds, they receive a personalized DM with exact pricing and stock info for the specific product.",
  },
  {
    step: "2",
    title: "AI qualifies and answers product questions",
    detail:
      "The buyer asks about sizing, fabric, delivery time, or COD availability. The AI reads your live Shopify catalog to answer accurately — no hallucinations, no guessing.",
  },
  {
    step: "3",
    title: "Objections handled, margin protected",
    detail:
      "The buyer hesitates. The AI offers a pre-approved prepaid discount (5–10% off for UPI), checks delivery feasibility for their pincode, and addresses concerns — all within your strict margin ceilings.",
  },
  {
    step: "4",
    title: "Order completed in-chat",
    detail:
      "A 1-click UPI link or Shopify draft order is generated directly in WhatsApp. The buyer pays, receives confirmation, and the order is synced to your Shopify admin with tracking.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is a WhatsApp sales bot?",
      answerCount: 1,
      acceptedAnswer: {
        "@type": "Answer",
        text: "A WhatsApp sales bot is an AI-powered conversational agent that operates inside WhatsApp to qualify buyers, answer product questions with live inventory data, handle objections, and complete orders via UPI or draft orders. Unlike basic flowchart bots, AI sales agents understand natural language and can execute the full commerce loop without human intervention.",
      },
    },
    {
      "@type": "Question",
      name: "How is a WhatsApp sales bot different from a WhatsApp chatbot?",
      answerCount: 1,
      acceptedAnswer: {
        "@type": "Answer",
        text: "A WhatsApp chatbot typically handles FAQ responses and order tracking through rigid button menus. A WhatsApp sales bot goes further — it qualifies buyers, checks live Shopify inventory, handles pricing objections, enforces margin guardrails, and completes native checkout inside the chat. The key difference is closing sales, not just answering questions.",
      },
    },
    {
      "@type": "Question",
      name: "Can a WhatsApp sales bot check real-time inventory?",
      answerCount: 1,
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, advanced WhatsApp sales bots like VoluChat connect directly to your Shopify catalog via webhooks and GraphQL to read live variant stock levels. This means the bot never confirms availability for out-of-stock items and can suggest alternatives when a specific size or color is unavailable.",
      },
    },
  ],
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/what-is/whatsapp-sales-bot", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema(), faqSchema]}
>
  <Header />

  <main class="pt-20">
    <section class="relative overflow-hidden pt-20 pb-16 sm:pt-24 lg:pb-20">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_14%,rgba(16,185,129,0.15),transparent_34%),linear-gradient(180deg,rgba(8,17,31,0.96),rgba(6,13,24,0.96))]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="whatis-hero-text opacity-0 mx-auto max-w-4xl text-center">
          <div class="chip mb-4">
            <span class="mini-label">Definition</span>
          </div>
          <h1
            class="text-4xl font-semibold leading-[1.04] text-white sm:text-6xl lg:text-7xl font-heading"
          >
            What is a WhatsApp Sales Bot?
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl text-slate-300">
            A WhatsApp sales bot is an AI-powered conversational agent that qualifies buyers, answers product questions with live inventory data, handles objections, and completes orders directly inside WhatsApp — without human intervention.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl">
          <p class="section-eyebrow text-emerald-400 mb-4">Types of WhatsApp bots</p>
          <h2 class="text-3xl font-heading font-semibold text-white mb-8">
            Not all WhatsApp bots are equal
          </h2>
          <div class="space-y-4">
            {
              types.map((item) => (
                <article class="whatis-type opacity-0 solid-card p-6 md:p-8">
                  <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                    <div class="max-w-xl">
                      <h3 class="text-xl font-heading font-semibold text-white">
                        {item.type}
                      </h3>
                      <p class="mt-1 text-sm text-slate-500">e.g. {item.example}</p>
                      <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                        {item.description}
                      </p>
                    </div>
                    <div class="md:text-right">
                      <p class="mini-label text-slate-400">Best for</p>
                      <p class="mt-1 text-sm font-medium text-slate-300">
                        {item.fit}
                      </p>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl">
          <p class="section-eyebrow text-emerald-400 mb-4">How it works</p>
          <h2 class="text-3xl font-heading font-semibold text-white mb-8">
            The 4-step AI sales flow
          </h2>
          <div class="space-y-4">
            {
              howItWorks.map((item) => (
                <article class="whatis-step opacity-0 solid-card p-6 md:p-8">
                  <div class="flex items-start gap-5">
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-emerald-500/20 border border-emerald-500/30 font-mono text-sm font-bold text-emerald-300">
                      {item.step}
                    </span>
                    <div>
                      <h3 class="text-xl font-heading font-semibold text-white">
                        {item.title}
                      </h3>
                      <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                        {item.detail}
                      </p>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl text-center">
          <p class="section-eyebrow text-emerald-400 mb-4">See it in action</p>
          <h2 class="text-3xl font-heading font-semibold text-white mb-4">
            Ready to deploy an AI sales agent on WhatsApp?
          </h2>
          <p class="section-copy mx-auto mb-8 max-w-2xl text-slate-300">
            VoluChat is a WhatsApp sales bot that goes beyond chatbots — it qualifies buyers, checks live Shopify stock, handles objections, and closes orders with native UPI checkout in 90 seconds.
          </p>
          <div class="flex flex-col justify-center gap-3.5 sm:flex-row">
            <a href="/contact" class="btn-primary">Apply for 1 of 10 Pilot Spots &rarr;</a>
            <a href="/compare" class="btn-secondary">Compare vs Wati / Manychat</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    gsap.fromTo(".whatis-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    gsap.utils.toArray<HTMLElement>(".whatis-type, .whatis-step").forEach((card, i) => {
      gsap.fromTo(card,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          delay: i * 0.08,
          ease: "power2.out",
          scrollTrigger: {
            trigger: card,
            start: "top 85%",
            toggleActions: "play none none reverse",
          },
        }
      );
    });
  });
</script>
