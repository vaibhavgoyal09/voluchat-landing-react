---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FAQ from "../../components/FAQ.astro";
import { getFaqSchema } from "../../lib/faqSchema.mjs";

const seoTitle = "What-is Guides — DM Automation Explained | VoluChat";
const seoDescription =
  "Plain-English guides to comment-to-DM automation, WhatsApp sales bots, in-chat UPI checkout and cart recovery for fashion boutiques.";
const seoKeywords =
  "comment to DM automation guide, WhatsApp sales bot guide, in-chat UPI checkout, WhatsApp cart recovery, Instagram DM automation explained";
const siteUrl = "https://www.voluchat.com";

const guides = [
  {
    href: "/what-is/comment-to-DM-automation",
    tag: "Capture",
    title: "What is Comment-to-DM Automation?",
    text: "How 'Price?' comments on Reels become priced, in-stock DMs in 2 seconds.",
  },
  {
    href: "/what-is/whatsapp-sales-bot",
    tag: "Qualify",
    title: "What is a WhatsApp Sales Bot?",
    text: "Flowchart bots vs keyword responders vs e-commerce automation agents.",
  },
  {
    href: "/what-is/in-chat-upi-checkout",
    tag: "Close",
    title: "What is In-Chat UPI Checkout?",
    text: "GPay, PhonePe and Paytm payments completed inside WhatsApp — no website drop-off.",
  },
  {
    href: "/what-is/whatsapp-cart-recovery",
    tag: "Recover",
    title: "What is WhatsApp Cart Recovery?",
    text: "Recover 35%+ of abandoned checkouts with fit reassurance and 1-click UPI links.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: seoTitle,
    description: seoDescription,
    url: `${siteUrl}/what-is`,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: guides.map((g, i) => ({
      "@type": "SiteNavigationElement",
      position: i + 1,
      name: g.title,
      url: `${siteUrl}${g.href}`,
    })),
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/what-is", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema()]}
>
  <Navbar />

  <main class="overflow-hidden">
    <section class="hero-stripe">
      <div class="section-glow-emerald"></div>
      <div class="sect-grid opacity-20"></div>
      <div class="page-shell">
        <div class="mx-auto max-w-3xl text-center">
          <Breadcrumbs items={[{ label: "Learn", href: "/learn" }, { label: "What-is" }]} />
          <div class="chip mb-4">
            <span class="mini-label text-emerald-600">Definitions</span>
          </div>
          <h1 class="mt-6 text-4xl font-semibold leading-[1.04] text-slate-900 sm:text-6xl font-heading">
            E-commerce automation, defined.
          </h1>
          <p class="section-copy mx-auto mt-5 max-w-2xl">
            Four short guides boutique founders actually finish — each with a
            4-step flow, comparison table and FAQPage schema for LLM citation.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-24 bg-white">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl">
          <p class="section-eyebrow mb-4">All guides</p>
          <div class="grid gap-4 md:grid-cols-2">
            {guides.map((g) => (
              <a href={g.href} class="solid-card group p-6 md:p-8 transition-all">
                <span class="mini-label text-slate-500">{g.tag}</span>
                <h2 class="mt-3 text-xl font-heading font-semibold text-slate-900 transition-colors group-hover:text-emerald-600">
                  {g.title}
                </h2>
                <p class="mt-2 text-sm sm:text-base font-normal leading-relaxed text-slate-600">
                  {g.text}
                </p>
                <p class="mt-4 text-sm font-semibold text-slate-900">Read guide →</p>
              </a>
            ))}
          </div>
          <div class="solid-card mx-auto mt-8 max-w-4xl p-6 text-center sm:p-8">
            <p class="text-sm font-normal leading-relaxed text-slate-600">
              Need terms, not guides? Browse the <a href="/glossary" class="text-emerald-700 underline underline-offset-4">20-term Glossary</a>
              or quantify your leak with the <a href="/comment-revenue-leak-calculator" class="text-emerald-700 underline underline-offset-4">free revenue calculator</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <FAQ />
  </main>

  <Footer />
</Layout>
