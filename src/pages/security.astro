---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const siteUrl = "https://www.voluchat.com";
const seoTitle = "Security & Brand Guardrails | VoluChat AI Sales";
const seoDescription =
  "How VoluChat protects your brand: official Meta APIs, margin floors, zero out-of-stock selling, and instant human escalation on WhatsApp.";
const seoKeywords =
  "WhatsApp API security, Meta Cloud API compliance, ecommerce AI guardrails, brand safe AI sales, DM automation security";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/security`,
};

const metaCompliance = [
  {
    title: "Official Meta Cloud APIs Only (Zero Ban Risk)",
    description: "VoluChat connects exclusively through Meta's official WhatsApp Business Cloud API and Instagram Graph API. No unofficial scrapers, browser extensions, or grey-market tools. Your account stays 100% safe and fully compliant with Meta's terms of service.",
  },
  {
    title: "WhatsApp App Coexistence Support",
    description: "Fully compatible with WhatsApp's official Coexistence feature. Your team can continue using the standard WhatsApp Business phone app simultaneously without any disruption to manual replies or phone access.",
  },
  {
    title: "Scoped API Permissions",
    description: "We request only the minimum API permissions needed for your enabled workflows. If you only use WhatsApp sales, we don't request Instagram access. If you only use comment-to-DM, we don't request message read access beyond new comments.",
  },
  {
    title: "Token Security",
    description: "Access tokens are stored encrypted at rest, never logged in plaintext, and rotated on a regular schedule. Compromised tokens are revoked immediately via Meta's token invalidation API.",
  },
];

const dataFlow = [
  {
    title: "What VoluChat reads from your store",
    items: [
      "Product catalog: titles, descriptions, variants, pricing, SKUs, images",
      "Inventory levels: real-time stock counts per variant across all locations",
      "Order data: order status, tracking numbers, fulfillment state",
      "Shipping policies: delivery zones, COD availability, return windows",
      "Discount rules: active promotions, coupon codes, margin floors",
    ],
  },
  {
    title: "What VoluChat writes to your store",
    items: [
      "Draft orders: pre-populated with customer details, selected variant, and pricing",
      "Payment links: Razorpay or Cashfree UPI links embedded in draft orders",
      "Order notes: internal notes marking AI-generated vs human-assisted orders",
    ],
  },
  {
    title: "What VoluChat never touches",
    items: [
      "Product pricing or inventory levels (read-only, never modified by AI)",
      "Fulfillment or shipping operations (your team handles this)",
      "Refund or return processing (escalated to human, never auto-processed)",
      "Customer payment credentials (handled entirely by Razorpay/Cashfree)",
    ],
  },
];

const guardrails = [
  {
    title: "Strict Margin Floors & Ceilings",
    description: "The AI is cryptographically restricted from offering discounts below your configured minimum margin or above your maximum discount threshold. Every discount request is checked against your rules before being shown to the buyer.",
    details: ["Configurable per-product or per-category margin floors", "Maximum discount percentage enforced in real-time", "Bundle and combo offers checked against combined margin rules", "Audit trail of every discount offer made by the AI"],
  },
  {
    title: "Zero Out-of-Stock Selling",
    description: "VoluChat reads live Shopify variant inventory before every stock confirmation. If a variant has 0 units, the AI never confirms availability — it suggests alternatives or waits for restock.",
    details: ["Real-time variant stock checks via Shopify GraphQL API", "Multi-location inventory awareness (central warehouse + stores)", "Low-stock warnings trigger 'selling fast' urgency without false promises", "Back-in-stock alerts offered when variants are unavailable"],
  },
  {
    title: "1-Click Human Escalation",
    description: "Certain situations automatically trigger a handoff to your human team. The AI detects these signals and alerts your sales rep on WhatsApp within seconds.",
    details: ["Custom orders: bridal, bulk, or non-standard requests", "VIP customers: high LTV or repeat buyers flagged in Shopify", "Negative sentiment: frustration, anger, or complaint keywords", "Refund/return requests: never handled by AI, always escalated", "Ambiguous sizing: when AI confidence on size recommendation is low"],
  },
  {
    title: "Brand Voice Calibration",
    description: "Before going live, we train the AI on your brand's tone, vocabulary, and communication style. Every customer interaction matches your brand identity — not generic chatbot language.",
    details: ["Tone mapping: casual, formal, luxury, playful — matched to your brand", "Vocabulary training: your product names, abbreviations, and terminology", "Response templates: your preferred greeting, sign-off, and escalation phrases", "Competitor handling: how your brand discusses alternatives (or doesn't)"],
  },
];

const codGuardrails = [
  {
    title: "OTP Verification for COD Orders",
    description: "Cash-on-Delivery orders above a configurable threshold require WhatsApp button confirmation or OTP verification before the order is placed — reducing fake orders and RTO rates.",
  },
  {
    title: "Prepayment Incentives",
    description: "The AI can offer small discounts (within your margin rules) for UPI prepayment instead of COD, reducing your return-to-origin costs while giving the buyer a reason to pay upfront.",
  },
  {
    title: "Address Validation",
    description: "Before confirming a COD order, the AI validates the delivery pincode against your shipping zones and confirms the estimated delivery timeline — preventing orders to areas you don't serve.",
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/security", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="overflow-hidden">
    <section class="hero-stripe text-left">
      <div class="section-glow-emerald"></div>
      <div class="sect-grid opacity-20"></div>

      <div class="page-shell">
        <div class="sec-hero-text mx-auto max-w-4xl">
          <div class="chip mb-5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 mr-1.5"></span>
            Enterprise-Grade Brand Safety
          </div>
          <h1
            class="max-w-3xl text-4xl font-semibold leading-[1.02] text-[#fcfdff] sm:text-6xl lg:text-7xl font-heading"
          >
            Total control over every conversation and checkout.
          </h1>
          <p class="section-copy mt-6 max-w-2xl">
            We treat your brand reputation as sacred. VoluChat wraps every AI response in strict margin limits, verified stock checks, catalog isolation, and instant human fallback — so your brand never says the wrong thing.
          </p>
          <p class="mt-4 max-w-xl text-sm font-normal leading-relaxed text-slate-500">
            <strong class="text-slate-400">What does this mean?</strong> Your e-commerce automation agent can only say what your catalog says, can only discount within your configured margins, and hands off to a human the moment something is ambiguous.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-24 bg-[#000000]">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl">
          <h2 class="section-eyebrow mb-6">Meta API compliance</h2>
          <div class="grid gap-4 sm:grid-cols-3">
            {metaCompliance.map((item) => (
              <article class="sec-card opacity-0 solid-card p-5 md:p-6">
                <h3 class="text-base font-heading font-semibold text-[#fcfdff]">{item.title}</h3>
                <p class="mt-2 text-sm font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24 bg-[#000000]">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl">
          <h2 class="section-eyebrow mb-6">Data flow architecture</h2>
          <div class="grid gap-4 sm:grid-cols-3">
            {dataFlow.map((group) => (
              <article class="sec-card opacity-0 solid-card p-5 md:p-6">
                <h3 class="text-base font-heading font-semibold text-[#fcfdff] mb-3">{group.title}</h3>
                <ul class="space-y-2">
                  {group.items.map((item) => (
                    <li class="flex gap-2.5 text-sm font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24 bg-[#000000]">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl">
          <h2 class="section-eyebrow mb-6">Brand safety guardrails</h2>
          <div class="space-y-4">
            {guardrails.map((item) => (
              <article class="sec-guardrail opacity-0 solid-card p-6 md:p-8">
                <div class="grid gap-6 lg:grid-cols-[1fr_1.2fr] lg:items-start">
                  <div>
                    <h3 class="text-lg font-heading font-semibold text-[#fcfdff]">{item.title}</h3>
                    <p class="mt-2 text-sm font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">{item.description}</p>
                  </div>
                  <ul class="space-y-2.5">
                    {item.details.map((d) => (
                      <li class="flex gap-2.5 text-sm font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">
                        <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[#101012] border border-white/[0.14] font-mono text-[10px] font-bold text-emerald-300">
                          ✓
                        </span>
                        <span>{d}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24 bg-[#000000]">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl">
          <h2 class="section-eyebrow mb-6">COD order guardrails</h2>
          <div class="grid gap-4 sm:grid-cols-3">
            {codGuardrails.map((item) => (
              <article class="sec-card opacity-0 solid-card p-5 md:p-6">
                <h3 class="text-base font-heading font-semibold text-[#fcfdff]">{item.title}</h3>
                <p class="mt-2 text-sm font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24 bg-[#000000]">
      <div class="page-shell text-center">
        <h2 class="section-title text-[#fcfdff]">Ready to deploy with full brand control?</h2>
        <p class="section-copy mx-auto mt-4 max-w-2xl">
          Get 30 days free with 100% done-for-you setup. We configure every guardrail, test every edge case, and tune the AI on your brand voice before going live.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3.5 sm:flex-row">
          <a href="/free-trial" class="btn-primary">Start 30-Day Free Trial &rarr;</a>
          <a
            href="https://wa.me/918847568693?text=Hi%20Vaibhav%2C%20I'd%20like%20to%20know%20about%20VoluChat%20security%20guardrails."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            Chat on WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    gsap.fromTo(".sec-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    gsap.utils.toArray<HTMLElement>(".sec-card, .sec-guardrail").forEach((el) => {
      gsap.fromTo(el,
        { opacity: 0, y: 20 },
        {
          opacity: 1,
          y: 0,
          duration: 0.4,
          ease: "power2.out",
          scrollTrigger: {
            trigger: el,
            start: "top 90%",
            toggleActions: "play none none reverse",
          },
        }
      );
    });
  });
</script>
