---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Security & Guardrails | VoluChat Social Commerce Agents",
  description: "Learn how VoluChat protects your store with official Meta & WhatsApp Business Cloud APIs, strict discount floors, live inventory validation, and 1-click human escalation.",
  url: siteUrl,
};

const safeguards = [
  {
    title: "Official Meta & WhatsApp APIs",
    text: "Zero shady unofficial scrapers or browser extensions. Connected directly via official Meta Cloud APIs for 100% account safety and zero ban risk.",
  },
  {
    title: "Strict Margin Floors",
    text: "The AI agent is cryptographically restricted from offering unauthorized discounts or trading away margins to chase a conversion.",
  },
  {
    title: "Real-time Catalog Isolation",
    text: "Read-only inventory sync ensures the AI agent only sells verified, in-stock variant SKUs with accurate delivery SLAs.",
  },
  {
    title: "1-Click Human Escalation",
    text: "Custom bridal orders, VIP clients, or negative sentiment triggers instantly alert your team on WhatsApp for a seamless takeover.",
  },
];
---

<Layout
  title="Security & Brand Guardrails | VoluChat"
  description="Learn how VoluChat protects your store with official Meta & WhatsApp Business Cloud APIs, strict discount floors, live inventory validation, and 1-click human escalation."
  keywords="WhatsApp API security, Meta Cloud API, ecommerce AI guardrails, brand safe AI sales closer"
  canonical={new URL("/security", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="relative overflow-hidden pt-36 pb-24 sm:pt-40">
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_18%,rgba(16,185,129,0.12),transparent_30%),radial-gradient(circle_at_82%_20%,rgba(15,23,42,0.6),transparent_30%)]"
    >
    </div>
    <div class="ambient-noise"></div>

    <div class="page-shell px-6">
      <div class="sec-hero-text opacity-0 mx-auto mb-14 max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/25 bg-emerald-950/40 px-3.5 py-1 text-xs font-bold text-emerald-300 mb-5">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          Enterprise-Grade Brand Safety
        </div>
        <h1
          class="text-4xl font-semibold leading-[1.03] text-white md:text-6xl font-heading"
        >
          Total control over every conversation and checkout.
        </h1>
        <p class="section-copy mx-auto mt-6 max-w-2xl text-slate-300">
          We treat your brand reputation as sacred. VoluChat wraps every conversational response in strict margin limits, verified stock checks, and instant human fallback.
        </p>
      </div>

      <div class="sec-main-card opacity-0 solid-card mb-10 p-6 md:p-10 border-emerald-500/20 bg-[#09131f]">
        <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-center">
          <div class="rounded-2xl bg-gradient-to-br from-emerald-950/80 to-[#0c1c28] border border-emerald-500/30 p-8 text-white">
            <p
              class="text-[11px] font-semibold uppercase tracking-[0.18em] text-emerald-400 font-mono"
            >
              Zero Bot Hallucinations
            </p>
            <h2 class="mt-4 text-3xl font-heading font-semibold leading-[1.08]">
              Autonomous sales with ironclad boundaries.
            </h2>
            <p class="mt-5 text-sm font-medium leading-relaxed text-slate-300">
              Your AI closer is trained exclusively on your official Shopify product catalog, shipping policies, and discount ceilings. It never invents policies or sells out-of-stock items.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {
              safeguards.map((item, index) => (
                <article class="sec-safeguard-card opacity-0 rounded-[1.5rem] border border-white/10 bg-[#0c1626]/90 p-5">
                  <span class="grid h-8 w-8 place-items-center rounded-full bg-emerald-500/20 border border-emerald-500/30 font-mono text-xs font-bold text-emerald-300">
                    0{index + 1}
                  </span>
                  <h3 class="mt-4 text-base font-heading font-semibold text-white">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-xs font-medium leading-relaxed text-slate-300">
                    {item.text}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // Hero
    gsap.fromTo(".sec-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    // Main Card
    const mainTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".sec-main-card",
        start: "top 80%",
        toggleActions: "play none none reverse"
      }
    });
    mainTl.fromTo(".sec-main-card",
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" }
    ).fromTo(".sec-safeguard-card",
      { opacity: 0, scale: 0.95 },
      { opacity: 1, scale: 1, duration: 0.5, stagger: 0.1, ease: "back.out(1.2)" },
      "-=0.4"
    );

    // Bottom Grid
    gsap.fromTo(".sec-article-card",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.6, stagger: 0.15, ease: "power2.out",
        scrollTrigger: {
          trigger: ".sec-grid",
          start: "top 85%",
          toggleActions: "play none none reverse"
        }
      }
    );
  });
</script>
