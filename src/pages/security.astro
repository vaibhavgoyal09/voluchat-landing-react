---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lastUpdated = "May 20, 2026";

const safeguards = [
  {
    title: "Official channel access",
    text: "VoluChat connects through Meta login and scoped permissions for Instagram and Facebook Page workflows. We do not ask for social account passwords."
  },
  {
    title: "Token protection",
    text: "Authorized access tokens are stored with encryption controls and restricted internal access. Disconnecting a channel stops future automation through that integration."
  },
  {
    title: "Buyer data boundaries",
    text: "Product questions, catalog context, and handoff summaries are used to operate the service and improve store workflows, not sold to third-party ad networks."
  },
  {
    title: "Human review paths",
    text: "Automation is designed for repeated questions. Your team stays responsible for unusual messages, final order confirmation, and payments."
  }
];
---

<Layout
  title="Security Standards | VoluChat"
  description="Learn how VoluChat protects connected social channels, access tokens, buyer conversations, and ecommerce reply automation data."
  keywords="ecommerce automation security, Instagram DM automation security, Facebook Page automation security, Meta Graph API security, access token encryption"
>
  <Header />

  <main class="relative overflow-hidden pt-36 pb-24 animate-page-entry opacity-0 sm:pt-40">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_18%,rgba(83,111,159,0.11),transparent_30%),radial-gradient(circle_at_82%_20%,rgba(203,217,234,0.18),transparent_30%)]"></div>
    <div class="ambient-noise"></div>

    <div class="mx-auto max-w-6xl px-6">
      <div class="mx-auto mb-14 max-w-3xl text-center">
        <div class="chip">Trust & protection</div>
        <h1 class="mt-6 text-4xl font-semibold leading-[1.03] text-stone-950 md:text-6xl">
          Security for connected ecommerce conversations.
        </h1>
        <p class="section-copy mx-auto mt-6 max-w-2xl">
          VoluChat is built around scoped access, token protection, and clear data boundaries for stores using social messaging automation.
        </p>
        <p class="mt-4 text-sm font-medium text-stone-500">Last updated: {lastUpdated}</p>
      </div>

      <div class="solid-card mb-10 p-6 md:p-10">
        <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-center">
          <div class="rounded-xl bg-primary-900 p-8 text-white">
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary-100">Meta access</p>
            <h2 class="mt-4 text-3xl font-heading font-semibold leading-[1.08]">No password sharing.</h2>
            <p class="mt-5 text-sm font-medium leading-relaxed text-white/78">
              Stores connect supported channels through authorization flows. VoluChat uses the granted permissions to operate reply automation without collecting social account passwords.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {safeguards.map((item, index) => (
              <article class="rounded-[1.5rem] border border-stone-200/70 bg-white/76 p-5">
                <span class="grid h-9 w-9 place-items-center rounded-full bg-primary-800 font-mono text-xs font-semibold text-white">0{index + 1}</span>
                <h3 class="mt-5 text-lg font-heading font-semibold text-stone-950">{item.title}</h3>
                <p class="mt-3 text-sm font-semibold leading-relaxed text-stone-600">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        <article class="solid-card">
          <p class="section-eyebrow">Encryption</p>
          <h2 class="mt-4 text-2xl font-heading font-semibold text-stone-950">Protected storage</h2>
          <p class="mt-4 text-sm font-semibold leading-relaxed text-stone-600">
            Sensitive operational data is protected with encryption controls, access limits, and infrastructure practices appropriate for a hosted SaaS product.
          </p>
        </article>
        <article class="solid-card">
          <p class="section-eyebrow">Access</p>
          <h2 class="mt-4 text-2xl font-heading font-semibold text-stone-950">Scoped permissions</h2>
          <p class="mt-4 text-sm font-semibold leading-relaxed text-stone-600">
            We request permissions needed for reply automation and handoff workflows, and avoid unrelated account surfaces wherever possible.
          </p>
        </article>
        <article class="solid-card">
          <p class="section-eyebrow">Control</p>
          <h2 class="mt-4 text-2xl font-heading font-semibold text-stone-950">Disconnect paths</h2>
          <p class="mt-4 text-sm font-semibold leading-relaxed text-stone-600">
            Stores can disconnect channels and stop future automation through those integrations as their workflow or requirements change.
          </p>
        </article>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
