---
import Layout from '../layouts/Layout.astro';
import Header from '../components/landing/Navbar.astro';
import Footer from '../components/landing/Footer.astro';
import FAQ from '../components/FAQ.astro';

const lastUpdated = "June 24, 2026";

const safeguards = [
  {
    title: "Store Data Boundaries",
    text: "VoluChat agents only access the specific Shopify scopes required for your configured workflows. We adhere to strict data minimization."
  },
  {
    title: "Human Approval Workflows",
    text: "Agents can be set to 'recommend-only' mode, requiring a team member to approve actions like sending a discount or launching a clearance campaign."
  },
  {
    title: "Margin Controls",
    text: "Set strict limits on the maximum discount an agent can offer for cart recovery or upselling. Agents cannot override these financial guardrails."
  },
  {
    title: "Full Audit Logs",
    text: "Every action, recommendation, and execution taken by a commerce agent is permanently logged for your team's review."
  }
];
---

<Layout
  title="Security & Guardrails | VoluChat AI Commerce Agents"
  description="Learn how VoluChat protects your Shopify data and enforces strict approval workflows and margin controls for autonomous commerce agents."
  keywords="commerce agent security, AI guardrails, Shopify data security, human-in-the-loop AI, AI approval workflows"
>
  <Header />

  <main class="relative overflow-hidden pt-36 pb-24 animate-page-entry opacity-0 sm:pt-40">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_18%,rgba(83,111,159,0.11),transparent_30%),radial-gradient(circle_at_82%_20%,rgba(203,217,234,0.18),transparent_30%)]"></div>
    <div class="ambient-noise"></div>

    <div class="mx-auto max-w-6xl px-6">
      <div class="mx-auto mb-14 max-w-3xl text-center">
        <div class="chip">Trust & Guardrails</div>
        <h1 class="mt-6 text-4xl font-semibold leading-[1.03] text-white md:text-6xl">
          Security and control for autonomous commerce.
        </h1>
        <p class="section-copy mx-auto mt-6 max-w-2xl">
          VoluChat is built around scoped access, margin protection, and clear human approval boundaries for stores deploying AI agents.
        </p>
        <p class="mt-4 text-sm font-medium text-slate-300">Last updated: {lastUpdated}</p>
      </div>

      <div class="solid-card mb-10 p-6 md:p-10">
        <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-center">
          <div class="rounded-xl bg-teal-500 p-8 text-white">
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary-100">Human-in-the-loop</p>
            <h2 class="mt-4 text-3xl font-heading font-semibold leading-[1.08]">You have the final say.</h2>
            <p class="mt-5 text-base font-medium leading-relaxed text-white/78">
              AI shouldn't make unilateral financial decisions without your permission. VoluChat's approval workflows let you review, edit, or reject agent recommendations before they reach the customer.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {safeguards.map((item, index) => (
              <article class="rounded-[1.5rem] border border-[rgba(148,163,184,0.2)] bg-[#101b2e] p-5">
                <span class="grid h-9 w-9 place-items-center rounded-full bg-teal-500 font-mono text-xs font-semibold text-white">0{index + 1}</span>
                <h3 class="mt-5 text-lg font-heading font-semibold text-white">{item.title}</h3>
                <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        <article class="solid-card">
          <p class="section-eyebrow">Data Privacy</p>
          <h2 class="mt-4 text-2xl font-heading font-semibold text-white">Strict Boundaries</h2>
          <p class="mt-4 text-base font-medium leading-relaxed text-slate-300">
            Your product catalog, customer data, and store metrics are used exclusively to operate your agents. We never train public models on your private data.
          </p>
        </article>
        <article class="solid-card">
          <p class="section-eyebrow">Access</p>
          <h2 class="mt-4 text-2xl font-heading font-semibold text-white">Shopify Scopes</h2>
          <p class="mt-4 text-base font-medium leading-relaxed text-slate-300">
            We request only the Shopify API permissions needed for the agents you deploy, adhering to the principle of least privilege.
          </p>
        </article>
        <article class="solid-card">
          <p class="section-eyebrow">Oversight</p>
          <h2 class="mt-4 text-2xl font-heading font-semibold text-white">Action History</h2>
          <p class="mt-4 text-base font-medium leading-relaxed text-slate-300">
            Easily audit the exact triggers, logic, and output of every agent workflow in your workspace to ensure brand safety.
          </p>
        </article>
      </div>
    </div>
  </main>

  <FAQ />
  <Footer />
</Layout>
