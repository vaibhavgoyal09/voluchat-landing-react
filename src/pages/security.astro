---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lastUpdated = "May 20, 2026";
---

<Layout 
  title="Security Standards & Cryptography | VoluChat"
  description="Learn about VoluChat's robust security standards. Discover how we protect your Instagram access tokens and sensitive shoe store data using official Meta APIs, salting, peppering, and advanced isolation."
  keywords="SaaS security standards, salting and peppering, password hashing, API token encryption, AES-256, Instagram DM automation security, Meta Graph API security, VoluChat compliance"
>
  <Header />

  <main class="relative pt-32 pb-24 overflow-hidden">
    <!-- Background Elements for Premium Aesthetic -->
    <div class="sect-grid"></div>
    <div class="sect-orb w-[600px] h-[600px] bg-stone-200/30 -top-32 -left-32 animate-pulse" style="animation-duration: 8s;"></div>
    <div class="sect-orb w-[500px] h-[500px] bg-stone-300/25 bottom-12 -right-32 animate-pulse" style="animation-duration: 12s;"></div>
    <div class="sect-orb w-[300px] h-[300px] bg-stone-100/30 top-1/2 left-1/3 blur-[120px]"></div>

    <div class="max-w-5xl mx-auto px-6 relative z-10">
      <!-- Page Hero Header -->
      <div class="text-center mb-16 reveal-on-scroll">
        <div class="mb-4 inline-flex">
          <span class="chip">Trust & Protection</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-heading font-semibold text-stone-950 tracking-tight mb-6">
          Security <span class="text-gradient-primary">Standards</span>
        </h1>
        <p class="text-lg md:text-xl text-stone-600 max-w-2xl mx-auto leading-relaxed font-semibold">
          How we safeguard your store credentials, buyer conversations, and Meta integration keys using mathematical defense-in-depth frameworks.
        </p>
      </div>

      <!-- Meta Graph API Integration Premium Banner -->
      <div class="mb-16 reveal-on-scroll">
        <div class="relative overflow-hidden rounded-[2.5rem] border border-stone-200/60 bg-white/70 p-8 md:p-12 backdrop-blur-xl shadow-xl">
          <div class="absolute -right-16 -top-16 w-44 h-44 rounded-full bg-stone-200/30 blur-2xl"></div>
          <div class="absolute -left-16 -bottom-16 w-44 h-44 rounded-full bg-stone-300/20 blur-2xl"></div>
          
          <div class="flex flex-col md:flex-row items-center gap-10 relative z-10">
            <!-- Badge / Icon Container -->
            <div class="flex-shrink-0 w-28 h-28 rounded-3xl bg-gradient-to-tr from-stone-950 to-stone-800 p-0.5 shadow-lg shadow-stone-900/10 flex items-center justify-center">
              <div class="w-full h-full bg-stone-950 rounded-[22px] flex flex-col items-center justify-center p-3 text-center">
                <span class="text-[9px] font-bold tracking-widest text-stone-400 uppercase">SECURE</span>
                <span class="font-heading font-semibold text-xl text-white leading-none tracking-tighter">Meta</span>
                <span class="text-[8px] font-bold text-stone-500 mt-1.5 uppercase">APIs Only</span>
              </div>
            </div>
            
            <div class="flex-1 text-center md:text-left space-y-4">
              <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-stone-800 bg-stone-100 border border-stone-200/80 px-3.5 py-1.5 rounded-full shadow-sm">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  Official Meta Graph API
                </span>
                <span class="text-[10px] font-bold text-stone-400 uppercase tracking-widest">Verified Integration</span>
              </div>
              
              <h3 class="text-2xl font-heading font-bold text-stone-950 tracking-tight sm:text-3xl">
                Built Entirely on Official Meta APIs
              </h3>
              <p class="text-sm sm:text-base font-semibold leading-relaxed text-stone-600">
                VoluChat connects to your store's Instagram and Facebook pages strictly via official, scoped **Meta Graph APIs**. We request granular, read-write scoped permissions using standard Meta Login OAuth flows, meaning you never have to share your Instagram password or credential files. We strictly follow Meta's Developer Platform Policies and Data Protection Guidelines to keep your social accounts safe and fully compliant.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Section: Meta Graph API & Social Account Protection -->
      <div class="mb-20 reveal-on-scroll">
        <div class="text-center mb-12">
          <p class="section-eyebrow mb-2">API Integration Security</p>
          <h2 class="text-3xl font-heading font-bold text-stone-950 sm:text-4xl">How We Guard Connected Social Accounts</h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Column 1: Scoped Permissions -->
          <div class="glass-card-premium rounded-3xl p-8 flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-stone-100 border border-stone-200 flex items-center justify-center text-stone-850 mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
                </svg>
              </div>
              <h4 class="font-heading font-bold text-stone-950 text-lg mb-2">Minimal-Scope Authorization</h4>
              <p class="text-xs font-semibold text-stone-500 leading-relaxed">
                We strictly adhere to the principle of least privilege. When you connect your Instagram and Facebook pages, we request only the absolute minimal permissions required to read messages, manage replies, and execute handoffs. We never request access to personal ad accounts, payment systems, or unrelated business manager assets.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-stone-200 flex items-center justify-between text-[9px] text-stone-400 uppercase font-bold tracking-widest">
              <span>Scope Limited</span>
              <span class="text-stone-900">Strictly Scoped</span>
            </div>
          </div>

          <!-- Column 2: Developer Policy Compliance -->
          <div class="glass-card-premium rounded-3xl p-8 flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-stone-100 border border-stone-200 flex items-center justify-center text-stone-850 mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m5.231 13.481L15 17.25m-4.5-1.5H13m-9-3h12m-12 6h12m-13.5-3.75h16.5V2.25H3.75v16.5Z" />
                </svg>
              </div>
              <h4 class="font-heading font-bold text-stone-950 text-lg mb-2">Meta Developer Policy Compliance</h4>
              <p class="text-xs font-semibold text-stone-500 leading-relaxed">
                Our platform integration complies fully with Meta’s Developer Platform policies and review guidelines. Our backend storage, webhook validations, and scoped login flows are engineered to match Meta's standard security requirements, ensuring stable and secure messaging channels for your business.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-stone-200 flex items-center justify-between text-[9px] text-stone-400 uppercase font-bold tracking-widest">
              <span>Policy Compliant</span>
              <span class="text-stone-900">Standard Webhooks</span>
            </div>
          </div>

          <!-- Column 3: Instant Revocation -->
          <div class="glass-card-premium rounded-3xl p-8 flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-stone-100 border border-stone-200 flex items-center justify-center text-stone-850 mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
              </div>
              <h4 class="font-heading font-bold text-stone-950 text-lg mb-2">Instant Token Shredding</h4>
              <p class="text-xs font-semibold text-stone-500 leading-relaxed">
                If you choose to disconnect a social account from VoluChat, we immediately execute a secure deletion algorithm. The associated access token is not just marked as inactive; it is permanently shredded from our database clusters, all active webhook subscriptions are instantly unregistered, and memory caches are purged.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-stone-200 flex items-center justify-between text-[9px] text-stone-400 uppercase font-bold tracking-widest">
              <span>Shredding Standard</span>
              <span class="text-stone-900">Zero Residual Data</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Core Cryptographic Hashing Visual Section -->
      <div class="mb-20 reveal-on-scroll">
        <div class="glass-panel-premium rounded-[2.5rem] p-8 md:p-12 border-stone-200 shadow-2xl relative overflow-hidden">
          <div class="absolute top-0 right-0 w-96 h-96 bg-stone-200/20 rounded-full blur-[80px] -mr-20 -mt-20"></div>
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
            <div class="lg:col-span-5 space-y-6">
              <span class="chip">Advanced Cryptography</span>
              <h2 class="text-3xl font-heading font-bold text-stone-950 tracking-tight leading-tight">
                Salting, Peppering & Memory-Hard Hashing
              </h2>
              <p class="text-stone-600 leading-relaxed text-sm md:text-base font-semibold">
                Passwords and system secrets are never stored in raw text. To withstand modern offline dictionary attacks and GPU-accelerated brute-forcing, we employ a highly advanced, layered cryptographic pipeline.
              </p>
              
              <div class="space-y-4">
                <div class="flex gap-4">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-stone-950 text-white flex items-center justify-center font-bold text-sm">1</div>
                  <div>
                    <h4 class="font-bold text-stone-950 text-sm">Cryptographic Salt</h4>
                    <p class="text-xs text-stone-500 mt-1 font-medium">A cryptographically random 128-bit string generated uniquely for every single record, stored alongside the hash in the database to prevent rainbow table attacks.</p>
                  </div>
                </div>

                <div class="flex gap-4">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-stone-950 text-white flex items-center justify-center font-bold text-sm">2</div>
                  <div>
                    <h4 class="font-bold text-stone-950 text-sm">Global Secret Pepper</h4>
                    <p class="text-xs text-stone-500 mt-1 font-medium">A high-entropy, hardware-secured pepper stored in server memory (outside the database), combined with the input before hashing. If the database leaks, hashes cannot be brute-forced without the server pepper.</p>
                  </div>
                </div>

                <div class="flex gap-4">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-stone-950 text-white flex items-center justify-center font-bold text-sm">3</div>
                  <div>
                    <h4 class="font-bold text-stone-950 text-sm">Argon2id (Memory-Hard)</h4>
                    <p class="text-xs text-stone-500 mt-1 font-medium">We feed the salted, peppered value into <strong>Argon2id</strong> (or optimized <strong>bcrypt</strong>), calibrated with severe memory and time costs, making brute-force attempts cost-prohibitive.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Beautiful Visual Block / CSS Diagram representing the Pipeline -->
            <div class="lg:col-span-7">
              <div class="bg-slate-950 rounded-2xl p-6 md:p-8 shadow-2xl relative border border-slate-800 text-slate-200 font-mono text-xs">
                <!-- Mac-like Window Controls -->
                <div class="flex items-center gap-1.5 mb-6 pb-4 border-b border-slate-800">
                  <span class="w-3.5 h-3.5 rounded-full bg-rose-500/80 inline-block"></span>
                  <span class="w-3.5 h-3.5 rounded-full bg-amber-500/80 inline-block"></span>
                  <span class="w-3.5 h-3.5 rounded-full bg-emerald-500/80 inline-block"></span>
                  <span class="text-[10px] text-slate-500 ml-4 font-sans font-bold">VoluChat Cryptography Pipeline</span>
                </div>

                <div class="space-y-6">
                  <!-- Step 1: Input -->
                  <div class="relative pl-6 border-l-2 border-slate-800 hover:border-stone-500 transition-colors duration-300">
                    <div class="absolute -left-[6px] top-0 w-2.5 h-2.5 rounded-full bg-slate-800 border-2 border-slate-950"></div>
                    <span class="text-[10px] uppercase font-black tracking-widest text-slate-500 font-sans block mb-1">01. INGEST SENSITIVE DATA</span>
                    <div class="bg-slate-900 p-3 rounded-lg border border-slate-800 flex items-center justify-between">
                      <span class="text-stone-400">"sensitive_secret_data"</span>
                      <span class="text-[10px] text-slate-600 bg-slate-950 px-2 py-0.5 rounded font-sans uppercase font-bold">Plaintext</span>
                    </div>
                  </div>

                  <!-- Step 2: Salt & Pepper Combined -->
                  <div class="relative pl-6 border-l-2 border-slate-800 hover:border-stone-500 transition-colors duration-300">
                    <div class="absolute -left-[6px] top-0 w-2.5 h-2.5 rounded-full bg-slate-800 border-2 border-slate-950"></div>
                    <span class="text-[10px] uppercase font-black tracking-widest text-slate-500 font-sans block mb-1">02. MATHEMATICAL LAYER ADDITION</span>
                    <div class="grid grid-cols-2 gap-3">
                      <div class="bg-stone-900/60 p-2.5 rounded-lg border border-stone-850">
                        <span class="text-[9px] uppercase font-bold text-stone-400 block mb-0.5">Unique Salt (in DB)</span>
                        <span class="text-[10px] text-stone-300 block truncate">8f3c4e92a10b9e83...</span>
                      </div>
                      <div class="bg-stone-900/60 p-2.5 rounded-lg border border-stone-850">
                        <span class="text-[9px] uppercase font-bold text-stone-400 block mb-0.5">Global Pepper (Env Only)</span>
                        <span class="text-[10px] text-stone-300 block truncate">k9#xP!1mZ92@qRw7...</span>
                      </div>
                    </div>
                  </div>

                  <!-- Step 3: Key Derivation Function -->
                  <div class="relative pl-6 border-l-2 border-slate-800 hover:border-emerald-500 transition-colors duration-300">
                    <div class="absolute -left-[6px] top-0 w-2.5 h-2.5 rounded-full bg-slate-800 border-2 border-slate-950"></div>
                    <span class="text-[10px] uppercase font-black tracking-widest text-slate-500 font-sans block mb-1">03. ARGON2ID WORK FACTOR</span>
                    <div class="bg-emerald-950/30 p-3 rounded-lg border border-emerald-900/50 flex items-center justify-between">
                      <div class="space-y-0.5">
                        <span class="text-emerald-400 font-bold block text-[11px]">Argon2id (m=65536, t=3, p=4)</span>
                        <span class="text-[9px] text-slate-500 block">Demands 64MB of physical RAM to compute</span>
                      </div>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-emerald-400 animate-spin" style="animation-duration: 4s;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                      </svg>
                    </div>
                  </div>

                  <!-- Step 4: Encrypted Output -->
                  <div class="relative pl-6 border-l-2 border-transparent">
                    <div class="absolute -left-[6px] top-0 w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)] border-2 border-emerald-500"></div>
                    <span class="text-[10px] uppercase font-black tracking-widest text-slate-500 font-sans block mb-1">04. SECURE RESULT AT REST</span>
                    <div class="bg-slate-900 p-3 rounded-lg border border-emerald-900/40 flex items-center justify-between shadow-lg shadow-emerald-950/20">
                      <span class="text-emerald-300 text-[10px] select-all break-all overflow-hidden line-clamp-1">$argon2id$v=19$m=65536,t=3,p=4$c29tZXNhbHQ$dGVzdGFyZ29uMmhhc2g...</span>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-emerald-400">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Core Security Pillars Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20 reveal-on-scroll">
        
        <!-- Token Protection -->
        <div class="glass-card-premium rounded-3xl p-8">
          <div class="w-12 h-12 rounded-2xl bg-stone-100 border border-stone-200 flex items-center justify-center text-stone-900 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-stone-950 mb-3">Instagram Token Vaulting</h3>
          <p class="text-sm text-stone-600 leading-relaxed mb-4 font-semibold">
            To coordinate automatic comment replies and WhatsApp handoffs, VoluChat securely interacts with the Instagram Graph API. Access tokens are immediately encrypted at rest using <strong>AES-256-GCM</strong>.
          </p>
          <ul class="space-y-2.5 text-xs text-stone-500 font-bold">
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-stone-900"></span> Unique encryption keys per store tenant.
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-stone-900"></span> Secret rotation cycles controlled by KMS.
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-stone-900"></span> Hardware Security Module (HSM) key isolation.
            </li>
          </ul>
        </div>

        <!-- Tenant Isolation -->
        <div class="glass-card-premium rounded-3xl p-8">
          <div class="w-12 h-12 rounded-2xl bg-stone-100 border border-stone-200 flex items-center justify-center text-stone-900 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-.621-.504-1.125-1.125-1.125H9.75M9.663 5h4.674m-4.674 0c-.228 0-.454.016-.677.048C7.68 5.253 7 6.444 7 7.788V19a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V7.788c0-1.344-.68-2.535-1.31-2.74a12.07 12.07 0 0 0-.677-.048" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-stone-950 mb-3">Database Isolation & RLS</h3>
          <p class="text-sm text-stone-600 leading-relaxed mb-4 font-semibold">
            We store shoes catalog details, order parameters, and buyer messages. To ensure cross-contamination never occurs, we enforce structural database boundary separation.
          </p>
          <ul class="space-y-2.5 text-xs text-stone-500 font-bold">
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-stone-900"></span> Strict Row-Level Security (RLS) policies.
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-stone-900"></span> Dynamic parameterized querying (no raw SQL).
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-stone-900"></span> Automated test coverage for data leaks.
            </li>
          </ul>
        </div>

        <!-- Transmission Security -->
        <div class="glass-card-premium rounded-3xl p-8">
          <div class="w-12 h-12 rounded-2xl bg-stone-100 border border-stone-200 flex items-center justify-center text-stone-900 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 5.25 5.25 0 0 1 10.233-2.33 3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-stone-950 mb-3">Encrypted Data in Transit</h3>
          <p class="text-sm text-stone-600 leading-relaxed mb-4 font-semibold">
            Data passing between your shop dashboard, the Instagram servers, and the customer handoff URL is protected under high-grade transit encryption.
          </p>
          <ul class="space-y-2.5 text-xs text-stone-500 font-bold">
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-stone-900"></span> Mandatory TLS 1.3 encryption across all APIs.
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-stone-900"></span> Strict HTTP Strict Transport Security (HSTS).
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-stone-900"></span> Secure SHA-256 Meta webhook signatures verification.
            </li>
          </ul>
        </div>

        <!-- Logging and Audits -->
        <div class="glass-card-premium rounded-3xl p-8">
          <div class="w-12 h-12 rounded-2xl bg-stone-100 border border-stone-200 flex items-center justify-center text-stone-900 mb-6">
