          <!-- FAQ 1 -->
          <details class="group border border-stone-200/60 bg-white/50 backdrop-blur-md rounded-2xl p-6 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden open:border-stone-300 open:bg-white/80">
