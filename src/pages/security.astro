---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Security & Guardrails | VoluChat AI Commerce Agents",
  description: "See how VoluChat gives Shopify brands control over AI commerce agents with scoped access, approval workflows, margin rules, and reviewable action history.",
  url: siteUrl,
};

const safeguards = [
  {
    title: "Scoped store access",
    text: "Agents should only work with the store data needed for the workflows you enable: catalog, inventory, carts, orders, and policy context where relevant.",
  },
  {
    title: "Approval before sensitive action",
    text: "Discounts, campaign launches, high-value recovery messages, and unusual escalations can be queued for review before anything reaches a customer.",
  },
  {
    title: "Margin and offer limits",
    text: "Set boundaries around discounts, bundles, clearance products, and recovery incentives so an agent cannot trade away margin to chase a conversion.",
  },
  {
    title: "Reviewable decision trail",
    text: "Teams need to know why an agent acted. VoluChat is designed to keep the signal, recommendation, approval state, and outcome visible.",
  },
];
---

<Layout
  title="Security & Guardrails | VoluChat AI Commerce Agents"
  description="See how VoluChat gives Shopify brands control over AI commerce agents with scoped access, approval workflows, margin rules, and reviewable action history."
  keywords="commerce agent security, AI guardrails, Shopify data security, human-in-the-loop AI, AI approval workflows"
  canonical={new URL("/security", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="relative overflow-hidden pt-36 pb-24 sm:pt-40">
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_18%,rgba(83,111,159,0.11),transparent_30%),radial-gradient(circle_at_82%_20%,rgba(203,217,234,0.18),transparent_30%)]"
    >
    </div>
    <div class="ambient-noise"></div>

    <div class="page-shell px-6">
      <div class="sec-hero-text opacity-0 mx-auto mb-14 max-w-3xl text-center">
        <div class="chip">Trust & Guardrails</div>
        <h1
          class="mt-6 text-4xl font-semibold leading-[1.03] text-white md:text-6xl"
        >
          Control the agent before the agent talks to customers.
        </h1>
        <p class="section-copy mx-auto mt-6 max-w-2xl">
          Commerce agents can move fast. VoluChat is built so operators can
          decide what agents can see, what they can recommend, what needs
          approval, and what should never happen automatically.
        </p>
        <p class="mt-4 text-sm font-medium text-slate-300">
          Last updated: {lastUpdated}
        </p>
      </div>

      <div class="sec-main-card opacity-0 solid-card mb-10 p-6 md:p-10">
        <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-center">
          <div class="rounded-xl bg-teal-500 p-8 text-white">
            <p
              class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary-100"
            >
              Human judgment stays in the loop
            </p>
            <h2 class="mt-4 text-3xl font-heading font-semibold leading-[1.08]">
              Automation should not mean blind permission.
            </h2>
            <p class="mt-5 text-base font-medium leading-relaxed text-white/78">
              A commerce agent may draft a cart recovery message, suggest a
              bundle, or propose a clearance offer. Your team can keep those
              actions in recommend-only mode, review the exact suggestion, and
              decide what gets sent.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {
              safeguards.map((item, index) => (
                <article class="sec-safeguard-card opacity-0 rounded-[1.5rem] border border-[rgba(148,163,184,0.2)] bg-[#101b2e] p-5">
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-teal-500 font-mono text-xs font-semibold text-white">
                    0{index + 1}
                  </span>
                  <h3 class="mt-5 text-lg font-heading font-semibold text-white">
                    {item.title}
                  </h3>
                  <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                    {item.text}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </div>

      <div class="sec-grid grid gap-5 md:grid-cols-3">
        <article class="sec-article-card opacity-0 solid-card">
          <p class="section-eyebrow">Data boundaries</p>
          <h2 class="mt-4 text-2xl font-heading font-semibold text-white">
            Use store context carefully
          </h2>
          <p class="mt-4 text-base font-medium leading-relaxed text-slate-300">
            Agents need context to be useful, but they should not have unlimited
            context by default. VoluChat's security posture starts with using
            the store data needed to operate the configured workflow.
          </p>
        </article>
        <article class="sec-article-card opacity-0 solid-card">
          <p class="section-eyebrow">Access</p>
          <h2 class="mt-4 text-2xl font-heading font-semibold text-white">
            Keep permissions tied to workflows
          </h2>
          <p class="mt-4 text-base font-medium leading-relaxed text-slate-300">
            Product answers, cart recovery, upsells, and inventory clearance do
            not need the same level of access. Permissions should map to the
            agent workflows you actually deploy.
          </p>
        </article>
        <article class="sec-article-card opacity-0 solid-card">
          <p class="section-eyebrow">Oversight</p>
          <h2 class="mt-4 text-2xl font-heading font-semibold text-white">
            Make every action explainable
          </h2>
          <p class="mt-4 text-base font-medium leading-relaxed text-slate-300">
            Operators should be able to inspect the trigger, recommendation,
            approval state, and final result. That visibility is what makes
            automation usable for serious stores.
          </p>
        </article>
      </div>
    </div>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // Hero
    gsap.fromTo(".sec-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    // Main Card
    const mainTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".sec-main-card",
        start: "top 80%",
        toggleActions: "play none none reverse"
      }
    });
    mainTl.fromTo(".sec-main-card",
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" }
    ).fromTo(".sec-safeguard-card",
      { opacity: 0, scale: 0.95 },
      { opacity: 1, scale: 1, duration: 0.5, stagger: 0.1, ease: "back.out(1.2)" },
      "-=0.4"
    );

    // Bottom Grid
    gsap.fromTo(".sec-article-card",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.6, stagger: 0.15, ease: "power2.out",
        scrollTrigger: {
          trigger: ".sec-grid",
          start: "top 85%",
          toggleActions: "play none none reverse"
        }
      }
    );
  });
</script>
