---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const siteUrl = "https://www.voluchat.com";

const helpfulLinks = [
  {
    title: "How It Works",
    description: "See how VoluChat automates comments, qualifies sizing, and closes orders.",
    href: "/#how-it-works",
  },
  {
    title: "Features & Architecture",
    description: "Explore the 4-pillar automated sales engine for Instagram & WhatsApp.",
    href: "/features",
  },
  {
    title: "Pilot Cohort & Pricing",
    description: "Discover our white-glove setup and 10x value standard for pilot stores.",
    href: "/pricing",
  },
  {
    title: "Compare Solutions",
    description: "See how VoluChat compares to traditional chatbots and manual reps.",
    href: "/compare",
  },
];
---

<Layout
  title="Page Not Found | VoluChat"
  description="The page you were looking for doesn't exist or may have been moved. Return to VoluChat or explore our popular links."
  robots="noindex, follow"
  canonical={new URL("/404", siteUrl).toString()}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Page Not Found | VoluChat",
    description: "The page you were looking for doesn't exist or may have been moved.",
    url: siteUrl,
  }}
>
  <Header />

  <main class="min-h-[85vh] overflow-hidden bg-[#000000]">
    <section class="hero-stripe pb-16 pt-32 sm:pt-40">
      <div class="section-glow-emerald"></div>
      <div class="sect-grid opacity-20"></div>

      <div class="page-shell">
        <div class="notfound-hero mx-auto max-w-2xl text-center">
          <div class="chip mb-5">
            <span class="mini-label">404 Error</span>
          </div>

          <h1 class="text-4xl font-semibold leading-[1.08] text-[#fcfdff] sm:text-5xl lg:text-6xl font-heading">
            Page not found.
          </h1>

          <p class="section-copy mx-auto mt-5 max-w-lg">
            The page you are looking for might have been moved, renamed, or doesn't exist. Let's get you back on track.
          </p>

          <div class="mt-8 flex flex-col items-center justify-center gap-3.5 sm:flex-row">
            <a href="/" class="btn-primary">
              Return to Homepage &rarr;
            </a>
            <a href="/contact" class="btn-secondary">
              Contact Support
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Helpful Navigation Grid -->
    <section class="pb-28 bg-[#000000]">
      <div class="page-shell">
        <div class="mx-auto max-w-3xl">
          <p class="section-eyebrow mb-6 text-center">Popular destinations</p>
          <div class="grid gap-4 sm:grid-cols-2">
            {
              helpfulLinks.map((item) => (
                <a
                  href={item.href}
                  class="notfound-card group block rounded-xl border border-white/[0.12] bg-[#0c0c10] p-6 transition-all duration-200 hover:border-emerald-500/40 hover:bg-[#121216]"
                >
                  <div class="flex items-center justify-between gap-4">
                    <h2 class="text-base font-heading font-semibold text-white transition-colors group-hover:text-emerald-400">
                      {item.title}
                    </h2>
                    <span class="text-slate-400 transition-transform duration-200 group-hover:translate-x-1 group-hover:text-emerald-400">
                      &rarr;
                    </span>
                  </div>
                  <p class="mt-2.5 text-sm font-normal leading-relaxed text-slate-300">
                    {item.description}
                  </p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    gsap.fromTo(".notfound-hero", 
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }
    );

    gsap.fromTo(".notfound-card", 
      { opacity: 0, y: 15 },
      { opacity: 1, y: 0, duration: 0.4, stagger: 0.05, delay: 0.1, ease: "power2.out" }
    );
  });
</script>

