---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

interface Blog {
  id: number;
  title: string;
  slug: string;
  content: string;
  published: number;
  author_id: number;
  created_at: string;
}

export async function getStaticPaths() {
  const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
  let blogs: Blog[] = [];
  try {
    const response = await fetch(`${apiUrl}/blogs/`);
    if (response.ok) {
        blogs = await response.json();
    }
  } catch (e) {
    console.error('Error in getStaticPaths:', e);
  }

  // Always include fallback paths for demo
  const paths = [
    { params: { slug: 'ai-revolutionizing-instagram-growth' } },
    { params: { slug: 'regional-language-support-ecommerce' } },
    { params: { slug: 'maximizing-conversions-dm-whatsapp' } },
    ...blogs.map(blog => ({ params: { slug: blog.slug } }))
  ];

  return paths;
}

const { slug } = Astro.params;
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://127.0.0.1:8000';

let blog: Blog | null = null;
let error: string | null = null;

try {
  console.log(`[Server] Fetching blog slug: ${slug} from ${apiUrl}`);
  const response = await fetch(`${apiUrl}/blogs/slug/${slug}`);
  if (!response.ok) {
    throw new Error(`State: ${response.status}`);
  }
  blog = await response.json();
  console.log(`[Server] Successfully fetched blog: ${blog?.title}`);
} catch (e) {
  console.error(`[Server] Failed to fetch blog ${slug}:`, e);
  // Fallback for demo
  const fallbacks: Record<string, any> = {
    'ai-revolutionizing-instagram-growth': {
      title: "How AI is Revolutionizing Instagram Growth in 2024",
      content: "The landscape of social media marketing is shifting. With the advent of advanced AI tools, brands are now able to automate interactions that once required a full team. Discover how VoluChat is leading the charge with regional language support and intelligent DM automation.\n\n## The Evolution of Social Media\n\nIn the past, social media was a one-to-one conversation. But as brands grew, this became impossible to manage. Enter artificial intelligence. It's not just about chatbots anymore; it's about intelligent systems that understand intent, sentiment, and context.\n\n## Why Automation Matters\n\n1. **Speed**: Instant replies increase customer satisfaction.\n2. **Consistency**: Every customer gets the same high-quality interaction.\n3. **Scale**: Handle thousands of DMs simultaneously without additional headcount.",
      author_id: 1,
      created_at: "2024-03-20T10:00:00Z"
    },
    'regional-language-support-ecommerce': {
        title: "The Power of Regional Language Support in Indian E-commerce",
        content: "India is a land of many languages. For brands to truly scale, they must speak the language of their customers. Learn why regional language automation is the key to unlocking 10x growth in tier 2 and tier 3 cities.",
        author_id: 1,
        created_at: "2024-03-22T08:30:00Z"
    },
    'maximizing-conversions-dm-whatsapp': {
        title: "Maximizing Conversions: From DM to WhatsApp in Seconds",
        content: "The friction between an Instagram interest and a WhatsApp sale often leads to lost revenue. VoluChat's seamless integration bridge ensures that every lead is captured and moved into a high-intent conversation immediately.",
        author_id: 1,
        created_at: "2024-03-25T14:15:00Z"
    }
  };
  
  if (fallbacks[slug]) {
    blog = fallbacks[slug];
  } else {
    error = "The blog post you're looking for doesn't exist or is currently unavailable.";
  }
}

const date = blog?.created_at ? new Date(blog.created_at).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}) : 'Recently published';
---

<Layout title={blog ? `${blog.title} | VoluChat Blog` : "Blog Post Not Found"}>
  <Header />
  
  <main class="relative pt-32 pb-20 overflow-hidden">
    {blog ? (
      <article class="container-wide px-6 max-w-4xl mx-auto">
        <div class="mb-12 text-center">
          <a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 mb-8 hover:gap-3 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Back to Blog
          </a>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 mb-8 tracking-tight leading-tight">
            {blog.title}
          </h1>
          <div class="flex items-center justify-center gap-6 text-slate-500">
             <div class="flex items-center gap-2">
               <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center font-bold text-indigo-600">V</div>
               <span class="font-bold text-slate-900">VoluChat Team</span>
             </div>
             <span class="w-1 h-1 rounded-full bg-slate-300"></span>
             <time class="font-medium">{date}</time>
          </div>
        </div>

        <div class="glass-panel relative aspect-[21/9] rounded-2xl overflow-hidden mb-16">
           <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/20 via-cyan-400/10 to-emerald-400/20"></div>
           <div class="absolute inset-0 flex items-center justify-center text-slate-300">
             <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
           </div>
        </div>

        <div class="glass-panel rounded-3xl p-8 md:p-12 prose prose-slate prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-indigo-600 prose-img:rounded-3xl shadow-none">
          {blog.content.split('\n').map(p => {
             if (p.startsWith('##')) return <h2 class="text-3xl font-bold text-slate-900 mt-12 mb-6">{p.replace('##', '').trim()}</h2>;
             if (p.startsWith('1. ') || p.startsWith('2. ') || p.startsWith('3. ')) return <li class="text-slate-600 leading-relaxed text-lg ml-6 mb-2">{p}</li>;
             return <p class="text-slate-600 leading-relaxed text-lg mb-6">{p}</p>;
          })}
        </div>

        <div class="mt-20 pt-10 border-t border-white/55">
          <div class="glass-card flex flex-col md:flex-row items-center justify-between gap-8 p-8 rounded-2xl">
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Ready to grow your brand?</h3>
              <p class="text-slate-600 font-medium">Start your free trial today and automate your customer engagement.</p>
            </div>
            <a href="https://dashboard.voluchat.com" class="btn-primary whitespace-nowrap px-10">
              Get Started Free
            </a>
          </div>
        </div>
      </article>
    ) : (
      <div class="container-wide px-6 py-20 text-center">
        <h1 class="text-3xl font-bold text-slate-900 mb-4">Post Not Found</h1>
        <p class="text-slate-600 mb-8">{error}</p>
        <a href="/blog" class="btn-primary">Back to Blog</a>
      </div>
    )}
  </main>

  <Footer />
</Layout>

<style>
  /* Base Prose-like styles for content */
  p { margin-bottom: 1.5rem; }
  h2 { margin-top: 2.5rem; margin-bottom: 1.25rem; }
  li { display: list-item; list-style-type: decimal; }
</style>
