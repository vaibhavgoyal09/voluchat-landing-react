---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { fetchBlogPostBySlug, getBlogApiBaseUrl } from "../../lib/blogApi.mjs";
import { renderMarkdownToHtml } from "../../lib/markdown.mjs";

const relatedLinks = [
  {
    href: "/features",
    label: "Pillar",
    title: "Instagram and Facebook reply automation",
    text: "See the core product flow for product questions, catalog replies, order details, and WhatsApp handoffs.",
  },
  {
    href: "/compare",
    label: "Compare",
    title: "VoluChat versus broad automation builders",
    text: "Compare focused ecommerce reply setup with larger chatbot and shared-inbox tools.",
  },
  {
    href: "/contact",
    label: "Demo",
    title: "Book a founder-led demo",
    text: "Review a live workflow and decide whether early access fits your store.",
  },
];

const { slug } = Astro.params;
const apiUrl = getBlogApiBaseUrl(import.meta.env);
const siteOrigin = Astro.site?.origin ?? "https://www.voluchat.com";
let blog = null;
let error: string | null = null;

try {
  blog = slug ? await fetchBlogPostBySlug(slug, { baseUrl: apiUrl }) : null;
} catch (e) {
  console.error(`[Server] Failed to fetch blog ${slug}:`, e);
  error = "The blog API is unreachable from the server. Check backend logs.";
}

if (!blog) {
  Astro.response.status = error ? 503 : 404;
}

const contentBlocks =
  blog?.content
    .split(/\n{2,}/)
    .map((block) => block.trim())
    .filter(Boolean) || [];

const renderedContentHtml = blog ? renderMarkdownToHtml(blog.content) : "";

const robots = [
  blog?.robotsIndex ? "index" : "noindex",
  blog?.robotsFollow ? "follow" : "nofollow",
].join(", ");

const blogKeywords = blog
  ? Array.from(
      new Set(
        [
          blog.focusKeyword,
          ...blog.keywords,
          ...blog.categories.map((category) => category.name),
          ...blog.tags.map((tag) => tag.name),
        ].filter(Boolean),
      ),
    ).join(", ") ||
    "Instagram DM automation, Facebook Page automation, ecommerce reply automation"
  : undefined;

const blogCanonicalUrl = blog
  ? new URL(blog.canonicalUrl || blog.href, siteOrigin).toString()
  : undefined;
const blogImageUrl = blog?.featuredImageUrl || "/og-image.webp";
const absoluteBlogImageUrl = new URL(blogImageUrl, siteOrigin).toString();
const structuredData = blog
  ? [
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: blog.title,
        description: blog.excerpt,
        image: absoluteBlogImageUrl,
        datePublished: blog.publishedAt || undefined,
        dateModified: blog.createdAt || blog.publishedAt || undefined,
        author: {
          "@type": "Person",
          name: blog.author.name,
        },
        publisher: {
          "@type": "Organization",
          name: "VoluChat",
          logo: {
            "@type": "ImageObject",
            url: new URL("/voluchat_logo.svg", siteOrigin).toString(),
          },
        },
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": blogCanonicalUrl,
        },
        keywords: blogKeywords,
        articleBody: contentBlocks.join("\n\n"),
      },
      ...(blog.faqs.length > 0
        ? [
            {
              "@context": "https://schema.org",
              "@type": "FAQPage",
              mainEntity: blog.faqs.map((faq) => ({
                "@type": "Question",
                name: faq.question,
                acceptedAnswer: {
                  "@type": "Answer",
                  text: faq.answer,
                },
              })),
            },
          ]
        : []),
      ...((() => {
        const headings = blog.content.match(/^##\s+(.+)$/gm) || [];
        const steps = headings
          .map((h) => h.replace(/^##\s+/, "").trim())
          .filter((h) => /step\s+\d|^\d+[\.\)]\s|how\s+to|setup|install|configure|create|build|deploy/i.test(h));
        if (steps.length < 2) return [];
        return [
          {
            "@context": "https://schema.org",
            "@type": "HowTo",
            name: blog.title,
            description: blog.excerpt,
            step: steps.map((step, i) => ({
              "@type": "HowToStep",
              position: i + 1,
              name: step,
            })),
          },
        ];
      })()),
    ]
  : [];
---

<Layout
  title={blog ? `${blog.seoTitle} | VoluChat Blog` : "Blog Post Not Found"}
  description={blog?.seoDescription ||
    "The requested VoluChat blog post is unavailable."}
  keywords={blogKeywords}
  image={blogImageUrl}
  type="article"
  robots={robots}
  canonical={blog?.canonicalUrl || blog?.href}
  author={blog?.author.name}
  publishedTime={blog?.publishedAt}
  modifiedTime={blog?.createdAt}
  tags={blog?.tags.map((tag) => tag.name) || []}
>
  {
    structuredData.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )
  }

  <Navbar />

  <main
    id="hero"
    class="relative overflow-hidden pt-32 pb-20 sm:pt-36"
  >
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_8%,rgba(83,111,159,0.08),transparent_30%),radial-gradient(circle_at_12%_72%,rgba(203,217,234,0.14),transparent_30%)]"
    >
    </div>
    <div class="ambient-noise"></div>

    {
      blog ? (
        <article class="blog-article mx-auto max-w-5xl px-5 sm:px-6">
          <div class="blog-post-header mx-auto mb-10 max-w-3xl text-center sm:mb-12">
            <a
              href="/blog"
              class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-teal-200 transition-colors hover:text-teal-100"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <line x1="19" y1="12" x2="5" y2="12" />
                  <polyline points="12 19 5 12 12 5" />
                </>
              </svg>
              Back to blog
            </a>

            {blog.categories.length > 0 && (
              <div class="mb-5 flex flex-wrap justify-center gap-2">
                {blog.categories.map((category) => (
                  <span class="chip">{category.name}</span>
                ))}
              </div>
            )}

            <h1 class="text-[2.55rem] font-semibold leading-[1.04] text-white sm:text-5xl lg:text-[3.65rem]">
              {blog.title}
            </h1>

            <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-300">
              {blog.excerpt}
            </p>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-4 text-sm text-slate-400">
              <div class="flex items-center gap-3">
                {blog.author.avatarUrl ? (
                  <img
                    src={blog.author.avatarUrl}
                    alt=""
                    class="h-10 w-10 rounded-full object-cover"
                    width="40"
                    height="40"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="grid h-10 w-10 place-items-center rounded-full bg-teal-500/20 font-semibold text-teal-200">
                    V
                  </div>
                )}
                <span class="font-semibold text-slate-100">
                  {blog.author.name}
                </span>
              </div>
              <span class="h-1 w-1 rounded-full bg-slate-600" />
              <time class="font-medium" datetime={blog.publishedAt}>
                {blog.dateLabel}
              </time>
            </div>
          </div>

          <div class="blog-post-image relative mx-auto mb-10 aspect-[16/8.5] max-w-4xl overflow-hidden rounded-[1.75rem] border border-white/10 bg-[#0b1526] shadow-[0_22px_70px_rgba(0,0,0,0.4)] sm:mb-12 lg:aspect-[21/9]">
            {blog.featuredImageUrl ? (
              <img
                src={blog.featuredImageUrl}
                alt={blog.featuredImageAlt}
                class="h-full w-full object-cover"
                width="1200"
                height="510"
                loading="eager"
                decoding="async"
              />
            ) : (
              <div class="blog-cover-fallback">
                <div>
                  <span class="mini-label text-teal-200">
                    VoluChat Field Notes
                  </span>
                  <p class="mt-5 max-w-2xl text-2xl font-semibold leading-tight text-white sm:text-4xl">
                    {blog.title}
                  </p>
                </div>
                <div class="blog-cover-mark" aria-hidden="true">
                  V
                </div>
              </div>
            )}
          </div>

          {blog.excerpt && (
            <div class="blog-tldr mx-auto mb-10 max-w-3xl rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8">
              <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-emerald-400 font-mono mb-3">TL;DR</p>
              <p class="text-base font-medium leading-relaxed text-slate-200">
                {blog.excerpt}
              </p>
            </div>
          )}

          <div class="blog-prose-shell">
            <div class="blog-prose" set:html={renderedContentHtml} />
          </div>

          {blog.faqs.length > 0 && (
            <section class="mx-auto mt-12 max-w-3xl sm:mt-14">
              <h2 class="mb-6 text-3xl font-semibold text-white">FAQs</h2>
              <div class="space-y-4">
                {blog.faqs.map((faq) => (
                  <details class="rounded-[1.75rem] border border-white/10 bg-[#0c1728] p-6">
                    <summary class="cursor-pointer font-semibold text-white">
                      {faq.question}
                    </summary>
                    <p class="mt-4 leading-relaxed text-slate-300">
                      {faq.answer}
                    </p>
                  </details>
                ))}
              </div>
            </section>
          )}

          <section class="mx-auto mt-14 max-w-4xl">
            <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="section-eyebrow">Related paths</p>
                <h2 class="mt-3 text-3xl font-semibold text-white">
                  Keep exploring VoluChat
                </h2>
              </div>
            </div>
            <div class="grid gap-4 md:grid-cols-3">
              {relatedLinks.map((link) => (
                <a
                  href={link.href}
                  class="rounded-[1.75rem] border border-white/10 bg-[#0c1728] group p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-teal-300/20 hover:bg-teal-300/[0.06]"
                >
                  <span class="mini-label">{link.label}</span>
                  <h3 class="mt-3 text-lg font-semibold text-white transition-colors group-hover:text-teal-200">
                    {link.title}
                  </h3>
                  <p class="mt-3 text-sm font-medium leading-relaxed text-slate-300">
                    {link.text}
                  </p>
                </a>
              ))}
            </div>
          </section>
        </article>
      ) : (
        <div class="mx-auto max-w-3xl px-6 py-20 text-center">
          <h1 class="mb-4 text-3xl font-semibold text-white">Post not found</h1>
          <p class="mb-8 text-slate-300">
            {error ||
              "The blog post you're looking for doesn't exist or is currently unavailable."}
          </p>
          <a href="/blog" class="btn-primary">
            Back to blog
          </a>
        </div>
      )
    }
  </main>

  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const tl = gsap.timeline();
    tl.fromTo(".blog-post-header",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" }
    ).fromTo(".blog-post-image",
      { opacity: 0, scale: 0.95 },
      { opacity: 1, scale: 1, duration: 1, ease: "power3.out" },
      "-=0.5"
    ).fromTo(".blog-tldr",
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
      "-=0.4"
    ).fromTo(".blog-prose-shell",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" },
      "-=0.4"
    );
  });
</script>
