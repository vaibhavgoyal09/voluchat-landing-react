---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { fetchBlogPostBySlug, getBlogApiBaseUrl } from '../../lib/blogApi.mjs';

const { slug } = Astro.params;
const apiUrl = getBlogApiBaseUrl(import.meta.env);
let blog = null;
let error: string | null = null;

try {
  blog = slug ? await fetchBlogPostBySlug(slug, { baseUrl: apiUrl }) : null;
} catch (e) {
  console.error(`[Server] Failed to fetch blog ${slug}:`, e);
  error = 'The blog API is unreachable from the server. Check backend logs.';
}

if (!blog) {
  Astro.response.status = error ? 503 : 404;
}

const contentBlocks = blog?.content
  .split(/\n{2,}/)
  .map((block) => block.trim())
  .filter(Boolean) || [];

const robots = [
  blog?.robotsIndex ? 'index' : 'noindex',
  blog?.robotsFollow ? 'follow' : 'nofollow',
].join(', ');
---

<Layout
  title={blog ? `${blog.seoTitle} | VoluChat Blog` : 'Blog Post Not Found'}
  description={blog?.seoDescription || 'The requested VoluChat blog post is unavailable.'}
  image={blog?.featuredImageUrl || '/og-image.webp'}
  type="article"
  robots={robots}
>
  <Header />

  <main class="relative overflow-hidden pt-36 pb-20 animate-page-entry opacity-0 sm:pt-40">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_8%,rgba(83,111,159,0.1),transparent_30%),radial-gradient(circle_at_12%_72%,rgba(203,217,234,0.18),transparent_30%)]"></div>
    <div class="ambient-noise"></div>

    {blog ? (
      <article class="mx-auto max-w-4xl px-6">
        <div class="mb-12 text-center">
          <a href="/blog" class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-primary-700 transition-colors hover:text-primary-900">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Back to blog
          </a>

          {blog.categories.length > 0 && (
            <div class="mb-5 flex flex-wrap justify-center gap-2">
              {blog.categories.map((category) => (
                <span class="chip">{category.name}</span>
              ))}
            </div>
          )}

          <h1 class="text-4xl font-semibold leading-[1.05] text-stone-950 md:text-5xl lg:text-6xl">
            {blog.title}
          </h1>

          <div class="mt-8 flex flex-wrap items-center justify-center gap-5 text-stone-500">
            <div class="flex items-center gap-3">
              {blog.author.avatarUrl ? (
                <img src={blog.author.avatarUrl} alt="" class="h-10 w-10 rounded-full object-cover" width="40" height="40" loading="lazy" decoding="async" />
              ) : (
                <div class="grid h-10 w-10 place-items-center rounded-full bg-primary-50 font-semibold text-primary-700">V</div>
              )}
              <span class="font-semibold text-stone-900">{blog.author.name}</span>
            </div>
            <span class="h-1 w-1 rounded-full bg-stone-300"></span>
            <time class="font-medium" datetime={blog.publishedAt}>{blog.dateLabel}</time>
          </div>
        </div>

        <div class="solid-card relative mb-14 aspect-[21/9] overflow-hidden p-0">
          {blog.featuredImageUrl ? (
            <img src={blog.featuredImageUrl} alt={blog.featuredImageAlt} class="h-full w-full object-cover" loading="eager" decoding="async" />
          ) : (
            <>
              <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(83,111,159,0.12),rgba(255,255,255,0.6),rgba(203,217,234,0.16))]"></div>
              <div class="absolute inset-0 flex items-center justify-center text-primary-200">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
              </div>
            </>
          )}
        </div>

        <div class="solid-card p-6 shadow-none md:p-10">
          {contentBlocks.map((block) => {
            if (block.startsWith('# ')) {
              return <h2 class="mt-10 mb-5 text-3xl font-semibold text-stone-950">{block.replace(/^#\s+/, '')}</h2>;
            }

            if (block.startsWith('## ')) {
              return <h2 class="mt-10 mb-5 text-3xl font-semibold text-stone-950">{block.replace(/^##\s+/, '')}</h2>;
            }

            if (/^\d+\.\s/.test(block)) {
              return (
                <ol class="mb-6 list-decimal space-y-2 pl-6 text-lg leading-relaxed text-stone-600">
                  {block.split('\n').map((item) => (
                    <li>{item.replace(/^\d+\.\s/, '')}</li>
                  ))}
                </ol>
              );
            }

            if (/^-\s/.test(block)) {
              return (
                <ul class="mb-6 list-disc space-y-2 pl-6 text-lg leading-relaxed text-stone-600">
                  {block.split('\n').map((item) => (
                    <li>{item.replace(/^-\s/, '')}</li>
                  ))}
                </ul>
              );
            }

            return <p class="mb-6 text-lg leading-relaxed text-stone-600">{block}</p>;
          })}
        </div>

        {blog.faqs.length > 0 && (
          <section class="mt-14">
            <h2 class="mb-6 text-3xl font-semibold text-stone-950">FAQs</h2>
            <div class="space-y-4">
              {blog.faqs.map((faq) => (
                <details class="solid-card p-6">
                  <summary class="cursor-pointer font-semibold text-stone-950">{faq.question}</summary>
                  <p class="mt-4 leading-relaxed text-stone-600">{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <div class="mt-20 border-t border-white/55 pt-10">
          <div class="solid-card p-8 text-center">
            <h4 class="text-2xl font-heading font-semibold text-stone-950">See how VoluChat works for ecommerce stores</h4>
            <p class="mx-auto mt-4 max-w-xl font-medium leading-relaxed text-stone-600">Book a demo call to see how repeated product questions can become faster replies and cleaner sales-team handoffs.</p>
            <a href="/contact" class="btn-primary mt-8">Book demo call</a>
          </div>
        </div>
      </article>
    ) : (
      <div class="mx-auto max-w-3xl px-6 py-20 text-center">
        <h1 class="mb-4 text-3xl font-semibold text-stone-950">Post not found</h1>
        <p class="mb-8 text-stone-600">{error || "The blog post you're looking for doesn't exist or is currently unavailable."}</p>
        <a href="/blog" class="btn-primary">Back to blog</a>
      </div>
    )}
  </main>

  <Footer />
</Layout>
