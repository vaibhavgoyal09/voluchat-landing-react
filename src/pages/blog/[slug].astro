---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { fetchBlogPostBySlug, getBlogApiBaseUrl } from '../../lib/blogApi.mjs';

const { slug } = Astro.params;
const apiUrl = getBlogApiBaseUrl(import.meta.env);
let blog = null;
let error: string | null = null;

try {
  blog = slug ? await fetchBlogPostBySlug(slug, { baseUrl: apiUrl }) : null;
} catch (e) {
  console.error(`[Server] Failed to fetch blog ${slug}:`, e);
  error = 'The blog API is unreachable from the server. Check backend logs.';
}

if (!blog) {
  Astro.response.status = error ? 503 : 404;
}

const contentBlocks = blog?.content
  .split(/\n{2,}/)
  .map((block) => block.trim())
  .filter(Boolean) || [];

const robots = [
  blog?.robotsIndex ? 'index' : 'noindex',
  blog?.robotsFollow ? 'follow' : 'nofollow',
].join(', ');
---

<Layout
  title={blog ? `${blog.seoTitle} | VoluChat Blog` : 'Blog Post Not Found'}
  description={blog?.seoDescription || 'The requested VoluChat blog post is unavailable.'}
  image={blog?.featuredImageUrl || '/og-image.png'}
  type="article"
  robots={robots}
>
  <Header />

  <main class="relative pt-32 pb-20 overflow-hidden animate-page-entry opacity-0">
    {blog ? (
    <article class="container-wide px-6 max-w-4xl mx-auto">
      <div class="mb-12 text-center">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 mb-8 group">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:-translate-x-1"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Back to Blog
        </a>

        {blog.categories.length > 0 && (
          <div class="mb-5 flex flex-wrap justify-center gap-2">
            {blog.categories.map((category) => (
              <span class="section-badge">{category.name}</span>
            ))}
          </div>
        )}

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 mb-8 tracking-tight leading-tight">
          {blog.title}
        </h1>

        <div class="flex flex-wrap items-center justify-center gap-5 text-slate-500">
          <div class="flex items-center gap-3">
            {blog.author.avatarUrl ? (
              <img src={blog.author.avatarUrl} alt="" class="h-10 w-10 rounded-full object-cover" />
            ) : (
              <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center font-bold text-indigo-600">V</div>
            )}
            <span class="font-bold text-slate-900">{blog.author.name}</span>
          </div>
          <span class="w-1 h-1 rounded-full bg-slate-300"></span>
          <time class="font-medium" datetime={blog.publishedAt}>{blog.dateLabel}</time>
        </div>
      </div>

      <div class="glass-panel-premium relative aspect-[21/9] rounded-2xl overflow-hidden mb-16">
        {blog.featuredImageUrl ? (
          <img
            src={blog.featuredImageUrl}
            alt={blog.featuredImageAlt}
            class="h-full w-full object-cover"
          />
        ) : (
          <>
            <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/20 via-cyan-400/10 to-emerald-400/20"></div>
            <div class="absolute inset-0 flex items-center justify-center text-slate-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
            </div>
          </>
        )}
      </div>

      <div class="glass-panel-premium rounded-3xl p-8 md:p-12 prose prose-slate prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-indigo-600 prose-img:rounded-3xl shadow-none">
        {contentBlocks.map((block) => {
          if (block.startsWith('# ')) {
            return <h2 class="text-3xl font-bold text-slate-900 mt-12 mb-6">{block.replace(/^#\s+/, '')}</h2>;
          }

          if (block.startsWith('## ')) {
            return <h2 class="text-3xl font-bold text-slate-900 mt-12 mb-6">{block.replace(/^##\s+/, '')}</h2>;
          }

          if (/^\d+\.\s/.test(block)) {
            return (
              <ol class="list-decimal pl-6 text-slate-600 leading-relaxed text-lg mb-6">
                {block.split('\n').map((item) => (
                  <li>{item.replace(/^\d+\.\s/, '')}</li>
                ))}
              </ol>
            );
          }

          if (/^-\s/.test(block)) {
            return (
              <ul class="list-disc pl-6 text-slate-600 leading-relaxed text-lg mb-6">
                {block.split('\n').map((item) => (
                  <li>{item.replace(/^-\s/, '')}</li>
                ))}
              </ul>
            );
          }

          return <p class="text-slate-600 leading-relaxed text-lg mb-6">{block}</p>;
        })}
      </div>

      {blog.faqs.length > 0 && (
        <section class="mt-14">
          <h2 class="text-3xl font-bold text-slate-900 mb-6">FAQs</h2>
          <div class="space-y-4">
            {blog.faqs.map((faq) => (
              <details class="glass-card-premium rounded-2xl p-6">
                <summary class="cursor-pointer font-bold text-slate-900">{faq.question}</summary>
                <p class="mt-4 text-slate-600 leading-relaxed">{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <div class="mt-20 pt-10 border-t border-white/55">
        <div class="glass-card-premium p-8 rounded-3xl text-center">
          <h4 class="text-2xl font-heading font-black text-slate-950 mb-4 tracking-tight">See how VoluChat works for your boutique</h4>
          <p class="text-slate-600 font-medium mb-8">Start a 14-day trial to see how Instagram comments can become helpful DMs and clearer WhatsApp chats.</p>
          <a href="/contact" class="group relative inline-flex items-center justify-center gap-3 px-8 py-4 bg-zinc-950 text-white rounded-2xl font-black text-sm transition-all duration-300 hover:scale-[1.03] hover:bg-blue-600 shadow-2xl hover:shadow-blue-500/25 overflow-hidden">
            <span class="relative z-10">Start 14-day free trial</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="relative z-10 transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
          </a>
        </div>
      </div>
    </article>
    ) : (
      <div class="container-wide px-6 py-20 text-center">
        <h1 class="text-3xl font-bold text-slate-900 mb-4">Post Not Found</h1>
        <p class="text-slate-600 mb-8">{error || "The blog post you're looking for doesn't exist or is currently unavailable."}</p>
        <a href="/blog" class="btn-primary">Back to Blog</a>
      </div>
    )}
  </main>

  <Footer />
</Layout>
