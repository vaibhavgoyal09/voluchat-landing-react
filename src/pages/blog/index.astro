---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import BlogCard from "../../components/BlogCard.astro";
import {
  fetchPublishedBlogPosts,
  getBlogApiBaseUrl,
} from "../../lib/blogApi.mjs";

const seoTitle = "VoluChat Blog | WhatsApp & Instagram Sales Guides";
const seoDescription =
  "Guides on WhatsApp and Instagram DM e-commerce automation: upsells, cross-sells, cart recovery, in-chat checkout, and D2C sales strategies.";
const seoKeywords =
  "WhatsApp e-commerce automation guide, Instagram DM sales tips, cart recovery strategy, D2C automation blog, upsell cross-sell guide";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: seoTitle,
  description: seoDescription,
  url: siteUrl,
};
const apiUrl = getBlogApiBaseUrl(import.meta.env);
let blogs: any = [];
let error: string | null = null;

try {
  blogs = await fetchPublishedBlogPosts({ baseUrl: apiUrl, limit: 12 });
} catch (e) {
  console.error(`[Server] Failed to fetch blogs:`, e);
  error = "The blog API is unreachable from the server. Check backend logs.";
}
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/blog", siteUrl).toString()}
  structuredData={structuredData}
>
  <Navbar />

  <main class="min-h-screen overflow-hidden bg-[#000000]">
    <section class="hero-stripe pb-14">
      <div class="section-glow-emerald"></div>
      <div class="sect-grid opacity-20"></div>

      <div class="page-shell">
        <div class="blog-hero-text mx-auto max-w-3xl text-center">
          <div class="chip mb-4">
            <span class="mini-label">Guides</span>
          </div>
          <h1
            class="mt-6 text-4xl font-semibold leading-[1.03] text-[#fcfdff] sm:text-6xl font-heading"
          >
            Ecommerce sales team automation guides.
          </h1>
          <p class="section-copy mx-auto mt-5 max-w-2xl">
            Learn how to answer repeated product questions faster, reduce
            duplicate manual replies, and prepare cleaner handoffs for your sales
            team.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-24 bg-[#000000]">
      <div class="page-shell">
        {
          error && (
            <div class="mb-12 solid-card p-6 text-center text-sm font-medium text-slate-300">
              {error}
            </div>
          )
        }

        <div class="blog-grid grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {blogs.map((blog: any) => <BlogCard blog={blog} />)}
        </div>

        {
          blogs.length === 0 && (
            <div class="py-20 text-center">
              <p class="font-normal text-slate-500">No blog posts found yet.</p>
            </div>
          )
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const tl = gsap.timeline();
    tl.fromTo(".blog-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    ).fromTo(".blog-grid",
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" },
      "-=0.5"
    );
  });
</script>
