---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import BlogCard from "../../components/BlogCard.astro";
import {
  fetchPublishedBlogPosts,
  getBlogApiBaseUrl,
} from "../../lib/blogApi.mjs";

const seoTitle = "VoluChat Blog | Ecommerce sales team automation guides";
const seoDescription =
  "Guides for ecommerce sales teams that want faster product replies across Instagram, Facebook Pages, and WhatsApp workflows.";
const seoKeywords =
  "Shopify AI blog, ecommerce automation guides, sales team automation, Shopify product replies, AI commerce guides";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: seoTitle,
  description: seoDescription,
  url: siteUrl,
};
const apiUrl = getBlogApiBaseUrl(import.meta.env);
let blogs: any = [];
let error: string | null = null;

try {
  blogs = await fetchPublishedBlogPosts({ baseUrl: apiUrl, limit: 12 });
} catch (e) {
  console.error(`[Server] Failed to fetch blogs:`, e);
  error = "The blog API is unreachable from the server. Check backend logs.";
}
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/blog", siteUrl).toString()}
  structuredData={structuredData}
>
  <Navbar />

  <main
    class="relative min-h-screen overflow-hidden pt-36 pb-20 sm:pt-40"
  >
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_82%_10%,rgba(83,111,159,0.12),transparent_30%),radial-gradient(circle_at_10%_68%,rgba(203,217,234,0.22),transparent_28%)]"
    >
    </div>
    <div class="ambient-noise"></div>

    <div class="page-shell">
      <div class="blog-hero-text opacity-0 mx-auto mb-16 max-w-3xl text-center">
        <div class="chip">Guides</div>
        <h1
          class="mt-6 text-4xl font-semibold leading-[1.03] text-white sm:text-6xl"
        >
          Ecommerce sales team automation guides.
        </h1>
        <p class="section-copy mx-auto mt-5 max-w-2xl">
          Learn how to answer repeated product questions faster, reduce
          duplicate manual replies, and prepare cleaner handoffs for your sales
          team.
        </p>
      </div>

      {
        error && (
          <div class="mb-12 rounded-[1.75rem] border border-white/10 bg-[#101b2e] p-6 text-center text-sm font-semibold text-slate-200">
            {error}
          </div>
        )
      }

      <div class="blog-grid opacity-0 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {blogs.map((blog: any) => <BlogCard blog={blog} />)}
      </div>

      {
        blogs.length === 0 && (
          <div class="py-20 text-center">
            <p class="font-medium text-slate-400">No blog posts found yet.</p>
          </div>
        )
      }
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const tl = gsap.timeline();
    tl.fromTo(".blog-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    ).fromTo(".blog-grid",
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" },
      "-=0.5"
    );
  });
</script>
