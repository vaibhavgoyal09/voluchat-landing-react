---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { fetchPublishedBlogPosts, getBlogApiBaseUrl } from '../../lib/blogApi.mjs';

const apiUrl = getBlogApiBaseUrl(import.meta.env);
let blogs: any = [];
let error: string | null = null;

try {
  blogs = await fetchPublishedBlogPosts({ baseUrl: apiUrl, limit: 12 });
} catch (e) {
  console.error(`[Server] Failed to fetch blogs:`, e);
  error = 'The blog API is unreachable from the server. Check backend logs.';
}
---

<Layout title="VoluChat Blog | Ecommerce sales team automation guides" description="Guides for ecommerce sales teams that want faster product replies across Instagram, Facebook Pages, and WhatsApp workflows.">
  <Header />

  <main class="relative min-h-screen overflow-hidden pt-36 pb-20 animate-page-entry opacity-0 sm:pt-40">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_82%_10%,rgba(83,111,159,0.12),transparent_30%),radial-gradient(circle_at_10%_68%,rgba(203,217,234,0.22),transparent_28%)]"></div>
    <div class="ambient-noise"></div>

    <div class="page-shell">
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <div class="chip">Guides</div>
        <h1 class="mt-6 text-4xl font-semibold leading-[1.03] text-stone-950 sm:text-6xl">
          Ecommerce sales team automation guides.
        </h1>
        <p class="section-copy mx-auto mt-5 max-w-2xl">
          Learn how to answer repeated product questions faster, reduce duplicate manual replies, and prepare cleaner handoffs for your sales team.
        </p>
      </div>

      {error && (
        <div class="glass-card-premium mb-12 rounded-2xl p-6 text-center text-sm font-semibold text-stone-700">
          {error}
        </div>
      )}

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {blogs.map((blog: any) => (
          <BlogCard blog={blog} />
        ))}
      </div>

      {blogs.length === 0 && (
        <div class="py-20 text-center">
          <p class="font-medium text-stone-400">No blog posts found yet.</p>
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>
