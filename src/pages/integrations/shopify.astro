---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import { getFaqSchema } from "../../lib/faqSchema.mjs";

const seoTitle = "Shopify Integration — WhatsApp AI Sales | VoluChat";
const seoDescription =
  "Connect Shopify to VoluChat for live variant stock checks, automated draft orders, and delivery pincode validation inside WhatsApp chats.";
const seoKeywords =
  "Shopify WhatsApp integration, Shopify Instagram DM automation, Shopify live inventory sync, WhatsApp checkout Shopify, Shopify draft order automation";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/integrations/shopify`,
};

const readsFromShopify = [
  {
    title: "Live Variant Inventory",
    description: "Real-time stock count for every size, color, and material variant. The AI never confirms availability for an out-of-stock item.",
  },
  {
    title: "Product Pricing & SKUs",
    description: "Accurate pricing pulled from your Shopify admin — including compare-at prices, discounts, and variant-specific pricing rules.",
  },
  {
    title: "Fabric & Material Details",
    description: "Product descriptions, material composition, and care instructions — used to answer sizing and fabric questions without hallucinations.",
  },
  {
    title: "Delivery Pincode SLA",
    description: "Checks whether a courier can deliver to a specific Indian pincode and confirms estimated transit time before the buyer asks.",
  },
  {
    title: "Order Status & Tracking",
    description: "Reads existing order data to provide instant tracking lookups — no more 'let me check with the team' responses.",
  },
];

const createsInShopify = [
  {
    title: "Draft Orders with Pre-Populated SKUs",
    description: "When a buyer confirms their selection in WhatsApp, VoluChat creates a Shopify draft order with customer details, variant info, and pricing — ready for payment.",
  },
  {
    title: "1-Click UPI Payment Links",
    description: "Generates a Razorpay or Cashfree payment link embedded in the draft order, sent directly in the WhatsApp conversation for instant checkout.",
  },
  {
    title: "Order Confirmation Sync",
    description: "Once payment is completed, the order status updates in Shopify admin. Your fulfillment team sees it instantly — no manual data entry.",
  },
];

const flowSteps = [
  {
    step: "1",
    title: "Customer comments or DMs",
    description: "A shopper comments 'Price?' on your Instagram Reel or messages your WhatsApp at 11 PM.",
  },
  {
    step: "2",
    title: "VoluChat reads your Shopify catalog",
    description: "Instantly checks variant stock, pricing, pincode SLA, and fabric details from your live Shopify store.",
  },
  {
    step: "3",
    title: "AI qualifies and recommends",
    description: "Asks about size preference, budget, and delivery pincode — then recommends the right variant with exact pricing.",
  },
  {
    step: "4",
    title: "Draft order created in Shopify",
    description: "Creates a draft order with pre-populated SKUs, customer details, and pricing in your Shopify admin.",
  },
  {
    step: "5",
    title: "UPI link sent in WhatsApp",
    description: "Buyer receives a 1-click payment link in the chat, completes payment, and gets order confirmation — all in 90 seconds.",
  },
];

const guardrails = [
  {
    title: "Read-Only by Default",
    description: "VoluChat only reads catalog and order data. It never modifies your products, pricing, or inventory settings without explicit approval.",
  },
  {
    title: "Zero Hallucination Design",
    description: "Every product answer is grounded in live Shopify data. The AI never guesses pricing, stock, or delivery timelines.",
  },
  {
    title: "Catalog Isolation",
    description: "Each pilot store has an isolated catalog connection. Your data is never mixed with other merchants' data.",
  },
  {
    title: "Margin Floor & Ceiling",
    description: "Hardcoded limits prevent the AI from offering discounts below your minimum margin or above your maximum discount threshold.",
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/integrations/shopify", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="overflow-hidden">
    <section class="hero-stripe text-left">
      <div class="section-glow-emerald"></div>
      <div class="sect-grid opacity-20"></div>

      <div class="page-shell">
        <div class="int-hero-text max-w-4xl">
          <div class="chip mb-5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 mr-1.5"></span>
            Shopify &bull; Meta Architecture
          </div>
          <h1
            class="max-w-3xl text-4xl font-semibold leading-[1.02] text-[#fcfdff] sm:text-6xl lg:text-7xl font-heading"
          >
            Your Shopify Store, Powering Every WhatsApp Conversation.
          </h1>
          <p class="section-copy mt-6 max-w-2xl">
            VoluChat reads your live Shopify catalog — variant stock, pricing, fabric details, pincode SLA — and writes draft orders with UPI checkout links directly inside WhatsApp and Instagram DMs.
          </p>
          <p class="mt-4 max-w-xl text-sm font-normal leading-relaxed text-slate-500">
            <strong class="text-slate-400">What is this integration?</strong> A real-time bridge between your Shopify store and VoluChat's e-commerce automation agent — ensuring every answer in chat is accurate, every stock check is live, and every order syncs back to your admin.
          </p>
          <div class="mt-8 flex flex-col gap-3.5 sm:flex-row">
            <a href="/free-trial" class="btn-primary">Start 30-Day Free Trial &rarr;</a>
            <a href="/security" class="btn-secondary">Review Brand Guardrails</a>
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24 bg-[#000000]">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl">
          <h2 class="section-eyebrow mb-2">How the integration works</h2>
          <p class="section-copy mb-8 max-w-2xl">5 steps. 90 seconds. No website hopping.</p>
          <!-- Kid-simple visual flow: comment → Shopify → chat → order → pay -->
          <div class="visual-frame mb-8 flex items-center justify-between gap-2 overflow-x-auto text-center">
            <div class="min-w-[90px]"><p class="text-2xl">💬</p><p class="mt-1 text-xs text-white font-semibold">Comment</p></div>
            <span class="text-[#86868b]">→</span>
            <div class="min-w-[90px]"><p class="text-2xl">🛍️</p><p class="mt-1 text-xs text-white font-semibold">Shopify check</p></div>
            <span class="text-[#86868b]">→</span>
            <div class="min-w-[90px]"><p class="text-2xl">📏</p><p class="mt-1 text-xs text-white font-semibold">Size fit</p></div>
            <span class="text-[#86868b]">→</span>
            <div class="min-w-[90px]"><p class="text-2xl">🧾</p><p class="mt-1 text-xs text-white font-semibold">Draft order</p></div>
            <span class="text-emerald-400">→</span>
            <div class="min-w-[90px]"><p class="text-2xl">💚</p><p class="mt-1 text-xs font-semibold text-emerald-300">UPI paid</p></div>
          </div>
          <div class="space-y-0">
            {flowSteps.map((item) => (
              <article class="shopify-flow-step opacity-0 hairline-row flex gap-5 !py-5">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/[0.14] bg-transparent text-sm font-mono font-bold text-white">
                  {item.step}
                </div>
                <div>
                  <h3 class="text-lg font-heading font-semibold text-white">{item.title}</h3>
                  <p class="mt-1.5 text-sm font-normal leading-relaxed text-[#86868b]">{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24 bg-[#000000]">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl grid gap-10 lg:grid-cols-2">
          <div>
            <h2 class="section-eyebrow mb-6">Reads from your Shopify store</h2>
            <div class="space-y-0">
              {readsFromShopify.map((item) => (
                <article class="shopify-card opacity-0 hairline-row !py-4">
                  <h3 class="text-base font-heading font-semibold text-white">↓ {item.title}</h3>
                  <p class="mt-1 text-sm font-normal leading-relaxed text-[#86868b]">{item.description}</p>
                </article>
              ))}
            </div>
          </div>
          <div>
            <h2 class="section-eyebrow mb-6">Creates in your Shopify admin</h2>
            <div class="visual-frame !p-5 space-y-0">
              {createsInShopify.map((item) => (
                <article class="shopify-card opacity-0 border-t border-white/[0.08] py-4 first:border-0 first:pt-0 last:pb-0">
                  <h3 class="text-base font-heading font-semibold text-white">↑ {item.title}</h3>
                  <p class="mt-1 text-sm font-normal leading-relaxed text-[#86868b]">{item.description}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24 bg-[#000000]">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl">
          <h2 class="section-eyebrow mb-6">Security & guardrails</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {guardrails.map((item) => (
              <article class="shopify-guardrail opacity-0 solid-card p-5 md:p-6">
                <h3 class="text-base font-heading font-semibold text-[#fcfdff]">{item.title}</h3>
                <p class="mt-2 text-sm font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24 bg-[#000000]">
      <div class="page-shell text-center">
        <h2 class="section-title text-[#fcfdff]">Ready to connect your Shopify store?</h2>
        <p class="section-copy mx-auto mt-4 max-w-2xl">
          Get 30 days free with 100% done-for-you setup. We handle the Shopify catalog integration, Meta API configuration, and brand voice calibration — you start selling immediately.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3.5 sm:flex-row">
          <a href="/free-trial" class="btn-primary">Start 30-Day Free Trial &rarr;</a>
          <a
            href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary inline-flex items-center gap-2"
          >
            💬 Test Drive the Bot on WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    gsap.fromTo(".int-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    gsap.utils.toArray<HTMLElement>(".shopify-flow-step, .shopify-card, .shopify-guardrail").forEach((el) => {
      gsap.fromTo(el,
        { opacity: 0, y: 20 },
        {
          opacity: 1,
          y: 0,
          duration: 0.4,
          ease: "power2.out",
          scrollTrigger: {
            trigger: el,
            start: "top 90%",
            toggleActions: "play none none reverse",
          },
        }
      );
    });
  });
</script>
