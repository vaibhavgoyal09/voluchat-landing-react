---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lastUpdated = "April 4, 2026";

const sections = [
  {
    title: "1. Acceptance of terms",
    body: "By accessing or using VoluChat, you agree to these Terms and Conditions. If you do not agree, you may not use the service."
  },
  {
    title: "2. Description of service",
    body: "VoluChat provides ecommerce reply automation for repeated product questions, connected social channels, catalog context, and sales-team handoff workflows."
  },
  {
    title: "3. User obligations",
    body: "You are responsible for providing accurate account information, maintaining account security, reviewing automated responses, and using VoluChat in compliance with applicable laws and platform policies."
  },
  {
    title: "4. Data storage and usage",
    body: "To provide the service, VoluChat may store authorized access tokens, product context, comments, messages, and handoff data needed to process replies and improve workflows."
  },
  {
    title: "5. Disclaimer of warranties",
    body: "The service is provided on an as-is and as-available basis. We do not guarantee uninterrupted operation, error-free automation, or any specific sales outcome."
  },
  {
    title: "6. Limitation of liability",
    body: "VoluChat, its directors, employees, and agents are not liable for indirect, incidental, special, consequential, or punitive damages resulting from access to or use of the service."
  },
  {
    title: "7. Termination",
    body: "We may suspend or terminate access if these terms are breached or if continued access creates operational, legal, or platform-policy risk."
  },
  {
    title: "8. Governing law",
    body: "These terms are governed by the laws of India, without regard to conflict of law provisions."
  }
];
---

<Layout title="Terms & Conditions | VoluChat" description="VoluChat terms for ecommerce reply automation, connected social channels, and product conversation workflows.">
  <Header />

  <main class="relative overflow-hidden pt-36 pb-24 animate-page-entry opacity-0 sm:pt-40">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_82%_16%,rgba(83,111,159,0.1),transparent_30%),radial-gradient(circle_at_14%_70%,rgba(203,217,234,0.18),transparent_30%)]"></div>
    <div class="ambient-noise"></div>

    <div class="mx-auto max-w-4xl px-6">
      <div class="mb-12">
        <div class="chip">Legal</div>
        <h1 class="mt-6 text-4xl font-semibold text-stone-950 md:text-5xl">Terms & Conditions</h1>
        <p class="mt-4 font-medium text-stone-500">Last updated: {lastUpdated}</p>
      </div>

      <div class="glass-panel-premium rounded-[2rem] p-6 text-stone-600 md:p-10">
        <div class="space-y-8">
          {sections.map((section) => (
            <section>
              <h2 class="mb-3 text-2xl font-heading font-semibold text-stone-950">{section.title}</h2>
              <p class="leading-relaxed">{section.body}</p>
            </section>
          ))}

          <section>
            <h2 class="mb-3 text-2xl font-heading font-semibold text-stone-950">9. Contact us</h2>
            <p class="leading-relaxed">
              If you have questions about these Terms, contact us at <a href="mailto:support@voluchat.com" class="font-semibold text-primary-700 hover:underline">support@voluchat.com</a>.
            </p>
          </section>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
