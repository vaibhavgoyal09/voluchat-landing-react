---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PricingSection from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';

const seoTitle = "Founder-Led Pilot Pricing for D2C Sales Workflows | VoluChat";
const seoDescription = "See VoluChat pilot pricing for growing D2C teams that need custom AI sales workflows, catalog-aware replies, and clean WhatsApp handoffs.";
---

<Layout title={seoTitle} description={seoDescription}>
  <Header />

  <main class="animate-page-entry opacity-0">
    <section class="relative overflow-hidden pt-36 pb-12 sm:pt-40 lg:pb-16">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_14%,rgba(83,111,159,0.12),transparent_32%),linear-gradient(180deg,rgba(255,255,255,0.9),rgba(247,249,252,0.86))]"></div>
      <div class="ambient-noise"></div>

      <div class="page-shell text-center">
        <div class="mx-auto max-w-4xl">
          <div class="chip">Founder-led pilot pricing</div>
          <h1 class="mt-6 text-4xl font-semibold leading-[1.02] text-stone-950 sm:text-6xl lg:text-7xl">
            Launch a custom sales workflow with clear pilot pricing.
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-2xl">
            Book a demo call to map one high-value D2C sales workflow, then launch at Rs. 5,000 setup and Rs. 3,000/month with a 30-day money-back guarantee.
          </p>
        </div>
      </div>
    </section>

    <PricingSection />
    <FAQ />
  </main>

  <Footer />
</Layout>
