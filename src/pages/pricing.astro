---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "VoluChat Pricing — 30-Day Free Trial & Done-For-You Setup";
const seoDescription =
  "Claim a 30-day free trial of VoluChat with 100% done-for-you setup for fashion boutiques. Includes live Shopify catalog sync, sizing qualification, and WhatsApp UPI checkout.";
const seoKeywords =
  "VoluChat pricing, fashion WhatsApp automation free trial, boutique AI sales stylist pricing, size chart AI agent setup";
const siteUrl = "https://www.voluchat.com";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: seoTitle,
    description: seoDescription,
    url: `${siteUrl}/pricing`,
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "VoluChat 30-Day Free Trial & Setup",
    description: "Done-for-you AI sales stylist setup for fashion & boutique brands. Includes Meta Cloud API configuration, WhatsApp Business API, catalog & size chart sync, upsells, cross-sells, and brand voice guardrails with 30 days free.",
    provider: {
      "@type": "Organization",
      name: "VoluChat",
      url: siteUrl,
    },
    areaServed: {
      "@type": "Country",
      name: "India",
    },
    serviceType: "Autonomous Fashion AI Sales Stylist Setup",
  },
];

const pilotIncludes = [
  {
    icon: "⚙️",
    title: "Official Meta & WhatsApp Cloud API Setup",
    text: "Zero developer work needed from you. We configure your official Meta verified number, webhooks, and catalog permissions directly.",
  },
  {
    icon: "👗",
    title: "Catalog, Size Charts & Live Stock Sync",
    text: "Real-time variant stock reading (S-XXL), sizing chart rules, and automatic draft order creation with tracking sync.",
  },
  {
    icon: "⚡",
    title: "Instagram Comment-to-DM Trigger Engine",
    text: "Automated 2-second personalized DM responses for comments across your viral Instagram Reels and Meta Ads.",
  },
  {
    icon: "💳",
    title: "Native In-Chat UPI & 1-Click Payment Link",
    text: "Enables customers to complete prepaid purchases directly inside WhatsApp without bouncing to an external browser checkout.",
  },
  {
    icon: "🛡️",
    title: "Strict Brand Voice & Margin Guardrails",
    text: "Pre-set maximum discount ceilings, COD verification rules, and automated human handoff triggers for bridal/custom orders.",
  },
  {
    icon: "👤",
    title: "Direct Founder Engineering Support",
    text: "Direct WhatsApp group with the founder and core engineers to tune and optimize your conversion rates weekly.",
  },
];

const cohortPromise = [
  {
    metric: "10",
    suffix: "stores",
    text: "Limited to first 10 stores with founder-led onboarding.",
  },
  {
    metric: "100%",
    suffix: "white-glove",
    text: "Our engineering team handles the entire Meta and Shopify build.",
  },
  {
    metric: "10x",
    suffix: "ROI standard",
    text: "If we don't deliver 10x the value, we keep working until we do.",
  },
  {
    metric: "24/7",
    suffix: "autonomous",
    text: "Captures and closes the night-shift sales humans miss.",
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/pricing", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema()]}
>
  <Navbar />

  <main class="overflow-hidden">
    <section class="hero-stripe">
      <div class="section-glow-emerald"></div>
      <div class="sect-grid opacity-30"></div>

      <div class="page-shell">
        <div class="mx-auto max-w-3xl">
          <div class="chip mb-4">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse mr-1.5"></span>
            Special Offer &bull; First 10 Stores Only
          </div>
          <h1
            class="mt-6 text-4xl font-semibold leading-[1.04] text-[#fcfdff] sm:text-6xl lg:text-7xl font-heading"
          >
            30 Days Free.
            <span class="block text-emerald-400">100% Done-For-You Setup.</span>
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-2xl">
            Experience the full power of autonomous WhatsApp sales with zero upfront cost. For the first 10 stores, our engineering team handles your entire Meta &amp; Shopify integration, catalog syncing, and brand voice tuning.
          </p>
          <div class="mt-8 flex flex-col justify-center gap-3.5 sm:flex-row">
            <a href="/free-trial" class="btn-primary">Claim 30-Day Free Trial &rarr;</a>
            <a
              href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary inline-flex items-center gap-2"
            >
              💬 Test Drive the Bot on WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="relative py-16 sm:py-24 border-t border-white/[0.08] bg-[#06060a]">
      <div class="page-shell">
        <div class="mx-auto mb-12 max-w-2xl text-center">
          <p class="section-eyebrow">The 10-Store Guarantee</p>
          <h2 class="section-title mt-3 font-heading">
            What you get from day one.
          </h2>
          <p class="section-copy mx-auto mt-4 max-w-2xl">
            All VoluChat features unlocked for 30 days, backed by personal founder calibration.
          </p>
        </div>

        <!-- PROCESS: how you start — open flow with arrows -->
        <p class="mx-auto mb-6 max-w-5xl font-mono text-[11px] uppercase tracking-[0.2em] text-[#a1a1a6]">How you start →</p>
        <div class="mx-auto mb-20 grid max-w-5xl gap-8 sm:grid-cols-3 sm:gap-10">
          <div class="relative border-t-2 border-white/[0.10] pt-8 text-center sm:text-left">
            <span class="inline-grid h-9 w-9 place-items-center rounded-full border border-white/[0.16] bg-transparent font-mono text-sm font-bold text-white">1</span>
            <p class="mt-4 font-heading text-base font-semibold text-white">You apply</p>
            <p class="mt-2 text-sm leading-relaxed text-[#86868b]">30-sec form.<br />We check fit in 24h.</p>
          </div>
          <div class="relative border-t-2 border-white/[0.10] pt-8 text-center sm:text-left">
            <span class="inline-grid h-9 w-9 place-items-center rounded-full border border-white/[0.16] bg-transparent font-mono text-sm font-bold text-white">2</span>
            <p class="mt-4 font-heading text-base font-semibold text-white">We build everything</p>
            <p class="mt-2 text-sm leading-relaxed text-[#86868b]">Catalog, Meta APIs, UPI.<br />Done in 48h.</p>
          </div>
          <div class="relative border-t-2 border-emerald-500/50 pt-8 text-center sm:text-left">
            <span class="inline-grid h-9 w-9 place-items-center rounded-full border border-emerald-500/50 bg-emerald-500/10 font-mono text-sm font-bold text-emerald-300">3</span>
            <p class="mt-4 font-heading text-base font-semibold text-white">You sell 24/7</p>
            <p class="mt-2 text-sm leading-relaxed text-[#86868b]">Comments → DMs<br />→ paid orders.</p>
          </div>
        </div>

        <!-- PROOF: why it works — boxed titanium band, totally different read -->
        <p class="mx-auto mb-6 max-w-5xl font-mono text-[11px] uppercase tracking-[0.2em] text-emerald-400">Why stores trust it ✓</p>
        <div class="visual-frame mx-auto grid max-w-5xl gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
          {
            cohortPromise.map((stat) => (
              <div class="pb-2">
                <p class="kid-num">
                  {stat.metric}
                </p>
                <p class="mt-3 text-xs font-mono uppercase tracking-[0.18em] text-emerald-400">
                  {stat.suffix}
                </p>
                <p class="mt-3 text-sm font-normal leading-relaxed text-[#86868b]">
                  {stat.text}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="relative pb-24 sm:pb-32 bg-[#000000] pt-16">
      <div class="page-shell">
        <div class="mx-auto mb-12 max-w-2xl text-center">
          <p class="section-eyebrow">White-Glove Scope</p>
          <h2 class="section-title mt-3 font-heading">
            Everything we build for you.
          </h2>
          <p class="section-copy mx-auto mt-4 max-w-2xl">
            Six deliverables. Fully built before your trial goes live.
          </p>
        </div>

        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14 max-w-5xl mx-auto items-start">
          <!-- Sticky visual: what the shopper sees -->
          <div class="visual-frame lg:sticky lg:top-24">
            <p class="font-mono text-[11px] uppercase tracking-widest text-[#a1a1a6]">What your customer sees</p>
            <div class="mt-4 space-y-3">
              <div class="chat-user">Price? Is size M in stock?</div>
              <div class="chat-ai">Yes! M is in stock — ₹2,899, pure cotton. <span class="text-emerald-300 font-semibold">Pay here →</span></div>
              <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-center">
                <p class="font-heading text-2xl font-bold text-white">₹2,899</p>
                <p class="mt-1 text-xs font-mono text-emerald-300">1-click UPI • Paid in 85s</p>
              </div>
            </div>
          </div>
          <div>
            {
              pilotIncludes.map((item, idx) => (
                <article class="hairline-row grid gap-2 sm:grid-cols-[44px_1fr]">
                  <div class="grid h-10 w-10 place-items-center rounded-full border border-white/[0.12] bg-transparent text-xl">
                    {item.icon}
                  </div>
                  <div>
                    <p class="font-mono text-[11px] text-[#a1a1a6] font-bold">0{idx + 1}</p>
                    <h3 class="mt-1 text-lg font-heading font-semibold leading-snug text-white">
                      {item.title}
                    </h3>
                    <p class="mt-2 text-sm font-normal leading-relaxed text-[#86868b]">
                      {item.text}
                    </p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="relative pb-24 bg-[#000000]">
      <div class="page-shell">
        <div class="solid-card-elevated p-8 sm:p-12">
          <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
            <div>
              <p class="section-eyebrow">Our Value Standard</p>
              <h2 class="mt-4 text-3xl font-heading font-semibold leading-[1.1] text-[#fcfdff] sm:text-4xl">
                "Anything less than 10x value is unacceptable."
              </h2>
              <p class="mt-5 text-base font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">
                If your store spends lakhs on Meta Ads, we make sure you stop losing 50%+ of your customer inquiries at night. We personally monitor your chat conversion rates daily, and we don't move on to the next store until the numbers prove it.
              </p>
            </div>
            <div class="flex flex-col gap-3">
              <a href="/free-trial" class="btn-primary w-full">Claim 30-Day Free Trial &rarr;</a>
              <a href="/compare" class="btn-secondary w-full">See how we compare</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <FAQ />
  </main>

  <Footer />
</Layout>
