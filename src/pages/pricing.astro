---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "Pricing — White-Glove Pilot Program | VoluChat";
const seoDescription =
  "VoluChat pilot pricing: what the white-glove program includes — catalog sync, comment-to-DM, sizing, UPI checkout, tracking and 24/7 automation — plus how to start with 30 days free.";
const seoKeywords =
  "VoluChat pricing, fashion boutique AI employee, WhatsApp boutique automation trial, WhatsApp sales automation, order tracking returns setup, boutique AI hire early access";
const siteUrl = "https://www.voluchat.com";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: seoTitle,
    description: seoDescription,
    url: `${siteUrl}/pricing`,
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "VoluChat AI Employee — Starter Plan",
    description: "AI employee for fashion boutiques: Instagram comment-to-DM, AI sizing, 1-click UPI checkout, courier tracking, and 24/7 automation for up to 200 conversations per month.",
    provider: {
      "@type": "Organization",
      name: "VoluChat",
      url: siteUrl,
    },
    areaServed: {
      "@type": "Country",
      name: "India",
    },
    serviceType: "Autonomous AI Employee Setup for Fashion Boutiques",
    offers: {
      "@type": "Offer",
      price: "4999",
      priceCurrency: "INR",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: "4999",
        priceCurrency: "INR",
        billingDuration: {
          "@type": "QuantitativeValue",
          value: 1,
          unitCode: "MON",
        },
      },
      availability: "https://schema.org/InStock",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "VoluChat AI Employee — Growth Plan",
    description: "Full-scope AI employee for fashion boutiques: unlimited conversations, cross-sell/upsell, priority WhatsApp support, white-glove 48h setup, and complete autonomous sales automation.",
    provider: {
      "@type": "Organization",
      name: "VoluChat",
      url: siteUrl,
    },
    areaServed: {
      "@type": "Country",
      name: "India",
    },
    serviceType: "Autonomous AI Employee Setup for Fashion Boutiques",
    offers: {
      "@type": "Offer",
      price: "9999",
      priceCurrency: "INR",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: "9999",
        priceCurrency: "INR",
        billingDuration: {
          "@type": "QuantitativeValue",
          value: 1,
          unitCode: "MON",
        },
      },
      availability: "https://schema.org/InStock",
    },
  },
];

const tiers = [
  {
    name: "Starter",
    price: "₹4,999",
    period: "/mo",
    description: "Core automation for growing boutiques",
    cta: "Start Free Trial",
    ctaLink: "/free-trial",
    highlight: false,
    features: [
      { text: "Up to 200 conversations/mo", included: true },
      { text: "Instagram Comment-to-DM", included: true },
      { text: "AI Sizing & Styling", included: true },
      { text: "1-Click UPI Checkout", included: true },
      { text: "Courier Tracking", included: true },
      { text: "Basic Exchange Handling", included: true },
      { text: "Cross-sell / Upsell", included: false },
      { text: "Priority WhatsApp Support", included: false },
      { text: "White-glove 48h Setup", included: false },
    ],
  },
  {
    name: "Growth",
    price: "₹9,999",
    period: "/mo",
    description: "Full-scope AI employee — recommended",
    cta: "Start Free Trial",
    ctaLink: "/free-trial",
    highlight: true,
    badge: "Most Popular",
    features: [
      { text: "Unlimited conversations", included: true },
      { text: "Instagram Comment-to-DM", included: true },
      { text: "AI Sizing & Styling", included: true },
      { text: "1-Click UPI Checkout", included: true },
      { text: "Courier Tracking", included: true },
      { text: "Full Exchange Handling", included: true },
      { text: "Cross-sell / Upsell", included: true },
      { text: "Priority WhatsApp Support", included: true },
      { text: "White-glove 48h Setup", included: true },
    ],
  },
];

const pilotIncludes = [
  {
    icon: "👗",
    title: "Catalog, Size Charts & Live Stock Sync",
    text: "We upload your collection, set up size guides (S to XXL), and connect your inventory so the AI never quotes wrong stock.",
  },
  {
    icon: "⚡",
    title: "Instagram Comment-to-DM Setup",
    text: "Instant 2-second replies whenever someone comments 'Price?' on your Instagram Reels, ads, or posts — sliding straight into their DMs.",
  },
  {
    icon: "💳",
    title: "1-Click UPI Payment Links",
    text: "Enables buyers to pay immediately via Google Pay, PhonePe, or Paytm inside WhatsApp without typing UPI IDs or sending screenshots.",
  },
  {
    icon: "📦",
    title: "Courier Tracking & Size Exchanges",
    text: "Connects with Delhivery, Shiprocket, or your courier to send live parcel updates and collect exchange details automatically.",
  },
  {
    icon: "🛡️",
    title: "Price Protection & Store Rules",
    text: "We set your maximum discount limits, return rules, and alerts so you have complete control over your boutique's margins.",
  },
  {
    icon: "👤",
    title: "Direct WhatsApp Support with Founder",
    text: "Private WhatsApp channel directly with our founder (Vaibhav Goyal) to calibrate your store tone and assist whenever you need.",
  },
];

const cohortPromise = [
  {
    metric: "48",
    suffix: "h setup",
    text: "White-glove onboarding by our team — catalog, tracking, returns, and checkout configured before your trial goes live.",
  },
  {
    metric: "30",
    suffix: "days free",
    text: "Full scope of autonomous sales automation — tracking, returns, checkout, and 24/7 operations — at zero upfront cost.",
  },
  {
    metric: "1",
    suffix: "AI employee",
    text: "Replaces 4 daily store jobs: selling & sizing, parcel tracking, exchanges, and support.",
  },
  {
    metric: "24/7",
    suffix: "autonomous",
    text: "Captures and closes the night-shift sales humans miss.",
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/pricing", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema()]}
>
  <Navbar />

  <main class="overflow-hidden">
    <section class="hero-stripe">
      <div class="section-glow-emerald"></div>
      <div class="sect-grid opacity-30"></div>

      <div class="page-shell">
        <div class="mx-auto max-w-3xl">
          <div class="chip mb-4">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse mr-1.5"></span>
            30-Day Free Trial &bull; No Card Required
          </div>
            <h1
              class="mt-6 text-4xl font-semibold leading-[1.04] text-[#fcfdff] sm:text-6xl lg:text-7xl font-heading"
            >
              Hire an AI Employee for<br class="hidden sm:block" /> <em class="serif-accent">₹4,999/mo</em>.
              <span class="block text-emerald-400">Replaces 4 daily store jobs — 24/7.</span>
            </h1>
            <p class="section-copy mx-auto mt-6 max-w-2xl">
              One AI employee handles selling, sizing, tracking, and support — while you sleep. Start free for 30 days. White-glove setup in 48 hours.
            </p>
            <div class="mt-8 flex flex-col justify-center gap-3.5 sm:flex-row">
              <a href="#plans" class="btn-primary">See Plans &amp; Pricing &rarr;</a>
              <a
                href="https://wa.me/919530840375?text=Hi%2C%20I'd%20like%20to%20learn%20about%20VoluChat%20pricing."
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary inline-flex items-center gap-2"
              >
                Ask on WhatsApp &rarr;
              </a>
            </div>
        </div>
      </div>
    </section>

    <section class="relative py-16 sm:py-24 border-t border-white/[0.08] bg-[#06060a]">
      <div class="page-shell">
        <div class="mx-auto mb-12 max-w-2xl text-center">
          <p class="section-eyebrow">The 10-Store Guarantee</p>
          <h2 class="section-title mt-3 font-heading">
            What you get from day one.
          </h2>
          <p class="section-copy mx-auto mt-4 max-w-2xl">
            All VoluChat features unlocked for 30 days, with founder calibration included.
          </p>
        </div>

        <!-- PROCESS: how you start — open flow with arrows -->
        <p class="mx-auto mb-6 max-w-5xl font-mono text-[11px] uppercase tracking-[0.2em] text-[#a1a1a6]">How you start →</p>
        <div class="mx-auto mb-20 grid max-w-5xl gap-8 sm:grid-cols-3 sm:gap-10">
          <div class="relative border-t-2 border-white/[0.10] pt-8 text-center sm:text-left">
            <span class="inline-grid h-9 w-9 place-items-center rounded-full border border-white/[0.16] bg-transparent font-mono text-sm font-bold text-white">1</span>
            <p class="mt-4 font-heading text-base font-semibold text-white">You apply</p>
            <p class="mt-2 text-sm leading-relaxed text-[#86868b]">30-sec form.<br />We check fit in 24h.</p>
          </div>
          <div class="relative border-t-2 border-white/[0.10] pt-8 text-center sm:text-left">
            <span class="inline-grid h-9 w-9 place-items-center rounded-full border border-white/[0.16] bg-transparent font-mono text-sm font-bold text-white">2</span>
            <p class="mt-4 font-heading text-base font-semibold text-white">We build everything</p>
            <p class="mt-2 text-sm leading-relaxed text-[#86868b]">Catalog, tracking, returns, Meta APIs, checkout. <br />Done in 48h.</p>
          </div>
          <div class="relative border-t-2 border-emerald-500/50 pt-8 text-center sm:text-left">
            <span class="inline-grid h-9 w-9 place-items-center rounded-full border border-emerald-500/50 bg-emerald-500/10 font-mono text-sm font-bold text-emerald-300">3</span>
            <p class="mt-4 font-heading text-base font-semibold text-white">You run 24/7</p>
            <p class="mt-2 text-sm leading-relaxed text-[#86868b]">Capture, size, checkout, track, return — all automated.<br />Human takeover in 1 tap when needed.</p>
          </div>
        </div>

        <!-- PROOF: why it works — boxed titanium band, totally different read -->
        <p class="mx-auto mb-6 max-w-5xl font-mono text-[11px] uppercase tracking-[0.2em] text-emerald-400">Why stores trust it ✓</p>
        <div class="visual-frame mx-auto grid max-w-5xl gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
          {
            cohortPromise.map((stat) => (
              <div class="pb-2">
                <p class="kid-num">
                  {stat.metric}
                </p>
                <p class="mt-3 text-xs font-mono uppercase tracking-[0.18em] text-emerald-400">
                  {stat.suffix}
                </p>
                <p class="mt-3 text-sm font-normal leading-relaxed text-[#86868b]">
                  {stat.text}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="plans" class="relative py-16 sm:py-24 border-t border-white/[0.08] bg-[#06060a]">
      <div class="page-shell">
        <div class="mx-auto mb-12 max-w-2xl text-center">
          <p class="section-eyebrow">Choose Your Plan</p>
          <h2 class="section-title mt-3 font-heading">
            Simple pricing. <em class="serif-accent">No surprises.</em>
          </h2>
          <p class="section-copy mx-auto mt-4 max-w-2xl">
            Start with 30 days free. Pick a plan that fits your boutique — upgrade or cancel anytime.
          </p>
        </div>

        <div class="mx-auto grid max-w-4xl gap-6 sm:grid-cols-2 sm:gap-8">
          {tiers.map((tier) => (
            <div class={`relative flex flex-col rounded-2xl border p-8 sm:p-10 ${tier.highlight ? 'border-emerald-500/40 bg-gradient-to-b from-emerald-950/30 to-[#0a0a0f] shadow-[0_0_40px_rgba(16,185,129,0.08)]' : 'border-white/[0.10] bg-[#0c0c12]'}`}>
              {tier.badge && (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-emerald-500 px-4 py-1 text-xs font-bold text-black">
                  {tier.badge}
                </span>
              )}
              <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#a1a1a6]">{tier.name}</p>
                <div class="mt-4 flex items-baseline gap-1">
                  <span class="text-4xl sm:text-5xl font-heading font-bold text-[#fcfdff]">{tier.price}</span>
                  <span class="text-sm text-[#86868b]">{tier.period}</span>
                </div>
                <p class="mt-3 text-sm text-[#86868b]">{tier.description}</p>
              </div>
              <div class="mt-8 flex flex-col gap-3">
                <a href={tier.ctaLink} class={tier.highlight ? 'btn-primary w-full justify-center' : 'btn-secondary w-full justify-center'}>
                  {tier.cta} &rarr;
                </a>
                <p class="text-center text-xs text-[#86868b]">30 days free &bull; No card required</p>
              </div>
              <ul class="mt-8 flex flex-col gap-3 border-t border-white/[0.08] pt-6">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-3 text-sm">
                    {f.included ? (
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-400" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    ) : (
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-[#3a3a3c]" viewBox="0 0 16 16" fill="none"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    )}
                    <span class={f.included ? 'text-[rgba(252,253,255,0.85)]' : 'text-[#4a4a4c]'}>{f.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-[#86868b]">
          Both plans include 30-day free trial with full features. After trial, choose Starter (₹4,999/mo) or Growth (₹9,999/mo). Annual billing: 2 months free.
        </p>
      </div>
    </section>

    <section class="relative pb-24 sm:pb-32 bg-[#000000] pt-16">
      <div class="page-shell">
        <div class="mx-auto mb-12 max-w-2xl text-center">
          <p class="section-eyebrow">White-Glove Scope</p>
          <h2 class="section-title mt-3 font-heading">
            Everything we build for you.
          </h2>
          <p class="section-copy mx-auto mt-4 max-w-2xl">
            Six deliverables. Fully built before your trial goes live.
          </p>
        </div>

        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14 max-w-5xl mx-auto items-start">
          <!-- Sticky visual: what the shopper sees -->
          <div class="visual-frame lg:sticky lg:top-24">
            <p class="font-mono text-[11px] uppercase tracking-widest text-[#a1a1a6]">What your customer sees</p>
            <div class="mt-4 space-y-3">
              <div class="chat-user">Price? Is size M in stock?</div>
              <div class="chat-ai">Yes! M is in stock — ₹2,899, pure cotton. <span class="text-emerald-300 font-semibold">Pay here →</span></div>
              <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-center">
                <p class="font-heading text-2xl font-bold text-white">₹2,899</p>
                <p class="mt-1 text-xs font-mono text-emerald-300">1-click UPI • Paid in chat</p>
              </div>
            </div>
          </div>
          <div>
            {
              pilotIncludes.map((item, idx) => (
                <article class="hairline-row grid gap-2 sm:grid-cols-[44px_1fr]">
                  <div class="grid h-10 w-10 place-items-center rounded-full border border-white/[0.12] bg-transparent text-xl">
                    {item.icon}
                  </div>
                  <div>
                    <p class="font-mono text-[11px] text-[#a1a1a6] font-bold">0{idx + 1}</p>
                    <h3 class="mt-1 text-lg font-heading font-semibold leading-snug text-white">
                      {item.title}
                    </h3>
                    <p class="mt-2 text-sm font-normal leading-relaxed text-[#86868b]">
                      {item.text}
                    </p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="relative pb-24 bg-[#000000]">
      <div class="page-shell">
        <div class="solid-card-elevated p-8 sm:p-12">
          <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
            <div>
              <p class="section-eyebrow">Our Value Standard</p>
              <h2 class="mt-4 text-3xl font-heading font-semibold leading-[1.1] text-[#fcfdff] sm:text-4xl">
                "We don't stop until your online sales run completely hands-free."
              </h2>
              <p class="mt-5 text-base font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">
                We personally configure your AI employee for sales, tracking, returns, and checkout — and stay with you through the trial until every customer workflow runs smoothly.
              </p>
            </div>
            <div class="flex flex-col gap-3">
              <a href="/free-trial" class="btn-primary w-full">Start My 30-Day Free Trial &rarr;</a>
              <a href="/compare" class="btn-secondary w-full">See how we compare</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <FAQ />
  </main>

  <Footer />
</Layout>
