---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PricingSection from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';

const seoTitle = "14-day trial for ecommerce sales teams | VoluChat";
const seoDescription = "Start a 14-day VoluChat trial for ecommerce sales team automation across Instagram, Facebook Pages, repeated product questions, and sales handoffs.";
---

<Layout title={seoTitle} description={seoDescription}>
  <Header />

  <main class="animate-page-entry opacity-0">
    <section class="relative overflow-hidden pt-36 pb-12 sm:pt-40 lg:pb-16">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_14%,rgba(83,111,159,0.12),transparent_32%),linear-gradient(180deg,rgba(255,255,255,0.9),rgba(247,249,252,0.86))]"></div>
      <div class="ambient-noise"></div>

      <div class="page-shell text-center">
        <div class="mx-auto max-w-4xl">
          <div class="chip">14-day free trial</div>
          <h1 class="mt-6 text-4xl font-semibold leading-[1.02] text-stone-950 sm:text-6xl lg:text-7xl">
            Try automated replies before you pay.
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-2xl">
            Test VoluChat on your real product questions, catalog context, and team handoff rules before deciding whether it fits your ecommerce workflow.
          </p>
        </div>
      </div>
    </section>

    <PricingSection />
    <FAQ />
  </main>

  <Footer />
</Layout>
