---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "VoluChat Pricing — 10-Store Pilot Cohort & Setup Scope";
const seoDescription =
  "Join the 10-store private pilot cohort for VoluChat. 100% done-for-you WhatsApp & Instagram setup, live Shopify catalog syncing, and guaranteed 10x ROI standard.";
const seoKeywords =
  "VoluChat pilot pricing, WhatsApp AI agent cost, done for you ecommerce automation, Instagram DM sales agent setup";
const siteUrl = "https://www.voluchat.com";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: seoTitle,
    description: seoDescription,
    url: `${siteUrl}/pricing`,
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "VoluChat Pilot Cohort Setup",
    description: "Done-for-you autonomous AI sales agent setup for Shopify D2C brands. Includes Meta API configuration, WhatsApp Business API, Shopify catalog sync, and brand voice guardrails.",
    provider: {
      "@type": "Organization",
      name: "VoluChat",
      url: siteUrl,
    },
    areaServed: {
      "@type": "Country",
      name: "India",
    },
    serviceType: "Autonomous Social Commerce AI Sales Agent Setup",
  },
];

const pilotIncludes = [
  {
    title: "Official Meta & WhatsApp Cloud API Setup",
    text: "Zero developer work needed from you. We configure your official Meta verified number, webhooks, and catalog permissions directly.",
  },
  {
    title: "Full Shopify Catalog & Live Stock Sync",
    text: "Real-time variant stock reading, SKU pricing rules, and automatic Shopify draft order creation with tracking sync.",
  },
  {
    title: "Instagram Comment-to-DM Trigger Engine",
    text: "Automated 2-second personalized DM responses for comments across your viral Instagram Reels and Meta Ads.",
  },
  {
    title: "Native In-Chat UPI & 1-Click Payment Link",
    text: "Enables customers to complete prepaid purchases directly inside WhatsApp without bouncing to an external browser checkout.",
  },
  {
    title: "Strict Brand Voice & Margin Guardrails",
    text: "Pre-set maximum discount ceilings, COD verification rules, and automated human handoff triggers for bridal/custom orders.",
  },
  {
    title: "Direct Founder Engineering Support",
    text: "Direct WhatsApp group with the founder and core engineers to tune and optimize your conversion rates weekly.",
  },
];

---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/pricing", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema()]}
>
  <Header />

  <main class="pt-20">
    <section class="relative overflow-hidden pt-20 pb-16 sm:pt-24 lg:pb-20">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_14%,rgba(16,185,129,0.15),transparent_34%),linear-gradient(180deg,rgba(8,17,31,0.96),rgba(6,13,24,0.96))]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell text-center">
        <div class="pricing-hero-text opacity-0 mx-auto max-w-4xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/25 bg-emerald-950/40 px-3.5 py-1 text-xs font-bold text-emerald-300 mb-5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Private Founder Cohort &bull; 10 Brands
          </div>
          <h1
            class="text-4xl font-semibold leading-[1.02] text-white sm:text-6xl lg:text-7xl font-heading"
          >
            100% White-Glove Setup.<br />
            <span class="gradient-text-anim">Guaranteed 10x ROI Standard.</span>
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-2xl text-slate-300">
            We don't sell self-serve software that sits empty. For our first 10 pilot stores, our engineering team builds, integrates, and tunes your autonomous sales agent end-to-end.
          </p>
          <div class="mt-8 flex flex-col justify-center gap-3.5 sm:flex-row">
            <a href="/contact" class="btn-primary">Apply for Pilot Store Setup &rarr;</a>
            <a href="/#how-it-works" class="btn-secondary">Explore the 4 Pillars</a>
          </div>
        </div>
      </div>
    </section>

    <section class="pricing-factors-section relative overflow-hidden pb-16 sm:pb-24">
      <div class="page-shell">
        <div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
          <aside class="pricing-aside opacity-0 solid-card h-fit lg:sticky lg:top-32 lg:p-8 border-emerald-500/20 bg-[#0a1424]">
            <p class="section-eyebrow text-emerald-400">Our Value Standard</p>
            <h2
              class="mt-4 text-3xl font-heading font-semibold leading-[1.08] text-white"
            >
              "Anything less than 10x value is unacceptable."
            </h2>
            <p
              class="mt-5 text-sm font-medium leading-relaxed text-slate-300"
            >
              If your store spends lakhs on Meta Ads, we make sure you stop losing 50%+ of your customer inquiries at night. We personally monitor your chat conversion rates daily.
            </p>
            <a href="/contact" class="btn-primary mt-8 w-full"
                  >Apply for Cohort &rarr;</a
            >
          </aside>

          <div class="grid gap-4 sm:grid-cols-2">
            {
              pilotIncludes.map((factor) => (
                <article class="pricing-factor-card opacity-0 rounded-2xl border border-white/10 bg-[#081120] p-6">
                  <h3 class="text-base font-heading font-bold text-white">
                    {factor.title}
                  </h3>
                  <p class="mt-3 text-xs font-medium leading-relaxed text-slate-300">
                    {factor.text}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <FAQ />
  </main>

  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // Hero
    gsap.fromTo(".pricing-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    // Factors Section
    const factorsTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".pricing-factors-section",
        start: "top 75%",
        toggleActions: "play none none reverse"
      }
    });
    factorsTl.fromTo(".pricing-aside",
      { opacity: 0, x: -30 },
      { opacity: 1, x: 0, duration: 0.8, ease: "power2.out" }
    ).fromTo(".pricing-factor-card",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 0.5, stagger: 0.1, ease: "back.out(1.2)" },
      "-=0.5"
    );

    // Included Section
    const includedTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".pricing-included-section",
        start: "top 80%",
        toggleActions: "play none none reverse"
      }
    });
    includedTl.fromTo(".pricing-included-text",
      { opacity: 0, x: -30 },
      { opacity: 1, x: 0, duration: 0.7, ease: "power2.out" }
    ).fromTo(".pricing-included-card",
      { opacity: 0, scale: 0.95 },
      { opacity: 1, scale: 1, duration: 0.6, ease: "power2.out" },
      "-=0.4"
    ).fromTo(".pricing-included-item",
      { opacity: 0, x: -20 },
      { opacity: 1, x: 0, duration: 0.4, stagger: 0.08, ease: "power2.out" },
      "-=0.3"
    );
  });
</script>
