---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PricingSection from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';

const seoTitle = "Transparent Pricing for Growing Brands | VoluChat";
const seoDescription = "Join VoluChat's Early beta for free. Get unlimited Instagram DMs, comment automation, and WhatsApp funnels at no cost during our beta phase.";
---

<Layout title={seoTitle} description={seoDescription}>
  <Header />

  <main class="pt-20">
    <section class="relative py-24 overflow-hidden">
      <div class="sect-grid"></div>
      <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
        <div class="max-w-3xl mx-auto">
          <div class="section-badge mb-6">Pricing</div>
          <h1 class="text-5xl sm:text-7xl font-heading font-bold text-slate-900 mb-8 leading-[1.05] tracking-tight">
            Start free during <br /><span class="text-gradient-primary">early beta</span>
          </h1>
          <p class="text-xl text-slate-600 leading-relaxed max-w-2xl mx-auto">
            Try VoluChat for your store with no credit card. Set up comment replies, DMs, products, and WhatsApp flow while beta access is open.
          </p>
        </div>
      </div>
    </section>

    <!-- Pricing component -->
    <PricingSection />

    <FAQ />
  </main>

  <Footer />
</Layout>
