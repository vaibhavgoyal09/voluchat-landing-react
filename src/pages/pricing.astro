---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PricingSection from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';

const seoTitle = "Founding-store pricing for shoe sellers | VoluChat";
const seoDescription = "Request a demo for founding-store setup: Instagram comment replies, shoe details in DM, and WhatsApp handoff for Indian shoe stores.";
---

<Layout title={seoTitle} description={seoDescription}>
  <Header />

  <main class="pt-24">
    <section class="relative py-32 overflow-hidden">
      <div class="absolute inset-0 pointer-events-none -z-10">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-indigo-50/30 rounded-full blur-[150px] opacity-50"></div>
      </div>
      <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
        <div class="max-w-4xl mx-auto">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-100 border border-slate-200/60 backdrop-blur-md mb-10">
            <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
            <span class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-500">Founding-store pricing</span>
          </div>
          <h1 class="text-6xl sm:text-8xl font-heading font-black text-slate-950 mb-10 leading-[1.02] tracking-tighter">
            Founding-store pricing <br /><span class="text-gradient-primary">for shoe sellers.</span>
          </h1>
          <p class="text-xl md:text-2xl text-slate-600 leading-relaxed font-medium max-w-2xl mx-auto">
            Request a demo first. We'll review your Instagram comments, shoe details, and WhatsApp order process before suggesting the right setup.
          </p>
        </div>
      </div>
    </section>

    <!-- Pricing component -->
    <PricingSection />

    <FAQ />
  </main>

  <Footer />
</Layout>
