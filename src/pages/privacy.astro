---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lastUpdated = "April 4, 2026";

const sections = [
  {
    title: "1. Introduction",
    body: "VoluChat respects your privacy and is committed to protecting information connected to your store, channels, products, and buyer conversations."
  },
  {
    title: "2. Information we collect",
    body: "We may collect account details, connected Instagram or Facebook Page integration data, authorized access tokens, product catalog information, and conversation data needed to provide reply automation and handoff workflows."
  },
  {
    title: "3. How we use information",
    body: "We use this information to operate VoluChat, answer repeated product questions, prepare buyer summaries, provide support, improve the service, and keep your authorized integrations working."
  },
  {
    title: "4. Data security",
    body: "We use encryption, scoped access, secure infrastructure practices, and restricted internal access to protect store data and connected-channel credentials."
  },
  {
    title: "5. Third-party services",
    body: "VoluChat integrates with Meta services such as Instagram and Facebook Pages. Your use of those channels is also subject to Meta's terms and privacy policies."
  },
  {
    title: "6. Your rights",
    body: "You can request access, correction, or deletion of personal information where applicable. You can also disconnect authorized channels to stop future collection through those integrations."
  },
  {
    title: "7. Changes",
    body: "We may update this policy as the product changes. Material changes will be reflected on this page or communicated through appropriate product or email notices."
  }
];
---

<Layout title="Privacy Policy | VoluChat" description="VoluChat privacy policy for ecommerce reply automation, connected social channels, and buyer conversation data.">
  <Header />

  <main class="relative overflow-hidden pt-36 pb-24 animate-page-entry opacity-0 sm:pt-40">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_18%_18%,rgba(83,111,159,0.1),transparent_30%),radial-gradient(circle_at_82%_20%,rgba(203,217,234,0.18),transparent_30%)]"></div>
    <div class="ambient-noise"></div>

    <div class="mx-auto max-w-4xl px-6">
      <div class="mb-12">
        <div class="chip">Legal</div>
        <h1 class="mt-6 text-4xl font-semibold text-stone-950 md:text-5xl">Privacy Policy</h1>
        <p class="mt-4 font-medium text-stone-500">Last updated: {lastUpdated}</p>
      </div>

      <div class="solid-card text-stone-600 md:p-10">
        <div class="space-y-8">
          {sections.map((section) => (
            <section>
              <h2 class="mb-3 text-2xl font-heading font-semibold text-stone-950">{section.title}</h2>
              <p class="leading-relaxed">{section.body}</p>
            </section>
          ))}

          <section>
            <h2 class="mb-3 text-2xl font-heading font-semibold text-stone-950">8. Contact information</h2>
            <p class="leading-relaxed">
              To ask questions about this privacy policy, contact us at <a href="mailto:support@voluchat.com" class="font-semibold text-primary-700 hover:underline">support@voluchat.com</a>.
            </p>
          </section>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
