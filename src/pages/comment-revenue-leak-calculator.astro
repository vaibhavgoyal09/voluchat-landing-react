---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const siteUrl = "https://www.voluchat.com";

const seoTitle = "Instagram Comment Revenue Leak Calculator | VoluChat";
const seoDescription =
  "Free calculator for fashion boutiques. See how much revenue unanswered Instagram comments and Reel interactions are costing you — and what instant comment-to-DM automation recovers.";
const seoKeywords =
  "Instagram comment revenue calculator, fashion boutique Instagram sales, comment to DM conversion, Instagram DM automation ROI, Reel comment revenue leak, Instagram sales automation";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Instagram Comment Revenue Leak Calculator",
    description: seoDescription,
    url: `${siteUrl}/comment-revenue-leak-calculator`,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "INR",
    },
    provider: {
      "@type": "Organization",
      name: "VoluChat",
      url: siteUrl,
    },
  },
  getFaqSchema(),
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/comment-revenue-leak-calculator", siteUrl).toString()}
  structuredData={structuredData}
>
  <Navbar />

  <main class="min-h-screen overflow-hidden bg-white">
    <!-- Hero -->
    <section class="relative overflow-hidden pt-32 pb-16 sm:pt-40 sm:pb-20 bg-white">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(60%_45%_at_50%_10%,rgba(16,185,129,0.12),transparent_65%)]"></div>
      <div class="sect-grid opacity-20 pointer-events-none"></div>
      <div class="page-shell relative z-10">
        <div class="mx-auto max-w-3xl text-center">
          <div class="chip mx-auto mb-5">
            <span class="mini-label text-emerald-600">Free Tool</span>
          </div>
          <h1 class="text-3xl font-bold leading-[1.1] text-slate-900 sm:text-5xl lg:text-6xl font-heading tracking-tight">
            How much revenue are your unanswered Instagram comments costing you?
          </h1>
          <p class="section-copy mx-auto mt-5 max-w-2xl text-base sm:text-lg">
            Enter your boutique's monthly numbers and see exactly how much revenue leaks from comments that never become DMs — and what instant automation recovers.
          </p>
          <div class="mt-6 flex items-center justify-center gap-3 text-xs font-mono text-slate-500">
            <span>✓ No signup required</span>
            <span>&bull;</span>
            <span>✓ 30 seconds</span>
            <span>&bull;</span>
            <span>✓ Fashion-focused model</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Calculator -->
    <section class="border-t border-slate-200 bg-slate-50 py-16 sm:py-24">
      <div class="page-shell">
        <div class="mx-auto max-w-6xl">
          <div class="grid gap-8 lg:grid-cols-2 items-start">
            <!-- Left: Inputs -->
            <div class="solid-card p-6 sm:p-8 space-y-8 reveal-on-scroll">
              <div class="flex items-center gap-3">
                <span class="grid h-8 w-8 place-items-center rounded-full border border-slate-200 font-mono text-xs font-bold text-slate-900">1</span>
                <div>
                  <p class="text-sm font-semibold text-slate-900">Your boutique numbers</p>
                  <p class="text-xs text-[#86868b]">Adjust the sliders to match your business.</p>
                </div>
              </div>

              <div class="space-y-8">
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <label for="comments" class="text-sm font-medium text-[#f5f5f7]">
                      Monthly Instagram comments &amp; Reel interactions
                    </label>
                    <span id="comments-val" class="font-mono text-sm text-emerald-700 tabular-nums">1,000</span>
                  </div>
                  <input
                    type="range"
                    id="comments"
                    min="100"
                    max="20000"
                    step="100"
                    value="1000"
                    class="w-full h-2 rounded-full bg-slate-100 appearance-none cursor-pointer accent-emerald-400"
                    style="accent-color: #34d399;"
                  />
                  <div class="flex justify-between text-[11px] text-[#86868b] mt-2">
                    <span>100</span>
                    <span>20,000</span>
                  </div>
                </div>

                <div>
                  <div class="flex items-center justify-between mb-3">
                    <label for="responseTime" class="text-sm font-medium text-[#f5f5f7]">
                      Average reply time to a comment
                    </label>
                    <span id="responseTime-val" class="font-mono text-sm text-emerald-700">4–12 hours</span>
                  </div>
                  <input
                    type="range"
                    id="responseTime"
                    min="0"
                    max="4"
                    step="1"
                    value="3"
                    class="w-full h-2 rounded-full bg-slate-100 appearance-none cursor-pointer"
                    style="accent-color: #34d399;"
                  />
                  <div class="flex justify-between text-[11px] text-[#86868b] mt-2">
                    <span>Under 2 min</span>
                    <span>24+ hours</span>
                  </div>
                  <div class="mt-3 flex flex-wrap gap-2" id="responseTimeChips">
                    {["Under 2 min", "Under 30 min", "1–4 hours", "4–12 hours", "24+ hours"].map((label, i) => (
                      <span class={`response-chip rounded-full border px-2.5 py-1 text-[11px] font-medium transition-colors ${i === 3 ? "border-emerald-300 bg-emerald-500/10 text-emerald-700" : "border-slate-200 bg-slate-50 text-[#86868b]"}`}>
                        {label}
                      </span>
                    ))}
                  </div>
                </div>

                <div>
                  <div class="flex items-center justify-between mb-3">
                    <label for="aov" class="text-sm font-medium text-[#f5f5f7]">
                      Average order value (₹)
                    </label>
                    <span id="aov-val" class="font-mono text-sm text-emerald-700 tabular-nums">₹1,200</span>
                  </div>
                  <input
                    type="range"
                    id="aov"
                    min="200"
                    max="20000"
                    step="100"
                    value="1200"
                    class="w-full h-2 rounded-full bg-slate-100 appearance-none cursor-pointer"
                    style="accent-color: #34d399;"
                  />
                  <div class="flex justify-between text-[11px] text-[#86868b] mt-2">
                    <span>₹200</span>
                    <span>₹20,000</span>
                  </div>
                </div>

                <div>
                  <div class="flex items-center justify-between mb-3">
                    <label for="convRate" class="text-sm font-medium text-[#f5f5f7]">
                      Current comment-to-DM conversion rate
                    </label>
                    <span id="convRate-val" class="font-mono text-sm text-emerald-700">3%</span>
                  </div>
                  <input
                    type="range"
                    id="convRate"
                    min="0.5"
                    max="15"
                    step="0.5"
                    value="3"
                    class="w-full h-2 rounded-full bg-slate-100 appearance-none cursor-pointer"
                    style="accent-color: #34d399;"
                  />
                  <div class="flex justify-between text-[11px] text-[#86868b] mt-2">
                    <span>0.5%</span>
                    <span>15%</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right: Results -->
            <div class="space-y-6">
              <div class="solid-card-elevated p-6 sm:p-8 reveal-on-scroll reveal-delay-1">
                <div class="flex items-center gap-3 mb-5">
                  <span class="grid h-8 w-8 place-items-center rounded-full border border-slate-200 font-mono text-xs font-bold text-slate-900">2</span>
                  <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-[#a1a1a6]">Your leak at a glance</p>
                    <p class="text-[11px] text-[#86868b]">Updated live as you adjust the sliders.</p>
                  </div>
                </div>
                <div class="space-y-0">
                  <div class="flex items-baseline justify-between py-4 border-b border-slate-200">
                    <span class="text-sm text-[#86868b]">Comments going cold per month</span>
                    <span id="coldComments" class="text-xl font-semibold text-slate-900 font-heading tabular-nums">9,700</span>
                  </div>
                  <div class="flex items-baseline justify-between py-4 border-b border-slate-200">
                    <span class="text-sm text-[#86868b]">Leads lost per month</span>
                    <span id="leadsLost" class="text-xl font-semibold text-slate-900 font-heading tabular-nums">7,520</span>
                  </div>
                  <div class="flex items-baseline justify-between py-4 border-b border-slate-200">
                    <span class="text-sm text-[#86868b]">Revenue leaked per month</span>
                    <span id="revenueLeaked" class="text-xl font-semibold text-[#fca5a5] font-heading tabular-nums">₹9,02,400</span>
                  </div>
                  <div class="flex items-baseline justify-between py-4">
                    <span class="text-sm text-[#86868b]">Revenue leaked per year</span>
                    <span id="revenueLeakedYear" class="text-xl font-semibold text-[#fca5a5] font-heading tabular-nums">₹1,08,28,800</span>
                  </div>
                </div>
              </div>

              <div class="solid-card p-6 sm:p-8 border-emerald-300 bg-emerald-50 reveal-on-scroll reveal-delay-2">
                <div class="flex items-center gap-3 mb-4">
                  <span class="grid h-8 w-8 place-items-center rounded-full border border-emerald-300 font-mono text-xs font-bold text-emerald-700">3</span>
                  <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-emerald-700">With VoluChat comment-to-DM automation</p>
                    <p class="text-[11px] text-[#86868b]">Replying in under 2 minutes and converting cold commenters into checkout-ready DMs.</p>
                  </div>
                </div>
                <p class="text-sm text-[#86868b] mb-1">Recoverable revenue per month</p>
                <p id="recoverable" class="text-4xl font-semibold text-emerald-700 font-heading tabular-nums">₹8,08,560</p>
                <div class="mt-5">
                  <a href="/free-trial" class="btn-primary btn-sheen !w-full justify-center text-center">
                    See how VoluChat recovers this →
                  </a>
                </div>
              </div>

              <!-- Lead capture -->
              <div id="capture-block" class="solid-card p-6 sm:p-8 reveal-on-scroll reveal-delay-3">
                <div class="flex items-start gap-3 mb-4">
                  <div class="mt-0.5 h-5 w-5 rounded-full bg-emerald-500/15 border border-emerald-300 flex items-center justify-center">
                    <svg class="h-3 w-3 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-slate-900">Get your free breakdown</p>
                    <p class="text-xs text-[#86868b] mt-1">
                      We'll email you a shareable report with your exact leak numbers and a 3-step recovery plan.
                    </p>
                  </div>
                </div>
                <form id="lead-form" class="space-y-3">
                  <input
                    type="email"
                    required
                    placeholder="you@boutique.com"
                    class="text-input w-full"
                  />
                  <input
                    type="text"
                    placeholder="Your name (optional)"
                    class="text-input w-full"
                  />
                  <button type="submit" class="btn-primary btn-sheen !w-full justify-center text-center">
                    Send me the breakdown →
                  </button>
                  <p class="text-[11px] text-[#86868b] text-center">No spam. Unsubscribe anytime.</p>
                </form>
                <p id="form-ok" class="hidden mt-3 text-center text-sm font-medium text-emerald-700">
                  Report sent — check your inbox.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="border-t border-slate-200 bg-white py-16 sm:py-24">
      <div class="page-shell">
        <div class="mx-auto max-w-3xl text-center mb-12 reveal-on-scroll">
          <p class="section-eyebrow">How it works</p>
          <h2 class="section-title mt-3">From "Price?" to UPI payment — inside chat.</h2>
          <p class="section-copy mx-auto mt-4 max-w-2xl">
            VoluChat auto-replies to Instagram comments in 2 seconds, slides into DMs with pricing and checkout, and recovers abandoned carts — all without manual effort.
          </p>
        </div>
        <div class="mx-auto max-w-5xl grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {[
            { num: "01", title: "Comment detected", desc: "Auto-replies to 'Price?', 'Available?', and sizing comments on Reels, posts, and ads within 2 seconds." },
            { num: "02", title: "DM slide with context", desc: "Sends exact pricing, product photos, size options, and a direct WhatsApp link — before the user scrolls away." },
            { num: "03", title: "AI qualifies & closes", desc: "Answers fabric questions, recommends sizes, generates 1-click UPI payment links, and settles the order inside WhatsApp." },
            { num: "04", title: "Cart recovery", desc: "If the buyer abandons, automated reminders with payment links recover the sale — even at 2 AM." },
          ].map((step) => (
            <div class="solid-card p-6 reveal-on-scroll" style="transition-delay: 0ms;">
              <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-emerald-600">{step.num}</span>
              <h3 class="mt-2 text-sm font-semibold text-slate-900 font-heading">{step.title}</h3>
              <p class="mt-2 text-xs text-[#86868b] leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
        <div class="mt-10 text-center reveal-on-scroll">
          <a href="/free-trial" class="btn-primary btn-sheen inline-flex items-center justify-center">
            Apply for 1 of 10 Pilot Spots →
          </a>
          <p class="mt-3 text-[11px] text-[#86868b]">Zero technical setup. Done-for-you onboarding. 10x ROI standard.</p>
        </div>
      </div>
    </section>

    <FAQ />
  </main>

  <Footer />

  <script>
    (() => {
      const commentsEl = document.getElementById("comments") as HTMLInputElement | null;
      const responseTimeEl = document.getElementById("responseTime") as HTMLInputElement | null;
      const aovEl = document.getElementById("aov") as HTMLInputElement | null;
      const convRateEl = document.getElementById("convRate") as HTMLInputElement | null;

      const commentsVal = document.getElementById("comments-val");
      const responseTimeVal = document.getElementById("responseTime-val");
      const aovVal = document.getElementById("aov-val");
      const convRateVal = document.getElementById("convRate-val");

      const coldCommentsEl = document.getElementById("coldComments");
      const leadsLostEl = document.getElementById("leadsLost");
      const revenueLeakedEl = document.getElementById("revenueLeaked");
      const revenueLeakedYearEl = document.getElementById("revenueLeakedYear");
      const recoverableEl = document.getElementById("recoverable");

      const responseTimeLabels = ["Under 2 min", "Under 30 min", "1–4 hours", "4–12 hours", "24+ hours"];
      const responseTimeChips = document.querySelectorAll(".response-chip");

      const captureCurve = [1.0, 0.55, 0.22, 0.08, 0.02];

      const fmtINR = (n: number) => "₹" + Math.round(n).toLocaleString("en-IN");
      const fmtNum = (n: number) => n.toLocaleString("en-IN");

      const update = () => {
        if (!commentsEl || !responseTimeEl || !aovEl || !convRateEl) return;

        const comments = parseInt(commentsEl.value, 10);
        const responseTimeIdx = parseInt(responseTimeEl.value, 10);
        const aov = parseInt(aovEl.value, 10);
        const convRate = parseFloat(convRateEl.value);

        if (commentsVal) commentsVal.textContent = fmtNum(comments);
        if (responseTimeVal) responseTimeVal.textContent = responseTimeLabels[responseTimeIdx] ?? "";
        if (aovVal) aovVal.textContent = fmtINR(aov);
        if (convRateVal) convRateVal.textContent = convRate + "%";

        responseTimeChips.forEach((chip, i) => {
          if (i === responseTimeIdx) {
            chip.classList.remove("border-slate-200", "bg-slate-50", "text-[#86868b]");
            chip.classList.add("border-emerald-300", "bg-emerald-500/10", "text-emerald-700");
          } else {
            chip.classList.add("border-slate-200", "bg-slate-50", "text-[#86868b]");
            chip.classList.remove("border-emerald-300", "bg-emerald-500/10", "text-emerald-700");
          }
        });

        const coldComments = Math.round(comments * (1 - convRate / 100));
        const capture = captureCurve[responseTimeIdx] ?? 0.02;
        const leadsLost = Math.round(coldComments * (1 - capture));
        const revenueLeaked = leadsLost * aov;
        const revenueLeakedYear = revenueLeaked * 12;
        const recoverable = leadsLost * capture * aov;

        if (coldCommentsEl) coldCommentsEl.textContent = fmtNum(coldComments);
        if (leadsLostEl) leadsLostEl.textContent = fmtNum(leadsLost);
        if (revenueLeakedEl) revenueLeakedEl.textContent = fmtINR(revenueLeaked);
        if (revenueLeakedYearEl) revenueLeakedYearEl.textContent = fmtINR(revenueLeakedYear);
        if (recoverableEl) recoverableEl.textContent = fmtINR(recoverable);
      };

      [commentsEl, responseTimeEl, aovEl, convRateEl].forEach((el) => {
        el?.addEventListener("input", update);
      });

      update();

      const form = document.getElementById("lead-form");
      const formOk = document.getElementById("form-ok");
      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        if (formOk) formOk.classList.remove("hidden");
        (e.target as HTMLFormElement).reset();
      });
    })();
  </script>
</Layout>
