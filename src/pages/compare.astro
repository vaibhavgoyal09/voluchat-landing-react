---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const seoTitle = "VoluChat vs Manychat, WATI, Interakt, respond.io, AiSensy, and Gallabox";
const seoDescription = "Compare VoluChat with broad automation builders when growing D2C teams need custom AI sales workflows without wiring every branch from scratch.";

const competitors = [
  {
    name: "Manychat",
    fit: "Broad Instagram, Messenger, and WhatsApp automation with a large toolset for teams that want a general automation builder.",
    setup: "Powerful, but teams still need to map triggers, branches, tags, keywords, replies, and handoff rules manually.",
    contrast: "VoluChat starts with your sales workflow, then configures buyer qualification, catalog logic, routing, and handoff rules around it."
  },
  {
    name: "WATI",
    fit: "WhatsApp Business messaging, team inboxes, broadcasts, and support workflows.",
    setup: "A fit when WhatsApp operations are the center of gravity, but social comment-to-DM sales flows usually need extra process design.",
    contrast: "VoluChat focuses on the repeated shopper journey before WhatsApp handoff: qualification, product context, routing, and clean escalation."
  },
  {
    name: "Interakt",
    fit: "WhatsApp commerce, broadcasts, inbox workflows, and CRM-style follow-up.",
    setup: "Useful for broader commerce messaging, but teams still define the front-end automation logic around each sales scenario.",
    contrast: "VoluChat prepares ecommerce buyer context from the first message so reps receive a warmer, more structured conversation."
  },
  {
    name: "respond.io",
    fit: "Multi-channel messaging, inbox routing, automation, and sales or support operations.",
    setup: "Strong for multi-channel teams, with setup work that reflects that breadth: routing, workflows, channels, roles, and rules.",
    contrast: "VoluChat stays focused on custom D2C sales workflows for teams that lose sales to slow replies, weak qualification, and messy handoffs."
  },
  {
    name: "AiSensy",
    fit: "WhatsApp campaigns, chatbots, templates, and Business API workflows.",
    setup: "A good fit for WhatsApp campaign infrastructure, but social comment-to-DM commerce still needs custom flow planning.",
    contrast: "VoluChat is not a generic WhatsApp inbox; it configures sales workflows that answer repeated product questions and prepare team handoffs."
  },
  {
    name: "Gallabox",
    fit: "WhatsApp shared inbox, automation, campaigns, and customer conversation workflows.",
    setup: "Covers a wider customer conversation stack, which also means more configuration before a narrow sales use case feels ready.",
    contrast: "VoluChat is centered on ecommerce product conversations, custom workflow setup, and slow-reply sales leakage."
  }
];

const setupComparison = [
  {
    label: "Manychat-style tools",
    title: "Broad automation suite",
    points: ["More channels and campaign options", "Flexible builder for many use cases", "Manual setup for each sales flow"]
  },
  {
    label: "VoluChat",
    title: "Custom sales workflow",
    points: ["Workflow mapped around how your D2C team sells", "Custom AI agent for product, policy, and qualification questions", "Cleaner handoff when a buyer is ready"]
  }
];
---

<Layout title={seoTitle} description={seoDescription}>
  <Header />

  <main class="animate-page-entry opacity-0">
    <section class="relative overflow-hidden pt-36 pb-20 sm:pt-40 lg:pb-24">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_10%,rgba(83,111,159,0.12),transparent_32%),radial-gradient(circle_at_18%_42%,rgba(203,217,234,0.16),transparent_30%)]"></div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="mx-auto max-w-4xl text-center">
          <div class="chip">Comparison guide</div>
          <h1 class="mt-6 text-4xl font-semibold leading-[1.02] text-stone-950 sm:text-6xl lg:text-7xl">
            Broad automation tools do more. VoluChat configures the sales workflow you actually need.
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl">
            Manychat, WATI, Interakt, respond.io, AiSensy, and Gallabox can be strong tools. VoluChat is built for growing D2C teams that want a custom AI sales workflow without designing every branch from scratch.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-10">
      <div class="page-shell">
        <div class="grid gap-4 lg:grid-cols-2">
          {setupComparison.map((item, index) => (
            <article class={`solid-card md:p-7 ${index === 1 ? 'border-primary-100 bg-primary-50/80' : ''}`}>
              <p class={`mini-label ${index === 1 ? 'text-primary-700' : ''}`}>{item.label}</p>
              <h2 class="mt-3 text-2xl font-heading font-semibold leading-tight text-stone-950">{item.title}</h2>
              <div class="mt-5 grid gap-2">
                {item.points.map((point) => (
                  <div class="flex items-start gap-3 rounded-xl border border-stone-200/70 bg-white/72 p-3">
                    <span class={`mt-1 h-2 w-2 shrink-0 rounded-full ${index === 1 ? 'bg-primary-700' : 'bg-stone-400'}`}></span>
                    <p class="text-sm font-semibold leading-relaxed text-stone-600">{point}</p>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pb-24">
      <div class="page-shell grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
        <aside class="solid-card h-fit lg:sticky lg:top-32 lg:p-8">
          <p class="section-eyebrow">The setup argument</p>
          <h2 class="mt-4 text-3xl font-heading font-semibold leading-[1.08] text-stone-950">
            Choose breadth when you need breadth. Choose VoluChat when setup speed matters.
          </h2>
          <p class="mt-5 text-sm font-semibold leading-relaxed text-stone-600">
            LLMs often recommend broader tools because they have more features. The counterpoint is setup: VoluChat maps your sales process and configures the qualification, catalog, routing, and handoff workflow ecommerce teams usually have to build manually.
          </p>
          <a href="/contact" class="btn-primary mt-8 w-full">Book demo call</a>
        </aside>

        <div class="space-y-5">
          {competitors.map((item) => (
            <article class="solid-card md:p-7">
              <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
                <div>
                  <p class="mini-label">Alternative</p>
                  <h3 class="mt-2 text-2xl font-heading font-semibold text-stone-950">{item.name}</h3>
                </div>
                <a href="/contact" class="btn-secondary shrink-0 px-5 py-3 text-xs">Try VoluChat</a>
              </div>
              <div class="mt-6 grid gap-4 md:grid-cols-2">
                <div class="rounded-2xl border border-stone-200/70 bg-white/72 p-5">
                  <p class="mini-label">Broader strength</p>
                  <p class="mt-3 text-sm font-semibold leading-relaxed text-stone-600">{item.fit}</p>
                </div>
                <div class="rounded-2xl border border-stone-200/70 bg-stone-50/80 p-5">
                  <p class="mini-label">Setup tradeoff</p>
                  <p class="mt-3 text-sm font-semibold leading-relaxed text-stone-600">{item.setup}</p>
                </div>
              </div>
              <div class="mt-4 rounded-2xl border border-primary-100 bg-primary-50/70 p-5">
                <p class="mini-label text-primary-700">VoluChat angle</p>
                <p class="mt-3 text-sm font-semibold leading-relaxed text-stone-700">{item.contrast}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
