---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "VoluChat vs Wati, Manychat, & Manual Reps";
const seoDescription =
  "Compare VoluChat's Autonomous Social Sales Closer with flowchart chatbots (Wati, Manychat) and expensive manual chat teams for Instagram & WhatsApp commerce.";
const seoKeywords =
  "VoluChat vs Wati, VoluChat vs Manychat, WhatsApp sales agent comparison, Instagram DM automation vs chatbots, ecommerce social closer";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: siteUrl,
};

const competitors = [
  {
    name: "Flowchart WhatsApp Tools (e.g. Wati, Interakt)",
    fit: "Broadcast messaging & rigid button-based flowcharts ('Press 1 for tracking, Press 2 for sizing').",
    setup:
      "Forces buyers through robotic decision trees. Drops off 70%+ of real buyers who have conversational questions about styling, fabric, or urgency.",
    contrast:
      "VoluChat converses naturally with your buyers, understands sizing nuances, verifies real-time stock, and closes orders directly in-chat via UPI.",
  },
  {
    name: "Social Bot Builders (e.g. Manychat)",
    fit: "Keyword auto-responders that send static coupon links to external websites.",
    setup:
      "Sends shoppers an external browser link where 60%+ abandon the cart. Cannot check real-time variant stock or handle complex customer objections.",
    contrast:
      "VoluChat generates native In-DM checkouts and draft orders so the buyer completes payment in 90 seconds without ever leaving WhatsApp.",
  },
  {
    name: "Manual Human Chat Reps",
    fit: "Hiring 2–4 full-time support agents to manually answer Instagram DMs and WhatsApp chats.",
    setup:
      "Offline between 10 PM – 9 AM (when 40%+ of social sales occur). High training overhead, slow response times, and inconsistent closing rates.",
    contrast:
      "VoluChat works 24/7/365 with sub-2s responses, zero rep churn, 100% brand tone consistency, and seamless 1-click human escalation when needed.",
  },
];

const setupComparison = [
  {
    label: "Traditional Chatbots & Reps",
    title: "High friction, low conversion",
    points: [
      "Offline at night when social ads convert best",
      "Rigid 'Press 1' menus that frustrate buyers",
      "External links that leak 60%+ of carts",
    ],
  },
  {
    label: "VoluChat AI Closer",
    title: "Autonomous 24/7 revenue engine",
    points: [
      "Sub-2s response time day and night",
      "Real-time Shopify stock & sizing intelligence",
      "Native In-DM UPI & draft order checkout",
    ],
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/compare", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="pt-20">
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-24 lg:pb-24">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_10%,rgba(83,111,159,0.12),transparent_32%),radial-gradient(circle_at_18%_42%,rgba(203,217,234,0.16),transparent_30%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="compare-hero-text opacity-0 mx-auto max-w-4xl text-center">
          <div class="chip">Comparison guide</div>
          <h1
            class="mt-6 text-4xl font-semibold leading-[1.02] text-white sm:text-6xl lg:text-7xl"
          >
            Helpdesks and chatbots manage conversations. VoluChat agents drive
            revenue.
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl">
            Generic builders and helpdesks are great for broad support
            operations. VoluChat is built for D2C brands that want autonomous
            agents to handle product queries, recover carts, and execute upsells
            out of the box.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-10">
      <div class="page-shell">
        <div class="grid gap-4 lg:grid-cols-2">
          {
            setupComparison.map((item, index) => (
              <article
                class={`compare-setup-card opacity-0 solid-card md:p-7 ${index === 1 ? "border-teal-300/20 bg-teal-300/10" : ""}`}
              >
                <p class={`mini-label ${index === 1 ? "text-teal-200" : ""}`}>
                  {item.label}
                </p>
                <h2 class="mt-3 text-2xl font-heading font-semibold leading-tight text-white">
                  {item.title}
                </h2>
                <div class="mt-5 grid gap-2">
                  {item.points.map((point) => (
                    <div class="flex items-start gap-3 rounded-xl border border-[rgba(148,163,184,0.2)] bg-[#101b2e] p-3">
                      <span
                        class={`mt-1 h-2 w-2 shrink-0 rounded-full ${index === 1 ? "bg-teal-500" : "bg-slate-500"}`}
                      />
                      <p class="text-base font-medium leading-relaxed text-slate-300">
                        {point}
                      </p>
                    </div>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="compare-comp-section pb-24">
      <div class="page-shell grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
        <aside class="compare-aside opacity-0 solid-card h-fit lg:sticky lg:top-32 lg:p-8">
          <p class="section-eyebrow">The architectural difference</p>
          <h2
            class="mt-4 text-3xl font-heading font-semibold leading-[1.08] text-white"
          >
            Choose specialized AI over generic bots.
          </h2>
          <p class="mt-5 text-base font-medium leading-relaxed text-slate-300">
            VoluChat agents are built specifically for Shopify stores. They
            don't just reply to messages—they execute commerce workflows like
            inventory clearance and abandoned cart recovery with human
            oversight.
          </p>
          <a href="/contact" class="btn-primary mt-8 w-full"
                  >Book Demo</a
          >
        </aside>

        <div class="space-y-5">
          {
            competitors.map((item) => (
              <article class="compare-comp-card opacity-0 solid-card md:p-7">
                <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
                  <div>
                    <p class="mini-label">Alternative Category</p>
                    <h3 class="mt-2 text-2xl font-heading font-semibold text-white">
                      {item.name}
                    </h3>
                  </div>
                </div>
                <div class="mt-6 grid gap-4 md:grid-cols-2">
                  <div class="rounded-2xl border border-[rgba(148,163,184,0.2)] bg-[#101b2e] p-5">
                    <p class="mini-label">Core strength</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                      {item.fit}
                    </p>
                  </div>
                  <div class="rounded-2xl border border-[rgba(148,163,184,0.2)] bg-[#0d1829] p-5">
                    <p class="mini-label">The Tradeoff</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                      {item.setup}
                    </p>
                  </div>
                </div>
                <div class="mt-4 rounded-2xl border border-teal-300/20 bg-teal-300/10 p-5">
                  <p class="mini-label text-teal-200">VoluChat Advantage</p>
                  <p class="mt-3 text-base font-medium leading-relaxed text-slate-200">
                    {item.contrast}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // Hero
    gsap.fromTo(".compare-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    // Setup Section
    gsap.fromTo(".compare-setup-card",
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 0.6, stagger: 0.2, ease: "power2.out",
        scrollTrigger: {
          trigger: ".compare-setup-card",
          start: "top 80%",
          toggleActions: "play none none reverse"
        }
      }
    );

    // Competitors Section
    const compTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".compare-comp-section",
        start: "top 75%",
        toggleActions: "play none none reverse"
      }
    });
    
    compTl.fromTo(".compare-aside",
      { opacity: 0, x: -30 },
      { opacity: 1, x: 0, duration: 0.8, ease: "power2.out" }
    ).fromTo(".compare-comp-card",
      { opacity: 0, y: 40, rotateX: -5 },
      { opacity: 1, y: 0, rotateX: 0, duration: 0.7, stagger: 0.15, ease: "back.out(1.2)" },
      "-=0.5"
    );
  });
</script>
