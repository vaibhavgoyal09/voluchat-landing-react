---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "VoluChat vs Wati, Manychat & Reps — Fashion Sales Agent";
const seoDescription =
  "Compare VoluChat's AI sales stylist with Wati, Manychat, and manual chat reps for clothing and fashion boutiques on WhatsApp and Instagram.";
const seoKeywords =
  "VoluChat vs Wati, VoluChat vs Manychat, WhatsApp boutique sales bot, fashion ecommerce automation vs chatbots, Instagram DM sales closer";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/compare`,
};

const competitors = [
  {
    name: "Flowchart WhatsApp Tools (e.g. Wati, Interakt)",
    icon: "🧭",
    fit: "Broadcast messaging & rigid button-based flowcharts ('Press 1 for tracking, Press 2 for sizing').",
    tradeoff:
      "Forces boutique shoppers through robotic menus. Drops 70%+ of high-intent buyers who ask natural styling questions ('Is this pure silk?', 'Does it come with a dupatta?').",
    advantage:
      "VoluChat acts as an AI Stylist — conversing naturally, qualifying exact fit and measurements, verifying live variant stock, and closing orders via UPI inside chat.",
  },
  {
    name: "Social Bot Builders (e.g. Manychat)",
    icon: "🔗",
    fit: "Keyword auto-responders that send static coupon links to external websites.",
    tradeoff:
      "Kicks shoppers to an external browser link where 70%+ abandon the cart. Cannot check live variant inventory or handle sizing objections in DM.",
    advantage:
      "VoluChat generates native In-DM checkouts and draft orders so the customer pays via 1-click UPI in 90 seconds without ever leaving WhatsApp.",
  },
  {
    name: "Manual Human Chat Reps",
    icon: "👥",
    fit: "Hiring 2–4 full-time support agents to manually answer Instagram DMs and WhatsApp chats.",
    tradeoff:
      "Offline between 10 PM – 9 AM (when 55%+ of fashion browsing occurs). Founders spend 4+ hours chasing manual UPI screenshots and size chart questions.",
    advantage:
      "VoluChat works 24/7 with sub-2s responses, zero rep churn, 100% brand tone consistency, and seamless 1-click human escalation when needed.",
  },
];

const differentiators = [
  {
    label: "Flowchart Bots & Manual Reps",
    points: [
      "Offline at 11 PM when Instagram Reels & ads peak",
      "Rigid 'Press 1' menus that kill the boutique vibe",
      "External website links that leak 70%+ of carts",
      "Manual UPI screenshot chasing and sizing errors",
    ],
  },
  {
    label: "VoluChat AI Stylist",
    points: [
      "Sub-2s response time day and night",
      "Real-time catalog stock & sizing intelligence",
      "Native In-DM 1-click UPI checkout links",
      "Strict margin floors, 1-click founder takeover",
    ],
  },
];

const whenToChooseOther = [
  {
    label: "Choose Wati if…",
    points: [
      "You need broadcast messaging for mass discount blasts and festive campaigns",
      "Simple order tracking bots with 'Press 1' menus are sufficient",
      "You want a self-serve tool and have time to build flows yourself",
    ],
  },
  {
    label: "Choose Manychat if…",
    points: [
      "Basic Instagram comment auto-replies for lead capture are your only priority",
      "You mainly distribute coupon links to an existing follower base",
      "Budget is tight and you just need a simple keyword trigger tool",
    ],
  },
  {
    label: "Choose manual reps if…",
    points: [
      "Your chat volume is under 10 boutique inquiries per day",
      "Every single order requires bespoke bespoke tailoring customization",
      "You're okay with offline midnight gaps and slow response times",
    ],
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/compare", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Navbar />

  <main class="overflow-hidden">
    <section class="relative isolate overflow-hidden pt-32 pb-16 sm:pt-40 sm:pb-20">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_10%,rgba(83,111,159,0.12),transparent_32%),radial-gradient(circle_at_18%_42%,rgba(203,217,234,0.16),transparent_30%)]"
      >
      </div>
      <div class="sect-grid opacity-20"></div>

      <div class="page-shell">
        <div class="mx-auto max-w-4xl text-center">
          <div class="chip mx-auto">Comparison guide</div>
          <h1
            class="mt-6 text-4xl font-semibold leading-[1.04] text-white sm:text-6xl lg:text-7xl font-heading"
          >
            Chatbots push website links.
            <span class="block gradient-text-anim">VoluChat closes fashion sales on WhatsApp.</span>
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl text-slate-300">
            Flowchart builders and support desks leak 70%+ of boutique buyers with rigid menus and slow website links. VoluChat is built specifically for fashion &amp; apparel brands to answer sizing queries, verify live inventory, and close paid orders directly in WhatsApp in 90 seconds.
          </p>
        </div>
      </div>
    </section>

    <section class="relative pb-16">
      <div class="page-shell">
        <div class="grid gap-5 lg:grid-cols-2">
          {
            differentiators.map((item, index) => (
              <article
                class={`solid-card p-6 sm:p-8 ${index === 1 ? "border-emerald-500/30 bg-emerald-950/20" : ""}`}
              >
                <p class={`mini-label ${index === 1 ? "text-emerald-300" : ""}`}>
                  {item.label}
                </p>
                <h2 class="mt-3 text-2xl font-heading font-semibold leading-tight text-white">
                  {index === 1
                    ? "Autonomous 24/7 revenue engine"
                    : "High friction, low conversion"}
                </h2>
                <ul class="mt-6 space-y-3">
                  {item.points.map((point) => (
                    <li class="flex items-start gap-3 rounded-xl border border-white/10 bg-[#0c1728] p-3.5">
                      <span
                        class={`mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full text-[10px] font-bold ${index === 1 ? "bg-emerald-500/20 text-emerald-300" : "bg-slate-500/20 text-slate-300"}`}
                      >
                        {index === 1 ? "✓" : "✕"}
                      </span>
                      <p class="text-sm font-medium leading-relaxed text-slate-200 sm:text-base">
                        {point}
                      </p>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="relative pb-20 sm:pb-28">
      <div class="page-shell">
        <div class="mx-auto mb-12 max-w-2xl text-center">
          <p class="section-eyebrow text-emerald-400">Side by side</p>
          <h2 class="section-title mt-3 text-white font-heading">
            How each alternative actually stacks up.
          </h2>
          <p class="section-copy mx-auto mt-4 max-w-2xl text-slate-300">
            Three real categories we compete with, what they are genuinely good at, and where VoluChat replaces them.
          </p>
        </div>

        <div class="grid gap-6">
          {
            competitors.map((item) => (
              <article class="solid-card p-6 sm:p-8">
                <header class="flex items-start gap-4 border-b border-white/10 pb-5">
                  <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl border border-white/10 bg-white/[0.05] text-2xl">
                    {item.icon}
                  </span>
                  <div>
                    <p class="mini-label">Alternative category</p>
                    <h3 class="mt-1 text-xl font-heading font-semibold text-white sm:text-2xl">
                      {item.name}
                    </h3>
                  </div>
                </header>

                <div class="mt-6 grid gap-4 md:grid-cols-2">
                  <div class="rounded-2xl border border-white/10 bg-[#0c1728] p-5">
                    <p class="mini-label">Core strength</p>
                    <p class="mt-3 text-sm font-medium leading-relaxed text-slate-300 sm:text-base">
                      {item.fit}
                    </p>
                  </div>
                  <div class="rounded-2xl border border-white/10 bg-[#0d1829] p-5">
                    <p class="mini-label text-rose-300">The tradeoff</p>
                    <p class="mt-3 text-sm font-medium leading-relaxed text-slate-300 sm:text-base">
                      {item.tradeoff}
                    </p>
                  </div>
                </div>

                <div class="mt-4 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-5">
                  <p class="mini-label text-emerald-200">VoluChat advantage</p>
                  <p class="mt-3 text-sm font-medium leading-relaxed text-slate-100 sm:text-base">
                    {item.advantage}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="relative pb-24">
      <div class="page-shell">
        <div class="mx-auto max-w-5xl">
          <div class="mb-10 text-center">
            <p class="section-eyebrow text-emerald-400">Honest take</p>
            <h2 class="section-title mt-3 text-white font-heading">
              When to choose the other tools
            </h2>
            <p class="section-copy mx-auto mt-4 max-w-2xl text-slate-300">
              We'd rather you pick the right tool than regret a wrong fit. Here's when each alternative actually makes sense.
            </p>
          </div>

          <div class="grid gap-5 md:grid-cols-3">
            {
              whenToChooseOther.map((item) => (
                <article class="solid-card p-6">
                  <p class="mini-label text-slate-300">{item.label}</p>
                  <ul class="mt-4 space-y-3 text-sm font-medium leading-relaxed text-slate-300">
                    {item.points.map((point) => (
                      <li class="flex gap-2.5">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-500" />
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>

          <div class="mt-10 solid-card border-emerald-500/30 bg-emerald-950/20 p-8 text-center sm:p-10">
            <p class="mini-label text-emerald-300">Choose VoluChat if…</p>
            <p class="mx-auto mt-3 max-w-2xl text-lg font-medium leading-relaxed text-slate-100">
              You want to close sales, not just answer questions. VoluChat qualifies buyers, checks live stock, handles objections, and completes orders in-chat — the full 90-second commerce loop the other tools can't deliver.
            </p>
            <a href="/contact" class="btn-primary mt-6 inline-block">Apply for Pilot Cohort &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <FAQ />
  </main>

  <Footer />
</Layout>
