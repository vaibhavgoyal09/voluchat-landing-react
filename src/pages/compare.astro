---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "VoluChat vs Wati, Manychat, & Manual Reps — Sales Comparison";
const seoDescription =
  "Compare VoluChat's Autonomous Social Sales Closer with flowchart chatbots (Wati, Manychat) and expensive manual chat teams for Instagram & WhatsApp commerce.";
const seoKeywords =
  "VoluChat vs Wati, VoluChat vs Manychat, WhatsApp sales agent comparison, Instagram DM automation vs chatbots, ecommerce social closer";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/compare`,
};

const competitors = [
  {
    name: "Flowchart WhatsApp Tools (e.g. Wati, Interakt)",
    fit: "Broadcast messaging & rigid button-based flowcharts ('Press 1 for tracking, Press 2 for sizing').",
    setup:
      "Forces buyers through robotic decision trees. Drops off 70%+ of real buyers who have conversational questions about styling, fabric, or urgency.",
    contrast:
      "VoluChat converses naturally with your buyers, understands sizing nuances, verifies real-time stock, and closes orders directly in-chat via UPI.",
  },
  {
    name: "Social Bot Builders (e.g. Manychat)",
    fit: "Keyword auto-responders that send static coupon links to external websites.",
    setup:
      "Sends shoppers an external browser link where 60%+ abandon the cart. Cannot check real-time variant stock or handle complex customer objections.",
    contrast:
      "VoluChat generates native In-DM checkouts and draft orders so the buyer completes payment in 90 seconds without ever leaving WhatsApp.",
  },
  {
    name: "Manual Human Chat Reps",
    fit: "Hiring 2–4 full-time support agents to manually answer Instagram DMs and WhatsApp chats.",
    setup:
      "Offline between 10 PM – 9 AM (when 40%+ of social sales occur). High training overhead, slow response times, and inconsistent closing rates.",
    contrast:
      "VoluChat works 24/7/365 with sub-2s responses, zero rep churn, 100% brand tone consistency, and seamless 1-click human escalation when needed.",
  },
];

const setupComparison = [
  {
    label: "Traditional Chatbots & Reps",
    title: "High friction, low conversion",
    points: [
      "Offline at night when social ads convert best",
      "Rigid 'Press 1' menus that frustrate buyers",
      "External links that leak 60%+ of carts",
    ],
  },
  {
    label: "VoluChat AI Closer",
    title: "Autonomous 24/7 revenue engine",
    points: [
      "Sub-2s response time day and night",
      "Real-time Shopify stock & sizing intelligence",
      "Native In-DM UPI & draft order checkout",
    ],
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/compare", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="pt-20">
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-24 lg:pb-24">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_10%,rgba(83,111,159,0.12),transparent_32%),radial-gradient(circle_at_18%_42%,rgba(203,217,234,0.16),transparent_30%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="compare-hero-text opacity-0 mx-auto max-w-4xl text-center">
          <div class="chip">Comparison guide</div>
          <h1
            class="mt-6 text-4xl font-semibold leading-[1.02] text-white sm:text-6xl lg:text-7xl font-heading"
          >
            Chatbots manage tickets. VoluChat closes social commerce sales.
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl text-slate-300">
            Flowchart builders and support desks leak 70%+ of your buyers with rigid menus and external links. VoluChat is built specifically for D2C brands to qualify inquiries on Instagram, verify Shopify variant inventory, and close paid orders directly in WhatsApp in 90 seconds.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-10">
      <div class="page-shell">
        <div class="grid gap-4 lg:grid-cols-2">
          {
            setupComparison.map((item, index) => (
              <article
                class={`compare-setup-card opacity-0 solid-card md:p-7 ${index === 1 ? "border-emerald-500/30 bg-emerald-950/20" : ""}`}
              >
                <p class={`mini-label ${index === 1 ? "text-emerald-300" : ""}`}>
                  {item.label}
                </p>
                <h2 class="mt-3 text-2xl font-heading font-semibold leading-tight text-white">
                  {item.title}
                </h2>
                <div class="mt-5 grid gap-2">
                  {item.points.map((point) => (
                    <div class="flex items-start gap-3 rounded-xl border border-white/10 bg-[#0c1728] p-3">
                      <span
                        class={`mt-1 h-2 w-2 shrink-0 rounded-full ${index === 1 ? "bg-emerald-400" : "bg-slate-500"}`}
                      />
                      <p class="text-base font-medium leading-relaxed text-slate-300">
                        {point}
                      </p>
                    </div>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="compare-comp-section pb-24">
      <div class="page-shell grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
        <aside class="compare-aside opacity-0 solid-card h-fit lg:sticky lg:top-32 lg:p-8 border-emerald-500/20 bg-[#081120]">
          <p class="section-eyebrow text-emerald-400">The architectural difference</p>
          <h2
            class="mt-4 text-3xl font-heading font-semibold leading-[1.08] text-white"
          >
            Autonomous Sales Closer vs Generic Bots.
          </h2>
          <p class="mt-5 text-base font-medium leading-relaxed text-slate-300">
            VoluChat is engineered for modern D2C commerce. We connect directly with your official Meta APIs and Shopify catalog to execute real sales transactions inside chat with strict margin and COD safety guardrails.
          </p>
          <a href="/contact" class="btn-primary mt-8 w-full"
                  >Apply for Pilot Cohort &rarr;</a
          >
        </aside>

        <div class="space-y-5">
          {
            competitors.map((item) => (
              <article class="compare-comp-card opacity-0 solid-card md:p-7">
                <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
                  <div>
                    <p class="mini-label">Alternative Category</p>
                    <h3 class="mt-2 text-2xl font-heading font-semibold text-white">
                      {item.name}
                    </h3>
                  </div>
                </div>
                <div class="mt-6 grid gap-4 md:grid-cols-2">
                  <div class="rounded-2xl border border-[rgba(148,163,184,0.2)] bg-[#0c1728] p-5">
                    <p class="mini-label">Core strength</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                      {item.fit}
                    </p>
                  </div>
                  <div class="rounded-2xl border border-[rgba(148,163,184,0.2)] bg-[#0d1829] p-5">
                    <p class="mini-label">The Tradeoff</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                      {item.setup}
                    </p>
                  </div>
                </div>
                <div class="mt-4 rounded-2xl border border-teal-300/20 bg-teal-300/10 p-5">
                  <p class="mini-label text-teal-200">VoluChat Advantage</p>
                  <p class="mt-3 text-base font-medium leading-relaxed text-slate-200">
                    {item.contrast}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="pb-24">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl">
          <div class="text-center mb-10">
            <p class="section-eyebrow text-emerald-400">Honest take</p>
            <h2 class="section-title mt-4 text-white font-heading">
              When to choose the other tools
            </h2>
            <p class="section-copy mx-auto mt-5 max-w-2xl text-slate-300">
              We'd rather you pick the right tool than regret a wrong fit. Here's when each alternative actually makes sense.
            </p>
          </div>

          <div class="grid gap-5 md:grid-cols-3">
            <article class="solid-card p-6">
              <p class="mini-label text-slate-400">Choose Wati if...</p>
              <ul class="mt-3 space-y-2 text-sm font-medium leading-relaxed text-slate-300">
                <li>You need broadcast messaging for promotions and sale announcements</li>
                <li>Simple order tracking bots with 'Press 1' menus are enough</li>
                <li>You want a self-serve tool and have time to build flows yourself</li>
              </ul>
            </article>
            <article class="solid-card p-6">
              <p class="mini-label text-slate-400">Choose Manychat if...</p>
              <ul class="mt-3 space-y-2 text-sm font-medium leading-relaxed text-slate-300">
                <li>Basic Instagram comment auto-replies for lead capture are your priority</li>
                <li>You mainly distribute coupon codes to an existing audience</li>
                <li>Budget is tight and you need a simple keyword trigger tool</li>
              </ul>
            </article>
            <article class="solid-card p-6">
              <p class="mini-label text-slate-400">Choose manual reps if...</p>
              <ul class="mt-3 space-y-2 text-sm font-medium leading-relaxed text-slate-300">
                <li>Your chat volume is under 10 inquiries per day</li>
                <li>Conversations require deep emotional nuance every time</li>
                <li>You're okay with offline gaps and inconsistent response times</li>
              </ul>
            </article>
          </div>

          <div class="mt-10 solid-card p-6 md:p-8 border-emerald-500/30 bg-emerald-950/20 text-center">
            <p class="mini-label text-emerald-300">Choose VoluChat if...</p>
            <p class="mt-3 text-lg font-medium leading-relaxed text-slate-200 max-w-2xl mx-auto">
              You want to close sales, not just answer questions. VoluChat qualifies buyers, checks live stock, handles objections, and completes orders in-chat — the full 90-second commerce loop the other tools can't deliver.
            </p>
            <a href="/contact" class="btn-primary mt-6 inline-block">Apply for Pilot Cohort &rarr;</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // Hero
    gsap.fromTo(".compare-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    // Setup Section
    gsap.fromTo(".compare-setup-card",
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 0.6, stagger: 0.2, ease: "power2.out",
        scrollTrigger: {
          trigger: ".compare-setup-card",
          start: "top 80%",
          toggleActions: "play none none reverse"
        }
      }
    );

    // Competitors Section
    const compTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".compare-comp-section",
        start: "top 75%",
        toggleActions: "play none none reverse"
      }
    });
    
    compTl.fromTo(".compare-aside",
      { opacity: 0, x: -30 },
      { opacity: 1, x: 0, duration: 0.8, ease: "power2.out" }
    ).fromTo(".compare-comp-card",
      { opacity: 0, y: 40, rotateX: -5 },
      { opacity: 1, y: 0, rotateX: 0, duration: 0.7, stagger: 0.15, ease: "back.out(1.2)" },
      "-=0.5"
    );
  });
</script>
