---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PainPoints from '../components/PainPoints.astro';
import BestFor from '../components/BestFor.astro';
import Features from '../components/Features.astro';
import Demo from '../components/Demo.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CompactComparison from '../components/CompactComparison.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const siteUrl = "https://voluchat.com";
const seoTitle = "Turn More DMs Into Orders | VoluChat";
const seoDescription = "VoluChat helps Instagram-led stores answer repeated DMs, recommend products, collect delivery details, and send customers to WhatsApp with the order message filled in.";
const seoKeywords = "Instagram DM automation, WhatsApp order message, DM to order automation, ecommerce reply automation, product catalog AI agent, COD delivery questions, Hinglish customer replies, Manychat alternative India";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does VoluChat turn DMs into orders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VoluChat answers repeated product questions, recommends products from your catalog, collects cart and delivery details, and sends customers to WhatsApp with the order message already filled in."
      }
    },
    {
      "@type": "Question",
      "name": "Can VoluChat recommend products from my catalog?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Shoppers can describe what they want, ask for a size or shade, or send product context. VoluChat uses your catalog to suggest relevant matches."
      }
    },
    {
      "@type": "Question",
      "name": "What happens when the customer is ready to order?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VoluChat prepares the product, variant, quantity, delivery address, and phone details, then gives the customer a WhatsApp link with the order message prefilled for your store."
      }
    },
    {
      "@type": "Question",
      "name": "Does VoluChat process payments or fully confirm orders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Your store still handles final confirmation and payment details. VoluChat prepares the WhatsApp-ready order so your team can close faster."
      }
    },
    {
      "@type": "Question",
      "name": "Will my team still control the final sale?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. VoluChat handles repeated replies and detail collection. Your team stays in control of confirmation, payment instructions, exceptions, and customer judgment."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need technical knowledge to use it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. You get help connecting Instagram and Facebook Pages, adding catalog details, tuning replies, and setting up WhatsApp order messages."
      }
    },
    {
      "@type": "Question",
      "name": "How much does VoluChat cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Early access pricing is Rs. 5,000 for one-time setup and Rs. 3,000 per month, with a 30-day money-back guarantee."
      }
    }
  ]
};

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "VoluChat",
    "url": siteUrl,
    "description": seoDescription,
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "inLanguage": "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "VoluChat",
    "url": siteUrl,
    "logo": `${siteUrl}/voluchat_logo.svg`,
    "description": seoDescription
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "SiteNavigationElement",
        "position": 1,
        "name": "Features",
        "url": `${siteUrl}/features/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 2,
        "name": "Pricing",
        "url": `${siteUrl}/pricing/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 3,
        "name": "Compare",
        "url": `${siteUrl}/compare/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 4,
        "name": "About",
        "url": `${siteUrl}/about/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 5,
        "name": "Blog",
        "url": `${siteUrl}/blog/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 6,
        "name": "Book Demo",
        "url": `${siteUrl}/contact/`
      }
    ]
  },
  faqSchema
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <Header />
  
  <main class="animate-page-entry opacity-0">
    <Hero />
    <PainPoints />
    <BestFor />
    <Demo />
    <Features />
    <HowItWorks />
    <CompactComparison />
    <Pricing />
    <Testimonials />
    <FAQ />
  </main>

  <Footer />
</Layout>
