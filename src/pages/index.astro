---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PainPoints from '../components/PainPoints.astro';
import Features from '../components/Features.astro';
import Demo from '../components/Demo.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What does VoluChat do for my Instagram DMs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VoluChat works like an AI DM helpdesk. It replies to buyers, answers routine questions, searches your catalog, collects useful details, and prepares a WhatsApp handoff for your staff."
      }
    },
    {
      "@type": "Question",
      "name": "Can VoluChat find products from photos or buyer messages?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Buyers can describe what they want or send an image. VoluChat can use catalog data and vector search to find relevant product matches."
      }
    },
    {
      "@type": "Question",
      "name": "Does VoluChat replace my store staff?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. VoluChat handles the repetitive first layer of DM work so your staff can spend more time on buyers who are ready to close."
      }
    },
    {
      "@type": "Question",
      "name": "Does VoluChat manage cart, address, and offer details?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. It can collect product, size, color, quantity, shipping address, and discount or offer-code details before the WhatsApp handoff."
      }
    },
    {
      "@type": "Question",
      "name": "Does VoluChat process orders or payments?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Your team still handles final order confirmation and payment manually in WhatsApp. VoluChat prepares the conversation with the details your staff needs."
      }
    },
    {
      "@type": "Question",
      "name": "Can store owners track missed chats and team workload?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VoluChat is designed to make DM ownership clearer by separating handled chats, follow-ups, and WhatsApp-ready conversations."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need technical knowledge to use it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Founding stores get hands-on help connecting Instagram, adding catalog details, tuning replies, and setting up the WhatsApp handoff."
      }
    }
  ]
};
---

<Layout title="VoluChat | AI DM Helpdesk for Instagram Stores">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  
  <Header />
  
  <main>
    <Hero />
    <PainPoints />
    <Features />
    <Demo />
    <HowItWorks />
    <Pricing />
    <Testimonials />
    <FAQ />
  </main>

  <Footer />
</Layout>
