---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import ProblemSection from "../components/ProblemSection.astro";
import UseCasesSection from "../components/UseCasesSection.astro";
import ProductLoopSection from "../components/ProductLoopSection.astro";
import GuardrailsSection from "../components/GuardrailsSection.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import FounderNoteSection from "../components/FounderNoteSection.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

export const prerender = true;

const seoTitle = "VoluChat — 24/7 AI Sales Closer for WhatsApp & Instagram";
const seoDescription =
  "Turn Instagram comments and WhatsApp chats into 24/7 automated revenue. VoluChat qualifies buyers, checks live stock, and completes native UPI orders.";
const seoKeywords =
  "WhatsApp AI sales agent, Instagram DM automation, D2C social commerce closer, WhatsApp native checkout, Shopify WhatsApp sales bot, VoluChat";
const siteUrl = "https://www.voluchat.com";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "VoluChat",
    url: siteUrl,
    logo: `${siteUrl}/voluchat_logo.svg`,
    sameAs: [
      "https://www.instagram.com/voluchat",
      "https://x.com/voluchat",
      "https://www.linkedin.com/company/voluchat",
      "https://www.youtube.com/@voluchat",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "VoluChat",
    alternateName: "VoluChat AI",
    url: siteUrl,
    description: seoDescription,
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "VoluChat",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: siteUrl,
    description: seoDescription,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: [
      {
        "@type": "SiteNavigationElement",
        position: 1,
        name: "Features",
        url: `${siteUrl}/features`,
      },
      {
        "@type": "SiteNavigationElement",
        position: 2,
        name: "Pricing",
        url: `${siteUrl}/pricing`,
      },
      {
        "@type": "SiteNavigationElement",
        position: 3,
        name: "Compare",
        url: `${siteUrl}/compare`,
      },
      {
        "@type": "SiteNavigationElement",
        position: 4,
        name: "About",
        url: `${siteUrl}/about`,
      },
      {
        "@type": "SiteNavigationElement",
        position: 5,
        name: "Contact",
        url: `${siteUrl}/contact`,
      },
    ],
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema()]}
>
  <Navbar />

  <main class="overflow-x-hidden">
    <Hero />
    <ProblemSection />
    <ProductLoopSection />
    <UseCasesSection />
    <FounderNoteSection />
    <GuardrailsSection />
    <FAQ />
  </main>

  <Footer />
</Layout>
