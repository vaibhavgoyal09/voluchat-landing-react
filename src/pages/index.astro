---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/landing/Navbar.astro';
import Hero from '../components/landing/Hero.astro';
import ProblemSection from '../components/landing/ProblemSection.astro';
import ComparisonSection from '../components/landing/ComparisonSection.astro';
import ProductLoopSection from '../components/landing/ProductLoopSection.astro';
import FeatureGrid from '../components/landing/FeatureGrid.astro';
import DemoFlowSection from '../components/landing/DemoFlowSection.astro';
import AudienceSection from '../components/landing/AudienceSection.astro';
import TrustSection from '../components/landing/TrustSection.astro';
import CTASection from '../components/landing/CTASection.astro';
import Footer from '../components/landing/Footer.astro';

const seoTitle = "VoluChat | AI Commerce Operations Platform for Shopify Brands";
const seoDescription = "VoluChat gives growing Shopify stores AI agents that handle repetitive commerce operations — from product questions and cart recovery to upsells, follow-ups, and revenue leak detection.";
const seoKeywords = "AI commerce platform, Shopify automation, Shopify AI agents, D2C automation layer, cart recovery, product recommendations, ecommerce operations, VoluChat";
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
>
  <Navbar />
  
  <main class="animate-page-entry opacity-0 overflow-x-hidden">
    <Hero />
    <ProblemSection />
    <ComparisonSection />
    <ProductLoopSection />
    <FeatureGrid />
    <DemoFlowSection />
    <AudienceSection />
    <TrustSection />
    <CTASection />
  </main>

  <Footer />
</Layout>
