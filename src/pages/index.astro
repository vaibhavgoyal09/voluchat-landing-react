---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PainPoints from '../components/PainPoints.astro';
import BestFor from '../components/BestFor.astro';
import Features from '../components/Features.astro';
import Demo from '../components/Demo.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CompactComparison from '../components/CompactComparison.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const siteUrl = "https://www.voluchat.com";
const seoTitle = "Custom AI Sales Workflows for Growing D2C Teams | VoluChat";
const seoDescription = "VoluChat builds custom AI sales workflows for growing D2C teams: qualify buyers, answer catalog questions, route exceptions, and prepare clean WhatsApp handoffs.";
const seoKeywords = "custom AI sales workflows, D2C sales automation, Instagram DM automation, WhatsApp order handoff, ecommerce reply automation, product catalog AI agent, COD delivery questions, Hinglish customer replies, Manychat alternative India";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does VoluChat build custom sales workflows?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VoluChat maps how your team sells today, then configures AI workflows for repeated buyer questions, catalog recommendations, qualification, escalation rules, and WhatsApp handoffs."
      }
    },
    {
      "@type": "Question",
      "name": "Can VoluChat recommend products from my catalog?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Shoppers can describe what they want, ask for a size or shade, or send product context. VoluChat uses your catalog to suggest relevant matches."
      }
    },
    {
      "@type": "Question",
      "name": "Is VoluChat limited to Instagram-to-WhatsApp handoff?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Instagram-to-WhatsApp is one common workflow. VoluChat can also be configured around buyer qualification, catalog matching, team escalation, delivery checks, offer rules, and follow-up context."
      }
    },
    {
      "@type": "Question",
      "name": "Does VoluChat process payments or fully confirm orders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Your team still handles final confirmation and payment details. VoluChat prepares cleaner buyer context and sales handoffs so your team can close faster."
      }
    },
    {
      "@type": "Question",
      "name": "Will my team still control the final sale?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. VoluChat handles repeated replies and detail collection. Your team stays in control of confirmation, payment instructions, exceptions, and customer judgment."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need technical knowledge to use it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. You get founder-led help mapping the workflow, connecting the right channels, adding catalog and policy details, tuning replies, and launching the pilot."
      }
    },
    {
      "@type": "Question",
      "name": "How much does VoluChat cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Founder-led pilot pricing is Rs. 5,000 for one-time setup and Rs. 3,000 per month, with a 30-day money-back guarantee."
      }
    }
  ]
};

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "VoluChat",
    "url": siteUrl,
    "description": seoDescription,
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "inLanguage": "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "VoluChat",
    "url": siteUrl,
    "logo": `${siteUrl}/voluchat_logo.svg`,
    "description": seoDescription
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "SiteNavigationElement",
        "position": 1,
        "name": "Features",
        "url": `${siteUrl}/features/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 2,
        "name": "Pricing",
        "url": `${siteUrl}/pricing/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 3,
        "name": "Compare",
        "url": `${siteUrl}/compare/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 4,
        "name": "About",
        "url": `${siteUrl}/about/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 5,
        "name": "Blog",
        "url": `${siteUrl}/blog/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 6,
        "name": "Book Demo",
        "url": `${siteUrl}/contact/`
      }
    ]
  },
  faqSchema
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <Header />
  
  <main class="animate-page-entry opacity-0">
    <Hero />
    <PainPoints />
    <BestFor />
    <Demo />
    <Features />
    <HowItWorks />
    <CompactComparison />
    <Pricing />
    <Testimonials />
    <FAQ />
  </main>

  <Footer />
</Layout>
