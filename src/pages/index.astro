---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import BestFor from '../components/BestFor.astro';
import Features from '../components/Features.astro';
import Demo from '../components/Demo.astro';
import CompactComparison from '../components/CompactComparison.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const siteUrl = "https://voluchat.com";
const seoTitle = "Instant Product Replies for Instagram and Facebook Stores | VoluChat";
const seoDescription = "VoluChat helps premium ecommerce stores answer Instagram and Facebook product questions, collect order details, and prepare WhatsApp messages without a complicated chatbot setup.";
const seoKeywords = "Instagram DM automation, Facebook Page automation, ecommerce reply automation, premium ecommerce stores, comment to DM automation, Meta shopping assistant, product catalog replies, WhatsApp order messages, Manychat alternative for ecommerce";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does VoluChat help stores reply faster on Instagram and Facebook?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VoluChat answers common product questions from comments and DMs, collects size and delivery details, and prepares a WhatsApp order message before the shopper loses interest."
      }
    },
    {
      "@type": "Question",
      "name": "Can VoluChat find products from photos or shopper messages?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Shoppers can describe a product, ask for a size or shade, or send an image. VoluChat can use your catalog to suggest relevant matches."
      }
    },
    {
      "@type": "Question",
      "name": "Does VoluChat replace the human touch?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. VoluChat handles repeat questions and detail collection. Your store still confirms the order, shares payment details, and steps in when the chat needs a person."
      }
    },
    {
      "@type": "Question",
      "name": "Does VoluChat create the WhatsApp checkout message?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. After collecting products, variant choices, quantity, and delivery address, VoluChat prepares WhatsApp text so the order is easier to confirm."
      }
    },
    {
      "@type": "Question",
      "name": "Does VoluChat manage cart, address, and offer details?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. It can collect product, size, color, quantity, shipping address, COD preference, and discount or offer-code details before the final payment step."
      }
    },
    {
      "@type": "Question",
      "name": "Does VoluChat process orders or payments?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Your store still handles final confirmation and payment details. Most stores send their UPI QR code or payment instructions after VoluChat prepares the order message."
      }
    },
    {
      "@type": "Question",
      "name": "How is VoluChat different from Manychat, WATI, Interakt, respond.io, AiSensy, or Gallabox?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Those tools are strong options when you need broad automation. VoluChat is focused on faster setup for Instagram and Facebook product conversations, comment-to-DM flows, and ready-to-confirm order chats."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need technical knowledge to use it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. You get help connecting Instagram and Facebook Pages, adding catalog details, tuning replies, and setting up WhatsApp order messages."
      }
    },
    {
      "@type": "Question",
      "name": "How much does VoluChat cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Early access pricing is Rs. 5,000 for one-time setup and Rs. 3,000 per month, with a 30-day money-back guarantee."
      }
    }
  ]
};

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "VoluChat",
    "url": siteUrl,
    "description": seoDescription,
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "inLanguage": "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "VoluChat",
    "url": siteUrl,
    "logo": `${siteUrl}/voluchat_logo.svg`,
    "description": seoDescription
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "SiteNavigationElement",
        "position": 1,
        "name": "Features",
        "url": `${siteUrl}/features/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 2,
        "name": "Pricing",
        "url": `${siteUrl}/pricing/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 3,
        "name": "Compare",
        "url": `${siteUrl}/compare/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 4,
        "name": "About",
        "url": `${siteUrl}/about/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 5,
        "name": "Blog",
        "url": `${siteUrl}/blog/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 6,
        "name": "Book Demo",
        "url": `${siteUrl}/contact/`
      }
    ]
  },
  faqSchema
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <Header />
  
  <main class="animate-page-entry opacity-0">
    <Hero />
    <BestFor />
    <Demo />
    <Features />
    <CompactComparison />
    <Pricing />
    <Testimonials />
    <FAQ />
  </main>

  <Footer />
</Layout>
