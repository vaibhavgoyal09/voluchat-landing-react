---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import ProblemSection from "../components/ProblemSection.astro";
import HowItWorksFlow from "../components/HowItWorksFlow.astro";
import RoiCalculatorSection from "../components/RoiCalculatorSection.astro";
import FounderNoteSection from "../components/FounderNoteSection.astro";
import GuardrailsSection from "../components/GuardrailsSection.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

export const prerender = true;

const seoTitle = "VoluChat — AI WhatsApp Sales Agent for Fashion Boutiques";
const seoDescription =
  "Autonomous AI sales agent on WhatsApp for fashion boutiques. Automates Reel comment-to-DM, answers sizing questions, and closes UPI checkouts 24/7 across Instagram, WhatsApp, Facebook, and your website.";
const seoKeywords =
  "AI sales agent fashion, WhatsApp sales bot clothing boutique, Instagram DM sales automation, fashion ecommerce WhatsApp checkout, boutique cart recovery WhatsApp, size chart AI agent";
const siteUrl = "https://www.voluchat.com";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "VoluChat",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: siteUrl,
    description: seoDescription,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: [
      {
        "@type": "SiteNavigationElement",
        position: 1,
        name: "Features",
        url: `${siteUrl}/features`,
      },
      {
        "@type": "SiteNavigationElement",
        position: 2,
        name: "Pricing",
        url: `${siteUrl}/pricing`,
      },
      {
        "@type": "SiteNavigationElement",
        position: 3,
        name: "Compare",
        url: `${siteUrl}/compare`,
      },
      {
        "@type": "SiteNavigationElement",
        position: 4,
        name: "About",
        url: `${siteUrl}/about`,
      },
      {
        "@type": "SiteNavigationElement",
        position: 5,
        name: "Contact",
        url: `${siteUrl}/contact`,
      },
    ],
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema()]}
>
  <Navbar />

  <main class="overflow-x-hidden">
    <Hero />
    <ProblemSection />
    <HowItWorksFlow />
    <RoiCalculatorSection />
    <FounderNoteSection />
    <GuardrailsSection />
    <FAQ />
  </main>

  <Footer />
</Layout>
