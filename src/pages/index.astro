---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PainPoints from '../components/PainPoints.astro';
import Features from '../components/Features.astro';
import MetaCatalogSync from '../components/MetaCatalogSync.astro';
import Demo from '../components/Demo.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Security from '../components/Security.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const siteUrl = "https://voluchat.com";
const seoTitle = "Stop Losing Sales to Slow Replies | VoluChat";
const seoDescription = "VoluChat automates repeated product questions across Instagram and Facebook Pages so ecommerce stores answer faster, save hours, and stop losing sales.";
const seoKeywords = "ecommerce reply automation, Instagram DM automation, Facebook Page automation, repeated product questions, slow reply lost sales, AI sales assistant, product catalog search, WhatsApp automation, shoe store automation, high-ticket ecommerce automation";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does VoluChat stop ecommerce stores losing sales to slow replies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VoluChat automates replies to repeated product questions across Instagram and Facebook Pages, checks catalog details, collects buyer context, and helps your team step in when shoppers are ready to move forward."
      }
    },
    {
      "@type": "Question",
      "name": "Can VoluChat find products from photos or buyer messages?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Shoppers can describe a product, ask for size or shade, or send an image. VoluChat can use catalog data and vector search to find relevant product matches."
      }
    },
    {
      "@type": "Question",
      "name": "Does VoluChat replace my store staff?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. VoluChat handles the repetitive first layer of product questions so your staff can spend more time on shoppers who are ready to buy."
      }
    },
    {
      "@type": "Question",
      "name": "Does VoluChat manage cart, address, and offer details?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. It can collect product, size, color, quantity, shipping address, and discount or offer-code details before the WhatsApp handoff."
      }
    },
    {
      "@type": "Question",
      "name": "Does VoluChat process orders or payments?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Your team still handles final order confirmation and payment. VoluChat prepares the conversation with the details your staff needs, and native WhatsApp automation is coming soon."
      }
    },
    {
      "@type": "Question",
      "name": "Can store owners track missed chats and team workload?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VoluChat is designed to make DM ownership clearer by separating handled chats, follow-ups, and WhatsApp-ready conversations."
      }
    },
    {
      "@type": "Question",
      "name": "How is VoluChat different from Manychat, WATI, Interakt, respond.io, AiSensy, or Gallabox?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Those tools are strong options for broad chat automation, WhatsApp inboxes, or customer support workflows. VoluChat is focused on ecommerce product conversations where slow manual replies can cost sales."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need technical knowledge to use it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Store teams get hands-on help connecting Instagram and Facebook Pages, adding catalog details, tuning replies, and setting up the handoff during the 14-day trial."
      }
    }
  ]
};

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "VoluChat",
    "url": siteUrl,
    "description": seoDescription,
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "inLanguage": "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "VoluChat",
    "url": siteUrl,
    "logo": `${siteUrl}/voluchat_logo.svg`,
    "description": seoDescription
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "SiteNavigationElement",
        "position": 1,
        "name": "Features",
        "url": `${siteUrl}/features/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 2,
        "name": "Pricing",
        "url": `${siteUrl}/pricing/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 3,
        "name": "Compare",
        "url": `${siteUrl}/compare/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 4,
        "name": "About",
        "url": `${siteUrl}/about/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 5,
        "name": "Blog",
        "url": `${siteUrl}/blog/`
      },
      {
        "@type": "SiteNavigationElement",
        "position": 6,
        "name": "Start Trial",
        "url": `${siteUrl}/contact/`
      }
    ]
  },
  faqSchema
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <Header />
  
  <main class="animate-page-entry opacity-0">
    <Hero />
    <PainPoints />
    <Features />
    <MetaCatalogSync />
    <Demo />
    <HowItWorks />
    <Security />
    <Pricing />
    <Testimonials />
    <FAQ />
  </main>

  <Footer />
</Layout>
