---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import ProblemSection from "../components/ProblemSection.astro";
import HowItWorksFlow from "../components/HowItWorksFlow.astro";
import ProductProofSection from "../components/ProductProofSection.astro";
import ConnectedSystemSection from "../components/ConnectedSystemSection.astro";
import GuardrailsSection from "../components/GuardrailsSection.astro";
import RoiCalculatorSection from "../components/RoiCalculatorSection.astro";
import EarlyAccessSection from "../components/EarlyAccessSection.astro";
import FounderNoteSection from "../components/FounderNoteSection.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

export const prerender = true;

const seoTitle = "VoluChat — AI Employee for Fashion Boutiques | 24/7 Online Store Operations";
const seoDescription =
  "Hire an AI employee for your fashion boutique. VoluChat sells your collection, answers sizing doubts, tracks orders, and handles routine exchanges across Instagram and WhatsApp.";
const seoKeywords =
  "AI employee fashion boutique, WhatsApp AI sales agent clothing, Instagram DM boutique automation, boutique order tracking WhatsApp, size chart AI agent, fashion ecommerce operations bot";
const siteUrl = "https://www.voluchat.com";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "VoluChat",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: siteUrl,
    description: seoDescription,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: [
      {
        "@type": "SiteNavigationElement",
        position: 1,
        name: "Features",
        url: `${siteUrl}/features`,
      },
      {
        "@type": "SiteNavigationElement",
        position: 2,
        name: "Pricing",
        url: `${siteUrl}/pricing`,
      },
      {
        "@type": "SiteNavigationElement",
        position: 3,
        name: "Compare",
        url: `${siteUrl}/compare`,
      },
      {
        "@type": "SiteNavigationElement",
        position: 4,
        name: "About",
        url: `${siteUrl}/about`,
      },
      {
        "@type": "SiteNavigationElement",
        position: 5,
        name: "Contact",
        url: `${siteUrl}/contact`,
      },
    ],
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema()]}
>
  <Navbar />

  <main class="overflow-x-hidden">
    <Hero />
    <ProblemSection />
    <HowItWorksFlow />
    <ProductProofSection />
    <ConnectedSystemSection />
    <GuardrailsSection />
    <RoiCalculatorSection />
    <EarlyAccessSection />
    <FAQ />
  </main>

  <Footer />
</Layout>
