---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PainPoints from '../components/PainPoints.astro';
import Features from '../components/Features.astro';
import Demo from '../components/Demo.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is VoluChat safe for my Instagram account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VoluChat connects through official Meta APIs, so you do not share your Instagram password with us."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need technical knowledge to use it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Founding stores get hands-on setup help for Instagram, shoe details, buyer messages, and WhatsApp handoff."
      }
    },
    {
      "@type": "Question",
      "name": "What happens after a customer comments on my Reel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VoluChat can send the buyer an Instagram DM, ask helpful questions, answer common product details, and guide them to WhatsApp when they are ready."
      }
    },
    {
      "@type": "Question",
      "name": "How does the WhatsApp handoff work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When the buyer is ready, VoluChat opens WhatsApp with useful details like the shoe, size, color, budget, and question they asked. Your team can then process the order manually."
      }
    },
    {
      "@type": "Question",
      "name": "Can VoluChat answer shoe-specific questions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You can add product names, prices, sizes, colors, photos, stock notes, and delivery details so buyers get clearer answers in Instagram DM."
      }
    },
    {
      "@type": "Question",
      "name": "Does it support Hindi or Hinglish?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VoluChat can be set up for English, Hindi, and Hinglish buyer messages. We can tune the tone during onboarding."
      }
    },
    {
      "@type": "Question",
      "name": "How much does VoluChat cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pricing is shared after a demo because founding stores may need different setup support depending on catalog size, message volume, and WhatsApp workflow."
      }
    }
  ]
};
---

<Layout title="VoluChat | Instagram Comment Replies for Indian Shoe Stores">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  
  <Header />
  
  <main>
    <Hero />
    <PainPoints />
    <Features />
    <Demo />
    <HowItWorks />
    <Pricing />
    <Testimonials />
    <FAQ />
  </main>

  <Footer />
</Layout>
