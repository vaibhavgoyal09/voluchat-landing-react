---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/landing/Navbar.astro';
import Hero from '../components/landing/Hero.astro';
import ProblemSection from '../components/landing/ProblemSection.astro';
import PlatformSection from '../components/landing/PlatformSection.astro';
import UseCasesSection from '../components/landing/UseCasesSection.astro';
import ProductLoopSection from '../components/landing/ProductLoopSection.astro';
import GuardrailsSection from '../components/landing/GuardrailsSection.astro';
import DemoFlowSection from '../components/landing/DemoFlowSection.astro';
import FounderNoteSection from '../components/landing/FounderNoteSection.astro';
import TrustSection from '../components/landing/TrustSection.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/landing/Footer.astro';

const seoTitle = "Shopify AI Agents for Revenue Recovery | VoluChat";
const seoDescription = "Use VoluChat's Shopify AI agents to recover carts, answer product questions, recommend upsells, follow up with buyers, and control actions with guardrails.";
const seoKeywords = "Shopify AI agents, AI cart recovery, ecommerce AI agents, Shopify automation, product question AI, revenue recovery agent, D2C automation, VoluChat";
const siteUrl = "https://www.voluchat.com";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "VoluChat",
    "url": siteUrl,
    "logo": `${siteUrl}/voluchat_logo.svg`,
    "sameAs": []
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "VoluChat",
    "url": siteUrl,
    "description": seoDescription
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "VoluChat",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web",
    "url": siteUrl,
    "description": seoDescription
  }
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  structuredData={structuredData}
>
    <Navbar />
  
  <main class="overflow-x-hidden">
    <Hero />
    <ProblemSection />
    <PlatformSection />
    <UseCasesSection />
    <ProductLoopSection />
    <GuardrailsSection />
    <DemoFlowSection />
    <FounderNoteSection />
    <TrustSection />
    <FAQ />
  </main>

  <Footer />
</Layout>
