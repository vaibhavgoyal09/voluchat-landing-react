---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import ProblemSection from "../components/ProblemSection.astro";
import HowItWorksFlow from "../components/HowItWorksFlow.astro";
import ProductProofSection from "../components/ProductProofSection.astro";
import ConnectedSystemSection from "../components/ConnectedSystemSection.astro";
import GuardrailsSection from "../components/GuardrailsSection.astro";
import RoiCalculatorSection from "../components/RoiCalculatorSection.astro";
import EarlyAccessSection from "../components/EarlyAccessSection.astro";
import FounderNoteSection from "../components/FounderNoteSection.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

export const prerender = true;

const seoTitle = "VoluChat — AI Employee for Fashion Boutiques | Sells While You Sleep";
const seoDescription =
  "VoluChat replies to 'Price?' in 2s, advises sizes from size charts, sends 1-click UPI links, and tracks parcels 24/7 on Instagram & WhatsApp. 30-day free trial.";
const seoKeywords =
  "AI employee fashion boutique, WhatsApp AI sales agent clothing, Instagram DM boutique automation, boutique order tracking WhatsApp, size chart AI agent, fashion ecommerce operations bot";
const siteUrl = "https://www.voluchat.com";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "VoluChat",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: siteUrl,
    description: seoDescription,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "INR",
      name: "30-Day Free Trial",
      description: "30-day free trial with white-glove setup in 48 hours.",
      availability: "https://schema.org/InStock",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: siteUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "How VoluChat Works — 4 Jobs, One AI Employee",
    description:
      "VoluChat handles selling & sizing, parcel tracking, exchange resolution, and 24/7 FAQs for fashion boutiques.",
    step: [
      {
        "@type": "HowToStep",
        name: "Sell & Close",
        text: "Turns casual 'Price?' comments and DMs into completed orders with size guidance and direct 1-click UPI links.",
      },
      {
        "@type": "HowToStep",
        name: "Track Parcels",
        text: "Answers 'Where is my parcel?' instantly by fetching live status directly from Delhivery, Shiprocket, or your courier.",
      },
      {
        "@type": "HowToStep",
        name: "Resolve Exchanges",
        text: "Handles routine exchange requests by verifying your 7-day policy, collecting tag photos, and creating tickets.",
      },
      {
        "@type": "HowToStep",
        name: "24/7 Support",
        text: "Answers questions on pure fabrics, lining, wash care, boutique timings, and shipping timelines in your tone.",
      },
    ],
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema()]}
>
  <Navbar />

  <main class="overflow-x-hidden">
    <Hero />
    <ProblemSection />
    <HowItWorksFlow />
    <ProductProofSection />
    <ConnectedSystemSection />
    <GuardrailsSection />
    <RoiCalculatorSection />
    <EarlyAccessSection />
    <FAQ />
  </main>

  <Footer />
</Layout>
