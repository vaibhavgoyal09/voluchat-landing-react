---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/landing/Navbar.astro';
import Hero from '../components/landing/Hero.astro';
import ProblemSection from '../components/landing/ProblemSection.astro';
import PlatformSection from '../components/landing/PlatformSection.astro';
import UseCasesSection from '../components/landing/UseCasesSection.astro';
import ProductLoopSection from '../components/landing/ProductLoopSection.astro';
import GuardrailsSection from '../components/landing/GuardrailsSection.astro';
import DemoFlowSection from '../components/landing/DemoFlowSection.astro';
import FounderNoteSection from '../components/landing/FounderNoteSection.astro';
import TrustSection from '../components/landing/TrustSection.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/landing/Footer.astro';

const seoTitle = "VoluChat | AI Commerce Agents for Shopify Brands";
const seoDescription = "VoluChat gives growing Shopify stores commerce agents that answer product questions, recover carts, suggest upsells, follow up with customers, and surface revenue leaks.";
const seoKeywords = "AI commerce agents, commerce agents, Shopify AI agents, ecommerce agents, cart recovery agent, product recommendation agent, D2C automation, Shopify automation, VoluChat";
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
>
  <Navbar />
  
  <main class="animate-page-entry opacity-0 overflow-x-hidden">
    <Hero />
    <ProblemSection />
    <PlatformSection />
    <UseCasesSection />
    <ProductLoopSection />
    <GuardrailsSection />
    <DemoFlowSection />
    <FounderNoteSection />
    <TrustSection />
    <FAQ />
  </main>

  <Footer />
</Layout>
