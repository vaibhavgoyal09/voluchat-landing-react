---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "VoluChat Features — Front-Office AI Employee for Fashion Boutiques";
const seoDescription =
  "Explore VoluChat's front-office operations: Instagram comment-to-DM capture, AI sizing & sales employee, order tracking (WISMO), returns & exchanges, 1-click UPI checkout, and 24/7 autonomous boutique support.";
const seoKeywords =
  "AI employee fashion boutique, front-office operations WhatsApp, order tracking WISMO, returns exchanges automation, WhatsApp sales agent, boutique DM automation, AI sizing employee, in-chat UPI checkout";
const siteUrl = "https://www.voluchat.com";

const featurePillars = [
  {
    number: "01",
    tag: "Customer Capture",
    title: "Instant Customer Capture — From Comment to Conversation",
    subtitle: "Turn Instagram Reel comments into qualified buying conversations in 2 seconds.",
    description: "When a shopper comments 'Price?' or 'Available?' on your Instagram Reel, they want an answer immediately. VoluChat auto-replies to their comment and slides into their DMs with exact pricing, photos, and a direct WhatsApp link before they scroll away.",
    highlight: "2.0s Response Time",
    items: [
      {
        title: "2-Second Reel Comment Auto-Reply",
        desc: "Instantly acknowledges comments on your posts, Reels, and ads, driving public curiosity into private sales conversations.",
      },
      {
        title: "Exact Reel & Product Recognition",
        desc: "Knows the exact dress, lehenga, or co-ord set shown in the specific Reel the customer commented on.",
      },
      {
        title: "1-Click WhatsApp Transfer",
        desc: "Smoothly shifts ready-to-buy customers from Instagram DMs into your official WhatsApp chat with product context intact.",
      },
    ],
  },
  {
    number: "02",
    tag: "Sales & Sizing Employee",
    title: "AI Sales & Sizing Employee",
    subtitle: "Qualifies orders, recommends fits, and manages routine customer requests 24/7.",
    description: "Stop answering sizing questions fifty times a day. VoluChat understands your catalog, sizing charts, and fit preferences to recommend the right size, manage routine exchanges, and assist with order tracking — all without typing a single word.",
    highlight: "Zero Sizing Confusion",
    items: [
      {
        title: "Measurement & Fit Recommendation",
        desc: "Asks customer height and fit preferences to recommend the exact size, drastically reducing post-purchase exchange requests.",
      },
      {
        title: "Fabric, Quality & Care Details",
        desc: "Explains pure cotton, georgette, chanderi silk details, lining information, and care tips directly in the chat.",
      },
      {
        title: "Smart Styling & Cross-Sell Add-ons",
        desc: "Suggests matching dupattas, jewelry, or complementary pieces to increase average order value naturally.",
      },
    ],
  },
  {
    number: "03",
    tag: "In-Chat Checkout",
    title: "1-Click UPI Payment & Instant Settlement",
    subtitle: "Collect payments inside WhatsApp without sending QR codes or asking for screenshots.",
    description: "Forget typing your Google Pay number and begging customers for transaction screenshots. VoluChat generates 1-click UPI links (GPay, PhonePe, Paytm, CRED) directly in chat so customers can pay in 15 seconds.",
    highlight: "15-Second Checkout",
    items: [
      {
        title: "1-Click UPI Payment Links",
        desc: "Generates instant payment links that open Google Pay, PhonePe, or Paytm directly on the customer's phone.",
      },
      {
        title: "Zero Screenshot Verification",
        desc: "Payments are verified automatically via secure gateway webhooks — no manual bank checking or screenshot matching.",
      },
      {
        title: "Prepaid Discount Incentives",
        desc: "Strategically offers small prepaid discounts (e.g. ₹100 off on instant UPI) to eliminate COD orders and avoid fake deliveries.",
      },
    ],
  },
  {
    number: "04",
    tag: "Catalog & Stock",
    title: "Catalog, Stock & Courier Updates Without a Website",
    subtitle: "Manage your collection, sizes, and parcels with simple spreadsheets or photos.",
    description: "You don't need a complicated website dashboard. Upload product photos, sizes, and prices via Google Sheets or chat. VoluChat checks available stock, collects delivery addresses, logs orders, and sends tracking links cleanly.",
    highlight: "Zero Website Required",
    items: [
      {
        title: "Simple Sheet or Photo Catalog Sync",
        desc: "Add your latest collection easily from Google Sheets or phone photos — no technical setup needed.",
      },
      {
        title: "Automated Address & Pincode Checking",
        desc: "Collects complete delivery address and pincode in chat, checking courier serviceability before taking payment.",
      },
      {
        title: "Optional Shopify Sync Available",
        desc: "Already have a Shopify store? VoluChat connects optionally to sync inventory and create draft orders automatically.",
      },
    ],
  },
  {
    number: "05",
    tag: "24/7 Store Operations",
    title: "24/7 Store Operations — Parcel Tracking, Exchanges & Night Sales",
    subtitle: "Answers 'Where is my parcel?', validates size exchanges, and closes night sales.",
    description: "Most boutique inquiries happen after 9 PM or ask 'Where is my parcel?'. VoluChat checks live courier status, checks your 7-day exchange rules with unboxing photos, and closes orders while you sleep — alerting you only when personal attention is needed.",
    highlight: "24/7 Always Active",
    items: [
      {
        title: "Live Parcel Tracking Answers",
        desc: "Pulls live courier status (Delhivery, Shiprocket, BlueDart) and sends direct tracking updates instantly in WhatsApp.",
      },
      {
        title: "Smooth Size Exchange Validation",
        desc: "Checks your 7-day policy window, collects unboxing photos with tags intact, and prepares the replacement details cleanly.",
      },
      {
        title: "Instant WhatsApp Alert for Custom Requests",
        desc: "Detects bespoke bridal tailoring, bulk wedding orders, or special requests and alerts you for 1-tap takeover.",
      },
      {
        title: "Fixed Price & Discount Limits",
        desc: "Follows your strict minimum price rules so your boutique never offers unauthorized discounts.",
      },
    ],
  },
  {
    number: "06",
    tag: "Website Chat Widget",
    title: "Storefront AI Chat Widget for Your Website",
    subtitle: "Guide website visitors, recommend sizes, and share tracking updates right on your site.",
    description: "Add a smart chat assistant to your website or Shopify store. It answers sizing questions, guides hesitant buyers to checkout, provides live parcel tracking, and handles exchange requests without redirecting them elsewhere.",
    highlight: "Zero-Redirect Experience",
    items: [
      {
        title: "8 Proactive Playbooks",
        desc: "Detects product dwell, cart hesitation, checkout abandonment, and search queries to trigger context-aware help at the right moment.",
      },
      {
        title: "In-Page Product Cards & Quick Replies",
        desc: "Shows product cards, quick-reply chips, and navigation highlights directly on your website without leaving the page.",
      },
      {
        title: "Cart & Checkout Recovery",
        desc: "Monitors cart state in real time, offers shipping and discount info, and gently guides visitors to complete checkout.",
      },
    ],
  },
];

const transformationPoints = [
  {
    before: "Waking up to 40 unread 'Price?' DMs with buyers already gone — plus tracking and return requests piling up",
    after: "Every DM answered in 2s with sizing, tracking updates, and exchange validation done inside WhatsApp overnight",
  },
  {
    before: "Manually checking courier dashboards for 'Where is my order?' texts and typing out GPay numbers",
    after: "Live tracking status pulled instantly + 1-click UPI link with automatic payment confirmation",
  },
  {
    before: "Measuring dresses and answering sizing questions 50x a day, plus validating return tags and photos manually",
    after: "AI employee qualifies fits, manages routine exchanges, and handles order status — zero manual lookup",
  },
  {
    before: "Copy-pasting customer addresses from chat into messy spreadsheets and manually updating tracking links",
    after: "Clean address, order details, and live courier tracking logged automatically with customer notifications",
  },
  {
    before: "Website visitors leave to WhatsApp and never come back — with no way to track their inquiry or assist with returns",
    after: "AI widget captures inquiries, provides tracking updates, and manages exchanges directly on your site",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: seoTitle,
    description: seoDescription,
    url: `${siteUrl}/features`,
  },
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    name: "VoluChat Front-Office AI Employee for Fashion Boutiques",
    description:
      "Front-office operations for fashion boutiques: customer capture, AI sales & sizing employee, in-chat checkout, catalog & tracking management, 24/7 operations with WISMO and returns, and website widget.",
    url: `${siteUrl}/features`,
    hasDefinedTerm: featurePillars.flatMap((pillar) => [
      {
        "@type": "DefinedTerm",
        name: pillar.title,
        description: pillar.description,
        inDefinedTermSet: `${siteUrl}/features`,
      },
      ...pillar.items.map((item) => ({
        "@type": "DefinedTerm",
        name: item.title,
        description: item.desc,
        inDefinedTermSet: `${siteUrl}/features`,
      })),
    ]),
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/features", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema()]}
>
  <Navbar />

  <main class="overflow-hidden">
    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-32 pb-16 sm:pt-40 sm:pb-20 bg-[#000000]">
      <!-- Background Ambient Glow -->
      <div class="absolute left-1/2 top-1/4 -z-10 h-[450px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(ellipse,rgba(16,185,129,0.15),transparent_70%)] blur-[90px] pointer-events-none"></div>
      <div class="sect-grid opacity-20 pointer-events-none"></div>

      <div class="page-shell relative z-10">
        <div class="mx-auto max-w-3xl text-center">
          <div class="chip mx-auto mb-5">
            <span class="mini-label text-emerald-400">Front-Office Operations</span>
          </div>
          
          <h1 class="text-3xl font-bold leading-[1.1] text-[#fcfdff] sm:text-5xl lg:text-6xl font-heading tracking-tight">
            Everything your clothing boutique needs to <span class="text-emerald-400">run front-office operations 24/7.</span>
          </h1>
          
          <p class="section-copy mx-auto mt-5 max-w-2xl text-base sm:text-lg">
            Turn Instagram &amp; Facebook Reel comments and WhatsApp inquiries into completed orders — with live tracking updates and routine exchange validation — automatically. No website, Shopify store, or coding required.
          </p>

          <div class="mt-8 flex flex-wrap justify-center gap-3.5">
            <a href="/free-trial" class="btn-primary">Start 30-Day Free Trial &rarr;</a>
            <a
              href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary inline-flex items-center gap-2"
            >
              💬 Test Drive the Bot on WhatsApp
            </a>
          </div>

          <div class="mt-6 flex items-center justify-center gap-4 text-xs font-mono text-slate-400">
            <span>✓ No Website Needed</span>
            <span>&bull;</span>
            <span>✓ 100% White-Glove Setup</span>
            <span>&bull;</span>
            <span>✓ WhatsApp, Instagram &amp; Facebook</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Before vs After — kid-simple: left pain, right fix -->
    <section class="border-y border-white/[0.08] bg-[#06060a] py-12 sm:py-16">
      <div class="page-shell">
        <div class="max-w-2xl mx-auto text-center mb-10">
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-emerald-400">The Boutique Transformation</span>
          <h2 class="section-title mt-2">Manual DM Selling vs VoluChat AI</h2>
        </div>

        <div class="grid gap-10 lg:grid-cols-2 max-w-5xl mx-auto">
          <div>
            <p class="font-mono text-[11px] uppercase tracking-widest text-rose-400 mb-2">✕ Before: manual struggle</p>
            {
              transformationPoints.slice(0, 3).map((point) => (
                <div class="hairline-row">
                  <p class="text-sm text-[#86868b] leading-relaxed">{point.before}</p>
                </div>
              ))
            }
          </div>
          <div class="visual-frame">
            <p class="font-mono text-[11px] uppercase tracking-widest text-emerald-300 mb-3">✓ After: VoluChat does it</p>
            <div class="space-y-3">
              {
                transformationPoints.slice(0, 3).map((point) => (
                  <div class="chat-ai">{point.after}</div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 Core Feature Pillars — alternating visual story -->
    <section class="relative py-16 sm:py-24 bg-[#000000]">
      <div class="page-shell space-y-16 sm:space-y-24 max-w-5xl mx-auto">
        {
          featurePillars.map((pillar, pIdx) => (
            <article class="reveal-on-scroll border-t border-white/[0.08] pt-10">
              <div class={`grid gap-8 lg:gap-12 items-start lg:grid-cols-2`}>
                <div class={pIdx % 2 === 1 ? "lg:order-2" : ""}>
                  <div class="flex items-center gap-3">
                    <span class="grid h-8 w-8 place-items-center rounded-full bg-transparent border border-white/[0.14] font-mono text-xs font-bold text-white">
                      {pillar.number}
                    </span>
                    <span class="font-mono text-[11px] font-semibold text-[#a1a1a6] uppercase tracking-wider">
                      {pillar.tag}
                    </span>
                  </div>
                  <h2 class="mt-3 text-2xl sm:text-3xl font-bold font-heading text-white tracking-tight">
                    {pillar.title}
                  </h2>
                  <p class="mt-2 text-base font-semibold text-slate-200 font-heading">
                    {pillar.subtitle}
                  </p>
                  <p class="mt-2 text-sm text-[#86868b] font-normal leading-relaxed">
                    {pillar.description}
                  </p>
                  <div class="mt-4">
                    <span class="win-pill">{pillar.highlight}</span>
                  </div>
                  <div class="mt-6 space-y-0">
                    {pillar.items.map((item) => (
                      <div class="hairline-row !py-4">
                        <h3 class="font-heading text-sm font-bold text-white">
                          <span class="text-emerald-400 mr-2">•</span>{item.title}
                        </h3>
                        <p class="mt-1 text-sm text-[#86868b] leading-relaxed">
                          {item.desc}
                        </p>
                      </div>
                    ))}
                  </div>
                </div>
                <div class={`visual-frame ${pIdx % 2 === 1 ? "lg:order-1" : ""} lg:sticky lg:top-24`}>
                  <p class="font-mono text-[11px] uppercase tracking-widest text-[#a1a1a6]">See it in chat</p>
                  <div class="mt-4 space-y-3">
                    <div class="chat-user">{pillar.subtitle}</div>
                    <div class="chat-ai">{pillar.highlight} — done inside WhatsApp, no website needed.</div>
                    <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-4 flex items-center justify-between">
                      <span class="text-sm font-semibold text-white">{pillar.tag}</span>
                      <span class="text-xs font-mono text-emerald-300">✓ Automated</span>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Bottom Conversion CTA Section -->
    <section class="border-t border-white/[0.08] bg-gradient-to-b from-[#08090e] to-[#040507] py-16 sm:py-20 text-center">
      <div class="page-shell">
        <div class="max-w-2xl mx-auto">
          <div class="chip mx-auto mb-4">
            <span class="mini-label text-emerald-400">First 10 Stores Only</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-bold text-white font-heading">
            Ready to hire your boutique's AI front-office employee?
          </h2>
          <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed">
            Get 30 days free with 100% done-for-you setup. We upload your catalog, set up WhatsApp APIs, configure tracking and exchange rules, and calibrate your AI employee on your brand voice.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3.5">
            <a href="/free-trial" class="btn-primary">Start 30-Day Free Trial &rarr;</a>
            <a
              href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary inline-flex items-center gap-2"
            >
              💬 Test Drive the Bot on WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>
