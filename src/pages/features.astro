---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "VoluChat Features — AI Sales Stylist for Fashion Brands";
const seoDescription =
  "Explore VoluChat features: Instagram comment-to-DM, WhatsApp sizing qualification, live stock checks, upsells, and 1-click UPI checkout.";
const seoKeywords =
  "VoluChat features, fashion WhatsApp sales bot, Instagram DM sizing agent, boutique cart recovery WhatsApp, clothing in-chat checkout";
const siteUrl = "https://www.voluchat.com";

const featureCategories = [
  {
    category: "01 / Lead Capture & Top-of-Funnel",
    title: "Comment-to-DM & Instant Outreach",
    desc: "Capture active buyer intent within seconds of public interaction across Instagram and Meta ads.",
    badge: "Top of Funnel",
    features: [
      {
        icon: "⚡",
        title: "2-Second Auto DM Dispatch",
        desc: "Instantly detects buyer comments ('Price?', 'Available?', 'Size M?') on Reels and ads, triggering a direct message before the shopper scrolls away.",
      },
      {
        icon: "🎯",
        title: "Post & Reel Context Mapping",
        desc: "The agent understands the exact product SKU, variant, and pricing shown in the specific video or post the shopper commented on.",
      },
      {
        icon: "🔗",
        title: "Seamless WhatsApp Handoff",
        desc: "Moves qualified buyers from Instagram DMs directly into your official WhatsApp chat with conversation history preserved.",
      },
    ],
  },
  {
    category: "02 / Catalog & Product Advisory",
    title: "Catalog Intelligence & Sizing Advisory",
    desc: "Provide real-time product answers grounded in your live Shopify catalog with zero guesswork or hallucinations.",
    badge: "Catalog Brain",
    features: [
      {
        icon: "📦",
        title: "Real-Time Shopify Stock Check",
        desc: "Verifies live variant stock counts before confirming availability. Never sells an out-of-stock size or backordered variant.",
      },
      {
        icon: "📏",
        title: "Conversational Sizing Guidance",
        desc: "Answers complex buyer sizing questions, recommends sizing based on height/fit preferences, and shares accurate size charts in-chat.",
      },
      {
        icon: "🧵",
        title: "Fabric, Care & Styling Advice",
        desc: "Trained on your product specifications to explain material composition, wash instructions, styling tips, and matching accessories.",
      },
    ],
  },
  {
    category: "03 / Autonomous Closer & Negotiation",
    title: "WhatsApp Sales Closer Engine",
    desc: "Autonomous conversational closing that addresses buyer hesitations and seals orders 24/7.",
    badge: "Sales Closer",
    features: [
      {
        icon: "🌙",
        title: "24/7 Night-Shift Sales Closer",
        desc: "Captures and closes the 40%+ of social purchases that happen between 10 PM and 8 AM when human teams are offline.",
      },
      {
        icon: "🏷️",
        title: "Margin-Safe Incentive Engine",
        desc: "Strategically offers pre-approved prepaid discounts (e.g. 5–10% off for instant UPI) to incentivize upfront payment and stop abandoned chats.",
      },
      {
        icon: "🚚",
        title: "Pincode SLA & Delivery Confirmation",
        desc: "Instantly checks courier delivery feasibility and confirms realistic transit timelines before the customer asks.",
      },
    ],
  },
  {
    category: "04 / In-Chat Checkout & Fulfillment",
    title: "Native Payment & Order Settlement",
    desc: "Frictionless checkout experience without sending shoppers to external website browsers.",
    badge: "Checkout & Sync",
    features: [
      {
        icon: "💳",
        title: "1-Click UPI & Instant Payment Link",
        desc: "Generates quick UPI / payment links directly inside WhatsApp, allowing buyers to pay in under 90 seconds.",
      },
      {
        icon: "🔄",
        title: "Automatic Shopify Admin Sync",
        desc: "Creates paid orders or draft orders in Shopify with customer address and SKU details pre-populated instantly upon settlement.",
      },
      {
        icon: "📍",
        title: "Automated Tracking & Status Updates",
        desc: "Pushes real-time order confirmation and courier tracking links directly to the customer's WhatsApp thread.",
      },
    ],
  },
  {
    category: "05 / Safety, Control & Analytics",
    title: "Guardrails & Human-in-the-Loop",
    desc: "Complete operational control, margin protection, and revenue tracking across every conversation.",
    badge: "Brand Safety",
    features: [
      {
        icon: "🛡️",
        title: "Strict Margin Floors & Ceilings",
        desc: "Hardcoded limits ensure the agent never offers discounts exceeding your predefined maximum margin threshold.",
      },
      {
        icon: "🙋",
        title: "1-Click Human Handoff",
        desc: "Detects custom requests, bridal inquiries, or sensitive escalations and immediately alerts human sales reps on WhatsApp.",
      },
      {
        icon: "📊",
        title: "Direct Revenue Attribution",
        desc: "Tracks every rupee earned back to the exact Reel, comment, and chat thread that generated the order.",
      },
    ],
  },
];

const technicalSpecs = [
  {
    title: "Meta Cloud API Integration",
    detail: "Official Meta & WhatsApp Business Cloud API — 100% compliant, zero scraping, no account ban risks.",
  },
  {
    title: "Shopify Webhooks & GraphQL Sync",
    detail: "Sub-second bidirectional synchronization with Shopify inventory, pricing, variant metadata, and order creation.",
  },
  {
    title: "Sub-2s Response Latency",
    detail: "High-performance inference pipeline delivers conversational responses in under 2 seconds to maximize buyer impulse.",
  },
  {
    title: "Multi-Agent Workflow Architecture",
    detail: "Modular agents specialized in capture, sizing advisory, negotiation, and settlement working as a single unified engine.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: seoTitle,
    description: seoDescription,
    url: `${siteUrl}/features`,
  },
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    name: "VoluChat Platform Capabilities",
    description:
      "Core features of VoluChat's autonomous e-commerce automation agent for Instagram and WhatsApp DMs — upsells, cross-sells, cart recovery, and in-chat checkout.",
    url: `${siteUrl}/features`,
    hasDefinedTerm: featureCategories.flatMap((group) => [
      {
        "@type": "DefinedTerm",
        name: group.title,
        description: group.desc,
        inDefinedTermSet: `${siteUrl}/features`,
      },
      ...group.features.map((feat) => ({
        "@type": "DefinedTerm",
        name: feat.title,
        description: feat.desc,
        inDefinedTermSet: `${siteUrl}/features`,
      })),
    ]),
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/features", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema()]}
>
  <Navbar />

  <main class="overflow-hidden">
    <section class="hero-stripe">
      <div class="section-glow-emerald"></div>
      <div class="sect-grid opacity-30"></div>

      <div class="page-shell">
        <div class="mx-auto max-w-4xl text-center">
          <div class="chip mx-auto">
            <span class="mini-label">Platform Capabilities</span>
          </div>
          <h1
            class="mt-6 text-4xl font-semibold leading-[1.04] text-[#fcfdff] sm:text-6xl lg:text-7xl font-heading"
          >
            Everything you need to
            <span class="block text-emerald-400">automate social sales.</span>
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-2xl">
            A comprehensive breakdown of VoluChat's autonomous commerce features — from viral comment capture to 90-second WhatsApp checkout and Shopify fulfillment.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/contact" class="btn-primary">Book a Live Demo &rarr;</a>
            <a href="/compare" class="btn-secondary">Compare vs Wati / Manychat</a>
          </div>
        </div>
      </div>
    </section>

    <section class="relative pb-20 sm:pb-28 bg-[#000000]">
      <div class="page-shell space-y-10 sm:space-y-14">
        {
          featureCategories.map((group) => (
            <article class="solid-card p-6 sm:p-10">
              <header class="flex flex-col gap-3 border-b border-white/[0.08] pb-6 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <span class="mb-1.5 block font-mono text-xs font-bold uppercase tracking-widest text-emerald-400">
                    {group.category}
                  </span>
                  <h2 class="text-2xl font-heading font-semibold text-[#fcfdff] sm:text-3xl">
                    {group.title}
                  </h2>
                </div>
                <span class="w-fit rounded-full border border-white/[0.08] bg-[#101012] px-3.5 py-1 font-mono text-xs font-medium text-emerald-300">
                  {group.badge}
                </span>
              </header>

              <p class="mb-8 mt-6 max-w-3xl text-sm font-normal leading-relaxed text-[rgba(252,253,255,0.7)] sm:text-base">
                {group.desc}
              </p>

              <div class="grid gap-4 md:grid-cols-3">
                {group.features.map((feat) => (
                  <article class="solid-card-subtle flex flex-col justify-between">
                    <div>
                      <div class="mb-4 grid h-9 w-9 place-items-center rounded-lg border border-white/[0.14] bg-[#101012] text-lg text-emerald-300">
                        {feat.icon}
                      </div>
                      <h3 class="font-heading text-base font-semibold text-[#fcfdff]">
                        {feat.title}
                      </h3>
                      <p class="mt-2 text-xs font-normal leading-relaxed text-[rgba(252,253,255,0.7)] sm:text-sm">
                        {feat.desc}
                      </p>
                    </div>
                  </article>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="relative border-y border-white/[0.08] bg-[#06060a] py-16 sm:py-24">
      <div class="page-shell">
        <div class="mb-12 max-w-3xl">
          <div class="chip mb-3">
            <span class="mini-label">Under the Hood</span>
          </div>
          <h2 class="section-title text-[#fcfdff] font-heading">
            Enterprise-grade infrastructure.
          </h2>
          <p class="section-copy mt-4">
            Engineered for high-volume D2C brands that require sub-second speeds, zero downtime, and total security.
          </p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            technicalSpecs.map((spec, idx) => (
              <div class="solid-card p-6">
                <span class="font-mono text-xs font-bold text-emerald-400">
                  0{idx + 1}
                </span>
                <h3 class="mt-3 font-heading text-base font-semibold text-[#fcfdff]">
                  {spec.title}
                </h3>
                <p class="mt-2 text-xs font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">
                  {spec.detail}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>
