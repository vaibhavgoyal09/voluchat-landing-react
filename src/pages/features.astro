---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "VoluChat Features — WhatsApp AI Sales Agent for Fashion Boutiques";
const seoDescription =
  "Explore VoluChat features: Instagram comment-to-DM, AI sizing stylist, 1-click UPI checkout, and 24/7 WhatsApp sales automation for clothing boutiques — no website required.";
const seoKeywords =
  "WhatsApp sales agent features, fashion boutique DM automation, Instagram comment to DM clothing, AI sizing stylist WhatsApp, in-chat UPI checkout, sell on WhatsApp without website";
const siteUrl = "https://www.voluchat.com";

const featurePillars = [
  {
    number: "01",
    tag: "Lead Capture",
    title: "Instant Comment-to-DM Sales Engine",
    subtitle: "Turn viral Instagram Reel comments into buying conversations in 2 seconds.",
    description: "When a shopper comments 'Price?' or 'Available?' on your Instagram Reel, they want an answer immediately. VoluChat auto-replies to their comment and slides into their DMs with exact pricing, photos, and a direct WhatsApp link before they scroll away.",
    highlight: "2.0s Response Time",
    items: [
      {
        title: "2-Second Reel Comment Auto-Reply",
        desc: "Instantly acknowledges comments on your posts, Reels, and ads, driving public curiosity into private sales conversations.",
      },
      {
        title: "Exact Reel & Product Recognition",
        desc: "Knows the exact dress, lehenga, or co-ord set shown in the specific Reel the customer commented on.",
      },
      {
        title: "1-Click WhatsApp Transfer",
        desc: "Smoothly shifts ready-to-buy customers from Instagram DMs into your official WhatsApp chat with product context intact.",
      },
    ],
  },
  {
    number: "02",
    tag: "AI Stylist",
    title: "AI Fashion Stylist & Sizing Expert",
    subtitle: "Answer sizing, fabric, and styling questions without typing a single word.",
    description: "Stop answering 'Is size M true to size?' fifty times a day. VoluChat understands your sizing charts, bust/waist measurements, fabric composition, and wash care instructions to guide customers to the right fit with zero hesitation.",
    highlight: "Zero Sizing Confusion",
    items: [
      {
        title: "Measurement & Fit Recommendation",
        desc: "Asks customer height and fit preferences to recommend the exact size, drastically reducing post-purchase exchange requests.",
      },
      {
        title: "Fabric, Quality & Care Details",
        desc: "Explains pure cotton, georgette, chanderi silk details, lining information, and care tips directly in the chat.",
      },
      {
        title: "Smart Styling & Cross-Sell Add-ons",
        desc: "Suggests matching dupattas, jewelry, or complementary pieces to increase average order value naturally.",
      },
    ],
  },
  {
    number: "03",
    tag: "In-Chat Checkout",
    title: "1-Click UPI Payment & Instant Settlement",
    subtitle: "Collect payments inside WhatsApp without sending QR codes or asking for screenshots.",
    description: "Forget typing your Google Pay number and begging customers for transaction screenshots. VoluChat generates 1-click UPI links (GPay, PhonePe, Paytm, CRED) directly in chat so customers can pay in 15 seconds.",
    highlight: "15-Second Checkout",
    items: [
      {
        title: "1-Click UPI Payment Links",
        desc: "Generates instant payment links that open Google Pay, PhonePe, or Paytm directly on the customer's phone.",
      },
      {
        title: "Zero Screenshot Verification",
        desc: "Payments are verified automatically via secure gateway webhooks — no manual bank checking or screenshot matching.",
      },
      {
        title: "Prepaid Discount Incentives",
        desc: "Strategically offers small prepaid discounts (e.g. ₹100 off on instant UPI) to eliminate COD orders and avoid fake deliveries.",
      },
    ],
  },
  {
    number: "04",
    tag: "Zero-Website Selling",
    title: "Catalog & Order Management Without a Website",
    subtitle: "Manage your collection and customer orders using simple spreadsheets or photos.",
    description: "You don't need a ₹50,000 Shopify website to run an automated boutique. Upload your product photos, sizes, and prices via Google Sheets or chat. VoluChat tracks stock, collects customer addresses, and logs orders cleanly.",
    highlight: "Zero Website Required",
    items: [
      {
        title: "Simple Sheet or Photo Catalog Sync",
        desc: "Sync products easily from Google Sheets or image folders — no complex e-commerce dashboard needed.",
      },
      {
        title: "Automated Address & Pincode Capture",
        desc: "Collects complete delivery address, pincode, and contact number in chat, validating courier serviceable areas.",
      },
      {
        title: "Optional Shopify Sync Available",
        desc: "Already have a Shopify store? VoluChat connects optionally to sync inventory and create draft orders automatically.",
      },
    ],
  },
  {
    number: "05",
    tag: "24/7 Closer & Control",
    title: "24/7 Night-Shift Closer with Live Human Takeover",
    subtitle: "Close midnight orders while you sleep, with instant alerts for custom bridal requests.",
    description: "Over 50% of boutique shopping happens after 9 PM. VoluChat works all night closing orders while you sleep, but immediately notifies your phone if a VIP customer requests custom bridal stitching or personal styling.",
    highlight: "24/7 Automated Revenue",
    items: [
      {
        title: "Late-Night Automated Sales Closer",
        desc: "Answers pricing, qualifies sizing, and collects UPI payments from 11 PM to 4 AM when manual staff is asleep.",
      },
      {
        title: "Instant Human Escalation on WhatsApp",
        desc: "Detects custom bridal requests, bulk orders, or complaints and notifies you on WhatsApp for 1-click human takeover.",
      },
      {
        title: "Strict Margin Protection Floors",
        desc: "Hardcoded safety rules ensure the AI never quotes wrong prices or offers discounts beyond your approved limits.",
      },
    ],
  },
];

const transformationPoints = [
  {
    before: "Waking up to 40 unread 'Price?' DMs with buyers already gone",
    after: "Every DM answered in 2s with photos & sizes closed overnight",
  },
  {
    before: "Typing out GPay numbers and waiting hours for payment screenshots",
    after: "Instant 1-click UPI link with automatic payment confirmation",
  },
  {
    before: "Manually measuring dresses and sending size charts 50x a day",
    after: "AI Stylist qualifies height and fit recommendations in seconds",
  },
  {
    before: "Copy-pasting customer addresses from chat into messy spreadsheets",
    after: "Clean address, pincode, and order details logged automatically",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: seoTitle,
    description: seoDescription,
    url: `${siteUrl}/features`,
  },
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    name: "VoluChat Boutique WhatsApp Sales Capabilities",
    description:
      "Features of VoluChat's WhatsApp AI Sales Agent for clothing and fashion boutiques selling directly in DMs without needing a website.",
    url: `${siteUrl}/features`,
    hasDefinedTerm: featurePillars.flatMap((pillar) => [
      {
        "@type": "DefinedTerm",
        name: pillar.title,
        description: pillar.description,
        inDefinedTermSet: `${siteUrl}/features`,
      },
      ...pillar.items.map((item) => ({
        "@type": "DefinedTerm",
        name: item.title,
        description: item.desc,
        inDefinedTermSet: `${siteUrl}/features`,
      })),
    ]),
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/features", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema()]}
>
  <Navbar />

  <main class="overflow-hidden">
    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-32 pb-16 sm:pt-40 sm:pb-20 bg-[#000000]">
      <!-- Background Ambient Glow -->
      <div class="absolute left-1/2 top-1/4 -z-10 h-[450px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(ellipse,rgba(16,185,129,0.15),transparent_70%)] blur-[90px] pointer-events-none"></div>
      <div class="sect-grid opacity-20 pointer-events-none"></div>

      <div class="page-shell relative z-10">
        <div class="mx-auto max-w-3xl text-center">
          <div class="chip mx-auto mb-5">
            <span class="mini-label text-emerald-400">Boutique Sales Automation</span>
          </div>
          
          <h1 class="text-3xl font-bold leading-[1.1] text-[#fcfdff] sm:text-5xl lg:text-6xl font-heading tracking-tight">
            Everything your clothing boutique needs to <span class="text-emerald-400">sell on WhatsApp 24/7.</span>
          </h1>
          
          <p class="section-copy mx-auto mt-5 max-w-2xl text-base sm:text-lg">
            Turn Instagram &amp; Facebook Reel comments and WhatsApp inquiries into completed UPI orders automatically. No website, Shopify store, or coding required.
          </p>

          <div class="mt-8 flex flex-wrap justify-center gap-3.5">
            <a href="/free-trial" class="btn-primary">Start 30-Day Free Trial &rarr;</a>
            <a
              href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary inline-flex items-center gap-2"
            >
              💬 Test Drive the Bot on WhatsApp
            </a>
          </div>

          <div class="mt-6 flex items-center justify-center gap-4 text-xs font-mono text-slate-400">
            <span>✓ No Website Needed</span>
            <span>&bull;</span>
            <span>✓ 100% White-Glove Setup</span>
            <span>&bull;</span>
            <span>✓ WhatsApp, Instagram &amp; Facebook</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Before vs After Comparison Strip -->
    <section class="border-y border-white/[0.08] bg-[#06060a] py-12 sm:py-16">
      <div class="page-shell">
        <div class="max-w-2xl mx-auto text-center mb-10">
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-emerald-400">The Boutique Transformation</span>
          <h2 class="text-xl sm:text-2xl font-bold text-white font-heading mt-1">Manual DM Selling vs VoluChat AI</h2>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 max-w-6xl mx-auto">
          {
            transformationPoints.map((point) => (
              <div class="rounded-2xl border border-white/[0.08] bg-[#0a0a0e] p-5 flex flex-col justify-between">
                <div class="border-b border-white/[0.06] pb-3 mb-3">
                  <span class="text-[10px] font-mono uppercase text-rose-400 font-semibold tracking-wider block mb-1">Manual Struggle</span>
                  <p class="text-xs text-slate-400 font-normal leading-relaxed">{point.before}</p>
                </div>
                <div>
                  <span class="text-[10px] font-mono uppercase text-emerald-400 font-semibold tracking-wider block mb-1">With VoluChat</span>
                  <p class="text-xs font-medium text-white leading-relaxed">{point.after}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 5 Core Feature Pillars -->
    <section class="relative py-16 sm:py-24 bg-[#000000]">
      <div class="page-shell space-y-12 sm:space-y-16">
        {
          featurePillars.map((pillar) => (
            <article class="reveal-on-scroll rounded-3xl border border-white/[0.10] bg-gradient-to-b from-[#0e1017] via-[#0a0b0f] to-[#07080a] p-6 sm:p-10 lg:p-12 shadow-xl relative overflow-hidden">
              <!-- Top Header Block -->
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-white/[0.08] pb-6 mb-6">
                <div class="flex items-center gap-3">
                  <span class="grid h-8 w-8 place-items-center rounded-lg bg-emerald-500/15 border border-emerald-500/30 font-mono text-xs font-bold text-emerald-400">
                    {pillar.number}
                  </span>
                  <div>
                    <span class="font-mono text-[11px] font-semibold text-emerald-400 uppercase tracking-wider block">
                      {pillar.tag}
                    </span>
                    <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold font-heading text-white mt-0.5">
                      {pillar.title}
                    </h2>
                  </div>
                </div>

                <span class="w-fit rounded-full border border-emerald-500/25 bg-emerald-500/10 px-3.5 py-1 font-mono text-xs font-semibold text-emerald-300 self-start sm:self-auto">
                  {pillar.highlight}
                </span>
              </div>

              <!-- Context Description -->
              <div class="max-w-3xl mb-8">
                <p class="text-sm sm:text-base font-semibold text-slate-200 mb-2 font-heading">
                  {pillar.subtitle}
                </p>
                <p class="text-xs sm:text-sm text-[rgba(252,253,255,0.7)] font-normal leading-relaxed">
                  {pillar.description}
                </p>
              </div>

              <!-- 3-Column Specific Breakdown -->
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {pillar.items.map((item) => (
                  <div class="rounded-2xl border border-white/[0.06] bg-[#12141c]/80 p-5 flex flex-col justify-between hover:border-emerald-500/30 transition-all">
                    <div>
                      <div class="flex items-center gap-2 mb-2">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                        <h3 class="font-heading text-sm font-bold text-white">
                          {item.title}
                        </h3>
                      </div>
                      <p class="text-xs text-[rgba(252,253,255,0.65)] font-normal leading-relaxed">
                        {item.desc}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Bottom Conversion CTA Section -->
    <section class="border-t border-white/[0.08] bg-gradient-to-b from-[#08090e] to-[#040507] py-16 sm:py-20 text-center">
      <div class="page-shell">
        <div class="max-w-2xl mx-auto">
          <div class="chip mx-auto mb-4">
            <span class="mini-label text-emerald-400">First 10 Stores Only</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-bold text-white font-heading">
            Ready to automate your boutique sales on WhatsApp?
          </h2>
          <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed">
            Get 30 days free with 100% done-for-you setup. We upload your catalog, set up WhatsApp APIs, and calibrate your AI stylist on your brand voice.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3.5">
            <a href="/free-trial" class="btn-primary">Start 30-Day Free Trial &rarr;</a>
            <a
              href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary inline-flex items-center gap-2"
            >
              💬 Test Drive the Bot on WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>
