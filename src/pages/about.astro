---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "About VoluChat — Autonomous WhatsApp Commerce";
const seoDescription =
  "Learn why we're building VoluChat — zero-config autonomous AI sales agents on WhatsApp and Instagram for fashion and clothing boutiques.";
const seoKeywords =
  "About VoluChat, QubitNine Technologies, WhatsApp sales bot story, ecommerce sales automation, boutique WhatsApp DM agent, Vaibhav Goyal";
const siteUrl = "https://www.voluchat.com";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/about`,
  mainEntity: {
    "@type": "Organization",
    name: "VoluChat",
    legalName: "QubitNine Technologies Pvt. Ltd.",
    url: siteUrl,
    logo: `${siteUrl}/voluchat_logo.svg`,
    founder: {
      "@type": "Person",
      name: "Vaibhav Goyal",
      jobTitle: "Founder & CEO",
      description:
        "Former e-commerce Sales Manager turned founder, building zero-config autonomous sales intelligence for online merchants.",
    },
    address: {
      "@type": "PostalAddress",
      addressLocality: "Noida",
      addressRegion: "Uttar Pradesh",
      addressCountry: "India",
    },
    sameAs: [
      "https://www.instagram.com/voluchat",
      "https://x.com/voluchat",
      "https://www.linkedin.com/company/voluchat",
      "https://www.youtube.com/@voluchat",
    ],
  },
};

const frontlineProblems = [
  {
    icon: "🔍",
    leak: "01",
    title: "The Camera Roll Photo Hunt",
    desc: "Sales reps wasted 10–15 minutes scrolling through thousands of photos in phone albums just to find specific product angles, fabric swatches, or size charts requested by a shopper.",
  },
  {
    icon: "⏳",
    leak: "02",
    title: "The Window-Shopper Drain",
    desc: "Reps spent 80% of their day fielding repetitive questions from casual tire-kickers, while high-intent, ready-to-pay buyers waited in line and eventually bought elsewhere.",
  },
  {
    icon: "🌙",
    leak: "03",
    title: "The Midnight Revenue Bleed",
    desc: "Peak social shopping happens between 9 PM and 2 AM. When sales reps went to sleep, hot inbound DM leads went stone cold by morning.",
  },
  {
    icon: "🚫",
    leak: "04",
    title: "Selling Out-of-Stock Variants",
    desc: "Without live inventory synchronization, reps frequently accepted customer payments for sizes or colors that were already sold out, triggering costly refunds and frustrated buyers.",
  },
  {
    icon: "📋",
    leak: "05",
    title: "Manual Order Chaos",
    desc: "Copy-pasting shipping addresses from chat threads, verifying screenshot receipts, and manually creating invoices led to frequent fulfillment mistakes.",
  },
  {
    icon: "📊",
    leak: "06",
    title: "Zero Sales Accountability",
    desc: "Merchants had zero visibility into why deals were lost, which objections killed conversions, or how much revenue was slipping through unanswered chats.",
  },
];

const operatingPrinciples = [
  {
    number: "01",
    title: "Zero-Config Simplicity",
    desc: "Running an online store is already hard enough. Merchants shouldn't have to become prompt engineers or flowchart architects. We provide full setup white-glove, out of the box.",
  },
  {
    number: "02",
    title: "10x Value Standard",
    desc: "We don't charge for software that sits idle or delivers vanity metrics. If VoluChat doesn't generate at least 10x measurable ROI for our partner stores, we have failed.",
  },
  {
    number: "03",
    title: "Zero Hallucination Guardrails",
    desc: "Conversational speed means nothing if the bot promises discounts that erode margins or confirms items that are out of stock. Deterministic guardrails protect your brand.",
  },
  {
    number: "04",
    title: "Instant Human Escalation",
    desc: "AI should handle 80% of repetitive qualification and closing, but step aside seamlessly when bespoke requests or complex human judgment are needed.",
  },
];

const companyFacts = [
  { label: "Legal Entity", value: "QubitNine Technologies Pvt. Ltd." },
  { label: "Headquarters", value: "Noida, Uttar Pradesh, India" },
  { label: "Leadership", value: "Vaibhav Goyal (Founder & CEO)" },
  { label: "Operating Stage", value: "Private 10-Store Founder Pilot" },
  { label: "Direct Inquiries", value: "founders@voluchat.com" },
  { label: "Core Platform", value: "Meta Cloud API & WhatsApp Engine" },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/about", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="overflow-hidden">
    <!-- Hero Section -->
    <section class="hero-stripe text-left">
      <div class="section-glow-emerald"></div>
      <div class="sect-grid opacity-20"></div>

      <div class="page-shell">
        <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div class="abt-hero-text">
            <div class="chip mb-6">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 mr-1.5"></span>
              The VoluChat Story
            </div>
            <h1
              class="text-4xl font-semibold leading-[1.08] text-[#fcfdff] sm:text-6xl font-heading"
            >
              Running an online store was never meant to be a headache.
            </h1>
            <p class="section-copy mt-6 max-w-xl text-lg leading-relaxed">
              VoluChat was born directly on the frontline of e-commerce sales. We saw brilliant merchants spend lakhs on marketing, only to drown in chaotic WhatsApp chats, lost night-time orders, and out-of-stock mishaps.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/contact" class="btn-primary">Apply for Pilot Cohort &rarr;</a>
              <a href="#origin" class="btn-secondary">Read Our Genesis</a>
            </div>
          </div>

          <div class="abt-hero-image solid-card p-2">
            <img
              src="/about_hero.webp"
              alt="Autonomous commerce workspace by VoluChat"
              class="h-full w-full rounded-lg object-cover"
              width="1024"
              height="1024"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Origin Story / Frontline Reality -->
    <section id="origin" class="abt-origin-section relative overflow-hidden py-20 sm:py-24 border-t border-white/[0.08] bg-[#06060a]">
      <div class="page-shell">
        <div class="max-w-3xl">
          <p class="section-eyebrow">The Genesis</p>
          <h2 class="section-title mt-3 text-[#fcfdff] font-heading text-3xl sm:text-5xl">
            Built from real frontline frustration, not a Silicon Valley whiteboard.
          </h2>
          <p class="mt-5 text-base sm:text-lg font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">
            While working as a <strong>Sales Manager</strong> for an online commerce store, our founder lived through the daily chaos of social selling. Social media brought massive organic and paid traffic, but closing orders manually over WhatsApp DMs was fundamentally broken.
          </p>
        </div>

        <!-- 6 Frontline Leaks Grid -->
        <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {
            frontlineProblems.map((item) => (
              <div class="abt-problem-card solid-card p-6 sm:p-7">
                <div class="flex items-center justify-between">
                  <span class="text-2xl">{item.icon}</span>
                  <span class="font-mono text-xs font-bold text-emerald-400 bg-[#101012] px-2.5 py-0.5 rounded-full border border-white/[0.08]">
                    PROBLEM {item.leak}
                  </span>
                </div>
                <h3 class="mt-5 text-lg font-heading font-semibold text-[#fcfdff]">
                  {item.title}
                </h3>
                <p class="mt-2.5 text-sm leading-relaxed text-[rgba(252,253,255,0.7)] font-normal">
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>

        <div class="mt-10 solid-card-elevated p-8 sm:p-10">
          <h3 class="text-xl sm:text-2xl font-heading font-semibold text-[#fcfdff]">
            The Bot Dilemma: Why Flowcharts Failed
          </h3>
          <p class="mt-4 text-sm sm:text-base font-normal text-[rgba(252,253,255,0.7)] leading-relaxed">
            When trying existing automation tools (ManyChat, Wati, flowchart bots), we ran into another wall: they required weeks of complex setup, logic diagrams, and ongoing maintenance. Non-technical store owners were forced to become prompt engineers and software architects just to send a product link.
          </p>
          <p class="mt-3 text-sm sm:text-base font-normal text-[rgba(252,253,255,0.86)] leading-relaxed">
            <strong>VoluChat exists to change that paradigm:</strong> deliver an autonomous, zero-config sales agent that works out of the box with live catalog synchronization, sizing qualification, and 1-click UPI checkout.
          </p>
        </div>
      </div>
    </section>

    <!-- Operating Principles -->
    <section class="abt-principles-section relative overflow-hidden py-20 sm:py-24 bg-[#000000]">
      <div class="page-shell">
        <div class="mx-auto max-w-3xl text-center">
          <p class="section-eyebrow">Our Standards</p>
          <h2 class="section-title mt-3 text-[#fcfdff] font-heading">
            How we operate and build
          </h2>
          <p class="section-copy mx-auto mt-4 max-w-2xl">
            Principles designed to eliminate merchant risk and build sustainable sales growth.
          </p>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-2">
          {
            operatingPrinciples.map((item) => (
              <article class="abt-principle-card solid-card p-7 sm:p-8">
                <div class="flex items-center gap-4">
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-[#101012] border border-white/[0.14] font-mono text-sm font-bold text-emerald-300">
                    {item.number}
                  </span>
                  <h3 class="text-xl font-heading font-semibold text-[#fcfdff]">
                    {item.title}
                  </h3>
                </div>
                <p class="mt-4 text-sm font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">
                  {item.desc}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- The Bigger Vision -->
    <section class="abt-vision-section relative overflow-hidden py-20 sm:py-24 border-t border-white/[0.08] bg-[#06060a]">
      <div class="page-shell">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div class="abt-vision-image solid-card p-2">
            <img
              src="/mission_collaboration.webp"
              alt="VoluChat e-commerce agent workflow"
              class="h-full w-full rounded-lg object-cover"
              width="1024"
              height="1024"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="abt-vision-text">
            <p class="section-eyebrow">The Horizon</p>
            <h2 class="mt-3 text-3xl font-heading font-semibold text-[#fcfdff] sm:text-5xl">
              Our vision goes far beyond a WhatsApp chatbot.
            </h2>
            <p class="mt-5 text-[rgba(252,253,255,0.7)] leading-relaxed text-base font-normal">
              A chat bot is just an interface. Our long-term mission is to build the <strong>autonomous operating layer for modern e-commerce</strong>.
            </p>
            <p class="mt-3 text-[rgba(252,253,255,0.7)] leading-relaxed text-base font-normal">
              From the moment an Instagram shopper comments on a video, to sizing guidance, intelligent inventory allocation, fraud-protected UPI payment links, and post-purchase support — VoluChat handles the heavy lifting so boutique founders can focus purely on product and brand storytelling.
            </p>

            <div class="mt-8 grid grid-cols-2 gap-4 border-t border-white/[0.08] pt-6">
              <div>
                <p class="text-2xl font-bold font-heading text-[#fcfdff]">Zero</p>
                <p class="text-xs text-slate-400 mt-1">Flowchart builder config required</p>
              </div>
              <div>
                <p class="text-2xl font-bold font-heading text-emerald-400">10x</p>
                <p class="text-xs text-slate-400 mt-1">Founder ROI value standard</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Company Transparency & Quick Facts -->
    <section class="abt-facts-section relative overflow-hidden py-20 sm:py-24 bg-[#000000]">
      <div class="page-shell">
        <div class="solid-card p-8 sm:p-12">
          <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:items-center">
            <div>
              <p class="section-eyebrow">Corporate Information</p>
              <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-[#fcfdff] mt-2">
                Company Transparency
              </h2>
              <p class="mt-4 text-sm text-[rgba(252,253,255,0.7)] leading-relaxed font-normal">
                VoluChat is developed and operated by <strong>QubitNine Technologies Pvt. Ltd.</strong>, headquartered in Noida, Uttar Pradesh, India.
              </p>
              <p class="mt-3 text-sm text-[rgba(252,253,255,0.7)] leading-relaxed font-normal">
                We are committed to enterprise data isolation, official Meta Cloud API compliance, and merchant margin safety.
              </p>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              {
                companyFacts.map((fact) => (
                  <div class="solid-card-subtle p-4">
                    <p class="text-xs font-mono font-medium text-slate-400 uppercase tracking-wider">
                      {fact.label}
                    </p>
                    <p class="text-sm font-semibold text-[#fcfdff] mt-1">
                      {fact.value}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Founder Commitment Card -->
    <section class="abt-founder-section relative pb-28 bg-[#000000]">
      <div class="page-shell">
        <div class="solid-card-elevated p-8 sm:p-12 text-center max-w-4xl mx-auto">
          <p class="section-eyebrow">Direct Founder Accountability</p>
          <blockquote class="mt-4 text-2xl sm:text-3xl font-heading font-semibold text-[#fcfdff] leading-relaxed">
            "I will deliver 10x the value of what we charge. Anything less is unacceptable."
          </blockquote>
          <p class="mt-6 text-[rgba(252,253,255,0.7)] max-w-2xl mx-auto text-sm sm:text-base leading-relaxed font-normal">
            For every brand joining our 10-Store Pilot Cohort, my team and I personally oversee catalog ingestion, Instagram hook tuning, and live sales qualification. No outsourced support, no junior account managers.
          </p>
          <div class="mt-8 flex flex-col items-center justify-center gap-2">
            <div class="relative mb-2">
              <img
                src="/founder_portrait.webp"
                alt="Vaibhav Goyal - Founder & CEO of VoluChat"
                class="h-16 w-16 sm:h-20 sm:w-20 rounded-full object-cover border-2 border-emerald-400/40 shadow-lg shadow-emerald-500/10"
                width="80"
                height="80"
                loading="lazy"
                decoding="async"
              />
              <span class="absolute bottom-1 right-1 h-3 w-3 rounded-full bg-emerald-500 ring-2 ring-[#0c0d12]"></span>
            </div>
            <p class="text-base font-semibold text-white">Vaibhav Goyal</p>
            <p class="text-xs font-mono text-emerald-300">Founder & CEO &bull; VoluChat / QubitNine Technologies</p>
            <div class="mt-4">
              <a href="/contact" class="btn-primary">Apply to Join the 10-Store Cohort &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // Hero Animation
    gsap.fromTo(
      ".abt-hero-text",
      { opacity: 0, x: -30, filter: "blur(5px)" },
      { opacity: 1, x: 0, filter: "blur(0px)", duration: 0.8, ease: "power2.out" }
    );
    gsap.from(".abt-hero-image", {
      opacity: 0,
      scale: 0.95,
      duration: 1,
      ease: "power3.out",
      immediateRender: true,
    });

    // Origin Problems Stagger
    const originTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".abt-origin-section",
        start: "top 75%",
        toggleActions: "play none none reverse",
      },
    });
    originTl.fromTo(
      ".abt-problem-card",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.5, stagger: 0.1, ease: "power2.out" }
    );

    // Principles Stagger
    const principlesTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".abt-principles-section",
        start: "top 75%",
        toggleActions: "play none none reverse",
      },
    });
    principlesTl.fromTo(
      ".abt-principle-card",
      { opacity: 0, y: 35 },
      { opacity: 1, y: 0, duration: 0.6, stagger: 0.12, ease: "power2.out" }
    );

    // Vision Animation
    const visionTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".abt-vision-section",
        start: "top 75%",
        toggleActions: "play none none reverse",
      },
    });
    visionTl
      .fromTo(
        ".abt-vision-image",
        { opacity: 0, x: -30 },
        { opacity: 1, x: 0, duration: 0.8, ease: "power2.out" }
      )
      .fromTo(
        ".abt-vision-text",
        { opacity: 0, x: 30 },
        { opacity: 1, x: 0, duration: 0.8, ease: "power2.out" },
        "-=0.5"
      );
  });
</script>
