---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About Us | VoluChat">
  <Header />

  <main class="pt-32 overflow-hidden">
    <!-- Hero Section -->
    <section class="relative px-6 pb-24">
      <div class="sect-grid"></div>
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="section-badge mb-6">Our Story</div>
            <h1 class="text-5xl md:text-6xl font-heading font-extrabold text-slate-900 mb-8 leading-tight">
              Bridging the Gap Between <span class="text-gradient-primary">Brands & Customers</span>
            </h1>
            <p class="text-lg text-slate-600 leading-relaxed mb-10 max-w-xl">
              VoluChat was born from a simple observation: modern brands are losing revenue because they can't keep up with the thousands of DMs and comments they receive every day. We're here to change that with AI that feels human.
            </p>
            <div class="flex flex-wrap gap-4">
              <div class="glass-card flex items-center gap-3 px-5 py-3 rounded-2xl">
                <span class="text-2xl font-bold text-indigo-600">5M+</span>
                <span class="text-sm text-slate-500 font-medium">Interactions<br/>Automated</span>
              </div>
              <div class="glass-card flex items-center gap-3 px-5 py-3 rounded-2xl">
                <span class="text-2xl font-bold text-purple-600">98%</span>
                <span class="text-sm text-slate-500 font-medium">Positive<br/>Sentiment</span>
              </div>
            </div>
          </div>
          <div class="relative group">
            <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-indigo-50/50 to-transparent -mb-12 rounded-3xl -z-10 blur-2xl opacity-50"></div>
            <div class="glass-panel p-3 rounded-[2rem] rotate-2 transition-transform group-hover:rotate-0 duration-700">
              <img 
                src="/about_hero.png" 
                alt="VoluChat Workspace" 
                class="rounded-[2rem] w-full shadow-2xl"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission Section -->
    <section class="py-24 relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="section-badge mb-6">Our Mission</div>
          <h2 class="text-4xl font-heading font-bold text-slate-900 mb-6">
            Empowering Human Creativity Through Intelligent Automation
          </h2>
          <p class="text-lg text-slate-600 leading-relaxed">
            We believe that entrepreneurs should spend their time creating and building, not copy-pasting the same reply to "What's the price?" a hundred times a day.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 mb-20">
          <div class="glass-card p-8 rounded-2xl group">
            <div class="w-12 h-12 bg-white/65 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">Security First</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              We treat your Instagram access tokens and customer data with the highest level of encryption and security standards.
            </p>
          </div>
          <div class="glass-card p-8 rounded-2xl group">
            <div class="w-12 h-12 bg-white/65 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">24/7 Availability</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Your business doesn't sleep, and neither does VoluChat. We ensure your customers get answers the second they ask.
            </p>
          </div>
          <div class="glass-card p-8 rounded-2xl group">
            <div class="w-12 h-12 bg-white/65 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">Seamless Growth</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Our tools are designed to scale with your brand, from your first 100 followers to your first million.
            </p>
          </div>
        </div>

        <div class="glass-panel p-4 rounded-[2rem] overflow-hidden group">
          <img 
            src="/mission_collaboration.png" 
            alt="Collaborating on VoluChat" 
            class="rounded-[1.8rem] w-full object-cover max-h-[500px] transition-transform duration-[2s] group-hover:scale-105"
          />
        </div>
      </div>
    </section>

    <!-- Values & Philosophy -->
    <section class="py-24 px-6 relative">
      <div class="max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 gap-20 items-center">
          <div>
            <h2 class="text-4xl font-heading font-extrabold text-slate-900 mb-10 leading-tight">
              We're building the future of <span class="text-gradient-primary">social commerce.</span>
            </h2>
            <div class="space-y-8">
              <div class="flex gap-4">
                <div class="mt-1 w-6 h-6 rounded-full bg-slate-900 flex-shrink-0 flex items-center justify-center text-white text-[10px]">1</div>
                <div>
                  <p class="font-bold text-slate-900 mb-1">AI with Context</p>
                  <p class="text-slate-600 text-sm">We don't just send automated replies. Our AI understands regional nuances and Hindi context to reply naturally.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="mt-1 w-6 h-6 rounded-full bg-slate-900 flex-shrink-0 flex items-center justify-center text-white text-[10px]">2</div>
                <div>
                  <p class="font-bold text-slate-900 mb-1">Human-in-the-loop</p>
                  <p class="text-slate-600 text-sm">Our lead handoff system ensures that when a conversation gets serious, a human is notified instantly on WhatsApp.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="mt-1 w-6 h-6 rounded-full bg-slate-900 flex-shrink-0 flex items-center justify-center text-white text-[10px]">3</div>
                <div>
                  <p class="font-bold text-slate-900 mb-1">Performance Driven</p>
                  <p class="text-slate-600 text-sm">Every DM automated and every lead captured is tracked. We focus on the metrics that drive your revenue.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="glass-dark rounded-[2rem] p-12 text-white relative">
            <div class="absolute -top-6 -right-6 w-24 h-24 bg-indigo-500 rounded-full blur-3xl opacity-50"></div>
            <div class="relative z-10">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="currentColor" class="text-indigo-400 mb-8 opacity-50 outline-none border-none"><path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C14.9124 8 14.017 7.10457 14.017 6V5C14.017 3.89543 14.9124 3 16.017 3H19.017C21.2261 3 23.017 4.79086 23.017 7V15C23.017 18.3137 20.3307 21 17.017 21H14.017ZM1.017 21L1.017 18C1.017 16.8954 1.91243 16 3.017 16H6.017C6.56928 16 7.017 15.5523 7.017 15V9C7.017 8.44772 6.56928 8 6.017 8H3.017C1.91243 8 1.017 7.10457 1.017 6V5C1.017 3.89543 1.91243 3 3.017 3H6.017C8.22614 3 10.017 4.79086 10.017 7V15C10.017 18.3137 7.33072 21 4.017 21H1.017Z"/></svg>
              <p class="text-2xl font-heading font-medium mb-8 leading-relaxed">
                "VoluChat isn't just about automation. It's about giving brand owners their life back while their business grows faster than ever before."
              </p>
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-slate-800 border-2 border-slate-700 flex items-center justify-center font-bold text-indigo-400">VG</div>
                <div>
                  <div class="font-bold">Vaibhav Goyal</div>
                  <div class="text-xs text-slate-500 uppercase tracking-widest font-bold">Founder, VoluChat</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    </section>
  </main>

  <Footer />
</Layout>
