---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "About VoluChat — The Autonomous Sales Closer for D2C Brands";
const seoDescription =
  "Learn how VoluChat turns Instagram comments and WhatsApp chats into 24/7 automated revenue for D2C brands with 100% white-glove setup.";
const seoKeywords =
  "About VoluChat, WhatsApp sales automation, Instagram DM sales agent, D2C conversational commerce";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/about`,
};

const principles = [
  {
    title: "Context before action",
    text: "A useful commerce agent should understand the cart, customer, product, inventory, and policy context before it recommends anything.",
  },
  {
    title: "Revenue over replies",
    text: "Answering a question matters. Recovering a cart, saving a sale, clearing old stock, or surfacing the right add-on matters more.",
  },
  {
    title: "Approval over blind automation",
    text: "AI should not discount, message, or change a customer experience without clear limits. Sensitive actions stay reviewable and approved.",
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/about", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="pt-20">
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-24 lg:pb-24">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_18%_18%,rgba(83,111,159,0.12),transparent_30%),radial-gradient(circle_at_80%_16%,rgba(203,217,234,0.2),transparent_30%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
          <div class="abt-hero-text">
            <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/25 bg-emerald-950/40 px-3.5 py-1 text-xs font-bold text-emerald-300 mb-5">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              Our Mission
            </div>
            <h1
              class="text-4xl font-semibold leading-[1.04] text-white sm:text-6xl font-heading"
            >
              Building the autonomous closer for Instagram DM and WhatsApp sales.
            </h1>
            <p class="section-copy mt-6 max-w-xl text-slate-300">
              Online shopping in India and global D2C has moved to Instagram and WhatsApp. VoluChat provides the 24/7 intelligent sales agent that ensures no buyer inquiry goes unanswered and every warm lead is closed into a paid order.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/contact" class="btn-primary">Apply for Pilot Cohort &rarr;</a>
              <a href="/#how-it-works" class="btn-secondary">Explore the Engine</a>
            </div>
          </div>

          <div class="abt-hero-image solid-card p-3 border-emerald-500/20 bg-[#081120]">
            <img
              src="/about_hero.webp"
              alt="VoluChat workspace for commerce agents"
              class="h-full w-full rounded-xl object-cover"
              width="1024"
              height="1024"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="abt-believe-section section-pad relative overflow-hidden">
      <div class="page-shell">
        <div class="abt-believe-text mx-auto max-w-3xl text-center">
          <p class="section-eyebrow text-emerald-400">What we believe</p>
          <h2 class="section-title mt-4 text-white font-heading">
            Speed and conversational depth close sales. Not rigid bot menus.
          </h2>
          <p class="section-copy mx-auto mt-5 max-w-2xl text-slate-300">
            Social shoppers buy on impulse. When they ask about sizing, custom delivery dates, or COD at 11 PM, an instant intelligent answer is the difference between a ₹3,000 checkout and a lost customer.
          </p>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {
            [
              {
                title: "Speed is Conversion",
                text: "Replying to an Instagram Reel comment in 2 seconds delivers 8x higher conversion than replying the next morning.",
              },
              {
                title: "Zero Bot Hallucinations",
                text: "The AI understands live Shopify variant stock, accurate delivery pincodes, and strict margin rules without making false promises.",
              },
              {
                title: "10x Value Standard",
                text: "We don't charge for software that sits idle. We provide white-glove setup and guarantee measurable revenue lift for every store.",
              },
            ].map((item, index) => (
              <article
                class="abt-believe-card solid-card border-white/10 bg-[#0a1424]/90 p-7"
              >
                <span class="grid h-10 w-10 place-items-center rounded-full bg-emerald-500/20 border border-emerald-500/30 font-mono text-xs font-bold text-emerald-300">
                  0{index + 1}
                </span>
                <h3 class="mt-6 text-xl font-heading font-semibold text-white">
                  {item.title}
                </h3>
                <p class="mt-4 text-sm font-medium leading-relaxed text-slate-300">
                  {item.text}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="abt-founder-section relative pb-28">
      <div class="page-shell">
        <div class="grid gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-center">
          <div class="abt-founder-image solid-card p-3 border-emerald-500/20 bg-[#081120]">
            <img
              src="/mission_collaboration.webp"
              alt="Configuring ecommerce agent workflows"
              class="max-h-[500px] w-full rounded-xl object-cover"
              width="1024"
              height="1024"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="abt-founder-text">
            <p class="section-eyebrow text-emerald-400">Founder commitment</p>
            <h2
              class="mt-4 text-3xl font-heading font-semibold leading-[1.08] text-white sm:text-5xl"
            >
              "I will deliver 10x the value of what we charge. Anything less is unacceptable."
            </h2>
            <p
              class="mt-5 text-base font-medium leading-relaxed text-slate-300"
            >
              As a founder, I saw merchants spending lakhs on Meta ads, only to watch 50%+ of their customer intent leak away because manual sales reps were offline or overwhelmed. VoluChat exists to turn social media DMs into a 24/7 autonomous cash-register.
            </p>
            <div
              class="mt-8 rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-6"
            >
              <p class="text-base font-semibold leading-relaxed text-slate-200">
                "For our initial 10 pilot stores, my team and I personally handle 100% of the Meta setup, catalog synchronization, and live closer tuning."
              </p>
              <p class="mt-4 text-sm font-bold text-emerald-300 font-mono">
                Vaibhav Goyal &bull; Founder, VoluChat
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // Hero
    gsap.fromTo(".abt-hero-text",
      { opacity: 0, x: -30, filter: "blur(5px)" },
      { opacity: 1, x: 0, filter: "blur(0px)", duration: 0.8, ease: "power2.out" }
    );
    gsap.fromTo(".abt-hero-image",
      { opacity: 0, scale: 0.95 },
      { opacity: 1, scale: 1, duration: 1, ease: "power3.out" },
      "-=0.6"
    );

    // Believe
    const believeTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".abt-believe-section",
        start: "top 75%",
        toggleActions: "play none none reverse"
      }
    });
    believeTl.fromTo(".abt-believe-text",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" }
    ).fromTo(".abt-believe-card",
      { opacity: 0, y: 40, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 0.6, stagger: 0.15, ease: "back.out(1.2)" },
      "-=0.4"
    );

    // Founder
    const founderTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".abt-founder-section",
        start: "top 75%",
        toggleActions: "play none none reverse"
      }
    });
    founderTl.fromTo(".abt-founder-image",
      { opacity: 0, x: -40, rotateY: 10 },
      { opacity: 1, x: 0, rotateY: 0, duration: 0.8, ease: "power2.out" }
    ).fromTo(".abt-founder-text",
      { opacity: 0, x: 30 },
      { opacity: 1, x: 0, duration: 0.8, ease: "power2.out" },
      "-=0.6"
    );
  });
</script>
