---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "About VoluChat — Built for Fashion & Clothing Boutiques";
const seoDescription =
  "Why we built VoluChat — autonomous WhatsApp and Instagram sales agent that closes orders, recommends sizes, and collects UPI payments 24/7.";
const seoKeywords =
  "About VoluChat, fashion boutique WhatsApp sales bot, clothing DM automation, Instagram reel comment sales, Vaibhav Goyal";
const siteUrl = "https://www.voluchat.com";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/about`,
  mainEntity: {
    "@type": "Organization",
    name: "VoluChat",
    legalName: "QubitNine Technologies Pvt. Ltd.",
    url: siteUrl,
    logo: `${siteUrl}/voluchat_logo.svg`,
    founder: {
      "@type": "Person",
      name: "Vaibhav Goyal",
      jobTitle: "Founder & CEO",
      description:
        "Former e-commerce Sales Manager turned founder, building automated WhatsApp sales agents for fashion boutique owners.",
    },
    address: {
      "@type": "PostalAddress",
      addressLocality: "Noida",
      addressRegion: "Uttar Pradesh",
      addressCountry: "India",
    },
    sameAs: [
      "https://www.instagram.com/voluchat",
      "https://x.com/voluchat",
      "https://www.linkedin.com/company/voluchat",
      "https://www.youtube.com/@voluchat",
    ],
  },
};

const frontlineProblems = [
  {
    icon: "📸",
    leak: "01",
    title: "Scrolling Phone Gallery for Photos",
    desc: "When a customer asks for real fabric photos or size charts, your team spends 10 minutes scrolling through thousands of photos on their phone while the buyer loses interest.",
  },
  {
    icon: "💬",
    leak: "02",
    title: "Overwhelmed by 'Price Please' Comments",
    desc: "A Reel goes viral, but 80% of comments are casual inquiries. Real buyers asking about sizes or ready to pay get buried in the backlog.",
  },
  {
    icon: "🌙",
    leak: "03",
    title: "Losing Hot Midnight Buyers",
    desc: "Most fashion shopping happens in bed between 10 PM and 1 AM. When your staff goes to sleep, high-intent buyers message other boutiques instead.",
  },
  {
    icon: "❌",
    leak: "04",
    title: "Selling Sold-Out Sizes",
    desc: "Without live stock tracking, reps accept customer UPI payments for sizes or colors that are already out of stock, causing angry refunds.",
  },
  {
    icon: "📝",
    leak: "05",
    title: "Manual Address & Payment Chaos",
    desc: "Manually typing bank details, checking screenshot receipts, and copy-pasting addresses from chat threads leads to costly dispatch errors.",
  },
  {
    icon: "📉",
    leak: "06",
    title: "Zero Clarity on Lost Sales",
    desc: "You spend lakhs on Instagram Ads and creator shoots, but have no clear idea why half of your DM conversations never turn into orders.",
  },
];

const operatingPrinciples = [
  {
    number: "01",
    title: "100% Done-For-You Setup",
    desc: "Running a clothing brand is busy enough. You shouldn't have to build chatbots or complex flowchart diagrams. We handle your entire setup for you.",
  },
  {
    number: "02",
    title: "10x Value Standard",
    desc: "We only win when you win. If VoluChat doesn't visibly increase your store's WhatsApp sales and save your team hours every day, we haven't earned your business.",
  },
  {
    number: "03",
    title: "Zero Guesswork & Margin Safety",
    desc: "Speed is useless if a bot offers unauthorized discounts or confirms items you don't have. Our strict guardrails protect your brand reputation and profits.",
  },
  {
    number: "04",
    title: "Instant Human Takeover",
    desc: "AI handles repetitive sizing queries and generates UPI checkout links, but steps aside instantly whenever custom bridal orders or human touch is needed.",
  },
];

const companyFacts = [
  { label: "Legal Entity", value: "QubitNine Technologies Pvt. Ltd." },
  { label: "Headquarters", value: "Noida, Uttar Pradesh, India" },
  { label: "Founder", value: "Vaibhav Goyal (Founder & CEO)" },
  { label: "Special Offer", value: "30-Day Free Trial (First 10 Stores)" },
  { label: "Direct Founder Line", value: "+91 88475 68693 (WhatsApp)" },
  { label: "Email Support", value: "support@voluchat.com" },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/about", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="overflow-hidden">
    <!-- Hero Section -->
    <section class="hero-stripe text-left">
      <div class="section-glow-emerald"></div>
      <div class="sect-grid opacity-20"></div>

      <div class="page-shell">
        <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div class="abt-hero-text">
            <div class="chip mb-6">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 mr-1.5"></span>
              Why We Built VoluChat
            </div>
            <h1
              class="text-4xl font-semibold leading-[1.08] text-[#fcfdff] sm:text-6xl font-heading"
            >
              Selling on Instagram &amp; WhatsApp was never meant to be this exhausting.
            </h1>
            <p class="section-copy mt-6 max-w-xl text-lg leading-relaxed">
              We built VoluChat after experiencing the real chaos of online boutique sales: running viral Reels, only to lose orders to slow replies, midnight DMs, and manual payment tracking.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/free-trial" class="btn-primary">Start 30-Day Free Trial &rarr;</a>
              <a href="#origin" class="btn-secondary">Read Our Story</a>
            </div>
          </div>

          <div class="abt-hero-image solid-card p-2">
            <img
              src="/about_hero.webp"
              alt="VoluChat WhatsApp automation for fashion boutiques"
              class="h-full w-full rounded-lg object-cover"
              width="1024"
              height="1024"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Origin Story / Frontline Reality -->
    <section id="origin" class="abt-origin-section relative overflow-hidden py-20 sm:py-24 border-t border-white/[0.08] bg-[#06060a]">
      <div class="page-shell">
        <div class="max-w-3xl">
          <p class="section-eyebrow">The Real Frontline Story</p>
          <h2 class="section-title mt-3 text-[#fcfdff] font-heading text-3xl sm:text-5xl">
            Built from real store frustration, not theoretical tech ideas.
          </h2>
          <p class="mt-5 text-base sm:text-lg font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">
            While working as a <strong>Sales Manager</strong> for an online commerce store, our founder saw the daily reality of DM selling up close. Instagram brought massive organic views and ad traffic, but closing orders manually over WhatsApp was slow, chaotic, and leaked revenue every single night.
          </p>
        </div>

        <!-- 6 Frontline Leaks — kid-simple numbered list, no cards -->
        <div class="mt-14 max-w-4xl">
          {
            frontlineProblems.map((item) => (
              <div class="abt-problem-card hairline-row grid gap-3 sm:grid-cols-[56px_1fr] sm:gap-6">
                <span class="kid-num !text-3xl text-[#a1a1a6]">{item.leak}</span>
                <div>
                  <h3 class="text-lg font-heading font-semibold text-white">
                    <span class="mr-2">{item.icon}</span>{item.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-[#86868b] font-normal">
                    {item.desc}
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        <div class="mt-10 solid-card-elevated p-8 sm:p-10">
          <h3 class="text-xl sm:text-2xl font-heading font-semibold text-[#fcfdff]">
            Why Traditional Chatbots Don't Work for Fashion
          </h3>
          <p class="mt-4 text-sm sm:text-base font-normal text-[rgba(252,253,255,0.7)] leading-relaxed">
            Existing tools (Wati, ManyChat, flowchart bots) give customers rigid "Press 1 for Price, Press 2 for Sizing" buttons. Fashion shoppers hate that. Clothing buyers need real answers: <em>"Will this fit a 38 bust?", "Is the fabric pure cotton?", "Can I get this delivered by Friday?"</em>.
          </p>
          <p class="mt-3 text-sm sm:text-base font-normal text-[rgba(252,253,255,0.86)] leading-relaxed">
            <strong>VoluChat changes the game:</strong> an intelligent AI sales stylist that talks like your best sales rep, checks live inventory, recommends the right size, and generates 1-click UPI payment links directly inside WhatsApp.
          </p>
        </div>
      </div>
    </section>

    <!-- Operating Principles -->
    <section class="abt-principles-section relative overflow-hidden py-20 sm:py-24 bg-[#000000]">
      <div class="page-shell">
        <div class="mx-auto max-w-3xl text-center">
          <p class="section-eyebrow">Our Core Standards</p>
          <h2 class="section-title mt-3 text-[#fcfdff] font-heading">
            How we support every partner store
          </h2>
          <p class="section-copy mx-auto mt-4 max-w-2xl">
            Built to take the stress off boutique owners and deliver real, measurable sales.
          </p>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-2">
          {
            operatingPrinciples.map((item) => (
              <article class="abt-principle-card solid-card p-7 sm:p-8">
                <div class="flex items-center gap-4">
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-[#101012] border border-white/[0.14] font-mono text-sm font-bold text-emerald-300">
                    {item.number}
                  </span>
                  <h3 class="text-xl font-heading font-semibold text-[#fcfdff]">
                    {item.title}
                  </h3>
                </div>
                <p class="mt-4 text-sm font-normal leading-relaxed text-[rgba(252,253,255,0.7)]">
                  {item.desc}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- The Bigger Vision -->
    <section class="abt-vision-section relative overflow-hidden py-20 sm:py-24 border-t border-white/[0.08] bg-[#06060a]">
      <div class="page-shell">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div class="abt-vision-image solid-card p-2">
            <img
              src="/mission_collaboration.webp"
              alt="VoluChat e-commerce sales automation"
              class="h-full w-full rounded-lg object-cover"
              width="1024"
              height="1024"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="abt-vision-text">
            <p class="section-eyebrow">Our Vision</p>
            <h2 class="mt-3 text-3xl font-heading font-semibold text-[#fcfdff] sm:text-5xl">
              Giving every boutique a 24/7 top-performing sales team.
            </h2>
            <p class="mt-5 text-[rgba(252,253,255,0.7)] leading-relaxed text-base font-normal">
              Big e-commerce brands have massive support centers and technical teams. Independent boutiques and growing fashion labels shouldn't be held back because they can't afford 24/7 staff.
            </p>
            <p class="mt-3 text-[rgba(252,253,255,0.7)] leading-relaxed text-base font-normal">
              From the instant a shopper comments on your Instagram Reel, to sizing help, live stock check, 1-click UPI payments, and order tracking — VoluChat automates the entire sales journey so you can focus on creating great collections.
            </p>

            <div class="mt-8 grid grid-cols-2 gap-4 border-t border-white/[0.08] pt-6">
              <div>
                <p class="text-2xl font-bold font-heading text-[#fcfdff]">Zero Tech</p>
                <p class="text-xs text-slate-400 mt-1">We set up everything for you</p>
              </div>
              <div>
                <p class="text-2xl font-bold font-heading text-emerald-400">30 Days</p>
                <p class="text-xs text-slate-400 mt-1">Free trial with all features</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Company Transparency & Quick Facts -->
    <section class="abt-facts-section relative overflow-hidden py-20 sm:py-24 bg-[#000000]">
      <div class="page-shell">
        <div class="solid-card p-8 sm:p-12">
          <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:items-center">
            <div>
              <p class="section-eyebrow">Corporate Information</p>
              <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-[#fcfdff] mt-2">
                Company Transparency
              </h2>
              <p class="mt-4 text-sm text-[rgba(252,253,255,0.7)] leading-relaxed font-normal">
                VoluChat is developed and operated by <strong>QubitNine Technologies Pvt. Ltd.</strong>, headquartered in Noida, Uttar Pradesh, India.
              </p>
              <p class="mt-3 text-sm text-[rgba(252,253,255,0.7)] leading-relaxed font-normal">
                We are committed to enterprise data isolation, official Meta Cloud API compliance, and merchant margin safety.
              </p>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              {
                companyFacts.map((fact) => (
                  <div class="solid-card-subtle p-4">
                    <p class="text-xs font-mono font-medium text-slate-400 uppercase tracking-wider">
                      {fact.label}
                    </p>
                    <p class="text-sm font-semibold text-[#fcfdff] mt-1">
                      {fact.value}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Founder Commitment Card -->
    <section class="abt-founder-section relative pb-28 bg-[#000000]">
      <div class="page-shell">
        <div class="solid-card-elevated p-8 sm:p-12 text-center max-w-4xl mx-auto">
          <p class="section-eyebrow">Direct Founder Accountability</p>
          <blockquote class="mt-4 text-2xl sm:text-3xl font-heading font-semibold text-[#fcfdff] leading-relaxed">
            "I will deliver 10x the value of what we charge. Anything less is unacceptable."
          </blockquote>
          <p class="mt-6 text-[rgba(252,253,255,0.7)] max-w-2xl mx-auto text-sm sm:text-base leading-relaxed font-normal">
            For every brand in our first 10 stores, we provide a <strong>30-day free trial</strong> while my team and I personally oversee catalog ingestion, Instagram hook tuning, and live sales qualification. No outsourced support, no junior account managers.
          </p>
          <div class="mt-8 flex flex-col items-center justify-center gap-2">
            <div class="relative mb-2">
              <img
                src="/founder_portrait.webp"
                alt="Vaibhav Goyal - Founder & CEO of VoluChat"
                class="h-16 w-16 sm:h-20 sm:w-20 rounded-full object-cover border-2 border-emerald-400/40 shadow-lg shadow-emerald-500/10"
                width="80"
                height="80"
                loading="lazy"
                decoding="async"
              />
              <span class="absolute bottom-1 right-1 h-3 w-3 rounded-full bg-emerald-500 ring-2 ring-[#0c0d12]"></span>
            </div>
            <p class="text-base font-semibold text-white">Vaibhav Goyal</p>
            <p class="text-xs font-mono text-emerald-300">Founder & CEO &bull; VoluChat / QubitNine Technologies</p>
            <div class="mt-5 flex flex-col sm:flex-row items-center gap-3">
              <a href="/free-trial" class="btn-primary">Claim 30-Day Free Trial &rarr;</a>
              <a
                href="https://wa.me/918847568693?text=Hi%20Vaibhav%2C%20I'd%20like%20to%20claim%20the%2030-Day%20Free%20Trial%20for%20my%20store."
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary inline-flex items-center gap-2"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="text-emerald-400"
                  aria-hidden="true"
                >
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.978-1.408A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.2c-1.637 0-3.15-.472-4.43-1.286l-.317-.199-2.952.835.83-2.87-.217-.328A8.17 8.17 0 013.8 12c0-4.52 3.68-8.2 8.2-8.2 4.52 0 8.2 3.68 8.2 8.2 0 4.52-3.68 8.2-8.2 8.2z" clip-rule="evenodd"/>
                </svg>
                <span>Chat on WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // Hero Animation
    gsap.fromTo(
      ".abt-hero-text",
      { opacity: 0, x: -30, filter: "blur(5px)" },
      { opacity: 1, x: 0, filter: "blur(0px)", duration: 0.8, ease: "power2.out" }
    );
    gsap.from(".abt-hero-image", {
      opacity: 0,
      scale: 0.95,
      duration: 1,
      ease: "power3.out",
      immediateRender: true,
    });

    // Origin Problems Stagger
    const originTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".abt-origin-section",
        start: "top 75%",
        toggleActions: "play none none reverse",
      },
    });
    originTl.fromTo(
      ".abt-problem-card",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.5, stagger: 0.1, ease: "power2.out" }
    );

    // Principles Stagger
    const principlesTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".abt-principles-section",
        start: "top 75%",
        toggleActions: "play none none reverse",
      },
    });
    principlesTl.fromTo(
      ".abt-principle-card",
      { opacity: 0, y: 35 },
      { opacity: 1, y: 0, duration: 0.6, stagger: 0.12, ease: "power2.out" }
    );

    // Vision Animation
    const visionTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".abt-vision-section",
        start: "top 75%",
        toggleActions: "play none none reverse",
      },
    });
    visionTl
      .fromTo(
        ".abt-vision-image",
        { opacity: 0, x: -30 },
        { opacity: 1, x: 0, duration: 0.8, ease: "power2.out" }
      )
      .fromTo(
        ".abt-vision-text",
        { opacity: 0, x: 30 },
        { opacity: 1, x: 0, duration: 0.8, ease: "power2.out" },
        "-=0.5"
      );
  });
</script>
