---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "About VoluChat | Shopify AI Agents";
const seoDescription =
  "Learn why VoluChat builds Shopify AI agents for cart recovery, product questions, upsells, inventory workflows, and revenue recovery.";
const seoKeywords =
  "VoluChat about, Shopify AI company, commerce agents founder, AI automation team, Shopify AI agents";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: siteUrl,
};

const principles = [
  {
    title: "Context before action",
    text: "A useful commerce agent should understand the cart, customer, product, inventory, and policy context before it recommends anything.",
  },
  {
    title: "Revenue over replies",
    text: "Answering a question matters. Recovering a cart, saving a sale, clearing old stock, or surfacing the right add-on matters more.",
  },
  {
    title: "Approval over blind automation",
    text: "AI should not discount, message, or change a customer experience without clear limits. Sensitive actions stay reviewable and approved.",
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/about", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="pt-20">
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-24 lg:pb-24">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_18%_18%,rgba(83,111,159,0.12),transparent_30%),radial-gradient(circle_at_80%_16%,rgba(203,217,234,0.2),transparent_30%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
          <div class="abt-hero-text opacity-0">
            <div class="chip">Our Vision</div>
            <h1
              class="mt-6 text-4xl font-semibold leading-[1.02] text-white sm:text-6xl"
            >
              Shopify teams need AI that knows when to ask first.
            </h1>
            <p class="section-copy mt-6 max-w-xl">
              VoluChat helps growing Shopify brands turn repeated product
              questions, abandoned carts, stock pressure, and customer
              follow-ups into AI-recommended workflows your team can approve.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/contact" class="btn-primary">Book a workflow demo</a>
              <a href="/features" class="btn-secondary">Explore features</a>
            </div>
          </div>

          <div class="abt-hero-image opacity-0 solid-card p-3">
            <img
              src="/about_hero.webp"
              alt="VoluChat workspace for commerce agents"
              class="h-full w-full rounded-xl object-cover"
              width="1024"
              height="1024"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="abt-believe-section section-pad relative overflow-hidden">
      <div class="page-shell">
        <div class="abt-believe-text opacity-0 mx-auto max-w-3xl text-center">
          <p class="section-eyebrow">What we believe</p>
          <h2 class="section-title mt-4">
            AI should help operators move faster, not take judgment away.
          </h2>
          <p class="section-copy mx-auto mt-5 max-w-2xl">
            The best use of AI in commerce is not a chatbot that sounds clever.
            It is a system that spots the next useful action, explains the
            reasoning, and keeps the team in control.
          </p>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {
            principles.map((item, index) => (
              <article
                class="abt-believe-card opacity-0 solid-card"
              >
                <span class="grid h-10 w-10 place-items-center rounded-full bg-teal-500 font-mono text-xs font-semibold text-white">
                  0{index + 1}
                </span>
                <h3 class="mt-6 text-xl font-heading font-semibold text-white">
                  {item.title}
                </h3>
                <p class="mt-4 text-base font-medium leading-relaxed text-slate-300">
                  {item.text}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="abt-founder-section relative pb-28">
      <div class="page-shell">
        <div class="grid gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-center">
          <div class="abt-founder-image opacity-0 solid-card p-3">
            <img
              src="/mission_collaboration.webp"
              alt="Configuring ecommerce agent workflows"
              class="max-h-[500px] w-full rounded-xl object-cover"
              width="1024"
              height="1024"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="abt-founder-text opacity-0">
            <p class="section-eyebrow">Founder note</p>
            <h2
              class="mt-4 text-3xl font-heading font-semibold leading-[1.08] text-white sm:text-5xl"
            >
              We are building for the work that happens between tools.
            </h2>
            <p
              class="mt-5 text-base font-semibold leading-relaxed text-slate-300"
            >
              Most revenue leaks are not dramatic. They happen when a shopper
              waits too long for an answer, a cart follow-up never goes out, or
              old inventory needs attention but nobody has time to build the
              campaign. VoluChat exists to catch those moments and turn them
              into clear, approved next steps.
            </p>
            <div
              class="mt-8 rounded-xl border border-teal-300/20 bg-teal-300/10 p-6"
            >
              <p class="text-lg font-semibold leading-relaxed text-slate-200">
                "Commerce teams do not need AI making unchecked decisions. They
                need AI that can read the store context, recommend the right
                action, and show why it is safe to approve."
              </p>
              <p class="mt-5 text-sm font-semibold text-teal-200">
                Vaibhav Goyal, Founder
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // Hero
    gsap.fromTo(".abt-hero-text",
      { opacity: 0, x: -30, filter: "blur(5px)" },
      { opacity: 1, x: 0, filter: "blur(0px)", duration: 0.8, ease: "power2.out" }
    );
    gsap.fromTo(".abt-hero-image",
      { opacity: 0, scale: 0.95 },
      { opacity: 1, scale: 1, duration: 1, ease: "power3.out" },
      "-=0.6"
    );

    // Believe
    const believeTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".abt-believe-section",
        start: "top 75%",
        toggleActions: "play none none reverse"
      }
    });
    believeTl.fromTo(".abt-believe-text",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" }
    ).fromTo(".abt-believe-card",
      { opacity: 0, y: 40, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 0.6, stagger: 0.15, ease: "back.out(1.2)" },
      "-=0.4"
    );

    // Founder
    const founderTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".abt-founder-section",
        start: "top 75%",
        toggleActions: "play none none reverse"
      }
    });
    founderTl.fromTo(".abt-founder-image",
      { opacity: 0, x: -40, rotateY: 10 },
      { opacity: 1, x: 0, rotateY: 0, duration: 0.8, ease: "power2.out" }
    ).fromTo(".abt-founder-text",
      { opacity: 0, x: 30 },
      { opacity: 1, x: 0, duration: 0.8, ease: "power2.out" },
      "-=0.6"
    );
  });
</script>
