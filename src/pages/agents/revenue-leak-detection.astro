---
import AgentDetailPage from "../../components/AgentDetailPage.astro";
import { getFaqSchema } from "../../lib/faqSchema.mjs";

const workflow = [
  {
    title: "Watch for patterns across the store",
    text: "The agent looks at repeated unanswered questions, abandoned carts, slow inventory, product-page hesitation, offer performance, and drop-off reasons.",
  },
  {
    title: "Turn signals into ranked opportunities",
    text: "It separates noise from action by estimating where the leak is happening, what workflow could address it, and whether the fix needs approval.",
  },
  {
    title: "Route the fix to the right agent",
    text: "Some leaks become product-answer improvements, some become recovery workflows, some become clearance campaigns, and some need a human operator.",
  },
];

const useCases = [
  {
    label: "Conversion friction",
    title: "Find repeated reasons shoppers hesitate",
    text: "Surfaces patterns such as delivery uncertainty, missing size guidance, unclear returns, or repeated price objections.",
  },
  {
    label: "Operational gaps",
    title: "Spot work that keeps falling through",
    text: "Highlights carts, products, and categories where the store is creating demand but not converting it into revenue.",
  },
  {
    label: "Action routing",
    title: "Recommend the next workflow",
    text: "Suggests whether to deploy a recovery message, update product guidance, launch a clearance offer, or escalate a pattern to the team.",
  },
];

const guardrails = [
  "Can run in observe-only mode before any automated intervention is enabled.",
  "Separates insights from actions so operators can approve workflow changes.",
  "Logs the evidence behind each recommendation.",
  "Escalates sensitive customer or policy patterns to a human reviewer.",
];

const relatedLinks = [
  { label: "Cart Recovery Agent", href: "/agents/cart-recovery" },
  { label: "Inventory Clearance Agent", href: "/agents/inventory-clearance" },
  { label: "Product Assistant", href: "/agents/product-assistant" },
];
const siteUrl = "https://www.voluchat.com";
const agentStructuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Revenue Leak Detection Agent",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: new URL("/agents/revenue-leak-detection/", siteUrl).toString(),
  description:
    "Find and fix ecommerce revenue leaks with VoluChat's agent for abandoned carts, unanswered demand, slow inventory, and operational gaps.",
};
---

<AgentDetailPage
  seoTitle="Revenue Leak Detection Agent for Shopify | VoluChat"
  seoDescription="Find and fix ecommerce revenue leaks with VoluChat's agent for abandoned carts, unanswered demand, slow inventory, and operational gaps."
  keywords="revenue leak detection, Shopify revenue leaks, ecommerce revenue gaps, cart abandonment analysis, inventory gaps"
  canonical={new URL("/agents/revenue-leak-detection", siteUrl).toString()}
  structuredData={agentStructuredData}
  faqSchema={getFaqSchema()}
  title="Revenue Leak Detection Agent."
  description="Find the places where your store is already creating demand but losing revenue, then route each opportunity to the right agent workflow."
  heroSignal="Multiple shoppers ask about delivery and leave carts in the same product category."
  heroDecision="Connect the repeated objection to cart abandonment, product guidance gaps, and potential recovery workflows."
  heroAction="Recommend a delivery clarification, recovery message, and approval rule for high-value carts."
  heroOutcome="Leak category, recommended fix, owner, and recovered revenue are tracked in one workflow."
  painTitle="Revenue leaks hide between dashboards and manual work."
  painCopy="Analytics can tell you conversion is down, but not always what to do next. The Revenue Leak Detection Agent watches the operational signals around lost revenue and turns them into ranked, actionable workflows your team can approve or automate."
  workflow={workflow}
  useCases={useCases}
  guardrails={guardrails}
  relatedLinks={relatedLinks}
/>
