---
import AgentDetailPage from "../../components/AgentDetailPage.astro";

const workflow = [
  {
    title: "Spot inventory that needs movement",
    text: "The agent looks for slow sell-through, aging stock, seasonal pressure, excess variants, and products that are attracting interest without converting.",
  },
  {
    title: "Match clearance offers to real demand",
    text: "Instead of blasting discounts to everyone, it introduces targeted offers when a shopper is browsing related products or showing relevant intent.",
  },
  {
    title: "Stop when the goal is reached",
    text: "Campaigns can pause automatically when inventory targets, budget limits, or margin thresholds are reached.",
  },
];

const useCases = [
  {
    label: "Aging stock",
    title: "Move products before they become dead stock",
    text: "Turns slow-moving units into targeted conversational offers while there is still time to protect cash flow.",
  },
  {
    label: "Variant imbalance",
    title: "Clear excess sizes or colors",
    text: "Promotes specific variants when shoppers are already considering nearby products or comparable alternatives.",
  },
  {
    label: "Seasonal pressure",
    title: "Create controlled clearance windows",
    text: "Runs short, rule-bound campaigns when a seasonal product needs movement without training customers to wait for discounts.",
  },
];

const guardrails = [
  "Only promotes SKUs or collections you approve for clearance.",
  "Discount depth, campaign duration, and inventory targets are capped.",
  "Offers pause when stock levels or sell-through goals are reached.",
  "High-impact clearance campaigns can require human approval before launch.",
];

const relatedLinks = [
  { label: "Revenue Leak Detection", href: "/agents/revenue-leak-detection" },
  { label: "Upsell & Bundle Agent", href: "/agents/upsell" },
  { label: "Shopify Integration", href: "/integrations/shopify" },
];
---

<AgentDetailPage
  seoTitle="AI Inventory Clearance Agent for Shopify | VoluChat"
  seoDescription="Move slow inventory with VoluChat's AI Inventory Clearance Agent using targeted offers, margin rules, and Shopify stock context."
  title="Inventory Clearance Agent."
  description="Turn slow stock into targeted, controlled offers that reach the right shoppers without making your whole store feel permanently discounted."
  heroSignal="A jacket variant has aged past your stock threshold while shoppers keep browsing similar products."
  heroDecision="Check inventory age, margin floor, related browsing intent, and approved clearance rules."
  heroAction="Offer the slow variant as a limited alternative to shoppers already considering the category."
  heroOutcome="Units moved, campaign stopped at the target, and margin impact recorded."
  painTitle="Inventory problems get expensive when nobody acts on them."
  painCopy="Dashboards can show slow-moving stock, but operators still have to decide what to promote, where to promote it, and when to stop. The Inventory Clearance Agent turns that work into a controlled workflow that acts only inside your merchandising and margin rules."
  workflow={workflow}
  useCases={useCases}
  guardrails={guardrails}
  relatedLinks={relatedLinks}
/>
