---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "Contact VoluChat — Direct Founder & Support Desk";
const seoDescription =
  "Get in touch with the VoluChat team. Direct WhatsApp founder line, email support, and enterprise sales inquiries.";
const seoKeywords =
  "Contact VoluChat, VoluChat WhatsApp, QubitNine Technologies support, ecommerce sales bot contact";
const siteUrl = "https://www.voluchat.com";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/contact`,
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/contact", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="overflow-hidden pt-20">
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-24 lg:pb-28">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_18%,rgba(16,185,129,0.15),transparent_32%),radial-gradient(circle_at_82%_20%,rgba(15,23,42,0.55),transparent_34%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="max-w-4xl mx-auto text-center mb-14">
          <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/25 bg-emerald-950/40 px-3.5 py-1 text-xs font-bold text-emerald-300 mb-5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Direct Access
          </div>
          <h1
            class="text-4xl font-semibold leading-[1.04] text-[#fcfdff] sm:text-6xl font-heading"
          >
            Get in touch with us.
          </h1>
          <p class="section-copy mt-5 max-w-2xl mx-auto text-base sm:text-lg">
            Whether you have questions about WhatsApp automation, our 30-day free trial offer, or partnership inquiries — we're right here.
          </p>
        </div>

        <div class="grid gap-10 lg:grid-cols-[1fr_1fr] max-w-5xl mx-auto items-start">
          <!-- Big visual: pick 1 way -->
          <div class="visual-frame lg:sticky lg:top-24">
            <p class="font-mono text-[11px] uppercase tracking-widest text-[#a1a1a6]">Fastest: 1 tap</p>
            <div class="mt-4 space-y-3">
              <div class="chat-user">Hi! I need help with sizing for Diwali drop?</div>
              <div class="chat-ai">Hey! I'm Vaibhav, founder. Reply in minutes — send your catalog link.</div>
              <a
                href="https://wa.me/918847568693?text=Hi%20Vaibhav%2C%20I'd%20like%20to%20learn%20more%20about%20VoluChat."
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary !w-full justify-center text-center"
              >
                Chat on WhatsApp →
              </a>
              <p class="text-center text-xs font-mono text-[#86868b]">+91 88475 68693 • replies in minutes</p>
            </div>
            <div class="mt-6 border-t border-white/[0.08] pt-4 grid grid-cols-3 gap-2 text-center">
              <div><p class="kid-num !text-2xl">1</p><p class="text-xs text-[#86868b]">You say hi</p></div>
              <div><p class="kid-num !text-2xl">2</p><p class="text-xs text-[#86868b]">We reply</p></div>
              <div><p class="kid-num !text-2xl text-emerald-400">3</p><p class="text-xs text-[#86868b]">You sell</p></div>
            </div>
          </div>
          <div>
            <div class="hairline-row">
              <p class="font-mono text-[11px] uppercase tracking-widest text-[#a1a1a6]">Email</p>
              <a href="mailto:support@voluchat.com" class="mt-1 block font-heading text-xl font-bold text-white hover:text-emerald-300">support@voluchat.com →</a>
              <p class="mt-1 text-sm text-[#86868b]">Onboarding, security, partnerships.</p>
            </div>
            <div class="hairline-row">
              <p class="font-mono text-[11px] uppercase tracking-widest text-[#a1a1a6]">Free trial</p>
              <a href="/free-trial" class="mt-1 block font-heading text-xl font-bold text-white hover:text-emerald-300">30-Day Free Trial →</a>
              <p class="mt-1 text-sm text-[#86868b]">All features unlocked, done-for-you setup.</p>
            </div>
            <div class="hairline-row">
              <p class="font-mono text-[11px] uppercase tracking-widest text-[#a1a1a6]">Company</p>
              <p class="mt-1 font-heading text-base font-semibold text-white">QubitNine Technologies Pvt. Ltd.</p>
              <p class="text-xs text-[#86868b] mt-1">Noida, India • Operating entity of VoluChat</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <FAQ />
  </main>

  <Footer />
</Layout>
