---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';

const seoTitle = "Contact Us | VoluChat Support";
const seoDescription = "Have questions about VoluChat? Reach out to our team for help with Instagram and DM automation, pricing, or the early beta program.";
---

<Layout title={seoTitle} description={seoDescription}>
  <Header />

  <main class="pt-20 overflow-hidden">
    <!-- Hero Section -->
    <section class="relative py-24">
      <div class="sect-grid"></div>
      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="section-badge mb-6">Contact Us</div>
            <h1 class="text-5xl md:text-6xl font-heading font-extrabold text-slate-900 mb-8 leading-tight">
              Need help with <span class="text-gradient-primary">VoluChat?</span>
            </h1>
            <p class="text-xl text-slate-600 leading-relaxed mb-10 max-w-xl">
              Ask us about setup, Instagram/Facebook connection, product automation, or the free beta.
            </p>
            
            <div class="space-y-8">
              <div class="flex items-center gap-5 group">
                <div class="glass-card-premium w-14 h-14 rounded-2xl flex items-center justify-center text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-all shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div>
                  <div class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-1">Email Us</div>
                  <a href="mailto:support@voluchat.com" class="text-xl font-black text-slate-950 hover:text-indigo-600 transition-colors tracking-tight">support@voluchat.com</a>
                </div>
              </div>
              
              <div class="flex items-center gap-5 group">
                <div class="glass-card-premium w-14 h-14 rounded-2xl flex items-center justify-center text-purple-600 group-hover:bg-purple-600 group-hover:text-white transition-all shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <div class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-1">Phone Support</div>
                  <a href="tel:+918847568693" class="text-xl font-black text-slate-950 hover:text-indigo-600 transition-colors tracking-tight">+91-88475-68693</a>
                </div>
              </div>
            </div>
          </div>
          
          <div class="relative">
            <div class="absolute -inset-10 bg-indigo-500/5 blur-[120px] rounded-full -z-10"></div>
            <div class="glass-panel-premium p-10 md:p-12 rounded-[3rem] relative z-10 shadow-2xl">
              <form class="space-y-8">
                <div class="grid md:grid-cols-2 gap-8">
                  <div>
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-3">First Name</label>
                    <input type="text" placeholder="Rahul" class="w-full px-5 py-4 bg-white/50 border border-slate-100 rounded-2xl focus:outline-none focus:ring-4 focus:ring-indigo-500/5 focus:bg-white focus:border-indigo-200 transition-all font-medium text-slate-900" />
                  </div>
                  <div>
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-3">Last Name</label>
                    <input type="text" placeholder="Sharma" class="w-full px-5 py-4 bg-white/50 border border-slate-100 rounded-2xl focus:outline-none focus:ring-4 focus:ring-indigo-500/5 focus:bg-white focus:border-indigo-200 transition-all font-medium text-slate-900" />
                  </div>
                </div>
                <div>
                  <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-3">Work Email</label>
                  <input type="email" placeholder="you@store.com" class="w-full px-5 py-4 bg-white/50 border border-slate-100 rounded-2xl focus:outline-none focus:ring-4 focus:ring-indigo-500/5 focus:bg-white focus:border-indigo-200 transition-all font-medium text-slate-900" />
                </div>
                <div>
                  <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-3">How can we help?</label>
                  <textarea rows="4" placeholder="Tell us what you sell..." class="w-full px-5 py-4 bg-white/50 border border-slate-100 rounded-2xl focus:outline-none focus:ring-4 focus:ring-indigo-500/5 focus:bg-white focus:border-indigo-200 transition-all font-medium text-slate-900 resize-none"></textarea>
                </div>
                <button type="submit" class="group relative flex items-center justify-center gap-3 w-full py-5 bg-slate-950 text-white rounded-2xl font-black text-base transition-all duration-300 hover:scale-[1.02] hover:bg-slate-900 shadow-2xl overflow-hidden">
                  <span class="relative z-10">Send Message</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="relative z-10 transition-transform group-hover:translate-x-1.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Visual Divider -->
    <section class="max-w-7xl mx-auto px-6 mb-32">
      <div class="glass-panel-premium p-5 rounded-[3rem] overflow-hidden group shadow-2xl">
        <img 
          src="/contact_support.png" 
          alt="VoluChat Support Team" 
          class="w-full h-[550px] object-cover rounded-[2.5rem] transition-transform duration-[2s] group-hover:scale-105"
        />
      </div>
    </section>

    <FAQ />
  </main>

  <Footer />
</Layout>
