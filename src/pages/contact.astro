---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";

const seoTitle = "Book Demo | VoluChat";
const seoDescription =
  "Find the revenue leaks in your Shopify store. Share your catalog, revenue workflows, and guardrail needs so we can identify the first agents worth deploying.";
const contactEmailUrl = "mailto:support@voluchat.com";
---

<Layout title={seoTitle} description={seoDescription}>
  <Header />

  <main class="animate-page-entry overflow-hidden opacity-0 pt-20">
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-24 lg:pb-28">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_18%,rgba(45,212,191,0.12),transparent_32%),radial-gradient(circle_at_82%_20%,rgba(15,23,42,0.55),transparent_34%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <div class="chip">Revenue leak review</div>
            <h1
              class="mt-6 text-4xl font-semibold leading-[1.02] text-white sm:text-6xl"
            >
              Find the revenue workflows worth automating first.
            </h1>
            <p class="section-copy mt-6 max-w-xl">
              Share your Shopify store, the workflow that hurts most, and how
              much control your team needs. We will review the store and
              recommend the first agent rollout to scope.
            </p>

            <div class="mt-10 grid gap-4">
              <div
                class="rounded-2xl border border-[rgba(148,163,184,0.18)] bg-white/[0.045] p-5"
              >
                <p class="section-eyebrow">What happens next</p>
                <div class="mt-4 grid gap-3">
                  {
                    [
                      "We review your catalog, carts, and current workflows.",
                      "We identify the highest-upside agent to deploy first.",
                      "You get a rollout scope, guardrails, and pricing proposal.",
                    ].map((item, index) => (
                      <div class="flex items-center gap-3">
                        <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-teal-300/10 text-xs font-bold text-teal-200">
                          0{index + 1}
                        </span>
                        <span class="text-base font-medium leading-snug text-slate-200">
                          {item}
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>

              <div
                class="flex items-center gap-4 rounded-2xl border border-[rgba(148,163,184,0.18)] bg-white/[0.035] p-4"
              >
                <div
                  class="grid h-12 w-12 place-items-center rounded-full border border-teal-300/20 bg-teal-300/10 text-teal-200"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path
                      d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                    ></path><polyline points="22,6 12,13 2,6"></polyline></svg
                  >
                </div>
                <div>
                  <p class="mini-label">Email</p>
                  <a
                    href={contactEmailUrl}
                    class="text-lg font-semibold text-white transition-colors hover:text-teal-200"
                    >support@voluchat.com</a
                  >
                </div>
              </div>
            </div>
          </div>

          <div class="solid-card p-6 sm:p-8 lg:p-10">
            <form id="contact-form" class="space-y-6">
              <div>
                <h2 class="text-2xl font-heading font-semibold text-white">
                  Book your demo
                </h2>
                <p class="mt-2 text-base font-medium text-slate-300">
                  Four fields. Enough context to avoid a generic demo call.
                </p>
              </div>

              <div>
                <label
                  for="name"
                  class="mb-2.5 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-300"
                  >Your name</label
                >
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Your name"
                  class="w-full rounded-2xl border border-[rgba(148,163,184,0.22)] bg-[#08111f] px-5 py-4 font-medium text-white placeholder:text-slate-500 transition-all focus:border-teal-300/50 focus:bg-[#0d1829] focus:outline-none focus:ring-4 focus:ring-teal-300/10"
                />
              </div>

              <div>
                <label
                  for="email"
                  class="mb-2.5 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-300"
                  >Work email</label
                >
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="you@store.com"
                  class="w-full rounded-2xl border border-[rgba(148,163,184,0.22)] bg-[#08111f] px-5 py-4 font-medium text-white placeholder:text-slate-500 transition-all focus:border-teal-300/50 focus:bg-[#0d1829] focus:outline-none focus:ring-4 focus:ring-teal-300/10"
                />
              </div>

              <div>
                <label
                  for="shopify_url"
                  class="mb-2.5 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-300"
                  >Store URL</label
                >
                <input
                  type="text"
                  id="shopify_url"
                  name="shopify_url"
                  required
                  placeholder="yourstore.com or yourstore.myshopify.com"
                  class="w-full rounded-2xl border border-[rgba(148,163,184,0.22)] bg-[#08111f] px-5 py-4 font-medium text-white placeholder:text-slate-500 transition-all focus:border-teal-300/50 focus:bg-[#0d1829] focus:outline-none focus:ring-4 focus:ring-teal-300/10"
                />
              </div>

              <div>
                <label
                  for="priority"
                  class="mb-2.5 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-300"
                  >First workflow to improve</label
                >
                <select
                  id="priority"
                  name="priority"
                  class="w-full rounded-2xl border border-[rgba(148,163,184,0.22)] bg-[#08111f] px-5 py-4 font-medium text-white transition-all focus:border-teal-300/50 focus:bg-[#0d1829] focus:outline-none focus:ring-4 focus:ring-teal-300/10"
                >
                  <option value="cart_recovery">Cart recovery</option>
                  <option value="product_questions">Product questions</option>
                  <option value="upsells">Upsells and bundles</option>
                  <option value="inventory_clearance"
                    >Inventory clearance</option
                  >
                  <option value="revenue_leaks">Revenue leak detection</option>
                </select>
              </div>

              <button
                type="submit"
                id="submit-btn"
                class="btn-primary w-full gap-3 px-6 py-5 text-base disabled:cursor-not-allowed disabled:opacity-55"
              >
                <span id="btn-text">Book Demo</span>
                <svg
                  id="btn-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                  ></path></svg
                >
              </button>

              <div
                id="form-message"
                class="hidden rounded-2xl p-4 text-center text-sm font-semibold"
              >
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <FAQ />
  </main>

  <Footer />

  <script
    is:inline
    define:vars={{ webhookUrl: import.meta.env.PUBLIC_N8N_DEMO_WEBHOOK_URL }}
  >
    const form = document.getElementById("contact-form");
    const submitBtn = document.getElementById("submit-btn");
    const btnText = document.getElementById("btn-text");
    const formMessage = document.getElementById("form-message");

    if (form) {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        submitBtn.disabled = true;
        const originalText = btnText.innerText;
        btnText.innerText = "Sending...";
        formMessage.classList.add("hidden");

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
          if (!webhookUrl) {
            throw new Error("Missing contact webhook URL");
          }

          const response = await fetch(webhookUrl, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(data),
          });

          if (!response.ok) {
            throw new Error("Failed to send request");
          }

          formMessage.innerText =
            "Thank you. We will review the store details and reach out shortly.";
          formMessage.className =
            "rounded-2xl border border-teal-300/20 bg-teal-300/10 p-4 text-center text-base font-medium text-teal-100 mt-6";
          formMessage.classList.remove("hidden");
          form.reset();
          btnText.innerText = "Request sent";
        } catch (error) {
          formMessage.innerText =
            "Something went wrong. Please try again or email us directly.";
          formMessage.className =
            "rounded-2xl border border-rose-300/20 bg-rose-400/10 p-4 text-center text-base font-medium text-rose-100 mt-6";
          formMessage.classList.remove("hidden");
          submitBtn.disabled = false;
          btnText.innerText = originalText;
        }
      });
    }
  </script>
</Layout>
