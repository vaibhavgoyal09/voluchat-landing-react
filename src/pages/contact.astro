---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import { getFaqSchema } from "../lib/faqSchema.mjs";

const seoTitle = "Apply for 1 of 10 Pilot Spots | VoluChat AI Sales Stylist for Fashion";
const seoDescription =
  "Join the private pilot cohort for VoluChat. Autonomous AI sales stylist for fashion & clothing boutiques — sizing intelligence, comment-to-DM, and WhatsApp UPI checkout. 100% white-glove setup.";
const seoKeywords =
  "VoluChat pilot application, fashion WhatsApp sales bot setup, boutique Instagram DM sales closer, clothing cart recovery";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: seoTitle,
  description: seoDescription,
  url: siteUrl,
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/contact", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="overflow-hidden pt-20">
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-24 lg:pb-28">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_18%,rgba(16,185,129,0.15),transparent_32%),radial-gradient(circle_at_82%_20%,rgba(15,23,42,0.55),transparent_34%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div class="contact-hero-text">
            <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/25 bg-emerald-950/40 px-3.5 py-1 text-xs font-bold text-emerald-300 mb-5">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Private Founder Cohort &bull; 10 Fashion Brands
            </div>
            <h1
              class="text-4xl font-semibold leading-[1.04] text-white sm:text-5xl lg:text-6xl font-heading"
            >
              Apply for 1 of 10 Pilot Store Deployments.
            </h1>
            <p class="section-copy mt-6 max-w-xl text-slate-300">
              We are selecting 10 ambitious apparel and clothing boutique brands. The founder personally handles 100% of the Meta Cloud API configuration, catalog &amp; size chart syncing, and AI stylist tuning.
            </p>

            <div class="mt-10 grid gap-4">
              <div
                class="rounded-2xl border border-white/10 bg-[#0a1424]/90 p-6"
              >
                <p class="section-eyebrow text-emerald-400">What is included in the pilot</p>
                <div class="mt-4 grid gap-3.5">
                  {
                    [
                      "Done-For-You Meta API & WhatsApp Business API Setup",
                      "Full Shopify Product Catalog & Live Stock Syncing",
                      "Automated Instagram Comment-to-DM Lead Engine",
                      "In-DM Native WhatsApp UPI / 1-Click Draft Order Checkout",
                      "Direct Founder Support on WhatsApp with 10x ROI Guarantee",
                    ].map((item, index) => (
                      <div class="flex items-center gap-3">
                        <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-emerald-500/15 font-mono text-xs font-bold text-emerald-300">
                          ✓
                        </span>
                        <span class="text-sm font-medium leading-snug text-slate-200">
                          {item}
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>

              <div
                class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-4"
              >
                <div
                  class="grid h-10 w-10 place-items-center rounded-xl border border-emerald-500/30 bg-emerald-500/10 text-emerald-300"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path
                      d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                    ></path><polyline points="22,6 12,13 2,6"></polyline></svg
                  >
                </div>
                <div>
                  <p class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400">Direct Founder Desk</p>
                  <a
                    href="mailto:support@voluchat.com"
                    class="text-sm font-semibold text-white transition-colors hover:text-emerald-300"
                    >support@voluchat.com</a
                  >
                </div>
              </div>
            </div>
          </div>

          <div class="contact-form-card solid-card p-6 sm:p-8 lg:p-10 border-emerald-500/20 bg-[#0c1524]">
            <form id="contact-form" class="space-y-5">
              <div>
                <h2 class="text-2xl font-heading font-semibold text-white">
                  Pilot Qualification Form
                </h2>
                <p class="mt-1.5 text-sm font-medium text-slate-300">
                  Takes 60 seconds. We review and respond within 12 hours.
                </p>
              </div>

              <div>
                <label
                  for="name"
                  class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-300"
                  >Your Name / Role</label
                >
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Vaibhav (Founder)"
                  class="w-full rounded-xl border border-white/10 bg-[#050c16] px-4 py-3.5 text-sm font-medium text-white placeholder:text-slate-500 transition-all focus:border-emerald-400 focus:bg-[#0a1424] focus:outline-none focus:ring-4 focus:ring-emerald-500/10"
                />
              </div>

              <div>
                <label
                  for="email"
                  class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-300"
                  >Work Email / WhatsApp No.</label
                >
                <input
                  type="text"
                  id="email"
                  name="email"
                  required
                  placeholder="you@store.com or +91 98765..."
                  class="w-full rounded-xl border border-white/10 bg-[#050c16] px-4 py-3.5 text-sm font-medium text-white placeholder:text-slate-500 transition-all focus:border-emerald-400 focus:bg-[#0a1424] focus:outline-none focus:ring-4 focus:ring-emerald-500/10"
                />
              </div>

              <div>
                <label
                  for="shopify_url"
                  class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-300"
                  >Instagram Handle or Store URL</label
                >
                <input
                  type="text"
                  id="shopify_url"
                  name="shopify_url"
                  required
                  placeholder="@yourbrand.in or yourstore.com"
                  class="w-full rounded-xl border border-white/10 bg-[#050c16] px-4 py-3.5 text-sm font-medium text-white placeholder:text-slate-500 transition-all focus:border-emerald-400 focus:bg-[#0a1424] focus:outline-none focus:ring-4 focus:ring-emerald-500/10"
                />
              </div>

              <div>
                <label
                  for="priority"
                  class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-300"
                  >Estimated Daily DM & Chat Volume</label
                >
                <select
                  id="priority"
                  name="priority"
                  class="w-full rounded-xl border border-white/10 bg-[#050c16] px-4 py-3.5 text-sm font-medium text-white transition-all focus:border-emerald-400 focus:bg-[#0a1424] focus:outline-none focus:ring-4 focus:ring-emerald-500/10"
                >
                  <option value="10-50">10 – 50 inquiries / day</option>
                  <option value="50-200">50 – 200 inquiries / day</option>
                  <option value="200+">200+ inquiries / day (High Volume)</option>
                  <option value="starting">Just starting with Ads & Reels</option>
                </select>
              </div>

              <button
                type="submit"
                id="submit-btn"
                class="btn-primary w-full gap-3 px-6 py-4 text-sm font-bold bg-white text-slate-950 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-55"
              >
                <span id="btn-text">Submit Pilot Application &rarr;</span>
              </button>

              <div
                id="form-message"
                class="hidden rounded-xl p-3 text-center text-xs font-semibold"
              >
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <FAQ />
  </main>

  <Footer />

  <script>
    import { gsap } from "gsap";
    
    document.addEventListener("DOMContentLoaded", () => {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) return;
  
      const tl = gsap.timeline();
      tl.fromTo(".contact-hero-text",
        { opacity: 0, x: -30 },
        { opacity: 1, x: 0, duration: 0.8, ease: "power2.out" }
      ).fromTo(".contact-form-card",
        { opacity: 0, x: 40, rotateY: -10 },
        { opacity: 1, x: 0, rotateY: 0, duration: 1, ease: "power3.out" },
        "-=0.6"
      );
    });
  </script>

  <script
    is:inline
    define:vars={{ webhookUrl: import.meta.env.PUBLIC_N8N_DEMO_WEBHOOK_URL }}
  >
    const form = document.getElementById("contact-form");
    const submitBtn = document.getElementById("submit-btn");
    const btnText = document.getElementById("btn-text");
    const formMessage = document.getElementById("form-message");

    if (form) {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        submitBtn.disabled = true;
        const originalText = btnText.innerText;
        btnText.innerText = "Sending...";
        formMessage.classList.add("hidden");

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
          if (!webhookUrl) {
            throw new Error("Missing contact webhook URL");
          }

          const response = await fetch(webhookUrl, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(data),
          });

          if (!response.ok) {
            throw new Error("Failed to send request");
          }

          formMessage.innerText =
            "Thank you. We will review the store details and reach out shortly.";
          formMessage.className =
            "rounded-2xl border border-teal-300/20 bg-teal-300/10 p-4 text-center text-base font-medium text-teal-100 mt-6";
          formMessage.classList.remove("hidden");
          form.reset();
          btnText.innerText = "Request sent";
        } catch (error) {
          formMessage.innerText =
            "Something went wrong. Please try again or email us directly.";
          formMessage.className =
            "rounded-2xl border border-rose-300/20 bg-rose-400/10 p-4 text-center text-base font-medium text-rose-100 mt-6";
          formMessage.classList.remove("hidden");
          submitBtn.disabled = false;
          btnText.innerText = originalText;
        }
      });
    }
  </script>
</Layout>
