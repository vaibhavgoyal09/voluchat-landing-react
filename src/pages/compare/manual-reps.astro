---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import { getFaqSchema } from "../../lib/faqSchema.mjs";

const seoTitle = "VoluChat vs Manual Sales Reps — Hiring Chat Staff vs AI Closer | Manual Rep Alternative";
const seoDescription =
  "Compare hiring full-time chat reps with VoluChat's autonomous AI sales stylist for WhatsApp, Instagram, and Facebook Messenger. 24/7 availability, zero churn, and 10x ROI standard.";
const seoKeywords =
  "hire WhatsApp sales reps vs chatbot, ecommerce chat rep cost India, Instagram DM sales agent, boutique sales closer WhatsApp, 24/7 chat sales, manual sales reps alternative";
const siteUrl = "https://www.voluchat.com";
const pageFaqs = [
  {
    question: "How much does VoluChat save vs hiring 4 chat reps?",
    answer:
      "4 reps at ₹20K/month each = ₹80,000/month in salaries alone — plus PF, ESI, training, and management overhead. VoluChat costs ₹4,999/month. That's a saving of over ₹75,000/month.",
  },
  {
    question: "Can VoluChat replace all 4 daily shifts?",
    answer:
      "Yes. VoluChat works 24/7 with zero breaks, sick days, or shift handovers. It covers the 10 PM–2 AM peak when manual reps are offline and 80%+ of impulse fashion buyers go cold.",
  },
  {
    question: "Will customers notice they're talking to AI?",
    answer:
      "VoluChat is designed to feel like a natural conversation — most customers don't notice it's AI. It answers sizing questions, recommends styles, and handles objections just like your best sales rep would.",
  },
  {
    question: "What happens when a customer needs a human?",
    answer:
      "VoluChat never invents answers. When a query falls outside its rules — like bespoke bridal alterations or bulk orders — it immediately alerts you on WhatsApp with full chat history so you can step in with one tap.",
  },
  {
    question: "Is VoluChat as knowledgeable as my best rep?",
    answer:
      "VoluChat has your entire catalog, size charts, fabric details, and pricing loaded. It never forgets a product or gives inconsistent sizing advice — unlike human reps who vary in knowledge and mood.",
  },
];
const comparison = [
  {
    category: "Late Night Speed (10 PM – 2 AM)",
    detail: "Coverage when Instagram Reel ads, Facebook posts, and browsing peak",
    manual: "15–45 minutes during working hours. Next-morning replies lose 80%+ of impulse fashion shoppers.",
    voluchat: "Sub-2 seconds. Instant response while the outfit impulse and buying mood are hottest.",
    voluAdvantage: "Sub-2s 24/7 speed",
  },
  {
    category: "Monthly Overhead & Hiring",
    detail: "Staff salaries, training, and turnover management",
    manual: "₹20,000–₹40,000/month per rep. Requires 2–3 reps for full shifts plus constant retraining on staff churn.",
    voluchat: "30-day free trial with transparent predictable pricing. Zero hiring, payroll, or churn headaches.",
    voluAdvantage: "Zero hiring overhead",
  },
  {
    category: "Sizing & Fit Accuracy",
    detail: "Preventing miscalculated body measurements & returns",
    manual: "Reps often misquote size measurements, forget fabric details, or make manual bank account typos.",
    voluchat: "100% consistent sizing qualification trained on your exact size charts and fabric guides.",
    voluAdvantage: "Zero sizing errors",
  },
  {
    category: "Live Inventory & Stock Verification",
    detail: "Preventing sales of sold-out colors and sizes",
    manual: "Reps must manually open the admin backend. Risk of confirming out-of-stock pieces.",
    voluchat: "Reads live variant inventory in real-time. Never confirms availability for sold-out pieces.",
    voluAdvantage: "Live stock protection",
  },
  {
    category: "Viral Reel Scalability",
    detail: "Handling 500+ comments on a viral post",
    manual: "Staff get overwhelmed, responses take 24+ hours, and hot buyers scroll past.",
    voluchat: "Simultaneously qualifies and closes 10 or 1,000 fashion shoppers with zero response lag.",
    voluAdvantage: "Infinite scale",
  },
  {
    category: "Human Escalation & Control",
    detail: "Handling VIP buyers and custom bridal inquiries",
    manual: "Reps may guess answers or drop VIP conversations without founder visibility.",
    voluchat: "AI handles 90% of routine sales and alerts your human team in 1 tap for custom bridal orders.",
    voluAdvantage: "1-Tap human takeover",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: seoTitle,
    description: seoDescription,
    url: `${siteUrl}/compare/manual-reps`,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "VoluChat vs Manual Sales Reps — Comparison Categories",
    description:
      "Detailed comparison categories between VoluChat's autonomous AI sales stylist and hiring manual chat reps for fashion boutiques.",
    url: `${siteUrl}/compare/manual-reps`,
    itemListElement: comparison.map((item, idx) => ({
      "@type": "ListItem",
      position: idx + 1,
      name: item.category,
      description: `${item.detail}. VoluChat advantage: ${item.voluAdvantage}.`,
      url: `${siteUrl}/compare/manual-reps#category-${idx + 1}`,
    })),
  },
];


const costBreakdown = [
  { label: "2 Chat Reps (Monthly Salary)", cost: "₹40,000–₹70,000" },
  { label: "Training & Staff Churn Costs", cost: "₹10,000–₹15,000" },
  { label: "Night Shift Allowance", cost: "₹10,000–₹15,000" },
  { label: "Lost Midnight Sales (Offline)", cost: "₹50,000+/month" },
  { label: "VoluChat AI Stylist", cost: "30 Days Free, Done-For-You" },
];

const verdict = {
  chooseManual: "Your chat volume is under 5 boutique inquiries per day, every piece is custom-tailored to unique body measurements, and you're okay with offline midnight gaps.",
  chooseVoluchat: "You want 24/7 instant sizing answers, live catalog inventory checks, zero manual UPI screenshot chasing, and autonomous WhatsApp, Instagram, and Facebook Messenger order closing.",
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/compare/manual-reps", siteUrl).toString()}
  structuredData={[...structuredData, getFaqSchema()]}
>
  <Header />

  <main class="overflow-hidden pt-20">
    <section class="relative overflow-hidden pt-20 pb-16 sm:pt-24 lg:pb-24">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_18%,rgba(16,185,129,0.15),transparent_32%),radial-gradient(circle_at_82%_20%,rgba(16,185,129,0.10),transparent_34%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="compare-hero-text mx-auto max-w-4xl text-center">
          <div class="inline-flex items-center gap-2 rounded-full border border-emerald-300 bg-emerald-50 px-3.5 py-1 text-xs font-bold text-emerald-700 mb-5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            VoluChat vs Manual Sales Reps
          </div>
          <h1
            class="text-4xl font-semibold leading-[1.04] text-slate-900 sm:text-6xl lg:text-7xl font-heading"
          >
            Autonomous AI Stylist vs
            <span class="block text-emerald-600">Hiring Manual Chat Reps.</span>
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl text-lg sm:text-xl leading-relaxed">
            Hiring chat reps is expensive, suffers from high turnover, and leaves your boutique offline at 11 PM when Instagram browsing peaks. VoluChat qualifies sizes, checks live stock, and closes orders 24/7.
          </p>
        </div>
      </div>
    </section>

    <!-- Side by Side Deep Comparison Grid -->
    <section class="py-16 sm:py-20 border-t border-slate-200 bg-slate-50">
      <div class="page-shell">
        <div class="mx-auto max-w-2xl text-center mb-12">
          <p class="section-eyebrow">Detailed Breakdown</p>
          <h2 class="section-title mt-3 text-slate-900 font-heading">
            How VoluChat compares to hiring manual reps.
          </h2>
        </div>

        <div class="max-w-5xl mx-auto space-y-5">
          {
            comparison.map((item, idx) => (
              <div class="solid-card p-6 sm:p-8 rounded-2xl border border-slate-200 hover:border-emerald-300 transition-all">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 pb-4 mb-5">
                  <div>
                    <span class="font-mono text-xs text-slate-500 font-bold uppercase">CATEGORY 0{idx + 1}</span>
                    <h3 class="text-xl font-heading font-bold text-slate-900 mt-0.5">{item.category}</h3>
                  </div>
                  <span class="inline-flex self-start sm:self-auto items-center gap-1.5 rounded-full border border-emerald-300 bg-emerald-500/10 px-3 py-1 text-xs font-mono font-medium text-emerald-700">
                    ✓ {item.voluAdvantage}
                  </span>
                </div>

                <div class="grid gap-4 md:grid-cols-2">
                  <div class="rounded-xl border border-rose-200 bg-rose-50 p-5">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-rose-600 font-mono font-bold text-xs">✕</span>
                      <span class="mini-label text-rose-600">Manual Reps Approach</span>
                    </div>
                    <p class="text-sm font-normal text-slate-600 leading-relaxed">{item.manual}</p>
                  </div>

                  <div class="rounded-xl border border-emerald-300 bg-emerald-50 p-5">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-emerald-600 font-mono font-bold text-xs">✓</span>
                      <span class="mini-label text-emerald-600">VoluChat Approach</span>
                    </div>
                    <p class="text-sm font-medium text-emerald-100 leading-relaxed">{item.voluchat}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Financial Cost Analysis Table -->
    <section class="py-16 sm:py-20 border-t border-slate-200 bg-white">
      <div class="page-shell">
        <div class="mx-auto max-w-2xl text-center mb-10">
          <p class="section-eyebrow">Cost Analysis</p>
          <h2 class="section-title mt-3 text-slate-900 font-heading">
            The True Cost of Manual Chat Staff
          </h2>
          <p class="section-copy mx-auto mt-3 max-w-lg">
            What you actually spend per month to maintain manual DM sales coverage.
          </p>
        </div>

        <div class="mx-auto max-w-3xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
          <div class="divide-y divide-white/[0.06]">
            {
              costBreakdown.map((item, i) => (
                <div class={`flex items-center justify-between p-5 sm:p-6 ${i === costBreakdown.length - 1 ? 'bg-emerald-50 font-bold' : ''}`}>
                  <span class={`text-sm ${i === costBreakdown.length - 1 ? 'text-emerald-700 font-heading text-base font-bold' : 'text-slate-600'}`}>
                    {item.label}
                  </span>
                  <span class={`font-mono text-sm ${i === costBreakdown.length - 1 ? 'text-emerald-600 text-base font-bold' : 'text-rose-600/90'}`}>
                    {item.cost}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Verdict Cards -->
    <section class="py-20 sm:py-24 bg-slate-50 border-t border-slate-200">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl grid gap-6 md:grid-cols-2">
          <div class="solid-card p-6 sm:p-8">
            <span class="mini-label text-slate-500">Choose Manual Reps if...</span>
            <h3 class="text-xl font-heading font-bold text-slate-900 mt-2 mb-3">Custom Bridal Alterations</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{verdict.chooseManual}</p>
          </div>

          <div class="solid-card-elevated p-6 sm:p-8 border-emerald-300">
            <span class="mini-label text-emerald-600">Choose VoluChat if...</span>
            <h3 class="text-xl font-heading font-bold text-slate-900 mt-2 mb-3">24/7 Instant Autonomous Sales</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{verdict.chooseVoluchat}</p>
          </div>
        </div>

        <div class="mt-14 text-center">
          <div class="flex flex-col sm:flex-row justify-center items-center gap-3.5">
            <a href="/free-trial" class="btn-primary">Start My 30-Day Free Trial &rarr;</a>
            <a
              href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary inline-flex items-center gap-2"
            >
              Try it on WhatsApp &rarr;
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Or explore <a href="/compare" class="text-emerald-600 hover:text-emerald-700 underline">all comparisons</a>.
          </p>
        </div>
      </div>
    </section>
  </main>

  <FAQ faqs={pageFaqs} />
  <Footer />
</Layout>
