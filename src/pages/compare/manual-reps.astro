---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import { getFaqSchema } from "../../lib/faqSchema.mjs";

const seoTitle = "VoluChat vs Manual Chat Reps — AI Sales Stylist vs Human Support for Boutiques";
const seoDescription =
  "Compare VoluChat's autonomous AI sales stylist with hiring manual chat reps for clothing boutique Instagram DMs and WhatsApp chats. Close 3x more orders 24/7 at a fraction of the cost.";
const seoKeywords =
  "VoluChat vs manual reps, boutique chat reps vs AI, WhatsApp sales bot fashion, Instagram DM closer clothing";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/compare/manual-reps`,
};

const comparison = [
  {
    category: "Late-Night Coverage",
    manual: "Offline between 10 PM – 9 AM. 55%+ of fashion Reel browsing happens at night when reps are asleep.",
    voluchat: "24/7/365 coverage. Converts midnight 'Price?' and 'Size M available?' comments in under 90 seconds.",
  },
  {
    category: "Response Time",
    manual: "15–45 minutes during working hours. Next-morning replies lose 80%+ of impulse fashion shoppers.",
    voluchat: "Sub-2 seconds. Instant response while the outfit impulse and buying mood are hottest.",
  },
  {
    category: "Monthly Overhead",
    manual: "₹18,000–35,000/month per rep. Need 2–3 reps for partial night shifts plus high churn.",
    voluchat: "Predictable pilot pricing with founder-backed 10x ROI standard. Zero hiring or rep churn overhead.",
  },
  {
    category: "Sizing & Fit Accuracy",
    manual: "Reps often misquote size measurements, forget fabric details, or make manual bank account typos.",
    voluchat: "100% consistent sizing qualification trained on your exact chart and fabric specifications.",
  },
  {
    category: "Inventory & Stock Sync",
    manual: "Reps manually check catalog/admin. Risk of confirming out-of-stock sizes or discontinued colors.",
    voluchat: "Reads live variant inventory in real-time. Never confirms availability for sold-out pieces.",
  },
  {
    category: "Viral Reel Scalability",
    manual: "Cannot handle 400+ comments on a viral Reel without crashing or taking 24+ hours to respond.",
    voluchat: "Simultaneously qualifies and closes 10 or 1,000 fashion shoppers with zero response lag.",
  },
];

const costBreakdown = [
  { label: "2 Chat Reps (monthly)", cost: "₹36,000–60,000" },
  { label: "Training & Onboarding", cost: "₹10,000–15,000" },
  { label: "Night Shift Premium", cost: "₹10,000–15,000" },
  { label: "Lost Midnight Sales", cost: "₹50,000+/mo" },
  { label: "VoluChat Pilot Setup", cost: "Fixed pricing, 10x ROI guarantee" },
];

const verdict = {
  chooseManual: "Your chat volume is under 5 boutique inquiries per day, every piece is custom-tailored to unique body measurements, and you're okay with offline midnight gaps.",
  chooseVoluchat: "You want 24/7 instant sizing answers, live catalog inventory checks, zero manual UPI screenshot chasing, and autonomous WhatsApp order closing.",
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/compare/manual-reps", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="pt-20">
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-24 lg:pb-24">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_10%,rgba(83,111,159,0.12),transparent_32%),radial-gradient(circle_at_18%_42%,rgba(203,217,234,0.16),transparent_30%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="compare-hero-text mx-auto max-w-4xl text-center">
          <div class="chip">VoluChat vs Manual Reps</div>
          <h1
            class="mt-6 text-4xl font-semibold leading-[1.02] text-white sm:text-6xl lg:text-7xl font-heading"
          >
            AI Sales Stylist vs Hiring Chat Reps.
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl text-slate-300">
            Hiring manual chat reps costs ₹40k+/month and leaves 55%+ of fashion inquiries cold at night. VoluChat acts as a tireless 24/7 AI stylist that closes orders in WhatsApp without manual typing.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl space-y-4">
          {
            comparison.map((row) => (
              <article class="solid-card p-6 md:p-8">
                <p class="section-eyebrow text-emerald-400 mb-4">{row.category}</p>
                <div class="grid gap-5 md:grid-cols-2">
                  <div class="rounded-2xl border border-white/10 bg-[#0c1728] p-5">
                    <p class="mini-label text-slate-400">Manual Reps</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                      {row.manual}
                    </p>
                  </div>
                  <div class="rounded-2xl border border-emerald-500/30 bg-emerald-950/20 p-5">
                    <p class="mini-label text-emerald-300">VoluChat</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-200">
                      {row.voluchat}
                    </p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl">
          <div class="solid-card p-6 md:p-8">
            <p class="section-eyebrow text-emerald-400 mb-4">Cost comparison</p>
            <h2 class="text-2xl font-heading font-semibold text-white mb-6">
              What manual reps actually cost
            </h2>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
              {costBreakdown.map((item) => (
                <div class="rounded-xl border border-white/10 bg-[#0c1728] p-4 text-center">
                  <p class="text-xs font-medium text-slate-400">{item.label}</p>
                  <p class="mt-2 text-sm font-bold text-white">{item.cost}</p>
                </div>
              ))}
            </div>
            <p class="mt-5 text-sm text-slate-400">
              VoluChat replaces all of these costs with a single fixed pilot price and a personal 10x ROI guarantee from the founder.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl grid gap-5 md:grid-cols-2">
          <article class="solid-card p-6 md:p-8">
            <p class="mini-label text-slate-400">Keep manual reps if...</p>
            <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
              {verdict.chooseManual}
            </p>
          </article>
          <article class="solid-card p-6 md:p-8 border-emerald-500/30 bg-emerald-950/20">
            <p class="mini-label text-emerald-300">Choose VoluChat if...</p>
            <p class="mt-3 text-base font-medium leading-relaxed text-slate-200">
              {verdict.chooseVoluchat}
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="pb-24">
      <div class="page-shell text-center">
        <a href="/contact" class="btn-primary">Apply for 1 of 10 Pilot Spots &rarr;</a>
        <p class="mt-4 text-sm text-slate-400">Or explore the full <a href="/compare" class="text-emerald-400 hover:text-emerald-300 underline">comparison guide</a>.</p>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    gsap.fromTo(".compare-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    gsap.utils.toArray<HTMLElement>(".solid-card").forEach((card) => {
      gsap.fromTo(card,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: "power2.out",
          scrollTrigger: {
            trigger: card,
            start: "top 85%",
            toggleActions: "play none none reverse",
          },
        }
      );
    });
  });
</script>
