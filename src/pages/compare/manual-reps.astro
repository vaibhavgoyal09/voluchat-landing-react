---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import { getFaqSchema } from "../../lib/faqSchema.mjs";

const seoTitle = "VoluChat vs Manual Sales Reps — Hiring Chat Staff vs AI Closer";
const seoDescription =
  "Compare hiring full-time chat reps with VoluChat's autonomous AI sales stylist for WhatsApp and Instagram. 24/7 availability, zero churn, and 10x ROI standard.";
const seoKeywords =
  "hire WhatsApp sales reps vs chatbot, ecommerce chat rep cost India, Instagram DM sales agent, boutique sales closer WhatsApp, 24/7 chat sales";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/compare/manual-reps`,
};

const comparison = [
  {
    category: "Late Night Speed (10 PM – 2 AM)",
    detail: "Coverage when Instagram Reel ads and browsing peak",
    manual: "15–45 minutes during working hours. Next-morning replies lose 80%+ of impulse fashion shoppers.",
    voluchat: "Sub-2 seconds. Instant response while the outfit impulse and buying mood are hottest.",
    voluAdvantage: "Sub-2s 24/7 speed",
  },
  {
    category: "Monthly Overhead & Hiring",
    detail: "Staff salaries, training, and turnover management",
    manual: "₹20,000–₹40,000/month per rep. Requires 2–3 reps for full shifts plus constant retraining on staff churn.",
    voluchat: "30-day free trial with transparent predictable pricing. Zero hiring, payroll, or churn headaches.",
    voluAdvantage: "Zero hiring overhead",
  },
  {
    category: "Sizing & Fit Accuracy",
    detail: "Preventing miscalculated body measurements & returns",
    manual: "Reps often misquote size measurements, forget fabric details, or make manual bank account typos.",
    voluchat: "100% consistent sizing qualification trained on your exact size charts and fabric guides.",
    voluAdvantage: "Zero sizing errors",
  },
  {
    category: "Live Inventory & Stock Verification",
    detail: "Preventing sales of sold-out colors and sizes",
    manual: "Reps must manually open the admin backend. Risk of confirming out-of-stock pieces.",
    voluchat: "Reads live variant inventory in real-time. Never confirms availability for sold-out pieces.",
    voluAdvantage: "Live stock protection",
  },
  {
    category: "Viral Reel Scalability",
    detail: "Handling 500+ comments on a viral post",
    manual: "Staff get overwhelmed, responses take 24+ hours, and hot buyers scroll past.",
    voluchat: "Simultaneously qualifies and closes 10 or 1,000 fashion shoppers with zero response lag.",
    voluAdvantage: "Infinite scale",
  },
  {
    category: "Human Escalation & Control",
    detail: "Handling VIP buyers and custom bridal inquiries",
    manual: "Reps may guess answers or drop VIP conversations without founder visibility.",
    voluchat: "AI handles 90% of routine sales and alerts your human team in 1 tap for custom bridal orders.",
    voluAdvantage: "1-Tap human takeover",
  },
];

const costBreakdown = [
  { label: "2 Chat Reps (Monthly Salary)", cost: "₹40,000–₹70,000" },
  { label: "Training & Staff Churn Costs", cost: "₹10,000–₹15,000" },
  { label: "Night Shift Allowance", cost: "₹10,000–₹15,000" },
  { label: "Lost Midnight Sales (Offline)", cost: "₹50,000+/month" },
  { label: "VoluChat AI Stylist", cost: "30 Days Free, Done-For-You" },
];

const verdict = {
  chooseManual: "Your chat volume is under 5 boutique inquiries per day, every piece is custom-tailored to unique body measurements, and you're okay with offline midnight gaps.",
  chooseVoluchat: "You want 24/7 instant sizing answers, live catalog inventory checks, zero manual UPI screenshot chasing, and autonomous WhatsApp order closing.",
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/compare/manual-reps", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="overflow-hidden pt-20">
    <section class="relative overflow-hidden pt-20 pb-16 sm:pt-24 lg:pb-24">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_18%,rgba(16,185,129,0.15),transparent_32%),radial-gradient(circle_at_82%_20%,rgba(15,23,42,0.55),transparent_34%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="compare-hero-text mx-auto max-w-4xl text-center">
          <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/25 bg-emerald-950/40 px-3.5 py-1 text-xs font-bold text-emerald-300 mb-5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            VoluChat vs Manual Sales Reps
          </div>
          <h1
            class="text-4xl font-semibold leading-[1.04] text-[#fcfdff] sm:text-6xl lg:text-7xl font-heading"
          >
            Autonomous AI Stylist vs
            <span class="block text-emerald-400">Hiring Manual Chat Reps.</span>
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl text-lg sm:text-xl leading-relaxed">
            Hiring chat reps is expensive, suffers from high turnover, and leaves your boutique offline at 11 PM when Instagram browsing peaks. VoluChat qualifies sizes, checks live stock, and closes orders 24/7.
          </p>
        </div>
      </div>
    </section>

    <!-- Side by Side Deep Comparison Grid -->
    <section class="py-16 sm:py-20 border-t border-white/[0.08] bg-[#06060a]">
      <div class="page-shell">
        <div class="mx-auto max-w-2xl text-center mb-12">
          <p class="section-eyebrow">Detailed Breakdown</p>
          <h2 class="section-title mt-3 text-[#fcfdff] font-heading">
            How VoluChat compares to hiring manual reps.
          </h2>
        </div>

        <div class="max-w-5xl mx-auto space-y-5">
          {
            comparison.map((item, idx) => (
              <div class="solid-card p-6 sm:p-8 rounded-2xl border border-white/[0.10] hover:border-emerald-500/30 transition-all">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-white/[0.08] pb-4 mb-5">
                  <div>
                    <span class="font-mono text-xs text-slate-500 font-bold uppercase">CATEGORY 0{idx + 1}</span>
                    <h3 class="text-xl font-heading font-bold text-white mt-0.5">{item.category}</h3>
                  </div>
                  <span class="inline-flex self-start sm:self-auto items-center gap-1.5 rounded-full border border-emerald-500/25 bg-emerald-500/10 px-3 py-1 text-xs font-mono font-medium text-emerald-300">
                    ✓ {item.voluAdvantage}
                  </span>
                </div>

                <div class="grid gap-4 md:grid-cols-2">
                  <div class="rounded-xl border border-rose-500/20 bg-[#12080a] p-5">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-rose-400 font-mono font-bold text-xs">✕</span>
                      <span class="mini-label text-rose-400">Manual Reps Approach</span>
                    </div>
                    <p class="text-sm font-normal text-slate-300 leading-relaxed">{item.manual}</p>
                  </div>

                  <div class="rounded-xl border border-emerald-500/30 bg-emerald-950/20 p-5">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-emerald-400 font-mono font-bold text-xs">✓</span>
                      <span class="mini-label text-emerald-400">VoluChat Approach</span>
                    </div>
                    <p class="text-sm font-medium text-emerald-100 leading-relaxed">{item.voluchat}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Financial Cost Analysis Table -->
    <section class="py-16 sm:py-20 border-t border-white/[0.08] bg-[#000000]">
      <div class="page-shell">
        <div class="mx-auto max-w-2xl text-center mb-10">
          <p class="section-eyebrow">Cost Analysis</p>
          <h2 class="section-title mt-3 text-[#fcfdff] font-heading">
            The True Cost of Manual Chat Staff
          </h2>
          <p class="section-copy mx-auto mt-3 max-w-lg">
            What you actually spend per month to maintain manual DM sales coverage.
          </p>
        </div>

        <div class="mx-auto max-w-3xl overflow-hidden rounded-2xl border border-white/[0.12] bg-[#0a0a0c] shadow-2xl">
          <div class="divide-y divide-white/[0.06]">
            {
              costBreakdown.map((item, i) => (
                <div class={`flex items-center justify-between p-5 sm:p-6 ${i === costBreakdown.length - 1 ? 'bg-emerald-950/30 font-bold' : ''}`}>
                  <span class={`text-sm ${i === costBreakdown.length - 1 ? 'text-emerald-300 font-heading text-base font-bold' : 'text-slate-300'}`}>
                    {item.label}
                  </span>
                  <span class={`font-mono text-sm ${i === costBreakdown.length - 1 ? 'text-emerald-400 text-base font-bold' : 'text-rose-400/90'}`}>
                    {item.cost}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Verdict Cards -->
    <section class="py-20 sm:py-24 bg-[#06060a] border-t border-white/[0.08]">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl grid gap-6 md:grid-cols-2">
          <div class="solid-card p-6 sm:p-8">
            <span class="mini-label text-slate-400">Choose Manual Reps if...</span>
            <h3 class="text-xl font-heading font-bold text-white mt-2 mb-3">Custom Bridal Alterations</h3>
            <p class="text-sm text-slate-300 leading-relaxed">{verdict.chooseManual}</p>
          </div>

          <div class="solid-card-elevated p-6 sm:p-8 border-emerald-500/30">
            <span class="mini-label text-emerald-400">Choose VoluChat if...</span>
            <h3 class="text-xl font-heading font-bold text-white mt-2 mb-3">24/7 Instant Autonomous Sales</h3>
            <p class="text-sm text-slate-300 leading-relaxed">{verdict.chooseVoluchat}</p>
          </div>
        </div>

        <div class="mt-14 text-center">
          <div class="flex flex-col sm:flex-row justify-center items-center gap-3.5">
            <a href="/free-trial" class="btn-primary">Start 30-Day Free Trial &rarr;</a>
            <a
              href="https://wa.me/919530840375?text=Hi%2C%20show%20me%20your%20summer%20dress%20collection."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary inline-flex items-center gap-2"
            >
              💬 Test Drive the Bot on WhatsApp
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Or explore <a href="/compare" class="text-emerald-400 hover:text-emerald-300 underline">all comparisons</a>.
          </p>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>
