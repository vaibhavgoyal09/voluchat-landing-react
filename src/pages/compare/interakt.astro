---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import { getFaqSchema } from "../../lib/faqSchema.mjs";

const seoTitle = "VoluChat vs Interakt — AI Stylist vs WhatsApp Inbox";
const seoDescription =
  "Compare VoluChat with Interakt's team inbox. See why automated sizing qualification and in-chat UPI checkout close more boutique orders.";
const seoKeywords =
  "VoluChat vs Interakt, Interakt alternative fashion, WhatsApp sales agent clothing, boutique DM sales closer";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/compare/interakt`,
};

const comparison = [
  {
    category: "Conversation Intelligence",
    interakt: "Template-based responses and shared human inbox. Agents manually type replies or use pre-approved WhatsApp templates.",
    voluchat: "Conversational AI Stylist that answers natural questions about fits, lengths, fabrics, and styling advice without human typing.",
  },
  {
    category: "Sales Automation",
    interakt: "Broadcast campaigns and generic notification alerts. No autonomous sizing qualification or objection handling.",
    voluchat: "Full autonomous sales closer: qualifies measurements, checks live variant inventory, cross-sells matching sets, and sends 1-click UPI links.",
  },
  {
    category: "Live Variant Inventory",
    interakt: "Basic catalog notifications. Cannot check live variant stock during high-intent sales conversations.",
    voluchat: "Reads live variant inventory in real-time. Prevents selling out-of-stock sizes and suggests in-stock styling alternatives.",
  },
  {
    category: "Checkout Experience",
    interakt: "Sends buyers to external website links. No native in-chat payment capability.",
    voluchat: "Native in-DM UPI payment links and draft orders. Shopper completes payment in 90 seconds without leaving WhatsApp.",
  },
  {
    category: "Instagram Reel Integration",
    interakt: "Primarily a WhatsApp support inbox. No native Instagram Reel comment-to-DM selling engine.",
    voluchat: "Comment-to-DM engine auto-replies to Instagram Reel comments in 2 seconds with exact pricing, photos, and sizing options.",
  },
  {
    category: "Setup",
    interakt: "Self-serve WhatsApp Business API tool. You configure templates, rules, and team assignments yourself.",
    voluchat: "100% white-glove setup. Founder personally syncs your catalog, size chart, and brand voice.",
  },
];

const verdict = {
  chooseInterakt: "You need a shared team inbox for human support reps, broadcast messaging for marketing blasts, and you have agents available to reply manually.",
  chooseVoluchat: "You want to close apparel sales autonomously 24/7. VoluChat qualifies sizes, checks live stock, handles styling doubts, and completes UPI payments in WhatsApp.",
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/compare/interakt", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="pt-20">
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-24 lg:pb-24">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_10%,rgba(83,111,159,0.12),transparent_32%),radial-gradient(circle_at_18%_42%,rgba(203,217,234,0.16),transparent_30%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="compare-hero-text mx-auto max-w-4xl text-center">
          <div class="chip">VoluChat vs Interakt</div>
          <h1
            class="mt-6 text-4xl font-semibold leading-[1.02] text-white sm:text-6xl lg:text-7xl font-heading"
          >
            VoluChat vs Interakt — AI Sales Agent vs Shared Inbox.
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl text-slate-300">
            Interakt provides a shared team inbox for human agents. VoluChat is an autonomous AI sales agent for fashion boutiques that qualifies sizing, cross-sells matching outfits, and completes 1-click UPI orders in-chat without manual typing.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl space-y-4">
          {
            comparison.map((row) => (
              <article class="solid-card p-6 md:p-8">
                <h2 class="section-eyebrow text-emerald-400 mb-4">{row.category}</h2>
                <div class="grid gap-5 md:grid-cols-2">
                  <div class="rounded-2xl border border-white/10 bg-[#0c1728] p-5">
                    <p class="mini-label text-slate-400">Interakt</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                      {row.interakt}
                    </p>
                  </div>
                  <div class="rounded-2xl border border-emerald-500/30 bg-emerald-950/20 p-5">
                    <p class="mini-label text-emerald-300">VoluChat</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-200">
                      {row.voluchat}
                    </p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl grid gap-5 md:grid-cols-2">
          <article class="solid-card p-6 md:p-8">
            <h2 class="mini-label text-slate-400">Choose Interakt if...</h2>
            <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
              {verdict.chooseInterakt}
            </p>
          </article>
          <article class="solid-card p-6 md:p-8 border-emerald-500/30 bg-emerald-950/20">
            <h2 class="mini-label text-emerald-300">Choose VoluChat if...</h2>
            <p class="mt-3 text-base font-medium leading-relaxed text-slate-200">
              {verdict.chooseVoluchat}
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="pb-24">
      <div class="page-shell text-center">
        <a href="/contact" class="btn-primary">Apply for 1 of 10 Pilot Spots &rarr;</a>
        <p class="mt-4 text-sm text-slate-400">Or explore the full <a href="/compare" class="text-emerald-400 hover:text-emerald-300 underline">comparison guide</a>.</p>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    gsap.fromTo(".compare-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    gsap.utils.toArray<HTMLElement>(".solid-card").forEach((card) => {
      gsap.fromTo(card,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: "power2.out",
          scrollTrigger: {
            trigger: card,
            start: "top 85%",
            toggleActions: "play none none reverse",
          },
        }
      );
    });
  });
</script>
