---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import { getFaqSchema } from "../../lib/faqSchema.mjs";

const seoTitle = "VoluChat vs Interakt — AI Sales Agent vs WhatsApp Business Toolkit";
const seoDescription =
  "Compare VoluChat's autonomous AI sales agent with Interakt's WhatsApp Business API toolkit for Shopify D2C brands. See why AI conversation closes more sales than shared inbox workflows.";
const seoKeywords =
  "VoluChat vs Interakt, Interakt alternative, Interakt vs AI sales agent, WhatsApp Business API India, best WhatsApp sales tool";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/compare/interakt`,
};

const comparison = [
  {
    category: "Conversation Intelligence",
    interakt: "Template-based responses and shared team inbox. Agents manually reply or use pre-approved message templates.",
    voluchat: "Generative AI that understands natural language, answers complex sizing/fabric questions, and handles objections without templates.",
  },
  {
    category: "Sales Automation",
    interakt: "Broadcast campaigns and order confirmation messages. No autonomous sales closing or objection handling.",
    voluchat: "Full autonomous sales loop: qualification, sizing, stock checks, objection handling, and in-chat UPI checkout — 24/7.",
  },
  {
    category: "Real-Time Inventory",
    interakt: "Basic Shopify integration for order notifications. Cannot check live variant stock during conversations.",
    voluchat: "Reads live Shopify variant inventory in real-time. Never sells out-of-stock items and suggests alternatives for unavailable sizes.",
  },
  {
    category: "Checkout Experience",
    interakt: "Sends buyers to external website links. No in-chat payment capability.",
    voluchat: "Native in-DM UPI links and draft order checkout. Buyer completes payment in 90 seconds without leaving WhatsApp.",
  },
  {
    category: "Instagram Integration",
    interakt: "Primarily a WhatsApp tool. Limited Instagram DM automation capabilities.",
    voluchat: "Comment-to-DM engine replies to Instagram comments in 2 seconds with exact pricing, stock info, and checkout links.",
  },
  {
    category: "Setup",
    interakt: "Self-serve WhatsApp Business API toolkit. You configure templates, workflows, and team assignments yourself.",
    voluchat: "100% white-glove setup for 10 pilot stores. Engineering team handles Meta API, Shopify sync, and brand voice guardrails.",
  },
];

const verdict = {
  chooseInterakt: "You need a shared team inbox for WhatsApp support, broadcast messaging for promotions, and basic order notifications — and you have agents available to reply manually.",
  chooseVoluchat: "You want to close sales autonomously. VoluChat qualifies buyers, checks live stock, handles objections, and completes orders in-chat — without requiring your team to be online.",
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/compare/interakt", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="pt-20">
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-24 lg:pb-24">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_10%,rgba(83,111,159,0.12),transparent_32%),radial-gradient(circle_at_18%_42%,rgba(203,217,234,0.16),transparent_30%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="compare-hero-text opacity-0 mx-auto max-w-4xl text-center">
          <div class="chip">VoluChat vs Interakt</div>
          <h1
            class="mt-6 text-4xl font-semibold leading-[1.02] text-white sm:text-6xl lg:text-7xl font-heading"
          >
            VoluChat vs Interakt — AI Sales Agent vs Shared Inbox.
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl text-slate-300">
            Interakt provides a shared team inbox and broadcast tools for WhatsApp Business. VoluChat is a generative AI sales agent that autonomously qualifies buyers, checks live stock, and closes orders in-chat.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl space-y-4">
          {
            comparison.map((row) => (
              <article class="opacity-0 solid-card p-6 md:p-8">
                <p class="section-eyebrow text-emerald-400 mb-4">{row.category}</p>
                <div class="grid gap-5 md:grid-cols-2">
                  <div class="rounded-2xl border border-white/10 bg-[#0c1728] p-5">
                    <p class="mini-label text-slate-400">Interakt</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                      {row.interakt}
                    </p>
                  </div>
                  <div class="rounded-2xl border border-emerald-500/30 bg-emerald-950/20 p-5">
                    <p class="mini-label text-emerald-300">VoluChat</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-200">
                      {row.voluchat}
                    </p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl grid gap-5 md:grid-cols-2">
          <article class="solid-card p-6 md:p-8">
            <p class="mini-label text-slate-400">Choose Interakt if...</p>
            <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
              {verdict.chooseInterakt}
            </p>
          </article>
          <article class="solid-card p-6 md:p-8 border-emerald-500/30 bg-emerald-950/20">
            <p class="mini-label text-emerald-300">Choose VoluChat if...</p>
            <p class="mt-3 text-base font-medium leading-relaxed text-slate-200">
              {verdict.chooseVoluchat}
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="pb-24">
      <div class="page-shell text-center">
        <a href="/contact" class="btn-primary">Apply for 1 of 10 Pilot Spots &rarr;</a>
        <p class="mt-4 text-sm text-slate-400">Or explore the full <a href="/compare" class="text-emerald-400 hover:text-emerald-300 underline">comparison guide</a>.</p>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    gsap.fromTo(".compare-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    gsap.utils.toArray<HTMLElement>(".solid-card").forEach((card) => {
      gsap.fromTo(card,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: "power2.out",
          scrollTrigger: {
            trigger: card,
            start: "top 85%",
            toggleActions: "play none none reverse",
          },
        }
      );
    });
  });
</script>
