---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import { getFaqSchema } from "../../lib/faqSchema.mjs";

const seoTitle = "VoluChat vs Manychat — AI Stylist vs Social Keyword Bot";
const seoDescription =
  "Compare VoluChat's in-chat WhatsApp sales agent with Manychat's external link-pusher. See why in-chat checkout converts 3x better for fashion boutiques.";
const seoKeywords =
  "VoluChat vs Manychat, Manychat alternative fashion, Instagram DM automation, WhatsApp checkout vs Manychat, fashion ecommerce chatbot";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/compare/manychat`,
};

const comparison = [
  {
    category: "Checkout & Cart Completion",
    detail: "How the customer actually completes payment",
    manychat: "Pushes external website links. 70%+ of mobile buyers bounce before entering address & payment on external browsers.",
    voluchat: "Native In-DM UPI checkout links and draft orders. Customer completes payment in under 90 seconds without leaving WhatsApp.",
    voluAdvantage: "Native in-chat payment",
  },
  {
    category: "Sizing Doubts & Fit Advice",
    detail: "Answering buyer questions on bust, waist, length, and fabric",
    manychat: "Trigger-based keyword responses only. Cannot answer 'Will this fit a 36 bust?' or compare size charts.",
    voluchat: "Trained on your exact size charts and fabric guides. Answers sizing doubts and qualifies fit accurately.",
    voluAdvantage: "Conversational AI Stylist",
  },
  {
    category: "Live Variant Stock Sync",
    detail: "Preventing sales of sold-out colors and sizes",
    manychat: "No real-time variant inventory check. Can send links for sizes that are completely sold out.",
    voluchat: "Reads live Shopify variant inventory before every recommendation. Zero overselling or refunded orders.",
    voluAdvantage: "Real-time stock check",
  },
  {
    category: "Comment-to-WhatsApp Flow",
    detail: "Moving buyers from Instagram comments to WhatsApp closing",
    manychat: "Traps buyers inside Instagram DMs with generic link cards.",
    voluchat: "Auto-replies to comments in 2 seconds and smoothly transitions high-intent shoppers to WhatsApp for personalized styling.",
    voluAdvantage: "High-conversion bridge",
  },
  {
    category: "Abandoned Cart Recovery",
    detail: "Re-engaging buyers who hesitate at payment",
    manychat: "Sends basic broadcast reminders with website links that get ignored.",
    voluchat: "Reaches out with personalized fit advice, handles hesitations, and provides a 1-click UPI checkout link.",
    voluAdvantage: "98% WhatsApp open rate",
  },
  {
    category: "Setup & Configuration",
    detail: "Time required to get started",
    manychat: "Self-serve DIY node builder. You must configure and maintain all trigger rules yourself.",
    voluchat: "100% Done-For-You white-glove setup. Our engineering team handles Meta Cloud APIs, catalog sync, and voice calibration.",
    voluAdvantage: "Zero setup effort",
  },
];

const verdict = {
  chooseManychat: "You run a creator account or lead-gen business where simple PDF distribution or sending followers to an external blog/landing page is your only goal.",
  chooseVoluchat: "You run an apparel brand or boutique where buyers have sizing hesitations, and you want to convert Instagram Reel comments into verified UPI orders directly in WhatsApp.",
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/compare/manychat", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="overflow-hidden pt-20">
    <section class="relative overflow-hidden pt-20 pb-16 sm:pt-24 lg:pb-24">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_18%,rgba(16,185,129,0.15),transparent_32%),radial-gradient(circle_at_82%_20%,rgba(15,23,42,0.55),transparent_34%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="compare-hero-text mx-auto max-w-4xl text-center">
          <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/25 bg-emerald-950/40 px-3.5 py-1 text-xs font-bold text-emerald-300 mb-5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            VoluChat vs Manychat
          </div>
          <h1
            class="text-4xl font-semibold leading-[1.04] text-[#fcfdff] sm:text-6xl lg:text-7xl font-heading"
          >
            In-Chat Sales Closer vs
            <span class="block text-emerald-400">External Link-Pusher.</span>
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl text-lg sm:text-xl leading-relaxed">
            Manychat auto-replies to comments by pushing external website links where 70%+ of mobile buyers drop off. VoluChat completes the full sizing, cross-sell, and UPI checkout flow inside WhatsApp in 90 seconds.
          </p>
        </div>
      </div>
    </section>

    <!-- Side by Side Deep Comparison Grid -->
    <section class="py-16 sm:py-20 border-t border-white/[0.08] bg-[#06060a]">
      <div class="page-shell">
        <div class="mx-auto max-w-2xl text-center mb-12">
          <p class="section-eyebrow">Detailed Breakdown</p>
          <h2 class="section-title mt-3 text-[#fcfdff] font-heading">
            How VoluChat compares to Manychat.
          </h2>
        </div>

        <div class="max-w-5xl mx-auto space-y-5">
          {
            comparison.map((item, idx) => (
              <div class="solid-card p-6 sm:p-8 rounded-2xl border border-white/[0.10] hover:border-emerald-500/30 transition-all">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-white/[0.08] pb-4 mb-5">
                  <div>
                    <span class="font-mono text-xs text-slate-500 font-bold uppercase">CATEGORY 0{idx + 1}</span>
                    <h3 class="text-xl font-heading font-bold text-white mt-0.5">{item.category}</h3>
                  </div>
                  <span class="inline-flex self-start sm:self-auto items-center gap-1.5 rounded-full border border-emerald-500/25 bg-emerald-500/10 px-3 py-1 text-xs font-mono font-medium text-emerald-300">
                    ✓ {item.voluAdvantage}
                  </span>
                </div>

                <div class="grid gap-4 md:grid-cols-2">
                  <div class="rounded-xl border border-rose-500/20 bg-[#12080a] p-5">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-rose-400 font-mono font-bold text-xs">✕</span>
                      <span class="mini-label text-rose-400">Manychat Approach</span>
                    </div>
                    <p class="text-sm font-normal text-slate-300 leading-relaxed">{item.manychat}</p>
                  </div>

                  <div class="rounded-xl border border-emerald-500/30 bg-emerald-950/20 p-5">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-emerald-400 font-mono font-bold text-xs">✓</span>
                      <span class="mini-label text-emerald-400">VoluChat Approach</span>
                    </div>
                    <p class="text-sm font-medium text-emerald-100 leading-relaxed">{item.voluchat}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Verdict Cards -->
    <section class="py-20 sm:py-24 bg-[#000000]">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl grid gap-6 md:grid-cols-2">
          <div class="solid-card p-6 sm:p-8">
            <span class="mini-label text-slate-400">Choose Manychat if...</span>
            <h3 class="text-xl font-heading font-bold text-white mt-2 mb-3">Simple Link Distribution</h3>
            <p class="text-sm text-slate-300 leading-relaxed">{verdict.chooseManychat}</p>
          </div>

          <div class="solid-card-elevated p-6 sm:p-8 border-emerald-500/30">
            <span class="mini-label text-emerald-400">Choose VoluChat if...</span>
            <h3 class="text-xl font-heading font-bold text-white mt-2 mb-3">In-Chat Fashion Revenue</h3>
            <p class="text-sm text-slate-300 leading-relaxed">{verdict.chooseVoluchat}</p>
          </div>
        </div>

        <div class="mt-14 text-center">
          <a href="/free-trial" class="btn-primary">Start 30-Day Free Trial &rarr;</a>
          <p class="mt-4 text-sm text-slate-500">
            Or explore <a href="/compare" class="text-emerald-400 hover:text-emerald-300 underline">all comparisons</a>.
          </p>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>
