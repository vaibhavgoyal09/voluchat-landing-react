---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import { getFaqSchema } from "../../lib/faqSchema.mjs";

const seoTitle = "VoluChat vs Manychat — AI Stylist vs DM Auto-Responder";
const seoDescription =
  "Compare VoluChat with Manychat. Close orders directly on WhatsApp with AI sizing and UPI checkout instead of sending static links.";
const seoKeywords =
  "VoluChat vs Manychat, Manychat alternative fashion, Instagram DM sales closer clothing, boutique WhatsApp checkout";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/compare/manychat`,
};

const comparison = [
  {
    category: "Response Intelligence",
    manychat: "Keyword-based auto-responders. Triggers on exact matches ('price', 'size') and sends generic static messages.",
    voluchat: "AI Stylist that understands nuanced fashion questions — 'Is this pure linen?', 'I'm 5'4, will size M be too long?' — and answers with context.",
  },
  {
    category: "Live Variant Inventory",
    manychat: "Cannot check live catalog variant stock. May confirm availability for colors or sizes that are actually sold out.",
    voluchat: "Reads live variant inventory in real-time. Never sells sold-out sizes and suggests matching in-stock outfits.",
  },
  {
    category: "Checkout Flow",
    manychat: "Sends an external browser link (website URL). 70%+ of impulse shoppers abandon at this step.",
    voluchat: "Native in-DM UPI links and draft orders. Buyer completes payment in 90 seconds without ever leaving WhatsApp.",
  },
  {
    category: "Instagram Reel Comment-to-DM",
    manychat: "Basic keyword trigger that sends a pre-written DM. No understanding of the specific outfit shown in the Reel.",
    voluchat: "2-second auto-reply with exact pricing, variant info, and stock status for the specific outfit in the Reel.",
  },
  {
    category: "WhatsApp Closing Layer",
    manychat: "Primarily an Instagram link-pusher. WhatsApp capabilities are limited to broadcast sequences.",
    voluchat: "Full WhatsApp AI stylist — qualifies measurements, checks delivery pincodes, handles COD doubts, and closes orders.",
  },
  {
    category: "Setup",
    manychat: "Self-serve SaaS. You build and maintain the flowchart logic yourself.",
    voluchat: "100% white-glove setup. Founder personally syncs your catalog, size chart, and brand voice.",
  },
];

const verdict = {
  chooseManychat: "You need basic Instagram comment auto-replies for lead capture, discount link distribution, or simple broadcast sequences.",
  chooseVoluchat: "You want to turn Reel scrollers into paid orders. VoluChat handles sizing, stock, objections, and collects UPI payment inside WhatsApp without external link drop-offs.",
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/compare/manychat", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="pt-20">
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-24 lg:pb-24">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_10%,rgba(83,111,159,0.12),transparent_32%),radial-gradient(circle_at_18%_42%,rgba(203,217,234,0.16),transparent_30%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="compare-hero-text mx-auto max-w-4xl text-center">
          <div class="chip">VoluChat vs Manychat</div>
          <h1
            class="mt-6 text-4xl font-semibold leading-[1.02] text-white sm:text-6xl lg:text-7xl font-heading"
          >
            VoluChat vs Manychat — AI Sales Closer vs Link-Pusher.
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl text-slate-300">
            Manychat sends keyword-triggered DMs and external website links where 70%+ of boutique buyers abandon. VoluChat is an AI stylist that qualifies measurements, checks live stock, and completes 1-click UPI checkout inside WhatsApp.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl space-y-4">
          {
            comparison.map((row) => (
              <article class="solid-card p-6 md:p-8">
                <h2 class="section-eyebrow text-emerald-400 mb-4">{row.category}</h2>
                <div class="grid gap-5 md:grid-cols-2">
                  <div class="rounded-2xl border border-white/10 bg-[#0c1728] p-5">
                    <p class="mini-label text-slate-400">Manychat</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                      {row.manychat}
                    </p>
                  </div>
                  <div class="rounded-2xl border border-emerald-500/30 bg-emerald-950/20 p-5">
                    <p class="mini-label text-emerald-300">VoluChat</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-200">
                      {row.voluchat}
                    </p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl grid gap-5 md:grid-cols-2">
          <article class="solid-card p-6 md:p-8">
            <h2 class="mini-label text-slate-400">Choose Manychat if...</h2>
            <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
              {verdict.chooseManychat}
            </p>
          </article>
          <article class="solid-card p-6 md:p-8 border-emerald-500/30 bg-emerald-950/20">
            <h2 class="mini-label text-emerald-300">Choose VoluChat if...</h2>
            <p class="mt-3 text-base font-medium leading-relaxed text-slate-200">
              {verdict.chooseVoluchat}
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="pb-24">
      <div class="page-shell text-center">
        <a href="/contact" class="btn-primary">Apply for 1 of 10 Pilot Spots &rarr;</a>
        <p class="mt-4 text-sm text-slate-400">Or explore the full <a href="/compare" class="text-emerald-400 hover:text-emerald-300 underline">comparison guide</a>.</p>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    gsap.fromTo(".compare-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    gsap.utils.toArray<HTMLElement>(".solid-card").forEach((card) => {
      gsap.fromTo(card,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: "power2.out",
          scrollTrigger: {
            trigger: card,
            start: "top 85%",
            toggleActions: "play none none reverse",
          },
        }
      );
    });
  });
</script>
