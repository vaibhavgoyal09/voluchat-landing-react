---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import { getFaqSchema } from "../../lib/faqSchema.mjs";

const seoTitle = "VoluChat vs Manychat — AI Sales Closer vs Instagram Auto-Responder";
const seoDescription =
  "Compare VoluChat's autonomous AI sales agent with Manychat's keyword-based Instagram auto-responder for Shopify D2C brands. See why in-DM checkout beats external link leaks.";
const seoKeywords =
  "VoluChat vs Manychat, Manychat alternative, Manychat vs AI sales agent, Instagram DM automation, WhatsApp sales bot India";
const siteUrl = "https://www.voluchat.com";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: `${siteUrl}/compare/manychat`,
};

const comparison = [
  {
    category: "Response Intelligence",
    manychat: "Keyword-based auto-responders. Triggers on exact matches ('price', 'size') and sends static messages.",
    voluchat: "Generative AI that understands nuanced questions — 'Do you have this in blue, size M, for a wedding next week?' — and responds contextually.",
  },
  {
    category: "Inventory Accuracy",
    manychat: "Cannot check live Shopify variant stock. May confirm availability for items that are actually sold out.",
    voluchat: "Reads live Shopify variant inventory in real-time. Never sells out-of-stock items or backordered variants.",
  },
  {
    category: "Checkout Flow",
    manychat: "Sends an external browser link (coupon code or website URL). 60%+ of shoppers abandon at this step.",
    voluchat: "Native in-DM UPI links and Shopify draft orders. Buyer completes payment in 90 seconds without leaving WhatsApp or Instagram.",
  },
  {
    category: "Instagram Comment-to-DM",
    manychat: "Basic comment trigger that sends a pre-written DM. No context about the specific product in the post.",
    voluchat: "2-second auto-reply with exact pricing, variant info, and stock status for the specific Reel or post the buyer commented on.",
  },
  {
    category: "WhatsApp Sales Closer",
    manychat: "Primarily an Instagram tool. WhatsApp capabilities are limited to broadcast sequences.",
    voluchat: "Full WhatsApp sales agent — qualifies buyers, checks delivery pincodes, handles objections, enforces margin guardrails, and closes orders.",
  },
  {
    category: "Setup",
    manychat: "Self-serve SaaS. You build the flows yourself using their visual builder.",
    voluchat: "100% white-glove setup for 10 pilot stores. Engineering team handles Meta API, Shopify sync, and brand voice guardrails.",
  },
];

const verdict = {
  chooseManychat: "You need basic Instagram comment auto-replies for lead capture, coupon code distribution, or simple broadcast sequences to an existing list.",
  chooseVoluchat: "You want to close sales end-to-end. VoluChat handles the full loop: comment capture, sizing questions, stock checks, objection handling, and in-chat payment — without sending buyers to external links.",
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical={new URL("/compare/manychat", siteUrl).toString()}
  structuredData={[structuredData, getFaqSchema()]}
>
  <Header />

  <main class="pt-20">
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-24 lg:pb-24">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_10%,rgba(83,111,159,0.12),transparent_32%),radial-gradient(circle_at_18%_42%,rgba(203,217,234,0.16),transparent_30%)]"
      >
      </div>
      <div class="ambient-noise"></div>

      <div class="page-shell">
        <div class="compare-hero-text opacity-0 mx-auto max-w-4xl text-center">
          <div class="chip">VoluChat vs Manychat</div>
          <h1
            class="mt-6 text-4xl font-semibold leading-[1.02] text-white sm:text-6xl lg:text-7xl font-heading"
          >
            VoluChat vs Manychat — AI Sales Closer vs Auto-Responder.
          </h1>
          <p class="section-copy mx-auto mt-6 max-w-3xl text-slate-300">
            Manychat sends keyword-triggered DMs and external links. VoluChat is a conversational AI that qualifies buyers, checks live stock, handles objections, and completes native checkout inside WhatsApp — closing sales, not just sending links.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl space-y-4">
          {
            comparison.map((row) => (
              <article class="opacity-0 solid-card p-6 md:p-8">
                <p class="section-eyebrow text-emerald-400 mb-4">{row.category}</p>
                <div class="grid gap-5 md:grid-cols-2">
                  <div class="rounded-2xl border border-white/10 bg-[#0c1728] p-5">
                    <p class="mini-label text-slate-400">Manychat</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
                      {row.manychat}
                    </p>
                  </div>
                  <div class="rounded-2xl border border-emerald-500/30 bg-emerald-950/20 p-5">
                    <p class="mini-label text-emerald-300">VoluChat</p>
                    <p class="mt-3 text-base font-medium leading-relaxed text-slate-200">
                      {row.voluchat}
                    </p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="page-shell">
        <div class="mx-auto max-w-4xl grid gap-5 md:grid-cols-2">
          <article class="solid-card p-6 md:p-8">
            <p class="mini-label text-slate-400">Choose Manychat if...</p>
            <p class="mt-3 text-base font-medium leading-relaxed text-slate-300">
              {verdict.chooseManychat}
            </p>
          </article>
          <article class="solid-card p-6 md:p-8 border-emerald-500/30 bg-emerald-950/20">
            <p class="mini-label text-emerald-300">Choose VoluChat if...</p>
            <p class="mt-3 text-base font-medium leading-relaxed text-slate-200">
              {verdict.chooseVoluchat}
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="pb-24">
      <div class="page-shell text-center">
        <a href="/contact" class="btn-primary">Apply for 1 of 10 Pilot Spots &rarr;</a>
        <p class="mt-4 text-sm text-slate-400">Or explore the full <a href="/compare" class="text-emerald-400 hover:text-emerald-300 underline">comparison guide</a>.</p>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    gsap.fromTo(".compare-hero-text",
      { opacity: 0, y: 30, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" }
    );

    gsap.utils.toArray<HTMLElement>(".solid-card").forEach((card) => {
      gsap.fromTo(card,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: "power2.out",
          scrollTrigger: {
            trigger: card,
            start: "top 85%",
            toggleActions: "play none none reverse",
          },
        }
      );
    });
  });
</script>
