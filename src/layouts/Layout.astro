---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	image?: string;
	type?: string;
	robots?: string;
	canonical?: string;
}

const {
	title,
	description = "VoluChat turns Instagram DMs into WhatsApp-ready chats for fashion boutiques. It replies to shoppers, searches products, collects details, and prepares WhatsApp handoffs.",
	keywords = "Instagram DM automation for boutiques, Instagram DMs to WhatsApp, WhatsApp-ready chats, fashion boutique WhatsApp automation, AI DM helpdesk, product search, WhatsApp handoff",
	image = "/og-image.png",
	type = "website",
	robots,
	canonical,
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? "https://voluchat.com";
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteOrigin).toString();
const imageUrl = new URL(image, siteOrigin).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		{robots && <meta name="robots" content={robots} />}
		<meta name="keywords" content={keywords} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{title}</title>
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content="VoluChat" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="theme-color" content="#0f172a" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
	</head>
	<body class="selection:bg-indigo-100 selection:text-indigo-900">
		<div class="animate-page-fade opacity-0">
			<slot />
		</div>

		<!-- Intersection Observer scroll-revealer script -->
		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				const observerOptions = {
					root: null,
					rootMargin: '0px 0px -60px 0px',
					threshold: 0.06
				};

				const observer = new IntersectionObserver((entries, obs) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('revealed');
							obs.unobserve(entry.target);
						}
					});
				}, observerOptions);

				const elements = document.querySelectorAll('.reveal-on-scroll');
				elements.forEach(el => observer.observe(el));
			});
		</script>
	</body>
</html>
